#!/usr/bin/env python3
"""Safely write black-box acceptance reports plus one terminal sentinel."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path
from typing import Any


TERMINAL_STATES = ("done", "fail", "blocked")
REPORT_SUFFIX = "-report.md"


class BlackboxReportError(Exception):
    """Expected operator-facing failure."""


def atomic_write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    tmp.write_text(content, encoding="utf-8")
    os.replace(tmp, path)


def read_body(path: str) -> str:
    if path == "-":
        return sys.stdin.read()
    return Path(path).read_text(encoding="utf-8")


def report_path(value: str) -> Path:
    if not value:
        raise BlackboxReportError("--report is required")
    path = Path(value).expanduser().resolve(strict=False)
    if path.name != "report.md" and not path.name.endswith(REPORT_SUFFIX):
        raise BlackboxReportError("--report must be named report.md or <prefix>-report.md")
    return path


def sentinel_prefix(report: Path) -> Path:
    if report.name == "report.md":
        return report.with_suffix("")
    return report.with_name(report.name[: -len(REPORT_SUFFIX)])


def sentinel_paths(report: Path) -> dict[str, Path]:
    prefix = sentinel_prefix(report)
    return {state: prefix.with_name(f"{prefix.name}.{state}") for state in TERMINAL_STATES}


def existing_markers(paths: dict[str, Path]) -> list[str]:
    return [state for state, path in paths.items() if path.exists()]


def command_write(args: argparse.Namespace) -> int:
    report = report_path(args.report)
    state = str(args.state)
    markers = sentinel_paths(report)
    existing = existing_markers(markers)
    if existing and existing != [state]:
        raise BlackboxReportError(f"terminal marker conflict: existing={','.join(existing)} requested={state}")

    body = read_body(args.body_file)
    if not body.strip():
        raise BlackboxReportError("report body is empty")

    atomic_write(report, body)
    marker = markers[state]
    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.touch()

    payload: dict[str, Any] = {
        "ok": True,
        "state": state,
        "report": str(report),
        "report_bytes": report.stat().st_size,
        "sentinel": str(marker),
        "existing_terminal_markers": existing,
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(f"report={report}")
        print(f"sentinel={marker}")
        print(f"state={state}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="omx_blackbox_report",
        description=(
            "Safely write a local black-box acceptance report and exactly one "
            "terminal sentinel. This helper does not run orchestration commands."
        ),
    )
    sub = parser.add_subparsers(dest="command", required=True)

    write = sub.add_parser("write", help="write report text from a file/stdin and a terminal sentinel")
    write.add_argument("--report", required=True, help="report path named <prefix>-report.md or report.md")
    write.add_argument("--state", choices=TERMINAL_STATES, required=True)
    write.add_argument("--body-file", required=True, help="report body file, or '-' for stdin")
    write.add_argument("--json", action="store_true")
    write.set_defaults(func=command_write)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.func(args))
    except BlackboxReportError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    except FileNotFoundError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("ERROR: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
