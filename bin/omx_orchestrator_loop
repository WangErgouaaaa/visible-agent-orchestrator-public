def _read_json_object(path: str) -> dict:
    if not path:
        return {}
    data = json.loads(Path(path).read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise ValueError(f"expected object JSON: {path}")
    return data


def _read_json_rows(path: str) -> list[dict]:
    if not path:
        return []
    data = json.loads(Path(path).read_text(encoding="utf-8"))
    if isinstance(data, dict):
        if "locks" in data:
            rows = data.get("locks")
        else:
            rows = data.get("workers", [])
    else:
        rows = data
    if not isinstance(rows, list):
        raise ValueError(f"expected row list JSON: {path}")
    return [row for row in rows if isinstance(row, dict)]


def _read_snapshot_sequence(path: str) -> list[dict]:
    payload = json.loads(Path(path).read_text(encoding="utf-8"))
    if isinstance(payload, dict):
        snapshots = payload.get("snapshots")
        if isinstance(snapshots, list):
            payload = snapshots
        else:
            payload = [payload]
    if not isinstance(payload, list) or not payload or not all(isinstance(item, dict) for item in payload):
        raise ValueError(f"expected one snapshot object or a non-empty snapshot list: {path}")
    return [dict(item) for item in payload]


def _emit(payload: dict, *, as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
        return
    if payload.get("answer_kind"):
        print(f"{payload.get('answer_kind')}:")
        print(f"  status: {payload.get('status')}")
        print(f"  primary_action: {payload.get('primary_action')}")
        print(f"  primary_reason: {payload.get('primary_reason')}")
        print(f"  actuation_enabled: {str(bool(payload.get('actuation_enabled'))).lower()}")
        print(f"  actionable: {str(bool(payload.get('actionable'))).lower()}")
        print(f"  would_execute: {str(bool(payload.get('would_execute'))).lower()}")
        safe_next_actions = payload.get("safe_next_actions")
        if isinstance(safe_next_actions, list):
            for item in safe_next_actions:
                print(f"  safe_next_action: {item}")
        forbidden_next_actions = payload.get("forbidden_next_actions")
        if isinstance(forbidden_next_actions, list):
            for item in forbidden_next_actions:
                print(f"  forbidden_next_action: {item}")
        return
    if payload.get("blackboard_kind"):
        print(f"{payload.get('blackboard_kind')}:")
        print(f"  mode: {payload.get('mode')}")
        print(f"  actuation_enabled: {str(bool(payload.get('actuation_enabled'))).lower()}")
        domains = payload.get("evidence_domains")
        if isinstance(domains, dict):
            for domain_id, row in sorted(domains.items()):
                status = row.get("status") if isinstance(row, dict) else ""
                print(f"  domain: {domain_id} status={status}")
        return
    if payload.get("scheduler_kind"):
        print(f"{payload.get('scheduler_kind')}:")
        print(f"  mode: {payload.get('mode')}")
        print(f"  actuation_enabled: {str(bool(payload.get('actuation_enabled'))).lower()}")
        if "would_dispatch" in payload:
            print(f"  would_dispatch: {str(bool(payload.get('would_dispatch'))).lower()}")
        if "executed" in payload:
            print(f"  executed: {str(bool(payload.get('executed'))).lower()}")
        decisions = payload.get("decisions")
        if isinstance(decisions, list):
            for row in decisions:
                if isinstance(row, dict):
                    action = row.get("action") or ""
                    domain = row.get("evidence_domain") or row.get("subagent_id") or ""
                    would_execute = str(bool(row.get("would_execute"))).lower()
                    print(f"  decision: {action} {domain} would_execute={would_execute}".rstrip())
        actions = payload.get("actions")
        if isinstance(actions, list):
            for row in actions:
                if isinstance(row, dict):
                    action = row.get("action") or ""
                    domain = row.get("evidence_domain") or row.get("subagent_id") or ""
                    would_execute_live = str(bool(row.get("would_execute_live"))).lower()
                    executed = str(bool(row.get("executed"))).lower()
                    print(
                        f"  action: {action} {domain} "
                        f"would_execute_live={would_execute_live} executed={executed}".rstrip()
                    )
        return
    if payload.get("executor_kind"):
        print(f"{payload.get('executor_kind')}:")
        print(f"  mode: {payload.get('mode')}")
        print(f"  actuation_enabled: {str(bool(payload.get('actuation_enabled'))).lower()}")
        print(f"  execution_allowed: {str(bool(payload.get('execution_allowed'))).lower()}")
        print(f"  executed: {str(bool(payload.get('executed'))).lower()}")
        return
    if payload.get("supervisor_kind"):
        decision = payload.get("last_decision") if isinstance(payload.get("last_decision"), dict) else {}
        print(f"{payload.get('supervisor_kind')}:")
        print(f"  run_id: {payload.get('run_id')}")
        print(f"  mode: {payload.get('mode')}")
        print(f"  cycles: {payload.get('cycles')}")
        print(f"  disposition: {decision.get('disposition') or '-'}")
        print(f"  reason: {decision.get('reason') or '-'}")
        print(f"  actuation_enabled: {str(bool(payload.get('actuation_enabled'))).lower()}")
        return
    if payload.get("rollback_kind"):
        print(f"{payload.get('rollback_kind')}:")
        print(f"  mode: {payload.get('mode')}")
        print(f"  recommended_mode: {payload.get('recommended_mode')}")
        print(f"  executed: {str(bool(payload.get('executed'))).lower()}")
        return
    print(f"{payload.get('loop_kind')}:")
    print(f"  actuation_enabled: {str(bool(payload.get('actuation_enabled'))).lower()}")
    summary = payload.get("summary")
    if isinstance(summary, dict):
        for key in sorted(summary):
            print(f"  {key}: {summary[key]}")
    recommendations = payload.get("recommendations")
    if isinstance(recommendations, list):
        for row in recommendations:
            if isinstance(row, dict):
                print(f"  recommendation: {row.get('recommendation')} {row.get('worker_id') or ''}".rstrip())


def command_contract(args: argparse.Namespace) -> int:
    _emit(build_loop_contract(), as_json=bool(args.json))
    return 0


def command_observe(args: argparse.Namespace) -> int:
    board = _read_json_object(args.board_json) if args.board_json else None
    locks = _read_json_rows(args.locks_json) if args.locks_json else None
    run_metrics = _read_json_object(args.run_metrics_json) if args.run_metrics_json else None
    decision_control = _read_json_object(args.decision_control_json) if args.decision_control_json else None
    payload = observe_once(
        Path(args.root),
        board_payload=board,
        lock_rows=locks,
        run_metrics_data=run_metrics,
            decision_control_data=decision_control,
            locks_command=args.locks_command,
    )
    _emit(payload, as_json=bool(args.json))
    return 0


def command_blackboard(args: argparse.Namespace) -> int:
    board = _read_json_object(args.board_json) if args.board_json else None
    if board is None:
        observation = observe_once(
            Path(args.root),
            board_payload=None,
            lock_rows=[],
            locks_command="",
        )
        payload = observation.get("blackboard") if isinstance(observation.get("blackboard"), dict) else {}
    else:
        payload = build_evidence_blackboard(board)
    _emit(payload, as_json=bool(args.json))
    return 0


def command_pull_dry_run(args: argparse.Namespace) -> int:
    board = _read_json_object(args.board_json) if args.board_json else None
    if board is None:
        observation = observe_once(
            Path(args.root),
            board_payload=None,
            lock_rows=[],
            locks_command="",
        )
        blackboard = observation.get("blackboard") if isinstance(observation.get("blackboard"), dict) else {}
        payload = build_pull_dry_run_plan(blackboard)
    else:
        projection = board.get("opencode_subagent_projection") if isinstance(board.get("opencode_subagent_projection"), dict) else {}
        blackboard = build_evidence_blackboard(board, projection)
        payload = build_pull_dry_run_plan(blackboard, subagent_projection=projection)
    if bool(args.answer_only):
        payload = payload.get("answer") if isinstance(payload.get("answer"), dict) else {}
    _emit(payload, as_json=bool(args.json))
    return 0


def command_pull_live_plan(args: argparse.Namespace) -> int:
    board = _read_json_object(args.board_json) if args.board_json else None
    if board is None:
        observation = observe_once(
            Path(args.root),
            board_payload=None,
            lock_rows=[],
            locks_command="",
        )
        blackboard = observation.get("blackboard") if isinstance(observation.get("blackboard"), dict) else {}
        payload = build_pull_live_plan(blackboard, allow_live=bool(args.allow_live))
    else:
        projection = board.get("opencode_subagent_projection") if isinstance(board.get("opencode_subagent_projection"), dict) else {}
        blackboard = build_evidence_blackboard(board, projection)
        payload = build_pull_live_plan(
            blackboard,
            subagent_projection=projection,
            allow_live=bool(args.allow_live),
        )
    _emit(payload, as_json=bool(args.json))
    return 0


def command_pull_executor_plan(args: argparse.Namespace) -> int:
    action = _read_json_object(args.action_json)
    worker_preflight = _read_json_object(args.worker_preflight_json) if args.worker_preflight_json else None
    locks = _read_json_rows(args.locks_json) if args.locks_json else None
    payload = build_pull_live_executor_plan(
        action,
        target_root=str(Path(args.target_root).resolve()),
        worker_preflight=worker_preflight,
        locks=locks,
        allow_real=bool(args.allow_real),
    )
    _emit(payload, as_json=bool(args.json))
    return 0


def command_pull_rollback_plan(args: argparse.Namespace) -> int:
    executor_plan = _read_json_object(args.executor_plan_json)
    payload = build_pull_live_rollback_plan(executor_plan, reason=args.reason)
    _emit(payload, as_json=bool(args.json))
    return 0


def command_advise(args: argparse.Namespace) -> int:
    board = _read_json_object(args.board_json) if args.board_json else None
    locks = _read_json_rows(args.locks_json) if args.locks_json else None
    decision_control = _read_json_object(args.decision_control_json) if args.decision_control_json else None
    output = Path(args.output)
    payload = {}
    for index in range(max(1, int(args.watch_count))):
        observation = observe_once(
            Path(args.root),
            board_payload=board,
            lock_rows=locks,
        decision_control_data=decision_control,
        locks_command=args.locks_command,
        )
        payload = write_advisory_plan(observation, output)
        if index + 1 < int(args.watch_count):
            time.sleep(float(args.interval))
    if bool(args.stdout_observation):
        payload = {
            "schema_version": 1,
            "loop_kind": "orchestrator_loop_advisor_handoff",
            "actuation_enabled": False,
            "plan": payload,
            "observation": observation,
        }
    _emit(payload, as_json=bool(args.json))
    return 0


