def command_replan_chain(args: argparse.Namespace) -> int:
    workers = [str(item).strip() for item in list(args.worker or []) if str(item).strip()]
    request = {
        "lane_contracts_path": args.lane_contracts,
        "workers": workers,
        "strict_closeout_contract": bool(args.strict_closeout_contract),
        "direct_tools_available": bool(args.direct_tools_available),
        "unresolved_go_no_go": bool(args.unresolved_go_no_go),
        "evidence_bundle_size": args.evidence_bundle_size,
        "topology_kind": args.topology_kind,
    }
    payload = write_replan_chain(
        request,
        output_dir=Path(args.output_dir),
        transition_outcome=args.transition_outcome,
    )
    _emit(payload, as_json=bool(args.json))
    return 0


