#!/usr/bin/env python3
"""Visible task lifecycle signal helper.

This helper is intended to be called by a visible worker from inside a task
prompt. It writes protocol markers and events in one visible-runs task
directory, may finalize that task's pending session acceptance fence, and
never edits report.md or owner locks.
"""

from __future__ import annotations

