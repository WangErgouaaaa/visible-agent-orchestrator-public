#!/usr/bin/env python3
"""Validate a worker/plugin receipt ack and signal .received for one visible task."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


_THIS_FILE = Path(__file__).resolve()
_CANDIDATE_IMPORT_ROOTS = []

_env_lib = os.environ.get("OMX_VISIBLE_AGENT_ORCHESTRATOR_LIB")
if _env_lib:
    _CANDIDATE_IMPORT_ROOTS.append(Path(_env_lib).expanduser().resolve())

_CANDIDATE_IMPORT_ROOTS.append((_THIS_FILE.parent.parent / "src").resolve())
_CANDIDATE_IMPORT_ROOTS.append((_THIS_FILE.parent.parent / "lib").resolve())

for _path in _CANDIDATE_IMPORT_ROOTS:
    if _path.exists() and str(_path) not in sys.path:
        sys.path.insert(0, str(_path))

from visible_agent_orchestrator.receipt_ack import ReceiptAckError, validate_receipt_ack  # noqa: E402


def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def rel(path: Path, root: Path) -> str:
    try:
        return str(path.resolve().relative_to(root.resolve()))
    except ValueError:
        return str(path)


def read_json(path: Path) -> dict[str, Any]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise ReceiptAckError("missing_ack") from exc
    except json.JSONDecodeError as exc:
        raise ReceiptAckError("malformed_ack_json") from exc
    if not isinstance(data, dict):
        raise ReceiptAckError("malformed_ack_json")
    return data


def atomic_write_json(path: Path, data: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def append_event(path: Path, event: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(event, sort_keys=True, ensure_ascii=False) + "\n")


def command_accept(args: argparse.Namespace) -> int:
    root = Path(args.root).resolve()
    task_dir = (root / args.task_dir).resolve(strict=False) if not Path(args.task_dir).is_absolute() else Path(args.task_dir).resolve(strict=False)
    ack_path = Path(args.ack_json)
    if not ack_path.is_absolute():
        ack_path = task_dir / ack_path
    ack_data = read_json(ack_path)
    ack = validate_receipt_ack(root, task_dir, args.worker, ack_data)
    received_path = task_dir / ".received"
    ts = utc_now()
    status = {
        "schema_version": 1,
        "validated_at": ts,
        "receipt_state": "already_received" if received_path.is_file() else "receipt_ack_validated",
        "worker_id": ack.worker_id,
        "run": ack.run,
        "task": ack.task,
        "task_dir": rel(task_dir, root),
        "ack_path": rel(ack_path, root),
        "delivery_prompt_sha256": ack.delivery_prompt_sha256,
        "source": "omx_visible_receipt_ack",
        "ack_source": ack.source,
    }
    atomic_write_json(task_dir / "receipt_ack_validated.json", status)
    append_event(
        task_dir / "events.jsonl",
        {
            "ts": ts,
            "event": "receipt_ack_validated",
            "source": "omx_visible_receipt_ack",
            "worker": ack.worker_id,
            "task_dir": rel(task_dir, root),
            "receipt_state": status["receipt_state"],
        },
    )
    if received_path.is_file():
        print("receipt_ack: already_received")
        print(f"task: {rel(task_dir, root)}")
        return 0
    signal = root / "bin" / "omx_task_signal"
    proc = subprocess.run(
        [sys.executable, str(signal), "received", "--root", str(root), "--task-dir", str(task_dir), "--worker", ack.worker_id],
        cwd=str(root),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if proc.returncode != 0:
        print(proc.stdout, end="")
        print(proc.stderr, end="", file=sys.stderr)
        return proc.returncode or 1
    print(proc.stdout, end="")
    print("receipt_ack: accepted")
    print(f"validated: {rel(task_dir / 'receipt_ack_validated.json', root)}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("accept", nargs="?")
    parser.add_argument("--root", required=True)
    parser.add_argument("--task-dir", required=True)
    parser.add_argument("--worker", required=True)
    parser.add_argument("--ack-json", default="receipt_ack.json")
    args = parser.parse_args(argv)
    if args.accept != "accept":
        parser.error("expected subcommand: accept")
    try:
        return command_accept(args)
    except ReceiptAckError as exc:
        print(f"receipt_ack_error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
