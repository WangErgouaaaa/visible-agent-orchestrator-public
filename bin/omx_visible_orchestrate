# Structured lock-rejection surfaces only (issue #895): explicit JSON fields
# and exact machine lines the downstream dispatch/langgraph control-plane
# CLIs emit, plus the typed DispatchError renderings dispatch prints for
# owner-lock refusals. Prose that merely mentions these codes never selects
# lock diagnostics.
LOCK_REJECTION_FINAL_STATES = ("worker_pool_busy",)
LOCK_REJECTION_MACHINE_LINES = (
    "final_state: worker_pool_busy",
    "wait_result: running_or_incomplete",
)
# The langgraph text mode prints the summary machine field as
# `summary: {json object}` (bin/omx_langgraph_control_plane:659).
LOCK_REJECTION_SUMMARY_LINE_PREFIX = "summary: "
LOCK_REJECTION_ERROR_LINE_PATTERNS = (
    re.compile(r"ERROR: submit failed: active_task_exists for \S.*"),
    re.compile(r"ERROR: submit failed: worker \S+ binding changed before owner lock acquisition"),
)
# Structured `refusal_reason` values carried by the omx_visible_rebind --json
# known-failure envelope (RebindError facts) that are confirmed target
# owner-lock refusals; every other nonzero rebind result keeps its own
# failure reason without lock diagnosis. `status` stays the trusted binding
# observation or null per the runbook contract.
REBIND_LOCK_REFUSAL_REASONS = ("target_owner_lock",)
TERMINAL_PROTOCOL_STATES = {"completed", "blocked", "failed", "submit_failed"}
CROSS_SESSION_REBIND_STATUS = "registry_session_mismatch_rebind_available"


class RecoveryGuidanceError(LeaderOrchestrateError):
    def __init__(self, message: str, guidance: dict[str, object] | None):
        super().__init__(message)
        self.guidance = guidance


def root_path(value: str | None) -> Path:
    return runtime_root(value)


def add_common_run_arguments(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--root", default=".")
    parser.add_argument("--backend", default="tmux-reference")
    parser.add_argument("--worker", action="append", default=[], help="repeatable worker id or comma-separated worker ids")
    parser.add_argument("--all-production-workers", action="store_true", help="use every dispatchable default/production worker from registry")
    parser.add_argument("--fanout", type=int, help="choose the first N dispatchable workers from registry (default worker first)")
    parser.add_argument("--title", required=True)
    parser.add_argument("--inner-mode", choices=["4x3", "4x7"], default="")
    parser.add_argument("--artifact-root", default="")
    parser.add_argument("--topology-metadata", default="", help="optional chapter brief / topology metadata JSON that can derive inner topology")
    parser.add_argument(
        "--task-profile",
        default="",
        help="optional validated task-feature JSON used for advisory fanout selection",
    )
    parser.add_argument(
        "--lane-contracts",
        default="",
        help="optional JSON file with explicit per-worker lane assignments and prepared task contracts",
    )
    parser.add_argument(
        "--emit-lane-contracts",
        default="",
        help="optional path where plan/run should write an auto-generated lane-contract JSON for a multiworker read-only run",
    )
    parser.add_argument(
        "--timeout",
        type=int,
        default=300,
        help=(
            "caller wait budget in seconds forwarded to the dispatch child; it is "
            "not a worker task deadline: expiry returns pending/running while "
            "task/attempt/owner stay retained, so keep reading the task's own "
            "report/marker/evidence and settle only after the formal terminal state"
        ),
    )
    parser.add_argument("--model", default="", help="optional model name for effective context budget hints")
    parser.add_argument("--nominal-context-tokens", type=int, default=0, help="model advertised context window in tokens")
    parser.add_argument("--effective-context-tokens", type=int, default=0, help="provider/runtime effective context window in tokens")
    parser.add_argument("--wait-for-workers", action="store_true")
    parser.add_argument("--worker-wait-timeout", type=int, default=600)
    parser.add_argument("--worker-wait-interval", type=int, default=5)
    parser.add_argument("--post-failure-settle-timeout", type=int, default=180)
    parser.add_argument("--post-failure-settle-interval", type=int, default=5)
    parser.add_argument("--allow-real", action="store_true")
    parser.add_argument(
        "--allow-visible-full-prompt",
        action="store_true",
        help=(
            "explicitly post the complete prompt.txt body into the visible "
            "TUI; full-prompt delivery modes are the only delivery modes "
            "whose task-body grants can authorize writes outside the task "
            "directory, and this flag selects the visible full-prompt mode "
            "- the flag itself grants no additional write scope"
        ),
    )
    parser.add_argument(
        "--task-contract-json",
        default="",
        help=(
            "host-prepared task contract JSON for real operator dispatch; "
            "the trusted host prepares the grant through the "
            "operation_authorization library, this entrypoint only consumes it"
        ),
    )
    parser.add_argument(
        "--draft-check",
        dest="draft_check",
        action="store_true",
        help=(
            "opt this task into the closed draft-check delivery contract "
            "(draft_check.enabled=true) before the grant/contract hash is "
            "prepared: --authorize-leader mints the grant with the "
            "selection bound into the task contract, and a consumed "
            "--task-contract-json must carry the exact same selection or "
            "the dispatch is rejected as a contract conflict"
        ),
    )
    parser.add_argument(
        "--draft-check-jev-live",
        dest="draft_check_jev_live",
        action="store_true",
        help=(
            "leader-only task-level live Jev selection for the automatic "
            "draft-check hook: implies --draft-check and requires "
            "--draft-check-evidence-root; within that hook path it is "
            "the only live-sending authorization (other tools keep their "
            "own independent surfaces), it is bound into the task "
            "contract before the grant/contract hash like --draft-check, "
            "and ordinary --draft-check stays offline"
        ),
    )
    parser.add_argument(
        "--draft-check-evidence-root",
        dest="draft_check_evidence_root",
        default="",
        help=(
            "authorized absolute evidence root recorded with "
            "--draft-check-jev-live; the check refuses to send unless "
            "the draft declares exactly this root, so a worker draft "
            "cannot point the check at a different host directory"
        ),
    )
    parser.add_argument("--require-confirmation", action="store_true")
    parser.add_argument("--force-langgraph", action="store_true")
    parser.add_argument("--thread-id")
    parser.add_argument("--approved", action="store_true")
    parser.add_argument(
        "--json",
        action="store_true",
        help=(
            "run: structured result receipt after an accepted single-worker "
            "dispatch, including run_preflight from the same call's binding/"
            "doctor/lock gates; usage and admission rejections stay "
            "stderr+nonzero with no JSON. plan: emit the selected plan JSON"
        ),
    )
    parser.add_argument(
        "--session-action",
        action="append",
        default=[],
        help="single action or repeatable worker=action mapping",
    )
    parser.add_argument(
        "--session-action-reason",
        default="",
        help=(
            "required for every session action; when any session_action=rotate "
            "this reason must equal --rotation-reason exactly (e.g. "
            "role_isolation), otherwise the run is rejected before any grant, "
            "task, or lock is created"
