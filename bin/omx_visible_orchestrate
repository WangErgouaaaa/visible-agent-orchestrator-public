    )
    parser.add_argument(
        "--rotation-reason",
        default="",
        help=(
            "required when any session_action=rotate; sanctioned values: "
            "manual_new, role_isolation, context_domain_changed, "
            "contract_breaking_changed, context_contaminated, "
            "context_rollover, recovery_restart, worker_reuse. "
            "context_domain_changed is not configured on this entry; use "
            "omx_visible_dispatch run-one with distinct --context-domain-id "
            "and --previous-context-domain-id. Ordinary new work uses "
            "worker_reuse with rehydration-packet-type new-task."
        ),
