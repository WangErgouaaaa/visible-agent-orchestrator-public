def cmd_dry_run_register(args: argparse.Namespace) -> int:
    metadata = backend_metadata(args.backend)
    canonical = metadata["name"]
    config, config_evidence = resolve_config_for_args(args, public_backend_name(canonical))
    config_source = config_evidence.config_path or config_evidence.config_source
    request = DryRunRegistrationRequest(
        backend_kind=public_backend_name(canonical),
        worker_id=args.worker_id,
        workspace_root=args.workspace_root,
        runtime_backend=args.runtime_backend,
        runtime_binding_kind=args.runtime_binding_kind,
        pane_id=args.pane_id,
        process_id=args.process_id,
        port=args.port,
        user_owned_pane=args.user_owned_pane,
        user_authorization_record=args.user_authorization_record,
        allowed_write_roots=list(args.allowed_write_root or []),
        allowed_read_roots=list(args.allowed_read_root or []),
        task_profile=args.task_profile,
        notes=list(args.note or []),
    )
    plan = build_dry_run_registration_plan(request, config=config, config_source=config_source)
    payload = {
        "schema_version": 1,
        "backend": public_backend_name(canonical),
        "canonical_backend": canonical,
        "config_path": config_source,
        "config_source": config_source,
        "config_found": config_evidence.config_found,
        "config_missing": config_evidence.config_missing,
        "fallback_used": config_evidence.fallback_used,
        "fail_closed_due_to_missing_config": config_evidence.fail_closed_due_to_missing_config,
        "config_path_evidence": config_evidence.to_dict(),
        **plan.to_dict(),
    }
    emit(payload, json_output=args.json)
    return 0


def cmd_preflight_evidence(args: argparse.Namespace) -> int:
    requested = public_backend_name(canonical_backend(args.backend))
    authorization_record_path = Path(args.authorization_record).resolve() if args.authorization_record else None
    if args.request:
        evidence = collect_preflight_evidence_from_fixture(
            Path(args.request).resolve(),
            authorization_record_path=authorization_record_path,
        )
        if evidence.backend_kind != requested:
            raise RuntimeAdapterError(f"request backend mismatch: {evidence.backend_kind} != {requested}")
        emit({"schema_version": 1, **evidence.to_dict()}, json_output=args.json)
        return 0
    if not args.allow_read_live:
        raise RuntimeAdapterError("preflight-evidence without --request requires explicit --allow-read-live")

    config_payload = {}
    if args.config:
        config_payload = read_json(Path(args.config).resolve())
    payload = {
        "backend_kind": requested,
        "worker_id": args.worker_id,
        "workspace_root": args.workspace_root,
        "runtime_backend": args.runtime_backend,
        "runtime_binding_kind": args.runtime_binding_kind,
        "pane_id": args.pane_id,
        "process_id": args.process_id,
        "port": args.port,
        "user_owned_pane": args.user_owned_pane,
        "user_authorization_record": args.user_authorization_record,
        "authorization_record_path": str(authorization_record_path) if authorization_record_path else "",
        "expected_business_index_files": list(args.expected_business_index or []),
        "allowed_workspace_roots": list(args.allowed_workspace_root or []),
        "allowed_read_roots": list(args.allowed_read_root or []),
        "allowed_write_roots": list(args.allowed_write_root or []),
        "notes": list(args.note or []),
        "runtime_health_evidence": {
            "health_ok": False,
            "policy_ok": False,
            "doctor_ok": False,
            "reason": "live-readonly command collection is intentionally conservative; no live command was called",
        },
    }
    if config_payload:
        payload["live_enable_config"] = config_payload
    request = DryRunPreflightRequest.from_dict(payload)
    evidence = collect_preflight_evidence_from_payload(request.to_dict() | payload, evidence_source="live-readonly")
    emit({"schema_version": 1, **evidence.to_dict()}, json_output=args.json)
    return 0


