        claude_live.add_argument("--runtime-binding-kind", default="tmux-pane", help="pane/process/headless binding kind")
        claude_live.add_argument("--pane-id", default="", help="candidate pane id")
        claude_live.add_argument("--pane-pid", default="", help="candidate pane pid")
        claude_live.add_argument("--process-id", default="", help="candidate process id")
        claude_live.add_argument("--command", default="", help="candidate command path")
        claude_live.add_argument("--user-owned-pane", action="store_true", help="candidate binding is a user-owned pane")
        claude_live.add_argument("--task-dir", default="", help="future task artifact directory")
        claude_live.add_argument("--task-id", default="", help="future task id")
        claude_live.add_argument("--prompt-text", default="", help="future prompt text for planning only")
        claude_live.add_argument("--prompt-file", default="", help="future prompt file path for audited tmux load-buffer")
        claude_live.add_argument("--authorization-record", default="", help="explicit authorization record JSON")
        claude_live.add_argument("--config", default="", help="optional live enable config JSON")
        claude_live.add_argument("--allowed-write-root", action="append", help="candidate allowed write root")
        claude_live.add_argument("--forbidden-path", action="append", help="candidate forbidden path")
        claude_live.add_argument("--expected-output", action="append", help="expected worker output path or marker")
        claude_live.add_argument("--report-path", default="", help="expected report.md path")
        claude_live.add_argument("--terminal-marker", action="append", help="allowed terminal marker name")
        claude_live.add_argument("--allow-real", action="store_true", help="authorize real submit attempt if all gates pass")
        claude_live.add_argument("--allow-tmux-input", action="store_true", help="authorize dedicated adapter tmux input if all gates pass")
