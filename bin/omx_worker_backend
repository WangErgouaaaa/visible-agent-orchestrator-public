def cmd_registered_worker_plan(args: argparse.Namespace) -> int:
    if args.record:
        payload = read_json(Path(args.record).resolve())
        base_path = Path(args.record).resolve().parent
    else:
        payload = build_registered_worker_record(
            backend_kind=public_backend_name(canonical_backend(args.backend)),
            worker_id=args.worker_id,
            workspace_root=args.workspace_root,
            runtime_backend=args.runtime_backend,
            runtime_binding_kind=args.runtime_binding_kind,
            pane_id=args.pane_id,
            pane_pid=args.pane_pid,
            process_id=args.process_id,
            command=args.command,
            user_owned_pane=args.user_owned_pane,
            authorization_record=args.authorization_record,
            live_enable_config=args.config or args.live_enable_config,
            smoke_evidence_path=args.last_smoke_artifact or args.smoke_evidence_path,
        ).to_dict()
        base_path = args.root
    plan = plan_registered_claude_worker(
        payload,
        registry_path=args.registry_path,
        base_path=base_path,
        allow_register=args.allow_register,
    )
    emit({"schema_version": 1, **plan.to_dict()}, json_output=args.json)
    return 0


def _registered_registry_allowed_roots(args: argparse.Namespace) -> list[Path]:
    root = getattr(args, "root", source_root())
    roots = [
        Path(root).resolve() / "tests",
        Path(tempfile.gettempdir()).resolve(),
    ]
    if getattr(args, "allow_framework_registry", False):
        roots.append(Path(root).resolve() / ".omx" / "framework" / "team" / "registered-workers")
    return roots


