def _mixed_ready_update_request_from_args(args: argparse.Namespace) -> MixedReadyUpdateRequest:
    fixture = getattr(args, "fixture", None)
    if fixture:
        return _mixed_ready_update_request_from_fixture(Path(fixture).resolve(), args)
    runtime_telemetry = read_json(Path(args.runtime_telemetry).resolve()) if args.runtime_telemetry else None
    return MixedReadyUpdateRequest(
        root=str(args.root),
        worker_id=args.worker_id,
        registered_worker_registry_path=str(Path(args.registered_worker_registry).resolve()),
        opencode_visible_registry_path=str(Path(args.opencode_visible_registry).resolve()),
        done_smoke_path=str(Path(args.done_smoke).resolve()),
        blocked_smoke_path=str(Path(args.blocked_smoke).resolve()),
        fail_smoke_path=str(Path(args.fail_smoke).resolve()),
        execution_mode=args.execution_mode,
        runtime_telemetry=runtime_telemetry or {},
        claude_allowed_write_roots=list(args.claude_allowed_write_root or []),
        opencode_allowed_write_roots=list(args.opencode_allowed_write_root or []),
        business_repo_writes_requested=args.business_repo_writes_requested,
        cursor_requested=args.cursor_requested,
        fixture_only=args.fixture_only,
        allow_framework_registry=args.allow_framework_registry,
        allow_mixed_ready_update=getattr(args, "allow_mixed_ready_update", False),
        propose_business_ready=args.propose_business_ready,
        propose_allow_business_repo_writes=args.propose_allow_business_repo_writes,
    )


def _fixture_path(value: str, base: Path) -> str:
    path = Path(value)
    if not path.is_absolute():
        path = base / path
    return str(path.resolve())


def _mixed_ready_update_request_from_fixture(fixture: Path, args: argparse.Namespace) -> MixedReadyUpdateRequest:
    payload = read_json(fixture / "request.json") if (fixture / "request.json").is_file() else {}
    source_fixture = str(payload.get("source_mixed_readiness_fixture", ""))
    base = fixture
    if source_fixture:
        base = (fixture.parent.parent / "mixed-readiness" / source_fixture).resolve()
    root = Path(str(payload.get("root", fixture))).resolve()
    registered = str(
        payload.get(
            "registered_worker_registry_path",
            payload.get("registered_worker_registry", ".omx/framework/team/registered-workers/registered-workers.json"),
        )
    )
    opencode = str(payload.get("opencode_visible_registry_path", payload.get("opencode_visible_registry", ".omx/framework/team/opencode_visible_workers.json")))
    done = str(payload.get("done_smoke_path", payload.get("done_smoke", "smokes/done/task-001")))
    blocked = str(payload.get("blocked_smoke_path", payload.get("blocked_smoke", "smokes/blocked/task-001")))
    fail = str(payload.get("fail_smoke_path", payload.get("fail_smoke", "smokes/fail/task-001")))
    runtime_path = Path(_fixture_path(str(payload.get("runtime_telemetry_path", "runtime-telemetry.json")), base))
    runtime_telemetry = read_json(runtime_path) if runtime_path.is_file() else {}
    return MixedReadyUpdateRequest(
        root=str(root),
        worker_id=str(payload.get("worker_id", getattr(args, "worker_id", "") or "vc-fixture-claude")),
        registered_worker_registry_path=_fixture_path(registered, base),
        opencode_visible_registry_path=_fixture_path(opencode, base),
        done_smoke_path=_fixture_path(done, base),
        blocked_smoke_path=_fixture_path(blocked, base),
        fail_smoke_path=_fixture_path(fail, base),
        execution_mode=str(payload.get("execution_mode", "no-live")),
        runtime_telemetry=runtime_telemetry,
        claude_allowed_write_roots=list(payload.get("claude_allowed_write_roots", [])),
        opencode_allowed_write_roots=list(payload.get("opencode_allowed_write_roots", [])),
        business_repo_writes_requested=bool(payload.get("business_repo_writes_requested", False)),
        cursor_requested=bool(payload.get("cursor_requested", False)),
        fixture_only=True,
        allow_framework_registry=bool(payload.get("allow_framework_registry", False)),
        allow_mixed_ready_update=bool(payload.get("allow_mixed_ready_update", False)),
        propose_business_ready=bool(payload.get("propose_business_ready", False)),
        propose_allow_business_repo_writes=bool(payload.get("propose_allow_business_repo_writes", False)),
        readiness_gate_overrides=dict(payload.get("readiness_gate_overrides", {})),
    )


def cmd_claude_mixed_ready_update_plan(args: argparse.Namespace) -> int:
    request = _mixed_ready_update_request_from_args(args)
    plan = build_mixed_ready_update_plan(request)
    emit(plan.to_dict(), json_output=args.json)
    return 0


def cmd_claude_mixed_ready_update(args: argparse.Namespace) -> int:
    request = _mixed_ready_update_request_from_args(args)
    result = write_mixed_ready_update(request)
    emit({"schema_version": 1, **result.to_dict()}, json_output=args.json)
    return 0 if result.wrote_registry else 1


def cmd_validate_mixed_ready_registry_update(args: argparse.Namespace) -> int:
    payload = read_json(Path(args.update).resolve())
    result = validate_mixed_ready_update_record(payload)
    emit(result, json_output=args.json)
    return 0 if result["ok"] else 1


def _registration_evidence_request_payload_from_args(args: argparse.Namespace, backend: str) -> dict:
    required = {
        "--worker-id": args.worker_id,
        "--workspace-root": args.workspace_root,
        "--runtime-backend": args.runtime_backend,
    }
    missing = [flag for flag, value in required.items() if not value]
    if missing:
        raise RuntimeAdapterError(f"missing required registration evidence arguments: {', '.join(missing)}")
    return {
        "backend_kind": backend,
        "worker_id": args.worker_id,
        "worker_label": args.worker_label,
        "workspace_root": args.workspace_root,
        "runtime_backend": args.runtime_backend,
        "runtime_binding_kind": args.runtime_binding_kind,
        "pane_id": args.pane_id,
        "process_id": args.process_id,
        "port": args.port,
        "user_owned_pane": args.user_owned_pane,
        "authorization_record_path": str(Path(args.authorization_record).resolve()) if args.authorization_record else "",
        "live_enable_config_path": str(Path(args.config).resolve()) if args.config else "",
        "preflight_request_path": str(Path(args.preflight_request).resolve()) if args.preflight_request else "",
        "expected_business_index_files": list(args.expected_business_index or []),
        "allow_mixed_worker": args.allow_mixed_worker,
        "notes": list(args.note or []),
    }


def _write_json_under_root(root: Path, output: Path, payload: dict) -> None:
    output_path = output.resolve()
    try:
        output_path.relative_to(root.resolve())
    except ValueError as exc:
        raise RuntimeAdapterError(f"output must stay under source root: {output_path}") from exc
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False) + "\n", encoding="utf-8")


def contract_worker_id(contract: dict, workers: list) -> str:
    value = contract.get("worker_id")
    if isinstance(value, str) and value:
        return value
    worker = contract.get("worker")
    if isinstance(worker, dict) and isinstance(worker.get("worker_id"), str):
        return worker["worker_id"]
    if workers:
        return str(workers[0].worker_id)
    raise RuntimeAdapterError("contract must provide worker_id or fixture must contain at least one worker")


def validate_contract_backend(contract: dict, backend: str) -> None:
    contract_backend = contract.get("backend")
    if contract_backend and canonical_backend(str(contract_backend)) != canonical_backend(backend):
        raise RuntimeAdapterError(f"contract backend mismatch: {contract_backend} != {backend}")


def cmd_plan(args: argparse.Namespace) -> int:
    canonical = canonical_backend(args.backend)
    if canonical == "opencode-tui":
        raise RuntimeAdapterError("opencode_tui planning belongs to omx_visible_dispatch; worker backend CLI does not direct submit")
    contract = read_json(Path(args.contract).resolve())
    validate_contract_backend(contract, args.backend)
    adapter = adapter_from_args(args)
    workers = adapter.discover_workers(args.root)
    worker_id = contract_worker_id(contract, workers)
    result = adapter.submit_plan(args.root, worker_id, task_reference={"source": "fixture-contract", "contract": args.contract})
    payload = {
        **backend_payload(args),
        "contract_path": str(Path(args.contract).resolve()),
        "fixture_path": str(Path(args.fixture).resolve()),
        "ok": True,
        "contract": {
            "worker_id": worker_id,
            "allowed_write_scope": contract.get("allowed_write_scope", []),
            "requires_report_marker": bool(contract.get("requires_report_marker", True)),
        },
        **result.to_dict(),
    }
    emit(payload, json_output=args.json)
    return 0


def terminal_markers_from_result(result: dict) -> list[str]:
    markers = result.get("terminal_markers")
    if isinstance(markers, list):
        return [str(item) for item in markers if str(item) in {"done", "fail", "blocked"}]
    marker = result.get("terminal_marker")
    if isinstance(marker, str) and marker in {"done", "fail", "blocked"}:
        return [marker]
    found = []
    for name in ("done", "fail", "blocked"):
        if result.get(name) is True:
            found.append(name)
    return found


def write_paths_from_result(result: dict) -> list[str]:
    paths = []
    for item in result.get("writes", []):
        if isinstance(item, str):
            paths.append(item)
        elif isinstance(item, dict) and isinstance(item.get("path"), str):
            paths.append(item["path"])
    return paths


def path_in_scope(path: str, allowed_scopes: list[str]) -> bool:
    clean = Path(path).as_posix().lstrip("/")
    for scope in allowed_scopes:
        allowed = Path(str(scope)).as_posix().lstrip("/")
        if clean == allowed or clean.startswith(f"{allowed.rstrip('/')}/"):
            return True
    return False


def cmd_validate_result(args: argparse.Namespace) -> int:
    canonical = canonical_backend(args.backend)
    if canonical == "opencode-tui":
        raise RuntimeAdapterError("opencode_tui results are validated by visible task reports, not this fixture CLI")
    contract = read_json(Path(args.contract).resolve())
    result = read_json(Path(args.result).resolve())
    validate_contract_backend(contract, args.backend)
    adapter = adapter_from_args(args)
    workers = adapter.discover_workers(args.root)
    worker_id = contract_worker_id(contract, workers)

    errors = []
    markers = terminal_markers_from_result(result)
    report_text = str(result.get("report", ""))
    if contract.get("requires_report_marker", True) and len(markers) != 1:
        errors.append(f"expected exactly one terminal marker, got {markers}")
    if not report_text.strip():
        errors.append("report must be non-empty")
    allowed_scopes = [str(item) for item in contract.get("allowed_write_scope", [])]
    out_of_scope = [path for path in write_paths_from_result(result) if allowed_scopes and not path_in_scope(path, allowed_scopes)]
    if out_of_scope:
        errors.append(f"out-of-scope writes: {out_of_scope}")

    payload = {
        **backend_payload(args),
        "contract_path": str(Path(args.contract).resolve()),
        "result_path": str(Path(args.result).resolve()),
        "fixture_path": str(Path(args.fixture).resolve()),
        "worker_id": worker_id,
        "ok": not errors,
        "terminal_markers": markers,
        "report_non_empty": bool(report_text.strip()),
        "allowed_write_scope": allowed_scopes,
        "writes": write_paths_from_result(result),
        "out_of_scope_writes": out_of_scope,
        "errors": errors,
        "warnings": [
            f"{public_backend_name(canonical)} validate-result is fixture-only; no live process is contacted"
        ],
    }
    emit(payload, json_output=args.json)
    return 0 if not errors else 1


def cmd_workers(args: argparse.Namespace) -> int:
    adapter = adapter_from_args(args)
    payload = {
        **backend_payload(args),
        "workers": [worker.to_dict() for worker in adapter.discover_workers(args.root)],
    }
    emit(payload, json_output=args.json)
    return 0


def cmd_resolve(args: argparse.Namespace) -> int:
    adapter = adapter_from_args(args)
    result = adapter.resolve_worker(args.root, args.worker)
    payload = {**backend_payload(args), **result.to_dict()}
    emit(payload, json_output=args.json)
    return 0


def cmd_verify(args: argparse.Namespace) -> int:
    adapter = adapter_from_args(args)
    result = adapter.verify_worker(args.root, args.worker)
    payload = {**backend_payload(args), **result.to_dict()}
    emit(payload, json_output=args.json)
    return 0 if result.ok else 1


def cmd_readiness(args: argparse.Namespace) -> int:
    adapter = adapter_from_args(args)
    result = adapter.fetch_readiness(args.root, args.worker)
    payload = {**backend_payload(args), **result.to_dict(), "dispatch_allowed": False}
    emit(payload, json_output=args.json)
    return 0


def cmd_submit_plan(args: argparse.Namespace) -> int:
    adapter = adapter_from_args(args)
    result = adapter.submit_plan(args.root, args.worker, task_reference={"source": "cli-plan"})
    payload = {**backend_payload(args), **result.to_dict()}
    emit(payload, json_output=args.json)
    return 0


def add_backend_args(sub: argparse.ArgumentParser, *, worker: bool = False) -> None:
    sub.add_argument("--root", type=repo_root, default=runtime_root(), help="repository root")
    sub.add_argument(
        "--backend",
        required=True,
        choices=sorted(BACKEND_ALIASES),
        help="worker backend",
    )
    sub.add_argument("--fixture", help="fixture directory containing worker-backends.json")
    sub.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    if worker:
        sub.add_argument("--worker", required=True, help="worker id")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="omx_worker_backend",
        description=(
            "Read-only WorkerBackend utility. It does not call Claude Code, Cursor Agent, "
            "OpenCode, rmux, tmux input, or mutate live runtime state."
        ),
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    list_cmd = subparsers.add_parser("list-backends", help="show worker agent backends")
    list_cmd.add_argument("--root", type=repo_root, default=runtime_root(), help="repository root")
    list_cmd.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    list_cmd.set_defaults(func=cmd_list_backends)

    list_public = subparsers.add_parser("list", help="show public worker backend names")
    list_public.add_argument("--root", type=repo_root, default=runtime_root(), help="repository root")
    list_public.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    list_public.set_defaults(func=cmd_list)

    config_paths = subparsers.add_parser("config-paths", help="show live-enable config path resolution")
    config_paths.add_argument("--root", type=repo_root, default=runtime_root(), help="repository root")
    config_paths.add_argument("--backend", default="claude_code", choices=sorted(BACKEND_ALIASES), help="worker backend")
    config_paths.add_argument("--config", help="optional live enable config JSON")
    config_paths.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    config_paths.set_defaults(func=cmd_config_paths)

    obsidian = subparsers.add_parser("obsidian-logging-check", help="dry-run Obsidian logging opt-in policy check")
    obsidian.add_argument("--root", type=repo_root, default=runtime_root(), help="repository root")
    obsidian.add_argument("--allow-obsidian-log", action="store_true", help="explicitly opt in to Obsidian logging")
    obsidian.add_argument("--target-vault-path", default="", help="explicit target Obsidian vault path")
    obsidian.add_argument("--target-note", default="", help="explicit target Obsidian note path")
    obsidian.add_argument("--purpose", default="", help="explicit logging purpose")
    obsidian.add_argument("--allowed-content-scope", default="", help="explicit allowed content scope")
    obsidian.add_argument("--append-only", action="store_true", help="authorize append-only note changes")
    obsidian.add_argument("--rollback-allowed", action="store_true", help="authorize rollback if a future write is requested")
    obsidian.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    obsidian.set_defaults(func=cmd_obsidian_logging_check)

    for name, handler, help_text in (
        ("interface", cmd_interface, "print the WorkerBackend interface document"),
        ("schema", cmd_schema, "print the worker backend contract schema"),
    ):
        sub = subparsers.add_parser(name, help=help_text)
        sub.add_argument("--root", type=repo_root, default=runtime_root(), help="repository root")
        sub.set_defaults(func=handler)

    workers = subparsers.add_parser("workers", help="list fixture workers for a backend")
    add_backend_args(workers)
    workers.set_defaults(func=cmd_workers)

    capabilities = subparsers.add_parser("capabilities", help="show backend capabilities without contacting live agents")
    capabilities.add_argument("--root", type=repo_root, default=runtime_root(), help="repository root")
    capabilities.add_argument("--backend", required=True, choices=sorted(BACKEND_ALIASES), help="worker backend")
    capabilities.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    capabilities.set_defaults(func=cmd_capabilities)

    eligibility = subparsers.add_parser(
        "check-live-eligibility",
        help="report whether a backend may be used for live submit without performing submit",
    )
    eligibility.add_argument("--root", type=repo_root, default=runtime_root(), help="repository root")
    eligibility.add_argument("--backend", required=True, choices=sorted(BACKEND_ALIASES), help="worker backend")
    eligibility.add_argument("--config", help="optional live enable config JSON")
    eligibility.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    eligibility.set_defaults(func=cmd_check_live_eligibility)

    live_status = subparsers.add_parser("live-enable-status", help="show fail-closed live enable status")
    live_status.add_argument("--root", type=repo_root, default=runtime_root(), help="repository root")
    live_status.add_argument("--backend", required=True, choices=sorted(BACKEND_ALIASES), help="worker backend")
    live_status.add_argument("--config", help="optional live enable config JSON")
    live_status.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    live_status.set_defaults(func=cmd_live_enable_status)

    live_check = subparsers.add_parser("live-enable-check", help="evaluate live enable gate without live calls")
    live_check.add_argument("--root", type=repo_root, default=runtime_root(), help="repository root")
    live_check.add_argument("--backend", required=True, choices=sorted(BACKEND_ALIASES), help="worker backend")
    live_check.add_argument("--config", help="optional live enable config JSON")
    live_check.add_argument("--workspace-root", default="", help="candidate workspace root")
    live_check.add_argument("--worker-id", default="", help="candidate worker id")
    live_check.add_argument("--runtime-backend", default="", help="candidate runtime substrate backend")
    live_check.add_argument("--user-owned-pane", action="store_true", help="candidate binding is a user-owned pane")
    live_check.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    live_check.set_defaults(func=cmd_live_enable_check)

    for name, handler, help_text in (
        ("claude-live-plan", cmd_claude_live_plan, "build a fail-closed Claude visible-pane live submit plan"),
        ("claude-live-submit", cmd_claude_live_submit, "return a fail-closed Claude visible-pane live submit result"),
    ):
