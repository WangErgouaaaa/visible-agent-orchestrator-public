    emit(result, json_output=args.json)
    return 0 if result.get("ok") else 1


def cmd_run_sandbox_role_live_smoke_package(args: argparse.Namespace) -> int:
    result = execute_sandbox_role_live_smoke_runner(
        {
            "package_dir": str(Path(args.package_dir).resolve()),
            "output_dir": str(Path(args.output_dir).resolve()) if args.output_dir else "",
            "allow_real": bool(args.allow_real),
            "timeout_seconds": int(getattr(args, "timeout", 240)),
            "dispatch_bin": str(Path(args.dispatch_bin).resolve()) if getattr(args, "dispatch_bin", "") else "",
        }
    )
    if getattr(args, "result_output", ""):
        result_output = Path(args.result_output).resolve()
        result["result_output_path"] = str(result_output)
        result_output.parent.mkdir(parents=True, exist_ok=True)
        result_output.write_text(
            json.dumps(result, indent=2, sort_keys=True, ensure_ascii=False) + "\n",
            encoding="utf-8",
        )
    emit(result, json_output=args.json)
    return 0 if result.get("ok") else 1


