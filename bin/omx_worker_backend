    def add_mixed_noop_live_args(sub: argparse.ArgumentParser, *, execute: bool = False) -> None:
        sub.add_argument("--root", type=repo_root, default=runtime_root(), help="runtime root")
        sub.add_argument("--registered-worker-registry", required=True, help="registered worker registry JSON")
        sub.add_argument("--opencode-visible-registry", required=True, help="OpenCode visible worker registry JSON")
        sub.add_argument("--include-worker", action="append", help="specific worker id to include")
        sub.add_argument("--execution-mode", default="no-live", choices=["no-live"], help="must remain no-live; live execution is authorized only by --allow-mixed-noop-live")
        sub.add_argument("--run-id", default="", help="optional mixed run id")
        sub.add_argument("--timeout", type=int, default=240, help="per-worker live timeout")
        sub.add_argument("--dispatch-bin", default="", help="override omx_visible_dispatch path for tests")
        sub.add_argument("--worker-backend-bin", default="", help="override omx_worker_backend path for tests")
        sub.add_argument("--watcher-bin", default="", help="override omx_visible_watcher path for tests")
        sub.add_argument("--live-enable-config", default="", help="override Claude live-enable config path")
        if execute:
            sub.add_argument("--allow-mixed-noop-live", action="store_true", help="explicitly authorize one controlled mixed no-op live run")
        sub.add_argument("--json", action="store_true", help="emit machine-readable JSON")

