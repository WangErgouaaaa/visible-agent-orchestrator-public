def cmd_build_registration_evidence_package(args: argparse.Namespace) -> int:
    requested = public_backend_name(canonical_backend(args.backend))
    if args.request:
        package = build_registration_evidence_package_from_fixture(Path(args.request).resolve())
    else:
        payload = _registration_evidence_request_payload_from_args(args, requested)
        package = build_registration_evidence_package(
            RegistrationEvidencePackageRequest.from_dict(payload),
            payload=payload,
            config_base=args.root,
        )
    if package.backend_kind != requested:
        raise RuntimeAdapterError(f"request backend mismatch: {package.backend_kind} != {requested}")
    payload = package.to_dict()
    if args.output:
        _write_json_under_root(args.root, Path(args.output), payload)
    emit(payload, json_output=args.json)
    return 0


def cmd_validate_registration_evidence_package(args: argparse.Namespace) -> int:
    result = validate_registration_evidence_package_file(Path(args.package).resolve())
    payload = result.to_dict()
    emit(payload, json_output=args.json)
    return 0 if result.ok else 1


def cmd_build_registered_worker_record(args: argparse.Namespace) -> int:
    record = build_registered_worker_record(
        backend_kind=public_backend_name(canonical_backend(args.backend)),
        worker_id=args.worker_id,
        workspace_root=args.workspace_root,
        runtime_backend=args.runtime_backend,
        runtime_binding_kind=args.runtime_binding_kind,
        pane_id=args.pane_id,
        pane_pid=args.pane_pid,
        process_id=args.process_id,
        command=args.command,
        port=args.port,
        user_owned_pane=args.user_owned_pane,
        registration_status=args.registration_status,
        live_enabled=args.live_enabled,
        allow_business_repo_writes=args.allow_business_repo_writes,
        allow_mixed_worker=args.allow_mixed_worker,
        authorization_record=args.authorization_record,
        live_enable_config=args.config or args.live_enable_config,
        smoke_evidence_path=args.last_smoke_artifact or args.smoke_evidence_path,
        notes=list(args.note or []),
    )
    validation = plan_registered_claude_worker(
        record,
        registry_path=args.registry_path,
        base_path=args.root,
        allow_register=args.allow_register,
    ).validation_result
    if args.output:
        if not args.allow_build_record_output:
            raise RuntimeAdapterError("--output requires --allow-build-record-output")
        write_record_under_root(args.root, Path(args.output), record)
    payload = {
        "schema_version": 1,
        "would_register": bool(args.allow_build_record_output),
        "would_write_registry": False,
        "would_write_state": False,
        "registry_record": record.to_dict(),
        "validation_result": validation,
        "warnings": [
            "build-registered-worker-record is dry-run/source-output only",
            "it does not write live registry or runtime state",
        ],
        "forbidden_next_actions": [
            "write live registry",
            "write runtime state",
            "touch Claude Code pane",
            "invoke claude or claude-code",
            "submit OpenCode live",
            "business repo writes",
            "mixed OpenCode plus Claude execution",
        ],
    }
    emit(payload, json_output=args.json)
    return 0


