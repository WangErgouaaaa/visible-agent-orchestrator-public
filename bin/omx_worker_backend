    dry_run = subparsers.add_parser("dry-run-register", help="plan worker registration without writing live registry")
    dry_run.add_argument("--root", type=repo_root, default=runtime_root(), help="repository root")
    dry_run.add_argument("--backend", required=True, choices=sorted(BACKEND_ALIASES), help="worker backend")
    dry_run.add_argument("--config", help="optional live enable config JSON")
    dry_run.add_argument("--worker-id", required=True, help="candidate worker id")
    dry_run.add_argument("--workspace-root", required=True, help="candidate workspace root")
    dry_run.add_argument("--runtime-backend", required=True, help="candidate runtime substrate backend")
    dry_run.add_argument("--runtime-binding-kind", default="", help="pane/process/headless binding kind")
    dry_run.add_argument("--pane-id", default="", help="candidate pane id")
    dry_run.add_argument("--process-id", default="", help="candidate process id")
    dry_run.add_argument("--port", default="", help="candidate port")
    dry_run.add_argument("--user-owned-pane", action="store_true", help="candidate binding is a user-owned pane")
    dry_run.add_argument("--user-authorization-record", default="", help="explicit authorization record reference")
    dry_run.add_argument("--allowed-write-root", action="append", help="candidate allowed write root")
    dry_run.add_argument("--allowed-read-root", action="append", help="candidate allowed read root")
    dry_run.add_argument("--task-profile", default="", help="candidate task profile")
    dry_run.add_argument("--note", action="append", help="extra dry-run note")
    dry_run.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    dry_run.set_defaults(func=cmd_dry_run_register)

    preflight = subparsers.add_parser("preflight-evidence", help="collect dry-run preflight evidence without live submit")
    preflight.add_argument("--root", type=repo_root, default=runtime_root(), help="repository root")
    preflight.add_argument("--backend", required=True, choices=sorted(BACKEND_ALIASES), help="worker backend")
    preflight.add_argument("--request", help="fixture request JSON")
    preflight.add_argument("--worker-id", default="", help="candidate worker id")
    preflight.add_argument("--workspace-root", default="", help="candidate workspace root")
    preflight.add_argument("--runtime-backend", default="", help="candidate runtime substrate backend")
    preflight.add_argument("--runtime-binding-kind", default="", help="pane/process/headless binding kind")
    preflight.add_argument("--pane-id", default="", help="candidate pane id")
    preflight.add_argument("--process-id", default="", help="candidate process id")
    preflight.add_argument("--port", default="", help="candidate port")
