INTERFACE_DOC = Path("worker-backends/worker-backend-interface.md")
CONTRACT_SCHEMA = Path("worker-backends/worker-backend-contract.schema.json")
LIVE_ENABLE_DEFAULT_CONFIG = Path("worker-backends/live-enable.default.disabled.json")
BACKEND_ALIASES = {
    "opencode_tui": "opencode-tui",
    "opencode-tui": "opencode-tui",
    "claude_code": "claude-code-fixture",
    "claude-code-fixture": "claude-code-fixture",
    "cursor_agent": "cursor-agent-fixture",
    "cursor-agent-fixture": "cursor-agent-fixture",
}
PUBLIC_BACKEND_NAMES = ("opencode_tui", "claude_code", "cursor_agent")


def repo_root(value: str) -> Path:
    root = Path(value).resolve()
    if not root.exists():
        raise argparse.ArgumentTypeError(f"root does not exist: {root}")
    source_repo_shape = (root / "README.md").exists()
    live_runtime_shape = (root / "AGENTS.md").exists() and (root / "bin").is_dir() and (root / ".omx").is_dir()
    installed_package_shape = (root / "bin").is_dir() and (root / "lib" / "visible_agent_orchestrator").is_dir()
    if not source_repo_shape and not live_runtime_shape and not installed_package_shape:
        raise argparse.ArgumentTypeError(f"root does not look like this repo: {root}")
    return root


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="replace")


def read_json(path: Path) -> dict:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise RuntimeAdapterError(f"JSON file missing: {path}") from exc
    except json.JSONDecodeError as exc:
        raise RuntimeAdapterError(f"invalid JSON file: {path}: {exc}") from exc
    if not isinstance(payload, dict):
        raise RuntimeAdapterError(f"JSON file must contain an object: {path}")
    return payload


def source_root() -> Path:
    return _THIS_FILE.parent.parent.resolve()


def resolve_config_for_args(args: argparse.Namespace, backend: str):
    config_path = getattr(args, "config", None)
    explicit = Path(config_path).resolve() if config_path else None
    return resolve_live_enable_config(
        backend,
        explicit_config=explicit,
        root=getattr(args, "root", source_root()),
        source_root=source_root(),
    )


def canonical_backend(name: str) -> str:
    try:
        return BACKEND_ALIASES[name]
    except KeyError as exc:
        raise RuntimeAdapterError(f"worker backend is not available: {name}") from exc


def public_backend_name(name: str) -> str:
    canonical = canonical_backend(name)
    for public, mapped in BACKEND_ALIASES.items():
        if public in PUBLIC_BACKEND_NAMES and mapped == canonical:
            return public
    return canonical


def backend_metadata(name: str) -> dict:
    canonical = canonical_backend(name)
    for item in available_backends():
        if item["name"] == canonical:
            return item
    raise RuntimeAdapterError(f"worker backend is not available: {name}")


def backend_payload(args: argparse.Namespace) -> dict:
    requested_backend = getattr(args, "backend", "")
    backend = canonical_backend(requested_backend) if requested_backend else ""
    fixture = getattr(args, "fixture", None)
    metadata = next((item for item in available_backends() if item["name"] == backend), {})
    return {
        "backend": backend,
        "requested_backend": requested_backend,
        "public_backend": public_backend_name(backend) if backend else "",
        "agent_kind": metadata.get("agent_kind", ""),
        "default_worker_backend": "opencode-tui",
        "live_enabled": is_backend_live_enabled(backend),
        "fixture_mode": bool(fixture),
        "fixture_only": bool(metadata.get("fixture_only", False)),
        "runtime_backend": metadata.get("runtime_backend", ""),
        "dispatch_adapter": metadata.get("dispatch_adapter", ""),
    }


def emit(payload: dict, *, json_output: bool) -> None:
    if json_output:
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
        return
    if "backends" in payload:
        for item in payload["backends"]:
            print(f"{item['name']}: {item['status']}")
            print(f"  agent_kind: {item['agent_kind']}")
            print(f"  fixture_only: {str(bool(item['fixture_only'])).lower()}")
            print(f"  live_enabled: {str(bool(item['live_enabled'])).lower()}")
        print("default worker backend: opencode-tui")
        return
    for key, value in payload.items():
        if isinstance(value, (dict, list)):
            print(f"{key}: {json.dumps(value, sort_keys=True, ensure_ascii=False)}")
        else:
            print(f"{key}: {value}")
    for warning in payload.get("warnings", []):
        print(f"warning: {warning}")
    for error in payload.get("errors", []):
        print(f"error: {error}")


def adapter_from_args(args: argparse.Namespace):
    fixture = getattr(args, "fixture", None)
    fixture_dir = Path(fixture).resolve() if fixture else None
    return get_backend(canonical_backend(args.backend), fixture_dir=fixture_dir)


def cmd_list_backends(args: argparse.Namespace) -> int:
    payload = {"backends": available_backends(), "default_worker_backend": "opencode-tui"}
    emit(payload, json_output=args.json)
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    items = []
    for public in PUBLIC_BACKEND_NAMES:
        metadata = backend_metadata(public)
        items.append(
            {
                **metadata,
                "backend": public,
                "canonical_backend": metadata["name"],
                "live_submit_requires_visible_dispatch_wrapper": metadata["name"] == "opencode-tui",
                "direct_submit_allowed": False,
                "live_submit_adapter_available": bool(metadata.get("live_submit_adapter_available", False)),
                "live_submit_runtime_enabled": bool(metadata.get("live_submit_runtime_enabled", False)),
            }
        )
    payload = {
        "schema_version": 1,
        "backends": items,
        "default_worker_backend": "opencode_tui",
        "notes": [
            "This CLI is fixture-only for Claude Code and Cursor Agent.",
            "OpenCode live submit remains delegated to omx_visible_dispatch; direct submit is not supported here.",
        ],
    }
    emit(payload, json_output=args.json)
    return 0


def cmd_interface(args: argparse.Namespace) -> int:
    path = args.root / INTERFACE_DOC
    if not path.is_file():
        raise RuntimeAdapterError(f"worker backend interface doc missing: {INTERFACE_DOC}")
    print(read_text(path))
    return 0


def cmd_schema(args: argparse.Namespace) -> int:
    path = args.root / CONTRACT_SCHEMA
    if not path.is_file():
        raise RuntimeAdapterError(f"worker backend contract schema missing: {CONTRACT_SCHEMA}")
    print(read_text(path))
    return 0


def cmd_config_paths(args: argparse.Namespace) -> int:
    backend = public_backend_name(canonical_backend(args.backend))
    explicit = Path(args.config).resolve() if args.config else None
    _, evidence = resolve_live_enable_config(
        backend,
        explicit_config=explicit,
        root=args.root,
        source_root=source_root(),
    )
    payload = {
        "schema_version": 1,
        "backend": backend,
        "root": str(args.root),
        "source_root": str(source_root()),
        "candidates": [candidate.to_dict() for candidate in discover_config_paths(
            explicit_config=explicit,
            root=args.root,
            source_root=source_root(),
        )],
        "selected": evidence.to_dict(),
    }
    emit(payload, json_output=args.json)
    return 0


def cmd_obsidian_logging_check(args: argparse.Namespace) -> int:
    result = validate_obsidian_logging_request(
        allow_obsidian_log=args.allow_obsidian_log,
        target_note=args.target_note,
        target_vault_path=args.target_vault_path,
        purpose=args.purpose,
        allowed_content_scope=args.allowed_content_scope,
        append_only=args.append_only,
        rollback_allowed=args.rollback_allowed,
    )
    emit({"schema_version": 1, **result.to_dict()}, json_output=args.json)
    return 0


def cmd_capabilities(args: argparse.Namespace) -> int:
    metadata = backend_metadata(args.backend)
    canonical = metadata["name"]
    supports_live_submit = backend_supports_live_submit(public_backend_name(canonical))
    adapter_available = backend_live_submit_adapter_available(public_backend_name(canonical))
    payload = {
        "schema_version": 1,
        "backend": public_backend_name(canonical),
        "canonical_backend": canonical,
        "agent_kind": metadata.get("agent_kind", ""),
        "fixture_only": bool(metadata.get("fixture_only", False)),
        "live_enabled": bool(metadata.get("live_enabled", False)),
        "supports_live_submit": supports_live_submit,
        "supports_live_submit_capability": supports_live_submit,
        "live_submit_adapter_available": adapter_available,
        "live_submit_runtime_enabled": bool(metadata.get("live_submit_runtime_enabled", False)),
        "direct_submit_allowed": False,
        "live_submit_requires_visible_dispatch_wrapper": canonical == "opencode-tui",
        "dispatch_adapter": metadata.get("dispatch_adapter", ""),
        "runtime_backend": metadata.get("runtime_backend", ""),
        "capabilities": [
            {
                "name": "fixture_plan",
                "supported": canonical != "opencode-tui",
                "detail": "fixture-only contract planning for candidate Claude/Cursor worker backends",
            },
            {
                "name": "validate_result",
                "supported": canonical != "opencode-tui",
                "detail": "validates fixture report marker and write-scope evidence without live process contact",
            },
            {
                "name": "live_submit",
                "supported": supports_live_submit,
                "detail": (
                    "OpenCode live submit requires omx_visible_dispatch wrapper"
                    if canonical == "opencode-tui"
                    else "live submit disabled for fixture-only backend"
                ),
            },
            {
                "name": "claude_visible_pane_live_plan",
                "supported": canonical == "claude-code-fixture" and adapter_available,
                "detail": (
                    "source-only Claude visible-pane live submit planning surface; disabled until separate live enable"
                    if canonical == "claude-code-fixture"
                    else "not a Claude Code backend"
                ),
            },
        ],
        "warnings": (
            []
            if canonical == "opencode-tui"
            else [
                f"{public_backend_name(canonical)} live_enabled=false",
                "technical adapter availability is not live enable" if adapter_available else "live adapter unavailable",
            ]
        ),
    }
    emit(payload, json_output=args.json)
    return 0


def cmd_check_live_eligibility(args: argparse.Namespace) -> int:
    metadata = backend_metadata(args.backend)
    canonical = metadata["name"]
    config, config_evidence = resolve_config_for_args(args, public_backend_name(canonical))
    config_source = config_evidence.config_path or config_evidence.config_source
    decision = evaluate_live_enable(
        backend_kind=public_backend_name(canonical),
        config=config,
        config_source=config_source,
    )
    eligible = decision.eligible
    payload = {
        "schema_version": 1,
        "backend": public_backend_name(canonical),
        "canonical_backend": canonical,
        "eligible": eligible,
        "live_enabled": decision.live_enabled,
        "fixture_only": bool(metadata.get("fixture_only", False)),
        "supports_live_submit": decision.capability_supports_live_submit,
        "supports_live_submit_capability": decision.capability_supports_live_submit,
        "live_submit_adapter_available": decision.live_submit_adapter_available,
        "live_submit_runtime_enabled": False,
        "direct_submit_allowed": False,
        "live_submit_requires_visible_dispatch_wrapper": canonical == "opencode-tui",
        "config_source": config_source,
        "config_path": config_source,
        "config_found": config_evidence.config_found,
        "config_missing": config_evidence.config_missing,
        "fallback_used": config_evidence.fallback_used,
        "fail_closed_due_to_missing_config": config_evidence.fail_closed_due_to_missing_config,
        "config_path_evidence": config_evidence.to_dict(),
        "blocked_reasons": decision.blocked_reasons,
        "warnings": decision.warnings + config_evidence.warnings,
        "reason": (
            "OpenCode is live-capable only through omx_visible_dispatch wrapper; this CLI does not direct submit"
            if canonical == "opencode-tui" and eligible
            else (
                "technical adapter exists, but disabled by live-enable config and authorization/preflight gates"
                if public_backend_name(canonical) == "claude_code" and decision.live_submit_adapter_available
                else f"{public_backend_name(canonical)} is fixture-only and live submit is disabled"
            )
        ),
        "forbidden_actions": [
            "direct adapter submit",
            "direct /tui/*",
            "tmux send-keys",
            "live claude-code/cursor-agent command invocation",
        ],
    }
    emit(payload, json_output=args.json)
    return 0


