    opencode_mixed_ready_validate.set_defaults(func=cmd_validate_opencode_mixed_ready_registry_update)

    def add_mixed_ready_update_args(sub: argparse.ArgumentParser, *, write: bool) -> None:
        sub.add_argument("--fixture", help="mixed-ready update fixture directory")
        sub.add_argument("--root", type=Path, default=runtime_root(), help="runtime, source, fixture, or temp root")
        sub.add_argument("--worker-id", default="", help="registered Claude worker id")
        sub.add_argument("--registered-worker-registry", default="", help="registered worker registry JSON")
        sub.add_argument("--opencode-visible-registry", default="", help="OpenCode visible worker registry JSON")
        sub.add_argument("--done-smoke", default="", help="task directory with non-empty report.md and .done")
        sub.add_argument("--blocked-smoke", default="", help="task directory with non-empty report.md and .blocked")
        sub.add_argument("--fail-smoke", default="", help="task directory with non-empty report.md and .fail")
        sub.add_argument("--execution-mode", default="no-live", choices=["no-live", "live"], help="default and only allowed mode is no-live")
        sub.add_argument("--runtime-telemetry", help="optional runtime telemetry JSON")
        sub.add_argument("--claude-allowed-write-root", action="append", help="candidate Claude write root")
        sub.add_argument("--opencode-allowed-write-root", action="append", help="candidate OpenCode write root")
        sub.add_argument("--business-repo-writes-requested", action="store_true", help="model a forbidden business repo write request")
        sub.add_argument("--cursor-requested", action="store_true", help="model a forbidden Cursor request")
        sub.add_argument("--fixture-only", action="store_true", help="skip live registry validation for local fixture files")
        sub.add_argument(
            "--allow-framework-registry",
            action="store_true",
            help="allow the explicit <root>/.omx/framework/team/registered-workers registry root",
        )
        sub.add_argument("--propose-business-ready", action="store_true", help="test-only forbidden proposed business_ready=true")
        sub.add_argument(
            "--propose-allow-business-repo-writes",
            action="store_true",
            help="test-only forbidden proposed allow_business_repo_writes=true",
        )
        if write:
            sub.add_argument("--allow-mixed-ready-update", action="store_true", help="explicitly allow this local mixed-ready registry write")
        sub.add_argument("--json", action="store_true", help="emit machine-readable JSON")

    mixed_ready_plan = subparsers.add_parser(
        "claude-mixed-ready-update-plan",
        help="plan a source-only Claude mixed_ready registry update without writing files",
    )
    add_mixed_ready_update_args(mixed_ready_plan, write=False)
    mixed_ready_plan.set_defaults(func=cmd_claude_mixed_ready_update_plan)

    mixed_ready_update = subparsers.add_parser(
        "claude-mixed-ready-update",
        help="write a Claude mixed_ready registry update with explicit allow flags",
    )
    add_mixed_ready_update_args(mixed_ready_update, write=True)
    mixed_ready_update.set_defaults(func=cmd_claude_mixed_ready_update)

    mixed_ready_validate = subparsers.add_parser(
        "validate-mixed-ready-registry-update",
        help="validate a mixed-ready registry update record",
    )
    mixed_ready_validate.add_argument("--root", type=repo_root, default=runtime_root(), help="repository root")
    mixed_ready_validate.add_argument("--update", required=True, help="mixed-ready update JSON")
    mixed_ready_validate.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    mixed_ready_validate.set_defaults(func=cmd_validate_mixed_ready_registry_update)

    plan = subparsers.add_parser("plan", help="build a fixture-only task plan from a contract")
    add_backend_args(plan)
    plan.add_argument("--contract", required=True, help="fixture contract JSON")
    plan.set_defaults(func=cmd_plan)

    validate = subparsers.add_parser("validate-result", help="validate fixture result protocol evidence")
    add_backend_args(validate)
    validate.add_argument("--contract", required=True, help="fixture contract JSON")
    validate.add_argument("--result", required=True, help="fixture result JSON")
    validate.set_defaults(func=cmd_validate_result)

    for name, handler, help_text in (
        ("resolve", cmd_resolve, "resolve one fixture worker"),
        ("verify", cmd_verify, "verify one fixture worker"),
        ("readiness", cmd_readiness, "read fixture readiness telemetry"),
        ("submit-plan", cmd_submit_plan, "build a non-mutating submit plan"),
    ):
        sub = subparsers.add_parser(name, help=help_text)
        add_backend_args(sub, worker=True)
        sub.set_defaults(func=handler)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except RuntimeAdapterError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
