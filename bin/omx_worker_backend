def _opencode_mixed_ready_update_request_from_args(args: argparse.Namespace) -> OpenCodeMixedReadyUpdateRequest:
    overrides = {}
    if getattr(args, "propose_business_ready", False):
        overrides["business_ready"] = True
    if getattr(args, "propose_allow_business_repo_writes", False):
        overrides["allow_business_repo_writes"] = True
    if getattr(args, "propose_binding_change", False):
        overrides["pane_id"] = "%999"
    if getattr(args, "propose_default_for_new_tasks", False):
        overrides["default_for_new_tasks"] = True
    return OpenCodeMixedReadyUpdateRequest(
        root=str(Path(args.root).resolve()),
        worker_id=args.worker_id,
        opencode_visible_registry_path=str(Path(args.opencode_visible_registry).resolve()),
        evidence_path=str(Path(args.evidence).resolve()),
        allow_framework_registry=getattr(args, "allow_framework_registry", False),
        allow_opencode_mixed_ready_update=getattr(args, "allow_opencode_mixed_ready_update", False),
        proposed_overrides=overrides,
    )


def cmd_opencode_mixed_ready_update_plan(args: argparse.Namespace) -> int:
    plan = build_opencode_mixed_ready_update_plan(_opencode_mixed_ready_update_request_from_args(args))
