def cmd_opencode_mixed_status(args: argparse.Namespace) -> int:
    root = Path(args.root_arg).resolve() if getattr(args, "root_arg", None) else args.root
    summary = source_opencode_mixed_status_summary(
        root,
        worker_id=args.worker_id or None,
        include_all=args.all_workers,
        execution_mode=args.execution_mode,
        opencode_visible_registry=args.opencode_visible_registry or None,
        registered_worker_registry=args.registered_worker_registry or None,
    )
    if args.json:
        print(json.dumps(summary, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print("\n".join(format_opencode_mixed_status_human(summary)))
    return 0 if summary.get("ok") else 1


