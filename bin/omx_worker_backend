    return 0


def cmd_live_enable_check(args: argparse.Namespace) -> int:
    metadata = backend_metadata(args.backend)
    canonical = metadata["name"]
    config, config_evidence = resolve_config_for_args(args, public_backend_name(canonical))
    config_source = config_evidence.config_path or config_evidence.config_source
    decision = evaluate_live_enable(
        backend_kind=public_backend_name(canonical),
        config=config,
        workspace_root=args.workspace_root,
        worker_id=args.worker_id,
        runtime_backend=args.runtime_backend,
        user_owned_pane=args.user_owned_pane,
        config_source=config_source,
    )
    payload = {
        "schema_version": 1,
        "backend": public_backend_name(canonical),
        "canonical_backend": canonical,
        "config_path": config_source,
        "config_source": config_source,
        "config_found": config_evidence.config_found,
        "config_missing": config_evidence.config_missing,
        "fallback_used": config_evidence.fallback_used,
        "fail_closed_due_to_missing_config": config_evidence.fail_closed_due_to_missing_config,
        "config_path_evidence": config_evidence.to_dict(),
        "eligible": decision.eligible,
        "live_enabled": decision.live_enabled,
        "supports_live_submit": decision.capability_supports_live_submit,
        "supports_live_submit_capability": decision.capability_supports_live_submit,
        "live_submit_adapter_available": decision.live_submit_adapter_available,
        "live_submit_runtime_enabled": False,
        "direct_submit_allowed": False,
        "live_submit_requires_visible_dispatch_wrapper": canonical == "opencode-tui",
        "blocked_reasons": decision.blocked_reasons,
        "warnings": decision.warnings + config_evidence.warnings,
        "decision": decision.to_dict(),
    }
    emit(payload, json_output=args.json)
    return 0


def _claude_live_request_from_args(args: argparse.Namespace) -> ClaudeLiveSubmitRequest:
    active_lock_count, active_lock_evidence_source = _active_owner_lock_count(args.root)
    return ClaudeLiveSubmitRequest(
        backend_kind="claude_code",
        worker_id=args.worker_id,
        workspace_root=args.workspace_root,
        runtime_backend=args.runtime_backend,
        runtime_binding_kind=args.runtime_binding_kind,
        pane_id=args.pane_id,
        pane_pid=args.pane_pid,
        process_id=args.process_id,
        command=args.command,
        user_owned_pane=args.user_owned_pane,
        task_dir=args.task_dir,
        task_id=args.task_id,
        prompt_text=args.prompt_text,
        prompt_file=args.prompt_file,
        authorization_record_path=args.authorization_record,
        live_enable_config_path=args.config,
        allowed_write_roots=list(args.allowed_write_root or []),
        forbidden_paths=list(args.forbidden_path or []),
        expected_outputs=list(args.expected_output or []),
        report_path=args.report_path,
        terminal_markers=list(args.terminal_marker or []),
        allow_real=args.allow_real,
        allow_tmux_input=args.allow_tmux_input,
        allow_user_owned_pane=args.allow_user_owned_pane,
        require_report_marker_protocol=not args.no_report_marker_protocol,
        active_lock_count=active_lock_count,
        active_lock_evidence_source=active_lock_evidence_source,
        dry_run=args.dry_run,
        notes=list(args.note or []),
    )


def _active_owner_lock_count(root: Path) -> tuple[int, str]:
    lock_dir = root / ".omx" / "framework" / "team" / "visible-runs" / "_locks"
    if not lock_dir.exists():
        return 0, str(lock_dir)
    count = 0
    for path in lock_dir.glob("*.lock.json"):
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            count += 1
            continue
        if not (payload.get("released_at") or payload.get("released")):
            count += 1
    return count, str(lock_dir)


