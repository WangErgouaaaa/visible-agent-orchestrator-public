def unique_worker_ids(values: list[str] | tuple[str, ...] | None) -> list[str]:
    ordered: list[str] = []
    seen: set[str] = set()
    for item in values or []:
        worker_id = str(item or "")
        if not worker_id or worker_id in seen:
            continue
        seen.add(worker_id)
        ordered.append(worker_id)
    return ordered


class RebindError(Exception):
    """Expected operator-facing failure."""

    def __init__(
        self,
        message: str,
        *,
        worker_id: str = "",
        status: str | None = None,
        conflicting_worker_ids: list[str] | None = None,
        result_path: str | None = None,
        facts: dict[str, Any] | None = None,
    ) -> None:
        super().__init__(message)
        self.worker_id = str(worker_id or "")
        self.status = status
        self.conflicting_worker_ids = unique_worker_ids(conflicting_worker_ids)
        self.result_path = result_path
        self.facts = dict(facts or {})


def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def stamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def root_path(value: str | None) -> Path:
    return runtime_root(value)


def guarded_tmux_argv(substrate: str, command: str, *args: str) -> list[str]:
    supported, reason = command_shape_supported(command, list(args))
    if not supported:
        raise RebindError(reason)
    return [substrate, command, *args]


def caller_pane_target_args(substrate: str) -> list[str]:
    pane_id = str(os.environ.get("TMUX_PANE") or "").strip()
    if substrate == "tmux" and re.fullmatch(r"%[0-9]+", pane_id):
        return ["-t", pane_id]
    return []


def framework_root(root: Path) -> Path:
    return root / ".omx" / "framework" / "team"


def rebind_root(root: Path) -> Path:
    return framework_root(root) / "rebind"


def backup_root(root: Path) -> Path:
    return framework_root(root) / "backups"


def registry_path(root: Path) -> Path:
    return framework_root(root) / "opencode_visible_workers.json"


def binding_pid_set(record: dict[str, Any]) -> set[int]:
    values: list[Any] = []
    for field in ("pane_pid", "opencode_pid"):
        values.append(record.get(field))
    for field in ("listener_pids", "opencode_pids", "strong_pid_matches"):
        raw = record.get(field)
        if isinstance(raw, list):
            values.extend(raw)
    result: set[int] = set()
    for value in values:
        try:
            parsed = int(value)
        except (TypeError, ValueError):
            continue
        if parsed > 0:
            result.add(parsed)
    return result


def process_instance_is_alive(pid: int, expected_start_time_ticks: int) -> bool:
    if int(pid or 0) <= 0 or int(expected_start_time_ticks or 0) <= 0:
        return False
    return (
        process_start_time_ticks(int(pid))
        == int(expected_start_time_ticks)
    )


def cross_boot_row_lost_port_ownership(
    root: Path,
    item: dict[str, Any],
    old_port: int,
) -> dict[str, Any] | None:
    """Positive evidence that a cross-boot registry row's recorded binding no
    longer owns its old port (#934). A reachable endpoint proves
    availability, not ownership: after a reboot a different fresh service
    can occupy the old port number while the row's own processes are gone.
    Proven only by a positive observation - the row's recorded OpenCode
    instance is positively absent or its pid was recycled (differing
    start-time ticks), or a successful port scan shows current listeners
    that exclude every pid the row recorded. Unknown observations (unreadable
    /proc, failed scan) prove nothing and keep the alias conflict."""
    recorded_pids: set[int] = set()
    pid_values: list[Any] = []
    if item.get("opencode_pid") is not None:
        pid_values.append(item.get("opencode_pid"))
    for key in ("opencode_pids", "listener_pids"):
        values = item.get(key)
        if isinstance(values, list):
            pid_values.extend(values)
    for value in pid_values:
        try:
            pid = int(value)
        except (TypeError, ValueError):
            continue
        if pid > 0:
            recorded_pids.add(pid)
    if not recorded_pids:
        return None
    try:
        opencode_pid = int(item.get("opencode_pid") or 0)
        opencode_ticks = int(item.get("opencode_start_time_ticks") or 0)
    except (TypeError, ValueError):
        opencode_pid = 0
        opencode_ticks = 0
    if (
        opencode_pid > 0
        and opencode_ticks > 0
        and process_instance_state(opencode_pid, opencode_ticks) == "dead"
    ):
        return {
            "old_opencode_process_dead": True,
            "recorded_opencode_pid": opencode_pid,
        }
    listeners = socket_discovery(root, old_port)
    listener_pids = {
        int(pid)
        for pid in listeners.get("listener_pids") or []
        if int(pid) > 0
    }
    if (
        not listeners.get("errors")
        and listeners.get("scan_succeeded")
        and listener_pids
        and listener_pids.isdisjoint(recorded_pids)
    ):
        # Only complete, unambiguous ownership evidence (a finished scan with
        # exactly one observed listener, errors empty) proves the old port is
        # now owned by different processes; a partial or ambiguous scan -
        # hidden or malformed listener lines - stays unknown and keeps the
        # conflict (#934).
        return {
            "old_opencode_process_dead": False,
            "current_listener_pids": sorted(listener_pids),
            "recorded_pids": sorted(recorded_pids),
        }
    return None


def ensure_target_quiescence(
    root: Path,
    worker_id: str,
    *,
    candidate: dict[str, Any] | None = None,
) -> list[Path]:
    lock_root = framework_root(root) / "visible-runs" / "_locks"
    locks = sorted(path for path in lock_root.glob("*.lock.json") if path.is_file())
    registry = read_json(registry_path(root))
    registry_workers = {
        str(item.get("worker_id") or ""): item
        for item in registry.get("workers", [])
        if isinstance(item, dict) and str(item.get("worker_id") or "")
    }
    target_locks = []
    collision_details: list[str] = []
    for path in locks:
        filename_worker_id = path.name.removesuffix(".lock.json")
        payload = read_json(path)
        payload_worker_id = payload.get("worker_id")
        if (
            filename_worker_id == worker_id
            or payload_worker_id == worker_id
            or not isinstance(payload_worker_id, str)
            or not payload_worker_id
            or payload_worker_id != filename_worker_id
        ):
            target_locks.append(path)
            continue
        if candidate is None:
            continue

        lock_binding = {
            **registry_workers.get(str(payload_worker_id), {}),
            **payload,
        }
        lock_boot = str(lock_binding.get("host_boot_id") or "")
        candidate_boot = str(candidate.get("host_boot_id") or "")
        if lock_boot and candidate_boot and lock_boot != candidate_boot:
            continue
        lock_server_pid = 0
        candidate_server_pid = 0
        try:
            lock_server_pid = int(lock_binding.get("tmux_server_pid") or 0)
        except (TypeError, ValueError):
            lock_server_pid = 0
        try:
            candidate_server_pid = int(candidate.get("tmux_server_pid") or 0)
        except (TypeError, ValueError):
            candidate_server_pid = 0
        # Same boot but a different tmux server generation means the pane
        # NUMBER may simply have been reused; only the pane-number reason is
        # exempt. Shared ports or processes are still real collisions.
        cross_server_generation = bool(
            lock_boot
            and candidate_boot
            and lock_boot == candidate_boot
            and lock_server_pid > 0
            and candidate_server_pid > 0
            and lock_server_pid != candidate_server_pid
        )
        reasons: list[str] = []
        lock_pane = str(lock_binding.get("pane_id") or "")
        candidate_pane = str(candidate.get("pane_id") or "")
        if (
            lock_pane
            and candidate_pane
            and lock_pane == candidate_pane
            and not cross_server_generation
        ):
            reasons.append(f"same pane {candidate_pane}")
        try:
            lock_port = int(lock_binding.get("port") or 0)
        except (TypeError, ValueError):
            lock_port = 0
        try:
            candidate_port = int(candidate.get("port") or 0)
        except (TypeError, ValueError):
            candidate_port = 0
        if lock_port and candidate_port and lock_port == candidate_port:
            reasons.append(f"same port {candidate_port}")
        shared_pids = binding_pid_set(lock_binding) & binding_pid_set(candidate)
        if shared_pids:
            reasons.append(
                "same binding pid " + ",".join(str(pid) for pid in sorted(shared_pids))
            )
        if reasons:
            target_locks.append(path)
            collision_details.append(f"{path.name}: {', '.join(reasons)}")
    if target_locks:
        names = ", ".join(path.name for path in target_locks)
        if collision_details:
            raise RebindError(
                f"target binding collision; refusing registry mutation: "
                + "; ".join(collision_details)
                + "; rebind the worker that currently holds the shared "
                "pane/port first; for a conflicting worker proven gone, run "
                "ITS OWN `omx_visible_rebind check --root <control-root> "
                "--worker <that-worker> --json` (accepted when status is "
                "binding_failed with errors, or port_not_live with no "
                "active owner lock) and then `omx_worker_backend "
                "opencode-visible-worker-disable --root <control-root> "
                "--worker-id <that-worker> --opencode-visible-registry "
                "<registry.json> --rebind-check <its-check.json> "
                "--allow-framework-registry --allow-worker-disable`",
                worker_id=worker_id,
                facts={"refusal_reason": "target_owner_lock"},
            )
        raise RebindError(
            f"target worker {worker_id} has an owner lock; refusing registry mutation: {names}",
            worker_id=worker_id,
            facts={"refusal_reason": "target_owner_lock"},
        )
    return locks


