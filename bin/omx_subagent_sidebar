#!/usr/bin/env python3
"""Display-only sidebar renderer for OpenCode subagent projection JSON."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


_THIS_FILE = Path(__file__).resolve()
for _p in ((_THIS_FILE.parent.parent / "src").resolve(), (_THIS_FILE.parent.parent / "lib").resolve()):
    if _p.exists() and str(_p) not in sys.path:
        sys.path.insert(0, str(_p))

from visible_agent_orchestrator.subagent_projection import build_subagent_projection
from visible_agent_orchestrator.subagent_sidebar import render_sidebar
from visible_agent_orchestrator.task_protocol_status import read_json, task_protocol_status
from visible_agent_orchestrator.runtime_paths import workspace_root


def scan_visible_run_tasks(root: Path) -> list[dict[str, str]]:
    """Minimal visible-runs task scan for the display-only sidebar.

    Task metadata comes from each task's own task.json; status comes from the
    shared task protocol reader. No backend or owner is assumed.
    """
    tasks: list[dict[str, str]] = []
    visible_runs = root / ".omx" / "framework" / "team" / "visible-runs"
    if not visible_runs.is_dir():
        return tasks
    for run_dir in sorted(p for p in visible_runs.iterdir() if p.is_dir()):
        tasks_root = run_dir / "tasks"
        if not tasks_root.is_dir():
            continue
        for task_dir in sorted(p for p in tasks_root.iterdir() if p.is_dir()):
            task_data = read_json(task_dir / "task.json")
            tasks.append({
                "backend": str(task_data.get("backend") or ""),
                "owner": str(task_data.get("owner") or ""),
                "run": run_dir.name,
                "id": str(task_data.get("id") or task_dir.name),
                "path": str(task_dir),
                "status": str(task_protocol_status(task_dir).get("status") or "prepared"),
            })
    return tasks


def command_sidebar(args: argparse.Namespace) -> int:
    if args.stdin_json:
        raw_projection = sys.stdin.read()
        try:
            projection = json.loads(raw_projection)
        except json.JSONDecodeError as exc:
            print(f"ERROR: invalid projection JSON: {exc}", file=sys.stderr)
            return 2
        if not isinstance(projection, dict):
            print("ERROR: projection JSON must be an object", file=sys.stderr)
            return 2
    else:
        root = workspace_root(args.root)
        projection = build_subagent_projection(root, scan_visible_run_tasks(root))
    print(render_sidebar(projection, width=args.width))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="omx_subagent_sidebar",
        description="Render opencode_subagent_projection JSON as a display-only terminal sidebar.",
    )
    parser.add_argument("--stdin-json", action="store_true", help="read opencode_subagent_projection JSON from stdin")
    parser.add_argument("--root", default=None, help="workspace root scanned for visible-run tasks when not using --stdin-json")
    parser.add_argument("--width", type=int, default=72, help="maximum output width, default: 72")
    parser.set_defaults(func=command_sidebar)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
