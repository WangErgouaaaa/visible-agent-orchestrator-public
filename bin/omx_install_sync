            f"source_commit={item['installed_source_git_commit'] or '-'} "
            f"recorded_sha256={item['recorded_target_sha256'] or '-'}"
        )
    for item in result["targets"]:
        print(
            f"target: {item['target_rel']} "
            f"parity={str(bool(item['parity'])).lower()} "
            f"event={item['installed_event_id'] or '-'} "
            f"source_repo={item['installed_source_repo'] or '-'} "
            f"source_commit={item['installed_source_git_commit'] or '-'} "
            f"recorded_sha256={item['recorded_target_sha256'] or '-'} "
            f"current_sha256={item['current_target_sha256'] or '-'}"
        )


def command_status(args: argparse.Namespace) -> int:
    target = Path(args.target)
    if not target.is_dir():
        raise InstallSyncError(f"status target root missing: {target.resolve()}")
    manifest_path = (
        Path(args.manifest) if getattr(args, "manifest", "") else None
    )
    source_root = (
        Path(args.source) if getattr(args, "source", "") else None
    )
    with global_mutation_gate(target, exclusive=False):
        result = build_install_status(target, manifest_path, source_root)
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print_install_status_human(result)
    return 0


def print_apply_human(result: dict[str, Any]) -> None:
    print("install_sync_apply")
    print("dry_run: false")
    print("writes_target: true")
    print(f"copies_files: {str(bool(result['copied_targets'])).lower()}")
    print(f"chmod: {str(bool(result['chmod_targets'])).lower()}")
    print(f"live_smoke: {str(bool(result.get('live_smoke'))).lower()}")
    print(f"source: {result['source']}")
    print(f"target: {result['target']}")
    print(f"backup_dir: {result['backup_dir']}")
    print(f"copied_count: {result['copied_count']}")
    print(f"backup_count: {result['backup_count']}")
    print(f"created_count: {result['created_count']}")
    print(f"updated_count: {result['updated_count']}")
    print(f"chmod_count: {result['chmod_count']}")
    for item in result["copied_targets"]:
        print(f"copied: {item['action']} {item['target_path']}")
    for item in result["chmod_targets"]:
        print(f"chmod: {item['target_path']} mode={item['old_target_mode']}->{item['new_target_mode']}")
    if result.get("live_smoke"):
        print(f"smoke_ok: {str(bool(result.get('smoke_ok'))).lower()}")
        if result.get("smoke_mode"):
            print(f"smoke_mode: {result['smoke_mode']}")
        if result.get("smoke_profile"):
            print(f"smoke_profile: {result['smoke_profile']}")
        if result.get("smoke_timeout_seconds"):
            print(f"smoke_timeout_seconds: {result['smoke_timeout_seconds']}")
        if result.get("smoke_worker"):
            print(f"smoke_worker: {result['smoke_worker']}")
        for item in result.get("smoke_results", []):
            if item.get("skipped"):
                print(f"smoke: {item['name']} skipped={item.get('reason', '-')}")
            else:
                print(
                    f"smoke: {item['name']} "
                    f"returncode={item.get('returncode')} "
                    f"timed_out={str(bool(item.get('timed_out'))).lower()} "
                    f"ok={str(bool(item.get('ok'))).lower()}"
                )
        for warning in result.get("smoke_warnings", []):
            print(f"smoke_warning: {warning}")
    for item in result.get("retired_targets", []):
        print(f"retired: {item['target_path']}")
    for item in result.get("retired_noop_targets", []):
        print(f"retire_noop: {item['target_path']}")
    if result.get("rollback_performed"):
        print("rollback_performed: true")
        print(
            "rollback_restored_count: "
            f"{result.get('rollback_result', {}).get('restored_count', 0)}"
        )
        print(
            "rollback_restored_retired_count: "
            f"{result.get('rollback_result', {}).get('restored_retired_count', 0)}"
        )
        print(
            "rollback_removed_created_count: "
            f"{result.get('rollback_result', {}).get('removed_created_count', 0)}"
        )
    elif result.get("rollback_error"):
        print("rollback_performed: false")
        print(f"rollback_error: {result['rollback_error']}")
    provenance = result.get("install_result_provenance")
    if isinstance(provenance, dict) and not provenance.get("ok"):
        print("install_result_provenance_ok: false")
        print(f"install_result_provenance_error: {provenance.get('error', '')}")


