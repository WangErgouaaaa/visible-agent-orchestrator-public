def rollback_failed_apply(
    result: dict[str, Any],
    target: Path,
    backup_dir: Path,
    *,
    failure_kind: str,
) -> int:
    failed_at = utc_now()
    try:
        rollback_result = rollback_backup(target, backup_dir)
    except Exception as exc:
        result["rollback_error"] = f"{type(exc).__name__}: {exc}"
        try:
            backup_manifest = load_backup_manifest(backup_dir)
            backup_manifest.update(
                {
                    "status": f"{failure_kind}_rollback_failed",
                    f"{failure_kind}_failed_at": failed_at,
                    f"{failure_kind}_rollback_error": result["rollback_error"],
                }
            )
            terminal_status = persist_terminal_backup_status(
                backup_dir,
                backup_manifest,
            )
        except Exception as status_exc:
            result["rollback_journal_error"] = (
                f"{type(status_exc).__name__}: {status_exc}"
            )
        else:
            if not terminal_status["primary_written"]:
                result["rollback_journal_fallback"] = (
                    terminal_status["fallback_path"]
                )
        return 3

    result["rollback_performed"] = True
    result["smoke_failed_rolled_back"] = failure_kind == "smoke"
    result["verification_failed_rolled_back"] = (
        failure_kind == "verification"
    )
    result["rollback_result"] = rollback_result
    try:
        backup_manifest = load_backup_manifest(backup_dir)
        backup_manifest.update(
            {
                "status": f"{failure_kind}_failed_rolled_back",
                f"{failure_kind}_failed_at": failed_at,
                "rollback_result": rollback_result,
            }
        )
        terminal_status = persist_terminal_backup_status(
            backup_dir,
            backup_manifest,
        )
    except Exception as exc:
        result["rollback_journal_error"] = f"{type(exc).__name__}: {exc}"
        return 3
    if not terminal_status["primary_written"]:
        result["rollback_journal_fallback"] = terminal_status["fallback_path"]
    return 2


def runtime_identity_closure_payload(plan: dict[str, Any]) -> dict[str, Any]:
    """Exact publication closure payload bound by capability scopes and
    leader-minted grants (#897): target root, source commit, manifest
    digest, and the full sorted per-target file closure."""
    target_root = Path(str(plan["target"])).resolve()
    source_commit = str(plan.get("source_git_commit") or "")
    manifest_sha256 = str(plan.get("manifest_sha256") or "")
    if (
        re.fullmatch(r"[0-9a-f]{40}", source_commit) is None
        or re.fullmatch(r"[0-9a-f]{64}", manifest_sha256) is None
    ):
        raise InstallSyncError("runtime identity publisher requires Git source provenance")
    targets: list[dict[str, Any]] = []
    for item in plan.get("files", []):
        target_rel = str(item.get("target_rel") or "")
        action = str(item.get("action") or "")
        if action in RETIRING_PLANNED_ACTIONS:
            removed_sha256 = str(item.get("retire_expected_sha256") or "")
            if re.fullmatch(r"[0-9a-f]{64}", removed_sha256) is None:
                raise InstallSyncError(
                    "runtime identity publisher plan closure is invalid"
                )
            targets.append(
                {
                    "target_rel": target_rel,
                    "removed_sha256": "sha256:" + removed_sha256,
                }
            )
            continue
        source_sha256 = str(item.get("source_sha256") or "")
        source_mode = item.get("source_mode")
        if (
            not target_rel
            or re.fullmatch(r"[0-9a-f]{64}", source_sha256) is None
            or type(source_mode) is not int
        ):
            raise InstallSyncError("runtime identity publisher plan closure is invalid")
        targets.append(
            {
                "target_rel": target_rel,
                "source_sha256": "sha256:" + source_sha256,
                "mode": source_mode,
            }
        )
    targets.sort(key=lambda item: str(item["target_rel"]))
    if len({str(item["target_rel"]) for item in targets}) != len(targets):
        raise InstallSyncError("runtime identity publisher plan closure is invalid")
    return {
        "action": "publish-runtime-identity",
        "target_root": str(target_root),
        "source_commit": source_commit,
        "manifest_sha256": "sha256:" + manifest_sha256,
        "targets": targets,
    }


def runtime_identity_capability_scope(plan: dict[str, Any]) -> dict[str, str]:
    return skill_generation_scope(runtime_identity_closure_payload(plan))


def require_runtime_identity_source(plan: dict[str, Any]) -> None:
    source_root = Path(str(plan.get("source") or "")).resolve()
    source_commit = str(plan.get("source_git_commit") or "")
    if (
        not plan.get("source_git_available")
        or bool(plan.get("source_git_dirty"))
        or re.fullmatch(r"[0-9a-f]{40}", source_commit) is None
    ):
        raise InstallSyncError(
            "runtime identity publisher requires clean Git source provenance"
        )
    for item in plan.get("files", []):
        source_rel = str(item.get("source_rel") or "")
        source_path = source_root / source_rel
        action = str(item.get("action") or "")
        if action in RETIRING_PLANNED_ACTIONS:
            if source_path.exists() or source_path.is_symlink():
                raise InstallSyncError(
                    "runtime identity publisher requires absent retirement "
                    f"source: {source_rel}"
                )
            listing = subprocess.run(
                [
                    "git",
                    "--no-replace-objects",
                    "-C",
                    str(source_root),
                    "ls-tree",
                    "-z",
                    source_commit,
                    "--",
                    source_rel,
                ],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
                timeout=10,
            )
            records = [
                record for record in listing.stdout.split(b"\0") if record
            ]
            if listing.returncode != 0 or records:
                raise InstallSyncError(
                    "runtime identity retirement source present in "
                    f"approved commit: {source_rel}"
                )
            continue
        try:
            observed = source_path.lstat()
        except OSError as exc:
            raise InstallSyncError(
                f"runtime identity publisher source is unreadable: {source_rel}"
            ) from exc
        if not stat.S_ISREG(observed.st_mode):
            raise InstallSyncError(
                f"runtime identity publisher requires regular source files: {source_rel}"
            )
        listing = subprocess.run(
            [
                "git",
                "--no-replace-objects",
                "-C",
                str(source_root),
                "ls-tree",
                "-z",
                source_commit,
                "--",
                source_rel,
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            timeout=10,
        )
        records = [record for record in listing.stdout.split(b"\0") if record]
        if listing.returncode != 0 or len(records) != 1:
            raise InstallSyncError(
                f"runtime identity source is absent from approved commit: {source_rel}"
            )
        try:
            header, encoded_path = records[0].split(b"\t", 1)
            tree_mode, object_type, object_id = header.decode("ascii").split(" ")
            tree_path = encoded_path.decode("utf-8")
        except (UnicodeDecodeError, ValueError) as exc:
            raise InstallSyncError(
                f"runtime identity source is unreadable in approved commit: {source_rel}"
            ) from exc
        source_sha256 = str(item.get("source_sha256") or "")
        source_mode = item.get("source_mode")
        if (
            tree_path != source_rel
            or tree_mode not in {"100644", "100755"}
            or object_type != "blob"
            or re.fullmatch(r"[0-9a-f]{40}", object_id) is None
            or type(source_mode) is not int
            or stat.S_IMODE(observed.st_mode) != source_mode
            or source_mode != int(tree_mode[-3:], 8)
            or re.fullmatch(r"[0-9a-f]{64}", source_sha256) is None
        ):
            raise InstallSyncError(
                f"runtime identity source differs from approved commit: {source_rel}"
            )
        blob = subprocess.run(
            [
                "git",
                "--no-replace-objects",
                "-C",
                str(source_root),
                "cat-file",
                "blob",
                object_id,
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            timeout=10,
        )
        if (
            blob.returncode != 0
            or hashlib.sha256(blob.stdout).hexdigest() != source_sha256
        ):
            raise InstallSyncError(
                f"runtime identity source differs from approved commit: {source_rel}"
            )


def runtime_identity_receipt_api() -> tuple[str, Callable[..., dict[str, Any]], Callable[..., dict[str, Any]]]:
    from visible_agent_orchestrator.companion_runtime_identity import (
        RUNTIME_IDENTITY,
        build_receipt,
        write_receipt,
    )

    return RUNTIME_IDENTITY, build_receipt, write_receipt


def publish_runtime_identity_receipt(result: dict[str, Any]) -> dict[str, Any]:
    runtime_identity, receipt_builder, receipt_writer = runtime_identity_receipt_api()
    event = result.get("mutation_event")
    receipt_source_commit = str(result["source_git_commit"])
    if not isinstance(event, dict):
        event = result.get("observed_prior_mutation")
        if (
            not isinstance(event, dict)
            or event.get("event_type") != "install_applied"
            or event.get("manifest_sha256") != result.get("manifest_sha256")
            or Path(str(event.get("target_root") or "")).resolve()
            != Path(str(result["target"])).resolve()
            or event.get("new_target_sha256") != installed_target_sha256(result)
        ):
            raise InstallSyncError(
                "runtime identity publisher requires an exact prior install mutation event"
            )
        # Zero-runtime-change republish (#931): this apply changed no target
        # bytes, so the runtime on target was installed by this prior trusted
        # ledger event. Reuse its credentials and keep attributing the
        # install to the commit that actually copied the bytes, even when
        # this apply's source commit differs (for example a release that
        # only changed companion Skills, docs, or tests). The identical
        # manifest digest plus the per-target parity loop below prove the
        # new commit expects exactly the installed bytes; a mismatched
        # manifest, a stale event, or actual target drift is rejected by the
        # checks above and the parity loop.
        receipt_source_commit = str(event["source_git_commit"])
    if not isinstance(event, dict) or not isinstance(event.get("event_id"), str):
        raise InstallSyncError("runtime identity publisher requires a new install mutation event")
    target_root = Path(str(result["target"])).resolve()
    targets: list[dict[str, Any]] = []
    for item in result.get("files", []):
        target_rel = str(item.get("target_rel") or "")
        action = str(item.get("action") or "")
        if action in RETIRING_PLANNED_ACTIONS:
            removed_sha256 = str(item.get("retire_expected_sha256") or "")
            if re.fullmatch(r"[0-9a-f]{64}", removed_sha256) is None:
                raise InstallSyncError(
                    f"runtime identity retirement preimage is missing: "
                    f"{target_rel}"
                )
            if os.path.lexists(target_root / target_rel):
                raise InstallSyncError(
                    f"runtime identity retired target is present: "
                    f"{target_rel}"
                )
            targets.append(
                {
                    "target_rel": target_rel,
                    "retired": True,
                    "removed_sha256": "sha256:" + removed_sha256,
                }
            )
            continue
        expected_sha256 = str(item.get("source_sha256") or "")
        target_path = target_root / target_rel
        with opened_target_parent(
            target_root,
            target_path,
            create_parents=False,
        ) as (
            parent_descriptor,
            target_name,
            verify_parent_identity,
        ):
            try:
                verify_parent_identity()
                descriptor = os.open(
                    target_name,
                    os.O_RDONLY
                    | os.O_NOFOLLOW
                    | os.O_NONBLOCK
                    | getattr(os, "O_CLOEXEC", 0),
                    dir_fd=parent_descriptor,
                )
            except OSError as exc:
                raise InstallSyncError(
                    f"runtime identity target is unreadable: {target_rel}"
                ) from exc
            try:
                observed = os.fstat(descriptor)
                if not stat.S_ISREG(observed.st_mode):
                    raise InstallSyncError(
                        f"runtime identity target is not a regular file: {target_rel}"
                    )
                current_sha256 = sha256_descriptor(descriptor)
                mode = stat.S_IMODE(observed.st_mode)
                verify_open_regular_entry(
                    descriptor,
                    parent_descriptor,
                    target_name,
                    expected_identity={
                        "st_dev": observed.st_dev,
                        "st_ino": observed.st_ino,
                    },
                    expected_sha256=expected_sha256,
                    expected_mode=mode,
                    error=(
                        "runtime identity target changed during verification: "
                        f"{target_rel}"
                    ),
                )
                verify_parent_identity()
            finally:
                os.close(descriptor)
        if (
            re.fullmatch(r"[0-9a-f]{64}", expected_sha256) is None
            or current_sha256 != expected_sha256
            or mode != item.get("source_mode")
        ):
            raise InstallSyncError(
                f"runtime identity target parity failed: {target_rel}"
            )
        targets.append(
            {
                "target_rel": target_rel,
                "expected_sha256": "sha256:" + expected_sha256,
                "current_sha256": "sha256:" + current_sha256,
                "mode": mode,
            }
        )
    targets.sort(key=lambda item: str(item["target_rel"]))
    receipt = receipt_builder(
        {
            "schema_version": 1,
            "runtime_identity": runtime_identity,
            "source_commit": receipt_source_commit,
            "manifest_sha256": "sha256:" + str(result["manifest_sha256"]),
            "contract_generation": TRUSTED_CONTRACT_GENERATION,
            "target_root": str(target_root),
            "targets": targets,
            "install_event_id": event["event_id"],
            "install_event_source_commit": str(event["source_git_commit"]),
            "runtime_attestation": False,
        }
    )
    return receipt_writer(str(held_exclusive_admission_root()), receipt)


def apply_prepared_plan(
    args: argparse.Namespace,
    target: Path,
    plan: dict[str, Any],
    *,
    publish_runtime_identity: bool,
    mutation_gate_held: bool,
    runtime_identity_authorization_id: str = "",
    install_events: list[dict[str, Any]] | None = None,
    transition_prepare: Callable[[dict[str, Any]], None] | None = None,
    transition_activate: Callable[[], None] | None = None,
) -> int:
    with (
        ExitStack()
        if mutation_gate_held
        else global_mutation_gate(target, exclusive=True)
    ):
        if not mutation_gate_held:
            ensure_global_quiescence(target)
        validate_target_preconditions(plan)
        apply_provenance = validate_apply_provenance(plan)
        if plan_requires_post_install_smoke(plan) and not bool(args.smoke):
            raise InstallSyncError(
                "post-install smoke required by manifest before mutating targets"
            )
        smoke_profile = str(
            plan.get("post_install_smoke_profile") or "default"
        )
        if smoke_profile == "offline_bootstrap":
            if not bool(args.smoke):
                raise InstallSyncError("post-install smoke required by offline_bootstrap before mutating targets")
            if any(record["target_exists"] for record in plan["files"]):
                raise InstallSyncError("offline_bootstrap requires absent install targets; use default smoke for updates")
            if any(os.path.lexists(target / relative) for relative in (
                ".omx/state",
                ".omx/framework/team/opencode_visible_workers.json",
                ".omx/framework/team/visible-runs",
            )):
                raise InstallSyncError("offline_bootstrap requires an unused worker runtime")
        if (
            bool(args.smoke)
            and smoke_profile == "default"
            and not str(args.smoke_worker or "").strip()
        ):
            raise InstallSyncError(
                "default post-install smoke requires explicit --smoke-worker "
                "before mutating targets"
            )
        events = (
            install_events
            if install_events is not None
            else read_install_mutation_events(target)
        )
        replay = replay_install_mutation_events(target, events)
        source_guard = validate_install_source_order(
            plan,
            current_target_install_provenance(plan, events),
            allow_stale_source=bool(
                getattr(args, "allow_stale_source", False)
            ),
            reason=str(getattr(args, "stale_source_reason", "") or ""),
        )
        pre_apply_items = plan.get("files", [])
        pre_apply_event_ids = {
            str(item["target_rel"]): str(
                (
                    replay["latest_by_target"].get(
                        str(item["target_rel"])
                    )
                    or ({}, "")
                )[0].get("event_id")
                or ""
            )
            for item in pre_apply_items
        }
        result = apply_plan(
            plan,
            Path(args.backup_dir),
            pre_apply_effective_event_id_by_target=pre_apply_event_ids,
            retain_created_anchors=True,
            on_backup_prepared=transition_prepare,
        )
        result["apply_provenance"] = apply_provenance
        result["stale_source_guard"] = source_guard
        if runtime_identity_authorization_id:
            result["runtime_identity_authorization_id"] = (
                runtime_identity_authorization_id
            )
        pre_smoke_parity = verify_install_parity(result)
        result["pre_smoke_parity"] = pre_smoke_parity
        result["install_parity_ok"] = bool(pre_smoke_parity["ok"])
        result["rollback_performed"] = False
        result["smoke_failed_rolled_back"] = False
        result["verification_failed_rolled_back"] = False
        return_code = 0
        if bool(args.smoke) and bool(pre_smoke_parity["ok"]):
            smoke = run_post_install_smoke(
                target,
                timeout=int(args.smoke_command_timeout),
                full_validate=bool(args.smoke_full_validate),
                worker_id=str(args.smoke_worker or ""),
                profile=smoke_profile,
            )
            result.update(
                {
                    "live_smoke": smoke_profile != "offline_bootstrap",
                    "smoke_ok": bool(smoke.get("smoke_ok")),
                    "smoke_mode": str(smoke.get("smoke_mode") or ""),
                    "smoke_profile": str(
                        smoke.get("smoke_profile") or "default"
                    ),
                    "smoke_timeout_seconds": int(smoke.get("smoke_timeout_seconds", 0) or 0),
                    "smoke_worker": str(smoke.get("smoke_worker") or ""),
                    "smoke_results": smoke.get("smoke_results", []),
                    "smoke_warnings": smoke.get("smoke_warnings", []),
                    "smoke_failure_domains": smoke.get("smoke_failure_domains", []),
                }
            )
            post_smoke_parity = verify_install_parity(result)
            result["post_smoke_parity"] = post_smoke_parity
            result["install_parity_ok"] = bool(
                pre_smoke_parity["ok"] and post_smoke_parity["ok"]
            )
            if not bool(post_smoke_parity["ok"]):
                result["smoke_warnings"] = [
                    *result["smoke_warnings"],
                    "post_install_target_parity_failed",
                ]
                result["smoke_failure_domains"] = sorted(
                    {
                        *result["smoke_failure_domains"],
                        "install_parity",
                    }
                )
        elif bool(args.smoke):
            result.update(
                {
                    "smoke_requested": True,
                    "smoke_ok": False,
                    "smoke_profile": smoke_profile,
                    "smoke_worker": str(args.smoke_worker or ""),
                    "smoke_results": [],
                    "smoke_warnings": [
                        "post_install_smoke_skipped:pre_smoke_parity_failed"
                    ],
                    "smoke_failure_domains": ["install_parity"],
                    "smoke_skipped_reason": "pre_smoke_parity_failed",
                }
            )

        failure_kind = ""
        if not bool(result["install_parity_ok"]):
            failure_kind = "verification"
        elif bool(args.smoke) and not bool(result.get("smoke_ok")):
            failure_kind = "smoke"
        if failure_kind:
            return_code = rollback_failed_apply(
                result,
                target,
                Path(args.backup_dir),
                failure_kind=failure_kind,
            )
        if return_code == 0:
            try:
                if (
                    result.get("copied_count")
                    or result.get("chmod_count")
                    or result.get("retired_count")
                    or result.get("copied_targets")
                    or result.get("chmod_targets")
                    or result.get("retired_targets")
                ):
                    result["mutation_event"] = (
                        append_install_mutation_event(result)
                    )
                elif all(
                    key in result
                    for key in (
                        "target",
                        "manifest_sha256",
                        "files",
                    )
                ):
                    prior = latest_matching_install_mutation(result)
                    if prior is not None:
                        result["observed_prior_mutation"] = prior
                if publish_runtime_identity:
                    result["runtime_identity_receipt"] = (
                        publish_runtime_identity_receipt(result)
                    )
            except Exception as exc:
                result[
                    (
                        "runtime_identity_provenance"
                        if publish_runtime_identity
                        else "mutation_provenance"
                    )
                ] = {
                    "ok": False,
                    "error": f"{type(exc).__name__}: {exc}",
                }
                return_code = 4
        try:
            persistence = persist_install_result(Path(args.backup_dir), result)
        except Exception as exc:
            persistence = {
                "ok": False,
                "install_result_written": False,
                "manifest_linked": False,
                "failure_stage": "unexpected_persistence_error",
                "error": f"{type(exc).__name__}: {exc}",
            }
        if not persistence["ok"]:
            result["install_result_provenance"] = persistence
            return_code = 4
        if return_code == 0 and transition_activate is not None:
            transition_activate()
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print_apply_human(result)
    return return_code


def prepare_runtime_identity_transition(
    plan: dict[str, Any],
    backup_manifest: dict[str, Any],
    authorization_context: dict[str, Any],
    backup_dir: Path,
) -> dict[str, Any]:
    root = held_exclusive_admission_root()
    gate = AdmissionGate(root, True)
    old_identity = gate.current_identity()
    new_identity = {
        "registry_sha256": mutation_registry_sha256(),
        "runtime_identity": TRUSTED_RUNTIME_IDENTITY,
        "contract_generation": TRUSTED_CONTRACT_GENERATION,
    }
    backup_path = Path(str(plan["target"])).resolve()
    backup_manifest_path = (
        Path(str(backup_manifest.get("target_root") or "")).resolve()
    )
    if backup_manifest_path != backup_path:
        raise InstallSyncError("runtime transition backup target changed")
    backup_file = (
        Path(str(backup_manifest.get("manifest") or "")).resolve()
    )
    if backup_file != Path(str(plan["manifest"])).resolve():
        raise InstallSyncError("runtime transition install manifest changed")
    backup_dir = backup_dir.resolve()
    backup_journal_path = backup_dir / "backup-manifest.json"
    backup_descriptor = os.open(
        backup_journal_path,
        os.O_RDONLY
        | os.O_NOFOLLOW
        | getattr(os, "O_CLOEXEC", 0),
    )
    try:
        os.fsync(backup_descriptor)
    finally:
        os.close(backup_descriptor)
    fsync_directory(backup_journal_path.parent)
    authorization = authorization_context["authorization"]
    transaction_key = {
        "authorization_id": authorization["authorization_id"],
        "backup_manifest_sha256": "sha256:" + sha256_file(backup_journal_path),
        "new_identity": new_identity,
        "old_identity": old_identity,
        "runtime_closure": authorization_context["target_scope"],
    }
    transaction_id = "runtime-install-" + hashlib.sha256(
        canonical_json_bytes(transaction_key)
    ).hexdigest()
    old_release_id = f"rollout-{old_identity['rollout_id']}"
    new_release_id = "runtime-" + str(plan["source_git_commit"])
    intent = {
        "schema_version": 1,
        "kind": "runtime_identity_install",
        "transaction_id": transaction_id,
        "authorization": {
            **authorization,
            "ledger_boundary": authorization_context["ledger_boundary"],
            "target_scope": authorization_context["target_scope"],
            "required_mutation_gates": authorization_context[
                "required_mutation_gates"
            ],
        },
        "old_identity": old_identity,
        "new_identity": new_identity,
        "old_release_id": old_release_id,
        "new_release_id": new_release_id,
        "source_commit": str(plan["source_git_commit"]),
        "manifest_sha256": "sha256:" + str(plan["manifest_sha256"]),
        "target_root": str(Path(str(plan["target"])).resolve()),
        "runtime_closure": authorization_context["target_scope"],
        "backup_dir": str(backup_dir),
        "backup_manifest_sha256": transaction_key[
            "backup_manifest_sha256"
        ],
        "backup_manifest_payload_sha256": "sha256:"
        + hashlib.sha256(canonical_json_bytes(backup_manifest)).hexdigest(),
    }
    intent_digest = "sha256:" + hashlib.sha256(
        canonical_json_bytes(intent)
    ).hexdigest()
    intent_path = root / f"{transaction_id}.json"
    if intent_path.exists():
        if read_json_nofollow(intent_path, owner_private=True) != intent:
            raise InstallSyncError("runtime transition intent conflicts")
    else:
        write_json_durable(intent_path, intent, mode=0o400)
    gate.prepare_identity_transition(
        transaction_id=transaction_id,
        manifest_sha256=intent_digest,
        old_release_id=old_release_id,
        new_release_id=new_release_id,
    )
    return {
        "transaction_id": transaction_id,
        "manifest_sha256": intent_digest,
        "old_release_id": old_release_id,
        "new_release_id": new_release_id,
        **new_identity,
    }


def finish_runtime_identity_transition(
    transition: dict[str, Any],
    *,
    activated: bool,
) -> None:
    AdmissionGate(
        held_exclusive_admission_root(),
        True,
    ).finish_identity_transition(
        activated=activated,
        **transition,
    )


def read_runtime_identity_transition(
    root: Path,
    plan: dict[str, Any],
    authorization_context: dict[str, Any],
) -> tuple[dict[str, Any], dict[str, Any]]:
    pending = dict(pending_transaction(root))
    if pending.get("event") != "RUNTIME_PREPARED":
        raise InstallSyncError(
            "pending admission event is not a runtime identity transition"
        )
    transaction_id = str(pending["transaction_id"])
    if not transaction_id.startswith("runtime-install-"):
        raise InstallSyncError(
            "pending admission transaction is not a runtime install"
        )
    intent = read_json_nofollow(
        root / f"{transaction_id}.json",
        owner_private=True,
    )
    if (
        not isinstance(intent, dict)
        or intent.get("schema_version") != 1
        or intent.get("kind") != "runtime_identity_install"
        or intent.get("transaction_id") != transaction_id
        or intent.get("old_release_id") != pending["old_release_id"]
        or intent.get("new_release_id") != pending["new_release_id"]
        or "sha256:"
        + hashlib.sha256(canonical_json_bytes(intent)).hexdigest()
        != pending["manifest_sha256"]
    ):
        raise InstallSyncError("runtime transition intent is invalid")
    old_identity = intent.get("old_identity")
    _runtime_identity_key = "runtime_identity"
    expected_old = {
        key: pending[key]
        for key in (
            "registry_sha256",
            _runtime_identity_key,
            "contract_generation",
            "rollout_id",
        )
    }
    expected_new = {
        "registry_sha256": mutation_registry_sha256(),
        _runtime_identity_key: TRUSTED_RUNTIME_IDENTITY,
        "contract_generation": TRUSTED_CONTRACT_GENERATION,
    }
    if (
        old_identity != expected_old
        or intent.get("new_identity") != expected_new
        or intent.get("runtime_closure")
        != authorization_context["target_scope"]
        or intent.get("target_root")
        != str(Path(str(plan["target"])).resolve())
        or intent.get("source_commit") != plan["source_git_commit"]
        or intent.get("manifest_sha256")
        != "sha256:" + str(plan["manifest_sha256"])
    ):
        raise InstallSyncError("runtime transition recovery identity changed")
    return pending, intent


def plan_target_parity(plan: dict[str, Any]) -> bool:
    for item in plan.get("files", []):
        target_path = Path(str(item["target_path"]))
        if str(item.get("action") or "") in RETIRING_PLANNED_ACTIONS:
            if target_path.exists() or target_path.is_symlink():
                return False
            continue
        if (
            not target_path.is_file()
            or sha256_file(target_path) != item.get("source_sha256")
            or (
                item.get("source_mode") is not None
                and file_mode(target_path) != item.get("source_mode")
            )
        ):
            return False
    return True


def backup_old_parity(
    target: Path,
    journal: dict[str, Any],
) -> bool:
    old_hashes = journal.get("old_target_sha256")
    if not isinstance(old_hashes, dict):
        return False
    for target_rel, old_hash in old_hashes.items():
        target_path = target / str(target_rel)
        if old_hash:
            if (
                not target_path.is_file()
                or sha256_file(target_path) != old_hash
            ):
                return False
        elif target_path.exists() or target_path.is_symlink():
            return False
    return True


def rollback_interrupted_runtime_install(
    target: Path,
    backup_dir: Path,
) -> dict[str, Any]:
    journal = load_backup_manifest(backup_dir)
    retired_restore: list[dict[str, Any]] = []
    for record in journal.get("retired_targets", []):
        if not isinstance(record, dict):
            continue
        target_rel = str(record.get("target_rel") or "")
        retired_path = target / target_rel
        removed_sha256 = str(record.get("removed_target_sha256") or "")
        removed_mode = record.get("removed_target_mode")
        if (
            retired_path.is_file()
            and sha256_file(retired_path) == removed_sha256
            and file_mode(retired_path) == removed_mode
        ):
            continue
        if retired_path.exists() or retired_path.is_symlink():
            raise InstallSyncError(
                f"interrupted retirement target is ambiguous: {retired_path}"
            )
        retired_restore.append(record)
    if backup_old_parity(target, journal) and not retired_restore:
        return {
            "restored_count": 0,
            "removed_created_count": 0,
            "restored_mode_count": 0,
        }
    backed_up: list[dict[str, Any]] = []
    for record in journal.get("backed_up_files", []):
        if not isinstance(record, dict):
            continue
        target_path = target_path_from_manifest_record(target, record)
        if (
            target_path.is_file()
            and sha256_file(target_path) == record.get("old_target_sha256")
            and file_mode(target_path) == record.get("old_target_mode")
        ):
            continue
        if (
            not target_path.is_file()
            or sha256_file(target_path) != record.get("new_target_sha256")
            or file_mode(target_path) != record.get("new_target_mode")
        ):
            raise InstallSyncError(
                f"interrupted install target is ambiguous: {target_path}"
            )
        if record.get("commit_state") == "validated":
            observed = target_path.stat()
            record = {
                **record,
                "commit_state": "committed",
                "new_target_identity": {
                    "st_dev": observed.st_dev,
                    "st_ino": observed.st_ino,
                },
            }
        backed_up.append(record)
    chmod_targets: list[dict[str, Any]] = []
    for record in journal.get("chmod_targets", []):
        if not isinstance(record, dict):
            continue
        target_path = target_path_from_manifest_record(target, record)
        if (
            target_path.is_file()
            and file_mode(target_path) == record.get("old_target_mode")
        ):
            continue
        if (
            not target_path.is_file()
            or file_mode(target_path) != record.get("new_target_mode")
        ):
            raise InstallSyncError(
                f"interrupted chmod target is ambiguous: {target_path}"
            )
        chmod_targets.append(record)
    for record in journal.get("created_targets", []):
        if (
            isinstance(record, dict)
            and Path(str(record.get("target_path") or "")).exists()
            and created_target_identity(record) is None
        ):
            raise InstallSyncError(
                "interrupted created target lacks durable ownership evidence"
            )
    result = rollback_backup(
        target,
        backup_dir,
        backed_up_files=backed_up,
        chmod_targets=chmod_targets,
        retired_targets=retired_restore,
        journal=journal,
    )
    if not backup_old_parity(target, journal):
        raise InstallSyncError(
            "interrupted runtime install rollback parity failed"
        )
    journal.update(
        {
            "status": "interrupted_install_rolled_back",
            "interrupted_install_rolled_back_at": utc_now(),
            "rollback_result": result,
        }
    )
    persist_terminal_backup_status(backup_dir, journal)
    return result


def reconcile_recovered_retirement_journal(
    plan: dict[str, Any],
    backup_dir: Path,
    journal: dict[str, Any],
) -> list[dict[str, Any]]:
    """Bind recovered retirement custody records to the plan before any
    journal finalization: the retired and declared-absence records together
    must cover the plan's exact retirement target set once each, with
    source/target identity, preimage pin, canonical mode, backup path and
    permitted commit states derived from the plan rather than the records.
    """
    plan_retiring = {
        str(item.get("target_rel") or ""): item
        for item in plan.get("files", [])
        if str(item.get("action") or "") in RETIRING_PLANNED_ACTIONS
    }
    retired_records = [
        record
        for record in journal.get("retired_targets", [])
        if isinstance(record, dict)
    ]
    noop_records = [
        record
        for record in journal.get("retired_noop_targets", [])
        if isinstance(record, dict)
    ]
    retired_rels = [
        str(record.get("target_rel") or "") for record in retired_records
    ]
    noop_rels = [
        str(record.get("target_rel") or "") for record in noop_records
    ]
    retired_set, noop_set = set(retired_rels), set(noop_rels)
    if (
        len(retired_rels) != len(retired_set)
        or len(noop_rels) != len(noop_set)
        or retired_set & noop_set
        or (retired_set | noop_set) != set(plan_retiring)
    ):
        raise InstallSyncError(
            "runtime transition retirement custody does not cover the "
            "planned retirement set exactly"
        )
    for record, is_noop in (
        [(record, False) for record in retired_records]
        + [(record, True) for record in noop_records]
    ):
        retired_rel = str(record.get("target_rel") or "")
        item = plan_retiring[retired_rel]
        if str(record.get("source_rel") or "") != str(
            item.get("source_rel") or ""
        ) or str(record.get("target_path") or "") != str(
            item.get("target_path") or ""
        ):
            raise InstallSyncError(
                "runtime transition retirement custody does not cover the "
                "planned retirement set exactly"
            )
        if is_noop:
            if str(record.get("action") or "") != "retire_absent_noop":
                raise InstallSyncError(
                    "runtime transition retirement custody does not cover the "
                    "planned retirement set exactly"
                )
            if os.path.lexists(backup_dir / "targets" / retired_rel):
                raise InstallSyncError(
                    "runtime transition retirement custody does not cover the "
                    "planned retirement set exactly"
                )
            continue
        if (
            str(record.get("removed_target_sha256") or "")
            != str(item.get("retire_expected_sha256") or "")
            or record.get("removed_target_mode")
            != item.get("retire_expected_mode")
            or record.get("backup_path")
            != str(backup_dir / "targets" / retired_rel)
            or record.get("commit_state") not in ("pending", "committed")
        ):
            raise InstallSyncError(
                "runtime transition retirement custody does not cover the "
                "planned retirement set exactly"
            )
    return retired_records


def recover_runtime_identity_transition(
    args: argparse.Namespace,
    plan: dict[str, Any],
    authorization_context: dict[str, Any],
) -> dict[str, Any] | None:
    root = held_exclusive_admission_root()
    pending, intent = read_runtime_identity_transition(
        root,
        plan,
        authorization_context,
    )
    backup_dir = Path(str(intent["backup_dir"])).resolve()
    target = Path(str(plan["target"])).resolve()
    if plan_target_parity(plan):
        journal = load_backup_manifest(backup_dir)
        # Every plan target is already at its desired state, so any durable
        # retirement custody record whose target is absent was in fact
        # committed; validate it against the exact backup preimage, promote
        # it, and finalize the journal to the truthful applied shape before
        # event/receipt publication.
        retired_records = reconcile_recovered_retirement_journal(
            plan,
            backup_dir,
            journal,
        )
        for record in retired_records:
            retired_rel = str(record.get("target_rel") or "")
            retired_path = target / retired_rel
            removed_sha256 = str(record.get("removed_target_sha256") or "")
            removed_mode = record.get("removed_target_mode")
            custody = backup_dir / "targets" / retired_rel
            if (
                retired_path.exists()
                or retired_path.is_symlink()
                or len(removed_sha256) != 64
                or type(removed_mode) is not int
                or not custody.is_file()
                or sha256_file(custody) != removed_sha256
                or stat.S_IMODE(custody.stat().st_mode) != removed_mode
            ):
                raise InstallSyncError(
                    "runtime transition retirement custody is invalid: "
                    f"{retired_rel}"
                )
            record["commit_state"] = "committed"
        if retired_records:
            journal["retired_targets"] = retired_records
            journal["removed_target_sha256"] = {
                str(record.get("target_rel") or ""): str(
                    record.get("removed_target_sha256") or ""
                )
                for record in retired_records
            }
            journal["status"] = "applied"
            write_backup_manifest(backup_dir, journal)
        old_hashes = journal.get("old_target_sha256")
        result = {
            **plan,
            "files": [
                {
                    **item,
                    "old_target_sha256": (
                        old_hashes.get(str(item["target_rel"]), "")
                        if isinstance(old_hashes, dict)
                        else ""
                    ),
                }
                for item in plan["files"]
            ],
            "items": plan["files"],
            "actor": journal["actor"],
            "backup_dir": str(backup_dir),
            "backed_up_files": journal.get("backed_up_files", []),
            "created_targets": journal.get("created_targets", []),
            "copied_targets": journal.get("copied_targets", []),
            "chmod_targets": journal.get("chmod_targets", []),
            "retired_targets": journal.get("retired_targets", []),
            "retired_noop_targets": journal.get("retired_noop_targets", []),
            "retired_count": len(journal.get("retired_targets", [])),
            "retired_noop_count": len(journal.get("retired_noop_targets", [])),
            "copied_count": len(journal.get("copied_targets", [])),
            "chmod_count": len(journal.get("chmod_targets", [])),
            "removed_target_sha256": {
                str(record.get("target_rel") or ""): str(
                    record.get("removed_target_sha256") or ""
                )
                for record in journal.get("retired_targets", [])
                if isinstance(record, dict)
            },
            "guarded_rollback_contract": journal.get(
                "guarded_rollback_contract"
            ),
            "pre_apply_effective_event_id_by_target": journal.get(
                "pre_apply_effective_event_id_by_target",
                {},
            ),
            "runtime_identity_authorization_id": intent["authorization"][
                "authorization_id"
            ],
        }
        prior = latest_matching_install_mutation(result)
        if prior is None:
            result["mutation_event"] = append_install_mutation_event(result)
        else:
            result["observed_prior_mutation"] = prior
        result["runtime_identity_receipt"] = publish_runtime_identity_receipt(
            result
        )
        persistence = persist_install_result(backup_dir, result)
        if not persistence["ok"]:
            raise InstallSyncError(
                "runtime transition recovery result persistence failed"
            )
        finish_runtime_identity_transition(
            {
                "transaction_id": pending["transaction_id"],
                "manifest_sha256": pending["manifest_sha256"],
                "old_release_id": pending["old_release_id"],
                "new_release_id": pending["new_release_id"],
                **intent["new_identity"],
            },
            activated=True,
        )
        print(
            json.dumps(result, indent=2, sort_keys=True, ensure_ascii=False)
            if args.json
            else "runtime identity transition recovered"
        )
        return None
    rollback_interrupted_runtime_install(target, backup_dir)
    return {
        "transaction_id": pending["transaction_id"],
        "manifest_sha256": pending["manifest_sha256"],
        "old_release_id": pending["old_release_id"],
        "new_release_id": pending["new_release_id"],
        **intent["new_identity"],
    }


def command_apply(args: argparse.Namespace) -> int:
    ensure_allow_write(bool(args.allow_write))
    target = Path(args.target)
    leader_mode = bool(getattr(args, "authorize_leader", False))
    if leader_mode and not bool(getattr(args, "publish_runtime_identity", False)):
        raise InstallSyncError(
            "--authorize-leader applies only to the runtime-identity "
            "publishing apply; the ordinary apply path takes no grant"
        )
    if leader_mode and str(getattr(args, "authorization_id", "") or "").strip():
        raise InstallSyncError(
            "--authorize-leader cannot be combined with a pre-made grant "
            "authorization id"
        )
    if leader_mode and getattr(args, "ledger_boundary", None) is not None:
        raise InstallSyncError(
            "--authorize-leader cannot be combined with a pre-made grant "
            "ledger boundary"
        )
    hot_plugin_docs = ""
    if getattr(args, "hot_plugin_docs", None) is not None:
        if bool(getattr(args, "publish_runtime_identity", False)):
            raise InstallSyncError(
                "--hot-plugin-docs cannot be combined with the "
                "runtime-identity publishing apply"
            )
        hot_plugin_docs = validate_hot_plugin_docs_plugin_name(
            str(getattr(args, "hot_plugin_docs", "") or "")
        )
    if not bool(getattr(args, "publish_runtime_identity", False)):
        with global_mutation_gate(target, exclusive=True):
            if not hot_plugin_docs:
                ensure_global_quiescence(target)
            plan = build_plan(Path(args.source), target, Path(args.manifest))
            if any(
                str(item.get("action") or "") in RETIRING_PLANNED_ACTIONS
                for item in plan.get("files", [])
            ):
                raise InstallSyncError(
                    "retirement requires the authenticated runtime-identity "
                    "publishing apply; the ordinary apply path refuses it"
                )
            if hot_plugin_docs:
                validate_hot_plugin_docs_plan(plan, hot_plugin_docs)
            return apply_prepared_plan(
                args,
                target,
                plan,
                publish_runtime_identity=False,
                mutation_gate_held=True,
            )
    if not str(args.control_root or "").strip():
        raise InstallSyncError(
            "runtime identity publisher requires explicit control root"
        )
    control_root = Path(args.control_root).resolve()
    if control_root != target.resolve():
        raise InstallSyncError(
            "runtime identity publisher control root must equal target root"
        )
    pre_plan = build_plan(Path(args.source), target, Path(args.manifest))
    require_runtime_identity_source(pre_plan)
    target_scope = runtime_identity_capability_scope(pre_plan)

    def leader_authorization_resolver(resolver_args: argparse.Namespace) -> None:
        """Append the exact leader grant only while the admission gate and
        quiescence hold (#897), mirroring the bundle leader entry (#778):
        no grant is written on lock refusal, an existing non-empty attempt
        ledger is never overwritten or revoked, and the grant binds this
        exact publication closure."""
        leader_authorization_id = (
            "runtime-identity-leader-"
            + safe_authorization_id_component(resolver_args.task_id, "task id")
            + "-"
            + safe_authorization_id_component(resolver_args.attempt_id, "attempt id")
        )
        require_generation_authorization(
            SimpleNamespace(
                authorization_id=leader_authorization_id,
                task_id=resolver_args.task_id,
                attempt_id=resolver_args.attempt_id,
            )
        )
        ledger_path = (
            control_root
            / ".omx"
            / "framework"
            / "team"
            / "operation-authorizations"
            / safe_authorization_id_component(resolver_args.task_id, "task id")
            / (
                safe_authorization_id_component(
                    resolver_args.attempt_id, "attempt id"
                )
                + ".jsonl"
            )
        )
        ledger = AuthorizationLedger(
            ledger_path,
            task_id=resolver_args.task_id,
            attempt_id=resolver_args.attempt_id,
        )
        if ledger.records():
            still_active = ledger.active_authorization(leader_authorization_id)
            raise InstallSyncError(
                "runtime identity leader authorization attempt ledger already "
                f"exists at {ledger_path} with boundary "
                f"{ledger.boundary_sequence()} (derived grant "
                f"{'active' if still_active else 'not active'}); consume it "
                "via the pre-made grant entry or use a new attempt"
            )
        leader_contract = derive_operation_contract("install_sync")
        closure = runtime_identity_closure_payload(pre_plan)
        leader_capability = validate_operation_capability(
            {
                "schema_version": 1,
                "contract_id": "contract-runtime-identity-leader",
                "contract_hash": "sha256:"
                + hashlib.sha256(canonical_json_bytes(closure)).hexdigest(),
                "authorization_id": leader_authorization_id,
                "authorization_source": "authorization_ledger",
                "operation_kind": "install_sync",
                "scope": target_scope,
                "mutation_gates": list(leader_contract["required_mutation_gates"]),
                "task_id": resolver_args.task_id,
                "attempt_id": resolver_args.attempt_id,
            },
            operation_kind="install_sync",
            target_scope=target_scope,
            required_mutation_gates=list(leader_contract["required_mutation_gates"]),
            task_id=resolver_args.task_id,
            attempt_id=resolver_args.attempt_id,
        )
        ledger.append(
            {
                "schema_version": 1,
                "authorization_id": leader_authorization_id,
                "principal": "direct-user",
                "decision": "grant",
                "task_id": resolver_args.task_id,
                "attempt_id": resolver_args.attempt_id,
                "contract_hash": leader_capability["contract_hash"],
                "created_at": datetime.now(UTC).isoformat().replace("+00:00", "Z"),
                "provenance": "runtime-identity-leader-authorization",
                "capability": leader_capability,
            }
        )
        resolver_args.authorization_id = leader_authorization_id
        resolver_args.ledger_boundary = ledger.boundary_sequence()

    with authorized_install_mutation(
        args,
        target_scope,
        authorization_resolver=(
            leader_authorization_resolver if leader_mode else None
        ),
    ) as ctx:
        authorization = ctx["authorization"]
        held_plan = build_plan(Path(args.source), target, Path(args.manifest))
        require_runtime_identity_source(held_plan)
        if runtime_identity_capability_scope(held_plan) != ctx["target_scope"]:
            raise InstallSyncError(
                "runtime identity publisher plan changed before mutation"
            )
        transition: dict[str, Any] = {}
        try:
            admission_root = held_exclusive_admission_root()
        except AdmissionError:
            admission_root = None
        if (
            admission_root is not None
            and lifecycle_state(admission_root)
            is LifecycleState.RECOVERY_REQUIRED
        ):
            recovered = recover_runtime_identity_transition(
                args,
                held_plan,
                ctx,
            )
            if recovered is None:
                return 0
            transition.update(recovered)
            held_plan = build_plan(
                Path(args.source),
                target,
                Path(args.manifest),
            )
            require_runtime_identity_source(held_plan)
            if (
                runtime_identity_capability_scope(held_plan)
                != ctx["target_scope"]
            ):
                raise InstallSyncError(
                    "runtime identity publisher plan changed after recovery"
                )
        events = read_install_mutation_events(target)
        if any(
            event.get("runtime_identity_authorization_id")
            == authorization["authorization_id"]
            for event in events
        ):
            raise InstallSyncError(
                "runtime identity publisher authorization id already consumed"
            )
        try:
            current_identity = AdmissionGate(
                held_exclusive_admission_root(),
                True,
            ).current_identity()
        except AdmissionError:
            current_identity = None
        identity_transition = bool(transition) or (
            current_identity is not None
            and (
                current_identity["registry_sha256"],
                current_identity["runtime_identity"],
                current_identity["contract_generation"],
            )
            != (
                mutation_registry_sha256(),
                TRUSTED_RUNTIME_IDENTITY,
                TRUSTED_CONTRACT_GENERATION,
            )
        )

        def prepare_transition(backup_manifest: dict[str, Any]) -> None:
            transition.update(
                prepare_runtime_identity_transition(
                    held_plan,
                    backup_manifest,
                    ctx,
                    Path(args.backup_dir),
                )
            )

        def finish_transition(*, activated: bool) -> None:
            if not transition:
                raise InstallSyncError(
                    "runtime identity transition was not prepared"
                )
            finish_runtime_identity_transition(
                transition,
                activated=activated,
            )

        return apply_prepared_plan(
            args,
            target,
            held_plan,
            publish_runtime_identity=True,
            mutation_gate_held=True,
            runtime_identity_authorization_id=authorization["authorization_id"],
            install_events=events,
            transition_prepare=(
                prepare_transition
                if identity_transition and not transition
                else None
            ),
            transition_activate=(
                (lambda: finish_transition(activated=True))
                if identity_transition else None
            ),
        )


def explicit_rollback_validation_from_args(
    args: argparse.Namespace,
) -> dict[str, Any]:
    return validate_explicit_rollback_bundle(
        source=Path(args.source),
        target=Path(args.target),
        backup_dir=Path(args.backup_dir),
        manifest_path=Path(args.manifest),
        expected_source_commit=str(args.expected_source_commit),
        expected_manifest_sha256=str(args.expected_manifest_sha256),
        applied_event_policy=str(args.applied_event_policy),
    )


def command_rollback_check(args: argparse.Namespace) -> int:
    validation = explicit_rollback_validation_from_args(args)
    if args.json:
        print(
            json.dumps(
                validation,
                indent=2,
                sort_keys=True,
                ensure_ascii=False,
            )
        )
    else:
        print("install_sync_rollback_check")
        print("writes_target: false")
        print("check: OK")
    return 0


def command_rollback(args: argparse.Namespace) -> int:
    ensure_allow_write(bool(args.allow_write))
    target = Path(args.target)
    with global_mutation_gate(target, exclusive=True), ExitStack() as stack:
        ensure_global_quiescence(target)
        terminal_journal = None
        guard_values = (
            str(getattr(args, "source", "") or ""),
            str(getattr(args, "manifest", "") or ""),
            str(getattr(args, "expected_source_commit", "") or ""),
            str(getattr(args, "expected_manifest_sha256", "") or ""),
            str(getattr(args, "applied_event_policy", "") or ""),
        )
        if any(guard_values) and not all(guard_values):
            raise InstallSyncError(
                "explicit rollback requires source, manifest, expected "
                "source commit, expected manifest sha256, and applied "
                "event policy"
            )
        if not any(guard_values):
            result = rollback_backup(target, Path(args.backup_dir))
            validation = None
        else:
            validation = explicit_rollback_validation_from_args(args)
            terminal_journal = stack.enter_context(
                opened_validated_backup_directory(
                    Path(args.backup_dir),
                    validation["rollback_journal_snapshot"],
                )
            )
            result = rollback_backup(
                target,
                Path(args.backup_dir),
                journal=validation["rollback_journal"],
                journal_snapshot=validation[
                    "rollback_journal_snapshot"
                ],
            )
        if validation is None:
            if args.json:
                print(
                    json.dumps(
                        result,
                        indent=2,
                        sort_keys=True,
                        ensure_ascii=False,
                    )
                )
            else:
                print_rollback_human(result)
            return 0
        restored = {
            Path(item["target_path"]).resolve()
            .relative_to(target.resolve())
            .as_posix(): item["restored_sha256"]
            for item in result["restored_targets"]
        }
        restored_retired = {
            Path(item["target_path"]).resolve()
            .relative_to(target.resolve())
            .as_posix(): item["restored_target_sha256"]
            for item in result.get("restored_retired_targets", [])
        }
        retired_rels = set(validation.get("retired_target_rels", []))
        noop_rels = set(validation.get("retired_noop_target_rels", []))
        if (
            set(restored_retired) != retired_rels
            or restored_retired
            != validation.get("restored_retired_target_sha256", {})
        ):
            raise InstallSyncError(
                "explicit rollback restored retired target parity mismatch"
            )
        for noop_rel in noop_rels:
            noop_path = target.resolve() / noop_rel
            if noop_path.exists() or noop_path.is_symlink():
                raise InstallSyncError(
                    "explicit rollback retired noop target is present: "
                    f"{noop_rel}"
                )
        restored_modes = {
            Path(item["target_path"]).resolve()
            .relative_to(target.resolve())
            .as_posix(): item["restored_mode"]
            for item in result["restored_modes"]
        }
        mutation_targets = set(validation["mutation_target_rels"])
        copied_mutation_targets = mutation_targets - set(
            validation["chmod_target_rels"]
        )
        expected_restored = validation["restored_target_sha256"]
        if (
            set(restored) != copied_mutation_targets
            or any(
                restored[target_rel] != expected_restored[target_rel]
                for target_rel in copied_mutation_targets
            )
        ):
            raise InstallSyncError(
                "explicit rollback restored target parity mismatch"
            )
        expected_modes = validation["restored_target_mode"]
        if restored_modes != expected_modes:
            raise InstallSyncError(
                "explicit rollback restored mode parity mismatch"
            )
        current_hashes = {
            target_rel: sha256_file(target.resolve() / target_rel)
            for target_rel in expected_restored
        }
        if current_hashes != expected_restored:
            raise InstallSyncError(
                "explicit rollback full bundle parity mismatch"
            )
        current_modes = {
            target_rel: file_mode(target.resolve() / target_rel)
            for target_rel in expected_modes
        }
        if current_modes != expected_modes:
            raise InstallSyncError(
                "explicit rollback full bundle mode parity mismatch"
            )
        try:
            rollback_event = append_install_rollback_event(validation)
            journal = copy.deepcopy(validation["rollback_journal"])
            journal.update(
                {
                    "status": "explicitly_rolled_back",
                    "explicitly_rolled_back_at": utc_now(),
                    "rollback_result": result,
                    "rollback_event": rollback_event,
                }
            )
            write_terminal_backup_manifest(terminal_journal, journal)
        except Exception as exc:
            raise InstallSyncError(
                "rollback provenance persistence failed: "
                f"{type(exc).__name__}: {exc}"
            ) from exc
        status = build_install_status(target)
        expected_targets = set(validation["restored_target_sha256"])
        scoped = [
            item
            for item in status["targets"]
            if item["target_rel"] in expected_targets
        ]
        if (
            {item["target_rel"] for item in scoped} != expected_targets
            or not all(
                item["attributed"] and item["parity"] for item in scoped
            )
        ):
            raise InstallSyncError(
                "rollback provenance attributed parity failed"
            )
        result["mutation_event"] = rollback_event
        result["install_status"] = status
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print_rollback_human(result)
    return 0


SKILL_GENERATION_MANIFEST = ".generation-manifest.json"
SKILL_GENERATION_JOURNAL = "activation-journal.jsonl"
DEFAULT_SKILL_PACKAGE_MAX_BYTES = 16 * 1024 * 1024
CANONICAL_SKILL_PACKAGE = "plugins/visible-agent-orchestrator-skill-v0"
CANONICAL_REPOSITORY_ORIGIN = (
    "https://github.com/WangErgouaaaa/visible-agent-orchestrator-public.git"
)
TRUSTED_INTEGRATION_REF = (
    "refs/remotes/origin/main"
)


def skill_generation_store(active: Path) -> Path:
    return active.parent / f".{active.name}-generations"


def absolute_active_path(value: str) -> Path:
    absolute = Path(os.path.abspath(os.path.expanduser(value)))
    if not absolute.name:
        raise InstallSyncError("active skill path must not be the filesystem root")
    current = Path(absolute.anchor)
    for part in absolute.parent.parts[1:]:
        current /= part
        try:
            observed = current.lstat()
        except FileNotFoundError as exc:
            raise InstallSyncError(
                f"active path parent missing: {current}"
            ) from exc
        if stat.S_ISLNK(observed.st_mode):
            raise InstallSyncError(
                f"active path parent symlink rejected: {current}"
            )
        if not stat.S_ISDIR(observed.st_mode):
            raise InstallSyncError(
                f"active path parent is not a directory: {current}"
            )
    return absolute


def fsync_directory(path: Path) -> None:
    descriptor = os.open(
        path,
        os.O_RDONLY
        | os.O_DIRECTORY
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_CLOEXEC", 0),
    )
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def read_regular_bytes_nofollow(
    path: Path,
    *,
    owner_private: bool = False,
    max_bytes: int = DEFAULT_SKILL_PACKAGE_MAX_BYTES,
) -> bytes:
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_NONBLOCK", 0)
            | getattr(os, "O_CLOEXEC", 0),
        )
    except OSError as exc:
        raise InstallSyncError(f"security record is not a regular file: {path}") from exc
    try:
        observed = os.fstat(descriptor)
        if not stat.S_ISREG(observed.st_mode):
            raise InstallSyncError(f"security record is not a regular file: {path}")
        if owner_private and (
            observed.st_uid != os.geteuid()
            or stat.S_IMODE(observed.st_mode) & 0o077
        ):
            raise InstallSyncError(f"security record must be owner-private: {path}")
        chunks: list[bytes] = []
        total = 0
        while True:
            chunk = os.read(descriptor, min(1024 * 1024, max_bytes - total + 1))
            if not chunk:
                return b"".join(chunks)
            total += len(chunk)
            if total > max_bytes:
                raise InstallSyncError(f"security record exceeds byte ceiling: {path}")
            chunks.append(chunk)
    finally:
        os.close(descriptor)


def read_json_nofollow(
    path: Path,
    *,
    owner_private: bool = False,
) -> dict[str, Any]:
    def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        payload: dict[str, Any] = {}
        for key, value in pairs:
            if key in payload:
                raise ValueError(f"duplicate JSON key: {key}")
            payload[key] = value
        return payload

    try:
        payload = json.loads(
            read_regular_bytes_nofollow(
                path,
                owner_private=owner_private,
            ).decode("utf-8"),
            object_pairs_hook=unique_object,
            parse_constant=reject_json_constant,
        )
    except (UnicodeDecodeError, json.JSONDecodeError, ValueError) as exc:
        raise InstallSyncError(f"security JSON is invalid: {path}") from exc
    if not isinstance(payload, dict):
        raise InstallSyncError(f"security JSON must be an object: {path}")
    return payload


def read_json_value_nofollow(path: Path) -> Any:
    def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        payload: dict[str, Any] = {}
        for key, value in pairs:
            if key in payload:
                raise ValueError(f"duplicate JSON key: {key}")
            payload[key] = value
        return payload

    try:
        return json.loads(
            read_regular_bytes_nofollow(path).decode("utf-8"),
            object_pairs_hook=unique_object,
            parse_constant=reject_json_constant,
        )
    except (UnicodeDecodeError, json.JSONDecodeError, ValueError) as exc:
        raise InstallSyncError(f"security JSON is invalid: {path}") from exc


def reject_json_constant(token: str) -> None:
    raise ValueError(f"nonstandard JSON constant: {token}")


def write_json_durable(
    path: Path,
    payload: dict[str, Any],
    *,
    mode: int = 0o600,
) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary_parent = (
        path.parent.parent
        if path.name == SKILL_GENERATION_MANIFEST
        else path.parent
    )
    temporary = temporary_parent / f".{path.parent.name}.{path.name}.{uuid.uuid4().hex}.tmp"
    descriptor = os.open(
        temporary,
        os.O_WRONLY
        | os.O_CREAT
        | os.O_EXCL
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_CLOEXEC", 0),
        mode,
    )
    try:
        os.fchmod(descriptor, mode)
        encoded = (
            json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False)
            + "\n"
        ).encode("utf-8")
        view = memoryview(encoded)
        while view:
            view = view[os.write(descriptor, view):]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    try:
        os.replace(temporary, path)
        fsync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)


def ensure_skill_generation_store(active: Path) -> Path:
    store = skill_generation_store(active)
    try:
        observed = store.lstat()
    except FileNotFoundError:
        store.mkdir(parents=True, mode=0o700)
        os.chmod(store, 0o700)
        fsync_directory(store.parent)
        observed = store.lstat()
    if (
        not stat.S_ISDIR(observed.st_mode)
        or stat.S_ISLNK(observed.st_mode)
        or observed.st_uid != os.getuid()
        or stat.S_IMODE(observed.st_mode) != 0o700
    ):
        raise InstallSyncError(
            f"skill generation store must be owner-controlled mode 0700: {store}"
        )
    generations = store / "generations"
    if not generations.exists():
        generations.mkdir(mode=0o700)
        fsync_directory(store)
    observed_generations = generations.lstat()
    if (
        not stat.S_ISDIR(observed_generations.st_mode)
        or stat.S_ISLNK(observed_generations.st_mode)
        or observed_generations.st_uid != os.getuid()
        or stat.S_IMODE(observed_generations.st_mode) != 0o700
    ):
        raise InstallSyncError(
            f"skill generations directory must be owner-controlled mode 0700: {generations}"
        )
    return store


def canonical_json_bytes(payload: dict[str, Any]) -> bytes:
    return json.dumps(
        payload,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
    ).encode("utf-8")


def skill_tree_manifest(
    package: Path,
    *,
    package_name: str,
    contract_version: str,
    source_commit: str,
    max_bytes: int,
) -> dict[str, Any]:
    package = package.resolve()
    if not package.is_dir():
        raise InstallSyncError(f"skill package directory missing: {package}")
    root_mode = stat.S_IMODE(package.lstat().st_mode)
    files: list[dict[str, Any]] = []
    directories: list[dict[str, Any]] = []
    total_bytes = 0
    for current, dir_names, file_names in os.walk(package, followlinks=False):
        current_path = Path(current)
        dir_names.sort()
        file_names.sort()
        for name in list(dir_names):
            path = current_path / name
            observed = path.lstat()
            if stat.S_ISLNK(observed.st_mode):
                raise InstallSyncError(f"skill package symlink rejected: {path}")
            if not stat.S_ISDIR(observed.st_mode):
                raise InstallSyncError(f"skill package special entry rejected: {path}")
            mode = stat.S_IMODE(observed.st_mode)
            directories.append(
                {
                    "path": path.relative_to(package).as_posix(),
                    "source_mode": mode,
                    "installed_mode": mode & ~0o222,
                }
            )
        for name in file_names:
            path = current_path / name
            rel = path.relative_to(package).as_posix()
            if rel == SKILL_GENERATION_MANIFEST:
                raise InstallSyncError(
                    f"skill package reserves {SKILL_GENERATION_MANIFEST}"
                )
            observed = path.lstat()
            if stat.S_ISLNK(observed.st_mode):
                raise InstallSyncError(f"skill package symlink rejected: {path}")
            if not stat.S_ISREG(observed.st_mode):
                raise InstallSyncError(f"skill package special entry rejected: {path}")
            total_bytes += observed.st_size
            if total_bytes > max_bytes:
                raise InstallSyncError(
                    "skill package exceeds hard byte ceiling: "
                    f"{total_bytes} > {max_bytes}"
                )
            mode = stat.S_IMODE(observed.st_mode)
            descriptor = os.open(
                path,
                os.O_RDONLY
                | getattr(os, "O_NOFOLLOW", 0)
                | getattr(os, "O_NONBLOCK", 0)
                | getattr(os, "O_CLOEXEC", 0),
            )
            try:
                opened = os.fstat(descriptor)
                if (
                    not stat.S_ISREG(opened.st_mode)
                    or opened.st_size != observed.st_size
                    or stat.S_IMODE(opened.st_mode) != mode
                ):
                    raise InstallSyncError(
                        f"skill package file changed during manifest: {path}"
                    )
                digest = sha256_descriptor(descriptor)
            finally:
                os.close(descriptor)
            files.append(
                {
                    "path": rel,
                    "sha256": digest,
                    "size": observed.st_size,
                    "source_mode": mode,
                    "installed_mode": mode & ~0o222,
                }
            )
    if not files:
        raise InstallSyncError("skill package contains no files")
    base = {
        "schema_version": 1,
        "package_name": package_name,
        "contract_version": contract_version,
        "source_commit": source_commit,
        "symlink_policy": "reject",
        "source_root_mode": root_mode,
        "installed_root_mode": 0o500,
        "total_bytes": total_bytes,
        "directories": sorted(directories, key=lambda item: item["path"]),
        "files": sorted(files, key=lambda item: item["path"]),
    }
    tree_hash = hashlib.sha256(canonical_json_bytes(base)).hexdigest()
    return {
        **base,
        "generation_id": tree_hash,
        "tree_hash": tree_hash,
    }


def validate_manifest_identity(manifest: dict[str, Any]) -> None:
    base = {
        key: value
        for key, value in manifest.items()
        if key not in {"generation_id", "tree_hash"}
    }
    digest = hashlib.sha256(canonical_json_bytes(base)).hexdigest()
    if (
        manifest.get("generation_id") != digest
        or manifest.get("tree_hash") != digest
        or manifest.get("symlink_policy") != "reject"
    ):
        raise InstallSyncError("skill generation manifest identity mismatch")


def verify_tree_against_manifest(
    root: Path,
    manifest: dict[str, Any],
    *,
    allow_source_modes: bool = False,
    allow_publish_root: bool = False,
    require_manifest_file: bool = True,
) -> None:
    validate_manifest_identity(manifest)
    expected_files = {
        str(item["path"]): item for item in manifest.get("files", [])
    }
    expected_directories = {
        str(item["path"]): item
        for item in manifest.get("directories", [])
    }
    actual_files: set[str] = set()
    actual_directories: set[str] = set()
    root_allowed_modes = {int(manifest["installed_root_mode"])}
    if allow_source_modes:
        root_allowed_modes.add(int(manifest["source_root_mode"]))
    if allow_publish_root:
        root_allowed_modes.add(0o700)
    if stat.S_IMODE(root.lstat().st_mode) not in root_allowed_modes:
        raise InstallSyncError("skill generation root mode mismatch")
    for current, dir_names, file_names in os.walk(root, followlinks=False):
        current_path = Path(current)
        dir_names.sort()
        file_names.sort()
        for name in dir_names:
            path = current_path / name
            observed = path.lstat()
            if stat.S_ISLNK(observed.st_mode) or not stat.S_ISDIR(observed.st_mode):
                raise InstallSyncError(f"skill generation special entry rejected: {path}")
            rel = path.relative_to(root).as_posix()
            actual_directories.add(rel)
            expected = expected_directories.get(rel)
            if expected is None:
                raise InstallSyncError(f"skill generation directory mismatch: {rel}")
            allowed_modes = {int(expected["installed_mode"])}
            if allow_source_modes:
                allowed_modes.add(int(expected["source_mode"]))
            if stat.S_IMODE(observed.st_mode) not in allowed_modes:
                raise InstallSyncError(f"skill generation directory mode mismatch: {rel}")
        for name in file_names:
            path = current_path / name
            rel = path.relative_to(root).as_posix()
            observed = path.lstat()
            if stat.S_ISLNK(observed.st_mode) or not stat.S_ISREG(observed.st_mode):
                raise InstallSyncError(f"skill generation special entry rejected: {path}")
            if rel == SKILL_GENERATION_MANIFEST:
                continue
            actual_files.add(rel)
            expected = expected_files.get(rel)
            if expected is None:
                raise InstallSyncError(f"skill generation file mismatch: {rel}")
            allowed_modes = {int(expected["installed_mode"])}
            if allow_source_modes:
                allowed_modes.add(int(expected["source_mode"]))
            descriptor = os.open(
                path,
                os.O_RDONLY
                | getattr(os, "O_NOFOLLOW", 0)
                | getattr(os, "O_NONBLOCK", 0)
                | getattr(os, "O_CLOEXEC", 0),
            )
            try:
                opened = os.fstat(descriptor)
                mismatch = (
                    not stat.S_ISREG(opened.st_mode)
                    or opened.st_size != int(expected["size"])
                    or stat.S_IMODE(opened.st_mode) not in allowed_modes
                    or sha256_descriptor(descriptor) != expected["sha256"]
                )
            finally:
                os.close(descriptor)
            if mismatch:
                raise InstallSyncError(f"skill generation file mismatch: {rel}")
    if actual_files != set(expected_files) or actual_directories != set(expected_directories):
        raise InstallSyncError("skill generation file list mismatch")
    manifest_path = root / SKILL_GENERATION_MANIFEST
    if require_manifest_file and not manifest_path.is_file():
        raise InstallSyncError("skill generation manifest missing")


def validate_generation(path: Path, expected_generation: str = "") -> dict[str, Any]:
    try:
        observed = path.lstat()
    except FileNotFoundError as exc:
        raise InstallSyncError(f"skill generation missing: {path}") from exc
    if stat.S_ISLNK(observed.st_mode) or not stat.S_ISDIR(observed.st_mode):
        raise InstallSyncError(f"skill generation must be a real directory: {path}")
    manifest_path = path / SKILL_GENERATION_MANIFEST
    try:
        manifest_observed = manifest_path.lstat()
    except FileNotFoundError as exc:
        raise InstallSyncError("skill generation manifest missing") from exc
    if (
        not stat.S_ISREG(manifest_observed.st_mode)
        or manifest_observed.st_uid != os.geteuid()
        or stat.S_IMODE(manifest_observed.st_mode) != 0o400
    ):
        raise InstallSyncError(
            "skill generation manifest must be an owner-read-only regular file"
        )
    manifest = read_json_nofollow(manifest_path, owner_private=True)
    if expected_generation and manifest.get("generation_id") != expected_generation:
        raise InstallSyncError("skill generation id does not match expected target")
    verify_tree_against_manifest(path, manifest)
    return manifest


def seal_generation(
    path: Path,
    manifest: dict[str, Any],
    *,
    allow_publish_root: bool = False,
    fault_after_manifest: str = "",
) -> None:
    verify_tree_against_manifest(
        path,
        manifest,
        allow_source_modes=True,
        allow_publish_root=allow_publish_root,
        require_manifest_file=False,
    )
    for item in manifest.get("files", []):
        file_path = path / str(item["path"])
        os.chmod(file_path, int(item["installed_mode"]), follow_symlinks=False)
        descriptor = os.open(
            file_path,
            os.O_RDONLY
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_CLOEXEC", 0),
        )
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    manifest_path = path / SKILL_GENERATION_MANIFEST
    write_json_durable(manifest_path, manifest)
    os.chmod(manifest_path, 0o400, follow_symlinks=False)
    manifest_descriptor = os.open(
        manifest_path,
        os.O_RDONLY
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_CLOEXEC", 0),
    )
    try:
        os.fsync(manifest_descriptor)
    finally:
        os.close(manifest_descriptor)
    if fault_after_manifest:
        skill_fault(fault_after_manifest)
    for item in sorted(
        manifest.get("directories", []),
        key=lambda value: str(value["path"]).count("/"),
        reverse=True,
    ):
        directory = path / str(item["path"])
        os.chmod(directory, int(item["installed_mode"]), follow_symlinks=False)
        fsync_directory(directory)
    os.chmod(path, int(manifest["installed_root_mode"]))
    fsync_directory(path)


def copy_skill_generation(
    package: Path,
    store: Path,
    manifest: dict[str, Any],
) -> Path:
    generations = store / "generations"
    generation = generations / str(manifest["generation_id"])
    try:
        observed_generation = generation.lstat()
    except FileNotFoundError:
        pass
    else:
        if (
            stat.S_ISDIR(observed_generation.st_mode)
            and not stat.S_ISLNK(observed_generation.st_mode)
            and observed_generation.st_uid == os.geteuid()
            and stat.S_IMODE(observed_generation.st_mode) == 0o700
        ):
            published_manifest = read_json_nofollow(
                generation / SKILL_GENERATION_MANIFEST,
                owner_private=True,
            )
            if published_manifest != manifest:
                raise InstallSyncError(
                    "interrupted published skill generation identity mismatch"
                )
            seal_generation(
                generation,
                manifest,
                allow_publish_root=True,
            )
        validate_generation(generation, str(manifest["generation_id"]))
        return generation
    staging = Path(tempfile.mkdtemp(prefix=".staging-", dir=generations))
    try:
        for item in manifest.get("directories", []):
            directory = staging / str(item["path"])
            directory.mkdir(
                parents=True,
                exist_ok=True,
                mode=0o700,
            )
            os.chmod(directory, 0o700)
        for item in manifest.get("files", []):
            rel = str(item["path"])
            source_path = package / rel
            target_path = staging / rel
            target_path.parent.mkdir(parents=True, exist_ok=True)
            source_descriptor = os.open(
                source_path,
                os.O_RDONLY
                | getattr(os, "O_NOFOLLOW", 0)
                | getattr(os, "O_CLOEXEC", 0),
            )
            try:
                observed = os.fstat(source_descriptor)
                if (
                    not stat.S_ISREG(observed.st_mode)
                    or observed.st_size != int(item["size"])
                    or stat.S_IMODE(observed.st_mode) != int(item["source_mode"])
                    or sha256_descriptor(source_descriptor) != item["sha256"]
                ):
                    raise InstallSyncError(
                        f"skill package changed during staging: {source_path}"
                    )
                copy_descriptor2(source_descriptor, target_path, observed)
                skill_fault("during_staging")
            finally:
                os.close(source_descriptor)
        for item in sorted(
            manifest.get("directories", []),
            key=lambda value: str(value["path"]).count("/"),
            reverse=True,
        ):
            os.chmod(
                staging / str(item["path"]),
                int(item["source_mode"]),
                follow_symlinks=False,
            )
        seal_generation(staging, manifest, allow_publish_root=True)
        os.chmod(staging, 0o700)
        os.replace(staging, generation)
        skill_fault("after_generation_rename")
        os.chmod(generation, int(manifest["installed_root_mode"]))
        fsync_directory(generation)
        fsync_directory(generations)
        fsync_directory(store)
    finally:
        if staging.exists():
            for current, dir_names, _ in os.walk(staging):
                os.chmod(current, 0o700)
            shutil.rmtree(staging)
    return generation


def parse_skill_generation_journal(
    raw: bytes,
) -> tuple[list[dict[str, Any]], int, str]:
    events: list[dict[str, Any]] = []
    valid_end = 0
    lines = raw.splitlines(keepends=True)
    for offset, raw_line in enumerate(lines):
        index = offset + 1
        complete = raw_line.endswith(b"\n")
        line = raw_line.rstrip(b"\r\n")
        try:
            event = json.loads(line.decode("utf-8"))
        except json.JSONDecodeError as exc:
            if offset == len(lines) - 1 and not complete:
                return events, valid_end, "torn"
            raise InstallSyncError(f"skill activation journal malformed at line {index}") from exc
        except UnicodeDecodeError as exc:
            if offset == len(lines) - 1 and not complete:
                return events, valid_end, "torn"
            raise InstallSyncError(f"skill activation journal malformed at line {index}") from exc
        if not isinstance(event, dict) or event.get("sequence") != index:
            raise InstallSyncError(
                f"skill activation journal sequence invalid at line {index}"
            )
        if canonical_json_bytes(event) != line:
            raise InstallSyncError(
                f"skill activation journal is not canonical at line {index}"
            )
        validate_skill_generation_event(event, events, index)
        events.append(event)
        valid_end += len(raw_line)
        if offset == len(lines) - 1 and not complete:
            return events, valid_end, "missing_newline"
    return events, valid_end, ""


def validate_skill_generation_event(
    event: dict[str, Any],
    prior: list[dict[str, Any]],
    index: int,
) -> None:
    event_type = event.get("event_type")
    required_by_type = {
        "PREPARED": (
            "authorization_id",
            "task_id",
            "attempt_id",
            "candidate_generation_id",
            "candidate_tree_hash",
            "candidate_source_commit",
            "candidate_contract_version",
        ),
        "ACTIVATED": (
            "generation_id",
            "tree_hash",
            "source_commit",
            "contract_version",
        ),
        "RECOVERED_ACTIVATED": (
            "generation_id",
            "tree_hash",
            "source_commit",
            "contract_version",
        ),
        "ROLLBACK_PREPARED": (
            "authorization_id",
            "task_id",
            "attempt_id",
            "from_generation_id",
            "target_generation_id",
            "target_tree_hash",
            "target_source_commit",
            "target_contract_version",
        ),
        "ROLLED_BACK": (
            "generation_id",
            "tree_hash",
            "source_commit",
            "contract_version",
            "replaced_generation_id",
        ),
        "RECOVERED_ROLLED_BACK": (
            "generation_id",
            "tree_hash",
            "source_commit",
            "contract_version",
            "replaced_generation_id",
        ),
        "FRESH_PROCESS_DISCOVERED": (
            "loaded_generation_id",
            "tree_hash",
            "source_commit",
            "contract_version",
        ),
    }
    common = ("event_id", "event_type", "transaction_id", "timestamp")
    if (
        event.get("schema_version") != 1
        or event_type not in required_by_type
        or not all(
            isinstance(event.get(field), str) and bool(event.get(field))
            for field in (*common, *required_by_type[event_type])
        )
    ):
        raise InstallSyncError(
            f"skill activation journal event schema invalid at line {index}"
        )

    transaction_id = event["transaction_id"]
    if event_type in {"ACTIVATED", "RECOVERED_ACTIVATED"}:
        prepared = next(
            (
                item
                for item in reversed(prior)
                if item.get("event_type") == "PREPARED"
                and item.get("transaction_id") == transaction_id
            ),
            None,
        )
        identity_fields = (
            ("candidate_generation_id", "generation_id"),
            ("candidate_tree_hash", "tree_hash"),
            ("candidate_source_commit", "source_commit"),
            ("candidate_contract_version", "contract_version"),
            ("previous_generation_id", "previous_generation_id"),
        )
    elif event_type in {"ROLLED_BACK", "RECOVERED_ROLLED_BACK"}:
        prepared = next(
            (
                item
                for item in reversed(prior)
                if item.get("event_type") == "ROLLBACK_PREPARED"
                and item.get("transaction_id") == transaction_id
            ),
            None,
        )
        identity_fields = (
            ("target_generation_id", "generation_id"),
            ("target_tree_hash", "tree_hash"),
            ("target_source_commit", "source_commit"),
            ("target_contract_version", "contract_version"),
            ("from_generation_id", "replaced_generation_id"),
        )
    elif event_type == "FRESH_PROCESS_DISCOVERED":
        prepared = next(
            (
                item
                for item in reversed(prior)
                if item.get("event_type")
                in {
                    "ACTIVATED",
                    "RECOVERED_ACTIVATED",
                    "ROLLED_BACK",
                    "RECOVERED_ROLLED_BACK",
                }
                and item.get("transaction_id") == transaction_id
            ),
            None,
        )
        identity_fields = (
            ("generation_id", "loaded_generation_id"),
            ("tree_hash", "tree_hash"),
            ("source_commit", "source_commit"),
            ("contract_version", "contract_version"),
        )
    else:
        return

    if prepared is None or any(
        prepared.get(source_field) != event.get(event_field)
        for source_field, event_field in identity_fields
    ):
        raise InstallSyncError(
            f"skill activation journal transaction mismatch at line {index}"
        )


def open_skill_generation_journal(
    store: Path,
    *,
    create: bool,
    writable: bool,
) -> tuple[int | None, int]:
    parent = os.open(
        store,
        os.O_RDONLY
        | os.O_DIRECTORY
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_CLOEXEC", 0),
    )
    flags = (
        getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_NONBLOCK", 0)
        | getattr(os, "O_CLOEXEC", 0)
        | (os.O_RDWR if writable else os.O_RDONLY)
    )
    try:
        descriptor = os.open(SKILL_GENERATION_JOURNAL, flags, dir_fd=parent)
    except FileNotFoundError:
        if not create:
            return None, parent
        descriptor = os.open(
            SKILL_GENERATION_JOURNAL,
            flags | os.O_CREAT | os.O_EXCL,
            0o600,
            dir_fd=parent,
        )
        os.fsync(parent)
    except OSError as exc:
        os.close(parent)
        raise InstallSyncError("skill activation journal is not a regular file") from exc
    observed = os.fstat(descriptor)
    if (
        not stat.S_ISREG(observed.st_mode)
        or observed.st_uid != os.geteuid()
        or stat.S_IMODE(observed.st_mode) & 0o077
    ):
        os.close(descriptor)
        os.close(parent)
        raise InstallSyncError(
            "skill activation journal must be an owner-private regular file"
        )
    return descriptor, parent


def read_descriptor_bytes(descriptor: int) -> bytes:
    os.lseek(descriptor, 0, os.SEEK_SET)
    chunks: list[bytes] = []
    while True:
        chunk = os.read(descriptor, 1024 * 1024)
        if not chunk:
            return b"".join(chunks)
        chunks.append(chunk)


def skill_generation_events(store: Path) -> list[dict[str, Any]]:
    descriptor, parent = open_skill_generation_journal(
        store,
        create=False,
        writable=False,
    )
    if descriptor is None:
        os.close(parent)
        return []
    try:
        fcntl.flock(descriptor, fcntl.LOCK_SH)
        events, _valid_end, _tail_state = parse_skill_generation_journal(
            read_descriptor_bytes(descriptor)
        )
        return events
    finally:
        os.close(descriptor)
        os.close(parent)


def append_skill_generation_event(
    store: Path,
    event_type: str,
    transaction_id: str,
    **fields: Any,
) -> dict[str, Any]:
    descriptor, parent = open_skill_generation_journal(
        store,
        create=True,
        writable=True,
    )
    assert descriptor is not None
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        events, valid_end, tail_state = parse_skill_generation_journal(
            read_descriptor_bytes(descriptor)
        )
        if tail_state == "torn":
            os.ftruncate(descriptor, valid_end)
            os.fsync(descriptor)
        elif tail_state == "missing_newline":
            os.lseek(descriptor, 0, os.SEEK_END)
            os.write(descriptor, b"\n")
            os.fsync(descriptor)
        event = {
            "schema_version": 1,
            "sequence": len(events) + 1,
            "event_id": f"skill-generation-{uuid.uuid4().hex}",
            "event_type": event_type,
            "transaction_id": transaction_id,
            "timestamp": utc_now(),
            **fields,
        }
        validate_skill_generation_event(event, events, len(events) + 1)
        encoded = canonical_json_bytes(event) + b"\n"
        os.lseek(descriptor, 0, os.SEEK_END)
        if os.environ.get("OMX_INSTALL_SYNC_FAULT_POINT") == (
            f"during_{event_type.lower()}_journal"
        ):
            os.write(descriptor, b'{"event_type":')
            os.fsync(descriptor)
            os.kill(os.getpid(), signal.SIGKILL)
        view = memoryview(encoded)
        while view:
            view = view[os.write(descriptor, view):]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
        os.close(parent)
    return event


def require_reconciled_generation_state(
    store: Path,
) -> list[dict[str, Any]]:
    events = skill_generation_events(store)
    latest = next(
        (
            event
            for event in reversed(events)
            if event.get("event_type")
            in {
                "PREPARED",
                "ACTIVATED",
                "RECOVERED_ACTIVATED",
                "ROLLBACK_PREPARED",
                "ROLLED_BACK",
                "RECOVERED_ROLLED_BACK",
            }
        ),
        None,
    )
    if latest is None:
        return events
    if latest.get("event_type") in {"PREPARED", "ROLLBACK_PREPARED"}:
        raise InstallSyncError(
            "unfinished skill generation transaction requires reconcile"
        )
    if not any(
        event.get("event_type") == "FRESH_PROCESS_DISCOVERED"
        and event.get("transaction_id") == latest.get("transaction_id")
        for event in events
    ):
        raise InstallSyncError(
            "skill generation transaction missing discovery; reconcile required"
        )
    return events


def cleanup_skill_staging_orphans(store: Path) -> None:
    generations = store / "generations"
    removed = False
    for staging in sorted(generations.glob(".staging-*")):
        observed = staging.lstat()
        if (
            stat.S_ISLNK(observed.st_mode)
            or not stat.S_ISDIR(observed.st_mode)
            or observed.st_uid != os.geteuid()
        ):
            raise InstallSyncError(
                f"skill staging orphan is not an installer-owned directory: {staging}"
            )
        directories = [staging]
        for current, dir_names, file_names in os.walk(staging, followlinks=False):
            current_path = Path(current)
            for name in dir_names:
                path = current_path / name
                child = path.lstat()
                if (
                    stat.S_ISLNK(child.st_mode)
                    or not stat.S_ISDIR(child.st_mode)
                    or child.st_uid != os.geteuid()
                ):
                    raise InstallSyncError(
                        f"skill staging orphan contains unsafe entry: {path}"
                    )
                directories.append(path)
            for name in file_names:
                path = current_path / name
                child = path.lstat()
                if not stat.S_ISREG(child.st_mode) or child.st_uid != os.geteuid():
                    raise InstallSyncError(
                        f"skill staging orphan contains unsafe entry: {path}"
                    )
        for directory in directories:
            os.chmod(directory, 0o700, follow_symlinks=False)
        shutil.rmtree(staging)
        removed = True
    if removed:
        fsync_directory(generations)


def skill_fault(point: str) -> None:
    if os.environ.get("OMX_INSTALL_SYNC_FAULT_POINT") == point:
        os.kill(os.getpid(), signal.SIGKILL)


def active_generation(active: Path, store: Path) -> tuple[Path, dict[str, Any]]:
    try:
        observed = active.lstat()
    except FileNotFoundError as exc:
        raise InstallSyncError(f"active skill pointer missing: {active}") from exc
    if not stat.S_ISLNK(observed.st_mode):
        raise InstallSyncError(f"active skill path is not a generation pointer: {active}")
    target = (active.parent / os.readlink(active)).resolve()
    generations = (store / "generations").resolve()
    if target.parent != generations:
        raise InstallSyncError("active skill pointer escapes the generation store")
    manifest = validate_generation(target, target.name)
    return target, manifest


def switch_active_generation(active: Path, generation: Path) -> None:
    temporary = active.with_name(f".{active.name}.{uuid.uuid4().hex}.tmp")
    relative = os.path.relpath(generation, active.parent)
    try:
        temporary.symlink_to(relative, target_is_directory=True)
        os.replace(temporary, active)
        fsync_directory(active.parent)
    finally:
        temporary.unlink(missing_ok=True)


def package_metadata(package: Path) -> tuple[str, str]:
    payload = read_json_nofollow(package / "plugin-manifest.json")
    name = str(payload.get("name") or "")
    version = str(payload.get("version") or "")
    if not name or not version or not (package / "SKILL.md").is_file():
        raise InstallSyncError("skill package metadata is incomplete")
    if version_tuple(version) is None:
        raise InstallSyncError("skill package contract version must be numeric dotted components")
    return name, version


def _require_installed_installer_provenance() -> None:
    from visible_agent_orchestrator.companion_runtime_identity import (
        RuntimeIdentityError,
        receipt_path,
    )

    control = control_root()
    try:
        receipt = current_runtime_receipt(control)
    except (RuntimeIdentityError, InstallSyncError, OSError) as exc:
        raise InstallSyncError(
            "installed installer provenance is missing or unverifiable: "
            f"{exc}; expected the trusted runtime identity receipt at "
            f"{receipt_path(str(control))} to cover the currently installed "
            "installer bytes. Controlled next step: from the exact clean "
            "source worktree and manifest that match the installed state, "
            "run the authorized runtime-identity publication entry "
            "(apply --publish-runtime-identity, optionally with "
            "--authorize-leader) to bind or refresh that receipt, then retry "
            "this command"
        ) from exc
    if Path(str(receipt["target_root"])).resolve() != REPO_ROOT.resolve():
        raise InstallSyncError("installed installer provenance target root mismatch")
    installer_digest = next(
        (
            str(item["current_sha256"])
            for item in receipt["targets"]
            if str(item["target_rel"]) == "bin/omx_install_sync"
        ),
        None,
    )
    if installer_digest is None:
        raise InstallSyncError(
            "installed installer provenance does not cover omx_install_sync"
        )
    running_digest = "sha256:" + hashlib.sha256(_THIS_FILE.read_bytes()).hexdigest()
    if running_digest != installer_digest:
        raise InstallSyncError(
            "installed installer provenance does not match reviewed installer "
            f"bytes: running {running_digest} but the receipt at "
            f"{receipt_path(str(control))} recorded {installer_digest}. "
            "Controlled next step: run this command from the exact source "
            "revision the receipt covers, or publish a fresh runtime "
            "identity receipt from the exact clean source/manifest matching "
            "the installed state (apply --publish-runtime-identity, "
            "optionally with --authorize-leader) and retry"
        )


def resolve_trusted_companion_release_source(source: Path, approved_ref: str) -> str:
    source = source.resolve()
    script_common_dir = subprocess.run(
        ["git", "-C", str(REPO_ROOT), "rev-parse", "--path-format=absolute", "--git-common-dir"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=5,
        check=False,
    )
    source_side = bool(script_common_dir.returncode == 0 and script_common_dir.stdout.strip())
    if source_side:
        source_common_dir = subprocess.run(
            ["git", "-C", str(source), "rev-parse", "--path-format=absolute", "--git-common-dir"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=5,
            check=False,
        )
        if (
            source_common_dir.returncode != 0
            or Path(script_common_dir.stdout.strip()).resolve()
            != Path(source_common_dir.stdout.strip()).resolve()
        ):
            raise InstallSyncError("skill source must share the reviewed installer's Git common-dir")
    else:
        _require_installed_installer_provenance()
    origin = subprocess.run(
        ["git", "-C", str(source), "remote", "get-url", "origin"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=5,
        check=False,
    )
    if origin.returncode != 0 or origin.stdout.strip() != CANONICAL_REPOSITORY_ORIGIN:
        raise InstallSyncError("skill source origin must be WangErgouaaaa/visible-agent-orchestrator-public")
    if approved_ref != TRUSTED_INTEGRATION_REF:
        raise InstallSyncError("approved source ref must be the trusted origin integration history")
    approved = subprocess.run(
        ["git", "--no-replace-objects", "-C", str(source), "rev-parse", "--verify", f"{approved_ref}^{{commit}}"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=5,
        check=False,
    )
    if approved.returncode != 0:
        raise InstallSyncError("trusted integration history ref does not resolve")
    return approved.stdout.strip()


@contextmanager
def staged_approved_companion_package(
    source: Path,
    source_commit: str,
    skill: Any,
) -> Any:
    package = str(skill.canonical_package)
    listing = subprocess.run(
        ["git", "--no-replace-objects", "-C", str(source), "ls-tree", "-r", "-z", source_commit, "--", package],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
        timeout=10,
    )
    if listing.returncode != 0:
        raise InstallSyncError("approved package tree is unavailable")
    entries: list[tuple[str, str, int, int, str]] = []
    total_bytes = 0
    prefix = f"{package}/"
    for record in listing.stdout.split(b"\0"):
        if not record:
            continue
        try:
            header, encoded_path = record.split(b"\t", 1)
            mode, object_type, object_id = header.decode("ascii").split(" ")
            path = encoded_path.decode("utf-8")
        except (UnicodeDecodeError, ValueError) as exc:
            raise InstallSyncError("approved package tree is unreadable") from exc
        relative = path.removeprefix(prefix)
        if (
            mode not in {"100644", "100755"}
            or object_type != "blob"
            or not re.fullmatch(r"[0-9a-f]{40}", object_id)
            or not path.startswith(prefix)
            or not relative
            or relative == SKILL_GENERATION_MANIFEST
            or Path(relative).as_posix() != relative
            or ".." in Path(relative).parts
            or unicodedata.normalize("NFC", relative) != relative
        ):
            raise InstallSyncError("approved package tree contains unsupported entry")
        size = subprocess.run(
            ["git", "--no-replace-objects", "-C", str(source), "cat-file", "-s", object_id],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            timeout=10,
        )
        if size.returncode != 0 or not size.stdout.strip().isdigit():
            raise InstallSyncError("approved package blob size is unavailable")
        blob_size = int(size.stdout.strip())
        total_bytes += blob_size
        if total_bytes > DEFAULT_SKILL_PACKAGE_MAX_BYTES:
            raise InstallSyncError("approved package tree exceeds hard byte ceiling")
        entries.append((relative, object_id, int(mode[-3:], 8), blob_size, ""))
    staging_parent = Path(tempfile.mkdtemp(prefix=".companion-release-"))
    staging = staging_parent / Path(package).name
    try:
        if shutil.disk_usage(staging_parent).free < total_bytes + 65536:
            raise InstallSyncError("insufficient free space for approved package staging")
        staging.mkdir(mode=0o755)
        os.chmod(staging, 0o755)
        directories = {Path(relative).parent for relative, _, _, _, _ in entries}
        for directory in sorted(directories, key=lambda value: (len(value.parts), value.as_posix())):
            if directory == Path("."):
                continue
            staged_directory = staging / directory
            staged_directory.mkdir(mode=0o755)
            os.chmod(staged_directory, 0o755)
        expected_files: list[dict[str, Any]] = []
        for relative, object_id, mode, blob_size, _ in entries:
            blob = subprocess.run(
            ["git", "--no-replace-objects", "-C", str(source), "cat-file", "blob", object_id],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
                timeout=10,
            )
            if blob.returncode != 0 or len(blob.stdout) != blob_size:
                raise InstallSyncError("approved package blob is unavailable")
            target = staging / relative
            descriptor = os.open(
                target,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
                mode,
            )
            try:
                view = memoryview(blob.stdout)
                while view:
                    view = view[os.write(descriptor, view):]
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
            os.chmod(target, mode, follow_symlinks=False)
            expected_files.append(
                {
                    "path": relative,
                    "sha256": hashlib.sha256(blob.stdout).hexdigest(),
                    "size": blob_size,
                    "source_mode": mode,
                    "installed_mode": mode & ~0o222,
                }
            )
        skill_bytes = read_regular_bytes_nofollow(staging / "SKILL.md")
        frontmatter = skill_bytes.decode("utf-8").splitlines()
        if not frontmatter or frontmatter[0] != "---":
            raise InstallSyncError("skill package metadata requires closed frontmatter")
        try:
            closing_index = frontmatter.index("---", 1)
        except ValueError as exc:
            raise InstallSyncError("skill package metadata requires closed frontmatter") from exc
        names = [line.removeprefix("name: ") for line in frontmatter[1:closing_index] if line.startswith("name: ")]
        if names != [str(skill.skill_id)]:
            raise InstallSyncError("skill package metadata name must match the managed skill")
        metadata_path = staging / "plugin-manifest.json"
        if metadata_path.exists():
            metadata = read_json_nofollow(metadata_path)
            if (
                metadata.get("name") != skill.active_name
                or metadata.get("entrypoint") != "SKILL.md"
                or metadata.get("version") != skill.contract_version
            ):
                raise InstallSyncError("skill package metadata must match the registry contract")
        for current, _, files in os.walk(staging):
            for filename in files:
                if filename.endswith(".json"):
                    read_json_value_nofollow(Path(current) / filename)
        if skill.skill_id == "visible-agent-orchestrator":
            validator = REPO_ROOT / "bin" / "omx_plugin_check"
            validated = subprocess.run(
                [str(validator), "validate", "--plugin", str(staging), "--json"],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=30,
                check=False,
            )
            if validated.returncode != 0:
                raise InstallSyncError(
                    "canonical skill package validation failed: "
                    + (validated.stderr.strip() or validated.stdout.strip())
                )
        for current, _, files in os.walk(staging):
            for filename in files:
                if filename != "test-prompts.json":
                    continue
                prompts = read_json_value_nofollow(Path(current) / filename)
                if not isinstance(prompts, list) or not prompts:
                    raise InstallSyncError("test prompts must be a nonempty list")
                seen: set[str | int] = set()
                for prompt in prompts:
                    if not isinstance(prompt, dict) or set(prompt) - {"id", "name", "prompt", "expected"}:
                        raise InstallSyncError("test prompt fields are invalid")
                    identifier = prompt.get("id")
                    if (
                        type(identifier) not in {str, int}
                        or identifier == ""
                        or identifier in seen
                        or not all(
                        isinstance(prompt.get(field), str) and prompt[field].strip()
                        for field in ("prompt", "expected")
                        )
                    ):
                        raise InstallSyncError("test prompt identity is invalid")
                    seen.add(identifier)
        for current, _, _ in os.walk(staging, topdown=False):
            fsync_directory(Path(current))
        fsync_directory(staging)
        manifest = skill_tree_manifest(
            staging,
            package_name=str(skill.active_name),
            contract_version=str(skill.contract_version),
            source_commit=source_commit,
            max_bytes=DEFAULT_SKILL_PACKAGE_MAX_BYTES,
        )
        expected_base = {
            "schema_version": 1,
            "package_name": str(skill.active_name),
            "contract_version": str(skill.contract_version),
            "source_commit": source_commit,
            "symlink_policy": "reject",
            "source_root_mode": 0o755,
            "installed_root_mode": 0o500,
            "total_bytes": total_bytes,
            "directories": [
                {"path": directory.as_posix(), "source_mode": 0o755, "installed_mode": 0o555}
                for directory in sorted(directories, key=lambda value: value.as_posix())
                if directory != Path(".")
            ],
            "files": sorted(expected_files, key=lambda item: item["path"]),
        }
        expected_digest = hashlib.sha256(canonical_json_bytes(expected_base)).hexdigest()
        expected_manifest = {**expected_base, "generation_id": expected_digest, "tree_hash": expected_digest}
        if manifest != expected_manifest:
            raise InstallSyncError("fixed Git inventory does not match staged manifest")
        verify_tree_against_manifest(
            staging,
            manifest,
            allow_source_modes=True,
            require_manifest_file=False,
        )
        yield staging, manifest
    finally:
        shutil.rmtree(staging_parent, ignore_errors=True)


def build_companion_release_plan(source: Path, source_commit: str) -> dict[str, Any]:
    from visible_agent_orchestrator.companion_skills import (
        RegistryError,
        assemble_release_plan,
        load_committed_registry,
        skill_install_target,
    )

    registry, registry_digest = load_committed_registry(source, source_commit, REPO_ROOT)
    try:
        targets = {
            skill.skill_id: absolute_active_path(str(skill_install_target(skill)))
            for skill in registry.skills
        }
    except RegistryError as exc:
        raise InstallSyncError(str(exc)) from exc
    manifests: dict[str, dict[str, Any]] = {}
    for skill in registry.skills:
        with staged_approved_companion_package(source, source_commit, skill) as (_, manifest):
            manifests[skill.skill_id] = manifest
    return assemble_release_plan(registry, source_commit, registry_digest, manifests, targets)


def verify_approved_skill_source(
    source: Path,
    package_rel: str,
    approved_ref: str,
) -> tuple[Path, str]:
    validate_relative_path(package_rel, "package")
    if Path(package_rel).as_posix() != CANONICAL_SKILL_PACKAGE:
        raise InstallSyncError(
            f"skill activation requires canonical skill package: {CANONICAL_SKILL_PACKAGE}"
        )
    source = source.resolve()
    approved_commit = resolve_trusted_companion_release_source(source, approved_ref)
    unresolved_package = source / package_rel
    current = source
    for part in Path(package_rel).parts:
        current = current / part
        try:
            observed = current.lstat()
        except FileNotFoundError as exc:
            raise InstallSyncError(f"skill package path missing: {current}") from exc
        if stat.S_ISLNK(observed.st_mode):
            raise InstallSyncError(f"skill package path symlink rejected: {current}")
    package = unresolved_package.resolve()
    if package != source and source not in package.parents:
        raise InstallSyncError("skill package escapes source repository")
    provenance = source_git_provenance(source)
    commit = str(provenance.get("source_git_commit") or "")
    if not provenance.get("source_git_available") or not commit:
        raise InstallSyncError("skill activation requires Git source provenance")
    if provenance.get("source_git_dirty"):
        raise InstallSyncError("skill activation requires a clean source checkout")
    if commit != approved_commit:
        raise InstallSyncError(
            "candidate source HEAD must equal the exact approved commit"
        )
    validator = REPO_ROOT / "bin" / "omx_plugin_check"
    if not validator.is_file():
        raise InstallSyncError("reviewed canonical skill package validator is missing")
    validated = subprocess.run(
        [str(validator), "validate", "--plugin", str(package), "--json"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=30,
        check=False,
    )
    if validated.returncode != 0:
        raise InstallSyncError(
            "canonical skill package validation failed: "
            + (validated.stderr.strip() or validated.stdout.strip())
        )
    return package, commit


def version_tuple(value: str) -> tuple[int, ...] | None:
    parts = value.split(".")
    if not parts or any(not part.isdigit() for part in parts):
        return None
    return tuple(int(part) for part in parts)


def require_generation_authorization(args: argparse.Namespace) -> dict[str, str]:
    values = {
        "authorization_id": str(args.authorization_id).strip(),
        "task_id": str(args.task_id).strip(),
        "attempt_id": str(args.attempt_id).strip(),
    }
    if any(not value for value in values.values()):
        raise InstallSyncError(
            "skill generation mutation requires authorization id, task id, and attempt id"
        )
    return values


def skill_generation_scope(payload: dict[str, Any]) -> dict[str, str]:
    return {
        "kind": "install_root",
        "id": "skill-generation:" + canonical_json_bytes(payload).decode("utf-8"),
    }


def activation_capability_scope(
    args: argparse.Namespace,
    active: Path,
    source_commit: str,
) -> dict[str, str]:
    return skill_generation_scope(
        {
            "action": "activate",
            "active_root": str(active),
            "allow_downgrade": bool(args.allow_downgrade),
            "allow_replacement": bool(args.allow_replacement),
            "approved_ref": str(args.approved_ref),
            "package": Path(str(args.package)).as_posix(),
            "source_commit": source_commit,
            "source_root": str(Path(args.source).resolve()),
        }
    )


def bundle_activation_capability_scope(
    release: dict[str, Any],
    args: argparse.Namespace,
    old_closure: dict[str, Any] | None = None,
) -> dict[str, str]:
    skills = release.get("skills")
    if not isinstance(skills, list) or len(skills) != 2:
        raise InstallSyncError("bundle release closure is incomplete")
    normalized_old = old_closure or {
        "release_id": "uninitialized",
        "skills": [
            {
                "skill_id": item["skill_id"],
                "target": item["target"],
                "state": "absent",
                "manifest": None,
            }
            for item in skills
        ],
    }
    closure = [
        {
            "skill_id": item["skill_id"],
            "generation_id": item["generation_id"],
            "tree_hash": item["tree_hash"],
            "target": item["target"],
            "contract_version": item["contract_version"],
        }
        for item in skills
    ]
    return skill_generation_scope(
        {
            "action": "activate",
            "release_id": release["release_id"],
            "release_digest": release["release_digest"],
            "registry_digest": release["registry_digest"],
            "source_commit": release["source_commit"],
            "contract_generation": release["contract_generation"],
            "runtime_identity": release["observed_runtime_identity"],
            "runtime_digest": release.get("observed_runtime_digest"),
            "runtime_compatibility": release["runtime_compatibility"],
            "skills": closure,
            "old_release_id": normalized_old["release_id"],
            "old_skills": normalized_old["skills"],
            "allow_downgrade": bool(args.allow_downgrade),
            "allow_replacement": bool(args.allow_replacement),
        }
    )


def evaluate_release_runtime_compatibility(
    release: dict[str, Any],
    control_root: Path,
) -> dict[str, Any]:
    from visible_agent_orchestrator.companion_runtime_identity import (
        RuntimeIdentityError,
        read_receipt,
    )

    try:
        receipt = read_receipt(str(control_root))
        target_root = Path(str(receipt["target_root"]))
        for item in receipt["targets"]:
            target_rel = str(item["target_rel"])
            target_path = target_root / target_rel
            if item.get("retired") is True:
                if target_path.exists() or target_path.is_symlink():
                    raise InstallSyncError(
                        "runtime receipt retired target is present: "
                        f"{target_rel}"
                    )
                continue
            with opened_target_parent(
                target_root,
                target_path,
                create_parents=False,
            ) as (parent_descriptor, target_name, verify_parent_identity):
                descriptor = os.open(
                    target_name,
                    os.O_RDONLY
                    | os.O_NOFOLLOW
                    | os.O_NONBLOCK
                    | getattr(os, "O_CLOEXEC", 0),
                    dir_fd=parent_descriptor,
                )
                try:
                    observed = os.fstat(descriptor)
                    if (
                        not stat.S_ISREG(observed.st_mode)
                        or stat.S_IMODE(observed.st_mode) != item["mode"]
                        or "sha256:" + sha256_descriptor(descriptor)
                        != item["current_sha256"]
                    ):
                        raise InstallSyncError("runtime receipt target drifted")
                    verify_parent_identity()
                finally:
                    os.close(descriptor)
    except (RuntimeIdentityError, InstallSyncError, OSError):
        observed = {
            **release,
            "observed_runtime_identity": None,
            "observed_runtime_digest": None,
            "observed_runtime_source_commit": None,
            "observed_runtime_manifest_digest": None,
            "runtime_compatibility": "unknown",
        }
        release_base = {
            key: value
            for key, value in observed.items()
            if key not in {"release_id", "release_digest"}
        }
        release_id = hashlib.sha256(canonical_json_bytes(release_base)).hexdigest()
        return {**observed, "release_id": release_id, "release_digest": "sha256:" + release_id}
    compatible = (
        receipt["runtime_identity"] == release["required_runtime_identity"]
        and receipt["contract_generation"] == release["contract_generation"]
        and receipt["runtime_attestation"] is False
    )
    observed = {
        **release,
        "observed_runtime_identity": receipt["runtime_identity"],
        "observed_runtime_digest": receipt["receipt_digest"],
        "observed_runtime_source_commit": receipt["source_commit"],
        "observed_runtime_manifest_digest": receipt["manifest_sha256"],
        "runtime_compatibility": "compatible" if compatible else "incompatible",
    }
    observed["skills"] = [
        {
            **skill,
            "observed_runtime_identity": observed["observed_runtime_identity"],
            "observed_runtime_digest": observed["observed_runtime_digest"],
            "runtime_compatibility": observed["runtime_compatibility"],
        }
        for skill in release["skills"]
    ]
    release_base = {
        key: value
        for key, value in observed.items()
        if key not in {"release_id", "release_digest"}
    }
    release_id = hashlib.sha256(canonical_json_bytes(release_base)).hexdigest()
    return {**observed, "release_id": release_id, "release_digest": "sha256:" + release_id}


def ensure_bundle_authorization_not_reused(
    control_root: Path,
    authorization: dict[str, Any],
    expected_intent: dict[str, Any],
) -> bool:
    releases = control_root / "releases"
    try:
        observed = releases.lstat()
    except FileNotFoundError:
        return False
    if (
        stat.S_ISLNK(observed.st_mode)
        or not stat.S_ISDIR(observed.st_mode)
        or observed.st_uid != os.geteuid()
        or stat.S_IMODE(observed.st_mode) != 0o700
    ):
        raise InstallSyncError("bundle release directory is not owner-private")
    authorization_id = str(authorization.get("authorization_id") or "")
    found = False
    for candidate in releases.glob("*.json"):
        try:
            intent = read_bundle_intent(control_root, candidate.stem)
        except InstallSyncError:
            continue
        candidate_id = str((intent.get("authorization") or {}).get("authorization_id") or "")
        if candidate_id != authorization_id:
            continue
        if intent != expected_intent:
            raise InstallSyncError("bundle activation authorization id already consumed")
        found = True
    return found


def companion_bootstrap_scope() -> dict[str, str]:
    return skill_generation_scope(
        {
            "action": "bootstrap-companion-skills",
            "contract_generation": TRUSTED_CONTRACT_GENERATION,
            "mutation_registry_sha256": mutation_registry_sha256(),
            "runtime_identity": TRUSTED_RUNTIME_IDENTITY,
        }
    )


def rollback_capability_scope(
    args: argparse.Namespace,
    active: Path,
    *,
    from_generation_id: str,
) -> dict[str, str]:
    return skill_generation_scope(
        {
            "action": "rollback",
            "active_root": str(active),
            "allow_downgrade": bool(args.allow_downgrade),
            "from_generation_id": from_generation_id,
            "target_generation_id": str(args.expected_generation),
            "target_source_commit": str(args.expected_source_commit),
            "target_tree_hash": str(args.expected_tree_hash),
        }
    )


def safe_authorization_id_component(value: str, label: str) -> str:
    if (
        not value
        or value in {".", ".."}
        or "/" in value
        or "\\" in value
        or "\x00" in value
    ):
        raise InstallSyncError(f"{label} must be a simple id")
    return value


@contextmanager
def authorized_install_mutation(
    args: argparse.Namespace,
    target_scope: dict[str, str],
    *,
    consume: bool = False,
    authorization_resolver: Any = None,
) -> Any:
    if authorization_resolver is not None and consume:
        raise InstallSyncError(
            "leader authorization resolver is only valid on the non-consuming boundary"
        )
    control_root = Path(args.control_root).resolve()
    try:
        contract = derive_operation_contract("install_sync")
        required_gates = list(contract["required_mutation_gates"])
        applied_gates = [
            "global_zero_lock",
            "install_authorization",
            "install_sync",
        ]
        validate_mutation_gate_union(required_gates, applied_gates)
        with global_mutation_gate(control_root, exclusive=True):
            ensure_global_quiescence(control_root)
            if authorization_resolver is not None:
                # Leader mode: append the exact grant only now - after the
                # admission global gate and admission-root quiescence hold,
                # inside the caller's runtime-root gate - so no lock can
                # arrive between any quiescence check and the append (#778).
                authorization_resolver(args)
            authorization = require_generation_authorization(args)
            ledger = AuthorizationLedger(
                control_root
                / ".omx"
                / "framework"
                / "team"
                / "operation-authorizations"
                / safe_authorization_id_component(
                    authorization["task_id"],
                    "task id",
                )
                / (
                    safe_authorization_id_component(
                        authorization["attempt_id"],
                        "attempt id",
                    )
                    + ".jsonl"
                ),
                task_id=authorization["task_id"],
                attempt_id=authorization["attempt_id"],
            )
            boundary = int(args.ledger_boundary)
            if boundary < 1:
                raise OperationAuthorizationError(
                    "authorization boundary is invalid"
                )
            if consume:
                capability = ledger.require_active_authorization(
                    authorization["authorization_id"],
                    expected_boundary=boundary,
                )
                validated = validate_operation_capability(
                    capability,
                    operation_kind="install_sync",
                    target_scope=target_scope,
                    required_mutation_gates=required_gates,
                    task_id=authorization["task_id"],
                    attempt_id=authorization["attempt_id"],
                )
                consumed = ledger.consume_authorization(
                    authorization["authorization_id"],
                    principal=authorization["task_id"],
                    expected_boundary=boundary,
                )
                if consumed is None:
                    raise InstallSyncError(
                        "install authorization could not be consumed"
                    )
                yield {
                    "authorization": authorization,
                    "ledger": ledger,
                    "ledger_boundary": boundary,
                    "capability_contract_id": validated["contract_id"],
                    "capability_contract_hash": validated["contract_hash"],
                    "target_scope": validated["scope"],
                    "required_mutation_gates": required_gates,
                    "control_root": str(control_root),
                }
                return
            with ledger.mutation_boundary(
                authorization["authorization_id"],
                expected_boundary=boundary,
            ) as capability:
                validated = validate_operation_capability(
                    capability,
                    operation_kind="install_sync",
                    target_scope=target_scope,
                    required_mutation_gates=required_gates,
                    task_id=authorization["task_id"],
                    attempt_id=authorization["attempt_id"],
                )
                yield {
                    "authorization": authorization,
                    "ledger": ledger,
                    "ledger_boundary": boundary,
                    "capability_contract_id": validated["contract_id"],
                    "capability_contract_hash": validated["contract_hash"],
                    "target_scope": validated["scope"],
                    "required_mutation_gates": required_gates,
                    "control_root": str(control_root),
                }
    except (OperationAuthorizationError, ValueError) as exc:
        raise InstallSyncError(str(exc)) from exc


def ensure_authorization_not_reused(
    store: Path,
    authorization: dict[str, str],
) -> None:
    for event in skill_generation_events(store):
        if (
            event.get("event_type") in {"PREPARED", "ROLLBACK_PREPARED"}
            and event.get("authorization_id") == authorization["authorization_id"]
        ):
            raise InstallSyncError("skill generation authorization id already consumed")


def legacy_manifest(active: Path, max_bytes: int) -> dict[str, Any]:
    return skill_tree_manifest(
        active,
        package_name=active.name,
        contract_version="legacy",
        source_commit="legacy-bootstrap",
        max_bytes=max_bytes,
    )


def install_bootstrap_previous(
    active: Path,
    store: Path,
    manifest: dict[str, Any],
) -> Path:
    previous = store / "generations" / str(manifest["generation_id"])
    if previous.exists():
        raise InstallSyncError("bootstrap previous generation already exists")
    os.replace(active, previous)
    fsync_directory(active.parent)
    fsync_directory(store / "generations")
    skill_fault("after_bootstrap_rename")
    seal_generation(
        previous,
        manifest,
        fault_after_manifest="during_bootstrap_seal",
    )
    return previous


def fresh_skill_discovery(active: Path) -> dict[str, Any]:
    completed = subprocess.run(
        [str(_THIS_FILE), "skill-discover", "--active", str(active), "--json"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=15,
        check=False,
    )
    if completed.returncode != 0:
        raise InstallSyncError(
            "fresh-process skill discovery failed: " + completed.stderr.strip()
        )
    try:
        receipt = json.loads(completed.stdout)
    except json.JSONDecodeError as exc:
        raise InstallSyncError("fresh-process skill discovery returned invalid JSON") from exc
    if not isinstance(receipt, dict):
        raise InstallSyncError("fresh-process skill discovery returned invalid receipt")
    return receipt


def record_fresh_skill_discovery(
    active: Path,
    store: Path,
    transaction_id: str,
) -> dict[str, Any]:
    receipt = fresh_skill_discovery(active)
    append_skill_generation_event(
        store,
        "FRESH_PROCESS_DISCOVERED",
        transaction_id,
        loaded_generation_id=receipt["loaded_generation_id"],
        tree_hash=receipt["tree_hash"],
        contract_version=receipt["contract_version"],
        source_commit=receipt["source_commit"],
        discovery_pid=receipt["process_id"],
    )
    return receipt


def command_skill_activate(args: argparse.Namespace) -> int:
    ensure_allow_write(bool(args.allow_write))
    if (
        args.max_package_bytes < 1
        or args.max_package_bytes > DEFAULT_SKILL_PACKAGE_MAX_BYTES
    ):
        raise InstallSyncError(
            "skill package byte ceiling cannot exceed the fixed installer maximum"
        )
    active = absolute_active_path(args.active)
    try:
        from visible_agent_orchestrator.companion_skills import (
            load_registry,
            skill_install_target,
        )
    except ModuleNotFoundError as exc:
        raise InstallSyncError(
            f"registry-managed skill classification is unavailable: {exc}"
        ) from exc
    try:
        registry = load_registry(DEFAULT_COMPANION_SKILL_REGISTRY, REPO_ROOT)
    except Exception as exc:
        raise InstallSyncError(
            f"registry-managed skill classification is unavailable: {exc}"
        ) from exc
    managed_targets = {skill_install_target(skill) for skill in registry.skills}
    held_root = held_exclusive_admission_root()
    if Path(args.control_root).resolve() != held_root:
        raise InstallSyncError("single-skill control root does not match admission root")
    if active in managed_targets and lifecycle_state(held_root).value != "UNINITIALIZED":
        raise InstallSyncError(
            "registry-managed skill requires bundle activation lifecycle"
        )
    planned_package, planned_commit = verify_approved_skill_source(
        Path(args.source),
        args.package,
        args.approved_ref,
    )
    planned_name, planned_version = package_metadata(planned_package)
    planned_manifest = skill_tree_manifest(
        planned_package,
        package_name=planned_name,
        contract_version=planned_version,
        source_commit=planned_commit,
        max_bytes=args.max_package_bytes,
    )
    target_scope = activation_capability_scope(args, active, planned_commit)
    with authorized_install_mutation(args, target_scope) as ctx:
        authorization = ctx["authorization"]
        if absolute_active_path(args.active) != active:
            raise InstallSyncError(
                "active skill path changed before mutation boundary"
            )
        package, source_commit = verify_approved_skill_source(
            Path(args.source),
            args.package,
            args.approved_ref,
        )
        package_name, contract_version = package_metadata(package)
        if package_name != active.name:
            raise InstallSyncError(
                "skill package name does not match active target name"
            )
        manifest = skill_tree_manifest(
            package,
            package_name=package_name,
            contract_version=contract_version,
            source_commit=source_commit,
            max_bytes=args.max_package_bytes,
        )
        if (
            package != planned_package
            or source_commit != planned_commit
            or manifest != planned_manifest
        ):
            raise InstallSyncError(
                "skill activation inputs changed before mutation boundary"
        )
        store = ensure_skill_generation_store(active)
        require_reconciled_generation_state(store)
        ensure_authorization_not_reused(store, authorization)
        cleanup_skill_staging_orphans(store)
        if shutil.disk_usage(store).free < int(manifest["total_bytes"]) + 65536:
            raise InstallSyncError("insufficient free space for skill generation staging")
        generation = copy_skill_generation(package, store, manifest)
        verified_package, verified_commit = verify_approved_skill_source(
            Path(args.source),
            args.package,
            args.approved_ref,
        )
        verified_name, verified_version = package_metadata(verified_package)
        verified_manifest = skill_tree_manifest(
            verified_package,
            package_name=verified_name,
            contract_version=verified_version,
            source_commit=verified_commit,
            max_bytes=args.max_package_bytes,
        )
        if verified_manifest != manifest:
            raise InstallSyncError("skill package changed during generation staging")
        skill_fault("after_staging")

        previous_manifest: dict[str, Any] | None = None
        bootstrap = False
        if active.exists() or active.is_symlink():
            observed = active.lstat()
            if stat.S_ISLNK(observed.st_mode):
                _, previous_manifest = active_generation(active, store)
                if previous_manifest["generation_id"] == manifest["generation_id"]:
                    receipt = fresh_skill_discovery(active)
                    result = {
                        "ok": True,
                        "status": "already_active",
                        "generation_id": manifest["generation_id"],
                        "tree_hash": manifest["tree_hash"],
                        "previous_generation_id": manifest["generation_id"],
                        "discovery_receipt": receipt,
                    }
                    print(json.dumps(result, indent=2, sort_keys=True) if args.json else result["status"])
                    return 0
            elif stat.S_ISDIR(observed.st_mode):
                previous_manifest = legacy_manifest(active, args.max_package_bytes)
                bootstrap = True
            else:
                raise InstallSyncError("active skill path is a special file")

        if previous_manifest is not None:
            previous_version = version_tuple(str(previous_manifest["contract_version"]))
            candidate_version = version_tuple(contract_version)
            if previous_version is not None and candidate_version is not None:
                if candidate_version < previous_version and not args.allow_downgrade:
                    raise InstallSyncError("implicit skill contract downgrade rejected")
                if (
                    candidate_version == previous_version
                    and previous_manifest["tree_hash"] != manifest["tree_hash"]
                    and not args.allow_replacement
                ):
                    raise InstallSyncError(
                        "same contract version with different tree requires explicit replacement authority"
                    )
            previous_commit = str(previous_manifest.get("source_commit") or "")
            if len(previous_commit) == 40 and all(char in "0123456789abcdef" for char in previous_commit):
                ancestry = subprocess.run(
                    ["git", "-C", str(Path(args.source).resolve()), "merge-base", "--is-ancestor", previous_commit, source_commit],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=5,
                    check=False,
                )
                if ancestry.returncode != 0 and not args.allow_downgrade:
                    raise InstallSyncError("implicit skill source-history downgrade rejected")

        transaction_id = f"activate-{uuid.uuid4().hex}"
        previous_generation_id = str(
            (previous_manifest or {}).get("generation_id") or ""
        )
        append_skill_generation_event(
            store,
            "PREPARED",
            transaction_id,
            **authorization,
            active_path=str(active),
            approved_ref=args.approved_ref,
            candidate_generation_id=manifest["generation_id"],
            candidate_tree_hash=manifest["tree_hash"],
            candidate_source_commit=source_commit,
            candidate_contract_version=contract_version,
            previous_generation_id=previous_generation_id,
            previous_tree_hash=str((previous_manifest or {}).get("tree_hash") or ""),
            bootstrap=bootstrap,
            bootstrap_previous_manifest=previous_manifest if bootstrap else None,
            allow_downgrade=bool(args.allow_downgrade),
            allow_replacement=bool(args.allow_replacement),
        )
        skill_fault("after_prepared")
        if bootstrap and previous_manifest is not None:
            install_bootstrap_previous(active, store, previous_manifest)
        switch_active_generation(active, generation)
        skill_fault("after_pointer_switch")
        append_skill_generation_event(
            store,
            "ACTIVATED",
            transaction_id,
            generation_id=manifest["generation_id"],
            tree_hash=manifest["tree_hash"],
            source_commit=source_commit,
            contract_version=contract_version,
            previous_generation_id=previous_generation_id,
        )
        skill_fault("after_activated")
        receipt = record_fresh_skill_discovery(active, store, transaction_id)
        result = {
            "ok": True,
            "status": "activated",
            "transaction_id": transaction_id,
            "generation_id": manifest["generation_id"],
            "tree_hash": manifest["tree_hash"],
            "source_commit": source_commit,
            "contract_version": contract_version,
            "previous_generation_id": previous_generation_id,
            "discovery_receipt": receipt,
        }
        print(json.dumps(result, indent=2, sort_keys=True) if args.json else result["status"])
        return 0


def latest_switch_event(events: list[dict[str, Any]]) -> dict[str, Any] | None:
    recognized = {
        "PREPARED",
        "ACTIVATED",
        "RECOVERED_ACTIVATED",
        "ROLLBACK_PREPARED",
        "ROLLED_BACK",
        "RECOVERED_ROLLED_BACK",
    }
    return next(
        (event for event in reversed(events) if event.get("event_type") in recognized),
        None,
    )


def recover_prepared_activation(
    active: Path,
    store: Path,
    event: dict[str, Any],
) -> dict[str, Any]:
    candidate_id = str(event.get("candidate_generation_id") or "")
    candidate = store / "generations" / candidate_id
    manifest = validate_generation(candidate, candidate_id)
    if manifest.get("tree_hash") != event.get("candidate_tree_hash"):
        raise InstallSyncError("prepared skill generation tree mismatch")
    pointer_matches = False
    if active.is_symlink():
        current, _ = active_generation(active, store)
        pointer_matches = current.name == candidate_id
        if not pointer_matches:
            previous_id = str(event.get("previous_generation_id") or "")
            if current.name != previous_id:
                raise InstallSyncError("active pointer conflicts with prepared activation")
    elif active.exists():
        if not event.get("bootstrap") or not active.is_dir():
            raise InstallSyncError("active path conflicts with prepared activation")
        prior = event.get("bootstrap_previous_manifest")
        if not isinstance(prior, dict):
            raise InstallSyncError("prepared bootstrap manifest missing")
        verify_tree_against_manifest(
            active,
            prior,
            allow_source_modes=True,
            require_manifest_file=False,
        )
        install_bootstrap_previous(active, store, prior)
    else:
        if event.get("bootstrap"):
            prior = event.get("bootstrap_previous_manifest")
            if not isinstance(prior, dict):
                raise InstallSyncError("prepared bootstrap manifest missing")
            previous = store / "generations" / str(prior.get("generation_id") or "")
            seal_generation(previous, prior)
    if not pointer_matches:
        switch_active_generation(active, candidate)
    append_skill_generation_event(
        store,
        "RECOVERED_ACTIVATED",
        str(event["transaction_id"]),
        generation_id=candidate_id,
        tree_hash=manifest["tree_hash"],
        source_commit=manifest["source_commit"],
        contract_version=manifest["contract_version"],
        previous_generation_id=str(event.get("previous_generation_id") or ""),
    )
    receipt = record_fresh_skill_discovery(active, store, str(event["transaction_id"]))
    return {
        "ok": True,
        "status": "recovered_activated",
        "generation_id": candidate_id,
        "tree_hash": manifest["tree_hash"],
        "discovery_receipt": receipt,
    }


def recover_prepared_rollback(
    active: Path,
    store: Path,
    event: dict[str, Any],
) -> dict[str, Any]:
    from_id = str(event.get("from_generation_id") or "")
    target_id = str(event.get("target_generation_id") or "")
    target = store / "generations" / target_id
    manifest = validate_generation(target, target_id)
    if manifest.get("tree_hash") != event.get("target_tree_hash"):
        raise InstallSyncError("prepared rollback tree mismatch")
    current, _ = active_generation(active, store)
    if current.name == from_id:
        switch_active_generation(active, target)
    elif current.name != target_id:
        raise InstallSyncError("active pointer conflicts with prepared rollback")
    append_skill_generation_event(
        store,
        "RECOVERED_ROLLED_BACK",
        str(event["transaction_id"]),
        generation_id=target_id,
        tree_hash=manifest["tree_hash"],
        source_commit=manifest["source_commit"],
        contract_version=manifest["contract_version"],
        replaced_generation_id=from_id,
    )
    receipt = record_fresh_skill_discovery(active, store, str(event["transaction_id"]))
    return {
        "ok": True,
        "status": "recovered_rolled_back",
        "generation_id": target_id,
        "tree_hash": manifest["tree_hash"],
        "discovery_receipt": receipt,
    }


def command_skill_reconcile(args: argparse.Namespace) -> int:
    ensure_allow_write(bool(args.allow_write))
    active = absolute_active_path(args.active)
    control_root = Path(args.control_root).resolve()
    with global_mutation_gate(control_root, exclusive=True):
        ensure_global_quiescence(control_root)
        store = ensure_skill_generation_store(active)
        events = skill_generation_events(store)
        latest = latest_switch_event(events)
        if latest is None:
            if active.is_symlink():
                raise InstallSyncError(
                    "active pointer has no matching durable PREPARED transaction"
                )
            result = {"ok": True, "status": "legacy_active"}
        elif latest["event_type"] == "PREPARED":
            result = recover_prepared_activation(active, store, latest)
        elif latest["event_type"] == "ROLLBACK_PREPARED":
            result = recover_prepared_rollback(active, store, latest)
        else:
            current, manifest = active_generation(active, store)
            expected = str(latest.get("generation_id") or "")
            if current.name != expected:
                raise InstallSyncError(
                    "active pointer conflicts with last authorized transaction"
                )
            receipt = None
            if not any(
                event.get("event_type") == "FRESH_PROCESS_DISCOVERED"
                and event.get("transaction_id") == latest.get("transaction_id")
                for event in events
            ):
                receipt = record_fresh_skill_discovery(
                    active,
                    store,
                    str(latest["transaction_id"]),
                )
            result = {
                "ok": True,
                "status": "recovered_discovery" if receipt else "healthy",
                "generation_id": current.name,
                "tree_hash": manifest["tree_hash"],
            }
            if receipt is not None:
                result["discovery_receipt"] = receipt
        print(json.dumps(result, indent=2, sort_keys=True) if args.json else result["status"])
        return 0


def command_skill_discover(args: argparse.Namespace) -> int:
    active = absolute_active_path(args.active)
    store = skill_generation_store(active)
    generation, manifest = active_generation(active, store)
    receipt = {
        "schema_version": 1,
        "active_path": str(active),
        "resolved_generation_path": str(generation),
        "loaded_generation_id": manifest["generation_id"],
        "tree_hash": manifest["tree_hash"],
        "contract_version": manifest["contract_version"],
        "source_commit": manifest["source_commit"],
        "loaded_at": utc_now(),
        "process_id": os.getpid(),
        "runtime_attestation": False,
    }
    print(json.dumps(receipt, indent=2, sort_keys=True) if args.json else generation)
    return 0


def command_bootstrap_companion_skills(args: argparse.Namespace) -> int:
    ensure_allow_write(bool(args.allow_write))
    target_scope = companion_bootstrap_scope()
    root = held_exclusive_admission_root().resolve()
    leader_mode = bool(getattr(args, "authorize_leader", False))
    supplied_root = str(args.control_root or "").strip()
    if supplied_root and Path(supplied_root).resolve() != root:
        raise InstallSyncError("bootstrap control root must match the admission root")
    if not supplied_root and not leader_mode:
        raise InstallSyncError("bootstrap pre-made grant requires explicit control root")
    args.control_root = str(root)
    if leader_mode:
        if str(args.authorization_id or "").strip() or args.ledger_boundary is not None:
            raise InstallSyncError("--authorize-leader cannot be combined with a pre-made grant")
        task_id = safe_authorization_id_component(args.task_id, "task id")
        attempt_id = safe_authorization_id_component(args.attempt_id, "attempt id")
        authorization_id = f"bootstrap-leader-{task_id}-{attempt_id}"
        with global_mutation_gate(root, exclusive=True):
            ensure_global_quiescence(root)
            ledger = AuthorizationLedger(
                root / ".omx" / "framework" / "team" / "operation-authorizations" / task_id / f"{attempt_id}.jsonl",
                task_id=task_id,
                attempt_id=attempt_id,
            )
            if ledger.records():
                raise InstallSyncError("bootstrap authorization attempt already exists; use a new attempt")
            contract = derive_operation_contract("install_sync")
            capability = validate_operation_capability(
                {
                    "schema_version": 1,
                    "contract_id": f"contract-{authorization_id}",
                    "contract_hash": "sha256:" + hashlib.sha256(canonical_json_bytes(target_scope)).hexdigest(),
                    "authorization_id": authorization_id,
                    "authorization_source": "authorization_ledger",
                    "operation_kind": "install_sync",
                    "scope": target_scope,
                    "mutation_gates": list(contract["required_mutation_gates"]),
                    "task_id": task_id,
                    "attempt_id": attempt_id,
                },
                operation_kind="install_sync",
                target_scope=target_scope,
                required_mutation_gates=list(contract["required_mutation_gates"]),
                task_id=task_id,
                attempt_id=attempt_id,
            )
            ledger.append({
                "schema_version": 1,
                "authorization_id": authorization_id,
                "principal": "direct-user",
                "decision": "grant",
                "task_id": task_id,
                "attempt_id": attempt_id,
                "contract_hash": capability["contract_hash"],
                "created_at": datetime.now(UTC).isoformat().replace("+00:00", "Z"),
                "provenance": "bootstrap-leader-authorization",
                "capability": capability,
            })
            args.authorization_id = authorization_id
            args.ledger_boundary = ledger.boundary_sequence()
    with authorized_install_mutation(args, target_scope, consume=True):
        bootstrap_companion_skills(
            root,
            registry_sha256=mutation_registry_sha256(),
            runtime_identity=TRUSTED_RUNTIME_IDENTITY,
            contract_generation=TRUSTED_CONTRACT_GENERATION,
        )
        result = {
            "contract_generation": TRUSTED_CONTRACT_GENERATION,
            "lifecycle_state": lifecycle_state(root),
            "mutation_registry_sha256": mutation_registry_sha256(),
            "runtime_identity": TRUSTED_RUNTIME_IDENTITY,
        }
        print(json.dumps(result, sort_keys=True) if args.json else result["lifecycle_state"])
    return 0


def command_companion_skills_status(args: argparse.Namespace) -> int:
    from visible_agent_orchestrator.companion_skills import (
        RegistryError,
        load_registry,
        skill_install_target,
        status_for_registry,
    )

    try:
        registry = load_registry(DEFAULT_COMPANION_SKILL_REGISTRY, REPO_ROOT)
    except RegistryError as exc:
        raise InstallSyncError(str(exc)) from exc
    targets = {skill.skill_id: skill_install_target(skill) for skill in registry.skills}
    visible_active = targets["visible-agent-orchestrator"]
    installed_paths = dict(targets)
    active_statuses = {
        "visible-agent-orchestrator": (
            "missing" if not os.path.lexists(visible_active) else "invalid"
        )
    }
    for skill_id, target in targets.items():
        try:
            generation, _manifest = active_generation(
                target,
                skill_generation_store(target),
            )
        except InstallSyncError:
            pass
        else:
            installed_paths[skill_id] = generation
            active_statuses[skill_id] = "current"
    result = status_for_registry(
        registry,
        REPO_ROOT,
        installed_paths=installed_paths,
        active_statuses=active_statuses,
    )
    print(json.dumps(result, indent=2, sort_keys=True) if args.json else result)
    return {"current": 0, "unverified": 2, "degraded": 2, "invalid": 3}[
        str(result["overall"])
    ]


def command_companion_release_plan(args: argparse.Namespace) -> int:
    from visible_agent_orchestrator.companion_skills import (
        RegistryError,
        assemble_release_plan,
        load_committed_registry,
    )

    try:
        source = Path(args.source).resolve()
        commit = resolve_trusted_companion_release_source(source, args.approved_ref)
        assembled = build_companion_release_plan(source, commit)
    except RegistryError as exc:
        raise InstallSyncError(str(exc)) from exc
    control = (
        Path(str(args.control_root or "").strip()).resolve()
        if str(args.control_root or "").strip()
        else control_root()
    )
    # The public plan reports the evaluated release identity/skills - the
    # exact identity a subsequent activation under this control root would
    # use - so discovery and authorization can never diverge. Evaluation is
    # read-only and changes no authorization semantics.
    result = evaluate_release_runtime_compatibility(assembled, control)
    result["admission_control_root"] = str(control)
    if result.get("observed_runtime_identity"):
        from visible_agent_orchestrator.companion_runtime_identity import read_receipt

        receipt = read_receipt(str(control))
        result["runtime_target_root"] = str(receipt.get("target_root") or "")
    else:
        result["runtime_target_root"] = "unknown"
    result["runtime_receipt_path"] = str(control / "runtime-identity.json")
    result["authorization_ledger_pattern"] = str(
        control
        / ".omx"
        / "framework"
        / "team"
        / "operation-authorizations"
        / "<task-id>"
        / "<attempt-id>.jsonl"
    )
    # Append diagnostics after evaluation to preserve the release identity.
    upgrade_policy: dict[str, Any] = {
        "status": "unknown",
        "required_allow_downgrade": None,
        "required_allow_replacement": None,
        "skills": [],
    }
    try:
        preview_registry, _preview_registry_digest = load_committed_registry(
            source,
            commit,
            REPO_ROOT,
        )
        from visible_agent_orchestrator.companion_skill_admission import admission_gate

        with admission_gate(control, exclusive=True):
            preview_old_closure = authoritative_bundle_old_closure(control, preview_registry)
    except (RegistryError, InstallSyncError, AdmissionError, OSError) as exc:
        upgrade_policy["old_closure_error"] = str(exc)
    else:
        upgrade_policy["old_release_id"] = preview_old_closure["release_id"]
        preview_findings = preview_bundle_upgrade_policy(
            preview_old_closure["skills"],
            result["skills"],
            source,
            commit,
        )
        upgrade_policy["required_allow_downgrade"] = any(
            finding["required_allow_downgrade"] for finding in preview_findings
        )
        upgrade_policy["required_allow_replacement"] = any(
            finding["required_allow_replacement"] for finding in preview_findings
        )
        if any(finding["blocking_error"] for finding in preview_findings):
            upgrade_policy["status"] = "blocked"
        elif (
            upgrade_policy["required_allow_downgrade"]
            or upgrade_policy["required_allow_replacement"]
        ):
            upgrade_policy["status"] = "requires_explicit_authority"
        else:
            upgrade_policy["status"] = "satisfied"
        upgrade_policy["skills"] = preview_findings
    upgrade_policy["observation"] = (
        "read-only active-pointer snapshot; activation revalidates under locks"
    )
    result["upgrade_policy"] = upgrade_policy
    print(json.dumps(result, indent=2, sort_keys=True) if args.json else result["release_id"])
    return 0


def bundle_release_intent_path(root: Path, release_id: str) -> Path:
    return root / "releases" / f"{release_id}.json"


def read_bundle_intent(root: Path, release_id: str) -> dict[str, Any]:
    path = bundle_release_intent_path(root, release_id)
    try:
        mode = stat.S_IMODE(path.lstat().st_mode)
    except OSError as exc:
        raise InstallSyncError("bundle release intent is missing") from exc
    if mode != 0o400:
        raise InstallSyncError("bundle release intent must be mode 0400")
    return read_json_nofollow(path, owner_private=True)


def bundle_active_release_id(root: Path) -> str | None:
    """Resolve the active release id from the last terminal admission event."""
    terminal = terminal_release(root)
    if terminal is None:
        return None
    if terminal["event"] == "ACTIVATED":
        return str(terminal["new_release_id"])
    return str(terminal["old_release_id"])


def authoritative_bundle_old_closure(
    root: Path,
    registry: Any,
) -> dict[str, Any]:
    terminal = terminal_release(root)
    if terminal is None:
        return bundle_old_closure(registry)
    release_id = bundle_active_release_id(root)
    assert release_id is not None
    intent = read_bundle_intent(root, release_id)
    identity = {
        "release_id": release_id,
        "release_digest": terminal["manifest_sha256"],
        "mutation_registry_sha256": terminal["registry_sha256"],
        "admission_runtime_identity": terminal["runtime_identity"],
        "contract_generation": terminal["contract_generation"],
    }
    if any(intent.get(key) != value for key, value in identity.items()):
        raise InstallSyncError("bundle release intent conflicts with terminal admission")
    if terminal["event"] == "ACTIVATED" and intent.get("transaction_id") != terminal["transaction_id"]:
        raise InstallSyncError("bundle release intent conflicts with terminal admission")
    skills = intent.get("new_skills")
    if not isinstance(skills, list):
        raise InstallSyncError("bundle release intent closure is incomplete")
    by_id: dict[str, dict[str, Any]] = {}
    for item in skills:
        if not isinstance(item, dict):
            raise InstallSyncError("bundle release intent closure is incomplete")
        skill_id = item.get("skill_id")
        if not isinstance(skill_id, str) or not skill_id:
            raise InstallSyncError("bundle release intent closure is incomplete")
        if skill_id in by_id:
            raise InstallSyncError(
                "bundle release intent closure has duplicate skill identity"
            )
        by_id[skill_id] = item
    closure: list[dict[str, Any]] = []
    for skill in registry.skills:
        item = by_id.get(skill.skill_id)
        if item is None:
            raise InstallSyncError(
                "bundle release intent missing retained skill"
            )
        active = absolute_active_path(str(item.get("target") or ""))
        from visible_agent_orchestrator.companion_skills import skill_install_target

        if active != skill_install_target(skill):
            raise InstallSyncError("bundle release intent target conflicts with registry")
        try:
            generation, manifest = active_generation(active, skill_generation_store(active))
        except InstallSyncError as exc:
            raise InstallSyncError(
                "bundle physical generation conflicts with authoritative closure"
            ) from exc
        expected = item.get("manifest")
        if (
            not isinstance(expected, dict)
            or generation != active.resolve()
            or manifest != expected
            or any(
                item.get(key) != manifest.get(key)
                for key in ("generation_id", "tree_hash", "contract_version", "source_commit")
            )
        ):
            raise InstallSyncError("bundle physical generation conflicts with authoritative closure")
        closure.append(
            {
                "skill_id": skill.skill_id,
                "target": str(active),
                "state": "generation",
                "manifest": manifest,
            }
        )
    return {"skills": closure, "release_id": release_id}


def legacy_skill_manifest(active: Path, skill: Any) -> dict[str, Any]:
    manifest = skill_tree_manifest(
        active,
        package_name=str(skill.active_name),
        contract_version="legacy",
        source_commit="legacy-bootstrap",
        max_bytes=DEFAULT_SKILL_PACKAGE_MAX_BYTES,
    )
    skill_bytes = read_regular_bytes_nofollow(active / "SKILL.md")
    if not skill_bytes.startswith(f"---\nname: {skill.skill_id}\n".encode("utf-8")):
        raise InstallSyncError("legacy skill identity does not match registry")
    return manifest


def snapshot_legacy_external_skill(
    active: Path,
    store: Path,
    manifest: dict[str, Any],
    skill: Any,
) -> Path:
    link_before = active.lstat()
    target_before = os.readlink(active)
    package = active.resolve()
    snapshot = copy_skill_generation(package, store, manifest)
    verified = legacy_skill_manifest(package, skill)
    link_after = active.lstat()
    if (
        verified != manifest
        or (link_before.st_dev, link_before.st_ino, target_before)
        != (link_after.st_dev, link_after.st_ino, os.readlink(active))
    ):
        raise InstallSyncError("legacy external skill symlink changed during snapshot")
    return snapshot


def bundle_old_closure(registry: Any) -> dict[str, Any]:
    from visible_agent_orchestrator.companion_skills import skill_install_target

    skills: list[dict[str, Any]] = []
    for skill in registry.skills:
        active = absolute_active_path(str(skill_install_target(skill)))
        if not os.path.lexists(active):
            skills.append(
                {
                    "skill_id": skill.skill_id,
                    "target": str(active),
                    "state": "absent",
                    "manifest": None,
                }
            )
            continue
        observed = active.lstat()
        if stat.S_ISLNK(observed.st_mode):
            resolved = active.resolve()
            store = skill_generation_store(active)
            try:
                resolved.relative_to(store)
            except ValueError:
                manifest = legacy_skill_manifest(resolved, skill)
                skills.append(
                    {
                        "skill_id": skill.skill_id,
                        "target": str(active),
                        "state": "legacy_external_symlink",
                        "manifest": manifest,
                    }
                )
            else:
                _generation, manifest = active_generation(active, store)
                skills.append(
                    {
                        "skill_id": skill.skill_id,
                        "target": str(active),
                        "state": "generation",
                        "manifest": manifest,
                    }
                )
            continue
        if stat.S_ISDIR(observed.st_mode):
            manifest = legacy_skill_manifest(active, skill)
            skills.append(
                {
                    "skill_id": skill.skill_id,
                    "target": str(active),
                    "state": "legacy_directory",
                    "manifest": manifest,
                }
            )
            continue
        raise InstallSyncError("bundle managed target is not a safe directory or generation pointer")
    states = {item["state"] for item in skills}
    if states == {"absent"}:
        return {"skills": skills, "release_id": "uninitialized"}
    if "absent" in states:
        raise InstallSyncError("bundle first migration requires all targets absent or all targets present")
    closure_base = {"skills": skills}
    release_id = hashlib.sha256(canonical_json_bytes(closure_base)).hexdigest()
    return {**closure_base, "release_id": release_id}


def preview_bundle_upgrade_policy(
    old_skills: list[dict[str, Any]],
    new_skills: list[dict[str, Any]],
    source: Path,
    source_commit: str,
) -> list[dict[str, Any]]:
    """Read-only relationship diagnostics using the shared source-history check."""
    findings: list[dict[str, Any]] = []
    for old, new in zip(old_skills, new_skills):
        old_manifest = old["manifest"]
        finding: dict[str, Any] = {
            "skill_id": str(old.get("skill_id") or ""),
            "old_state": str(old.get("state") or ""),
            "old_source_commit": None,
            "old_contract_version": None,
            "old_tree_hash": None,
            "new_source_commit": source_commit,
            "new_contract_version": str(new["contract_version"]),
            "new_tree_hash": str(new["tree_hash"]),
            "contract_change": "unknown",
            "tree_change": "unknown",
            "required_allow_downgrade": False,
            "required_allow_replacement": False,
            "blocking_error": None,
        }
        findings.append(finding)
        if old_manifest is None:
            finding["contract_change"] = "first_install"
            finding["tree_change"] = "absent"
            continue
        old_commit = str(old_manifest.get("source_commit") or "")
        old_version_raw = str(old_manifest["contract_version"])
        finding["old_source_commit"] = old_commit
        finding["old_contract_version"] = old_version_raw
        finding["old_tree_hash"] = str(old_manifest["tree_hash"])
        old_version = version_tuple(old_version_raw)
        new_version = version_tuple(finding["new_contract_version"])
        if old_version is not None and new_version is not None:
            if new_version < old_version:
                finding["contract_change"] = "downgrade"
            elif new_version == old_version:
                finding["contract_change"] = "same"
            else:
                finding["contract_change"] = "forward"
        finding["tree_change"] = (
            "unchanged"
            if finding["old_tree_hash"] == finding["new_tree_hash"]
            else "changed"
        )
        if old_commit == "legacy-bootstrap":
            finding["required_allow_downgrade"] = True
            finding["required_allow_replacement"] = True
        if finding["contract_change"] == "downgrade":
            finding["required_allow_downgrade"] = True
        elif (
            finding["contract_change"] == "same"
            and finding["tree_change"] == "changed"
        ):
            finding["required_allow_replacement"] = True
        if old_commit == "legacy-bootstrap":
            continue
        try:
            ancestor = bundle_source_is_ancestor(source, old_commit, source_commit)
        except (InstallSyncError, subprocess.TimeoutExpired) as exc:
            finding["blocking_error"] = str(exc)
        else:
            finding["source_is_ancestor"] = ancestor
            if not ancestor:
                finding["required_allow_downgrade"] = True
    return findings


def require_bundle_upgrade_policy(
    old_skills: list[dict[str, Any]],
    new_skills: list[dict[str, Any]],
    args: argparse.Namespace,
    source: Path,
    source_commit: str,
) -> None:
    for old, new in zip(old_skills, new_skills):
        old_manifest = old["manifest"]
        if old_manifest is None:
            continue
        old_commit = str(old_manifest.get("source_commit") or "")
        if old_commit == "legacy-bootstrap":
            if not args.allow_downgrade or not args.allow_replacement:
                raise InstallSyncError(
                    "legacy migration requires replacement and downgrade authority"
                )
            continue
        if not re.fullmatch(r"[0-9a-f]{40}", old_commit):
            raise InstallSyncError("prior skill source commit is invalid")
        old_version = version_tuple(str(old_manifest["contract_version"]))
        new_version = version_tuple(str(new["contract_version"]))
        if old_version is not None and new_version is not None:
            if new_version < old_version and not args.allow_downgrade:
                raise InstallSyncError("implicit skill contract downgrade rejected")
            if (
                new_version == old_version
                and old_manifest["tree_hash"] != new["tree_hash"]
                and not args.allow_replacement
            ):
                raise InstallSyncError(
                    "same contract version with different tree requires explicit replacement authority"
                )
        if (
            not bundle_source_is_ancestor(source, old_commit, source_commit)
            and not args.allow_downgrade
        ):
            raise InstallSyncError("implicit skill source-history downgrade rejected")


def bundle_source_is_ancestor(source: Path, old_commit: str, source_commit: str) -> bool:
    """Verify the prior commit before interpreting merge-base's 0/1 result."""
    if not re.fullmatch(r"[0-9a-f]{40}", old_commit):
        raise InstallSyncError("prior skill source commit is invalid")
    object_check = subprocess.run(
        [
            "git",
            "--no-replace-objects",
            "-C",
            str(source),
            "cat-file",
            "-e",
            f"{old_commit}^{{commit}}",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=5,
        check=False,
    )
    if object_check.returncode == 1:
        raise InstallSyncError("prior skill source commit is unavailable")
    if object_check.returncode != 0:
        raise InstallSyncError("prior skill source commit verification failed")
    try:
        ancestry = subprocess.run(
            [
                "git",
                "--no-replace-objects",
                "-C",
                str(source),
                "merge-base",
                "--is-ancestor",
                old_commit,
                source_commit,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        raise InstallSyncError("skill source-history verification failed") from exc
    if ancestry.returncode == 0:
        return True
    if ancestry.returncode != 1:
        raise InstallSyncError("skill source-history verification failed")
    return False


def command_companion_release_activate(args: argparse.Namespace) -> int:
    ensure_allow_write(bool(args.allow_write))
    leader_mode = bool(getattr(args, "authorize_leader", False))
    if leader_mode and str(args.authorization_id or "").strip():
        raise InstallSyncError(
            "--authorize-leader cannot be combined with a pre-made grant authorization id"
        )
    if leader_mode and getattr(args, "ledger_boundary", None) is not None:
        raise InstallSyncError(
            "--authorize-leader cannot be combined with a pre-made grant ledger boundary"
        )
    held_root = held_exclusive_admission_root().resolve()
    if str(args.control_root or "").strip():
        control_root = Path(args.control_root).resolve()
    elif leader_mode:
        # Leader entry may omit --control-root: the actually held admission
        # root is the only root this activation can use (#778).
        control_root = held_root
    else:
        raise InstallSyncError(
            "bundle activation pre-made grant entry requires --control-root"
        )
    if held_root != control_root:
        raise InstallSyncError("bundle activation control root does not match admission root")
    # Materialize the resolved root for the shared mutation boundary helper,
    # which derives every ledger/boundary path from args.control_root.
    args.control_root = str(control_root)
    if not leader_mode:
        if getattr(args, "ledger_boundary", None) is None:
            raise InstallSyncError(
                "bundle activation pre-made grant entry requires --ledger-boundary"
            )
        if not str(args.authorization_id or "").strip():
            raise InstallSyncError(
                "bundle activation pre-made grant entry requires --authorization-id"
            )
    source = Path(args.source).resolve()
    source_commit = resolve_trusted_companion_release_source(source, args.approved_ref)
    if leader_mode:
        provenance = source_git_provenance(source)
        if (
            not provenance["source_git_available"]
            or provenance["source_git_dirty"]
            or provenance["source_git_commit"] != source_commit
        ):
            raise InstallSyncError(
                "leader authorization requires a clean source worktree whose HEAD is the approved commit"
            )
    from visible_agent_orchestrator.companion_skills import load_committed_registry

    planned_registry, _planned_registry_digest = load_committed_registry(
        source,
        source_commit,
        REPO_ROOT,
    )
    planned_old_closure = authoritative_bundle_old_closure(control_root, planned_registry)
    planned_release = evaluate_release_runtime_compatibility(
        build_companion_release_plan(source, source_commit),
        control_root,
    )
    if planned_release["runtime_compatibility"] != "compatible":
        raise InstallSyncError("bundle activation runtime compatibility is not compatible")
    # Reject known policy failures before the leader grant; retain locked
    # authoritative revalidation inside the mutation boundary below.
    require_bundle_upgrade_policy(
        planned_old_closure["skills"],
        planned_release["skills"],
        args,
        source,
        source_commit,
    )
    target_scope = bundle_activation_capability_scope(
        planned_release,
        args,
        planned_old_closure,
    )
    from visible_agent_orchestrator.companion_runtime_identity import (
        RuntimeIdentityError,
        read_receipt,
    )

    try:
        runtime_receipt = read_receipt(str(control_root))
        runtime_root = Path(str(runtime_receipt["target_root"])).resolve()
    except (RuntimeIdentityError, KeyError, OSError) as exc:
        raise InstallSyncError(
            "bundle activation runtime target root is not verifiable: " + str(exc)
        ) from exc

    def leader_authorization_resolver(resolver_args: argparse.Namespace) -> None:
        """Append the exact leader grant only while BOTH root gates and BOTH
        quiescence checks hold (#778): invoked from inside
        authorized_install_mutation after the admission global gate and
        admission-root quiescence, nested inside the runtime-root gate, so no
        lock can arrive between any check and the append."""
        leader_authorization_id = (
            "bundle-leader-"
            + safe_authorization_id_component(resolver_args.task_id, "task id")
            + "-"
            + safe_authorization_id_component(resolver_args.attempt_id, "attempt id")
        )
        require_generation_authorization(
            SimpleNamespace(
                authorization_id=leader_authorization_id,
                task_id=resolver_args.task_id,
                attempt_id=resolver_args.attempt_id,
            )
        )
        ledger_path = (
            control_root
            / ".omx"
            / "framework"
            / "team"
            / "operation-authorizations"
            / safe_authorization_id_component(resolver_args.task_id, "task id")
            / (
                safe_authorization_id_component(
                    resolver_args.attempt_id, "attempt id"
                )
                + ".jsonl"
            )
        )
        ledger = AuthorizationLedger(
            ledger_path,
            task_id=resolver_args.task_id,
            attempt_id=resolver_args.attempt_id,
        )
        if ledger.records():
            still_active = ledger.active_authorization(leader_authorization_id)
            raise InstallSyncError(
                "bundle leader authorization attempt ledger already exists at "
                f"{ledger_path} with boundary {ledger.boundary_sequence()} "
                f"(derived grant {'active' if still_active else 'not active'}); "
                "consume it via the pre-made grant entry or use a new attempt"
            )
        leader_contract = derive_operation_contract("install_sync")
        leader_capability = validate_operation_capability(
            {
                "schema_version": 1,
                "contract_id": "contract-bundle-leader",
                "contract_hash": planned_release["release_digest"],
                "authorization_id": leader_authorization_id,
                "authorization_source": "authorization_ledger",
                "operation_kind": "install_sync",
                "scope": target_scope,
                "mutation_gates": list(leader_contract["required_mutation_gates"]),
                "task_id": resolver_args.task_id,
                "attempt_id": resolver_args.attempt_id,
            },
            operation_kind="install_sync",
            target_scope=target_scope,
            required_mutation_gates=list(leader_contract["required_mutation_gates"]),
            task_id=resolver_args.task_id,
            attempt_id=resolver_args.attempt_id,
        )
        ledger.append(
            {
                "schema_version": 1,
                "authorization_id": leader_authorization_id,
                "principal": "direct-user",
                "decision": "grant",
                "task_id": resolver_args.task_id,
                "attempt_id": resolver_args.attempt_id,
                "contract_hash": planned_release["release_digest"],
                "created_at": datetime.now(UTC).isoformat().replace("+00:00", "Z"),
                "provenance": "bundle-leader-authorization",
                "capability": leader_capability,
            }
        )
        resolver_args.authorization_id = leader_authorization_id
        resolver_args.ledger_boundary = ledger.boundary_sequence()

    # Task locks live under the runtime target root, not the admission root:
    # hold the runtime-root gate from the quiescence check through the leader
    # grant append and the whole activation write section (#778). When the
    # receipt's runtime root equals the admission root, the admission gate
    # inside authorized_install_mutation is the very same lock file; a second
    # exclusive flock from this process on it would self-deadlock, and the
    # single admission-root gate already covers that root's quiescence check,
    # the leader grant append, and the entire write section.
    runtime_gate: Any = (
        nullcontext()
        if runtime_root == control_root
        else global_mutation_gate(runtime_root, exclusive=True)
    )
    with runtime_gate:
        ensure_global_quiescence(runtime_root)
        with authorized_install_mutation(
            args,
            target_scope,
            authorization_resolver=(
                leader_authorization_resolver if leader_mode else None
            ),
        ) as ctx:
            authorization = ctx["authorization"]
            if held_exclusive_admission_root() != control_root:
                raise InstallSyncError("bundle activation admission root changed before mutation")
            fixed_commit = source_commit
            release = evaluate_release_runtime_compatibility(
                build_companion_release_plan(source, fixed_commit),
                control_root,
            )
            if release != planned_release:
                raise InstallSyncError("bundle activation inputs changed before mutation boundary")
            if release["runtime_compatibility"] != "compatible":
                raise InstallSyncError("bundle activation runtime compatibility is not compatible")
            from visible_agent_orchestrator.companion_skills import load_committed_registry

            registry, _registry_digest = load_committed_registry(source, fixed_commit, REPO_ROOT)
            old_closure = authoritative_bundle_old_closure(control_root, registry)
            if old_closure != planned_old_closure:
                raise InstallSyncError("bundle old closure changed before mutation boundary")
            require_bundle_upgrade_policy(
                old_closure["skills"],
                release["skills"],
                args,
                source,
                fixed_commit,
            )
            staged: list[tuple[Any, Path, dict[str, Any], Path, Path]] = []
            for skill, item in zip(registry.skills, release["skills"]):
                active = absolute_active_path(str(item["target"]))
                store = ensure_skill_generation_store(active)
                require_reconciled_generation_state(store)
                cleanup_skill_staging_orphans(store)
                with staged_approved_companion_package(source, fixed_commit, skill) as (package, manifest):
                    if manifest != item["manifest"]:
                        raise InstallSyncError("bundle release manifest changed during staging")
                    generation = copy_skill_generation(package, store, manifest)
                staged.append((skill, active, manifest, store, generation))
            for old, (skill, active, _manifest, store, _generation) in zip(
                old_closure["skills"],
                staged,
            ):
                if old["state"] == "legacy_external_symlink":
                    snapshot_legacy_external_skill(active, store, old["manifest"], skill)
            transaction_id = "bundle-activate-" + str(release["release_id"])
            old_release_id = str(old_closure["release_id"])
            intent = {
                "schema_version": 1,
                "release_id": release["release_id"],
                "release_digest": release["release_digest"],
                "authorization": {
                    **ctx["authorization"],
                    "ledger_boundary": ctx["ledger_boundary"],
                    "target_scope": ctx["target_scope"],
                    "required_mutation_gates": ctx["required_mutation_gates"],
                },
                "transaction_id": transaction_id,
                "old_release_id": old_release_id,
                "new_release_id": release["release_id"],
                "old_skills": old_closure["skills"],
                "new_skills": [
                    {
                        "skill_id": skill.skill_id,
                        "target": str(active),
                        "generation_id": manifest["generation_id"],
                        "tree_hash": manifest["tree_hash"],
                        "source_commit": manifest["source_commit"],
                        "contract_version": manifest["contract_version"],
                        "manifest": manifest,
                    }
                    for skill, active, manifest, _store, _generation in staged
                ],
                "source_commit": fixed_commit,
                "registry_digest": release["registry_digest"],
                "mutation_registry_sha256": mutation_registry_sha256(),
                "runtime_identity": release["observed_runtime_identity"],
                "admission_runtime_identity": TRUSTED_RUNTIME_IDENTITY,
                "runtime_digest": release["observed_runtime_digest"],
                "contract_generation": release["contract_generation"],
                "allow_downgrade": bool(args.allow_downgrade),
                "allow_replacement": bool(args.allow_replacement),
            }
            intent_exists = ensure_bundle_authorization_not_reused(
                control_root,
                authorization,
                intent,
            )
            intent_path = bundle_release_intent_path(control_root, str(release["release_id"]))
            intent_path.parent.mkdir(mode=0o700, exist_ok=True)
            intent_parent = intent_path.parent.lstat()
            if (
                stat.S_ISLNK(intent_parent.st_mode)
                or not stat.S_ISDIR(intent_parent.st_mode)
                or intent_parent.st_uid != os.geteuid()
                or stat.S_IMODE(intent_parent.st_mode) != 0o700
            ):
                raise InstallSyncError("bundle release directory is not owner-private")
            if intent_exists or intent_path.exists() or intent_path.is_symlink():
                if read_bundle_intent(control_root, str(release["release_id"])) != intent:
                    raise InstallSyncError("bundle release intent identity mismatch")
            else:
                write_json_durable(intent_path, intent, mode=0o400)
                intent_descriptor = os.open(
                    intent_path,
                    os.O_RDONLY
                    | os.O_NOFOLLOW
                    | getattr(os, "O_CLOEXEC", 0),
                )
                try:
                    os.fsync(intent_descriptor)
                finally:
                    os.close(intent_descriptor)
                fsync_directory(intent_path.parent)
            skill_fault("after_bundle_intent")
            admission = AdmissionGate(control_root, True)
            admission.prepare(
                    transaction_id=transaction_id,
                    registry_sha256=mutation_registry_sha256(),
                    runtime_identity=TRUSTED_RUNTIME_IDENTITY,
                    contract_generation=TRUSTED_CONTRACT_GENERATION,
                    manifest_sha256=release["release_digest"],
                    old_release_id=old_release_id,
                    new_release_id=release["release_id"],
                )
            skill_fault("after_bundle_prepared")
            for old, (_skill, active, manifest, store, generation) in zip(old_closure["skills"], staged):
                if old["state"] == "legacy_directory":
                    install_bootstrap_previous(active, store, old["manifest"])
                validate_generation(generation, str(manifest["generation_id"]))
                switch_active_generation(active, generation)
                fsync_directory(active.parent)
                skill_fault("after_bundle_pointer_switch")
            discoveries: list[dict[str, Any]] = []
            for skill, active, manifest, _store, generation in staged:
                current, current_manifest = active_generation(active, skill_generation_store(active))
                if current != generation or current_manifest != manifest:
                    raise InstallSyncError("bundle active pointer verification failed")
                receipt = fresh_skill_discovery(active)
                expected_receipt = {
                    "active_path": str(active),
                    "resolved_generation_path": str(generation),
                    "loaded_generation_id": manifest["generation_id"],
                    "tree_hash": manifest["tree_hash"],
                    "contract_version": manifest["contract_version"],
                    "source_commit": manifest["source_commit"],
                }
                if any(receipt.get(field) != value for field, value in expected_receipt.items()):
                    raise InstallSyncError("bundle fresh discovery generation mismatch")
                discoveries.append({"skill_id": skill.skill_id, **receipt})
            admission.finish_activation(
                    transaction_id=transaction_id,
                    registry_sha256=mutation_registry_sha256(),
                    runtime_identity=TRUSTED_RUNTIME_IDENTITY,
                    contract_generation=TRUSTED_CONTRACT_GENERATION,
                    manifest_sha256=release["release_digest"],
                    old_release_id=old_release_id,
                    new_release_id=release["release_id"],
            )
            result = {
                "ok": True,
                "status": "activated",
                "release": release,
                "transaction_id": transaction_id,
                "intent_path": str(intent_path),
                "discoveries": discoveries,
            }
            print(json.dumps(result, indent=2, sort_keys=True) if args.json else result["status"])
    return 0


def current_runtime_receipt(control_root: Path) -> dict[str, Any]:
    """Return the guarded runtime identity receipt with its targets verified."""
    from visible_agent_orchestrator.companion_runtime_identity import (
        RuntimeIdentityError,
        read_receipt,
    )

    receipt = read_receipt(str(control_root))
    target_root = Path(str(receipt["target_root"]))
    for item in receipt["targets"]:
        target_rel = str(item["target_rel"])
        target_path = target_root / target_rel
        if item.get("retired") is True:
            if target_path.exists() or target_path.is_symlink():
                raise InstallSyncError(
                    "runtime receipt retired target is present: "
                    f"{target_rel}"
                )
            continue
        with opened_target_parent(
            target_root,
            target_path,
            create_parents=False,
        ) as (parent_descriptor, target_name, verify_parent_identity):
            descriptor = os.open(
                target_name,
                os.O_RDONLY
                | os.O_NOFOLLOW
                | os.O_NONBLOCK
                | getattr(os, "O_CLOEXEC", 0),
                dir_fd=parent_descriptor,
            )
            try:
                observed = os.fstat(descriptor)
                if (
                    not stat.S_ISREG(observed.st_mode)
                    or stat.S_IMODE(observed.st_mode) != item["mode"]
                    or "sha256:" + sha256_descriptor(descriptor)
                    != item["current_sha256"]
                ):
                    raise InstallSyncError("runtime receipt target drifted")
                verify_parent_identity()
            finally:
                os.close(descriptor)
    return receipt


def bundle_runtime_compatible(intent: dict[str, Any], control_root: Path) -> bool:
    """The current guarded runtime must match the release intent's bound identity."""
    from visible_agent_orchestrator.companion_runtime_identity import (
        RuntimeIdentityError,
    )

    try:
        receipt = current_runtime_receipt(control_root)
    except (RuntimeIdentityError, InstallSyncError, OSError):
        return False
    return (
        receipt["runtime_identity"] == intent.get("runtime_identity")
        and receipt["contract_generation"] == intent.get("contract_generation")
        and receipt["runtime_attestation"] is False
    )


def bundle_rollback_capability_scope(
    intent: dict[str, Any],
    from_closure: dict[str, Any],
    to_closure: dict[str, Any],
    args: argparse.Namespace,
) -> dict[str, str]:
    skills: list[dict[str, Any]] = []
    for from_item, to_item in zip(from_closure["skills"], to_closure["skills"]):
        if (
            from_item["skill_id"] != to_item["skill_id"]
            or from_item["target"] != to_item["target"]
        ):
            raise InstallSyncError("bundle rollback closures conflict with registry order")
        skills.append(
            {
                "skill_id": from_item["skill_id"],
                "target": from_item["target"],
                "from_generation_id": from_item["manifest"]["generation_id"],
                "to_generation_id": to_item["manifest"]["generation_id"],
                "from_tree_hash": from_item["manifest"]["tree_hash"],
                "to_tree_hash": to_item["manifest"]["tree_hash"],
                "from_contract_version": from_item["manifest"]["contract_version"],
                "to_contract_version": to_item["manifest"]["contract_version"],
            }
        )
    return skill_generation_scope(
        {
            "action": "rollback",
            "from_release_id": from_closure["release_id"],
            "to_release_id": to_closure["release_id"],
            "from_release_digest": intent["release_digest"],
            "to_release_digest": to_closure["release_digest"],
            "registry_digest": intent["registry_digest"],
            "source_commit": intent["source_commit"],
            "contract_generation": intent["contract_generation"],
            "runtime_identity": intent["runtime_identity"],
            "runtime_digest": intent["runtime_digest"],
            "runtime_compatibility": "compatible",
            "skills": skills,
            "allow_downgrade": bool(args.allow_downgrade),
            "allow_replacement": bool(args.allow_replacement),
        }
    )


def bundle_closure_from_skills(
    registry: Any,
    items: Any,
    *,
    label: str,
) -> dict[str, Any]:
    """Build a fully managed closure from durable intent skills, validating generations."""
    from visible_agent_orchestrator.companion_skills import skill_install_target

    if not isinstance(items, list) or len(items) != len(registry.skills):
        raise InstallSyncError(f"bundle {label} closure is incomplete")
    closure: list[dict[str, Any]] = []
    for skill, item in zip(registry.skills, items):
        if not isinstance(item, dict) or item.get("skill_id") != skill.skill_id:
            raise InstallSyncError(f"bundle {label} closure order conflicts with registry")
        active = absolute_active_path(str(item.get("target") or ""))
        if active != skill_install_target(skill):
            raise InstallSyncError(f"bundle {label} target conflicts with registry")
        manifest = item.get("manifest")
        if not isinstance(manifest, dict) or not manifest.get("generation_id"):
            raise InstallSyncError(f"bundle {label} manifest missing")
        store = skill_generation_store(active)
        generation = store / "generations" / str(manifest["generation_id"])
        observed_manifest = validate_generation(generation, str(manifest["generation_id"]))
        if observed_manifest != manifest:
            raise InstallSyncError(f"bundle {label} retained generation conflicts with closure")
        closure.append(
            {
                "skill_id": skill.skill_id,
                "target": str(active),
                "state": "generation",
                "manifest": manifest,
            }
        )
    return {"skills": closure}


def authoritative_previous_bundle_closure(
    root: Path,
    registry: Any,
    from_closure: dict[str, Any],
) -> dict[str, Any]:
    """Build the fully managed previous release closure with retained generations."""
    current_intent = read_bundle_intent(root, str(from_closure["release_id"]))
    previous_release_id = str(current_intent.get("old_release_id") or "")
    if not previous_release_id or previous_release_id == "uninitialized":
        raise InstallSyncError("bundle rollback requires a previous managed release")
    previous = bundle_closure_from_skills(
        registry,
        current_intent.get("old_skills"),
        label="previous release",
    )
    previous_intent = read_bundle_intent(root, previous_release_id)
    return {
        **previous,
        "release_id": previous_release_id,
        "release_digest": str(previous_intent.get("release_digest") or ""),
    }


def require_bundle_rollback_policy(
    from_closure: dict[str, Any],
    to_closure: dict[str, Any],
    args: argparse.Namespace,
) -> None:
    for from_item, to_item in zip(from_closure["skills"], to_closure["skills"]):
        from_manifest = from_item["manifest"]
        to_manifest = to_item["manifest"]
        from_version = version_tuple(str(from_manifest["contract_version"]))
        to_version = version_tuple(str(to_manifest["contract_version"]))
        if from_version is not None and to_version is not None:
            if to_version < from_version and not args.allow_downgrade:
                raise InstallSyncError("bundle rollback downgrade requires explicit authorization")
            if (
                to_version == from_version
                and from_manifest["tree_hash"] != to_manifest["tree_hash"]
                and not args.allow_replacement
            ):
                raise InstallSyncError(
                    "bundle rollback replacement requires explicit authorization"
                )


def bundle_activation_pointer_state(
    active: Path,
    old_item: dict[str, Any],
    candidate_generation: Path,
) -> str:
    """Explain a physical pointer as old, absent, or candidate for an activation."""
    try:
        observed = active.lstat()
    except FileNotFoundError:
        return "absent"
    if stat.S_ISLNK(observed.st_mode):
        resolved = (active.parent / os.readlink(active)).resolve()
        if resolved == candidate_generation.resolve():
            return "candidate"
        old_manifest = old_item.get("manifest")
        store = skill_generation_store(active)
        if (
            isinstance(old_manifest, dict)
            and old_item.get("state") in {"generation", "legacy_directory"}
            and (store / "generations" / str(old_manifest.get("generation_id") or "")).resolve()
            == resolved
        ):
            return "old"
        if old_item.get("state") == "legacy_external_symlink":
            return "old"
        return ""
    if (
        stat.S_ISDIR(observed.st_mode)
        and not stat.S_ISLNK(observed.st_mode)
        and old_item.get("state") == "legacy_directory"
    ):
        return "old"
    return ""


def bundle_rollback_pointer_state(
    active: Path,
    from_item: dict[str, Any],
    to_item: dict[str, Any],
) -> str:
    """Explain a physical pointer as the from or to closure for a rollback."""
    try:
        observed = active.lstat()
    except FileNotFoundError:
        return ""
    if not stat.S_ISLNK(observed.st_mode):
        return ""
    resolved = (active.parent / os.readlink(active)).resolve()
    store = skill_generation_store(active)
    if (store / "generations" / str(to_item["manifest"]["generation_id"])).resolve() == resolved:
        return "to"
    if (store / "generations" / str(from_item["manifest"]["generation_id"])).resolve() == resolved:
        return "from"
    return ""


def _finalize_bundle_legacy_directory(active: Path, manifest: dict[str, Any]) -> None:
    store = skill_generation_store(active)
    previous = store / "generations" / str(manifest.get("generation_id") or "")
    try:
        active_observed = active.lstat()
    except FileNotFoundError:
        active_observed = None
    if (
        active_observed is not None
        and stat.S_ISDIR(active_observed.st_mode)
        and not stat.S_ISLNK(active_observed.st_mode)
    ):
        install_bootstrap_previous(active, store, manifest)
        return
    try:
        observed_previous = previous.lstat()
    except FileNotFoundError as exc:
        raise InstallSyncError("bundle bootstrapped previous generation is missing") from exc
    if stat.S_ISLNK(observed_previous.st_mode) or not stat.S_ISDIR(observed_previous.st_mode):
        raise InstallSyncError("bundle bootstrapped previous generation is unsafe")
    try:
        validate_generation(previous, str(manifest.get("generation_id") or ""))
    except InstallSyncError:
        seal_generation(previous, manifest, allow_publish_root=True)
    if validate_generation(previous, str(manifest.get("generation_id") or "")) != manifest:
        raise InstallSyncError("bundle bootstrapped previous generation conflicts with closure")


def validate_bundle_intent_authorization(root: Path, intent: dict[str, Any]) -> None:
    """The durable ledger capability bound to the transaction must be exact and active."""
    authorization = intent.get("authorization")
    if not isinstance(authorization, dict):
        raise InstallSyncError("bundle release intent authorization is missing")
    authorization_id = str(authorization.get("authorization_id") or "")
    task_id = str(authorization.get("task_id") or "")
    attempt_id = str(authorization.get("attempt_id") or "")
    boundary = authorization.get("ledger_boundary")
    target_scope = authorization.get("target_scope")
    required_gates = authorization.get("required_mutation_gates")
    if (
        not all((authorization_id, task_id, attempt_id))
        or type(boundary) is not int
        or not isinstance(target_scope, dict)
        or not isinstance(required_gates, list)
    ):
        raise InstallSyncError("bundle release intent authorization is invalid")
    ledger_path = (
        root
        / ".omx"
        / "framework"
        / "team"
        / "operation-authorizations"
        / safe_authorization_id_component(task_id, "task id")
        / (safe_authorization_id_component(attempt_id, "attempt id") + ".jsonl")
    )
    ledger = AuthorizationLedger(ledger_path, task_id=task_id, attempt_id=attempt_id)
    try:
        capability = ledger.require_active_authorization(
            authorization_id,
            expected_boundary=boundary,
        )
        validate_operation_capability(
            capability,
            operation_kind="install_sync",
            target_scope=target_scope,
            required_mutation_gates=required_gates,
            task_id=task_id,
            attempt_id=attempt_id,
        )
    except (OperationAuthorizationError, ValueError) as exc:
        raise InstallSyncError(str(exc)) from exc


def pending_bundle_activation(root: Path, pending: dict[str, Any]) -> dict[str, Any]:
    """Validate the durable activation intent against the pending journal record."""
    release_id = str(pending["new_release_id"])
    old_release_id = str(pending["old_release_id"])
    intent = read_bundle_intent(root, release_id)
    identity = {
        "release_id": release_id,
        "release_digest": pending["manifest_sha256"],
        "mutation_registry_sha256": pending["registry_sha256"],
        "admission_runtime_identity": pending["runtime_identity"],
        "contract_generation": pending["contract_generation"],
        "transaction_id": pending["transaction_id"],
    }
    if any(intent.get(key) != value for key, value in identity.items()):
        raise InstallSyncError("bundle release intent conflicts with pending admission")
    if intent.get("old_release_id") != old_release_id or intent.get("new_release_id") != release_id:
        raise InstallSyncError("bundle release intent transaction conflicts with journal")
    validate_bundle_intent_authorization(root, intent)
    return intent


def pending_bundle_rollback(root: Path, pending: dict[str, Any]) -> dict[str, Any]:
    """Validate the durable rollback intent against the pending journal record."""
    from_release_id = str(pending["new_release_id"])
    to_release_id = str(pending["old_release_id"])
    intent = read_bundle_intent(root, str(pending["transaction_id"]))
    identity = {
        "action": "rollback",
        "transaction_id": pending["transaction_id"],
        "from_release_id": from_release_id,
        "to_release_id": to_release_id,
        "to_release_digest": pending["manifest_sha256"],
        "mutation_registry_sha256": pending["registry_sha256"],
        "admission_runtime_identity": pending["runtime_identity"],
        "contract_generation": pending["contract_generation"],
    }
    if any(intent.get(key) != value for key, value in identity.items()):
        raise InstallSyncError("bundle rollback intent conflicts with pending admission")
    from_intent = read_bundle_intent(root, from_release_id)
    if intent.get("from_release_digest") != from_intent.get("release_digest"):
        raise InstallSyncError("bundle rollback from-release digest conflicts with published intent")
    validate_bundle_intent_authorization(root, intent)
    return intent


def _bundle_discoveries(registry: Any, closure_skills: list[dict[str, Any]]) -> list[dict[str, Any]]:
    discoveries: list[dict[str, Any]] = []
    for skill, item in zip(registry.skills, closure_skills):
        active = absolute_active_path(str(item["target"]))
        manifest = item["manifest"]
        store = skill_generation_store(active)
        current, current_manifest = active_generation(active, store)
        expected = store / "generations" / str(manifest["generation_id"])
        if current != expected.resolve() or current_manifest != manifest:
            raise InstallSyncError("bundle active pointer verification failed")
        receipt = fresh_skill_discovery(active)
        expected_receipt = {
            "active_path": str(active),
            "resolved_generation_path": str(expected.resolve()),
            "loaded_generation_id": manifest["generation_id"],
            "tree_hash": manifest["tree_hash"],
            "contract_version": manifest["contract_version"],
            "source_commit": manifest["source_commit"],
        }
        if any(receipt.get(field) != value for field, value in expected_receipt.items()):
            raise InstallSyncError("bundle fresh discovery generation mismatch")
        discoveries.append({"skill_id": skill.skill_id, **receipt})
    return discoveries


def _reconcile_bundle_activation(
    root: Path,
    registry: Any,
    pending: dict[str, Any],
) -> dict[str, Any]:
    intent = pending_bundle_activation(root, pending)
    if not bundle_runtime_compatible(intent, root):
        raise InstallSyncError("bundle reconcile runtime compatibility is not compatible")
    old_skills = intent.get("old_skills")
    candidate_closure = bundle_closure_from_skills(
        registry,
        intent.get("new_skills"),
        label="candidate",
    )
    if not isinstance(old_skills, list) or len(old_skills) != len(registry.skills):
        raise InstallSyncError("bundle release intent closure is incomplete")
    switches: list[tuple[Path, dict[str, Any], Path]] = []
    for old_item, candidate_item in zip(old_skills, candidate_closure["skills"]):
        if (
            not isinstance(old_item, dict)
            or old_item.get("skill_id") != candidate_item["skill_id"]
        ):
            raise InstallSyncError("bundle release intent closure order conflicts with registry")
        active = absolute_active_path(str(candidate_item["target"]))
        store = ensure_skill_generation_store(active)
        candidate = store / "generations" / str(candidate_item["manifest"]["generation_id"])
        state = bundle_activation_pointer_state(active, old_item, candidate)
        if state == "candidate":
            continue
        if state in {"old", "absent"}:
            switches.append((active, old_item, candidate))
            continue
        raise InstallSyncError("bundle active pointer is not explainable by the authorized transaction")
    for active, old_item, candidate in switches:
        if old_item.get("state") == "legacy_directory":
            _finalize_bundle_legacy_directory(active, old_item["manifest"])
        elif old_item.get("state") == "legacy_external_symlink":
            store = skill_generation_store(active)
            snapshot = store / "generations" / str(old_item["manifest"].get("generation_id") or "")
            if validate_generation(snapshot, str(old_item["manifest"].get("generation_id") or "")) != old_item["manifest"]:
                raise InstallSyncError("bundle legacy snapshot generation conflicts with closure")
        validate_generation(candidate, candidate.name)
        switch_active_generation(active, candidate)
        fsync_directory(active.parent)
        skill_fault("during_bundle_reconcile_activation_switches")
    discoveries = _bundle_discoveries(registry, candidate_closure["skills"])
    admission = AdmissionGate(root, True)
    admission.finish_activation(
        transaction_id=str(pending["transaction_id"]),
        registry_sha256=str(pending["registry_sha256"]),
        runtime_identity=str(pending["runtime_identity"]),
        contract_generation=int(pending["contract_generation"]),
        manifest_sha256=str(pending["manifest_sha256"]),
        old_release_id=str(pending["old_release_id"]),
        new_release_id=str(pending["new_release_id"]),
    )
    skill_fault("after_bundle_reconcile_terminal")
    return {
        "ok": True,
        "status": "recovered_activated",
        "transaction_id": pending["transaction_id"],
        "release_id": pending["new_release_id"],
        "discoveries": discoveries,
    }


def _reconcile_bundle_rollback(
    root: Path,
    registry: Any,
    pending: dict[str, Any],
) -> dict[str, Any]:
    intent = pending_bundle_rollback(root, pending)
    if not bundle_runtime_compatible(intent, root):
        raise InstallSyncError("bundle reconcile runtime compatibility is not compatible")
    from_closure = bundle_closure_from_skills(
        registry,
        intent.get("from_skills"),
        label="rollback from",
    )
    to_closure = bundle_closure_from_skills(
        registry,
        intent.get("to_skills"),
        label="rollback to",
    )
    switches: list[tuple[Path, dict[str, Any]]] = []
    for from_item, to_item in zip(from_closure["skills"], to_closure["skills"]):
        if from_item["skill_id"] != to_item["skill_id"] or from_item["target"] != to_item["target"]:
            raise InstallSyncError("bundle rollback intent closures conflict with registry order")
        active = absolute_active_path(str(from_item["target"]))
        state = bundle_rollback_pointer_state(active, from_item, to_item)
        if state == "to":
            continue
        if state == "from":
            switches.append((active, to_item))
            continue
        raise InstallSyncError("bundle active pointer is not explainable by the authorized rollback transaction")
    for active, to_item in switches:
        store = skill_generation_store(active)
        to_generation = store / "generations" / str(to_item["manifest"]["generation_id"])
        validate_generation(to_generation, str(to_item["manifest"]["generation_id"]))
        switch_active_generation(active, to_generation)
        fsync_directory(active.parent)
        skill_fault("during_bundle_reconcile_rollback_switches")
    discoveries = _bundle_discoveries(registry, to_closure["skills"])
    admission = AdmissionGate(root, True)
    admission.finish_rollback(
        transaction_id=str(pending["transaction_id"]),
        registry_sha256=str(pending["registry_sha256"]),
        runtime_identity=str(pending["runtime_identity"]),
        contract_generation=int(pending["contract_generation"]),
        manifest_sha256=str(pending["manifest_sha256"]),
        old_release_id=str(pending["old_release_id"]),
        new_release_id=str(pending["new_release_id"]),
    )
    skill_fault("after_bundle_reconcile_terminal")
    return {
        "ok": True,
        "status": "recovered_rolled_back",
        "transaction_id": pending["transaction_id"],
        "release_id": pending["old_release_id"],
        "discoveries": discoveries,
    }


def command_companion_release_reconcile(args: argparse.Namespace) -> int:
    ensure_allow_write(bool(args.allow_write))
    control_root = Path(args.control_root).resolve()
    if held_exclusive_admission_root() != control_root:
        raise InstallSyncError("bundle reconcile control root does not match admission root")
    from visible_agent_orchestrator.companion_skills import load_registry

    registry = load_registry(DEFAULT_COMPANION_SKILL_REGISTRY, REPO_ROOT)
    pending = pending_transaction(control_root)
    if pending["event"] == "PREPARED":
        result = _reconcile_bundle_activation(control_root, registry, pending)
    elif pending["event"] == "ROLLBACK_PREPARED":
        result = _reconcile_bundle_rollback(control_root, registry, pending)
    else:
        raise InstallSyncError("unexpected pending transaction event")
    print(json.dumps(result, indent=2, sort_keys=True) if args.json else result["status"])
    return 0


def command_companion_release_rollback(args: argparse.Namespace) -> int:
    ensure_allow_write(bool(args.allow_write))
    control_root = Path(args.control_root).resolve()
    if held_exclusive_admission_root() != control_root:
        raise InstallSyncError("bundle rollback control root does not match admission root")
    from visible_agent_orchestrator.companion_skills import load_registry

    registry = load_registry(DEFAULT_COMPANION_SKILL_REGISTRY, REPO_ROOT)
    planned_from_closure = authoritative_bundle_old_closure(control_root, registry)
    if planned_from_closure["release_id"] == "uninitialized":
        raise InstallSyncError("bundle rollback requires an active managed release")
    planned_intent = read_bundle_intent(control_root, str(planned_from_closure["release_id"]))
    if not bundle_runtime_compatible(planned_intent, control_root):
        raise InstallSyncError("bundle rollback runtime compatibility is not compatible")
    planned_to_closure = authoritative_previous_bundle_closure(
        control_root,
        registry,
        planned_from_closure,
    )
    require_bundle_rollback_policy(planned_from_closure, planned_to_closure, args)
    target_scope = bundle_rollback_capability_scope(
        planned_intent,
        planned_from_closure,
        planned_to_closure,
        args,
    )
    with authorized_install_mutation(args, target_scope) as ctx:
        authorization = ctx["authorization"]
        if held_exclusive_admission_root() != control_root:
            raise InstallSyncError("bundle rollback admission root changed before mutation")
        from_closure = authoritative_bundle_old_closure(control_root, registry)
        if from_closure != planned_from_closure:
            raise InstallSyncError("bundle current closure changed before rollback mutation boundary")
        intent = read_bundle_intent(control_root, str(from_closure["release_id"]))
        if intent != planned_intent:
            raise InstallSyncError("bundle release intent changed before rollback mutation boundary")
        to_closure = authoritative_previous_bundle_closure(control_root, registry, from_closure)
        if to_closure != planned_to_closure:
            raise InstallSyncError("bundle previous closure changed before rollback mutation boundary")
        if not bundle_runtime_compatible(intent, control_root):
            raise InstallSyncError("bundle rollback runtime compatibility is not compatible")
        transaction_id = "bundle-rollback-" + hashlib.sha256(
            canonical_json_bytes(
                {
                    "action": "rollback",
                    "from_release_id": str(from_closure["release_id"]),
                    "to_release_id": str(to_closure["release_id"]),
                    "authorization_id": authorization["authorization_id"],
                }
            )
        ).hexdigest()
        rollback_intent = {
            "schema_version": 1,
            "action": "rollback",
            "rollback_id": transaction_id,
            "transaction_id": transaction_id,
            "authorization": {
                **authorization,
                "ledger_boundary": ctx["ledger_boundary"],
                "target_scope": ctx["target_scope"],
                "required_mutation_gates": ctx["required_mutation_gates"],
            },
            "from_release_id": str(from_closure["release_id"]),
            "to_release_id": str(to_closure["release_id"]),
            "from_release_digest": intent["release_digest"],
            "to_release_digest": str(to_closure["release_digest"]),
            "from_skills": from_closure["skills"],
            "to_skills": to_closure["skills"],
            "source_commit": intent["source_commit"],
            "registry_digest": intent["registry_digest"],
            "mutation_registry_sha256": mutation_registry_sha256(),
            "runtime_identity": intent["runtime_identity"],
            "admission_runtime_identity": TRUSTED_RUNTIME_IDENTITY,
            "runtime_digest": intent["runtime_digest"],
            "contract_generation": intent["contract_generation"],
            "allow_downgrade": bool(args.allow_downgrade),
            "allow_replacement": bool(args.allow_replacement),
        }
        intent_exists = ensure_bundle_authorization_not_reused(
            control_root,
            authorization,
            rollback_intent,
        )
        intent_path = bundle_release_intent_path(control_root, transaction_id)
        intent_path.parent.mkdir(mode=0o700, exist_ok=True)
        intent_parent = intent_path.parent.lstat()
        if (
            stat.S_ISLNK(intent_parent.st_mode)
            or not stat.S_ISDIR(intent_parent.st_mode)
            or intent_parent.st_uid != os.geteuid()
            or stat.S_IMODE(intent_parent.st_mode) != 0o700
        ):
            raise InstallSyncError("bundle release directory is not owner-private")
        if intent_exists or intent_path.exists() or intent_path.is_symlink():
            if read_bundle_intent(control_root, transaction_id) != rollback_intent:
                raise InstallSyncError("bundle rollback intent identity mismatch")
        else:
            write_json_durable(intent_path, rollback_intent, mode=0o400)
            intent_descriptor = os.open(
                intent_path,
                os.O_RDONLY
                | os.O_NOFOLLOW
                | getattr(os, "O_CLOEXEC", 0),
            )
            try:
                os.fsync(intent_descriptor)
            finally:
                os.close(intent_descriptor)
            fsync_directory(intent_path.parent)
        skill_fault("after_bundle_rollback_intent")
        admission = AdmissionGate(control_root, True)
        admission.prepare_rollback(
            transaction_id=transaction_id,
            registry_sha256=mutation_registry_sha256(),
            runtime_identity=TRUSTED_RUNTIME_IDENTITY,
            contract_generation=TRUSTED_CONTRACT_GENERATION,
            manifest_sha256=str(to_closure["release_digest"]),
            old_release_id=str(to_closure["release_id"]),
            new_release_id=str(from_closure["release_id"]),
        )
        skill_fault("after_bundle_rollback_prepared")
        for from_item, to_item in zip(from_closure["skills"], to_closure["skills"]):
            active = absolute_active_path(str(from_item["target"]))
            store = skill_generation_store(active)
            to_generation = store / "generations" / str(to_item["manifest"]["generation_id"])
            validate_generation(to_generation, str(to_item["manifest"]["generation_id"]))
            switch_active_generation(active, to_generation)
            fsync_directory(active.parent)
            skill_fault("after_bundle_rollback_pointer_switch")
        discoveries = _bundle_discoveries(registry, to_closure["skills"])
        admission.finish_rollback(
            transaction_id=transaction_id,
            registry_sha256=mutation_registry_sha256(),
            runtime_identity=TRUSTED_RUNTIME_IDENTITY,
            contract_generation=TRUSTED_CONTRACT_GENERATION,
            manifest_sha256=str(to_closure["release_digest"]),
            old_release_id=str(to_closure["release_id"]),
            new_release_id=str(from_closure["release_id"]),
        )
        skill_fault("after_bundle_rollback_terminal")
        result = {
            "ok": True,
            "status": "rolled_back",
            "transaction_id": transaction_id,
            "from_release_id": str(from_closure["release_id"]),
            "to_release_id": str(to_closure["release_id"]),
            "intent_path": str(intent_path),
            "discoveries": discoveries,
        }
        print(json.dumps(result, indent=2, sort_keys=True) if args.json else result["status"])
    return 0


def command_companion_skills_impact_check(args: argparse.Namespace) -> int:
    from visible_agent_orchestrator.companion_skills import (
        RegistryError,
        load_impact_declaration,
        load_registry,
        validate_impact_declaration,
    )

    try:
        registry = load_registry(DEFAULT_COMPANION_SKILL_REGISTRY, REPO_ROOT)
        declaration = load_impact_declaration(Path(args.declaration))
        result = validate_impact_declaration(registry, declaration)
    except RegistryError as exc:
        raise InstallSyncError(str(exc)) from exc
    print(
        json.dumps(result, indent=2, sort_keys=True)
        if args.json
        else f"impact declaration valid: {result['change_id']}"
    )
    return 0


def command_skill_rollback(args: argparse.Namespace) -> int:
    ensure_allow_write(bool(args.allow_write))
    active = absolute_active_path(args.active)
    planned_store = skill_generation_store(active)
    planned_current, _planned_current_manifest = active_generation(
        active,
        planned_store,
    )
    target_scope = rollback_capability_scope(
        args,
        active,
        from_generation_id=planned_current.name,
    )
    with authorized_install_mutation(args, target_scope) as ctx:
        authorization = ctx["authorization"]
        if absolute_active_path(args.active) != active:
            raise InstallSyncError(
                "active skill path changed before rollback mutation boundary"
            )
        store = ensure_skill_generation_store(active)
        events = require_reconciled_generation_state(store)
        ensure_authorization_not_reused(store, authorization)
        current, current_manifest = active_generation(active, store)
        if current.name != planned_current.name:
            raise InstallSyncError(
                "active generation changed before rollback mutation boundary"
            )
        target_id = str(args.expected_generation)
        target = store / "generations" / target_id
        target_manifest = validate_generation(target, target_id)
        if (
            target_manifest.get("tree_hash") != args.expected_tree_hash
            or target_manifest.get("source_commit") != args.expected_source_commit
        ):
            raise InstallSyncError("rollback authorization does not match exact generation")
        latest_activation = next(
            (
                event
                for event in reversed(events)
                if event.get("event_type")
                in {
                    "ACTIVATED",
                    "RECOVERED_ACTIVATED",
                    "ROLLED_BACK",
                    "RECOVERED_ROLLED_BACK",
                }
            ),
            None,
        )
        expected_previous = ""
        if latest_activation is not None:
            if latest_activation.get("generation_id") != current.name:
                raise InstallSyncError(
                    "active pointer conflicts with latest terminal generation"
                )
            expected_previous = str(
                latest_activation.get(
                    "previous_generation_id"
                    if latest_activation.get("event_type")
                    in {"ACTIVATED", "RECOVERED_ACTIVATED"}
                    else "replaced_generation_id"
                )
                or ""
            )
        if (
            latest_activation is None
            or expected_previous != target_id
        ):
            raise InstallSyncError("rollback target is not the last fully active previous generation")
        current_version = version_tuple(str(current_manifest["contract_version"]))
        target_version = version_tuple(str(target_manifest["contract_version"]))
        is_downgrade = (
            target_version is None
            or current_version is None
            or target_version < current_version
        )
        if is_downgrade and not args.allow_downgrade:
            raise InstallSyncError("rollback downgrade requires explicit authorization")
        transaction_id = f"rollback-{uuid.uuid4().hex}"
        append_skill_generation_event(
            store,
            "ROLLBACK_PREPARED",
            transaction_id,
            **authorization,
            from_generation_id=current.name,
            from_tree_hash=current_manifest["tree_hash"],
            target_generation_id=target_id,
            target_tree_hash=target_manifest["tree_hash"],
            target_source_commit=target_manifest["source_commit"],
            target_contract_version=target_manifest["contract_version"],
            allow_downgrade=bool(args.allow_downgrade),
        )
        skill_fault("after_rollback_prepared")
        switch_active_generation(active, target)
        skill_fault("after_rollback_pointer_switch")
        append_skill_generation_event(
            store,
            "ROLLED_BACK",
            transaction_id,
            generation_id=target_id,
            tree_hash=target_manifest["tree_hash"],
            source_commit=target_manifest["source_commit"],
            contract_version=target_manifest["contract_version"],
            replaced_generation_id=current.name,
        )
        skill_fault("after_rolled_back")
        receipt = record_fresh_skill_discovery(active, store, transaction_id)
        result = {
            "ok": True,
            "status": "rolled_back",
            "transaction_id": transaction_id,
            "generation_id": target_id,
            "tree_hash": target_manifest["tree_hash"],
            "discovery_receipt": receipt,
        }
        print(json.dumps(result, indent=2, sort_keys=True) if args.json else result["status"])
        return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="omx_install_sync",
        description="Planner and guarded installer for visible-agent-orchestrator bin+package sync.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    plan = sub.add_parser("plan", help="print future sync plan without copying or chmod")
    plan.add_argument("--source", default=".")
    plan.add_argument("--target", required=True)
    plan.add_argument("--manifest", default=str(DEFAULT_MANIFEST))
    plan.add_argument("--json", action="store_true")
    plan.set_defaults(func=command_plan)

    diff_cmd = sub.add_parser("diff", help="preview concrete file diffs for would_update/create/chmod items")
    diff_cmd.add_argument("--source", default=".")
    diff_cmd.add_argument("--target", required=True)
    diff_cmd.add_argument("--manifest", default=str(DEFAULT_MANIFEST))
    diff_cmd.add_argument("--json", action="store_true")
    diff_cmd.set_defaults(func=command_diff)

    check = sub.add_parser("check", help="validate dry-run sync inputs without modifying target")
    check.add_argument("--source", default=".")
    check.add_argument("--target", required=True)
    check.add_argument("--manifest", default=str(DEFAULT_MANIFEST))
    check.add_argument("--require-target-preimages", action="store_true")
    check.set_defaults(func=command_check)

    status = sub.add_parser(
        "status",
        help="report installed source provenance and current target parity",
    )
    status.add_argument("--target", required=True)
    status.add_argument(
        "--manifest",
        default="",
        help=(
            "optional current install manifest used to separate real "
            "current-manifest drift from unexplained historical absence; "
            "without it the reference is reported as unavailable and "
            "status keeps the conservative all-ledger-targets behavior"
        ),
    )
    status.add_argument(
        "--source",
        default="",
        help=(
            "source root the --manifest is expanded against (default: this "
            "copy's own repository root); a manifest entry whose source is "
            "missing or whose glob matches nothing makes the reference "
            "unusable_source instead of silently shrinking the inventory"
        ),
    )
    status.add_argument("--json", action="store_true")
    status.set_defaults(func=command_status)

    apply_cmd = sub.add_parser("apply", help="copy allowlisted files after explicit --allow-write")
    apply_cmd.add_argument("--source", default=".")
    apply_cmd.add_argument("--target", required=True)
    apply_cmd.add_argument("--backup-dir", required=True)
    apply_cmd.add_argument("--manifest", default=str(DEFAULT_MANIFEST))
    apply_cmd.add_argument("--allow-write", action="store_true")
    apply_cmd.add_argument(
        "--publish-runtime-identity",
        action="store_true",
        help="publish a guarded runtime identity receipt after a new install event",
    )
    apply_cmd.add_argument(
        "--authorize-leader",
        dest="authorize_leader",
        action="store_true",
        help=(
            "with --publish-runtime-identity: mint this exact publication's "
            "grant in the task ledger after the exclusive admission and "
            "quiescence holds, instead of passing a pre-made grant; requires "
            "--task-id/--attempt-id and rejects --authorization-id/"
            "--ledger-boundary"
        ),
    )
    apply_cmd.add_argument("--control-root", default="")
    apply_cmd.add_argument("--ledger-boundary", type=int)
    apply_cmd.add_argument("--authorization-id", default="")
    apply_cmd.add_argument("--task-id", default="")
    apply_cmd.add_argument("--attempt-id", default="")
    apply_cmd.add_argument("--allow-stale-source", action="store_true")
    apply_cmd.add_argument("--stale-source-reason", default="")
    apply_cmd.add_argument(
        "--hot-plugin-docs",
        default=None,
        help=(
            "opt-in hot mode: only update existing non-executable Markdown "
            "docs under plugins/<name>/ for this one plugin, without "
            "requiring global worker quiescence (the global mutation gate "
            "and all ordinary allowlist/parity/rollback gates still apply)"
        ),
    )
    apply_cmd.add_argument("--smoke", action="store_true", help="run bounded post-install read-only smoke checks after apply")
    apply_cmd.add_argument(
        "--smoke-full-validate",
        action="store_true",
        help="include slower board/policy validate commands in post-install smoke",
    )
    apply_cmd.add_argument(
        "--smoke-command-timeout",
        type=int,
        default=90,
        help="per-command timeout in seconds for post-install smoke (default: 90)",
    )
    apply_cmd.add_argument(
        "--smoke-worker",
        default="",
        help="visible worker required for default post-install smoke checks",
    )
    apply_cmd.add_argument("--json", action="store_true")
    apply_cmd.set_defaults(func=command_apply)

    def add_explicit_rollback_arguments(
        command: argparse.ArgumentParser,
        *,
        required: bool,
    ) -> None:
        command.add_argument("--source", required=required, default="")
        command.add_argument("--target", required=True)
        command.add_argument("--backup-dir", required=True)
        command.add_argument("--manifest", required=required, default="")
        command.add_argument(
            "--expected-source-commit",
            required=required,
            default="",
        )
        command.add_argument(
            "--expected-manifest-sha256",
            required=required,
            default="",
        )
        command.add_argument(
            "--applied-event-policy",
            required=required,
            choices=("required", "optional"),
            default="",
        )
        command.add_argument("--json", action="store_true")

    rollback_check = sub.add_parser(
        "rollback-check",
        help="validate an exact rollback bundle without writing",
    )
    add_explicit_rollback_arguments(rollback_check, required=True)
    rollback_check.set_defaults(func=command_rollback_check)

    rollback = sub.add_parser(
        "rollback",
        help="restore files from an exact install-sync backup bundle",
    )
    add_explicit_rollback_arguments(rollback, required=False)
    rollback.add_argument("--allow-write", action="store_true")
    rollback.set_defaults(func=command_rollback)

    def add_skill_mutation_authorization(
        command: argparse.ArgumentParser,
        *,
        authorization_id_required: bool = True,
        control_root_required: bool = True,
        ledger_boundary_required: bool = True,
    ) -> None:
        if control_root_required:
            command.add_argument("--control-root", required=True)
        else:
            command.add_argument("--control-root", default="")
        if ledger_boundary_required:
            command.add_argument("--ledger-boundary", type=int, required=True)
        else:
            command.add_argument("--ledger-boundary", type=int, default=None)
        if authorization_id_required:
            command.add_argument("--authorization-id", required=True)
        else:
            command.add_argument("--authorization-id", default="")
        command.add_argument("--task-id", required=True)
        command.add_argument("--attempt-id", required=True)
        command.add_argument("--allow-write", action="store_true")
        command.add_argument("--json", action="store_true")

    bootstrap_companion = sub.add_parser(
        "bootstrap-companion-skills",
        help="initialize the fixed Companion Skill admission lifecycle",
    )
    add_skill_mutation_authorization(
        bootstrap_companion,
        authorization_id_required=False,
        control_root_required=False,
        ledger_boundary_required=False,
    )
    bootstrap_companion.add_argument(
        "--authorize-leader", action="store_true",
        help="authorize this exact first-install bootstrap under the held admission and zero-lock gates",
    )
    bootstrap_companion.set_defaults(func=command_bootstrap_companion_skills)

    skill_activate = sub.add_parser(
        "skill-activate",
        help="stage and atomically activate one immutable skill generation",
    )
    skill_activate.add_argument("--source", required=True)
    skill_activate.add_argument("--package", required=True)
    skill_activate.add_argument("--active", required=True)
    skill_activate.add_argument("--approved-ref", required=True)
    skill_activate.add_argument(
        "--max-package-bytes",
        type=int,
        default=DEFAULT_SKILL_PACKAGE_MAX_BYTES,
    )
    skill_activate.add_argument("--allow-downgrade", action="store_true")
    skill_activate.add_argument("--allow-replacement", action="store_true")
    add_skill_mutation_authorization(skill_activate)
    skill_activate.set_defaults(func=command_skill_activate)

    skill_reconcile = sub.add_parser(
        "skill-reconcile",
        help="reconcile an authorized interrupted skill generation switch",
    )
    skill_reconcile.add_argument("--active", required=True)
    skill_reconcile.add_argument("--control-root", required=True)
    skill_reconcile.add_argument("--allow-write", action="store_true")
    skill_reconcile.add_argument("--json", action="store_true")
    skill_reconcile.set_defaults(func=command_skill_reconcile)

    skill_discover = sub.add_parser(
        "skill-discover",
        help="resolve and verify the active immutable skill generation",
    )
    skill_discover.add_argument("--active", required=True)
    skill_discover.add_argument("--json", action="store_true")
    skill_discover.set_defaults(func=command_skill_discover)

    companion_status = sub.add_parser(
        "companion-skills-status",
        help="report managed Companion Skill source and discovery evidence without mutation",
    )
    companion_status.add_argument("--json", action="store_true")
    companion_status.set_defaults(func=command_companion_skills_status)

    companion_release_plan = sub.add_parser(
        "companion-release-plan",
        help="derive a read-only immutable managed-Skill release closure from an approved Git ref",
    )
    companion_release_plan.add_argument("--source", required=True)
    companion_release_plan.add_argument("--approved-ref", required=True)
    companion_release_plan.add_argument(
        "--control-root",
        default="",
        help="optional admission control root to evaluate the trusted runtime receipt against (read-only)",
    )
    companion_release_plan.add_argument("--json", action="store_true")
    companion_release_plan.set_defaults(func=command_companion_release_plan)

    companion_release_activate = sub.add_parser(
        "companion-release-activate",
        help="publish and activate one immutable managed-Skill release",
    )
    companion_release_activate.add_argument("--source", required=True)
    companion_release_activate.add_argument("--approved-ref", required=True)
    companion_release_activate.add_argument("--allow-downgrade", action="store_true")
    companion_release_activate.add_argument("--allow-replacement", action="store_true")
    companion_release_activate.add_argument(
        "--authorize-leader",
        action="store_true",
        help="prepare the exact bundle-activation capability for this invocation in the task ledger instead of consuming a pre-made grant",
    )
    add_skill_mutation_authorization(
        companion_release_activate,
        authorization_id_required=False,
        control_root_required=False,
        ledger_boundary_required=False,
    )
    companion_release_activate.set_defaults(func=command_companion_release_activate)

    companion_release_reconcile = sub.add_parser(
        "companion-release-reconcile",
        help="reconcile the sole durable authorized interrupted managed bundle transaction",
    )
    companion_release_reconcile.add_argument("--control-root", required=True)
    companion_release_reconcile.add_argument("--allow-write", action="store_true")
    companion_release_reconcile.add_argument("--json", action="store_true")
    companion_release_reconcile.set_defaults(func=command_companion_release_reconcile)

    companion_release_rollback = sub.add_parser(
        "companion-release-rollback",
        help="exactly roll back the active managed-Skill release to the previous managed release",
    )
    companion_release_rollback.add_argument("--allow-downgrade", action="store_true")
    companion_release_rollback.add_argument("--allow-replacement", action="store_true")
    add_skill_mutation_authorization(companion_release_rollback)
    companion_release_rollback.set_defaults(func=command_companion_release_rollback)

    companion_impact = sub.add_parser(
        "companion-skills-impact-check",
        help="validate a persistent managed-Skill impact declaration without mutation",
    )
    companion_impact.add_argument("--declaration", required=True)
    companion_impact.add_argument("--json", action="store_true")
    companion_impact.set_defaults(func=command_companion_skills_impact_check)

    skill_rollback = sub.add_parser(
        "skill-rollback",
        help="atomically roll back to the last fully active generation",
    )
    skill_rollback.add_argument("--active", required=True)
    skill_rollback.add_argument("--expected-generation", required=True)
    skill_rollback.add_argument("--expected-tree-hash", required=True)
    skill_rollback.add_argument("--expected-source-commit", required=True)
    skill_rollback.add_argument("--allow-downgrade", action="store_true")
    add_skill_mutation_authorization(skill_rollback)
    skill_rollback.set_defaults(func=command_skill_rollback)
    return parser


def main(argv: list[str] | None = None, *, _admission_root: Path | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return invoke_cli_handler("omx_install_sync", args, args.func, admission_root=_admission_root)
    except InstallSyncError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    except AdmissionError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
