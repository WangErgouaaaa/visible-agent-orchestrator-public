    )
    reference = result.get("current_reference", {})
    print(
        "current_reference: "
        f"origin={reference.get('origin', '-')} "
        f"targets={reference.get('target_count', 0)} "
        f"manifest={reference.get('manifest') or '-'} "
        f"source={reference.get('source') or '-'}"
    )
    print(
        "current_reference_parity: "
        f"{str(bool(result.get('current_reference_parity'))).lower()}"
    )
    for rel in result.get("reference_targets_without_install_record", []):
        print(f"reference_without_install_record: {rel}")
    print(
