class InstallSyncError(Exception):
    """Expected operator-facing failure."""


class ChmodRollbackError(InstallSyncError):
    """A post-mutation chmod could not restore its retained inode."""


DEFAULT_ORDINARY_INSTALL_MAX_BYTES = 16 * 1024 * 1024
ORDINARY_INSTALL_JOURNAL_RESERVE_BYTES = 65536


def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def ensure_global_quiescence(target_root: Path) -> None:
    lock_root = target_root.resolve() / ".omx" / "framework" / "team" / "visible-runs" / "_locks"
    try:
        observed = lock_root.lstat()
    except FileNotFoundError:
        return
    if stat.S_ISLNK(observed.st_mode) or not stat.S_ISDIR(observed.st_mode):
        raise InstallSyncError(
            f"global quiescence lock root must be a real directory: {lock_root}"
        )
    locks = sorted(lock_root.glob("*.lock.json"))
    if locks:
        names = ", ".join(path.name for path in locks)
        raise InstallSyncError(
            f"global quiescence required before install/sync; owner lock files present: {names}"
        )


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def sha256_descriptor(descriptor: int) -> str:
    digest = hashlib.sha256()
    offset = os.lseek(descriptor, 0, os.SEEK_CUR)
    try:
        os.lseek(descriptor, 0, os.SEEK_SET)
        for chunk in iter(lambda: os.read(descriptor, 1024 * 1024), b""):
            digest.update(chunk)
    finally:
        os.lseek(descriptor, offset, os.SEEK_SET)
    return digest.hexdigest()


def copy_descriptor2(
    source_descriptor: int,
    destination: Path,
    source_stat: os.stat_result,
    *,
    max_bytes: int | None = None,
) -> None:
    destination_descriptor = os.open(
        destination,
        os.O_WRONLY
        | os.O_CREAT
        | os.O_TRUNC
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_CLOEXEC", 0),
        stat.S_IMODE(source_stat.st_mode),
    )
    offset = os.lseek(source_descriptor, 0, os.SEEK_CUR)
    written = 0
    try:
        os.lseek(source_descriptor, 0, os.SEEK_SET)
        for chunk in iter(
            lambda: os.read(source_descriptor, 1024 * 1024),
            b"",
        ):
            if max_bytes is not None and written + len(chunk) > max_bytes:
                raise InstallSyncError(
                    f"copy exceeded pinned size: {destination}"
                )
            view = memoryview(chunk)
            while view:
                n = os.write(destination_descriptor, view)
                view = view[n:]
                written += n
        os.fchmod(
            destination_descriptor,
            stat.S_IMODE(source_stat.st_mode),
        )
        os.utime(
            destination_descriptor,
            ns=(source_stat.st_atime_ns, source_stat.st_mtime_ns),
        )
    finally:
        os.lseek(source_descriptor, offset, os.SEEK_SET)
        os.close(destination_descriptor)


def verify_open_regular_entry(
    descriptor: int,
    parent_descriptor: int,
    name: str,
    *,
    expected_identity: dict[str, int],
    expected_sha256: str,
    expected_mode: int,
    error: str,
) -> os.stat_result:
    try:
        opened = os.fstat(descriptor)
        actual_sha256 = (
            sha256_descriptor(descriptor)
            if stat.S_ISREG(opened.st_mode)
            else ""
        )
        observed = os.fstat(descriptor)
        entry = os.stat(
            name,
            dir_fd=parent_descriptor,
            follow_symlinks=False,
        )
        final = os.fstat(descriptor)
    except OSError as exc:
        raise InstallSyncError(error) from exc
    identity = {
        "st_dev": observed.st_dev,
        "st_ino": observed.st_ino,
    }
    if (
        (
            opened.st_dev,
            opened.st_ino,
            opened.st_size,
            opened.st_ctime_ns,
            opened.st_mtime_ns,
            stat.S_IMODE(opened.st_mode),
        )
        != (
            observed.st_dev,
            observed.st_ino,
            observed.st_size,
            observed.st_ctime_ns,
            observed.st_mtime_ns,
            stat.S_IMODE(observed.st_mode),
        )
        or (
            observed.st_dev,
            observed.st_ino,
            observed.st_size,
            observed.st_ctime_ns,
            observed.st_mtime_ns,
            stat.S_IMODE(observed.st_mode),
        )
        != (
            entry.st_dev,
            entry.st_ino,
            entry.st_size,
            entry.st_ctime_ns,
            entry.st_mtime_ns,
            stat.S_IMODE(entry.st_mode),
        )
        or (
            entry.st_dev,
            entry.st_ino,
            entry.st_size,
            entry.st_ctime_ns,
            entry.st_mtime_ns,
            stat.S_IMODE(entry.st_mode),
        )
        != (
            final.st_dev,
            final.st_ino,
            final.st_size,
            final.st_ctime_ns,
            final.st_mtime_ns,
            stat.S_IMODE(final.st_mode),
        )
        or not stat.S_ISREG(opened.st_mode)
        or not stat.S_ISREG(observed.st_mode)
        or not stat.S_ISREG(entry.st_mode)
        or not stat.S_ISREG(final.st_mode)
        or identity != expected_identity
        or (
            entry.st_dev,
            entry.st_ino,
        )
        != (
            observed.st_dev,
            observed.st_ino,
        )
        or actual_sha256 != expected_sha256
        or stat.S_IMODE(observed.st_mode) != expected_mode
    ):
        raise InstallSyncError(error)
    return final


def isolate_verified_entry(
    *,
    parent_descriptor: int,
    source_parent_descriptor: int,
    source_parent_name: str,
    source_parent_identity: dict[str, int],
    entry_name: str,
    entry_descriptor: int,
    entry_identity: dict[str, int],
    entry_sha256: str,
    entry_mode: int,
    isolation_prefix: str,
    source_path: Path,
) -> tuple[int, str, Path]:
    try:
        current_parent = os.stat(
            source_parent_name,
            dir_fd=parent_descriptor,
            follow_symlinks=False,
        )
    except OSError as exc:
        raise InstallSyncError(
            "rollback quarantine entry changed; candidate evidence "
            f"preserved at: {source_path}"
        ) from exc
    if (
        not stat.S_ISDIR(current_parent.st_mode)
        or {
            "st_dev": current_parent.st_dev,
            "st_ino": current_parent.st_ino,
        }
        != source_parent_identity
    ):
        raise InstallSyncError(
            "rollback quarantine entry changed; candidate evidence "
            f"preserved at: {source_path}"
        )
    isolation_proc = Path(
        tempfile.mkdtemp(
            dir=f"/proc/self/fd/{parent_descriptor}",
            prefix=isolation_prefix,
        )
    )
    isolation_name = isolation_proc.name
    isolation_path = source_path.parent.parent / isolation_name / entry_name
    isolation_descriptor = os.open(
        isolation_name,
        os.O_RDONLY
        | os.O_DIRECTORY
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_CLOEXEC", 0),
        dir_fd=parent_descriptor,
    )
    try:
        isolation_observed = os.fstat(isolation_descriptor)
        if (
            not stat.S_ISDIR(isolation_observed.st_mode)
            or stat.S_IMODE(isolation_observed.st_mode) & 0o077
        ):
            raise InstallSyncError(
                f"rollback isolation path invalid: {isolation_path.parent}"
            )
        try:
            os.replace(
                entry_name,
                entry_name,
                src_dir_fd=source_parent_descriptor,
                dst_dir_fd=isolation_descriptor,
            )
        except OSError as exc:
            raise InstallSyncError(
                "rollback quarantine entry changed; candidate evidence "
                f"preserved at: {source_path}"
            ) from exc
        try:
            verify_open_regular_entry(
                entry_descriptor,
                isolation_descriptor,
                entry_name,
                expected_identity=entry_identity,
                expected_sha256=entry_sha256,
                expected_mode=entry_mode,
                error=(
                    "rollback quarantine entry changed after isolation"
                ),
            )
        except InstallSyncError as mismatch:
            try:
                os.link(
                    entry_name,
                    entry_name,
                    src_dir_fd=isolation_descriptor,
                    dst_dir_fd=source_parent_descriptor,
                    follow_symlinks=False,
                )
                os.unlink(entry_name, dir_fd=isolation_descriptor)
                os.close(isolation_descriptor)
                isolation_descriptor = -1
                os.rmdir(isolation_name, dir_fd=parent_descriptor)
            except OSError as restore_exc:
                if isolation_descriptor >= 0:
                    os.close(isolation_descriptor)
                    isolation_descriptor = -1
                raise InstallSyncError(
                    "rollback quarantine entry changed; replacement "
                    f"preserved at: {isolation_path}; quarantine conflict "
                    f"preserved at: {source_path}"
                ) from restore_exc
            raise InstallSyncError(
                "rollback quarantine entry changed; replacement "
                f"preserved at: {source_path}"
            ) from mismatch
        return isolation_descriptor, isolation_name, isolation_path
    except Exception:
        if isolation_descriptor >= 0:
            os.close(isolation_descriptor)
        try:
            os.rmdir(isolation_name, dir_fd=parent_descriptor)
        except OSError:
            pass
        raise


def source_git_provenance(source_root: Path) -> dict[str, Any]:
    unavailable = {
        "source_git_available": False,
        "source_git_commit": "",
        "source_git_dirty": False,
    }
    try:
        commit = subprocess.run(
            ["git", "-C", str(source_root), "rev-parse", "--verify", "HEAD"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=5,
            check=False,
        )
        status = subprocess.run(
            ["git", "-C", str(source_root), "status", "--porcelain"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return unavailable
    source_commit = commit.stdout.strip()
    if commit.returncode != 0 or status.returncode != 0 or not source_commit:
        return unavailable
    return {
        "source_git_available": True,
        "source_git_commit": source_commit,
        "source_git_dirty": bool(status.stdout.strip()),
    }


def install_actor() -> dict[str, Any]:
    return {
        "user": os.environ.get("USER") or os.environ.get("LOGNAME") or "",
        "host": os.environ.get("HOSTNAME") or os.uname().nodename,
        "pid": os.getpid(),
        "tmux_pane": os.environ.get("TMUX_PANE", ""),
        "codex_thread_id": os.environ.get("CODEX_THREAD_ID", ""),
        "omx_run_id": os.environ.get("OMX_RUN_ID", ""),
    }


def read_manifest(path: Path) -> dict[str, Any]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise InstallSyncError(f"manifest not found: {path}") from exc
    except json.JSONDecodeError as exc:
        raise InstallSyncError(f"manifest is invalid JSON: {path}: {exc}") from exc
    if not isinstance(data, dict):
        raise InstallSyncError(f"manifest must be a JSON object: {path}")
    files = data.get("files", [])
    if not isinstance(files, list):
        raise InstallSyncError("manifest field 'files' must be a list")
    smoke_profile = data.get("post_install_smoke_profile", "default")
    if (
        not isinstance(smoke_profile, str)
        or smoke_profile not in POST_INSTALL_SMOKE_PROFILES
    ):
        raise InstallSyncError(
            "manifest field 'post_install_smoke_profile' must be one of: "
            + ", ".join(sorted(POST_INSTALL_SMOKE_PROFILES))
        )
    return data


def classify_action(
    source_exists: bool,
    target_exists: bool,
    source_sha: str,
    target_sha: str,
    *,
    mode_sync_needed: bool = False,
) -> str:
    if not source_exists:
        return "missing_source"
    if not target_exists:
        return "would_create"
    if source_sha != target_sha:
        return "would_update"
    if mode_sync_needed:
        return "would_chmod"
    return "up_to_date"


def file_mode(path: Path) -> int:
    return stat.S_IMODE(path.stat().st_mode)


def canonical_target_mode(target_rel: str) -> int:
    """Canonical install mode for an allowlisted target.

    Allowed bin targets are executable scripts (0755); every other allowed
    managed target is a non-executable owner-read/write file (0644). The
    mode derives from the reviewed install target boundary, never from
    ambient source or target worktree bits.
    """
    return 0o755 if target_rel.startswith("bin/") else 0o644


def has_glob(value: str) -> bool:
    return any(char in value for char in "*?[")


def first_glob_index(parts: tuple[str, ...]) -> int:
    for index, part in enumerate(parts):
        if has_glob(part):
            return index
    return len(parts)


def validate_relative_path(value: str, field: str) -> None:
    path = Path(value)
    if path.is_absolute() or ".." in path.parts:
        raise InstallSyncError(f"{field} must be a safe relative path: {value}")


def glob_base(value: str) -> Path:
    path = Path(value)
    index = first_glob_index(path.parts)
    return Path(*path.parts[:index]) if index else Path(".")


def map_glob_target_rel(source_rel: str, source_pattern: str, target_pattern: str) -> str:
    source_base = glob_base(source_pattern)
    target_base = glob_base(target_pattern)
    tail = Path(source_rel).relative_to(source_base)
    return (target_base / tail).as_posix()


def validate_expected_target_sha256(value: Any, target_rel: str) -> None:
    expected_target_sha256 = str(value or "")
    if expected_target_sha256 not in {"", "absent"} and (
        len(expected_target_sha256) != 64
        or any(
            char not in "0123456789abcdef"
            for char in expected_target_sha256
        )
    ):
        raise InstallSyncError(
            "expected_target_sha256 must be 64 lowercase hex: "
            f"{target_rel}"
        )


def expanded_manifest_entries(source_root: Path, manifest: dict[str, Any]) -> list[dict[str, Any]]:
    expanded: list[dict[str, Any]] = []
    for entry in manifest.get("files", []):
        if not isinstance(entry, dict):
            continue
        source_pattern = str(entry.get("source_path") or entry.get("source_rel") or "")
        target_pattern = str(entry.get("target_path") or entry.get("target_rel") or source_pattern)
        validate_relative_path(source_pattern, "source_path")
        validate_relative_path(target_pattern, "target_path")
        if str(entry.get("action") or "") == RETIRE_REQUESTED_ACTION and (
            has_glob(source_pattern) or has_glob(target_pattern)
        ):
            raise InstallSyncError(
                "retire action requires a direct non-glob entry: "
                f"{source_pattern}"
            )
        expected_target_sha256 = str(
            entry.get("expected_target_sha256") or ""
        )
        if expected_target_sha256 == "absent" and (
            has_glob(source_pattern) or has_glob(target_pattern)
        ):
            raise InstallSyncError(
                "absent target precondition requires a direct non-glob entry"
            )
        expected_by_target = entry.get("expected_target_sha256_by_target")
        if expected_by_target is not None:
            if not isinstance(expected_by_target, dict):
                raise InstallSyncError(
                    "expected_target_sha256_by_target must be an object"
                )
            if expected_target_sha256 == "absent":
                raise InstallSyncError(
                    "absent target precondition requires a direct "
                    "non-glob entry"
                )
            for pinned_target_rel, expected_target_sha256 in expected_by_target.items():
                if not isinstance(pinned_target_rel, str):
                    raise InstallSyncError(
                        "expected_target_sha256_by_target keys must be strings"
                    )
                if str(expected_target_sha256 or "") == "absent":
                    raise InstallSyncError(
                        "absent target precondition requires a direct "
                        "non-glob entry"
                    )
                validate_install_target(pinned_target_rel)
                validate_expected_target_sha256(
                    expected_target_sha256,
                    pinned_target_rel,
                )

        if not has_glob(source_pattern):
            expanded_entry = {
                **entry,
                "source_rel": source_pattern,
                "target_rel": target_pattern,
            }
            if isinstance(expected_by_target, dict) and target_pattern in expected_by_target:
                expanded_entry["expected_target_sha256"] = expected_by_target[target_pattern]
            expanded.append(expanded_entry)
            continue

        for source_path in sorted(source_root.glob(source_pattern)):
            if not source_path.is_file():
                continue
            source_rel = source_path.relative_to(source_root).as_posix()
            target_rel = map_glob_target_rel(source_rel, source_pattern, target_pattern)
            expanded_entry = {
                **entry,
                "source_rel": source_rel,
                "target_rel": target_rel,
            }
            if isinstance(expected_by_target, dict) and target_rel in expected_by_target:
                expanded_entry["expected_target_sha256"] = expected_by_target[target_rel]
            expanded.append(expanded_entry)
    return expanded


def validate_install_target(target_rel: str) -> None:
    validate_relative_path(target_rel, "target_path")
    if target_rel in FORBIDDEN_TARGET_FILES or target_rel.startswith(".env"):
        raise InstallSyncError(f"target outside install allowlist: {target_rel}")
    for fragment in FORBIDDEN_PATH_FRAGMENTS:
        if fragment in target_rel:
            raise InstallSyncError(f"target outside install allowlist: {target_rel}")
    for prefix in FORBIDDEN_TARGET_PREFIXES:
        if target_rel.startswith(prefix):
            raise InstallSyncError(f"target outside install allowlist: {target_rel}")
    if target_rel.startswith("bin/"):
        if Path(target_rel).name in ALLOWED_BIN_NAMES:
            return
        raise InstallSyncError(f"target outside install allowlist: {target_rel}")
    if target_rel in ALLOWED_WORKER_BACKEND_ASSETS:
        return
    if target_rel in ALLOWED_SCHEMA_ASSETS:
        return
    if target_rel in ALLOWED_OPENCODE_PLUGIN_ASSETS:
        return
    if target_rel in ALLOWED_COMPANION_SKILL_CONTRACTS:
        return
    if target_rel == "companion-skill-sources/visible-agent-orchestrator/references/worker-contracts.md":
        return
    if target_rel.startswith("lib/visible_agent_orchestrator/") and target_rel.endswith(".py"):
        return
    if target_rel.startswith("plugins/ag2-meeting-runtime/profiles/") and target_rel.endswith(".json"):
        return
    raise InstallSyncError(f"target outside install allowlist: {target_rel}")


def validate_historical_install_target(target_rel: str) -> None:
    validate_relative_path(target_rel, "target_path")
    if target_rel in RETIRED_INSTALL_EVENT_TARGETS:
        return
    validate_install_target(target_rel)


def validate_install_source(source_rel: str) -> None:
    validate_relative_path(source_rel, "source_path")
    if source_rel in FORBIDDEN_TARGET_FILES or source_rel.startswith(".env"):
        raise InstallSyncError(f"source outside install allowlist: {source_rel}")
    for fragment in FORBIDDEN_PATH_FRAGMENTS:
        if fragment in source_rel:
            raise InstallSyncError(f"source outside install allowlist: {source_rel}")
    for prefix in FORBIDDEN_TARGET_PREFIXES:
        if source_rel.startswith(prefix):
            raise InstallSyncError(f"source outside install allowlist: {source_rel}")
    if source_rel.startswith("worker-backends/") and source_rel not in ALLOWED_WORKER_BACKEND_ASSETS:
        raise InstallSyncError(f"source outside install allowlist: {source_rel}")
    if source_rel.startswith("schemas/") and source_rel not in ALLOWED_SCHEMA_ASSETS:
        raise InstallSyncError(f"source outside install allowlist: {source_rel}")
    if source_rel.startswith("contracts/") and source_rel not in ALLOWED_COMPANION_SKILL_CONTRACTS:
        raise InstallSyncError(f"source outside install allowlist: {source_rel}")


def validate_install_record(source_rel: str, target_rel: str) -> None:
    validate_install_source(source_rel)
    validate_install_target(target_rel)


def validate_launcher_plugin_dependency(
    source_root: Path,
    target_root: Path,
    records: list[dict[str, Any]],
) -> None:
    launcher_update = next(
        (
            record
            for record in records
            if record.get("target_rel") == "bin/omx_opencode_visible_launcher"
            and record.get("action") in MUTATING_ACTIONS
        ),
        None,
    )
    if launcher_update is None:
        return

    plugin_source = source_root / CLEAN_ROOM_STARTUP_PLUGIN_SOURCE_REL
    source_sha256 = (
        sha256_file(plugin_source)
        if plugin_source.is_file() and not plugin_source.is_symlink()
        else ""
    )
    bundled = any(
        record.get("source_rel") == CLEAN_ROOM_STARTUP_PLUGIN_SOURCE_REL
        and record.get("target_rel") == CLEAN_ROOM_STARTUP_PLUGIN_TARGET_REL
        and record.get("source_exists")
        and record.get("source_sha256") == source_sha256
        for record in records
    )
    installed_plugin = target_root / CLEAN_ROOM_STARTUP_PLUGIN_TARGET_REL
    installed = bool(
        source_sha256
        and installed_plugin.is_file()
        and not installed_plugin.is_symlink()
        and sha256_file(installed_plugin) == source_sha256
    )
    if not bundled and not installed:
        raise InstallSyncError(
            "launcher update requires clean-room startup gate plugin "
            "in the same plan or an installed byte-identical plugin"
        )


def validate_hot_plugin_docs_plugin_name(plugin_name: str) -> str:
    name = str(plugin_name or "").strip()
    if (
        not name
        or name in {".", ".."}
        or "/" in name
        or "\\" in name
        or has_glob(name)
    ):
        raise InstallSyncError(
            "--hot-plugin-docs requires one safe plugin directory "
            f"name under plugins/: {plugin_name!r}"
        )
    return name


def _hot_docs_require_regular_non_executable(
    path: Path,
    *,
    role: str,
    target_rel: str,
) -> None:
    try:
        observed = path.lstat()
    except OSError as exc:
        raise InstallSyncError(
            "hot plugin docs mode requires an existing regular "
            f"{role} file for {target_rel}: {path}: {exc}"
        ) from exc
    if stat.S_ISLNK(observed.st_mode) or not stat.S_ISREG(observed.st_mode):
        raise InstallSyncError(
            "hot plugin docs mode refuses symlinked or non-regular "
            f"{role} files: {target_rel}"
        )
    if stat.S_IMODE(observed.st_mode) & 0o111:
        raise InstallSyncError(
            f"hot plugin docs mode refuses executable {role} files: {target_rel}"
        )


def validate_hot_plugin_docs_plan(
    plan: dict[str, Any],
    plugin_name: str,
) -> None:
    """Constrain an opted-in hot apply to existing plugin Markdown docs.

    This mode tolerates unrelated in-flight worker owner locks, so every
    mutating plan item must be a content-only update (never a create,
    chmod-only sync, retirement, or a content update that would also
    change the existing file's mode) of one existing non-executable
    non-symlink Markdown plugin asset below ``plugins/<plugin_name>/``.
    The mode comparison reuses the recorded target_mode/source_mode plan
    facts, so only an unchanged-mode baseline admits the update.
    Retire items never reach this check because the ordinary apply path
    already refuses them before any write. An all-up-to-date plan is a
    valid idempotent no-op. This check rides on top of the ordinary
    allowlist and provenance gates; it never widens them.
    """
    prefix = f"plugins/{plugin_name}/"
    for item in plan_action_items(plan, MUTATING_ACTIONS):
        target_rel = str(item.get("target_rel") or "")
        action = str(item.get("action") or "")
        if action != "would_update":
            raise InstallSyncError(
                "hot plugin docs mode only permits updating existing "
                f"plugin Markdown; refused action {action!r}: {target_rel}"
            )
        if not target_rel.startswith(prefix):
            raise InstallSyncError(
                "hot plugin docs mode only permits mutating targets below "
                f"{prefix}; refused: {target_rel}"
            )
        if not target_rel.endswith(".md"):
            raise InstallSyncError(
                "hot plugin docs mode only permits Markdown ('.md') "
                f"updates; refused: {target_rel}"
            )
        for role in ("source", "target"):
            with opened_target_parent(
                Path(plan[role]),
                Path(item[f"{role}_path"]),
                create_parents=False,
            ):
                pass
        _hot_docs_require_regular_non_executable(
            Path(str(item.get("target_path") or "")),
            role="target",
            target_rel=target_rel,
        )
        _hot_docs_require_regular_non_executable(
            Path(str(item.get("source_path") or "")),
            role="source",
            target_rel=target_rel,
        )
        existing_mode = item.get("target_mode")
        planned_mode = item.get("source_mode")
        if (
            not isinstance(existing_mode, int)
            or not isinstance(planned_mode, int)
            or existing_mode != planned_mode
        ):
            raise InstallSyncError(
                "hot plugin docs mode only permits content-only updates; "
                "refused mode change "
                f"{existing_mode!r} -> {planned_mode!r}: {target_rel}"
            )


def validate_retire_expected_sha256(value: Any, target_rel: str) -> str:
    pinned = str(value or "")
    if len(pinned) != 64 or any(
        char not in "0123456789abcdef" for char in pinned
    ):
        raise InstallSyncError(
            "retire entry requires 64-hex expected_target_sha256: "
            f"{target_rel}"
        )
    return pinned


def build_retire_record(
    source_root: Path,
    target_root: Path,
    entry: dict[str, Any],
) -> dict[str, Any]:
    source_rel = str(entry.get("source_rel") or "")
    target_rel = str(entry.get("target_rel") or source_rel)
    if RETIRED_TEAM_BOARD_SOURCE_TO_TARGET.get(source_rel) != target_rel:
        raise InstallSyncError(
            "retire entry is outside the reviewed six-target retirement "
            f"map: {source_rel} -> {target_rel}"
        )
    validate_install_source(source_rel)
    validate_historical_install_target(target_rel)
    source_path = source_root / source_rel
    target_path = target_root / target_rel
    if source_path.exists() or source_path.is_symlink():
        raise InstallSyncError(
            f"retirement requires absent source: {source_rel}"
        )
    pinned_sha256 = validate_retire_expected_sha256(
        entry.get("expected_target_sha256"),
        target_rel,
    )
    expected_mode = canonical_target_mode(target_rel)
    try:
        observed = target_path.lstat()
    except FileNotFoundError:
        return {
            **entry,
            "source_rel": source_rel,
            "target_rel": target_rel,
            "source_path": str(source_path),
            "target_path": str(target_path),
            "source_exists": False,
            "target_exists": False,
            "source_sha256": "",
            "target_sha256": "",
            "source_mode": None,
            "target_mode": None,
            "target_identity": None,
            "retire_expected_sha256": pinned_sha256,
            "retire_expected_mode": expected_mode,
            "action": "retire_absent_noop",
        }
    if not stat.S_ISREG(observed.st_mode):
        raise InstallSyncError(
            f"retirement target is not a regular file: {target_rel}"
        )
    observed_sha256 = sha256_file(target_path)
    observed_mode = stat.S_IMODE(observed.st_mode)
    if observed_sha256 != pinned_sha256:
        raise InstallSyncError(
            f"retirement target preimage mismatch: {target_rel}"
        )
    if observed_mode != expected_mode:
        raise InstallSyncError(
            f"retirement target mode mismatch: {target_rel}"
        )
    return {
        **entry,
        "source_rel": source_rel,
        "target_rel": target_rel,
        "source_path": str(source_path),
        "target_path": str(target_path),
        "source_exists": False,
        "target_exists": True,
        "source_sha256": "",
        "target_sha256": observed_sha256,
        "source_mode": None,
        "target_mode": observed_mode,
        "target_identity": {
            "st_dev": observed.st_dev,
            "st_ino": observed.st_ino,
        },
        "retire_expected_sha256": pinned_sha256,
        "retire_expected_mode": expected_mode,
        "action": "would_retire",
    }


def build_plan(source: Path, target: Path, manifest_path: Path) -> dict[str, Any]:
    source_root = source.resolve()
    target_root = target.resolve()
    manifest_abs = manifest_path.resolve()
    manifest = read_manifest(manifest_path)
    git_provenance = source_git_provenance(source_root)
    records: list[dict[str, Any]] = []
    for entry in expanded_manifest_entries(source_root, manifest):
        if str(entry.get("action") or "") == RETIRE_REQUESTED_ACTION:
            records.append(
                build_retire_record(source_root, target_root, entry)
            )
            continue
        source_rel = str(entry.get("source_rel") or "")
        target_rel = str(entry.get("target_rel") or source_rel)
        validate_install_record(source_rel, target_rel)
        expected_target_sha256 = str(
            entry.get("expected_target_sha256") or ""
        )
        validate_expected_target_sha256(expected_target_sha256, target_rel)
        source_path = source_root / source_rel
        target_path = target_root / target_rel
        source_exists = source_path.is_file()
        target_exists = target_path.is_file()
        source_sha = sha256_file(source_path) if source_exists else ""
        target_sha = sha256_file(target_path) if target_exists else ""
        target_mode = file_mode(target_path) if target_exists else None
        planned_mode = canonical_target_mode(target_rel) if source_exists else None
        target_stat = (
            target_path.stat(follow_symlinks=False)
            if target_exists
            else None
        )
        mode_sync_needed = bool(
            source_exists
            and target_exists
            and planned_mode is not None
            and target_mode is not None
            and planned_mode != target_mode
        )
        records.append(
            {
                **entry,
                "source_rel": source_rel,
                "target_rel": target_rel,
                "source_path": str(source_path),
                "target_path": str(target_path),
                "source_exists": source_exists,
                "target_exists": target_exists,
                "source_sha256": source_sha,
                "target_sha256": target_sha,
                "source_mode": planned_mode,
                "target_mode": target_mode,
                "target_identity": (
                    {
                        "st_dev": target_stat.st_dev,
                        "st_ino": target_stat.st_ino,
                    }
                    if target_stat is not None
                    else None
                ),
                "missing_target": not target_exists,
                "action": classify_action(
                    source_exists,
                    target_exists,
                    source_sha,
                    target_sha,
                    mode_sync_needed=mode_sync_needed,
                ),
            }
        )
    counts: dict[str, int] = {}
    for record in records:
        action = str(record.get("action") or "")
        counts[action] = counts.get(action, 0) + 1
    validate_launcher_plugin_dependency(source_root, target_root, records)
    smoke_profile = str(
        manifest.get("post_install_smoke_profile") or "default"
    )
    allowed_targets = SMOKE_PROFILE_TARGETS.get(smoke_profile)
    if smoke_profile == "offline_bootstrap":
        target_paths = {record["target_rel"] for record in records}
        if not {f"bin/{name}" for name in ALLOWED_BIN_NAMES}.issubset(target_paths):
            raise InstallSyncError("offline_bootstrap requires the complete public runtime command set")
    if allowed_targets is not None:
        target_paths = {
            str(record.get("target_rel") or "") for record in records
        }
        unexpected = sorted(
            target_paths - allowed_targets
        )
        if not target_paths or unexpected:
            raise InstallSyncError(
                f"{smoke_profile} smoke profile only permits: "
                + ", ".join(sorted(allowed_targets))
                + (
                    "; unexpected targets: " + ", ".join(unexpected)
                    if unexpected
                    else ""
                )
            )
    if smoke_profile == "launcher_bootstrap":
        pairs = [
            (record["source_rel"], record["target_rel"])
            for record in records
        ]
        if pairs != [(
            "bin/omx_opencode_visible_launcher",
            "bin/omx_opencode_visible_launcher",
        )]:
            raise InstallSyncError(
                "launcher_bootstrap requires exactly the visible launcher mapping"
            )
    if smoke_profile == "provision_bootstrap":
        pairs = [
            (
                str(record.get("source_rel") or ""),
                str(record.get("target_rel") or ""),
            )
            for record in records
        ]
        if (
            len(pairs) != len(PROVISION_BOOTSTRAP_SMOKE_PAIRS)
            or set(pairs) != PROVISION_BOOTSTRAP_SMOKE_PAIRS
        ):
            raise InstallSyncError(
                "provision_bootstrap smoke profile requires exact "
                "source-to-target pairs: "
                + ", ".join(
                    f"{source_rel} -> {target_rel}"
                    for source_rel, target_rel in sorted(
                        PROVISION_BOOTSTRAP_SMOKE_PAIRS
                    )
                )
            )
    if smoke_profile == "clean_room_startup":
        pairs = [
            (
                str(record.get("source_rel") or ""),
                str(record.get("target_rel") or ""),
            )
            for record in records
        ]
        if (
            len(pairs) != len(CLEAN_ROOM_STARTUP_SMOKE_PAIRS)
            or set(pairs) != CLEAN_ROOM_STARTUP_SMOKE_PAIRS
        ):
            raise InstallSyncError(
                "clean_room_startup smoke profile requires exact "
                "source-to-target pairs: "
                + ", ".join(
                    f"{source_rel} -> {target_rel}"
                    for source_rel, target_rel in sorted(
                        CLEAN_ROOM_STARTUP_SMOKE_PAIRS
                    )
                )
            )
    notes = [
        "This command only plans/checks future sync.",
        "It does not copy, chmod, write target, or execute live smoke.",
        "Deployment requires apply --allow-write plus explicit profile-selected smoke.",
    ]
    if not any(
        record["target_rel"] == "bin/omx_install_sync"
        and record["action"] not in RETIRING_PLANNED_ACTIONS
        for record in records
    ):
        notes.append(
            "If this manifest is published with --publish-runtime-identity, "
            "the new receipt covers only this manifest, not previous coverage. "
            "It lacks non-retired bin/omx_install_sync, so subsequent installed "
            "companion-release-plan cannot verify installer provenance. "
            "To retain that coverage, before installation include the verified "
            "unchanged installer in the reviewed manifest and verify source/target "
            "bytes through the existing controlled install flow."
        )
    return {
        "schema_version": 1,
        "generated_at": utc_now(),
        "mode": "dry-run",
        "dry_run": True,
        "dry_run_only": True,
        "source": str(source_root),
        "target": str(target_root),
        "manifest": str(manifest_abs),
        "manifest_sha256": sha256_file(manifest_abs),
        **git_provenance,
        "post_install_smoke_profile": smoke_profile,
        "files": records,
        "items": records,
        "action_counts": counts,
        "writes_target": False,
        "copies_files": False,
        "chmod": False,
        "live_smoke": False,
        "notes": notes,
    }


def validate_apply_provenance(plan: dict[str, Any]) -> dict[str, list[str]]:
    source_root = Path(str(plan.get("source") or "")).resolve()
    required_assets: list[str] = []
    validated_assets: list[str] = []
    release_artifacts: list[str] = []
    for item in plan.get("files", []):
        source_rel = str(item.get("source_rel") or "")
        action = str(item.get("action") or "")
        if source_rel not in PROVENANCE_GATED_RUNTIME_ASSETS or action not in MUTATING_ACTIONS:
            continue
        required_assets.append(source_rel)
        artifact_rel = str(
            item.get("release_artifact_ref") or DEFAULT_RUNTIME_PROVENANCE_ARTIFACT
        ).strip()
        validate_relative_path(artifact_rel, "release_artifact_ref")
        artifact_path = (source_root / artifact_rel).resolve()
        try:
            artifact_path.relative_to(source_root)
        except ValueError as exc:
            raise InstallSyncError(
                f"runtime provenance artifact outside source root: {artifact_rel}"
            ) from exc
        try:
            payload = json.loads(artifact_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError, TypeError, ValueError) as exc:
            raise InstallSyncError(
                f"runtime provenance artifact required for {source_rel}: {artifact_rel}"
            ) from exc
        if payload.get("provenance_kind") != "public_source_release":
            raise InstallSyncError(
                f"runtime provenance artifact kind invalid for {source_rel}: {artifact_rel}"
            )
        files = payload.get("files")
        record = files.get(source_rel) if isinstance(files, dict) else None
        if not isinstance(record, dict):
            raise InstallSyncError(
                f"runtime provenance artifact missing asset: {source_rel}"
            )
        source_sha = str(item.get("source_sha256") or "")
        if str(record.get("reviewed_source_sha256") or "") != source_sha:
            raise InstallSyncError(
                f"runtime provenance reviewed source hash mismatch: {source_rel}"
            )
        if str(record.get("runtime_path") or "") != str(item.get("target_rel") or ""):
            raise InstallSyncError(
                f"runtime provenance target mismatch: {source_rel}"
            )
        validated_assets.append(source_rel)
        if artifact_rel not in release_artifacts:
            release_artifacts.append(artifact_rel)
    return {
        "required_assets": required_assets,
        "validated_assets": validated_assets,
        "release_artifacts": release_artifacts,
    }


def plan_action_items(plan: dict[str, Any], actions: set[str]) -> list[dict[str, Any]]:
    return [item for item in plan["files"] if item.get("action") in actions]


def read_text_lossy(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except Exception:
        return ""


def build_diff_preview(plan: dict[str, Any]) -> dict[str, Any]:
    entries: list[dict[str, Any]] = []
    counts: dict[str, int] = {}
    for item in plan["files"]:
        action = str(item.get("action") or "")
        if action not in {
            "would_update",
            "would_create",
            "would_chmod",
            "would_retire",
            "retire_absent_noop",
        }:
            continue
        counts[action] = counts.get(action, 0) + 1
        entry = {
            "source_rel": item["source_rel"],
            "target_rel": item["target_rel"],
            "source_path": item["source_path"],
            "target_path": item["target_path"],
            "action": action,
        }
        if action == "would_retire":
            entry["removed_target_sha256"] = str(
                item.get("target_sha256") or ""
            )
        elif action in {"would_update", "would_create"}:
            source_text = read_text_lossy(Path(item["source_path"]))
            target_text = read_text_lossy(Path(item["target_path"])) if bool(item.get("target_exists")) else ""
            diff_lines = list(
                difflib.unified_diff(
                    target_text.splitlines(keepends=True),
                    source_text.splitlines(keepends=True),
                    fromfile=item["target_rel"],
                    tofile=item["source_rel"],
                    n=3,
                )
            )
            entry["diff"] = "".join(diff_lines)
            entry["diff_line_count"] = len(diff_lines)
        if action == "would_chmod":
            entry["source_mode"] = item.get("source_mode")
            entry["target_mode"] = item.get("target_mode")
        entries.append(entry)
    return {
        "schema_version": 1,
        "generated_at": utc_now(),
        "mode": "diff",
        "dry_run": True,
        "dry_run_only": True,
        "source": plan["source"],
        "target": plan["target"],
        "manifest": plan["manifest"],
        "entries": entries,
        "items": entries,
        "action_counts": counts,
        "writes_target": False,
        "copies_files": False,
        "chmod": False,
        "live_smoke": False,
    }


def ensure_allow_write(value: bool) -> None:
    if not value:
        raise InstallSyncError("allow-write required")


def require_source_files(plan: dict[str, Any]) -> None:
    missing = [
        item["source_path"]
        for item in plan["files"]
        if not item.get("source_exists")
        and str(item.get("action") or "") not in RETIRING_PLANNED_ACTIONS
    ]
    if missing:
        raise InstallSyncError(f"source files missing: {missing}")


def existing_capacity_anchor(path: Path) -> Path:
    current = path
    while not current.exists():
        parent = current.parent
        if parent == current:
            raise InstallSyncError(f"install capacity is unknown: {path}")
        current = parent
    return current


def regular_file_size(path: Path) -> int:
    try:
        observed = path.stat(follow_symlinks=False)
    except OSError as exc:
        raise InstallSyncError(f"install size is unknown: {path}") from exc
    if not stat.S_ISREG(observed.st_mode):
        raise InstallSyncError(f"install size is unknown: {path}")
    return observed.st_size


def filesystem_free_bytes(path: Path) -> int:
    try:
        return shutil.disk_usage(path).free
    except OSError as exc:
        raise InstallSyncError(f"install capacity is unknown: {path}") from exc


def serialized_json_bytes(payload: Any) -> int:
    return len(
        json.dumps(
            payload,
            indent=2,
            sort_keys=True,
            ensure_ascii=False,
        ).encode("utf-8")
    )


def ordinary_journal_metadata_from_plan(
    plan: dict[str, Any],
    backup_root: Path,
) -> dict[str, Any]:
    files: list[dict[str, Any]] = []
    backed_up: list[dict[str, Any]] = []
    created: list[dict[str, Any]] = []
    chmod_targets: list[dict[str, Any]] = []
    retired_targets: list[dict[str, Any]] = []
    retired_noop_targets: list[dict[str, Any]] = []
    for item in plan.get("files", []):
        if not isinstance(item, dict):
            continue
        record = dict(item)
        action = str(item.get("action") or "")
        if action == "would_update":
            record["backup_path"] = str(
                backup_root / "targets" / str(item.get("target_rel") or "")
            )
            backed_up.append(record)
        elif action == "would_create":
            created.append(record)
        elif action == "would_chmod":
            chmod_targets.append(record)
        elif action == "would_retire":
            record["backup_path"] = str(
                backup_root / "targets" / str(item.get("target_rel") or "")
            )
            retired_targets.append(record)
        elif action == "retire_absent_noop":
            retired_noop_targets.append(record)
        files.append(record)
    return {
        **plan,
        "files": files,
        "items": files,
        "backed_up_files": backed_up,
        "created_targets": created,
        "chmod_targets": chmod_targets,
        "retired_targets": retired_targets,
        "retired_noop_targets": retired_noop_targets,
        "backup_dir": str(backup_root),
    }


def ordinary_journal_reserve_bytes(metadata: Any) -> int:
    reserve = (
        5 * serialized_json_bytes(metadata)
        + ORDINARY_INSTALL_JOURNAL_RESERVE_BYTES
    )
    reject_over_ordinary_ceiling(reserve)
    return reserve


def reject_over_ordinary_ceiling(nbytes: int) -> None:
    if nbytes > DEFAULT_ORDINARY_INSTALL_MAX_BYTES:
        raise InstallSyncError(
            "ordinary install exceeds hard byte ceiling: "
            f"{nbytes} > {DEFAULT_ORDINARY_INSTALL_MAX_BYTES}"
        )


def ordinary_mutation_capacity_budget(
    copy_items: list[dict[str, Any]],
    plan: dict[str, Any],
    backup_root: Path,
) -> dict[str, int]:
    source_bytes = 0
    target_required = 0
    backup_required = 0
    for item in copy_items:
        source_size = regular_file_size(Path(str(item["source_path"])))
        action = str(item.get("action") or "")
        if action == "would_create":
            target_size = 0
        else:
            target_size = regular_file_size(Path(str(item["target_path"])))
        source_bytes += source_size
        target_required += max(source_size, target_size)
        if action == "would_update":
            backup_required += target_size
    for item in plan.get("files", []):
        if str(item.get("action") or "") == "would_retire":
            backup_required += regular_file_size(
                Path(str(item.get("target_path") or ""))
            )
    reject_over_ordinary_ceiling(source_bytes)
    reject_over_ordinary_ceiling(backup_required)
    journal_reserve = ordinary_journal_reserve_bytes(
        ordinary_journal_metadata_from_plan(plan, backup_root)
    )
    return {
        "source_bytes": source_bytes,
        "target_required_bytes": target_required,
        "backup_required_bytes": backup_required,
        "journal_reserve_bytes": journal_reserve,
        "hard_ceiling_bytes": DEFAULT_ORDINARY_INSTALL_MAX_BYTES,
    }


def enforce_ordinary_write_capacity(
    *,
    target_root: Path,
    backup_root: Path,
    budget: dict[str, int],
    actor: dict[str, Any],
) -> dict[str, Any]:
    target_anchor = existing_capacity_anchor(target_root)
    backup_anchor = existing_capacity_anchor(backup_root)
    try:
        target_dev = target_anchor.stat().st_dev
        backup_dev = backup_anchor.stat().st_dev
    except OSError as exc:
        raise InstallSyncError(
            f"install capacity is unknown: {target_root}"
        ) from exc
    target_free = filesystem_free_bytes(target_anchor)
    backup_free = filesystem_free_bytes(backup_anchor)
    target_required = int(budget["target_required_bytes"])
    backup_required = int(budget["backup_required_bytes"])
    journal_required = int(budget["journal_reserve_bytes"])
    same_filesystem = target_dev == backup_dev
    if same_filesystem:
        required = target_required + backup_required + journal_required
        if target_free < required:
            raise InstallSyncError(
                "insufficient free space for ordinary install: "
                f"{required} > {target_free}"
            )
        evidence: dict[str, Any] = {
            "required_bytes": required,
            "free_bytes": target_free,
        }
    else:
        backup_side_required = backup_required + journal_required
        if target_free < target_required:
            raise InstallSyncError(
                "insufficient free space for ordinary install: "
                f"{target_required} > {target_free}"
            )
        if backup_free < backup_side_required:
            raise InstallSyncError(
                "insufficient free space for ordinary install: "
                f"{backup_side_required} > {backup_free}"
            )
        evidence = {}
    return {
        "source_bytes": int(budget["source_bytes"]),
        "target_required_bytes": target_required,
        "backup_required_bytes": backup_required,
        "journal_reserve_bytes": journal_required,
        "target_free_bytes": target_free,
        "backup_free_bytes": backup_free,
        "hard_ceiling_bytes": int(budget["hard_ceiling_bytes"]),
        "same_filesystem": same_filesystem,
        "actor": actor,
        **evidence,
    }


def enforce_ordinary_apply_capacity(
    plan: dict[str, Any],
    backup_root: Path,
    copy_items: list[dict[str, Any]],
    actor: dict[str, Any],
) -> dict[str, Any]:
    budget = ordinary_mutation_capacity_budget(copy_items, plan, backup_root)
    return enforce_ordinary_write_capacity(
        target_root=Path(plan["target"]).resolve(),
        backup_root=backup_root,
        budget=budget,
        actor=actor,
    )


def enforce_ordinary_rollback_capacity(
    target_root: Path,
    backup_root: Path,
    restore_records: list[dict[str, Any]],
    actor: dict[str, Any],
    journal: dict[str, Any],
) -> dict[str, Any]:
    restore_bytes = 0
    for record in restore_records:
        target_rel = str(record.get("target_rel") or "")
        restore_bytes += regular_file_size(backup_root / "targets" / target_rel)
    reject_over_ordinary_ceiling(restore_bytes)
    budget = {
        "source_bytes": restore_bytes,
        "target_required_bytes": restore_bytes,
        "backup_required_bytes": 0,
        "journal_reserve_bytes": ordinary_journal_reserve_bytes(journal),
        "hard_ceiling_bytes": DEFAULT_ORDINARY_INSTALL_MAX_BYTES,
    }
    return enforce_ordinary_write_capacity(
        target_root=target_root,
        backup_root=backup_root,
        budget=budget,
        actor=actor,
    )


def validate_target_preconditions(
    plan: dict[str, Any],
    *,
    require_target_preimages: bool = False,
) -> None:
    mismatches = []
    for item in plan.get("files", []):
        expected = str(item.get("expected_target_sha256") or "")
        action = str(item.get("action") or "")
        target_rel = str(item.get("target_rel") or "")
        actual = str(item.get("target_sha256") or "")
        if expected == "absent":
            if os.path.lexists(item["target_path"]):
                mismatches.append(
                    f"{target_rel} expected=absent actual={actual or 'present'}"
                )
            continue
        if action == "would_retire":
            if not os.path.lexists(item["target_path"]):
                mismatches.append(
                    f"{target_rel} retire target absent actual={actual or 'absent'}"
                )
            elif not expected or actual != expected:
                mismatches.append(
                    f"{target_rel} expected={expected or 'missing'} "
                    f"actual={actual or 'absent'}"
                )
            continue
        if action == "retire_absent_noop":
            if os.path.lexists(item["target_path"]):
                mismatches.append(
                    f"{target_rel} retire noop target appeared "
                    f"actual={actual or 'present'}"
                )
            continue
        if require_target_preimages:
            if not expected or actual != expected:
                mismatches.append(
                    f"{target_rel} expected={expected or 'missing'} "
                    f"actual={actual or 'absent'}"
                )
            continue
        if not expected or action not in {"would_create", "would_update"}:
            continue
        if actual != expected:
            mismatches.append(
                f"{item['target_rel']} expected={expected} actual={actual or 'absent'}"
            )
    if mismatches:
        raise InstallSyncError(
            "target precondition mismatch: " + "; ".join(mismatches)
        )


def plan_requires_post_install_smoke(plan: dict[str, Any]) -> bool:
    return any(
        item.get("action") in {"would_update", "would_create", "would_chmod"}
        and bool(item.get("smoke_required_after_install"))
        for item in plan["files"]
    )


@contextmanager
def opened_target_parent(
    target_root: Path,
    target: Path,
    *,
    create_parents: bool = True,
):
    if create_parents:
        target_root.mkdir(parents=True, exist_ok=True)
    try:
        target_rel = target.relative_to(target_root)
    except ValueError as exc:
        raise InstallSyncError(
            f"target outside target root: {target}"
        ) from exc
    flags = (
        os.O_RDONLY
        | os.O_DIRECTORY
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_CLOEXEC", 0)
    )
    fds: list[int] = []
    components: list[str] = []
    identities: list[tuple[int, int]] = []
    try:
        try:
            current_fd = os.open(target_root, flags)
        except FileNotFoundError as exc:
            raise InstallSyncError(f"target root missing: {target_root}") from exc
        fds.append(current_fd)
        observed = os.fstat(current_fd)
        identities.append((observed.st_dev, observed.st_ino))
        for component in target_rel.parent.parts:
            try:
                next_fd = os.open(component, flags, dir_fd=current_fd)
            except FileNotFoundError:
                if not create_parents:
                    raise InstallSyncError(
                        f"target parent component missing: {target.parent}"
                    )
                os.mkdir(component, dir_fd=current_fd)
                next_fd = os.open(component, flags, dir_fd=current_fd)
            except OSError as exc:
                raise InstallSyncError(
                    f"target parent component invalid: {target.parent}"
                ) from exc
            components.append(component)
            fds.append(next_fd)
            current_fd = next_fd
            observed = os.fstat(current_fd)
            identities.append((observed.st_dev, observed.st_ino))

        def verify_identity() -> None:
            verify_fds: list[int] = []
            try:
                verify_fd = os.open(target_root, flags)
                verify_fds.append(verify_fd)
                observed = os.fstat(verify_fd)
                if (observed.st_dev, observed.st_ino) != identities[0]:
                    raise InstallSyncError(
                        f"target parent identity changed: {target.parent}"
                    )
                for index, component in enumerate(components, start=1):
                    verify_fd = os.open(
                        component,
                        flags,
                        dir_fd=verify_fd,
                    )
                    verify_fds.append(verify_fd)
                    observed = os.fstat(verify_fd)
                    if (
                        observed.st_dev,
                        observed.st_ino,
                    ) != identities[index]:
                        raise InstallSyncError(
                            f"target parent identity changed: {target.parent}"
                        )
            except (FileNotFoundError, NotADirectoryError, OSError) as exc:
                if isinstance(exc, InstallSyncError):
                    raise
                raise InstallSyncError(
                    f"target parent identity changed: {target.parent}"
                ) from exc
            finally:
                for fd in reversed(verify_fds):
                    os.close(fd)

        yield current_fd, target.name, verify_identity
    finally:
        for fd in reversed(fds):
            os.close(fd)


def chmod_regular_target(
    target_root: Path,
    target: Path,
    mode: int,
    *,
    expected_identity: object = None,
    expected_sha256: str = "",
    expected_mode: int | None = None,
) -> tuple[int, dict[str, int]]:
    with opened_target_parent(target_root, target) as (
        parent_fd,
        target_name,
        verify_identity,
    ):
        descriptor = os.open(
            target_name,
            os.O_RDONLY
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_NONBLOCK", 0)
            | getattr(os, "O_CLOEXEC", 0),
            dir_fd=parent_fd,
        )
        try:
            observed = os.fstat(descriptor)
            if not stat.S_ISREG(observed.st_mode):
                raise InstallSyncError(
                    f"chmod target must be a regular file: {target}"
                )
            identity = {
                "st_dev": observed.st_dev,
                "st_ino": observed.st_ino,
            }
            actual_sha256 = sha256_descriptor(descriptor)
            if expected_identity is not None:
                if (
                    not isinstance(expected_identity, dict)
                    or type(expected_identity.get("st_dev")) is not int
                    or type(expected_identity.get("st_ino")) is not int
                ):
                    raise InstallSyncError(
                        f"chmod target identity invalid: {target}"
                    )
                if identity != expected_identity:
                    raise InstallSyncError(
                        f"chmod target identity changed: {target}"
                    )
            if expected_sha256 and (
                len(expected_sha256) != 64
                or actual_sha256 != expected_sha256
            ):
                raise InstallSyncError(
                    f"chmod target content changed: {target}"
                )
            if (
                expected_mode is not None
                and stat.S_IMODE(observed.st_mode) != expected_mode
            ):
                raise InstallSyncError(
                    f"chmod target mode changed: {target}"
                )
            verify_identity()
            os.fchmod(descriptor, mode)
            try:
                verify_identity()
                mutated = verify_open_regular_entry(
                    descriptor,
                    parent_fd,
                    target_name,
                    expected_identity=identity,
                    expected_sha256=actual_sha256,
                    expected_mode=mode,
                    error=(
                        f"chmod target changed after mutation: {target}"
                    ),
                )
            except Exception:
                rollback_mode = stat.S_IMODE(observed.st_mode)
                try:
                    os.fchmod(descriptor, rollback_mode)
                    restored = os.fstat(descriptor)
                    if (
                        not stat.S_ISREG(restored.st_mode)
                        or (
                            restored.st_dev,
                            restored.st_ino,
                        )
                        != (
                            identity["st_dev"],
                            identity["st_ino"],
                        )
                        or stat.S_IMODE(restored.st_mode)
                        != rollback_mode
                    ):
                        raise InstallSyncError(
                            "retained chmod inode mode restoration "
                            "did not verify"
                        )
                except Exception as rollback_exc:
                    raise ChmodRollbackError(
                        f"chmod rollback failed: {target}: "
                        f"{type(rollback_exc).__name__}: {rollback_exc}"
                    ) from rollback_exc
                raise
            return stat.S_IMODE(mutated.st_mode), identity
        finally:
            os.close(descriptor)


def atomic_copy2(
    source: Path,
    target: Path,
    *,
    overwrite: bool = True,
    target_root: Path | None = None,
    update_preimage: dict[str, Any] | None = None,
    on_validated_backup: Callable[[], None] | None = None,
    on_update_committed: (
        Callable[[dict[str, int]], None] | None
    ) = None,
    on_created_target_identity_anchored: (
        Callable[[dict[str, int], str], None] | None
    ) = None,
    expected_source_sha256: str = "",
    expected_source_mode: int | None = None,
) -> tuple[int, int, str] | None:
    root = target.parent if target_root is None else target_root
    with opened_target_parent(root, target) as (
        parent_fd,
        target_name,
        verify_identity,
    ):
        anchor_proc = Path(
            tempfile.mkdtemp(
                dir=f"/proc/self/fd/{parent_fd}",
                prefix=f".{target.name}.anchor-",
            )
        )
        anchor_name = anchor_proc.name
        anchor_path = target.parent / anchor_name
        anchor_fd = os.open(
            anchor_name,
            os.O_RDONLY
            | os.O_DIRECTORY
            | getattr(os, "O_NOFOLLOW", 0),
            dir_fd=parent_fd,
        )
        tmp_proc = Path(f"/proc/self/fd/{anchor_fd}/{target_name}")
        retain_tmp = False
        staged_descriptor = -1
        try:
            verify_identity()
            with tmp_proc.open("xb"):
                pass
            source_fd = os.open(
                source,
                os.O_RDONLY
                | getattr(os, "O_NOFOLLOW", 0)
                | getattr(os, "O_CLOEXEC", 0),
            )
            try:
                source_stat = os.fstat(source_fd)
                source_size = source_stat.st_size
                if (
                    not stat.S_ISREG(source_stat.st_mode)
                    or source_size > DEFAULT_ORDINARY_INSTALL_MAX_BYTES
                ):
                    raise InstallSyncError(
                        f"staged install invalid: {target}"
                    )
                copy_descriptor2(
                    source_fd,
                    tmp_proc,
                    source_stat,
                    max_bytes=source_size,
                )
            finally:
                os.close(source_fd)
            staged_descriptor = os.open(
                target_name,
                os.O_RDONLY
                | getattr(os, "O_NOFOLLOW", 0)
                | getattr(os, "O_NONBLOCK", 0)
                | getattr(os, "O_CLOEXEC", 0),
                dir_fd=anchor_fd,
            )
            staged_initial = os.fstat(staged_descriptor)
            staged_entry = os.stat(
                target_name,
                dir_fd=anchor_fd,
                follow_symlinks=False,
            )
            if (
                not stat.S_ISREG(staged_initial.st_mode)
                or not stat.S_ISREG(staged_entry.st_mode)
                or staged_initial.st_size != source_size
                or staged_entry.st_size != source_size
                or (
                    staged_entry.st_dev,
                    staged_entry.st_ino,
                )
                != (
                    staged_initial.st_dev,
                    staged_initial.st_ino,
                )
                or (
                    expected_source_mode is not None
                    and type(expected_source_mode) is not int
                )
            ):
                raise InstallSyncError(
                    f"staged install invalid: {target}"
                )
            staged_identity = {
                "st_dev": staged_initial.st_dev,
                "st_ino": staged_initial.st_ino,
            }
            staged_sha256 = (
                str(expected_source_sha256)
                if expected_source_sha256
                else sha256_descriptor(staged_descriptor)
            )
            staged_mode = (
                expected_source_mode
                if expected_source_mode is not None
                else stat.S_IMODE(staged_initial.st_mode)
            )
            os.fchmod(staged_descriptor, staged_mode)
            verify_open_regular_entry(
                staged_descriptor,
                anchor_fd,
                target_name,
                expected_identity=staged_identity,
                expected_sha256=staged_sha256,
                expected_mode=staged_mode,
                error=f"staged install invalid: {target}",
            )
            verify_identity()
            if overwrite and update_preimage is None:
                verify_open_regular_entry(
                    staged_descriptor,
                    anchor_fd,
                    target_name,
                    expected_identity=staged_identity,
                    expected_sha256=staged_sha256,
                    expected_mode=staged_mode,
                    error=f"staged install changed before commit: {target}",
                )
                os.replace(
                    target_name,
                    target_name,
                    src_dir_fd=anchor_fd,
                    dst_dir_fd=parent_fd,
                )
                verify_open_regular_entry(
                    staged_descriptor,
                    parent_fd,
                    target_name,
                    expected_identity=staged_identity,
                    expected_sha256=staged_sha256,
                    expected_mode=staged_mode,
                    error=f"installed target changed after commit: {target}",
                )
            elif overwrite:
                expected_identity = update_preimage.get(
                    "target_identity"
                )
                expected_sha256 = str(
                    update_preimage.get("target_sha256") or ""
                )
                expected_mode = update_preimage.get("target_mode")
                backup_path = Path(
                    str(update_preimage.get("backup_path") or "")
                )
                if (
                    not isinstance(expected_identity, dict)
                    or type(expected_identity.get("st_dev")) is not int
                    or type(expected_identity.get("st_ino")) is not int
                    or len(expected_sha256) != 64
                    or type(expected_mode) is not int
                    or not backup_path.is_absolute()
                    or on_validated_backup is None
                    or on_update_committed is None
                ):
                    raise InstallSyncError(
                        f"planned preimage invalid: {target}"
                    )
                quarantine_proc = Path(
                    tempfile.mkdtemp(
                        dir=f"/proc/self/fd/{parent_fd}",
                        prefix=f".{target.name}.update-",
                    )
                )
                quarantine_name = quarantine_proc.name
                quarantine_path = (
                    target.parent / quarantine_name / target_name
                )
                quarantine_fd = os.open(
                    quarantine_name,
                    os.O_RDONLY
                    | os.O_DIRECTORY
                    | getattr(os, "O_NOFOLLOW", 0),
                    dir_fd=parent_fd,
                )
                preserve_quarantine = False

                def restore_quarantined() -> None:
                    nonlocal quarantine_fd, preserve_quarantine
                    try:
                        os.link(
                            target_name,
                            target_name,
                            src_dir_fd=quarantine_fd,
                            dst_dir_fd=parent_fd,
                            follow_symlinks=False,
                        )
                    except OSError as exc:
                        preserve_quarantine = True
                        raise InstallSyncError(
                            "update preimage restoration conflict; "
                            f"quarantined target preserved at: "
                            f"{quarantine_path}"
                        ) from exc
                    os.unlink(target_name, dir_fd=quarantine_fd)
                    os.close(quarantine_fd)
                    quarantine_fd = -1
                    os.rmdir(quarantine_name, dir_fd=parent_fd)

                try:
                    quarantine_stat = os.fstat(quarantine_fd)
                    if (
                        not stat.S_ISDIR(quarantine_stat.st_mode)
                        or stat.S_IMODE(quarantine_stat.st_mode) & 0o077
                    ):
                        raise InstallSyncError(
                            "update quarantine path invalid: "
                            f"{quarantine_path.parent}"
                        )
                    verify_identity()
                    os.replace(
                        target_name,
                        target_name,
                        src_dir_fd=parent_fd,
                        dst_dir_fd=quarantine_fd,
                    )
                    preimage_descriptor = -1
                    try:
                        preimage_descriptor = os.open(
                            target_name,
                            os.O_RDONLY
                            | getattr(os, "O_NOFOLLOW", 0)
                            | getattr(os, "O_NONBLOCK", 0)
                            | getattr(os, "O_CLOEXEC", 0),
                            dir_fd=quarantine_fd,
                        )
                        observed = os.fstat(preimage_descriptor)
                        actual_identity = {
                            "st_dev": observed.st_dev,
                            "st_ino": observed.st_ino,
                        }
                        actual_sha256 = (
                            sha256_descriptor(preimage_descriptor)
                            if stat.S_ISREG(observed.st_mode)
                            else ""
                        )
                        if (
                            not stat.S_ISREG(observed.st_mode)
                            or actual_identity != expected_identity
                            or actual_sha256 != expected_sha256
                            or stat.S_IMODE(observed.st_mode)
                            != expected_mode
                        ):
                            raise InstallSyncError(
                                f"planned preimage mismatch: {target}"
                            )
                        backup_path.parent.mkdir(
                            parents=True,
                            exist_ok=True,
                        )
                        copy_descriptor2(
                            preimage_descriptor,
                            backup_path,
                            observed,
                            max_bytes=observed.st_size,
                        )
                        on_validated_backup()
                        current_quarantine = os.stat(
                            quarantine_name,
                            dir_fd=parent_fd,
                            follow_symlinks=False,
                        )
                        if (
                            not stat.S_ISDIR(current_quarantine.st_mode)
                            or (
                                current_quarantine.st_dev,
                                current_quarantine.st_ino,
                            )
                            != (
                                quarantine_stat.st_dev,
                                quarantine_stat.st_ino,
                            )
                        ):
                            raise InstallSyncError(
                                f"update quarantine changed: {target}"
                            )
                        verify_open_regular_entry(
                            preimage_descriptor,
                            quarantine_fd,
                            target_name,
                            expected_identity=expected_identity,
                            expected_sha256=expected_sha256,
                            expected_mode=expected_mode,
                            error=f"planned preimage changed: {target}",
                        )
                        verify_open_regular_entry(
                            staged_descriptor,
                            anchor_fd,
                            target_name,
                            expected_identity=staged_identity,
                            expected_sha256=staged_sha256,
                            expected_mode=staged_mode,
                            error=(
                                "staged install changed before commit: "
                                f"{target}"
                            ),
                        )
                        verify_identity()
                        try:
                            os.link(
                                target_name,
                                target_name,
                                src_dir_fd=anchor_fd,
                                dst_dir_fd=parent_fd,
                                follow_symlinks=False,
                            )
                        except OSError as exc:
                            raise InstallSyncError(
                                f"update commit conflict: {target}"
                            ) from exc
                        try:
                            installed = verify_open_regular_entry(
                                staged_descriptor,
                                parent_fd,
                                target_name,
                                expected_identity=staged_identity,
                                expected_sha256=staged_sha256,
                                expected_mode=staged_mode,
                                error=(
                                    "installed target changed after commit: "
                                    f"{target}"
                                ),
                            )
                        except Exception:
                            current = os.stat(
                                target_name,
                                dir_fd=parent_fd,
                                follow_symlinks=False,
                            )
                            if (
                                current.st_dev,
                                current.st_ino,
                            ) == (
                                staged_identity["st_dev"],
                                staged_identity["st_ino"],
                            ):
                                os.unlink(target_name, dir_fd=parent_fd)
                            else:
                                preserve_quarantine = True
                            raise
                        on_update_committed(
                            {
                                "st_dev": installed.st_dev,
                                "st_ino": installed.st_ino,
                            }
                        )
                    except Exception:
                        restore_quarantined()
                        raise
                    finally:
                        if preimage_descriptor >= 0:
                            os.close(preimage_descriptor)
                    os.unlink(target_name, dir_fd=quarantine_fd)
                    os.close(quarantine_fd)
                    quarantine_fd = -1
                    os.rmdir(quarantine_name, dir_fd=parent_fd)
                finally:
                    if quarantine_fd >= 0:
                        os.close(quarantine_fd)
                    if not preserve_quarantine:
                        try:
                            os.rmdir(quarantine_name, dir_fd=parent_fd)
                        except OSError:
                            pass
            else:
                verify_open_regular_entry(
                    staged_descriptor,
                    anchor_fd,
                    target_name,
                    expected_identity=staged_identity,
                    expected_sha256=staged_sha256,
                    expected_mode=staged_mode,
                    error=f"staged install changed before commit: {target}",
                )
                if on_created_target_identity_anchored is not None:
                    on_created_target_identity_anchored(
                        staged_identity,
                        str(anchor_path / target_name),
                    )
                try:
                    os.link(
                        target_name,
                        target_name,
                        src_dir_fd=anchor_fd,
                        dst_dir_fd=parent_fd,
                        follow_symlinks=False,
                    )
                except FileExistsError as exc:
                    raise InstallSyncError(
                        "absent target appeared during atomic install: "
                        f"{target}"
                    ) from exc
                try:
                    committed = verify_open_regular_entry(
                        staged_descriptor,
                        parent_fd,
                        target_name,
                        expected_identity=staged_identity,
                        expected_sha256=staged_sha256,
                        expected_mode=staged_mode,
                        error=f"created target changed after commit: {target}",
                    )
                except Exception:
                    try:
                        current = os.stat(
                            target_name,
                            dir_fd=parent_fd,
                            follow_symlinks=False,
                        )
                    except OSError:
                        current = None
                    if (
                        current is not None
                        and (
                            current.st_dev,
                            current.st_ino,
                        )
                        == (
                            staged_identity["st_dev"],
                            staged_identity["st_ino"],
                        )
                    ):
                        os.unlink(target_name, dir_fd=parent_fd)
                    raise
                retain_tmp = True
                return (
                    committed.st_dev,
                    committed.st_ino,
                    str(anchor_path / target_name),
                )
        finally:
            if staged_descriptor >= 0:
                os.close(staged_descriptor)
            if not retain_tmp:
                try:
                    os.unlink(target_name, dir_fd=anchor_fd)
                except FileNotFoundError:
                    pass
            os.close(anchor_fd)
            if not retain_tmp:
                os.rmdir(anchor_name, dir_fd=parent_fd)
    return None


def manifest_record_for_copy(item: dict[str, Any], backup_path: Path | None = None) -> dict[str, Any]:
    target_path = Path(item["target_path"])
    source_path = Path(item["source_path"])
    record = {
        "source_rel": item["source_rel"],
        "target_rel": item["target_rel"],
        "source_path": str(source_path),
        "target_path": str(target_path),
        "action": item["action"],
        "source_sha256": item.get("source_sha256", ""),
        "old_target_sha256": item.get("target_sha256", ""),
        "new_target_sha256": sha256_file(target_path) if target_path.exists() else "",
        "source_mode": item.get("source_mode"),
        "old_target_mode": item.get("target_mode"),
        "new_target_mode": file_mode(target_path) if target_path.exists() else None,
    }
    if backup_path is not None:
        record["backup_path"] = str(backup_path)
    return record


def write_json_atomic(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = path.with_name(f"{path.name}.tmp")
    try:
        tmp_path.write_text(
            json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False),
            encoding="utf-8",
        )
        tmp_path.replace(path)
    finally:
        if tmp_path.exists():
            tmp_path.unlink()


def write_backup_manifest(backup_dir: Path, manifest: dict[str, Any]) -> None:
    write_json_atomic(backup_dir / "backup-manifest.json", manifest)


def persist_install_result(backup_dir: Path, result: dict[str, Any]) -> dict[str, Any]:
    backup_root = backup_dir.resolve()
    result_path = backup_root / "install-result.json"
    status = {
        "ok": False,
        "install_result_written": False,
        "manifest_linked": False,
        "failure_stage": "",
        "error": "",
    }
    try:
        write_json_atomic(result_path, result)
    except Exception as exc:
        return {
            **status,
            "failure_stage": "install_result_write",
            "error": f"{type(exc).__name__}: {exc}",
        }
    status["install_result_written"] = True
    try:
        manifest = load_backup_manifest(backup_root)
    except Exception as exc:
        return {
            **status,
            "failure_stage": "backup_manifest_load",
            "error": f"{type(exc).__name__}: {exc}",
        }
    try:
        manifest["install_result"] = {
            "path": result_path.relative_to(backup_root).as_posix(),
            "sha256": sha256_file(result_path),
        }
        write_backup_manifest(backup_root, manifest)
    except Exception as exc:
        return {
            **status,
            "failure_stage": "backup_manifest_link",
            "error": f"{type(exc).__name__}: {exc}",
        }
    return {
        **status,
        "ok": True,
        "manifest_linked": True,
    }


def installed_target_sha256(result: dict[str, Any]) -> dict[str, str]:
    hashes: dict[str, str] = {}
    for item in result.get("files", []):
        target_rel = str(item.get("target_rel") or "")
        target_path = Path(str(item.get("target_path") or ""))
        if target_rel and target_path.is_file():
            hashes[target_rel] = sha256_file(target_path)
    return hashes


def verify_install_parity(result: dict[str, Any]) -> dict[str, Any]:
    targets: list[dict[str, Any]] = []
    for item in result.get("files", []):
        action = str(item.get("action") or "")
        if action in RETIRING_PLANNED_ACTIONS:
            removed_sha256 = str(item.get("retire_expected_sha256") or "")
            target_path = Path(str(item.get("target_path") or ""))
            exists = target_path.exists() or target_path.is_symlink()
            targets.append(
                {
                    "target_rel": str(item.get("target_rel") or ""),
                    "target_path": str(target_path),
                    "action": action,
                    "exists": exists,
                    "expected_sha256": removed_sha256,
                    "actual_sha256": "",
                    "expected_mode": item.get("retire_expected_mode"),
                    "actual_mode": None,
                    "observation_error": "",
                    "ok": (
                        not exists
                        and len(removed_sha256) == 64
                    ),
                }
            )
            continue
        if action not in MUTATING_ACTIONS:
            continue
        target_path = Path(str(item.get("target_path") or ""))
        expected_sha256 = str(item.get("source_sha256") or "")
        expected_mode = item.get("source_mode")
        observation_error = ""
        try:
            exists = target_path.is_file()
            actual_sha256 = sha256_file(target_path) if exists else ""
            actual_mode = file_mode(target_path) if exists else None
        except OSError as exc:
            exists = False
            actual_sha256 = ""
            actual_mode = None
            observation_error = f"{type(exc).__name__}: {exc}"
        hash_ok = bool(expected_sha256) and actual_sha256 == expected_sha256
        mode_ok = expected_mode is None or actual_mode == expected_mode
        targets.append(
            {
                "target_rel": str(item.get("target_rel") or ""),
                "target_path": str(target_path),
                "action": action,
                "exists": exists,
                "expected_sha256": expected_sha256,
                "actual_sha256": actual_sha256,
                "expected_mode": expected_mode,
                "actual_mode": actual_mode,
                "observation_error": observation_error,
                "ok": (
                    exists
                    and not observation_error
                    and hash_ok
                    and mode_ok
                ),
            }
        )
    mismatches = [item for item in targets if not item["ok"]]
    return {
        "ok": not mismatches,
        "checked_count": len(targets),
        "mismatch_count": len(mismatches),
        "targets": targets,
        "mismatches": mismatches,
    }


def install_event_log_path(target_root: Path) -> Path:
    return target_root.resolve() / INSTALL_EVENT_LOG_REL


def append_install_mutation_event(result: dict[str, Any]) -> dict[str, Any]:
    old_target_records = result.get("files", [])
    event = {
        "schema_version": 1,
        "event_id": f"install-{uuid.uuid4().hex}",
        "event_type": "install_applied",
        "timestamp": utc_now(),
        "actor": result["actor"],
        "source_repo": result["source"],
        "source_git_commit": str(result.get("source_git_commit") or ""),
        "source_git_dirty": bool(result.get("source_git_dirty")),
        "manifest": result["manifest"],
        "manifest_sha256": result["manifest_sha256"],
        "target_root": result["target"],
        "backup_dir": result["backup_dir"],
        "old_target_sha256": {
            str(item["target_rel"]): str(
                item.get("old_target_sha256")
                or item.get("target_sha256")
                or ""
            )
            for item in old_target_records
            if str(item.get("action") or "") not in RETIRING_PLANNED_ACTIONS
        },
        "new_target_sha256": installed_target_sha256(result),
        "pre_apply_effective_event_id_by_target": {
            target_rel: event_id
            for target_rel, event_id in result.get(
                "pre_apply_effective_event_id_by_target",
                {},
            ).items()
            if target_rel
            not in {
                str(item.get("target_rel") or "")
                for item in old_target_records
                if str(item.get("action") or "") in RETIRING_PLANNED_ACTIONS
            }
        },
        "chmod_targets": result.get("chmod_targets", []),
        "retired_target_sha256": {
            str(record.get("target_rel") or ""): str(
                record.get("removed_target_sha256") or ""
            )
            for record in result.get("retired_targets", [])
            if isinstance(record, dict)
        },
        "retired_noop_target_rel": [
            str(record.get("target_rel") or "")
            for record in result.get("retired_noop_targets", [])
            if isinstance(record, dict)
        ],
        "stale_source_guard": result.get("stale_source_guard", {}),
    }
    if result.get("runtime_identity_authorization_id"):
        event["runtime_identity_authorization_id"] = result[
            "runtime_identity_authorization_id"
        ]
    path = install_event_log_path(Path(result["target"]))
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(
            json.dumps(event, sort_keys=True, ensure_ascii=False) + "\n"
        )
        handle.flush()
        os.fsync(handle.fileno())
    return event


def read_install_mutation_events(target_root: Path) -> list[dict[str, Any]]:
    path = install_event_log_path(target_root)
    if not path.exists():
        return []
    if not path.is_file():
        raise InstallSyncError(
            f"install mutation ledger is unreadable: {path}"
        )
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise InstallSyncError(
            f"install mutation ledger is unreadable: {path}: {exc}"
        ) from exc
    events: list[dict[str, Any]] = []
    for line_number, line in enumerate(lines, start=1):
        if not line.strip():
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError as exc:
            raise InstallSyncError(
                f"install mutation ledger is malformed: {path}:{line_number}: {exc}"
            ) from exc
        if not isinstance(event, dict):
            raise InstallSyncError(
                f"install mutation ledger is malformed: {path}:{line_number}"
            )
        if event.get("event_type") == "install_applied":
            hashes = event.get("new_target_sha256")
            if (
                not isinstance(event.get("target_root"), str)
                or not isinstance(event.get("source_git_commit"), str)
                or not isinstance(hashes, dict)
                or any(
                    not isinstance(key, str) or not isinstance(value, str)
                    for key, value in hashes.items()
                )
            ):
                raise InstallSyncError(
                    f"install mutation ledger is malformed: {path}:{line_number}"
                )
        events.append(event)
    return events


def is_sha256_map(value: Any) -> bool:
    return (
        isinstance(value, dict)
        and bool(value)
        and all(
            isinstance(key, str)
            and isinstance(digest, str)
            and len(digest) == 64
            and all(
                char in "0123456789abcdef"
                for char in digest
            )
            for key, digest in value.items()
        )
    )


def effective_event_target_hashes(
    event: dict[str, Any],
) -> dict[str, str] | None:
    if event.get("event_type") == "install_applied":
        return event.get("new_target_sha256")
    if event.get("event_type") == "install_rolled_back":
        return event.get("restored_target_sha256")
    return None


def replay_install_mutation_events(
    target_root: Path,
    events: list[dict[str, Any]] | None = None,
) -> dict[str, Any]:
    target = target_root.resolve()
    ordered = (
        read_install_mutation_events(target)
        if events is None
        else events
    )
    recognized: list[dict[str, Any]] = []
    by_id: dict[str, dict[str, Any]] = {}
    compensated: set[str] = set()
    latest_effective: dict[str, tuple[dict[str, Any], str]] = {}
    retired_by_target: dict[str, tuple[dict[str, Any], str]] = {}

    def resolve_pre_apply_source(
        event_id: str,
        target_rel: str,
        expected_sha256: str,
    ) -> dict[str, Any]:
        seen: set[str] = set()
        current_id = event_id
        while current_id not in seen:
            seen.add(current_id)
            prior = by_id.get(current_id)
            prior_hashes = (
                effective_event_target_hashes(prior)
                if prior is not None
                else None
            )
            if (
                prior is None
                or prior_hashes is None
                or prior_hashes.get(target_rel) != expected_sha256
            ):
                break
            if prior.get("event_type") != "install_rolled_back":
                return prior
            nested = prior.get(
                "pre_apply_effective_event_id_by_target"
            )
            current_id = (
                nested.get(target_rel)
                if isinstance(nested, dict)
                else ""
            )
            if not isinstance(current_id, str) or not current_id:
                break
        raise InstallSyncError(
            "install mutation ledger rollback pre-apply "
            f"attribution mismatch: {target_rel}"
        )

    for index, event in enumerate(ordered, start=1):
        event_type = event.get("event_type")
        if event_type not in {"install_applied", "install_rolled_back"}:
            continue
        event_id = str(event.get("event_id") or "")
        if not event_id or event_id in by_id:
            raise InstallSyncError(
                "install mutation ledger is malformed: "
                f"missing or duplicate event_id at recognized event {index}"
            )
        hashes = effective_event_target_hashes(event)
        retired_ledger_map = (
            event.get("retired_target_sha256")
            if event_type == "install_applied"
            else None
        )
        retired_restore_map = (
            event.get("restored_retired_target_sha256")
            if event_type == "install_rolled_back"
            else None
        )
        if (
            str(event.get("target_root") or "") != str(target)
            or not isinstance(event.get("source_git_commit"), str)
            or not isinstance(hashes, dict)
            or (hashes and not is_sha256_map(hashes))
            or (
                not hashes
                and not isinstance(retired_ledger_map, dict)
                and not isinstance(retired_restore_map, dict)
            )
            or (
                isinstance(retired_ledger_map, dict)
                and retired_ledger_map
                and not is_sha256_map(retired_ledger_map)
            )
        ):
            raise InstallSyncError(
                "install mutation ledger is malformed: "
                f"recognized event {event_id}"
            )
        if event_type == "install_rolled_back":
            candidate_hashes = event.get("candidate_target_sha256")
            pre_apply = event.get(
                "pre_apply_effective_event_id_by_target"
            )
            compensated_value = event.get(
                "compensated_install_event_id"
            )
            compensated_id = (
                compensated_value
                if isinstance(compensated_value, str)
                else ""
            )
            if (
                (
                    not is_sha256_map(candidate_hashes)
                    and not (
                        isinstance(retired_restore_map, dict)
                        and not candidate_hashes
                    )
                )
                or set(candidate_hashes) != set(hashes)
                or not isinstance(pre_apply, dict)
                or set(pre_apply) != set(hashes)
                or any(
                    not isinstance(key, str)
                    or not isinstance(value, str)
                    or not value
                    for key, value in pre_apply.items()
                )
                or not isinstance(compensated_value, str)
                or any(
                    not isinstance(event.get(field), str)
                    or not event.get(field)
                    for field in (
                        "event_id",
                        "source_repo",
                        "source_git_commit",
                        "manifest",
                        "manifest_sha256",
                        "target_root",
                        "backup_dir",
                    )
                )
            ):
                raise InstallSyncError(
                    "install mutation ledger is malformed: "
                    f"rollback event {event_id}"
                )
            if compensated_id and (
                by_id.get(compensated_id) is None
                or by_id[compensated_id].get("event_type")
                != "install_applied"
            ):
                raise InstallSyncError(
                    "install mutation ledger has unknown or forward "
                    f"rollback reference: {compensated_id}"
                )
            restored_retired_map = event.get(
                "restored_retired_target_sha256"
            )
            if restored_retired_map is not None:
                if not isinstance(restored_retired_map, dict) or any(
                    not isinstance(key, str)
                    or not isinstance(value, str)
                    or re.fullmatch(r"[0-9a-f]{64}", value) is None
                    for key, value in restored_retired_map.items()
                ):
                    raise InstallSyncError(
                        "install mutation ledger is malformed: "
                        f"rollback event {event_id}"
                    )
                for restored_rel in restored_retired_map:
                    retired_by_target.pop(restored_rel, None)
            resolved_pre_apply = {
                target_rel: resolve_pre_apply_source(
                    pre_apply_id,
                    target_rel,
                    hashes[target_rel],
                )
                for target_rel, pre_apply_id in pre_apply.items()
            }
            if compensated_id:
                applied = by_id.get(compensated_id)
                if (
                    applied is None
                    or applied.get("event_type") != "install_applied"
                ):
                    raise InstallSyncError(
                        "install mutation ledger has unknown or forward "
                        f"rollback reference: {compensated_id}"
                    )
                if compensated_id in compensated:
                    raise InstallSyncError(
                        "install mutation ledger has duplicate compensation: "
                        f"{compensated_id}"
                    )
                identity_fields = (
                    "target_root",
                    "backup_dir",
                    "manifest",
                    "manifest_sha256",
                )
                if any(
                    str(event.get(field) or "")
                    != str(applied.get(field) or "")
                    for field in identity_fields
                ) or candidate_hashes != applied.get("new_target_sha256"):
                    raise InstallSyncError(
                        "install mutation ledger rollback identity mismatch: "
                        f"{compensated_id}"
                    )
                applied_old = applied.get("old_target_sha256")
                applied_pre_apply = applied.get(
                    "pre_apply_effective_event_id_by_target"
                )
                if not isinstance(applied_old, dict) or not isinstance(
                    applied_pre_apply, dict
                ):
                    raise InstallSyncError(
                        "install mutation ledger rollback restored hash "
                        f"mismatch: {compensated_id}"
                    )
                missing_old = sorted(
                    set(applied_old) - set(hashes)
                )
                missing_pre_apply = sorted(
                    set(applied_pre_apply) - set(pre_apply)
                )
                if missing_old or missing_pre_apply or any(
                    hashes[target_rel] != recorded_hash
                    for target_rel, recorded_hash in applied_old.items()
                ) or any(
                    pre_apply.get(target_rel) != recorded_id
                    for target_rel, recorded_id in applied_pre_apply.items()
                ):
                    raise InstallSyncError(
                        "install mutation ledger rollback restored hash "
                        f"mismatch: {compensated_id}"
                    )
                compensated.add(compensated_id)
            expected_latest_id = compensated_id
            for target_rel, pre_apply_id in pre_apply.items():
                latest = latest_effective.get(target_rel)
                required_id = expected_latest_id or pre_apply_id
                if (
                    latest is None
                    or str(latest[0].get("event_id") or "")
                    != required_id
                ):
                    raise InstallSyncError(
                        "install mutation ledger rollback does not "
                        f"compensate latest effective event: {target_rel}"
                    )
        by_id[event_id] = event
        recognized.append(event)
        retired_map = event.get("retired_target_sha256")
        if retired_map is not None:
            if not isinstance(retired_map, dict) or any(
                not isinstance(key, str)
                or not isinstance(value, str)
                or re.fullmatch(r"[0-9a-f]{64}", value) is None
                for key, value in retired_map.items()
            ):
                raise InstallSyncError(
                    "install mutation ledger is malformed: "
                    f"retired_target_sha256 at recognized event {event_id}"
                )
            for retired_rel, removed_sha256 in retired_map.items():
                retired_by_target[retired_rel] = (event, removed_sha256)
        if event_type == "install_applied":
            for target_rel, recorded_sha256 in hashes.items():
                latest_effective[target_rel] = (
                    event,
                    recorded_sha256,
                )
        else:
            for target_rel, recorded_sha256 in hashes.items():
                latest_effective[target_rel] = (
                    resolved_pre_apply[target_rel],
                    recorded_sha256,
                )

    effective_events = [
        event
        for event in recognized
        if event.get("event_type") == "install_rolled_back"
        or str(event.get("event_id") or "") not in compensated
    ]
    latest_by_target = latest_effective
    for target_rel in latest_by_target:
        validate_historical_install_target(target_rel)
    for target_rel in retired_by_target:
        validate_historical_install_target(target_rel)
    return {
        "events": ordered,
        "recognized_events": recognized,
        "effective_events": effective_events,
        "events_by_id": by_id,
        "compensated_event_ids": compensated,
        "latest_by_target": latest_by_target,
        "retired_by_target": retired_by_target,
    }


def resolve_current_install_reference(
    manifest_path: Path | None = None,
    source_root: Path | None = None,
) -> dict[str, Any]:
    """Resolve the target set the current install manifest expects (#943).

    The reference exists only when the operator passes ``--manifest``; there
    is no implicit default-manifest or partial-ledger guessing. The manifest
    is expanded through the existing manifest machinery against the
    ``--source`` root (default: this copy's own repository root), and every
    manifest entry's source must actually resolve there - a direct entry
    whose source file is missing or a glob entry that matches nothing makes
    the reference ``unusable_source`` instead of silently shrinking the
    expected inventory. Without a manifest the reference is ``unavailable``.
    Both non-available origins keep the conservative all-ledger-targets drift
    behavior. The reference only separates "still expected by the current
    install" from "dropped from the install line without a retirement
    record"; it never marks a missing target as satisfied.
    """
    unavailable = {
        "origin": "unavailable",
        "manifest": "",
        "source": "",
        "targets": set(),
    }
    if manifest_path is None:
        return unavailable
    manifest_abs = manifest_path.resolve()
    source = (source_root if source_root is not None else REPO_ROOT).resolve()
    base = {
        "manifest": str(manifest_abs),
        "source": str(source),
    }
    if not source.is_dir():
        return {**base, "origin": "unusable_source", "targets": set()}
    manifest = read_manifest(manifest_path)
    for entry in manifest.get("files", []):
        if not isinstance(entry, dict):
            continue
        if str(entry.get("action") or "") == RETIRE_REQUESTED_ACTION:
            continue
        source_pattern = str(
            entry.get("source_path") or entry.get("source_rel") or ""
        )
        if not source_pattern:
            continue
        if has_glob(source_pattern):
            if not any(source.glob(source_pattern)):
                return {**base, "origin": "unusable_source", "targets": set()}
        elif not (source / source_pattern).is_file():
            return {**base, "origin": "unusable_source", "targets": set()}
    targets = {
        str(entry.get("target_rel") or "")
        for entry in expanded_manifest_entries(source, manifest)
        if str(entry.get("action") or "") != RETIRE_REQUESTED_ACTION
        and str(entry.get("target_rel") or "")
    }
    return {
        **base,
        "origin": "explicit_manifest",
        "targets": targets,
    }


def build_install_status(
    target_root: Path,
    manifest_path: Path | None = None,
    source_root: Path | None = None,
) -> dict[str, Any]:
    target = target_root.resolve()
    replay = replay_install_mutation_events(target)
    target_events = replay["recognized_events"]
    latest_by_target = replay["latest_by_target"]
    reference = resolve_current_install_reference(manifest_path, source_root)
    reference_targets = reference["targets"]
    reference_available = reference["origin"] == "explicit_manifest"

    retired_by_target_map = replay.get("retired_by_target", {})
    targets: list[dict[str, Any]] = []
    historical_missing_targets: list[dict[str, Any]] = []
    for target_rel in sorted(latest_by_target):
        if target_rel in retired_by_target_map:
            # Currently retired paths keep their prior install lineage in
            # replay for exact rollback, but they must not project an
            # installed-present parity expectation.
            continue
        event, recorded_sha256 = latest_by_target[target_rel]
        target_path = target / target_rel
        target_exists = target_path.is_file()
        current_sha256 = sha256_file(target_path) if target_exists else ""
        event_id = str(event.get("event_id") or "")
        source_repo = str(event.get("source_repo") or "")
        source_git_commit = str(event.get("source_git_commit") or "")
        parity = (
            target_exists
            and bool(recorded_sha256)
            and current_sha256 == recorded_sha256
        )
        provenance_complete = bool(
            event_id and source_repo and source_git_commit and recorded_sha256
        )
        current_reference_member = (
            (target_rel in reference_targets) if reference_available else None
        )
        targets.append(
            {
                "target_rel": target_rel,
                "target_path": str(target_path),
                "target_exists": target_exists,
                "installed_event_id": event_id,
                "installed_at": str(event.get("timestamp") or ""),
                "installed_source_repo": source_repo,
                "installed_source_git_commit": source_git_commit,
                "installed_source_git_dirty": bool(
                    event.get("source_git_dirty")
                ),
                "installed_manifest": str(event.get("manifest") or ""),
                "installed_backup_dir": str(event.get("backup_dir") or ""),
                "recorded_target_sha256": recorded_sha256,
                "current_target_sha256": current_sha256,
                "parity": parity,
                "current_reference_member": current_reference_member,
                "provenance_complete": provenance_complete,
                "attributed": parity and provenance_complete,
            }
        )
        if (
            reference_available
            and not target_exists
            and not current_reference_member
        ):
            # Absent from disk and absent from the current install reference
            # without a retirement record: unexplained historical absence,
            # kept distinguishable from both real current-manifest drift and
            # approved retirement (#943). It is never counted as satisfied.
            historical_missing_targets.append(
                {
                    "target_rel": target_rel,
                    "target_path": str(target_path),
                    "installed_event_id": event_id,
                    "installed_at": str(event.get("timestamp") or ""),
                    "installed_source_repo": source_repo,
                    "installed_source_git_commit": source_git_commit,
                    "installed_manifest": str(event.get("manifest") or ""),
                    "recorded_target_sha256": recorded_sha256,
                    "provenance_complete": provenance_complete,
                }
            )

    retired_targets_status: list[dict[str, Any]] = []
    for target_rel in sorted(replay.get("retired_by_target", {})):
        retired_event, removed_sha256 = replay["retired_by_target"][
            target_rel
        ]
        retired_path = target / target_rel
        retired_present = os.path.lexists(retired_path)
        retired_targets_status.append(
            {
                "target_rel": target_rel,
                "target_path": str(retired_path),
                "target_exists": retired_present,
                "retired_event_id": str(retired_event.get("event_id") or ""),
                "retired_at": str(retired_event.get("timestamp") or ""),
                "removed_target_sha256": removed_sha256,
                "absent_ok": not retired_present,
                "retired_source_repo": str(
                    retired_event.get("source_repo") or ""
                ),
                "retired_source_git_commit": str(
                    retired_event.get("source_git_commit") or ""
                ),
                "provenance_complete": bool(
                    str(retired_event.get("event_id") or "")
                    and str(retired_event.get("source_repo") or "")
                    and str(retired_event.get("source_git_commit") or "")
                    and removed_sha256
                ),
            }
        )

    retirement_expected_absent = all(
        bool(item["absent_ok"]) and bool(item["provenance_complete"])
        for item in retired_targets_status
    ) if retired_targets_status else True
    historical_missing_rels = {
        item["target_rel"] for item in historical_missing_targets
    }
    reference_without_install_record = (
        sorted(
            reference_targets
            - set(latest_by_target)
            - set(retired_by_target_map)
        )
        if reference_available
        else []
    )
    current_drift = bool(reference_without_install_record) or any(
        not bool(item["parity"])
        and item["target_rel"] not in historical_missing_rels
        for item in targets
    )
    member_targets = [
        item for item in targets if item["current_reference_member"]
    ]
    current_reference_parity = (
        reference_available
        and bool(reference_targets)
        and not reference_without_install_record
        and all(bool(item["parity"]) for item in member_targets)
        and retirement_expected_absent
    )
    overall_parity = (
        (bool(targets) or bool(retired_targets_status))
        and all(bool(item["parity"]) for item in targets)
        and not reference_without_install_record
        and retirement_expected_absent
    )
    if not targets and not retired_targets_status:
        provenance_status = "no_install_history"
    elif retired_targets_status and not targets:
        if reference_without_install_record:
            provenance_status = "runtime_drift"
        else:
            provenance_status = (
                "attributed"
                if retirement_expected_absent
                else "incomplete_provenance"
            )
    elif current_drift or not retirement_expected_absent:
        provenance_status = "runtime_drift"
    elif historical_missing_targets:
        provenance_status = "historical_unaccounted"
    elif not all(bool(item["provenance_complete"]) for item in targets):
        provenance_status = "incomplete_provenance"
    else:
        provenance_status = "attributed"
    return {
        "schema_version": 1,
        "generated_at": utc_now(),
        "mode": "status",
        "target": str(target),
        "event_log": str(install_event_log_path(target)),
        "install_event_count": len(target_events),
        "target_count": len(targets),
        "attributed_target_count": sum(
            1 for item in targets if item["attributed"]
        ),
        "provenance_status": provenance_status,
        "overall_parity": overall_parity,
        "current_reference": {
            "origin": reference["origin"],
            "manifest": reference["manifest"],
            "source": reference["source"],
            "target_count": len(reference_targets),
        },
        "current_reference_parity": current_reference_parity,
        "reference_targets_without_install_record": (
            reference_without_install_record
        ),
        "reference_targets_without_install_record_count": len(
            reference_without_install_record
        ),
        "historical_missing_count": len(historical_missing_targets),
        "historical_missing_targets": historical_missing_targets,
        "targets": targets,
        "retired_targets": retired_targets_status,
        "retired_count": len(retired_targets_status),
        "writes_target": False,
        "copies_files": False,
        "chmod": False,
        "live_smoke": False,
    }


def current_target_install_provenance(
    plan: dict[str, Any],
    events: list[dict[str, Any]],
) -> list[dict[str, Any]]:
    target_root = str(Path(str(plan.get("target") or "")).resolve())
    latest_by_target = replay_install_mutation_events(
        Path(target_root),
        events,
    )["latest_by_target"]
    provenance: list[dict[str, Any]] = []
    for item in plan.get("files", []):
        if (
            item.get("action") not in MUTATING_ACTIONS
            or not item.get("target_exists")
        ):
            continue
        target_rel = str(item.get("target_rel") or "")
        current_hash = str(item.get("target_sha256") or "")
        latest = latest_by_target.get(target_rel)
        matching_event = (
            latest[0]
            if latest is not None and latest[1] == current_hash
            else None
        )
        provenance.append(
            {
                "target_rel": target_rel,
                "current_target_sha256": current_hash,
                "history_found": latest is not None,
                "matching_event_found": matching_event is not None,
                "installed_event_id": str(
                    (matching_event or {}).get("event_id") or ""
                ),
                "installed_source_git_commit": str(
                    (matching_event or {}).get("source_git_commit") or ""
                ),
            }
        )
    return provenance


def validate_install_source_order(
    plan: dict[str, Any],
    provenance: list[dict[str, Any]],
    *,
    allow_stale_source: bool,
    reason: str,
) -> dict[str, Any]:
    normalized_reason = reason.strip()
    if normalized_reason and not allow_stale_source:
        raise InstallSyncError(
            "--stale-source-reason requires --allow-stale-source"
        )
    if allow_stale_source and not normalized_reason:
        raise InstallSyncError(
            "--allow-stale-source requires nonblank --stale-source-reason"
        )

    source_root = Path(str(plan.get("source") or "")).resolve()
    current_commit = str(plan.get("source_git_commit") or "")
    targets: list[dict[str, Any]] = []
    violations: list[str] = []
    for record in provenance:
        target_rel = record["target_rel"]
        target_decision = {
            **record,
            "ancestry_proven": None,
            "status": "bootstrap",
        }
        violation = ""
        installed_commit = record["installed_source_git_commit"]
        if record["history_found"] and not record["matching_event_found"]:
            target_decision["status"] = "unattributed"
            violation = f"{target_rel} current target hash is unattributed"
        elif record["history_found"] and (
            not installed_commit or not current_commit
        ):
            target_decision["status"] = "source_commit_unavailable"
            violation = (
                f"{target_rel} requires nonempty installed and current source commits"
            )
        elif record["history_found"]:
            try:
                ancestry_proven = subprocess.run(
                    [
                        "git",
                        "-C",
                        str(source_root),
                        "merge-base",
                        "--is-ancestor",
                        installed_commit,
                        current_commit,
                    ],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=5,
                    check=False,
                ).returncode == 0
            except (OSError, subprocess.TimeoutExpired):
                ancestry_proven = False
            target_decision["ancestry_proven"] = ancestry_proven
            target_decision["status"] = (
                "forward" if ancestry_proven else "stale_or_divergent"
            )
            if not ancestry_proven:
                violation = (
                    f"{target_rel} installed commit {installed_commit} "
                    f"is not an ancestor of current commit {current_commit}"
                )
        if violation:
            violations.append(violation)
        targets.append(target_decision)

    if violations and not allow_stale_source:
        raise InstallSyncError(
            "stale install source: " + "; ".join(violations)
        )
    return {
        "decision": "override" if violations else "allowed",
        "allow_stale_source": allow_stale_source,
        "stale_source_reason": normalized_reason,
        "source_git_commit": current_commit,
        "targets": targets,
    }


def latest_matching_install_mutation(
    result: dict[str, Any],
) -> dict[str, Any] | None:
    current_hashes = installed_target_sha256(result)
    replay = replay_install_mutation_events(Path(result["target"]))
    if not current_hashes:
        target_root = str(Path(str(result["target"])).resolve())
        for event in replay["recognized_events"]:
            if (
                event.get("event_type") == "install_applied"
                and str(event.get("target_root") or "") == target_root
                and str(event.get("manifest_sha256") or "")
                == str(result.get("manifest_sha256") or "")
                and str(event.get("source_git_commit") or "")
                == str(result.get("source_git_commit") or "")
            ):
                return event
        return None
    matching: dict[str, Any] | None = None
    for target_rel, current_hash in current_hashes.items():
        latest = replay["latest_by_target"].get(target_rel)
        if latest is None or latest[1] != current_hash:
            return None
        event = latest[0]
        if matching is None:
            matching = event
        elif event.get("event_id") != matching.get("event_id"):
            return None
    return matching


def persist_terminal_backup_status(
    backup_dir: Path,
    manifest: dict[str, Any],
) -> dict[str, Any]:
    try:
        write_backup_manifest(backup_dir, manifest)
    except Exception as exc:
        fallback = {
            **manifest,
            "journal_error": f"{type(exc).__name__}: {exc}",
            "status_path": str(backup_dir / "rollback-status.json"),
        }
        try:
            write_json_atomic(
                backup_dir / "rollback-status.json",
                fallback,
            )
        except Exception as fallback_exc:
            raise InstallSyncError(
                "terminal backup status persistence failed: "
                f"primary={type(exc).__name__}: {exc}; "
                f"fallback={type(fallback_exc).__name__}: {fallback_exc}"
            ) from fallback_exc
        return {
            "primary_written": False,
            "fallback_path": str(backup_dir / "rollback-status.json"),
            "journal_error": fallback["journal_error"],
        }
    return {
        "primary_written": True,
        "fallback_path": "",
        "journal_error": "",
    }


def apply_plan(
    plan: dict[str, Any],
    backup_dir: Path,
    *,
    pre_apply_effective_event_id_by_target: dict[str, str] | None = None,
    retain_created_anchors: bool = False,
    on_backup_prepared: Callable[[dict[str, Any]], None] | None = None,
) -> dict[str, Any]:
    require_source_files(plan)
    actor = install_actor()
    backup_root = backup_dir.resolve()
    target_root = Path(plan["target"]).resolve()
    backup_targets_root = backup_root / "targets"
    copied_targets: list[dict[str, Any]] = []
    backed_up_files: list[dict[str, Any]] = []
    committed_backups: list[dict[str, Any]] = []
    created_targets: list[dict[str, Any]] = []
    chmod_targets: list[dict[str, Any]] = []
    retired_targets: list[dict[str, Any]] = []
    retired_noop_targets: list[dict[str, Any]] = []

    update_items = plan_action_items(plan, {"would_update"})
    copy_items = plan_action_items(plan, {"would_update", "would_create"})
    chmod_items = plan_action_items(plan, {"would_chmod"})
    retire_items = plan_action_items(plan, {"would_retire"})
    retire_noop_items = plan_action_items(plan, {"retire_absent_noop"})
    retiring_target_rels = {
        str(item.get("target_rel") or "")
        for item in plan.get("files", [])
        if str(item.get("action") or "") in RETIRING_PLANNED_ACTIONS
    }
    for item in update_items:
        validate_install_target(str(item["target_rel"]))
    capacity_check = enforce_ordinary_apply_capacity(
        plan,
        backup_root,
        copy_items,
        actor,
    )

    planned_created_targets = [
        {
            "source_rel": item["source_rel"],
            "target_rel": item["target_rel"],
            "source_path": item["source_path"],
            "target_path": item["target_path"],
            "action": item["action"],
            "source_sha256": item.get("source_sha256", ""),
            "old_target_sha256": "",
            "new_target_sha256": item.get("source_sha256", ""),
            "source_mode": item.get("source_mode"),
            "old_target_mode": None,
            "new_target_mode": item.get("source_mode"),
        }
        for item in copy_items
        if item.get("action") == "would_create"
    ]
    planned_created_by_target = {
        record["target_rel"]: record
        for record in planned_created_targets
    }
    planned_chmod_targets = [
        {
            "source_rel": item["source_rel"],
            "target_rel": item["target_rel"],
            "target_path": item["target_path"],
            "old_target_mode": item.get("target_mode"),
            "new_target_mode": item.get("source_mode"),
            "target_identity": item.get("target_identity"),
        }
        for item in chmod_items
        if item.get("source_mode") is not None
    ]
    prepared_manifest = {
        "timestamp": utc_now(),
        "status": "prepared",
        "source_repo": plan["source"],
        "source_git_available": bool(plan.get("source_git_available")),
        "source_git_commit": str(plan.get("source_git_commit") or ""),
        "source_git_dirty": bool(plan.get("source_git_dirty")),
        "actor": actor,
        "manifest": plan["manifest"],
        "manifest_sha256": plan["manifest_sha256"],
        "target_root": str(target_root),
        "backed_up_files": backed_up_files,
        "created_targets": planned_created_targets,
        "copied_targets": [],
        "chmod_targets": planned_chmod_targets,
        "retired_targets": [],
        "retired_noop_targets": [],
        "source_sha256": {
            item["target_rel"]: item.get("source_sha256", "")
            for item in copy_items
        },
        "old_target_sha256": {
            item["target_rel"]: item.get("target_sha256", "")
            for item in copy_items
        },
        "new_target_sha256": {
            item["target_rel"]: item.get("source_sha256", "")
            for item in copy_items
        },
        "pre_apply_effective_event_id_by_target": {
            target_rel: event_id
            for target_rel, event_id in (
                pre_apply_effective_event_id_by_target or {}
            ).items()
            if target_rel not in retiring_target_rels
        },
        "capacity_check": capacity_check,
    }
    try:
        write_backup_manifest(backup_root, prepared_manifest)
        (backup_root / "rollback-status.json").unlink(missing_ok=True)
        if on_backup_prepared is not None:
            on_backup_prepared(prepared_manifest)
    except Exception as exc:
        raise InstallSyncError(
            f"backup journal preparation failed: {type(exc).__name__}: {exc}"
        ) from exc

    try:
        for item in copy_items:
            source_path = Path(item["source_path"])
            target_path = Path(item["target_path"])
            validate_install_record(str(item["source_rel"]), str(item["target_rel"]))
            update_preimage = None
            on_validated_backup = None
            on_update_committed = None
            on_created_target_identity_anchored = None
            if item.get("action") == "would_update":
                backup_path = (
                    backup_targets_root / str(item["target_rel"])
                )
                backup_record = {
                    "target_rel": item["target_rel"],
                    "target_path": str(target_path),
                    "backup_path": str(backup_path),
                    "old_target_sha256": item.get("target_sha256", ""),
                    "new_target_sha256": item.get("source_sha256", ""),
                    "old_target_mode": item.get("target_mode"),
                    "new_target_mode": item.get("source_mode"),
                    "commit_state": "validated",
                }
                update_preimage = {
                    "target_identity": item.get("target_identity"),
                    "target_sha256": item.get("target_sha256"),
                    "target_mode": item.get("target_mode"),
                    "backup_path": str(backup_path),
                }

                def record_validated_backup(
                    record: dict[str, Any] = backup_record,
                ) -> None:
                    backed_up_files.append(record)
                    write_backup_manifest(
                        backup_root,
                        prepared_manifest,
                    )

                on_validated_backup = record_validated_backup

                def record_committed_update(
                    installed_identity: dict[str, int],
                    record: dict[str, Any] = backup_record,
                ) -> None:
                    record["new_target_identity"] = installed_identity
                    record["commit_state"] = "committed"
                    committed_backups.append(record)
                    write_backup_manifest(
                        backup_root,
                        prepared_manifest,
                    )

                on_update_committed = record_committed_update
            if item.get("action") == "would_create":
                def record_created_target_identity_anchored(
                    staged_identity: dict[str, int],
                    anchor_target_path: str,
                    target_rel: str = item["target_rel"],
                    planned: dict[str, Any] = planned_created_by_target[
                        item["target_rel"]
                    ],
                ) -> None:
                    record = {
                        **planned,
                        "created_target_identity": staged_identity,
                        "created_target_anchor_path": anchor_target_path,
                    }
                    created_targets.append(record)
                    prepared_manifest["created_targets"] = created_targets
                    write_backup_manifest(
                        backup_root,
                        prepared_manifest,
                    )

                on_created_target_identity_anchored = (
                    record_created_target_identity_anchored
                )
            created_identity = atomic_copy2(
                source_path,
                target_path,
                overwrite=item.get("action") != "would_create",
                target_root=target_root,
                update_preimage=update_preimage,
                on_validated_backup=on_validated_backup,
                on_update_committed=on_update_committed,
                on_created_target_identity_anchored=on_created_target_identity_anchored,
                expected_source_sha256=str(
                    item.get("source_sha256") or ""
                ),
                expected_source_mode=item.get("source_mode"),
            )
            ownership: dict[str, Any] = {}
            if item.get("action") == "would_create":
                if created_identity is None:
                    raise InstallSyncError(
                        f"created target identity missing: {target_path}"
                    )
                ownership = {
                    "created_target_identity": {
                        "st_dev": created_identity[0],
                        "st_ino": created_identity[1],
                    },
                    "created_target_anchor_path": created_identity[2],
                }
            copied = {
                **manifest_record_for_copy(item),
                **ownership,
            }
            copied_targets.append(copied)
            if item.get("action") == "would_create":
                created_targets[-1] = copied

        for item in chmod_items:
            target_path = Path(item["target_path"])
            source_mode = item.get("source_mode")
            if source_mode is None:
                continue
            validate_install_record(str(item["source_rel"]), str(item["target_rel"]))
            new_target_mode, target_identity = chmod_regular_target(
                target_root,
                target_path,
                int(source_mode),
                expected_identity=item.get("target_identity"),
                expected_sha256=str(item.get("target_sha256") or ""),
                expected_mode=item.get("target_mode"),
            )
            chmod_targets.append(
                {
                    "source_rel": item["source_rel"],
                    "target_rel": item["target_rel"],
                    "target_path": str(target_path),
                    "old_target_mode": item.get("target_mode"),
                    "new_target_mode": new_target_mode,
                    "new_target_sha256": item.get("source_sha256", ""),
                    "target_identity": target_identity,
                }
            )
        for item in retire_items:
            record = stage_retire_regular_target(
                target_root,
                backup_root,
                item,
            )
            retired_targets.append(record)
            prepared_manifest["retired_targets"] = retired_targets
            write_backup_manifest(backup_root, prepared_manifest)
            record = commit_retire_regular_target(
                target_root,
                item,
                record,
            )
            retired_targets[-1] = record
            prepared_manifest["retired_targets"] = retired_targets
            write_backup_manifest(backup_root, prepared_manifest)
        for item in retire_noop_items:
            noop_path = Path(str(item.get("target_path") or ""))
            if os.path.lexists(noop_path):
                raise InstallSyncError(
                    f"retire noop target appeared after plan: {noop_path}"
                )
            retired_noop_targets.append(
                {
                    "source_rel": str(item.get("source_rel") or ""),
                    "target_rel": str(item.get("target_rel") or ""),
                    "target_path": str(noop_path),
                    "action": "retire_absent_noop",
                }
            )
        backup_manifest = {
            **prepared_manifest,
            "status": "applied",
            "created_targets": created_targets,
            "copied_targets": copied_targets,
            "chmod_targets": chmod_targets,
            "retired_targets": retired_targets,
            "retired_noop_targets": retired_noop_targets,
            "source_sha256": {
                item["target_rel"]: item.get("source_sha256", "")
                for item in copied_targets
            },
            "old_target_sha256": {
                item["target_rel"]: item.get("old_target_sha256", "")
                for item in copied_targets
            },
            "new_target_sha256": {
                item["target_rel"]: item.get("new_target_sha256", "")
                for item in copied_targets
            },
            "removed_target_sha256": {
                str(record.get("target_rel") or ""): str(
                    record.get("removed_target_sha256") or ""
                )
                for record in retired_targets
            },
        }
        write_backup_manifest(backup_root, backup_manifest)
    except Exception as exc:
        apply_error = f"{type(exc).__name__}: {exc}"
        try:
            rollback_result = rollback_backup(
                target_root,
                backup_root,
                created_targets=created_targets,
                backed_up_files=committed_backups,
                chmod_targets=chmod_targets,
                retired_targets=retired_targets,
                journal=prepared_manifest,
            )
            if isinstance(exc, ChmodRollbackError):
                raise exc
        except Exception as rollback_exc:
            failed_manifest = {
                **prepared_manifest,
                "status": "rollback_failed",
                "apply_error": apply_error,
                "created_targets": created_targets,
                "copied_targets": copied_targets,
                "chmod_targets": chmod_targets,
                "retired_targets": retired_targets,
                "retired_noop_targets": retired_noop_targets,
                "rollback_error": (
                    f"{type(rollback_exc).__name__}: {rollback_exc}"
                ),
            }
            try:
                terminal_status = persist_terminal_backup_status(
                    backup_root,
                    failed_manifest,
                )
            except InstallSyncError as status_exc:
                raise InstallSyncError(
                    "apply failed and rollback failed; "
                    f"terminal status persistence failed: {status_exc}"
                ) from status_exc
            fallback_note = (
                "; fallback status recorded"
                if not terminal_status["primary_written"]
                else ""
            )
            raise InstallSyncError(
                "apply failed and rollback failed: "
                f"{apply_error}; {failed_manifest['rollback_error']}"
                f"{fallback_note}"
            ) from rollback_exc
        rolled_back_manifest = {
            **prepared_manifest,
            "status": "rolled_back",
            "apply_error": apply_error,
            "created_targets": created_targets,
            "copied_targets": copied_targets,
            "chmod_targets": chmod_targets,
            "retired_targets": retired_targets,
            "retired_noop_targets": retired_noop_targets,
            "rollback_result": rollback_result,
        }
        try:
            terminal_status = persist_terminal_backup_status(
                backup_root,
                rolled_back_manifest,
            )
        except InstallSyncError as status_exc:
            raise InstallSyncError(
                "apply failed; rollback completed; "
                f"terminal status persistence failed: {status_exc}"
            ) from status_exc
        fallback_note = (
            "; fallback status recorded"
            if not terminal_status["primary_written"]
            else ""
        )
        raise InstallSyncError(
            f"apply failed; rollback completed: {apply_error}"
            f"{fallback_note}"
        ) from exc

    action_counts: dict[str, int] = {}
    for item in copied_targets:
        action = str(item.get("action") or "")
        action_counts[action] = action_counts.get(action, 0) + 1

    result = {
        **plan,
        "mode": "apply",
        "dry_run": False,
        "dry_run_only": False,
        "writes_target": True,
        "copies_files": bool(copied_targets),
        "chmod": bool(chmod_targets),
        "live_smoke": False,
        "backup_dir": str(backup_root),
        "backup_manifest": str(backup_root / "backup-manifest.json"),
        "actor": actor,
        "items": plan["files"],
        "copied_targets": copied_targets,
        "backed_up_files": backed_up_files,
        "created_targets": created_targets,
        "copied_count": len(copied_targets),
        "backup_count": len(backed_up_files),
        "created_count": action_counts.get("would_create", 0),
        "updated_count": action_counts.get("would_update", 0),
        "chmod_count": len(chmod_targets),
        "chmod_targets": chmod_targets,
        "retired_targets": retired_targets,
        "retired_noop_targets": retired_noop_targets,
        "retired_count": len(retired_targets),
        "retired_noop_count": len(retired_noop_targets),
        "pre_apply_effective_event_id_by_target": (
            pre_apply_effective_event_id_by_target or {}
        ),
    }
    if not retain_created_anchors:
        cleanup_created_target_anchors(target_root, created_targets)
    return result


def resolve_dispatchable_smoke_worker(target_root: Path) -> str:
    dispatch = target_root / "bin" / "omx_visible_dispatch"
    if not dispatch.is_file():
        return ""
    try:
        result = subprocess.run(
            [
                str(dispatch),
                "status",
                "--root",
                str(target_root),
                "--include-pool-readiness",
                "--json",
            ],
            cwd=str(target_root),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=20,
            check=False,
        )
        payload = json.loads(result.stdout) if result.returncode == 0 else {}
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return ""
    workers = payload.get("dispatchable_visible_workers", []) if isinstance(payload, dict) else []
    for worker in workers:
        worker_id = str(worker.get("worker_id") or "").strip() if isinstance(worker, dict) else str(worker).strip()
        if worker_id:
            return worker_id
    return ""


def run_post_install_smoke(
    target_root: Path,
    *,
    timeout: int = 90,
    full_validate: bool = False,
    worker_id: str = "",
    profile: str = "default",
) -> dict[str, Any]:
    target_root = target_root.resolve()
    if profile not in POST_INSTALL_SMOKE_PROFILES:
        raise InstallSyncError(
            "unsupported post-install smoke profile: " + str(profile)
        )
    if profile == "offline_bootstrap":
        commands = [
            {
                "name": name + "_help",
                "argv": [str(target_root / "bin" / name), "--help"],
                "required": True,
                "failure_domain": "post_install_validation",
            }
            for name in sorted(ALLOWED_BIN_NAMES)
        ]
        worker_id = ""
    elif profile == "control_plane_only":
        commands = [
            {
                "name": "install_sync_help",
                "argv": [
                    str(target_root / "bin" / "omx_install_sync"),
                    "--help",
                ],
                "required": True,
                "failure_domain": "post_install_validation",
            },
            {
                "name": "opencode_tui_adapter_help",
                "argv": [
                    str(target_root / "bin" / "omx_opencode_tui_adapter"),
                    "--help",
                ],
                "required": True,
                "failure_domain": "post_install_validation",
            },
            {
                "name": "visible_dispatch_help",
                "argv": [
                    str(target_root / "bin" / "omx_visible_dispatch"),
                    "--help",
                ],
                "required": True,
                "failure_domain": "post_install_validation",
            },
            {
                "name": "visible_task_state_help",
                "argv": [
                    str(target_root / "bin" / "omx_visible_task_state.py"),
                    "--help",
                ],
                "required": True,
                "failure_domain": "post_install_validation",
            },
        ]
        rebind = target_root / "bin" / "omx_visible_rebind"
        if rebind.is_file():
            commands.append({
                "name": "visible_rebind_help",
                "argv": [str(rebind), "--help"],
                "required": True,
                "failure_domain": "post_install_validation",
            })
        worker_id = ""
    elif profile == "launcher_bootstrap":
        commands = [{
            "name": "opencode_visible_launcher_help",
            "argv": [str(target_root / "bin" / "omx_opencode_visible_launcher"), "--help"],
            "required": True,
            "failure_domain": "post_install_validation",
        }]
        worker_id = ""
    elif profile == "provision_bootstrap":
        commands = [
            {
                "name": "visible_orchestrate_help",
                "argv": [
                    str(target_root / "bin" / "omx_visible_orchestrate"),
                    "--help",
                ],
                "required": True,
                "failure_domain": "post_install_validation",
            },
            {
                "name": "opencode_visible_launcher_help",
                "argv": [
                    str(
                        target_root
                        / "bin"
                        / "omx_opencode_visible_launcher"
                    ),
                    "--help",
                ],
                "required": True,
                "failure_domain": "post_install_validation",
            },
        ]
        worker_id = ""
    elif profile == "clean_room_startup":
        node = shutil.which("node") or "node"
        commands = [
            {
                "name": "visible_dispatch_help",
                "argv": [
                    str(target_root / "bin" / "omx_visible_dispatch"),
                    "--help",
                ],
                "required": True,
                "failure_domain": "post_install_validation",
            },
            {
                "name": "opencode_tui_adapter_help",
                "argv": [
                    str(target_root / "bin" / "omx_opencode_tui_adapter"),
                    "--help",
                ],
                "required": True,
                "failure_domain": "post_install_validation",
            },
            {
                "name": "opencode_visible_launcher_help",
                "argv": [
                    str(
                        target_root
                        / "bin"
                        / "omx_opencode_visible_launcher"
                    ),
                    "--help",
                ],
                "required": True,
                "failure_domain": "post_install_validation",
            },
            {
                "name": "clean_room_startup_plugin_syntax",
                "argv": [
                    node,
                    "--check",
                    str(
                        target_root
                        / "lib"
                        / "visible_agent_orchestrator"
                        / "opencode_plugins"
                        / "omx-clean-room-startup-gate.mjs"
                    ),
                ],
                "required": True,
                "failure_domain": "post_install_validation",
            },
        ]
        worker_id = ""
    else:
        commands = []
    explicit_worker_id = str(worker_id or "").strip()
    worker_id = (
        explicit_worker_id
        or resolve_dispatchable_smoke_worker(target_root)
    ) if profile == "default" else ""
    if profile == "default":
        commands.append(
            {
                "name": "visible_watcher_alerts",
                "argv": [
                    str(target_root / "bin" / "omx_visible_watcher"),
                    "alerts",
                    "--root",
                    str(target_root),
                    "--recent-runs",
                    str(POST_INSTALL_SMOKE_WATCHER_RECENT_RUNS),
                ],
                "required": True,
                "failure_domain": "post_install_validation",
            }
        )
    policy_path = target_root / "bin" / "omx_visible_policy_check"
    if profile == "default" and policy_path.is_file():
        if full_validate and not explicit_worker_id:
            commands.append(
                {
                    "name": "visible_policy_check",
                    "argv": [
                        str(policy_path),
                        "check",
                        "--root",
                        str(target_root),
                        "--json",
                    ],
                    "required": True,
                    "failure_domain": "post_install_validation",
                }
            )
        if full_validate and not explicit_worker_id:
            commands.append(
                {
                    "name": "visible_policy_backend_audit",
                    "argv": [
                        str(policy_path),
                        "backend-audit",
                        "--root",
                        str(target_root),
                        "--backend",
                        "tmux-reference",
                        "--json",
                    ],
                    "required": True,
                    "failure_domain": "post_install_validation",
                }
            )
    if profile == "default" and worker_id:
        commands.extend(
            [
                {
                    "name": "visible_dispatch_doctor",
                    "argv": [
                        str(target_root / "bin" / "omx_visible_dispatch"),
                        "doctor",
                        "--compact",
                        "--root",
                        str(target_root),
                        "--worker",
                        worker_id,
                        "--backend",
                        "tmux-reference",
                    ],
                    "required": True,
                    "failure_domain": "worker_pool_health",
                },
                {
                    "name": "visible_health_check",
                    "argv": [
                        str(target_root / "bin" / "omx_visible_health"),
                        "check",
                        "--root",
                        str(target_root),
                        "--worker",
                        worker_id,
                        "--runtime-backend",
                        "tmux-reference",
                    ],
                    "required": True,
                    "failure_domain": "worker_pool_health",
                },
                {
                    "name": "visible_rebind_check",
                    "argv": [
                        str(target_root / "bin" / "omx_visible_rebind"),
                        "check",
                        "--root",
                        str(target_root),
                        "--worker",
                        worker_id,
                        "--runtime-backend",
                        "tmux-reference",
                    ],
                    "required": True,
                    "failure_domain": "worker_pool_health",
                },
            ]
        )
        orchestrate_path = target_root / "bin" / "omx_visible_orchestrate"
        if orchestrate_path.is_file():
            commands.append(
                {
                    "name": "visible_orchestrate_plan",
                    "argv": [
                        str(orchestrate_path),
                        "plan",
                        "--root",
                        str(target_root),
                        "--worker",
                        worker_id,
                        "--title",
                        f"install smoke {worker_id}",
                        "--body",
                        "read-only smoke body",
                        "--session-action",
                        "keep",
                        "--session-action-reason",
                        "post_install_smoke",
                        "--json",
                    ],
                    "required": True,
                    "failure_domain": "worker_pool_health",
                }
            )

    results: list[dict[str, Any]] = []
    smoke_warnings: list[str] = []
    smoke_ok = True
    if profile == "default" and not worker_id:
        results.append(
            {
                "name": "visible_smoke_worker_selection",
                "argv": [],
                "returncode": 1,
                "stdout": "",
                "stderr": (
                    "no current-window dispatchable smoke worker; pass "
                    "--smoke-worker only after its rebind check passes"
                ),
                "timed_out": False,
                "ok": False,
                "required": True,
                "failure_domain": "worker_pool_health",
            }
        )
        smoke_warnings.append("post_smoke_no_current_window_worker")
        smoke_ok = False
    for command in commands:
        argv = command["argv"]
        script_path = Path(argv[0])
        if not script_path.is_file():
            results.append(
                {
                    "name": command["name"],
                    "argv": argv,
                    "skipped": True,
                    "reason": f"missing command: {script_path}",
                    "required": bool(command.get("required")),
                    "failure_domain": str(command.get("failure_domain") or ""),
                }
            )
            if command.get("required"):
                smoke_ok = False
            continue
        try:
            proc = subprocess.run(
                argv,
                cwd=str(target_root),
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=timeout,
                check=False,
            )
            result = {
                "name": command["name"],
                "argv": argv,
                "returncode": proc.returncode,
                "stdout": proc.stdout,
                "stderr": proc.stderr,
                "timed_out": False,
                "ok": proc.returncode == 0,
                "required": bool(command.get("required")),
                "failure_domain": str(command.get("failure_domain") or ""),
            }
        except subprocess.TimeoutExpired as exc:
            result = {
                "name": command["name"],
                "argv": argv,
                "returncode": 124,
                "stdout": exc.stdout or "",
                "stderr": exc.stderr or "command timed out",
                "timed_out": True,
                "ok": False,
                "required": bool(command.get("required")),
                "failure_domain": str(command.get("failure_domain") or ""),
            }
            smoke_warnings.append(f"post_smoke_timeout:{command['name']}:{timeout}s")
        results.append(result)
        if not result["ok"] and command.get("required"):
            smoke_ok = False
    smoke_failure_domains = sorted(
        {
            str(item.get("failure_domain") or "")
            for item in results
            if bool(item.get("required")) and not bool(item.get("ok"))
        }
        - {""}
    )
    return {
        "smoke_requested": True,
        "smoke_ok": smoke_ok,
        "smoke_mode": (
            "targeted"
            if profile != "default"
            else ("full_validate" if full_validate else "quick")
        ),
        "smoke_profile": profile,
        "smoke_timeout_seconds": int(timeout),
        "smoke_worker": worker_id,
        "smoke_results": results,
        "smoke_warnings": smoke_warnings,
        "smoke_failure_domains": smoke_failure_domains,
    }


def load_backup_manifest(backup_dir: Path) -> dict[str, Any]:
    backup_root = backup_dir.resolve()
    manifest_path = backup_root / "backup-manifest.json"
    try:
        data = json.loads(manifest_path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise InstallSyncError(f"backup manifest missing: {manifest_path}") from exc
    except json.JSONDecodeError as exc:
        raise InstallSyncError(f"backup manifest invalid: {manifest_path}: {exc}") from exc
    if not isinstance(data, dict):
        raise InstallSyncError(f"backup manifest must be a JSON object: {manifest_path}")
    fallback_path = backup_root / "rollback-status.json"
    if fallback_path.is_file():
        try:
            fallback = json.loads(
                fallback_path.read_text(encoding="utf-8")
            )
        except json.JSONDecodeError as exc:
            raise InstallSyncError(
                f"rollback status invalid: {fallback_path}: {exc}"
            ) from exc
        if not isinstance(fallback, dict):
            raise InstallSyncError(
                f"rollback status must be a JSON object: {fallback_path}"
            )
        data.update(fallback)
    return data


def read_json_object_snapshot(
    path: Path,
    *,
    missing_error: str,
    invalid_error: str,
) -> tuple[dict[str, Any], dict[str, Any]]:
    parent_descriptor = os.open(
        path.parent,
        os.O_RDONLY
        | os.O_DIRECTORY
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_CLOEXEC", 0),
    )
    descriptor = -1
    try:
        parent_observed = os.fstat(parent_descriptor)
        try:
            descriptor = os.open(
                path.name,
                os.O_RDONLY
                | getattr(os, "O_NOFOLLOW", 0)
                | getattr(os, "O_NONBLOCK", 0)
                | getattr(os, "O_CLOEXEC", 0),
                dir_fd=parent_descriptor,
            )
        except FileNotFoundError as exc:
            raise InstallSyncError(missing_error) from exc
        observed = os.fstat(descriptor)
        if not stat.S_ISREG(observed.st_mode):
            raise InstallSyncError(invalid_error)
        offset = os.lseek(descriptor, 0, os.SEEK_CUR)
        try:
            os.lseek(descriptor, 0, os.SEEK_SET)
            raw = b"".join(
                iter(
                    lambda: os.read(descriptor, 1024 * 1024),
                    b"",
                )
            )
        finally:
            os.lseek(descriptor, offset, os.SEEK_SET)
        digest = hashlib.sha256(raw).hexdigest()
        identity = {
            "st_dev": observed.st_dev,
            "st_ino": observed.st_ino,
        }
        verify_open_regular_entry(
            descriptor,
            parent_descriptor,
            path.name,
            expected_identity=identity,
            expected_sha256=digest,
            expected_mode=stat.S_IMODE(observed.st_mode),
            error=invalid_error,
        )
        try:
            data = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise InstallSyncError(f"{invalid_error}: {exc}") from exc
        if not isinstance(data, dict):
            raise InstallSyncError(invalid_error)
        return data, {
            "path": str(path),
            "parent_identity": {
                "st_dev": parent_observed.st_dev,
                "st_ino": parent_observed.st_ino,
            },
            "identity": identity,
            "sha256": digest,
            "mode": stat.S_IMODE(observed.st_mode),
        }
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        os.close(parent_descriptor)


def load_backup_manifest_snapshot(
    backup_dir: Path,
) -> tuple[dict[str, Any], dict[str, Any]]:
    backup_root = backup_dir.resolve()
    manifest_path = backup_root / "backup-manifest.json"
    data, primary = read_json_object_snapshot(
        manifest_path,
        missing_error=f"backup manifest missing: {manifest_path}",
        invalid_error=f"backup manifest invalid: {manifest_path}",
    )
    entries = [primary]
    fallback_path = backup_root / "rollback-status.json"
    fallback_present = fallback_path.is_file()
    if fallback_present:
        fallback, fallback_snapshot = read_json_object_snapshot(
            fallback_path,
            missing_error=f"rollback status missing: {fallback_path}",
            invalid_error=f"rollback status invalid: {fallback_path}",
        )
        data.update(fallback)
        entries.append(fallback_snapshot)
    return data, {
        "entries": entries,
        "fallback_path": str(fallback_path),
        "fallback_present": fallback_present,
    }


def verify_backup_manifest_snapshot(snapshot: dict[str, Any]) -> None:
    entries = snapshot.get("entries")
    if not isinstance(entries, list) or not entries:
        raise InstallSyncError(
            "backup manifest snapshot invalid before rollback"
        )
    for entry in entries:
        if (
            not isinstance(entry, dict)
            or not isinstance(entry.get("parent_identity"), dict)
            or not isinstance(entry.get("identity"), dict)
            or type(entry.get("mode")) is not int
            or len(str(entry.get("sha256") or "")) != 64
        ):
            raise InstallSyncError(
                "backup manifest snapshot invalid before rollback"
            )
        path = Path(str(entry.get("path") or ""))
        parent_descriptor = -1
        descriptor = -1
        try:
            parent_descriptor = os.open(
                path.parent,
                os.O_RDONLY
                | os.O_DIRECTORY
                | getattr(os, "O_NOFOLLOW", 0)
                | getattr(os, "O_CLOEXEC", 0),
            )
            parent_observed = os.fstat(parent_descriptor)
            if {
                "st_dev": parent_observed.st_dev,
                "st_ino": parent_observed.st_ino,
            } != entry["parent_identity"]:
                raise InstallSyncError(
                    "backup manifest changed after validation"
                )
            descriptor = os.open(
                path.name,
                os.O_RDONLY
                | getattr(os, "O_NOFOLLOW", 0)
                | getattr(os, "O_NONBLOCK", 0)
                | getattr(os, "O_CLOEXEC", 0),
                dir_fd=parent_descriptor,
            )
            verify_open_regular_entry(
                descriptor,
                parent_descriptor,
                path.name,
                expected_identity=entry["identity"],
                expected_sha256=str(entry["sha256"]),
                expected_mode=int(entry["mode"]),
                error="backup manifest changed after validation",
            )
        except OSError as exc:
            raise InstallSyncError(
                "backup manifest changed after validation"
            ) from exc
        finally:
            if descriptor >= 0:
                os.close(descriptor)
            if parent_descriptor >= 0:
                os.close(parent_descriptor)
    fallback_path = Path(str(snapshot.get("fallback_path") or ""))
    fallback_present = bool(snapshot.get("fallback_present"))
    if fallback_path.is_file() != fallback_present:
        raise InstallSyncError(
            "backup manifest changed after validation"
        )


@contextmanager
def opened_validated_backup_directory(
    backup_dir: Path,
    snapshot: dict[str, Any],
):
    entries = snapshot.get("entries")
    primary = entries[0] if isinstance(entries, list) and entries else None
    if (
        not isinstance(primary, dict)
        or not isinstance(primary.get("parent_identity"), dict)
        or type(primary.get("mode")) is not int
    ):
        raise InstallSyncError(
            "backup manifest snapshot invalid before rollback"
        )
    backup_root = Path(str(primary.get("path") or "")).parent
    if backup_root != backup_dir.resolve():
        raise InstallSyncError(
            "backup manifest changed after validation"
        )
    descriptor = os.open(
        backup_root,
        os.O_RDONLY
        | os.O_DIRECTORY
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_CLOEXEC", 0),
    )
    try:
        observed = os.fstat(descriptor)
        identity = {
            "st_dev": observed.st_dev,
            "st_ino": observed.st_ino,
        }
        if (
            not stat.S_ISDIR(observed.st_mode)
            or identity != primary["parent_identity"]
        ):
            raise InstallSyncError(
                "backup manifest changed after validation"
            )
        yield {
            "descriptor": descriptor,
            "path": backup_root,
            "identity": identity,
            "manifest_mode": int(primary["mode"]),
        }
    finally:
        os.close(descriptor)


def write_terminal_backup_manifest(
    retained: dict[str, Any],
    manifest: dict[str, Any],
) -> None:
    parent_descriptor = int(retained["descriptor"])
    backup_root = Path(retained["path"])
    expected_parent_identity = retained["identity"]
    expected_mode = int(retained["manifest_mode"])
    parent_observed = os.fstat(parent_descriptor)
    if (
        not stat.S_ISDIR(parent_observed.st_mode)
        or {
            "st_dev": parent_observed.st_dev,
            "st_ino": parent_observed.st_ino,
        }
        != expected_parent_identity
    ):
        raise InstallSyncError(
            "validated backup directory changed during terminal persistence"
        )

    name = "backup-manifest.json"
    temp_name = f".{name}.{uuid.uuid4().hex}.tmp"
    raw = json.dumps(
        manifest,
        indent=2,
        sort_keys=True,
        ensure_ascii=False,
    ).encode("utf-8")
    digest = hashlib.sha256(raw).hexdigest()
    descriptor = os.open(
        temp_name,
        os.O_RDWR
        | os.O_CREAT
        | os.O_EXCL
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_CLOEXEC", 0),
        0o600,
        dir_fd=parent_descriptor,
    )
    renamed = False
    try:
        view = memoryview(raw)
        while view:
            view = view[os.write(descriptor, view):]
        os.fchmod(descriptor, expected_mode)
        os.fsync(descriptor)
        observed = os.fstat(descriptor)
        identity = {
            "st_dev": observed.st_dev,
            "st_ino": observed.st_ino,
        }
        verify_open_regular_entry(
            descriptor,
            parent_descriptor,
            temp_name,
            expected_identity=identity,
            expected_sha256=digest,
            expected_mode=expected_mode,
            error="terminal rollback journal staging changed",
        )
        os.replace(
            temp_name,
            name,
            src_dir_fd=parent_descriptor,
            dst_dir_fd=parent_descriptor,
        )
        renamed = True
        os.fsync(parent_descriptor)
        verify_open_regular_entry(
            descriptor,
            parent_descriptor,
            name,
            expected_identity=identity,
            expected_sha256=digest,
            expected_mode=expected_mode,
            error="terminal rollback journal commit changed",
        )
    finally:
        os.close(descriptor)
        if not renamed:
            try:
                os.unlink(temp_name, dir_fd=parent_descriptor)
            except FileNotFoundError:
                pass

    try:
        current = os.stat(backup_root, follow_symlinks=False)
    except OSError as exc:
        raise InstallSyncError(
            "validated backup directory changed during terminal persistence"
        ) from exc
    if (
        not stat.S_ISDIR(current.st_mode)
        or {
            "st_dev": current.st_dev,
            "st_ino": current.st_ino,
        }
        != expected_parent_identity
    ):
        raise InstallSyncError(
            "validated backup directory changed during terminal persistence"
        )


def target_path_from_manifest_record(target_root: Path, record: dict[str, Any]) -> Path:
    target_rel = str(record.get("target_rel") or "")
    if not target_rel:
        target_path = Path(str(record.get("target_path") or "")).resolve()
        try:
            target_rel = target_path.relative_to(target_root).as_posix()
        except ValueError as exc:
            raise InstallSyncError(f"backup target outside target root: {target_path}") from exc
    validate_install_target(target_rel)
    return target_root / target_rel


def created_target_identity(
    record: dict[str, Any],
) -> tuple[int, int] | None:
    identity = record.get("created_target_identity")
    if not isinstance(identity, dict):
        return None
    expected_dev = identity.get("st_dev")
    expected_ino = identity.get("st_ino")
    if type(expected_dev) is not int or type(expected_ino) is not int:
        return None
    return expected_dev, expected_ino


def validated_created_target_anchor(
    target_root: Path,
    target_path: Path,
    record: dict[str, Any],
) -> Path | None:
    identity = created_target_identity(record)
    anchor_value = record.get("created_target_anchor_path")
    if identity is None or not isinstance(anchor_value, str) or not anchor_value:
        return None
    anchor = Path(anchor_value)
    target_parent = target_path.parent.resolve()
    try:
        target_parent.relative_to(target_root)
    except ValueError as exc:
        raise InstallSyncError(
            f"created target parent outside target root: {target_parent}"
        ) from exc
    if (
        not anchor.is_absolute()
        or anchor.name != target_path.name
        or anchor.parent.parent.resolve() != target_parent
        or not anchor.parent.name.startswith(
            f".{target_path.name}.anchor-"
        )
    ):
        raise InstallSyncError(
            f"created target anchor path invalid: {anchor}"
        )
    anchor_dir = anchor.parent
    try:
        anchor_dir_stat = anchor_dir.lstat()
    except FileNotFoundError:
        return None
    if (
        not stat.S_ISDIR(anchor_dir_stat.st_mode)
        or stat.S_IMODE(anchor_dir_stat.st_mode) & 0o077
    ):
        raise InstallSyncError(
            f"created target anchor directory invalid: {anchor_dir}"
        )
    try:
        observed = anchor.lstat()
    except FileNotFoundError:
        return None
    if (
        not stat.S_ISREG(observed.st_mode)
        or (observed.st_dev, observed.st_ino) != identity
    ):
        raise InstallSyncError(
            f"created target anchor identity invalid: {anchor}"
        )
    return anchor


def cleanup_created_target_anchors(
    target_root: Path,
    records: list[dict[str, Any]],
) -> None:
    for record in records:
        if not isinstance(record, dict):
            continue
        target_path = target_path_from_manifest_record(target_root, record)
        with opened_target_parent(
            target_root,
            target_path,
            create_parents=False,
        ) as (
            parent_fd,
            target_name,
            verify_identity,
        ):
            anchor = validated_created_target_anchor(
                target_root,
                target_path,
                record,
            )
            if anchor is None:
                continue
            verify_identity()
            anchor_dir_name = anchor.parent.name
            anchor_fd = os.open(
                anchor_dir_name,
                os.O_RDONLY
                | os.O_DIRECTORY
                | getattr(os, "O_NOFOLLOW", 0),
                dir_fd=parent_fd,
            )
            try:
                os.unlink(target_name, dir_fd=anchor_fd)
            finally:
                os.close(anchor_fd)
            os.rmdir(anchor_dir_name, dir_fd=parent_fd)


def rollback_created_target(
    target_root: Path,
    target_path: Path,
    record: dict[str, Any],
) -> dict[str, Any] | None:
    identity = created_target_identity(record)
    anchor = validated_created_target_anchor(
        target_root,
        target_path,
        record,
    )
    expected_sha = str(record.get("new_target_sha256") or "")
    if identity is None or anchor is None or not expected_sha:
        return None

    with opened_target_parent(target_root, target_path) as (
        parent_fd,
        target_name,
        verify_identity,
    ):
        anchor_dir_name = anchor.parent.name
        anchor_fd = os.open(
            anchor_dir_name,
            os.O_RDONLY
            | os.O_DIRECTORY
            | getattr(os, "O_NOFOLLOW", 0),
            dir_fd=parent_fd,
        )
        quarantine_name = ""
        quarantine_fd = -1
        try:
            anchor_observed = os.stat(
                target_name,
                dir_fd=anchor_fd,
                follow_symlinks=False,
            )
            if (
                not stat.S_ISREG(anchor_observed.st_mode)
                or (
                    anchor_observed.st_dev,
                    anchor_observed.st_ino,
                ) != identity
            ):
                raise InstallSyncError(
                    f"created target anchor identity invalid: {anchor}"
                )
            quarantine_proc = Path(
                tempfile.mkdtemp(
                    prefix=f".{target_name}.rollback-",
                    dir=f"/proc/self/fd/{parent_fd}",
                )
            )
            quarantine_name = quarantine_proc.name
            quarantine_path = (
                target_path.parent / quarantine_name / target_name
            )
            quarantine_fd = os.open(
                quarantine_name,
                os.O_RDONLY
                | os.O_DIRECTORY
                | getattr(os, "O_NOFOLLOW", 0),
                dir_fd=parent_fd,
            )
            quarantine_stat = os.fstat(quarantine_fd)
            if (
                not stat.S_ISDIR(quarantine_stat.st_mode)
                or stat.S_IMODE(quarantine_stat.st_mode) & 0o077
            ):
                raise InstallSyncError(
                    f"created target quarantine path invalid: "
                    f"{quarantine_path.parent}"
                )
            verify_identity()
            try:
                os.replace(
                    target_name,
                    target_name,
                    src_dir_fd=parent_fd,
                    dst_dir_fd=quarantine_fd,
                )
            except FileNotFoundError:
                os.unlink(target_name, dir_fd=anchor_fd)
                os.rmdir(anchor_dir_name, dir_fd=parent_fd)
                os.close(quarantine_fd)
                quarantine_fd = -1
                os.rmdir(quarantine_name, dir_fd=parent_fd)
                return None

            quarantined_descriptor = -1
            try:
                try:
                    quarantined_descriptor = os.open(
                        target_name,
                        os.O_RDONLY
                        | getattr(os, "O_NOFOLLOW", 0)
                        | getattr(os, "O_NONBLOCK", 0)
                        | getattr(os, "O_CLOEXEC", 0),
                        dir_fd=quarantine_fd,
                    )
                except OSError:
                    observed = os.stat(
                        target_name,
                        dir_fd=quarantine_fd,
                        follow_symlinks=False,
                    )
                    if not stat.S_ISREG(observed.st_mode):
                        raise InstallSyncError(
                            "created target rollback preserved non-regular "
                            f"replacement in quarantine: {quarantine_path}; "
                            f"ownership anchor preserved at: {anchor}"
                        )
                    raise
                observed = os.fstat(quarantined_descriptor)
                actual_sha = (
                    sha256_descriptor(quarantined_descriptor)
                    if stat.S_ISREG(observed.st_mode)
                    else ""
                )
                current_quarantine = os.stat(
                    quarantine_name,
                    dir_fd=parent_fd,
                    follow_symlinks=False,
                )
                if (
                    not stat.S_ISDIR(current_quarantine.st_mode)
                    or (
                        current_quarantine.st_dev,
                        current_quarantine.st_ino,
                    )
                    != (
                        quarantine_stat.st_dev,
                        quarantine_stat.st_ino,
                    )
                ):
                    raise InstallSyncError(
                        "created target quarantine identity changed; "
                        "quarantined target and ownership anchor preserved"
                    )
                current_entry = os.stat(
                    target_name,
                    dir_fd=quarantine_fd,
                    follow_symlinks=False,
                )
                if (
                    current_entry.st_dev,
                    current_entry.st_ino,
                ) != (
                    observed.st_dev,
                    observed.st_ino,
                ):
                    raise InstallSyncError(
                        "created target quarantine entry identity changed; "
                        "quarantined target and ownership anchor preserved"
                    )
                owned = (
                    stat.S_ISREG(observed.st_mode)
                    and (observed.st_dev, observed.st_ino) == identity
                    and actual_sha == expected_sha
                )
                if not stat.S_ISREG(observed.st_mode):
                    raise InstallSyncError(
                        "created target rollback preserved non-regular "
                        f"replacement in quarantine: {quarantine_path}; "
                        f"ownership anchor preserved at: {anchor}"
                    )
                (
                    isolation_fd,
                    isolation_name,
                    isolation_path,
                ) = isolate_verified_entry(
                    parent_descriptor=parent_fd,
                    source_parent_descriptor=quarantine_fd,
                    source_parent_name=quarantine_name,
                    source_parent_identity={
                        "st_dev": quarantine_stat.st_dev,
                        "st_ino": quarantine_stat.st_ino,
                    },
                    entry_name=target_name,
                    entry_descriptor=quarantined_descriptor,
                    entry_identity={
                        "st_dev": observed.st_dev,
                        "st_ino": observed.st_ino,
                    },
                    entry_sha256=actual_sha,
                    entry_mode=stat.S_IMODE(observed.st_mode),
                    isolation_prefix=(
                        f".{target_name}.rollback-isolated-"
                    ),
                    source_path=quarantine_path,
                )
                if owned:
                    try:
                        os.unlink(target_name, dir_fd=isolation_fd)
                    finally:
                        os.close(isolation_fd)
                    os.rmdir(isolation_name, dir_fd=parent_fd)
                    os.unlink(target_name, dir_fd=anchor_fd)
                    os.rmdir(anchor_dir_name, dir_fd=parent_fd)
                    os.close(quarantine_fd)
                    quarantine_fd = -1
                    os.rmdir(quarantine_name, dir_fd=parent_fd)
                    return {
                        "target_path": str(target_path),
                        "matched_sha256": expected_sha,
                        "matched_identity": record[
                            "created_target_identity"
                        ],
                    }
                try:
                    os.link(
                        target_name,
                        target_name,
                        src_dir_fd=isolation_fd,
                        dst_dir_fd=parent_fd,
                        follow_symlinks=False,
                    )
                except OSError as exc:
                    os.close(isolation_fd)
                    raise InstallSyncError(
                        "created target rollback restoration failed; "
                        "quarantined replacement preserved at: "
                        f"{isolation_path}; "
                        f"ownership anchor preserved at: {anchor}"
                    ) from exc
                try:
                    os.unlink(target_name, dir_fd=isolation_fd)
                except OSError as exc:
                    os.close(isolation_fd)
                    raise InstallSyncError(
                        "created target rollback restored the replacement but "
                        "could not remove quarantine link: "
                        f"{isolation_path}; "
                        f"ownership anchor preserved at: {anchor}"
                    ) from exc
                os.close(isolation_fd)
                os.rmdir(isolation_name, dir_fd=parent_fd)
                os.close(quarantine_fd)
                quarantine_fd = -1
                os.rmdir(quarantine_name, dir_fd=parent_fd)
                os.unlink(target_name, dir_fd=anchor_fd)
                os.rmdir(anchor_dir_name, dir_fd=parent_fd)
                return None
            finally:
                if quarantined_descriptor >= 0:
                    os.close(quarantined_descriptor)
        except Exception:
            if quarantine_fd >= 0:
                os.close(quarantine_fd)
            if quarantine_name:
                try:
                    os.rmdir(quarantine_name, dir_fd=parent_fd)
                except OSError:
                    pass
            raise
        finally:
            os.close(anchor_fd)


def rollback_backed_file(
    target_root: Path,
    backup_root: Path,
    record: dict[str, Any],
) -> dict[str, Any]:
    target_path = target_path_from_manifest_record(target_root, record)
    target_rel = str(record.get("target_rel") or "")
    backup_path = backup_root / "targets" / target_rel
    recorded_backup = Path(str(record.get("backup_path") or ""))
    expected_old_sha = str(record.get("old_target_sha256") or "")
    expected_new_sha = str(record.get("new_target_sha256") or "")
    expected_old_mode = record.get("old_target_mode")
    expected_new_mode = record.get("new_target_mode")
    expected_identity = record.get("new_target_identity")
    if (
        recorded_backup != backup_path
        or len(expected_old_sha) != 64
        or len(expected_new_sha) != 64
        or type(expected_old_mode) is not int
        or type(expected_new_mode) is not int
        or not isinstance(expected_identity, dict)
        or type(expected_identity.get("st_dev")) is not int
        or type(expected_identity.get("st_ino")) is not int
    ):
        raise InstallSyncError(
            f"rollback record invalid: {target_path}"
        )

    with opened_target_parent(backup_root, backup_path) as (
        backup_parent_fd,
        backup_name,
        verify_backup_parent,
    ):
        backup_descriptor = os.open(
            backup_name,
            os.O_RDONLY
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_NONBLOCK", 0)
            | getattr(os, "O_CLOEXEC", 0),
            dir_fd=backup_parent_fd,
        )
        try:
            backup_observed = os.fstat(backup_descriptor)
            if (
                not stat.S_ISREG(backup_observed.st_mode)
                or sha256_descriptor(backup_descriptor)
                != expected_old_sha
                or stat.S_IMODE(backup_observed.st_mode)
                != expected_old_mode
            ):
                raise InstallSyncError(
                    f"rollback backup preimage mismatch: {backup_path}"
                )

            def verify_backup_entry() -> None:
                try:
                    current = os.stat(
                        backup_name,
                        dir_fd=backup_parent_fd,
                        follow_symlinks=False,
                    )
                except OSError as exc:
                    raise InstallSyncError(
                        f"rollback backup identity changed: {backup_path}"
                    ) from exc
                if (
                    not stat.S_ISREG(current.st_mode)
                    or (
                        current.st_dev,
                        current.st_ino,
                    )
                    != (
                        backup_observed.st_dev,
                        backup_observed.st_ino,
                    )
                ):
                    raise InstallSyncError(
                        f"rollback backup identity changed: {backup_path}"
                    )

            verify_backup_entry()
            verify_backup_parent()

            with opened_target_parent(target_root, target_path) as (
                parent_fd,
                target_name,
                verify_target_parent,
            ):
                anchor_proc = Path(
                    tempfile.mkdtemp(
                        dir=f"/proc/self/fd/{parent_fd}",
                        prefix=f".{target_name}.restore-",
                    )
                )
                anchor_name = anchor_proc.name
                anchor_fd = os.open(
                    anchor_name,
                    os.O_RDONLY
                    | os.O_DIRECTORY
                    | getattr(os, "O_NOFOLLOW", 0),
                    dir_fd=parent_fd,
                )
                quarantine_name = ""
                quarantine_fd = -1
                preserve_quarantine = False
                staged_descriptor = -1
                staged = Path(
                    f"/proc/self/fd/{anchor_fd}/{target_name}"
                )
                try:
                    with staged.open("xb"):
                        pass
                    copy_descriptor2(
                        backup_descriptor,
                        staged,
                        backup_observed,
                        max_bytes=backup_observed.st_size,
                    )
                    if (
                        sha256_descriptor(backup_descriptor)
                        != expected_old_sha
                    ):
                        raise InstallSyncError(
                            "rollback backup preimage changed while staging: "
                            f"{backup_path}"
                        )
                    verify_backup_entry()
                    verify_backup_parent()
                    staged_descriptor = os.open(
                        target_name,
                        os.O_RDONLY
                        | getattr(os, "O_NOFOLLOW", 0)
                        | getattr(os, "O_NONBLOCK", 0)
                        | getattr(os, "O_CLOEXEC", 0),
                        dir_fd=anchor_fd,
                    )
                    staged_stat = os.fstat(staged_descriptor)
                    staged_identity = {
                        "st_dev": staged_stat.st_dev,
                        "st_ino": staged_stat.st_ino,
                    }
                    staged_observed = verify_open_regular_entry(
                        staged_descriptor,
                        anchor_fd,
                        target_name,
                        expected_identity=staged_identity,
                        expected_sha256=expected_old_sha,
                        expected_mode=expected_old_mode,
                        error=(
                            "rollback staged backup mismatch: "
                            f"{backup_path}"
                        ),
                    )
                    verify_target_parent()
                    quarantine_proc = Path(
                        tempfile.mkdtemp(
                            dir=f"/proc/self/fd/{parent_fd}",
                            prefix=f".{target_name}.rollback-",
                        )
                    )
                    quarantine_name = quarantine_proc.name
                    quarantine_path = (
                        target_path.parent
                        / quarantine_name
                        / target_name
                    )
                    quarantine_fd = os.open(
                        quarantine_name,
                        os.O_RDONLY
                        | os.O_DIRECTORY
                        | getattr(os, "O_NOFOLLOW", 0),
                        dir_fd=parent_fd,
                    )
                    quarantine_observed = os.fstat(quarantine_fd)
                    if (
                        not stat.S_ISDIR(quarantine_observed.st_mode)
                        or stat.S_IMODE(quarantine_observed.st_mode)
                        & 0o077
                    ):
                        raise InstallSyncError(
                            "rollback quarantine path invalid: "
                            f"{quarantine_path.parent}"
                        )
                    verify_target_parent()
                    try:
                        os.replace(
                            target_name,
                            target_name,
                            src_dir_fd=parent_fd,
                            dst_dir_fd=quarantine_fd,
                        )
                    except FileNotFoundError as exc:
                        raise InstallSyncError(
                            f"rollback target preimage mismatch: {target_path}"
                        ) from exc

                    candidate_descriptor = -1
                    candidate_identity: dict[str, int] = {}
                    candidate_sha = ""
                    candidate_mode = 0

                    def isolate_quarantined() -> tuple[int, str, Path]:
                        return isolate_verified_entry(
                            parent_descriptor=parent_fd,
                            source_parent_descriptor=quarantine_fd,
                            source_parent_name=quarantine_name,
                            source_parent_identity={
                                "st_dev": quarantine_observed.st_dev,
                                "st_ino": quarantine_observed.st_ino,
                            },
                            entry_name=target_name,
                            entry_descriptor=candidate_descriptor,
                            entry_identity=candidate_identity,
                            entry_sha256=candidate_sha,
                            entry_mode=candidate_mode,
                            isolation_prefix=(
                                f".{target_name}.rollback-isolated-"
                            ),
                            source_path=quarantine_path,
                        )

                    def restore_quarantined() -> None:
                        nonlocal quarantine_fd, preserve_quarantine
                        (
                            isolation_fd,
                            isolation_name,
                            isolation_path,
                        ) = isolate_quarantined()
                        try:
                            os.link(
                                target_name,
                                target_name,
                                src_dir_fd=isolation_fd,
                                dst_dir_fd=parent_fd,
                                follow_symlinks=False,
                            )
                        except OSError as exc:
                            os.close(isolation_fd)
                            preserve_quarantine = True
                            raise InstallSyncError(
                                "rollback restoration conflict; "
                                "validated candidate preserved at: "
                                f"{isolation_path}"
                            ) from exc
                        try:
                            os.unlink(
                                target_name,
                                dir_fd=isolation_fd,
                            )
                        finally:
                            os.close(isolation_fd)
                        os.rmdir(isolation_name, dir_fd=parent_fd)
                        os.close(quarantine_fd)
                        quarantine_fd = -1
                        os.rmdir(quarantine_name, dir_fd=parent_fd)

                    try:
                        try:
                            candidate_descriptor = os.open(
                                target_name,
                                os.O_RDONLY
                                | getattr(os, "O_NOFOLLOW", 0)
                                | getattr(os, "O_NONBLOCK", 0)
                                | getattr(os, "O_CLOEXEC", 0),
                                dir_fd=quarantine_fd,
                            )
                        except OSError as exc:
                            preserve_quarantine = True
                            raise InstallSyncError(
                                "rollback target preimage mismatch: "
                                f"{target_path}"
                            ) from exc
                        candidate = os.fstat(candidate_descriptor)
                        candidate_sha = (
                            sha256_descriptor(candidate_descriptor)
                            if stat.S_ISREG(candidate.st_mode)
                            else ""
                        )
                        candidate_identity = {
                            "st_dev": candidate.st_dev,
                            "st_ino": candidate.st_ino,
                        }
                        candidate_mode = stat.S_IMODE(candidate.st_mode)
                        current_quarantine = os.stat(
                            quarantine_name,
                            dir_fd=parent_fd,
                            follow_symlinks=False,
                        )
                        current_candidate = os.stat(
                            target_name,
                            dir_fd=quarantine_fd,
                            follow_symlinks=False,
                        )
                        if (
                            not stat.S_ISDIR(current_quarantine.st_mode)
                            or (
                                current_quarantine.st_dev,
                                current_quarantine.st_ino,
                            )
                            != (
                                quarantine_observed.st_dev,
                                quarantine_observed.st_ino,
                            )
                            or (
                                current_candidate.st_dev,
                                current_candidate.st_ino,
                            )
                            != (
                                candidate.st_dev,
                                candidate.st_ino,
                            )
                        ):
                            preserve_quarantine = True
                            raise InstallSyncError(
                                "rollback quarantine identity changed; "
                                "candidate evidence preserved"
                            )
                        if (
                            not stat.S_ISREG(candidate.st_mode)
                            or {
                                "st_dev": candidate.st_dev,
                                "st_ino": candidate.st_ino,
                            }
                            != expected_identity
                            or candidate_sha != expected_new_sha
                            or stat.S_IMODE(candidate.st_mode)
                            != expected_new_mode
                        ):
                            restore_quarantined()
                            raise InstallSyncError(
                                "rollback target preimage mismatch: "
                                f"{target_path}"
                            )
                        current_quarantine = os.stat(
                            quarantine_name,
                            dir_fd=parent_fd,
                            follow_symlinks=False,
                        )
                        if (
                            not stat.S_ISDIR(current_quarantine.st_mode)
                            or (
                                current_quarantine.st_dev,
                                current_quarantine.st_ino,
                            )
                            != (
                                quarantine_observed.st_dev,
                                quarantine_observed.st_ino,
                            )
                        ):
                            preserve_quarantine = True
                            raise InstallSyncError(
                                "rollback quarantine identity changed; "
                                "candidate evidence preserved"
                            )
                        try:
                            verify_open_regular_entry(
                                candidate_descriptor,
                                quarantine_fd,
                                target_name,
                                expected_identity=expected_identity,
                                expected_sha256=expected_new_sha,
                                expected_mode=expected_new_mode,
                                error=(
                                    "rollback quarantined candidate changed; "
                                    "candidate evidence preserved"
                                ),
                            )
                        except InstallSyncError:
                            preserve_quarantine = True
                            raise
                        try:
                            verify_open_regular_entry(
                                backup_descriptor,
                                backup_parent_fd,
                                backup_name,
                                expected_identity={
                                    "st_dev": backup_observed.st_dev,
                                    "st_ino": backup_observed.st_ino,
                                },
                                expected_sha256=expected_old_sha,
                                expected_mode=expected_old_mode,
                                error=(
                                    "rollback backup changed before commit: "
                                    f"{backup_path}"
                                ),
                            )
                            verify_backup_entry()
                            verify_backup_parent()
                            verify_open_regular_entry(
                                staged_descriptor,
                                anchor_fd,
                                target_name,
                                expected_identity=staged_identity,
                                expected_sha256=expected_old_sha,
                                expected_mode=expected_old_mode,
                                error=(
                                    "rollback staged backup changed before "
                                    f"commit: {backup_path}"
                                ),
                            )
                            verify_target_parent()
                        except InstallSyncError:
                            restore_quarantined()
                            raise
                        try:
                            os.link(
                                target_name,
                                target_name,
                                src_dir_fd=anchor_fd,
                                dst_dir_fd=parent_fd,
                                follow_symlinks=False,
                            )
                        except OSError as exc:
                            preserve_quarantine = True
                            raise InstallSyncError(
                                "rollback commit conflict; "
                                f"quarantined target preserved at: "
                                f"{quarantine_path}"
                            ) from exc
                        installed_descriptor = -1
                        try:
                            installed_descriptor = os.open(
                                target_name,
                                os.O_RDONLY
                                | getattr(os, "O_NOFOLLOW", 0)
                                | getattr(os, "O_NONBLOCK", 0)
                                | getattr(os, "O_CLOEXEC", 0),
                                dir_fd=parent_fd,
                            )
                            verify_open_regular_entry(
                                installed_descriptor,
                                parent_fd,
                                target_name,
                                expected_identity=staged_identity,
                                expected_sha256=expected_old_sha,
                                expected_mode=expected_old_mode,
                                error=(
                                    "rollback installed target changed; "
                                    f"quarantined target preserved at: "
                                    f"{quarantine_path}"
                                ),
                            )
                        except Exception:
                            try:
                                current = os.stat(
                                    target_name,
                                    dir_fd=parent_fd,
                                    follow_symlinks=False,
                                )
                            except OSError:
                                current = None
                            if (
                                current is not None
                                and (
                                    current.st_dev,
                                    current.st_ino,
                                )
                                == (
                                    staged_identity["st_dev"],
                                    staged_identity["st_ino"],
                                )
                            ):
                                os.unlink(target_name, dir_fd=parent_fd)
                                restore_quarantined()
                            else:
                                preserve_quarantine = True
                            raise
                        finally:
                            if installed_descriptor >= 0:
                                os.close(installed_descriptor)
                        (
                            isolation_fd,
                            isolation_name,
                            _isolation_path,
                        ) = isolate_quarantined()
                        try:
                            os.unlink(
                                target_name,
                                dir_fd=isolation_fd,
                            )
                        finally:
                            os.close(isolation_fd)
                        os.rmdir(isolation_name, dir_fd=parent_fd)
                        os.close(quarantine_fd)
                        quarantine_fd = -1
                        os.rmdir(quarantine_name, dir_fd=parent_fd)
                        rollback_record = {
                            "target_path": str(target_path),
                            "backup_path": str(backup_path),
                            "restored_sha256": expected_old_sha,
                        }
                    finally:
                        if candidate_descriptor >= 0:
                            os.close(candidate_descriptor)
                    return rollback_record
                finally:
                    if staged_descriptor >= 0:
                        os.close(staged_descriptor)
                    if quarantine_fd >= 0:
                        os.close(quarantine_fd)
                    if quarantine_name and not preserve_quarantine:
                        try:
                            os.rmdir(
                                quarantine_name,
                                dir_fd=parent_fd,
                            )
                        except OSError:
                            pass
                    try:
                        os.unlink(target_name, dir_fd=anchor_fd)
                    except FileNotFoundError:
                        pass
                    os.close(anchor_fd)
                    os.rmdir(anchor_name, dir_fd=parent_fd)
        finally:
            os.close(backup_descriptor)


def stage_retire_regular_target(
    target_root: Path,
    backup_root: Path,
    item: dict[str, Any],
) -> dict[str, Any]:
    """Verify the target, snapshot its exact preimage, and return the
    pending custody record. The caller persists this record through the
    backup journal BEFORE the unlink, so deletion intent and preimage are
    durable before the target disappears."""
    target_rel = str(item.get("target_rel") or "")
    target_path = Path(str(item.get("target_path") or ""))
    validate_install_source(str(item.get("source_rel") or ""))
    validate_historical_install_target(target_rel)
    pinned_sha256 = str(item.get("retire_expected_sha256") or "")
    expected_mode = item.get("retire_expected_mode")
    expected_identity = item.get("target_identity")
    if (
        len(pinned_sha256) != 64
        or type(expected_mode) is not int
        or not isinstance(expected_identity, dict)
        or type(expected_identity.get("st_dev")) is not int
        or type(expected_identity.get("st_ino")) is not int
    ):
        raise InstallSyncError(
            f"retirement record invalid: {target_path}"
        )
    backup_path = backup_root / "targets" / target_rel
    backup_path.parent.mkdir(parents=True, exist_ok=True)
    with opened_target_parent(target_root, target_path) as (
        parent_fd,
        target_name,
        verify_target_parent,
    ):
        observed = os.stat(
            target_name,
            dir_fd=parent_fd,
            follow_symlinks=False,
        )
        if not stat.S_ISREG(observed.st_mode) or (
            observed.st_dev,
            observed.st_ino,
        ) != (
            expected_identity["st_dev"],
            expected_identity["st_ino"],
        ):
            raise InstallSyncError(
                f"retirement target drifted after plan: {target_path}"
            )
        descriptor = os.open(
            target_name,
            os.O_RDONLY
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_CLOEXEC", 0),
            dir_fd=parent_fd,
        )
        try:
            observed_sha256 = sha256_descriptor(descriptor)
            observed_mode = stat.S_IMODE(os.fstat(descriptor).st_mode)
            if (
                observed_sha256 != pinned_sha256
                or observed_mode != expected_mode
            ):
                raise InstallSyncError(
                    f"retirement target drifted after plan: {target_path}"
                )
            backup_tmp_fd, backup_tmp_name = tempfile.mkstemp(
                prefix=f".{backup_path.name}.retire-",
                dir=str(backup_path.parent),
            )
            backup_committed = False
            try:
                with (
                    os.fdopen(backup_tmp_fd, "wb") as sink,
                    open(descriptor, "rb", closefd=False) as source,
                ):
                    shutil.copyfileobj(source, sink)
                    sink.flush()
                    os.fsync(sink.fileno())
                os.chmod(backup_tmp_name, expected_mode)
                if sha256_file(Path(backup_tmp_name)) != pinned_sha256:
                    raise InstallSyncError(
                        f"retirement backup preimage mismatch: {target_rel}"
                    )
                os.replace(backup_tmp_name, backup_path)
                backup_committed = True
                fsync_directory(backup_path.parent)
            finally:
                if not backup_committed:
                    try:
                        os.unlink(backup_tmp_name)
                    except FileNotFoundError:
                        pass
        finally:
            os.close(descriptor)
    return {
        "source_rel": str(item.get("source_rel") or ""),
        "target_rel": target_rel,
        "target_path": str(target_path),
        "backup_path": str(backup_path),
        "removed_target_sha256": pinned_sha256,
        "removed_target_mode": expected_mode,
        "action": "would_retire",
        "commit_state": "pending",
    }


def commit_retire_regular_target(
    target_root: Path,
    item: dict[str, Any],
    record: dict[str, Any],
) -> dict[str, Any]:
    """Unlink the already-snapshotted target after its custody record is
    durable in the backup journal."""
    target_rel = str(record.get("target_rel") or "")
    target_path = Path(str(record.get("target_path") or ""))
    expected_identity = item.get("target_identity")
    with opened_target_parent(target_root, target_path) as (
        parent_fd,
        target_name,
        verify_target_parent,
    ):
        current = os.stat(
            target_name,
            dir_fd=parent_fd,
            follow_symlinks=False,
        )
        if not stat.S_ISREG(current.st_mode) or (
            current.st_dev,
            current.st_ino,
        ) != (
            expected_identity["st_dev"],
            expected_identity["st_ino"],
        ):
            raise InstallSyncError(
                f"retirement target identity changed: {target_path}"
            )
        os.unlink(target_name, dir_fd=parent_fd)
        fsync_directory(target_path.parent)
    return {
        **record,
        "commit_state": "committed",
    }


def rollback_retired_target(
    target_root: Path,
    backup_root: Path,
    record: dict[str, Any],
) -> dict[str, Any]:
    target_rel = str(record.get("target_rel") or "")
    target_path = Path(str(record.get("target_path") or "")).resolve()
    resolved_target_root = target_root.resolve()
    if not target_path.is_relative_to(resolved_target_root):
        raise InstallSyncError(
            "retirement rollback target outside target root: "
            f"{target_path}"
        )
    backup_path = backup_root / "targets" / target_rel
    recorded_backup = Path(str(record.get("backup_path") or ""))
    expected_sha256 = str(record.get("removed_target_sha256") or "")
    expected_mode = record.get("removed_target_mode")
    if (
        recorded_backup != backup_path
        or len(expected_sha256) != 64
        or type(expected_mode) is not int
    ):
        raise InstallSyncError(
            f"retirement rollback record invalid: {target_path}"
        )
    if os.path.lexists(target_path):
        if record.get("commit_state") == "pending":
            observed = target_path.lstat()
            if (
                stat.S_ISREG(observed.st_mode)
                and stat.S_IMODE(observed.st_mode) == expected_mode
                and sha256_file(target_path) == expected_sha256
            ):
                return {
                    "target_rel": target_rel,
                    "target_path": str(target_path),
                    "backup_path": str(backup_path),
                    "restored_target_sha256": expected_sha256,
                    "restored_target_mode": expected_mode,
                    "action": "retire_skip_unchanged",
                    "commit_state": "pending",
                }
        raise InstallSyncError(
            f"retirement rollback blocked; target recreated: {target_path}"
        )
    with opened_target_parent(backup_root, backup_path) as (
        backup_parent_fd,
        backup_name,
        verify_backup_parent,
    ):
        backup_fd = os.open(
            backup_name,
            os.O_RDONLY
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_NONBLOCK", 0)
            | getattr(os, "O_CLOEXEC", 0),
            dir_fd=backup_parent_fd,
        )
        try:
            backup_stat = os.fstat(backup_fd)
            if (
                not stat.S_ISREG(backup_stat.st_mode)
                or sha256_descriptor(backup_fd) != expected_sha256
                or stat.S_IMODE(backup_stat.st_mode) != expected_mode
            ):
                raise InstallSyncError(
                    f"retirement rollback backup preimage mismatch: "
                    f"{backup_path}"
                )
            verify_backup_parent()
            with opened_target_parent(target_root, target_path) as (
                parent_fd,
                target_name,
                verify_target_parent,
            ):
                verify_target_parent()
                if os.path.lexists(target_path):
                    raise InstallSyncError(
                        "retirement rollback blocked; target recreated: "
                        f"{target_path}"
                    )
                quarantine = Path(
                    tempfile.mkdtemp(
                        prefix=f".{target_name}.retire-restore-",
                        dir=str(target_path.parent),
                    )
                )
                try:
                    staged = quarantine / target_name
                    staged_fd = os.open(
                        staged,
                        os.O_WRONLY
                        | os.O_CREAT
                        | os.O_EXCL
                        | getattr(os, "O_CLOEXEC", 0),
                        0o600,
                    )
                    with (
                        os.fdopen(staged_fd, "wb") as sink,
                        open(backup_fd, "rb", closefd=False) as source,
                    ):
                        shutil.copyfileobj(source, sink)
                        sink.flush()
                        os.fsync(sink.fileno())
                    os.chmod(staged, expected_mode)
                    verify_target_parent()
                    try:
                        os.link(
                            staged,
                            target_path,
                            follow_symlinks=False,
                        )
                    except OSError as exc:
                        raise InstallSyncError(
                            "retirement rollback blocked; target recreated: "
                            f"{target_path}"
                        ) from exc
                    fsync_directory(target_path.parent)
                    restored_stat = os.stat(target_path)
                    if (
                        sha256_file(target_path) != expected_sha256
                        or stat.S_IMODE(restored_stat.st_mode)
                        != expected_mode
                    ):
                        raise InstallSyncError(
                            "retirement rollback verification failed: "
                            f"{target_path}"
                        )
                finally:
                    shutil.rmtree(quarantine, ignore_errors=True)
        finally:
            os.close(backup_fd)
    return {
        "target_rel": target_rel,
        "target_path": str(target_path),
        "backup_path": str(backup_path),
        "restored_target_sha256": expected_sha256,
        "restored_target_mode": expected_mode,
        "action": "retire_restored",
    }


def rollback_backup(
    target: Path,
    backup_dir: Path,
    *,
    created_targets: list[dict[str, Any]] | None = None,
    backed_up_files: list[dict[str, Any]] | None = None,
    chmod_targets: list[dict[str, Any]] | None = None,
    retired_targets: list[dict[str, Any]] | None = None,
    journal: dict[str, Any] | None = None,
    journal_snapshot: dict[str, Any] | None = None,
) -> dict[str, Any]:
    target_root = target.resolve()
    backup_root = backup_dir.resolve()
    manifest = (
        load_backup_manifest(backup_root)
        if journal is None
        else journal
    )
    if journal_snapshot is not None:
        verify_backup_manifest_snapshot(journal_snapshot)
    expected_target_root = str(Path(str(manifest.get("target_root") or "")).resolve())
    if expected_target_root != str(target_root):
        raise InstallSyncError(f"backup target root mismatch: {expected_target_root} != {target_root}")

    restored: list[dict[str, Any]] = []
    restored_retired: list[dict[str, Any]] = []
    removed_created: list[dict[str, Any]] = []
    restored_modes: list[dict[str, Any]] = []
    restore_records = [
        record
        for record in (
            manifest.get("backed_up_files", [])
            if backed_up_files is None
            else backed_up_files
        )
        if isinstance(record, dict)
        and record.get("commit_state") in (None, "committed")
    ]
    retired_restore_records = [
        record
        for record in (
            manifest.get("retired_targets", [])
            if retired_targets is None
            else retired_targets
        )
        if isinstance(record, dict)
        and record.get("commit_state") in (None, "committed", "pending")
    ]
    enforce_ordinary_rollback_capacity(
        target_root,
        backup_root,
        restore_records + retired_restore_records,
        install_actor(),
        manifest,
    )

    for record in restore_records:
        restored.append(
            rollback_backed_file(
                target_root,
                backup_root,
                record,
            )
        )

    for record in retired_restore_records:
        restored_retired.append(
            rollback_retired_target(
                target_root,
                backup_root,
                record,
            )
        )

    for record in (
        manifest.get("created_targets", [])
        if created_targets is None
        else created_targets
    ):
        if not isinstance(record, dict):
            continue
        target_path = target_path_from_manifest_record(target_root, record)
        removed = rollback_created_target(
            target_root,
            target_path,
            record,
        )
        if removed is not None:
            removed_created.append(removed)

    for record in (
        manifest.get("chmod_targets", [])
        if chmod_targets is None
        else chmod_targets
    ):
        if not isinstance(record, dict):
            continue
        target_path = target_path_from_manifest_record(target_root, record)
        old_mode = record.get("old_target_mode")
        if old_mode is None:
            continue
        restored_mode, _identity = chmod_regular_target(
            target_root,
            target_path,
            int(old_mode),
            expected_identity=record.get("target_identity"),
            expected_sha256=str(
                record.get("new_target_sha256") or ""
            ),
            expected_mode=record.get("new_target_mode"),
        )
        restored_modes.append(
            {
                "target_path": str(target_path),
                "restored_mode": restored_mode,
            }
        )

    return {
        "schema_version": 1,
        "generated_at": utc_now(),
        "mode": "rollback",
        "dry_run": False,
        "writes_target": True,
        "copies_files": bool(restored or restored_retired),
        "chmod": bool(restored_modes),
        "live_smoke": False,
        "target": str(target_root),
        "backup_dir": str(backup_root),
        "restored_targets": restored,
        "restored_retired_targets": restored_retired,
        "removed_created_targets": removed_created,
        "restored_modes": restored_modes,
        "restored_count": len(restored),
        "restored_retired_count": len(restored_retired),
        "removed_created_count": len(removed_created),
        "restored_mode_count": len(restored_modes),
    }


def derive_legacy_pre_apply_attribution(
    target_root: Path,
    replay: dict[str, Any],
    target_rels: list[str],
    old_hashes: dict[str, str],
    sparse_pre_apply: dict[str, Any],
    bundle_event_id: str,
) -> dict[str, str] | None:
    """Bootstrap attribution for legacy generic sparse applied events.

    Legacy generic producers recorded pre-apply attribution only for
    mutation targets (or none at all). For every missing target, the
    missing prior event must be the latest effective event in ledger
    history immediately before the bundle event: replay only the
    recognized ledger prefix (events ordered before the bundle event)
    and read its latest_by_target, whose hash must equal the expected
    old hash. Replaying the prefix preserves rollback-chain semantics,
    so a prior install event that was later compensated is never
    selected as attribution. Ambiguity or mismatch is rejection: any
    target whose recorded sparse entry disagrees with the derived
    latest attribution fails.
    """
    ordered = replay["recognized_events"]
    try:
        bundle_index = next(
            index
            for index, candidate in enumerate(ordered)
            if str(candidate.get("event_id") or "") == bundle_event_id
        )
    except StopIteration:
        return None
    prefix = ordered[:bundle_index]
    prefix_replay = replay_install_mutation_events(
        target_root,
        events=prefix,
    )
    derived: dict[str, str] = {}
    for target_rel in target_rels:
        latest = prefix_replay["latest_by_target"].get(target_rel)
        if latest is None:
            return None
        latest_event = latest[0]
        if str(latest[1] or "") != old_hashes[target_rel]:
            return None
        latest_id = str(latest_event.get("event_id") or "")
        sparse_id = sparse_pre_apply.get(target_rel)
        if sparse_id is not None and str(sparse_id) != latest_id:
            return None
        derived[target_rel] = latest_id
    return {target_rel: derived[target_rel] for target_rel in target_rels}


def validate_explicit_rollback_bundle(
    *,
    source: Path,
    target: Path,
    backup_dir: Path,
    manifest_path: Path,
    expected_source_commit: str,
    expected_manifest_sha256: str,
    applied_event_policy: str,
) -> dict[str, Any]:
    source_root = source.resolve()
    target_root = target.resolve()
    backup_root = backup_dir.resolve()
    manifest_abs = manifest_path.resolve()
    if applied_event_policy not in {"required", "optional"}:
        raise InstallSyncError(
            "applied event policy must be required or optional"
        )
    provenance = source_git_provenance(source_root)
    if (
        not provenance["source_git_available"]
        or provenance["source_git_dirty"]
        or provenance["source_git_commit"] != expected_source_commit
    ):
        raise InstallSyncError(
            "explicit rollback source commit or clean-state mismatch"
        )
    if (
        not manifest_abs.is_file()
        or sha256_file(manifest_abs) != expected_manifest_sha256
    ):
        raise InstallSyncError(
            "explicit rollback manifest identity mismatch"
        )
    plan = build_plan(source_root, target_root, manifest_abs)
    target_rels = [
        str(item["target_rel"])
        for item in plan["files"]
    ]

    journal, journal_snapshot = load_backup_manifest_snapshot(
        backup_root
    )
    expected_identity = {
        "status": "applied",
        "source_repo": str(source_root),
        "source_git_commit": expected_source_commit,
        "manifest": str(manifest_abs),
        "manifest_sha256": expected_manifest_sha256,
        "target_root": str(target_root),
    }
    for field, expected in expected_identity.items():
        if journal.get(field) != expected:
            label = (
                "source commit"
                if field == "source_git_commit"
                else field.replace("_", " ")
            )
            raise InstallSyncError(
                f"explicit rollback {label} mismatch"
            )
    if journal.get("source_git_dirty"):
        raise InstallSyncError(
            "explicit rollback source clean-state mismatch"
        )
    copied = journal.get("copied_targets")
    backed_up = journal.get("backed_up_files")
    chmod_records = journal.get("chmod_targets")
    retired_records = journal.get("retired_targets")
    retired_noop_records = journal.get("retired_noop_targets")
    if retired_records is not None and not isinstance(retired_records, list):
        raise InstallSyncError(
            "explicit rollback journal mutation set mismatch"
        )
    if retired_noop_records is not None and not isinstance(
        retired_noop_records, list
    ):
        raise InstallSyncError(
            "explicit rollback journal mutation set mismatch"
        )
    retired_records = retired_records or []
    retired_noop_records = retired_noop_records or []
    if (
        not isinstance(copied, list)
        or not isinstance(backed_up, list)
        or (not copied and not retired_records)
        or len(copied) != len(backed_up)
        or journal.get("created_targets") not in ([], None)
        or (chmod_records is not None and not isinstance(chmod_records, list))
    ):
        raise InstallSyncError(
            "explicit rollback journal mutation set mismatch"
        )
    copied_by_target = {
        str(record.get("target_rel") or ""): record
        for record in copied
        if isinstance(record, dict)
    }
    backup_by_target = {
        str(record.get("target_rel") or ""): record
        for record in backed_up
        if isinstance(record, dict)
    }
    chmod_records = chmod_records or []
    chmod_by_target = {
        str(record.get("target_rel") or ""): record
        for record in chmod_records
        if isinstance(record, dict)
    }
    if (
        len(chmod_by_target) != len(chmod_records)
        or set(chmod_by_target) & set(copied_by_target)
    ):
        raise InstallSyncError(
            "explicit rollback chmod target set mismatch"
        )
    retired_by_target = {
        str(record.get("target_rel") or ""): record
        for record in retired_records
        if isinstance(record, dict)
    }
    retired_noop_by_target = {
        str(record.get("target_rel") or ""): record
        for record in retired_noop_records
        if isinstance(record, dict)
    }
    if (
        len(retired_by_target) != len(retired_records)
        or len(retired_noop_by_target) != len(retired_noop_records)
        or set(retired_by_target) & (set(copied_by_target) | set(chmod_by_target))
        or set(retired_noop_by_target)
        & (
            set(retired_by_target)
            | set(copied_by_target)
            | set(chmod_by_target)
        )
    ):
        raise InstallSyncError(
            "explicit rollback retirement target set mismatch"
        )
    retiring_target_rels = set(retired_by_target) | set(retired_noop_by_target)
    mutation_targets = set(copied_by_target) | set(chmod_by_target)
    if (
        len(copied_by_target) != len(copied)
        or len(backup_by_target) != len(backed_up)
        or set(backup_by_target) != set(copied_by_target)
        or not mutation_targets.issubset(target_rels)
        or not retiring_target_rels.issubset(target_rels)
    ):
        raise InstallSyncError(
            "explicit rollback journal target set mismatch"
        )

    old_hashes: dict[str, str] = {}
    candidate_hashes: dict[str, str] = {}
    replay = replay_install_mutation_events(target_root)
    bundle_event: dict[str, Any] | None = None
    for candidate in replay["recognized_events"]:
        if candidate.get("event_type") != "install_applied":
            continue
        if (
            str(candidate.get("backup_dir") or "") == str(backup_root)
            and str(candidate.get("source_repo") or "") == str(source_root)
            and str(candidate.get("source_git_commit") or "")
            == expected_source_commit
            and not bool(candidate.get("source_git_dirty"))
            and str(candidate.get("target_root") or "") == str(target_root)
            and str(candidate.get("manifest") or "") == str(manifest_abs)
            and str(candidate.get("manifest_sha256") or "")
            == expected_manifest_sha256
        ):
            bundle_event = candidate
            break
    bundle_event_hashes = (
        bundle_event.get("new_target_sha256")
        if isinstance(bundle_event, dict)
        else None
    )
    for item in plan["files"]:
        source_rel = str(item["source_rel"])
        target_rel = str(item["target_rel"])
        source_path = source_root / source_rel
        target_path = target_root / target_rel
        old_hash = str(
            item.get("expected_target_sha256") or ""
        )
        candidate_hash = sha256_file(source_path) if source_path.is_file() else ""
        if target_rel in retired_by_target:
            retire_record = retired_by_target[target_rel]
            removed_hash = str(
                retire_record.get("removed_target_sha256") or ""
            )
            backup_path = backup_root / "targets" / target_rel
            observed_absent = not (
                target_path.exists() or target_path.is_symlink()
            )
            removed_mode = retire_record.get("removed_target_mode")
            pending_never_unlinked = (
                retire_record.get("commit_state") == "pending"
                and target_path.is_file()
                and sha256_file(target_path) == removed_hash
                and file_mode(target_path) == removed_mode
            )
            if (
                len(removed_hash) != 64
                or old_hash != removed_hash
                or not (observed_absent or pending_never_unlinked)
                or not backup_path.is_file()
                or sha256_file(backup_path) != removed_hash
                or not isinstance(removed_mode, int)
                or stat.S_IMODE(backup_path.stat().st_mode) != removed_mode
            ):
                raise InstallSyncError(
                    "explicit rollback retired target mismatch: "
                    f"{target_rel}"
                )
            continue
        if target_rel in retired_noop_by_target:
            if len(old_hash) != 64 or os.path.lexists(target_path):
                raise InstallSyncError(
                    "explicit rollback retired noop target mismatch: "
                    f"{target_rel}"
                )
            continue
        if target_rel not in mutation_targets:
            lineage_hash = ""
            if isinstance(bundle_event_hashes, dict):
                recorded = str(
                    bundle_event_hashes.get(target_rel) or ""
                )
                if recorded:
                    lineage_hash = recorded
            expected_hash = lineage_hash or old_hash
            if (
                not expected_hash
                or candidate_hash != expected_hash
                or not target_path.is_file()
                or sha256_file(target_path) != expected_hash
            ):
                raise InstallSyncError(
                    "explicit rollback unchanged target mismatch: "
                    f"{target_rel}"
                )
            old_hashes[target_rel] = expected_hash
            candidate_hashes[target_rel] = expected_hash
            continue
        chmod_record = chmod_by_target.get(target_rel)
        if chmod_record is not None:
            event_chmod_record = None
            if isinstance(bundle_event, dict):
                for event_record in (
                    bundle_event.get("chmod_targets") or []
                ):
                    if not isinstance(event_record, dict):
                        continue
                    if (
                        str(event_record.get("target_rel") or "")
                        == target_rel
                    ):
                        event_chmod_record = event_record
                        break
            recorded_chmod_hash = str(
                chmod_record.get("new_target_sha256") or ""
            )
            old_mode = chmod_record.get("old_target_mode")
            new_mode = chmod_record.get("new_target_mode")
            identity = chmod_record.get("target_identity")
            observed_stat = (
                target_path.stat(follow_symlinks=False)
                if target_path.is_file()
                else None
            )
            if (
                event_chmod_record != chmod_record
                or Path(
                    str(chmod_record.get("target_path") or "")
                ).resolve()
                != target_path
                or not recorded_chmod_hash
                or candidate_hash != recorded_chmod_hash
                or observed_stat is None
                or sha256_file(target_path) != recorded_chmod_hash
                or not isinstance(old_mode, int)
                or not isinstance(new_mode, int)
                or old_mode == new_mode
                or file_mode(target_path) != new_mode
                or not isinstance(identity, dict)
                or identity.get("st_dev") != observed_stat.st_dev
                or identity.get("st_ino") != observed_stat.st_ino
            ):
                raise InstallSyncError(
                    "explicit rollback chmod target mismatch: "
                    f"{target_rel}"
                )
            old_hashes[target_rel] = candidate_hash
            candidate_hashes[target_rel] = candidate_hash
            continue
        copied_record = copied_by_target[target_rel]
        backup_record = backup_by_target[target_rel]
        backup_path = backup_root / "targets" / target_rel
        recorded_candidate_hash = str(
            copied_record.get("new_target_sha256") or ""
        )
        if not old_hash:
            event_old_hashes = (
                bundle_event.get("old_target_sha256")
                if isinstance(bundle_event, dict)
                else None
            )
            old_hash = (
                str(event_old_hashes.get(target_rel) or "")
                if isinstance(event_old_hashes, dict)
                else ""
            )
        if (
            copied_record.get("action") != "would_update"
            or Path(str(copied_record.get("source_path") or "")).resolve()
            != source_path
            or Path(str(copied_record.get("target_path") or "")).resolve()
            != target_path
            or Path(str(backup_record.get("target_path") or "")).resolve()
            != target_path
            or Path(str(backup_record.get("backup_path") or "")).resolve()
            != backup_path
        ):
            raise InstallSyncError(
                f"explicit rollback path mismatch: {target_rel}"
            )
        if (
            not old_hash
            or str(copied_record.get("old_target_sha256") or "")
            != old_hash
            or str(backup_record.get("old_target_sha256") or "")
            != old_hash
            or not backup_path.is_file()
            or sha256_file(backup_path) != old_hash
        ):
            raise InstallSyncError(
                f"explicit rollback backup hash mismatch: {target_rel}"
            )
        if (
            not source_path.is_file()
            or not target_path.is_file()
            or not recorded_candidate_hash
            or candidate_hash != recorded_candidate_hash
            or sha256_file(target_path) != recorded_candidate_hash
        ):
            raise InstallSyncError(
                f"explicit rollback target candidate hash mismatch: {target_rel}"
            )
        old_hashes[target_rel] = old_hash
        candidate_hashes[target_rel] = candidate_hash

    raw_pre_apply = journal.get(
        "pre_apply_effective_event_id_by_target"
    )
    if not isinstance(raw_pre_apply, dict):
        raise InstallSyncError(
            "explicit rollback pre-apply effective event map mismatch"
        )
    target_rels_set = set(target_rels)
    if not set(raw_pre_apply).issubset(target_rels_set):
        raise InstallSyncError(
            "explicit rollback pre-apply effective event map mismatch"
        )
    ordinary_target_rels = (
        target_rels_set - retiring_target_rels
    )
    legacy_sparse_pre_apply = (
        set(raw_pre_apply) != ordinary_target_rels
    )
    pre_apply = raw_pre_apply
    if legacy_sparse_pre_apply:
        bundle_event_id = ""
        for candidate in replay["recognized_events"]:
            if (
                candidate.get("event_type") == "install_applied"
                and str(candidate.get("backup_dir") or "") == str(backup_root)
            ):
                bundle_event_id = str(candidate.get("event_id") or "")
                break
        legacy_pre_apply = derive_legacy_pre_apply_attribution(
            target_root,
            replay,
            target_rels,
            old_hashes,
            raw_pre_apply,
            bundle_event_id,
        )
        if legacy_pre_apply is None:
            raise InstallSyncError(
                "explicit rollback pre-apply effective event map mismatch"
            )
        pre_apply = legacy_pre_apply
    if any(
        not isinstance(event_id, str) or not event_id
        for target_rel, event_id in pre_apply.items()
        if target_rel not in retiring_target_rels
    ):
        raise InstallSyncError(
            "explicit rollback pre-apply effective event map mismatch"
        )
    for target_rel, event_id in pre_apply.items():
        if target_rel in retiring_target_rels:
            continue
        prior = replay["events_by_id"].get(event_id)
        prior_hashes = (
            effective_event_target_hashes(prior)
            if prior is not None
            else None
        )
        if (
            prior is None
            or prior_hashes is None
            or prior_hashes.get(target_rel) != old_hashes[target_rel]
        ):
            raise InstallSyncError(
                "install mutation ledger pre-apply attribution mismatch: "
                f"{target_rel}"
            )

    mutation_scoped_old_hashes = {
        target_rel: old_hashes[target_rel]
        for target_rel in sorted(mutation_targets)
    }

    def recorded_event_maps_match(event: dict[str, Any]) -> bool:
        recorded_old = event.get("old_target_sha256")
        recorded_new = event.get("new_target_sha256")
        recorded_pre_apply = event.get(
            "pre_apply_effective_event_id_by_target"
        )
        if not isinstance(recorded_old, dict) or recorded_old != old_hashes:
            if (
                not legacy_sparse_pre_apply
                or recorded_old != mutation_scoped_old_hashes
            ):
                return False
        if recorded_new != candidate_hashes:
            return False
        if not isinstance(recorded_pre_apply, dict):
            return False
        if recorded_pre_apply == pre_apply:
            return True
        return (
            legacy_sparse_pre_apply
            and recorded_pre_apply == raw_pre_apply
        )

    conflicts = [
        event
        for event in replay["recognized_events"]
        if event.get("event_type") == "install_applied"
        and str(event.get("backup_dir") or "") == str(backup_root)
        and (
            str(event.get("source_repo") or "") != str(source_root)
            or str(event.get("source_git_commit") or "")
            != expected_source_commit
            or bool(event.get("source_git_dirty"))
            or str(event.get("target_root") or "") != str(target_root)
            or str(event.get("manifest") or "") != str(manifest_abs)
            or str(event.get("manifest_sha256") or "")
            != expected_manifest_sha256
            or not recorded_event_maps_match(event)
        )
    ]
    if conflicts:
        raise InstallSyncError(
            "install mutation ledger has conflicting backup record"
        )
    matching = [
        event
        for event in replay["recognized_events"]
        if event.get("event_type") == "install_applied"
        and str(event.get("source_repo") or "") == str(source_root)
        and str(event.get("source_git_commit") or "")
        == expected_source_commit
        and not bool(event.get("source_git_dirty"))
        and str(event.get("target_root") or "") == str(target_root)
        and str(event.get("backup_dir") or "") == str(backup_root)
        and str(event.get("manifest") or "") == str(manifest_abs)
        and str(event.get("manifest_sha256") or "")
        == expected_manifest_sha256
        and recorded_event_maps_match(event)
    ]
    if len(matching) > 1:
        raise InstallSyncError(
            "install mutation ledger has multiple matching applied events"
        )
    if applied_event_policy == "required" and len(matching) != 1:
        raise InstallSyncError(
            "install mutation ledger matching applied event required"
        )
    matching_event = matching[0] if matching else None
    if matching_event is not None:
        matching_id = str(matching_event["event_id"])
        if matching_id in replay["compensated_event_ids"]:
            raise InstallSyncError(
                "install mutation ledger applied event already compensated"
            )
        for target_rel in target_rels:
            if target_rel in retiring_target_rels:
                continue
            latest = replay["latest_by_target"].get(target_rel)
            if (
                latest is None
                or str(latest[0].get("event_id") or "") != matching_id
            ):
                raise InstallSyncError(
                    "install mutation ledger latest effective event mismatch: "
                    f"{target_rel}"
                )
    else:
        for target_rel, event_id in pre_apply.items():
            if target_rel in retiring_target_rels:
                continue
            if not event_id:
                continue
            latest = replay["latest_by_target"].get(target_rel)
            if (
                latest is None
                or str(latest[0].get("event_id") or "") != event_id
            ):
                raise InstallSyncError(
                    "install mutation ledger latest effective event mismatch: "
                    f"{target_rel}"
                )
    return {
        "schema_version": 1,
        "mode": "rollback-check",
        "writes_target": False,
        "source": str(source_root),
        "target": str(target_root),
        "backup_dir": str(backup_root),
        "manifest": str(manifest_abs),
        "manifest_sha256": expected_manifest_sha256,
        "source_git_commit": expected_source_commit,
        "applied_event_policy": applied_event_policy,
        "matching_applied_event_id": (
            str(matching_event["event_id"]) if matching_event else ""
        ),
        "mutation_target_rels": sorted(mutation_targets),
        "retired_target_rels": sorted(retired_by_target),
        "retired_noop_target_rels": sorted(retired_noop_by_target),
        "restored_retired_target_sha256": {
            target_rel: str(
                retired_by_target[target_rel].get("removed_target_sha256")
                or ""
            )
            for target_rel in sorted(retired_by_target)
        },
        "chmod_target_rels": sorted(chmod_by_target),
        "restored_target_mode": {
            target_rel: int(chmod_by_target[target_rel]["old_target_mode"])
            for target_rel in sorted(chmod_by_target)
        },
        "pre_apply_effective_event_id_by_target": pre_apply,
        "candidate_target_sha256": candidate_hashes,
        "restored_target_sha256": old_hashes,
        "rollback_journal": journal,
        "rollback_journal_snapshot": journal_snapshot,
    }


def append_install_rollback_event(
    validation: dict[str, Any],
) -> dict[str, Any]:
    event = {
        "schema_version": 1,
        "event_id": f"rollback-{uuid.uuid4().hex}",
        "event_type": "install_rolled_back",
        "timestamp": utc_now(),
        "actor": install_actor(),
        "source_repo": validation["source"],
        "source_git_commit": validation["source_git_commit"],
        "source_git_dirty": False,
        "manifest": validation["manifest"],
        "manifest_sha256": validation["manifest_sha256"],
        "target_root": validation["target"],
        "backup_dir": validation["backup_dir"],
        "compensated_install_event_id": validation[
            "matching_applied_event_id"
        ],
        "pre_apply_effective_event_id_by_target": {
            target_rel: event_id
            for target_rel, event_id in validation[
                "pre_apply_effective_event_id_by_target"
            ].items()
            if target_rel not in set(validation.get("retired_target_rels", []))
            | set(validation.get("retired_noop_target_rels", []))
        },
        "candidate_target_sha256": validation[
            "candidate_target_sha256"
        ],
        "restored_target_sha256": validation[
            "restored_target_sha256"
        ],
        "restored_retired_target_sha256": validation.get(
            "restored_retired_target_sha256",
            {},
        ),
    }
    path = install_event_log_path(Path(validation["target"]))
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(
            json.dumps(event, sort_keys=True, ensure_ascii=False) + "\n"
        )
        handle.flush()
        os.fsync(handle.fileno())
    return event


def print_plan_human(plan: dict[str, Any]) -> None:
    print("install_sync_plan")
    print("dry_run_only: true")
    print(f"source: {plan['source']}")
    print(f"target: {plan['target']}")
    print(f"manifest: {plan['manifest']}")
    print(
        "source_git_available: "
        f"{str(bool(plan.get('source_git_available'))).lower()}"
    )
    print(f"source_git_commit: {plan.get('source_git_commit') or '-'}")
    print(
        "source_git_dirty: "
        f"{str(bool(plan.get('source_git_dirty'))).lower()}"
    )
    print("writes_target: false")
    print("copies_files: false")
    print("chmod: false")
    print("live_smoke: false")
    print("notes:")
    for note in plan["notes"]:
        print(f"  - {note}")
    print("files:")
    for item in plan["files"]:
        source_sha = item.get("source_sha256") or "-"
        target_sha = item.get("target_sha256") or "-"
        print(
            f"  - {item['source_rel']} -> {item['target_rel']} "
            f"source_path={item['source_path']} target_path={item['target_path']} "
            f"action={item['action']} source_exists={str(bool(item['source_exists'])).lower()} "
            f"target_exists={str(bool(item['target_exists'])).lower()} "
            f"source_sha256={source_sha} target_sha256={target_sha}"
        )


def print_diff_human(payload: dict[str, Any]) -> None:
    print("install_sync_diff")
    print("dry_run_only: true")
    print(f"source: {payload['source']}")
    print(f"target: {payload['target']}")
    print(f"manifest: {payload['manifest']}")
    print("writes_target: false")
    print("copies_files: false")
    print("chmod: false")
    print("live_smoke: false")
    print("entries:")
    for entry in payload["entries"]:
        print(f"  - {entry['action']} {entry['target_rel']}")
        if entry.get("action") == "would_chmod":
            print(f"    mode: {entry.get('target_mode')} -> {entry.get('source_mode')}")
        else:
            diff_text = str(entry.get("diff") or "").rstrip()
            if diff_text:
                for line in diff_text.splitlines():
                    print(f"    {line}")


def command_plan(args: argparse.Namespace) -> int:
    plan = build_plan(Path(args.source), Path(args.target), Path(args.manifest))
    if args.json:
        print(json.dumps(plan, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print_plan_human(plan)
    return 0


def command_diff(args: argparse.Namespace) -> int:
    plan = build_plan(Path(args.source), Path(args.target), Path(args.manifest))
    payload = build_diff_preview(plan)
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print_diff_human(payload)
    return 0


def command_check(args: argparse.Namespace) -> int:
    plan = build_plan(Path(args.source), Path(args.target), Path(args.manifest))
    validate_target_preconditions(
        plan,
        require_target_preimages=bool(
            getattr(args, "require_target_preimages", False)
        ),
    )
    print_plan_human(plan)
    print("check: OK")
    print("target_modified: false")
    return 0


