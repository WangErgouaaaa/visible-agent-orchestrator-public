#!/usr/bin/env python3
"""Plan and validate evidence-governed improvement artifacts."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import subprocess
import sys
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
for package_root in (ROOT / "lib", ROOT / "src"):
    if package_root.is_dir() and str(package_root) not in sys.path:
        sys.path.insert(0, str(package_root))

from visible_agent_orchestrator.improvement_control import (  # noqa: E402
    ImprovementControlError,
    apply_issue_plan,
    candidate_trigger,
    derive_issue_claim_store_dir,
    fetch_remote_issues_via_gh,
    plan_release_transition,
    plan_issue_sync,
    quarantine_experience,
    select_runtime_memory,
    validate_improvement_candidate,
    validate_episode,
    validate_experience,
    write_immutable_json,
)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="omx_improvement_control",
        description=(
            "Plan external Issue actions and validate local improvement evidence. "
            "Remote creation requires the literal issue-apply --apply flag."
        ),
    )
    commands = parser.add_subparsers(dest="command", required=True)

    issue_plan = commands.add_parser("issue-plan")
    issue_plan.add_argument("--issue-path", required=True)
    issue_plan.add_argument("--repo-root", required=True)
    issue_plan.add_argument("--remote-issues-json", required=True)
    issue_plan.add_argument("--source-commit", required=True)
    issue_plan.add_argument("--remote-url", required=True)
    issue_plan.set_defaults(handler=_command_issue_plan)

    issue_apply = commands.add_parser("issue-apply")
    issue_apply.add_argument("--plan", required=True)
    issue_apply.add_argument(
        "--apply",
        action="store_true",
        help="execute the one validated gh issue create command",
    )
    issue_apply.set_defaults(handler=_command_issue_apply)

    record_validate = commands.add_parser("record-validate")
    _add_record_input(record_validate)
    record_validate.set_defaults(handler=_command_record_validate)

    record_write = commands.add_parser("record-write")
    _add_record_input(record_write)
    record_write.add_argument("--output", required=True)
    record_write.set_defaults(handler=_command_record_write)

    quarantine = commands.add_parser("experience-quarantine")
    quarantine.add_argument("--input", required=True)
    quarantine.add_argument("--reopened-issue-url", required=True)
    quarantine.add_argument("--reopened-issue-sha256", required=True)
    quarantine.set_defaults(handler=_command_experience_quarantine)

    memory_select = commands.add_parser("memory-select")
    memory_select.add_argument("--records-json", required=True)
    memory_select.add_argument("--environment-json", required=True)
    memory_select.add_argument("--context-json", required=True)
    memory_select.set_defaults(handler=_command_memory_select)

    candidate_trigger_parser = commands.add_parser("candidate-trigger")
    candidate_trigger_parser.add_argument("--input", required=True)
    candidate_trigger_parser.set_defaults(handler=_command_candidate_trigger)

    candidate_validate = commands.add_parser("candidate-validate")
    candidate_validate.add_argument("--input", required=True)
    candidate_validate.add_argument("--rejected-fingerprints-json")
    candidate_validate.set_defaults(handler=_command_candidate_validate)

    candidate_fingerprint_parser = commands.add_parser("candidate-fingerprint")
    candidate_fingerprint_parser.add_argument("--input", required=True)
    candidate_fingerprint_parser.set_defaults(
        handler=_command_candidate_fingerprint
    )

    release_plan = commands.add_parser("release-plan")
    release_plan.add_argument("--input", required=True)
    release_plan.set_defaults(handler=_command_release_plan)
    return parser


def _add_record_input(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--kind", choices=("episode", "experience"), required=True)
    parser.add_argument("--input", required=True)


def _command_issue_plan(args: argparse.Namespace) -> int:
    remote_issues = _load_list(args.remote_issues_json, "remote issues")
    payload = plan_issue_sync(
        issue_path=args.issue_path,
        repo_root=args.repo_root,
        remote_issues=remote_issues,
        source_commit=args.source_commit,
        remote_url=args.remote_url,
    )
    _print_json(payload)
    return 0


def _command_issue_apply(args: argparse.Namespace) -> int:
    plan = _load_mapping(args.plan, "issue plan")
    if not args.apply:
        _print_json(
            {
                "action": str(plan.get("action") or ""),
                "reason_codes": ["explicit_apply_required"],
                "would_execute_remote": False,
            }
        )
        return 0
    payload = apply_issue_plan(
        plan=plan,
        remote_issue_loader=lambda: fetch_remote_issues_via_gh(
            plan,
            runner=subprocess.run,
        ),
        claim_store_dir=derive_issue_claim_store_dir(plan),
        runner=subprocess.run,
    )
    _print_json(payload)
    return 0


def _command_record_validate(args: argparse.Namespace) -> int:
    payload = _validate_record(args.kind, _load_mapping(args.input, args.kind))
    _print_json(payload)
    return 0


def _command_record_write(args: argparse.Namespace) -> int:
    payload = _validate_record(args.kind, _load_mapping(args.input, args.kind))
    result = write_immutable_json(args.output, payload)
    _print_json(result)
    return 1 if result["status"] == "conflict" else 0


def _command_experience_quarantine(args: argparse.Namespace) -> int:
    payload = quarantine_experience(
        _load_mapping(args.input, "experience"),
        reopened_issue_url=args.reopened_issue_url,
        reopened_issue_sha256=args.reopened_issue_sha256,
    )
    _print_json(payload)
    return 0


def _command_memory_select(args: argparse.Namespace) -> int:
    payload = select_runtime_memory(
        records=_load_list(args.records_json, "experience records"),
        environment_fingerprint=_load_mapping(
            args.environment_json,
            "environment fingerprint",
        ),
        context=_load_mapping(args.context_json, "runtime memory context"),
    )
    _print_json(payload)
    return 0


def _command_candidate_trigger(args: argparse.Namespace) -> int:
    inputs = _load_mapping(args.input, "candidate trigger")
    _require_cli_fields(
        inputs,
        {"experience_ids", "failure_clusters", "severe_event"},
        "candidate trigger",
    )
    payload = candidate_trigger(
        experience_ids=inputs["experience_ids"],
        failure_clusters=inputs["failure_clusters"],
        severe_event=inputs["severe_event"],
    )
    _print_json(payload)
    return 0


def _command_candidate_validate(args: argparse.Namespace) -> int:
    rejected = (
        _load_string_list(
            args.rejected_fingerprints_json,
            "rejected candidate fingerprints",
        )
        if args.rejected_fingerprints_json
        else []
    )
    payload = validate_improvement_candidate(
        _load_mapping(args.input, "improvement candidate"),
        rejected_fingerprints=rejected,
    )
    _print_json(payload)
    return 0


def _command_candidate_fingerprint(args: argparse.Namespace) -> int:
    payload = validate_improvement_candidate(
        _load_mapping(args.input, "improvement candidate")
    )
    _print_json({"fingerprint": payload["fingerprint"]})
    return 0


def _command_release_plan(args: argparse.Namespace) -> int:
    payload = plan_release_transition(
        _load_mapping(args.input, "improvement release plan")
    )
    _print_json(payload)
    return 0


def _validate_record(kind: str, payload: dict[str, Any]) -> dict[str, Any]:
    return validate_episode(payload) if kind == "episode" else validate_experience(payload)


def _load_json(path_value: str, field: str) -> object:
    path = Path(path_value).expanduser()
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise ImprovementControlError(f"{field} file not found: {path}") from exc
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ImprovementControlError(f"{field} must be valid JSON: {path}") from exc


def _load_mapping(path_value: str, field: str) -> dict[str, Any]:
    payload = _load_json(path_value, field)
    if not isinstance(payload, dict):
        raise ImprovementControlError(f"{field} must be a JSON mapping")
    return payload


def _load_list(path_value: str, field: str) -> list[dict[str, Any]]:
    payload = _load_json(path_value, field)
    if not isinstance(payload, list) or any(not isinstance(item, dict) for item in payload):
        raise ImprovementControlError(f"{field} must be a JSON list of mappings")
    return payload


def _load_string_list(path_value: str, field: str) -> list[str]:
    payload = _load_json(path_value, field)
    if not isinstance(payload, list) or any(
        not isinstance(item, str)
        for item in payload
    ):
        raise ImprovementControlError(f"{field} must be a JSON list of strings")
    return payload


def _require_cli_fields(
    payload: dict[str, Any],
    expected: set[str],
    field: str,
) -> None:
    unknown = sorted(set(payload).difference(expected))
    missing = sorted(expected.difference(payload))
    if unknown:
        raise ImprovementControlError(
            f"{field} has unknown fields: {', '.join(unknown)}"
        )
    if missing:
        raise ImprovementControlError(
            f"{field} is missing fields: {', '.join(missing)}"
        )


def _print_json(payload: object) -> None:
    print(
        json.dumps(
            payload,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        )
    )


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return int(args.handler(args))
    except (ImprovementControlError, OSError, ValueError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("ERROR: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
