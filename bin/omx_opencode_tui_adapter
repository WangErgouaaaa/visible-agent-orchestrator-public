    )


PROMPT_ASYNC_ENDPOINT = PROMPT_ASYNC_CONSUMED_PROJECTION["path"]
SESSION_ABORT_ENDPOINT = SESSION_ABORT_CONSUMED_PROJECTION["path"]
PROMPT_ASYNC_SESSION_ID_RE = re.compile(r"ses_[A-Za-z0-9][A-Za-z0-9_.-]*")
SESSION_CREATE_ENDPOINT = SESSION_CREATE_CONSUMED_PROJECTION["path"]
TUI_SELECT_SESSION_ENDPOINT = TUI_SELECT_SESSION_CONSUMED_PROJECTION["path"]
COLD_START_EXTERNAL_DIRECTORY_PERMISSION = "external_directory"
SUPPLEMENT_SELECTION_FIELDS = ("agent", "model", "variant")
SUPPLEMENT_SELECTION_SCHEMA_ALLOWED_KEYS = frozenset(
    {"description", "title", "type"}
)
SUPPLEMENT_MODEL_SCHEMA_ALLOWED_KEYS = frozenset(
    {"additionalProperties", "description", "title", "type", "properties", "required"}
)
SUPPLEMENT_DEFAULT_VARIANT = "default"


def supplement_selection_guard(
    *,
    original_selection: dict[str, Any],
    selection_evidence: str,
) -> dict[str, Any]:
    """Fail closed when the host-bound original selection is incomplete.

    Upstream v1.18.29 resolves an omitted agent to the *default* agent and an
    omitted model to ``agent.model`` before the session current model
    (prompt.ts createUserMessage), so the supplement must carry the bound
    agent/model/variant explicitly. A complete selection requires nonempty
    agent, model.providerID and model.modelID; the variant may be empty (it is
    emitted as the backend's canonical default sentinel). Whether the admitted
    request contract can express those fields is verified against the live
    schema before the POST.
    """
    bound_model = (
        original_selection.get("model")
        if isinstance(original_selection.get("model"), dict)
        else {}
    )
    if (
        not str(original_selection.get("agent") or "").strip()
        or not str(bound_model.get("providerID") or "").strip()
        or not str(bound_model.get("modelID") or "").strip()
    ):
        raise AdapterError(
            "supplement_original_selection_unsupported: the bound original "
            "selection is incomplete; nonempty agent, model.providerID and "
            "model.modelID are required"
        )
    if not str(selection_evidence or "").strip():
        raise AdapterError(
            "supplement_original_selection_unsupported: no selection evidence source"
        )
    return {
        "admitted": True,
        "selection_fields": list(SUPPLEMENT_SELECTION_FIELDS),
        "selection_evidence": str(selection_evidence),
    }


def _supplement_selection_property_admitted(
    doc: dict[str, Any],
    node: Any,
    *,
    allowed_keys: frozenset[str],
) -> dict[str, Any] | None:
    node = resolve_openapi_ref(doc, node)
    if not isinstance(node, dict):
        return None
    if not _schema_keys_supported(node, allowed_keys):
        return None
    if "additionalProperties" in node and not _additional_properties_value_supported(
        node["additionalProperties"]
    ):
        return None
    return node


def supplement_prompt_async_operation_schema(doc: dict[str, Any]) -> dict[str, Any]:
    """Real schema check for a selection-capable same-task supplement.

    Runs the existing strict parts-only validation first, then requires the
    live request schema to declare optional ``agent`` (string), ``variant``
    (string) and ``model`` (object with string providerID/modelID) properties
    outside ``required``. Returns the fields the live document admits; a
    document that only admits ``parts`` fails closed.
    """
    projection = canonical_prompt_async_operation(doc)
    paths = doc.get("paths", {}) if isinstance(doc, dict) else {}
    operation = paths.get(PROMPT_ASYNC_ENDPOINT, {}).get("post", {})
    request_body = operation.get("requestBody", {}) if isinstance(operation, dict) else {}
    if isinstance(request_body, dict):
        request_body = resolve_openapi_ref(doc, request_body)
    content = request_body.get("content", {}) if isinstance(request_body, dict) else {}
    entry = content.get("application/json") if isinstance(content, dict) else None
    schema = entry.get("schema", {}) if isinstance(entry, dict) else {}
    schema = resolve_openapi_ref(doc, schema)
    properties = schema.get("properties", {}) if isinstance(schema, dict) else {}
    required_fields = [
        str(item) for item in (schema.get("required") or [])
    ] if isinstance(schema, dict) else []
    for field in SUPPLEMENT_SELECTION_FIELDS:
        if field in required_fields:
            raise AdapterError(
                f"POST {PROMPT_ASYNC_ENDPOINT} must declare {field} optional, "
                "not required"
            )
    agent_node = _supplement_selection_property_admitted(
        doc,
        properties.get("agent"),
        allowed_keys=SUPPLEMENT_SELECTION_SCHEMA_ALLOWED_KEYS,
    )
    if agent_node is None or agent_node.get("type") != "string":
        raise AdapterError(
            f"POST {PROMPT_ASYNC_ENDPOINT} does not admit an optional string agent"
        )
    variant_node = _supplement_selection_property_admitted(
        doc,
        properties.get("variant"),
        allowed_keys=SUPPLEMENT_SELECTION_SCHEMA_ALLOWED_KEYS,
    )
    if variant_node is None or variant_node.get("type") != "string":
        raise AdapterError(
            f"POST {PROMPT_ASYNC_ENDPOINT} does not admit an optional string variant"
        )
    model_node = _supplement_selection_property_admitted(
        doc,
        properties.get("model"),
        allowed_keys=SUPPLEMENT_MODEL_SCHEMA_ALLOWED_KEYS,
    )
    if (
        model_node is None
        or model_node.get("type") != "object"
        or list(model_node.get("required") or []) != ["providerID", "modelID"]
    ):
        raise AdapterError(
            f"POST {PROMPT_ASYNC_ENDPOINT} does not admit an optional model with "
            "providerID and modelID"
        )
    model_properties = model_node.get("properties")
    model_properties = (
        model_properties if isinstance(model_properties, dict) else {}
    )
    for field in ("providerID", "modelID"):
        node = _supplement_selection_property_admitted(
            doc,
            model_properties.get(field),
            allowed_keys=SUPPLEMENT_SELECTION_SCHEMA_ALLOWED_KEYS,
        )
        if node is None or node.get("type") != "string":
            raise AdapterError(
                f"POST {PROMPT_ASYNC_ENDPOINT} model {field} must be a string"
            )
    return {
        "path": projection["path"],
        "method": projection["method"],
        "present": True,
        "executable": True,
        "reason": "ok",
        "request_fields": ["parts", *SUPPLEMENT_SELECTION_FIELDS],
        "admitted_fields": ["parts", *SUPPLEMENT_SELECTION_FIELDS],
        "required_fields": list(projection["required_fields"]),
        "emitted_optional_fields": list(SUPPLEMENT_SELECTION_FIELDS),
        "content_types": ["application/json"],
        "expects_status": 204,
        "payload_strategy": "prompt_async_parts",
        "projection_digest": prompt_async_supplement_consumed_schema_digest(),
    }


def supplement_selection_payload(
    original_selection: dict[str, Any],
) -> dict[str, Any]:
    """Return the payload fields that pin the bound agent/model/variant."""
    variant = str(original_selection.get("variant") or "").strip()
    return {
        "agent": str(original_selection.get("agent") or "").strip(),
        "model": {
            "providerID": str(
                (original_selection.get("model") or {}).get("providerID") or ""
            ).strip(),
            "modelID": str(
                (original_selection.get("model") or {}).get("modelID") or ""
            ).strip(),
        },
        "variant": variant or SUPPLEMENT_DEFAULT_VARIANT,
    }


def observed_session_selection(identity: dict[str, Any]) -> dict[str, Any]:
    """Map one bounded session identity snapshot to the bound-selection shape.

    Only the allowlisted identity fields (agent, model providerID/id/variant)
    are consumed; no message history or all-session read is involved.
    """
    return {
        "agent": str(identity.get("observed_agent") or ""),
        "model": {
            "providerID": str(
                (identity.get("observed_model") or {}).get("providerID") or ""
            ),
            "modelID": str(
                (identity.get("observed_model") or {}).get("id") or ""
            ),
        },
        "variant": str(
            (identity.get("observed_model") or {}).get("variant") or ""
        ),
    }


def session_selection_errors(
    observed: dict[str, Any],
    bound: dict[str, Any],
) -> list[str]:
    """Compare bounded session identity metadata with the bound selection."""
    errors: list[str] = []
    observed_agent = str(observed.get("agent") or "").strip()
    if not observed_agent:
        errors.append("bound session reports no agent; preservation is unverifiable")
    elif observed_agent != str(bound.get("agent") or "").strip():
        errors.append(
            f"session agent {observed_agent!r} does not match the bound agent"
        )
    observed_model = (
        observed.get("model") if isinstance(observed.get("model"), dict) else {}
    )
    provider_id = str(observed_model.get("providerID") or "").strip()
    model_id = str(observed_model.get("id") or observed_model.get("modelID") or "").strip()
    if not provider_id or not model_id:
        errors.append("bound session reports no model; preservation is unverifiable")
    else:
        bound_model = bound.get("model") if isinstance(bound.get("model"), dict) else {}
        if (
            provider_id != str(bound_model.get("providerID") or "").strip()
            or model_id != str(bound_model.get("modelID") or "").strip()
        ):
            errors.append(
                f"session model {provider_id}/{model_id} does not match the bound model"
            )
    observed_variant = str(observed.get("variant") or "").strip()
    if observed_variant == SUPPLEMENT_DEFAULT_VARIANT:
        observed_variant = ""
    bound_variant = str(bound.get("variant") or "").strip()
    if bound_variant == SUPPLEMENT_DEFAULT_VARIANT:
        bound_variant = ""
    if observed_variant != bound_variant:
        errors.append(
            f"session variant {observed_variant!r} does not match the bound variant"
        )
    return errors


def interrupt_selection_guard(
    *,
    original_selection: dict[str, Any],
    selection_evidence: str,
) -> dict[str, Any]:
    """Fail closed when the host-bound task selection is incomplete.

    The interrupt carries no body, so the selection is never sent; it is
    re-verified against the live bounded session identity so a stop can only
    proceed against the exact task selection recorded by the dispatch grant.
    """
    bound_model = (
        original_selection.get("model")
        if isinstance(original_selection.get("model"), dict)
        else {}
    )
    if (
        not str(original_selection.get("agent") or "").strip()
        or not str(bound_model.get("providerID") or "").strip()
        or not str(bound_model.get("modelID") or "").strip()
    ):
        raise AdapterError(
            "interrupt_selection_unsupported: the bound original selection "
            "is incomplete; nonempty agent, model.providerID and "
            "model.modelID are required"
        )
    if not str(selection_evidence or "").strip():
        raise AdapterError(
            "interrupt_selection_unsupported: no selection evidence source"
        )
    return {
        "admitted": True,
        "selection_fields": [],
        "selection_evidence": str(selection_evidence),
    }


def session_abort_operation_schema(doc: dict[str, Any]) -> dict[str, Any]:
    """Real schema check for the pinned session abort interface.

    The declared POST /session/{sessionID}/abort must carry no required
    request body and a 200 response whose application/json schema admits a
    boolean. Every $ref is resolved against the same document before the
    type is checked; other response entries are unconsumed.
    """
    paths = doc.get("paths") if isinstance(doc, dict) else None
    path_item = paths.get(SESSION_ABORT_ENDPOINT) if isinstance(paths, dict) else None
    if not isinstance(path_item, dict):
        raise AdapterError(f"/doc does not declare {SESSION_ABORT_ENDPOINT}")
    operation = path_item.get("post")
    if not isinstance(operation, dict):
        raise AdapterError(f"/doc does not declare POST {SESSION_ABORT_ENDPOINT}")
    request_body = operation.get("requestBody")
    if request_body is not None:
        body = resolve_openapi_ref(doc, request_body)
        if isinstance(body, dict) and body.get("required") is True:
            raise AdapterError(
                f"POST {SESSION_ABORT_ENDPOINT} must not require a request body"
            )
    responses = operation.get("responses")
    if not isinstance(responses, dict) or "200" not in responses:
        raise AdapterError(
            f"POST {SESSION_ABORT_ENDPOINT} does not declare a 200 response"
        )
    response = resolve_openapi_ref(doc, responses.get("200"))
    content = response.get("content") if isinstance(response, dict) else None
    media = content.get("application/json") if isinstance(content, dict) else None
    schema = resolve_openapi_ref(
        doc,
        media.get("schema") if isinstance(media, dict) else None,
    )
    if not isinstance(schema, dict) or schema.get("type") != "boolean":
        raise AdapterError(
            f"POST {SESSION_ABORT_ENDPOINT} 200 response must be a JSON boolean"
        )
    return {
        "admitted": True,
        "response_status": "200",
        "response_type": "boolean",
    }


def safe_http_session_abort_post(
    hostname: str,
    port: int,
    session_id: str,
    timeout: float = 6.0,
) -> dict[str, Any]:
    """One bodyless POST to the pinned session abort endpoint; never retried."""
    if not PROMPT_ASYNC_SESSION_ID_RE.fullmatch(session_id or ""):
        raise AdapterError(f"unsafe opencode session id for session abort: {session_id!r}")
    path = f"/session/{quote(session_id, safe='')}/abort"
    result = _safe_http_json_post(
        hostname,
        port,
        path,
        None,
        timeout=timeout,
        allowed_paths={path},
        label="server-session-abort",
    )
    response_boolean: bool | None = None
    if result.get("status") == 200:
        try:
            parsed = json.loads(str(result.get("body_head") or ""))
        except json.JSONDecodeError:
            parsed = None
        if isinstance(parsed, bool):
            response_boolean = parsed
    result["ok"] = bool(
        result.get("reachable")
        and result.get("status") == 200
        and isinstance(response_boolean, bool)
    )
    result["response_boolean"] = response_boolean
    return result


def safe_http_prompt_async_post(
    hostname: str,
    port: int,
    session_id: str,
    text: str,
    timeout: float = 6.0,
    extra_fields: dict[str, Any] | None = None,
) -> dict[str, Any]:
    if not PROMPT_ASYNC_SESSION_ID_RE.fullmatch(session_id or ""):
        raise AdapterError(f"unsafe opencode session id for prompt_async: {session_id!r}")
    path = f"/session/{quote(session_id, safe='')}/prompt_async"
    payload: dict[str, Any] = {"parts": [{"type": "text", "text": text}]}
    if extra_fields:
        payload.update(extra_fields)
    result = _safe_http_json_post(
        hostname,
        port,
        path,
        payload,
        timeout=timeout,
        allowed_paths={path},
        label="server-prompt-async",
    )
    result["ok"] = bool(result.get("reachable") and result.get("status") == 204)
    return result


def cold_start_task_directory_permission(task_dir: Path) -> list[dict[str, str]]:
    return [
        {
            "permission": COLD_START_EXTERNAL_DIRECTORY_PERMISSION,
            "pattern": "*",
            "action": "deny",
        },
        {
            "permission": COLD_START_EXTERNAL_DIRECTORY_PERMISSION,
            "pattern": f"{os.path.realpath(task_dir)}/*",
            "action": "allow",
        },
    ]


def safe_http_session_create_post(
    hostname: str,
    port: int,
    title: str,
    permission: list[dict[str, str]],
    timeout: float = 6.0,
    *,
    selection: dict[str, Any] | None = None,
) -> dict[str, Any]:
    payload: dict[str, Any] = {"title": title, "permission": permission}
    if selection is not None:
        supplement_selection_guard(
            original_selection=selection, selection_evidence="rotation session identity",
        )
        payload.update(agent=selection["agent"], model={
            "id": selection["model"]["modelID"],
            "providerID": selection["model"]["providerID"],
            "variant": selection["variant"],
        })
    result = _safe_http_json_post(
        hostname,
        port,
        SESSION_CREATE_ENDPOINT,
        payload,
        timeout=timeout,
        allowed_paths={SESSION_CREATE_ENDPOINT},
        label="server-session-create",
    )
    result["ok"] = bool(
        result.get("reachable")
        and result.get("status") == 200
        and not result.get("truncated")
        and not result.get("compressed")
        and "json" in str(result.get("content_type") or "").lower()
    )
    return result


def safe_http_session_title_patch(
    hostname: str,
    port: int,
    session_id: str,
    title: str,
    timeout: float = 6.0,
) -> dict[str, Any]:
    """One PATCH /session/{sessionID} {title}; display-only; never retried."""
    if not PROMPT_ASYNC_SESSION_ID_RE.fullmatch(session_id or ""):
        raise AdapterError(
            f"unsafe opencode session id for session title update: {session_id!r}"
        )
    if not isinstance(title, str) or not title.strip():
        raise AdapterError("session title update requires a non-empty title")
    path = f"/session/{quote(session_id, safe='')}"
    result = _safe_http_json_post(
        hostname,
        port,
        path,
        {"title": title},
        timeout=timeout,
        allowed_paths={path},
        label="server-session-title-update",
        method="PATCH",
    )
    result["ok"] = bool(
        result.get("reachable")
        and result.get("status") == 200
        and not result.get("truncated")
        and not result.get("compressed")
        and "json" in str(result.get("content_type") or "").lower()
    )
    return result


def safe_http_tui_select_session_post(
    hostname: str,
    port: int,
    session_id: str,
    timeout: float = 6.0,
) -> dict[str, Any]:
    if not PROMPT_ASYNC_SESSION_ID_RE.fullmatch(session_id or ""):
        raise AdapterError(
            f"unsafe opencode session id for select-session: {session_id!r}"
        )
    result = _safe_http_json_post(
        hostname,
        port,
        TUI_SELECT_SESSION_ENDPOINT,
        {"sessionID": session_id},
        timeout=timeout,
        allowed_paths={TUI_SELECT_SESSION_ENDPOINT},
        label="tui-select-session",
    )
    result["ok"] = bool(
        result.get("reachable")
        and result.get("status") == 200
        and str(result.get("body_head") or "").strip() == "true"
    )
    return result


_SUPPORTED_SUBSET = PROMPT_ASYNC_CONSUMED_PROJECTION["supported_subset"]
_ROOT_SCHEMA_ALLOWED_KEYS = frozenset(_SUPPORTED_SUBSET["root_allowed_keys"])
_PARTS_SCHEMA_ALLOWED_KEYS = frozenset(_SUPPORTED_SUBSET["parts_allowed_keys"])
_ITEMS_ANYOF_ALLOWED_KEYS = frozenset(_SUPPORTED_SUBSET["items_anyof_allowed_keys"])
_PART_CANDIDATE_ALLOWED_KEYS = frozenset(
    _SUPPORTED_SUBSET["part_candidate_allowed_keys"]
)
_DISCRIMINATOR_ALLOWED_KEYS = frozenset(_SUPPORTED_SUBSET["discriminator_allowed_keys"])
_TEXT_PROPERTY_ALLOWED_KEYS = frozenset(_SUPPORTED_SUBSET["text_property_allowed_keys"])


def _schema_keys_supported(node: dict[str, Any], allowed: frozenset[str]) -> bool:
    return all(key in allowed for key in node)


def _additional_properties_value_supported(value: Any) -> bool:
    return isinstance(value, (bool, dict))


def prompt_async_text_part_admitted(doc: dict[str, Any], candidate: Any) -> bool:
    candidate = resolve_openapi_ref(doc, candidate)
    if not isinstance(candidate, dict):
        return False
    if not _schema_keys_supported(candidate, _PART_CANDIDATE_ALLOWED_KEYS):
        return False
    if candidate.get("type") != "object":
        return False
    if "additionalProperties" in candidate and not _additional_properties_value_supported(
        candidate["additionalProperties"]
    ):
        return False
    if "required" in candidate:
        required_raw = candidate["required"]
        if not isinstance(required_raw, list) or not all(
            isinstance(item, str) for item in required_raw
        ):
            return False
        required = [str(item) for item in required_raw]
    else:
        required = []
    if any(field not in {"type", "text"} for field in required):
        return False
    properties = candidate.get("properties", {})
    if not isinstance(properties, dict):
        return False
    discriminator = resolve_openapi_ref(doc, properties.get("type"))
    if not isinstance(discriminator, dict) or discriminator.get("type") != "string":
        return False
    if not _schema_keys_supported(discriminator, _DISCRIMINATOR_ALLOWED_KEYS):
        return False
    if "enum" in discriminator:
        enum = discriminator["enum"]
        if not isinstance(enum, list) or not all(
            isinstance(item, str) for item in enum
        ):
            return False
        if "text" not in enum:
            return False
    if "const" in discriminator:
        if discriminator["const"] != "text":
            return False
    text_property = resolve_openapi_ref(doc, properties.get("text"))
    if not isinstance(text_property, dict) or text_property.get("type") != "string":
        return False
    if not _schema_keys_supported(text_property, _TEXT_PROPERTY_ALLOWED_KEYS):
        return False
    return True


def require_prompt_async_text_part_item(doc: dict[str, Any], parts_schema: dict[str, Any]) -> None:
    items = resolve_openapi_ref(doc, parts_schema.get("items"))
    if not isinstance(items, dict):
        raise AdapterError(
            f"POST {PROMPT_ASYNC_ENDPOINT} parts items must admit a text part object"
        )
    if "anyOf" in items:
        if not _schema_keys_supported(items, _ITEMS_ANYOF_ALLOWED_KEYS):
            raise AdapterError(
                f"POST {PROMPT_ASYNC_ENDPOINT} parts items anyOf has unsupported sibling keys"
            )
        alternatives = items["anyOf"]
        if (
            not isinstance(alternatives, list)
            or not alternatives
            or not all(isinstance(item, dict) for item in alternatives)
        ):
            raise AdapterError(
                f"POST {PROMPT_ASYNC_ENDPOINT} parts items anyOf must be a non-empty list of schemas"
            )
        candidates = alternatives
    else:
        candidates = [items]
    if any(prompt_async_text_part_admitted(doc, candidate) for candidate in candidates):
        return
    raise AdapterError(
        f"POST {PROMPT_ASYNC_ENDPOINT} parts items do not admit the emitted text part"
    )


def canonical_prompt_async_operation(doc: dict[str, Any]) -> dict[str, Any]:
    paths = doc.get("paths", {}) if isinstance(doc, dict) else {}
    path_item = paths.get(PROMPT_ASYNC_ENDPOINT) if isinstance(paths, dict) else None
    if not isinstance(path_item, dict):
        raise AdapterError(f"/doc does not declare {PROMPT_ASYNC_ENDPOINT}")
    operation = path_item.get("post")
    if not isinstance(operation, dict):
        raise AdapterError(f"/doc does not declare POST {PROMPT_ASYNC_ENDPOINT}")
    request_body = operation.get("requestBody", {})
    if isinstance(request_body, dict):
        request_body = resolve_openapi_ref(doc, request_body)
    content = request_body.get("content", {}) if isinstance(request_body, dict) else {}
    if not isinstance(content, dict) or "application/json" not in content:
        raise AdapterError(
            f"POST {PROMPT_ASYNC_ENDPOINT} does not declare application/json"
        )
    json_entry = content.get("application/json")
    schema = json_entry.get("schema", {}) if isinstance(json_entry, dict) else {}
    schema = resolve_openapi_ref(doc, schema)
    if not isinstance(schema, dict) or schema.get("type") != "object":
        raise AdapterError(
            f"POST {PROMPT_ASYNC_ENDPOINT} request schema must be an object"
        )
    if not _schema_keys_supported(schema, _ROOT_SCHEMA_ALLOWED_KEYS):
        raise AdapterError(
            f"POST {PROMPT_ASYNC_ENDPOINT} request schema has unsupported keys"
        )
    if "additionalProperties" in schema and not _additional_properties_value_supported(
        schema["additionalProperties"]
    ):
        raise AdapterError(
            f"POST {PROMPT_ASYNC_ENDPOINT} request schema additionalProperties must be a boolean or mapping"
        )
    required_raw = schema.get("required", []) if isinstance(schema.get("required", []), list) else []
    required_fields = [str(item) for item in required_raw]
    if required_fields != ["parts"]:
        raise AdapterError(
            f"POST {PROMPT_ASYNC_ENDPOINT} required request fields must be exactly ['parts']"
        )
    properties = schema.get("properties", {}) if isinstance(schema.get("properties", {}), dict) else {}
    parts_schema = properties.get("parts")
    parts_schema = resolve_openapi_ref(doc, parts_schema) if isinstance(parts_schema, dict) else {}
    if not isinstance(parts_schema, dict) or parts_schema.get("type") != "array":
        raise AdapterError(f"POST {PROMPT_ASYNC_ENDPOINT} parts must be a required array")
    if not _schema_keys_supported(parts_schema, _PARTS_SCHEMA_ALLOWED_KEYS):
        raise AdapterError(
            f"POST {PROMPT_ASYNC_ENDPOINT} parts schema has unsupported keys"
        )
    require_prompt_async_text_part_item(doc, parts_schema)
    responses = operation.get("responses", {})
    if not isinstance(responses, dict) or "204" not in responses:
        raise AdapterError(f"POST {PROMPT_ASYNC_ENDPOINT} does not declare a 204 response")
    response_204 = resolve_openapi_ref(doc, responses["204"])
    if not isinstance(response_204, dict) or "$ref" in response_204:
        raise AdapterError(
            f"POST {PROMPT_ASYNC_ENDPOINT} 204 response must resolve to a mapping"
        )
    return dict(PROMPT_ASYNC_CONSUMED_PROJECTION)


def server_prompt_async_operation_schema(doc: dict[str, Any]) -> dict[str, Any]:
    projection = canonical_prompt_async_operation(doc)
    return {
        "path": projection["path"],
        "method": projection["method"],
        "present": True,
        "executable": True,
        "reason": "ok",
        "request_fields": list(projection["required_fields"]),
        "required_fields": list(projection["required_fields"]),
        "content_types": ["application/json"],
        "expects_status": 204,
        "payload_strategy": "prompt_async_parts",
        "projection_digest": prompt_async_consumed_schema_digest(),
    }


def canonical_session_create_operation(doc: dict[str, Any]) -> dict[str, Any]:
    paths = doc.get("paths", {}) if isinstance(doc, dict) else {}
    path_item = paths.get(SESSION_CREATE_ENDPOINT) if isinstance(paths, dict) else None
    operation = path_item.get("post") if isinstance(path_item, dict) else None
    if not isinstance(operation, dict):
        raise AdapterError("OpenAPI does not declare POST /session")
    request_body = resolve_openapi_ref(doc, operation.get("requestBody", {}))
    content = request_body.get("content", {}) if isinstance(request_body, dict) else {}
    json_entry = content.get("application/json") if isinstance(content, dict) else None
    request_schema = (
        resolve_openapi_ref(doc, json_entry.get("schema"))
        if isinstance(json_entry, dict)
        else None
    )
    if not isinstance(request_schema, dict) or request_schema.get("type") != "object":
        raise AdapterError("POST /session request schema must be an object")
    if not _schema_keys_supported(request_schema, _ROOT_SCHEMA_ALLOWED_KEYS):
        raise AdapterError("POST /session request schema has unsupported keys")
    if (
        "additionalProperties" in request_schema
        and not _additional_properties_value_supported(
            request_schema["additionalProperties"]
        )
    ):
        raise AdapterError(
            "POST /session request additionalProperties must be boolean or mapping"
        )
    required = request_schema.get("required", [])
    if not isinstance(required, list) or required:
        raise AdapterError("POST /session request must not require unemitted fields")
    properties = request_schema.get("properties")
    title_schema = (
        resolve_openapi_ref(doc, properties.get("title"))
        if isinstance(properties, dict)
        else None
    )
    if (
        not isinstance(title_schema, dict)
        or title_schema.get("type") != "string"
        or any(key not in _TEXT_PROPERTY_ALLOWED_KEYS for key in title_schema)
    ):
        raise AdapterError("POST /session title must be an unrestricted string")
    permission_schema = (
        resolve_openapi_ref(doc, properties.get("permission"))
        if isinstance(properties, dict)
        else None
    )
    if (
        not isinstance(permission_schema, dict)
        or permission_schema.get("type") != "array"
        or not _schema_keys_supported(
            permission_schema,
            _PARTS_SCHEMA_ALLOWED_KEYS | {"additionalProperties"},
        )
    ):
        raise AdapterError("POST /session permission must be an array")
    permission_items = resolve_openapi_ref(doc, permission_schema.get("items"))
    if (
        not isinstance(permission_items, dict)
        or permission_items.get("type") != "object"
        or not _schema_keys_supported(permission_items, _ROOT_SCHEMA_ALLOWED_KEYS)
    ):
        raise AdapterError("POST /session permission items must be objects")
    item_required = permission_items.get("required")
    item_properties = permission_items.get("properties")
    needed = set(SESSION_CREATE_CONSUMED_PROJECTION["permission_item_fields"])
    if not isinstance(item_required, list) or set(item_required) != needed:
        raise AdapterError(
            "POST /session permission items must require action, pattern, and permission"
        )
    if not isinstance(item_properties, dict):
        raise AdapterError("POST /session permission item properties are missing")
    for field in SESSION_CREATE_CONSUMED_PROJECTION["permission_item_fields"]:
        field_schema = resolve_openapi_ref(doc, item_properties.get(field))
        allowed_keys = (
            _TEXT_PROPERTY_ALLOWED_KEYS | {"enum"}
            if field == "action"
            else _TEXT_PROPERTY_ALLOWED_KEYS
        )
        if (
            not isinstance(field_schema, dict)
            or field_schema.get("type") != "string"
            or any(key not in allowed_keys for key in field_schema)
            or (
                field == "action"
                and "enum" in field_schema
                and (
                    not isinstance(field_schema.get("enum"), list)
                    or "allow" not in field_schema["enum"]
                    or "deny" not in field_schema["enum"]
                )
            )
        ):
            raise AdapterError(
                f"POST /session permission {field} is outside the consumed schema"
            )
    responses = operation.get("responses")
    response = (
        resolve_openapi_ref(doc, responses.get("200"))
        if isinstance(responses, dict)
        else None
    )
    response_content = response.get("content", {}) if isinstance(response, dict) else {}
    response_json = (
        response_content.get("application/json")
        if isinstance(response_content, dict)
        else None
    )
    response_schema = (
        resolve_openapi_ref(doc, response_json.get("schema"))
        if isinstance(response_json, dict)
        else None
    )
    if not isinstance(response_schema, dict) or response_schema.get("type") != "object":
        raise AdapterError("POST /session 200 response schema must be an object")
    if not _schema_keys_supported(response_schema, _ROOT_SCHEMA_ALLOWED_KEYS):
        raise AdapterError("POST /session response schema has unsupported keys")
    if (
        "additionalProperties" in response_schema
        and not _additional_properties_value_supported(
            response_schema["additionalProperties"]
        )
    ):
        raise AdapterError(
            "POST /session response additionalProperties must be boolean or mapping"
        )
    response_required = response_schema.get("required")
    response_properties = response_schema.get("properties")
    consumed = SESSION_CREATE_CONSUMED_PROJECTION["consumed_response_fields"]
    if not isinstance(response_required, list) or not set(consumed).issubset(response_required):
        raise AdapterError("POST /session response must require id, title, and directory")
    if not isinstance(response_properties, dict):
        raise AdapterError("POST /session response properties are missing")
    for field in consumed:
        field_schema = resolve_openapi_ref(doc, response_properties.get(field))
        allowed_keys = (
            _TEXT_PROPERTY_ALLOWED_KEYS | {"pattern"}
            if field == "id"
            else _TEXT_PROPERTY_ALLOWED_KEYS
        )
        if (
            not isinstance(field_schema, dict)
            or field_schema.get("type") != "string"
            or any(key not in allowed_keys for key in field_schema)
            or (
                field == "id"
                and field_schema.get("pattern")
                != SESSION_CREATE_CONSUMED_PROJECTION["id_pattern"]
            )
        ):
            raise AdapterError(
                f"POST /session response {field} is outside the consumed schema"
            )
    return dict(SESSION_CREATE_CONSUMED_PROJECTION)


SESSION_TITLE_UPDATE_ENDPOINT_TEMPLATE = "/session/{sessionID}"


def canonical_session_title_update_operation(doc: dict[str, Any]) -> dict[str, Any]:
    """Minimal consumed contract for the display-only PATCH session title update.

    Only what this entry actually emits and treats as success is checked:
    the /doc declares a patch operation on the session path whose JSON body
    is an object carrying a string ``title`` property, and a 200 response.
    The resulting title is proven by the GET read-back, so response body
    details and unconsumed schema fields stay unconstrained here.
    """
    paths = doc.get("paths", {}) if isinstance(doc, dict) else {}
    path_item = (
        paths.get(SESSION_TITLE_UPDATE_ENDPOINT_TEMPLATE)
        if isinstance(paths, dict)
        else None
    )
    operation = path_item.get("patch") if isinstance(path_item, dict) else None
    if not isinstance(operation, dict):
        raise AdapterError(
            "OpenAPI does not declare PATCH /session/{sessionID}"
        )
    request_body = resolve_openapi_ref(doc, operation.get("requestBody", {}))
    content = request_body.get("content", {}) if isinstance(request_body, dict) else {}
    json_entry = content.get("application/json") if isinstance(content, dict) else None
    request_schema = (
        resolve_openapi_ref(doc, json_entry.get("schema"))
        if isinstance(json_entry, dict)
        else None
    )
    if not isinstance(request_schema, dict) or request_schema.get("type") != "object":
        raise AdapterError(
            "PATCH /session/{sessionID} request schema must be an object"
        )
    properties = request_schema.get("properties")
    title_schema = (
        resolve_openapi_ref(doc, properties.get("title"))
        if isinstance(properties, dict)
        else None
    )
    if not isinstance(title_schema, dict) or title_schema.get("type") != "string":
        raise AdapterError(
            "PATCH /session/{sessionID} must declare a string title property"
        )
    responses = operation.get("responses")
    response = (
        resolve_openapi_ref(doc, responses.get("200"))
        if isinstance(responses, dict)
        else None
    )
    if not isinstance(response, dict):
        raise AdapterError(
            "PATCH /session/{sessionID} must declare a 200 response"
        )
    return {
        "path": SESSION_TITLE_UPDATE_ENDPOINT_TEMPLATE,
        "method": "PATCH",
        "emitted_fields": ["title"],
        "title_property_type": "string",
        "response_status": "200",
    }


def canonical_tui_select_session_operation(doc: dict[str, Any]) -> dict[str, Any]:
    paths = doc.get("paths", {}) if isinstance(doc, dict) else {}
    path_item = (
        paths.get(TUI_SELECT_SESSION_ENDPOINT) if isinstance(paths, dict) else None
    )
    operation = path_item.get("post") if isinstance(path_item, dict) else None
    if not isinstance(operation, dict):
        raise AdapterError("OpenAPI does not declare POST /tui/select-session")
    request_body = resolve_openapi_ref(doc, operation.get("requestBody", {}))
    content = request_body.get("content", {}) if isinstance(request_body, dict) else {}
    json_entry = content.get("application/json") if isinstance(content, dict) else None
    request_schema = (
        resolve_openapi_ref(doc, json_entry.get("schema"))
        if isinstance(json_entry, dict)
        else None
    )
    if not isinstance(request_schema, dict) or request_schema.get("type") != "object":
        raise AdapterError("POST /tui/select-session request schema must be an object")
    if not _schema_keys_supported(request_schema, _ROOT_SCHEMA_ALLOWED_KEYS):
        raise AdapterError("POST /tui/select-session request schema has unsupported keys")
    required = request_schema.get("required")
    if not isinstance(required, list) or set(required) != {"sessionID"}:
        raise AdapterError("POST /tui/select-session must require only sessionID")
    properties = request_schema.get("properties")
    session_schema = (
        resolve_openapi_ref(doc, properties.get("sessionID"))
        if isinstance(properties, dict)
        else None
    )
    if (
        not isinstance(session_schema, dict)
        or session_schema.get("type") != "string"
        or any(
            key not in (_TEXT_PROPERTY_ALLOWED_KEYS | {"pattern"})
            for key in session_schema
        )
    ):
        raise AdapterError("POST /tui/select-session sessionID must be a string")
    if "pattern" in session_schema:
        pattern = session_schema.get("pattern")
        if pattern != TUI_SELECT_SESSION_CONSUMED_PROJECTION["session_id_pattern"]:
            raise AdapterError(
                "POST /tui/select-session sessionID pattern must be ^ses"
            )
    responses = operation.get("responses")
    response = (
        resolve_openapi_ref(doc, responses.get("200"))
        if isinstance(responses, dict)
        else None
    )
    response_content = response.get("content", {}) if isinstance(response, dict) else {}
    response_json = (
        response_content.get("application/json")
        if isinstance(response_content, dict)
        else None
    )
    response_schema = (
        resolve_openapi_ref(doc, response_json.get("schema"))
        if isinstance(response_json, dict)
        else None
    )
    if not isinstance(response_schema, dict) or response_schema.get("type") != "boolean":
        raise AdapterError("POST /tui/select-session 200 schema must be boolean")
    return dict(TUI_SELECT_SESSION_CONSUMED_PROJECTION)


def require_rotation_selection_schema(doc: dict[str, Any]) -> None:
    """Admit the current public create/select route, without changing canary digests."""
    canonical_session_create_operation(doc)
    canonical_tui_select_session_operation(doc)
    operation = doc["paths"][SESSION_CREATE_ENDPOINT]["post"]
    body = resolve_openapi_ref(doc, operation["requestBody"])
    schema = resolve_openapi_ref(doc, body["content"]["application/json"]["schema"])
    properties = schema.get("properties") or {}
    agent = resolve_openapi_ref(doc, properties.get("agent"))
    model = resolve_openapi_ref(doc, properties.get("model"))
    if (
        not isinstance(agent, dict) or agent.get("type") != "string"
        or not _schema_keys_supported(agent, _TEXT_PROPERTY_ALLOWED_KEYS)
        or not isinstance(model, dict) or model.get("type") != "object"
        or not _schema_keys_supported(model, _ROOT_SCHEMA_ALLOWED_KEYS)
        or not isinstance(model.get("required", []), list)
        or set(model.get("required", [])) - {"id", "providerID", "variant"}
    ):
        raise AdapterError("model_selection_unsupported: POST /session selection schema")
    for field in ("id", "providerID", "variant"):
        item = resolve_openapi_ref(doc, (model.get("properties") or {}).get(field))
        if (
            not isinstance(item, dict) or item.get("type") != "string"
            or not _schema_keys_supported(item, _TEXT_PROPERTY_ALLOWED_KEYS)
        ):
            raise AdapterError(f"model_selection_unsupported: POST /session model.{field}")


def http_get_limited(url: str, timeout: float = 2.0, limit: int = 8192, include_body_text: bool = False) -> dict[str, Any]:
    parsed = urlparse(url)
    if parsed.scheme != "http" or parsed.hostname not in {"127.0.0.1", "localhost"} or not parsed.port:
        raise AdapterError("http_get_limited only allows localhost http URLs")
    path = parsed.path or "/"
    if parsed.query:
        path += "?" + parsed.query
    return safe_http_request(parsed.hostname, int(parsed.port), path, "GET", timeout=timeout, limit=limit, include_body_text=include_body_text)


def detect_tui_methods(doc_text: str) -> list[str]:
    return [endpoint for endpoint in TUI_ENDPOINTS if endpoint in doc_text]


def summarize_doc(doc_text: str) -> dict[str, Any]:
    summary: dict[str, Any] = {
        "openapi_version": "",
        "title": "",
        "version": "",
        "paths": {},
    }
    for endpoint in [
        "/global/health",
        "/doc",
        "/session/status",
        "/global/event",
        "/event",
        *TUI_ENDPOINTS,
    ]:
        summary["paths"][endpoint] = endpoint in doc_text

    try:
        parsed = json.loads(doc_text)
    except Exception:
        return summary
    if isinstance(parsed, dict):
        summary["openapi_version"] = str(parsed.get("openapi", "") or parsed.get("swagger", ""))
        info = parsed.get("info", {})
        if isinstance(info, dict):
            summary["title"] = str(info.get("title", ""))
            summary["version"] = str(info.get("version", ""))
        paths = parsed.get("paths", {})
        if isinstance(paths, dict):
            for endpoint in summary["paths"]:
                summary["paths"][endpoint] = endpoint in paths
    return summary


def fetch_openapi_doc(root: Path, port: int) -> dict[str, Any]:
    record = safe_http_request("127.0.0.1", port, "/doc", "GET", timeout=3.0, limit=MAX_DOC_BYTES, include_body_text=True)
    if not record.get("ok") or record.get("status") != 200:
        raise AdapterError(
            f"GET /doc on port {port} did not return a successful HTTP 200 response"
        )
    doc_text = str(record.get("body_text", ""))
    try:
        parsed = json.loads(doc_text)
    except Exception as exc:
        raise AdapterError(f"GET /doc on port {port} did not return parseable JSON: {exc}") from exc
    if not isinstance(parsed, dict):
        raise AdapterError(f"GET /doc on port {port} returned JSON but not an object")
    return {
        "http": sanitize_http_record(record, include_body_head=False),
        "doc": parsed,
        "doc_text_sha256": hashlib.sha256(doc_text.encode("utf-8")).hexdigest(),
    }


def resolve_openapi_ref(doc: dict[str, Any], value: Any, depth: int = 0) -> Any:
    if depth > 8 or not isinstance(value, dict):
        return value
    ref = value.get("$ref")
    if not isinstance(ref, str) or not ref.startswith("#/"):
        return value
    current: Any = doc
    for part in ref[2:].split("/"):
        part = part.replace("~1", "/").replace("~0", "~")
        if not isinstance(current, dict) or part not in current:
            return value
        current = current[part]
    if isinstance(current, dict):
        merged = dict(current)
        for key, item in value.items():
            if key != "$ref":
                merged[key] = item
        return resolve_openapi_ref(doc, merged, depth + 1)
    return current


def json_schema_from_request_body(doc: dict[str, Any], operation: dict[str, Any]) -> tuple[list[str], dict[str, Any]]:
    request_body = operation.get("requestBody", {})
    if not isinstance(request_body, dict):
        return [], {}
    request_body = resolve_openapi_ref(doc, request_body)
    if not isinstance(request_body, dict):
        return [], {}
    content = request_body.get("content", {})
    if not isinstance(content, dict):
        return [], {}
    content_types = [str(key) for key in content.keys()]
    json_content = None
    for content_type in content_types:
        if content_type == "application/json" or content_type.endswith("+json") or "json" in content_type:
            json_content = content.get(content_type)
            break
    if not isinstance(json_content, dict):
        return content_types, {}
    schema = json_content.get("schema", {})
    schema = resolve_openapi_ref(doc, schema)
    return content_types, schema if isinstance(schema, dict) else {}


def endpoint_operation_schema(doc: dict[str, Any], path: str) -> dict[str, Any]:
    paths = doc.get("paths", {})
    path_item = paths.get(path) if isinstance(paths, dict) else None
    if not isinstance(path_item, dict):
        return {
            "path": path,
            "method": "POST",
            "present": False,
            "executable": False,
            "reason": "path missing from /doc",
        }
    operation = path_item.get("post")
    if not isinstance(operation, dict):
        return {
            "path": path,
            "method": "POST",
            "present": True,
            "executable": False,
            "reason": "POST operation missing from /doc path item",
        }
    request_body = operation.get("requestBody", {})
    has_request_body = isinstance(request_body, dict)
    request_body_required = bool(request_body.get("required", False)) if has_request_body else False
    content_types, schema = json_schema_from_request_body(doc, operation)
    schema_required = schema.get("required", []) if isinstance(schema.get("required", []), list) else []
    required_fields = [str(item) for item in schema_required]
    properties = schema.get("properties", {}) if isinstance(schema.get("properties", {}), dict) else {}
    property_names = [str(key) for key in properties.keys()]
    additional_properties = schema.get("additionalProperties")

    payload_template: dict[str, Any] = {}
    payload_strategy = "empty_object"
    text_field = ""
    command_field = ""
    executable = True
    reason = "ok"

    if path == "/tui/append-prompt":
        text_candidates = [field for field in APPEND_TEXT_FIELDS if field in properties or field in required_fields]
        text_field = text_candidates[0] if text_candidates else ""
        unknown_required = [field for field in required_fields if field not in APPEND_TEXT_FIELDS]
        if not text_field:
            executable = False
            reason = "append-prompt schema does not expose a known text field"
        elif unknown_required:
            executable = False
            reason = f"append-prompt has unsupported required fields: {', '.join(unknown_required)}"
        else:
            payload_template = {text_field: "<prompt_text>"}
            payload_strategy = "prompt_text_field"
    elif path == RESET_COMMAND_ENDPOINT:
        command_candidates = [
            field for field in EXECUTE_COMMAND_FIELDS if field in properties or field in required_fields
        ]
        command_field = command_candidates[0] if command_candidates else ""
        unknown_required = [field for field in required_fields if field not in EXECUTE_COMMAND_FIELDS]
        if not command_field:
            executable = False
            reason = "execute-command schema does not expose a known command field"
        elif unknown_required:
            executable = False
            reason = f"execute-command has unsupported required fields: {', '.join(unknown_required)}"
        else:
            payload_template = {command_field: "<slash_command>"}
            payload_strategy = "slash_command_field"
    else:
        if has_request_body and required_fields:
            executable = False
            reason = f"{path} requires unsupported request fields: {', '.join(required_fields)}"
        elif request_body_required and not schema:
            executable = False
            reason = f"{path} has required requestBody without JSON schema"
        else:
            payload_template = {}
            payload_strategy = "empty_object"

    return {
        "path": path,
        "method": "POST",
        "present": True,
        "operationId": str(operation.get("operationId", "")),
        "summary": str(operation.get("summary", "")),
        "description": str(operation.get("description", "")),
        "requestBody_required": request_body_required,
        "has_requestBody": has_request_body,
        "content_types": content_types,
        "json_schema": schema,
        "required_fields": required_fields,
        "property_names": property_names,
        "additionalProperties": additional_properties,
        "text_field": text_field,
        "command_field": command_field,
        "payload_strategy": payload_strategy,
        "payload_template": payload_template,
        "executable": executable,
        "reason": reason,
    }


def endpoint_schema_for_port(root: Path, port: int) -> dict[str, Any]:
    fetched = fetch_openapi_doc(root, port)
    doc = fetched["doc"]
    endpoints = [endpoint_operation_schema(doc, endpoint) for endpoint in TUI_ENDPOINTS_ORDERED]
    executable = all(item.get("executable") for item in endpoints)
    data = {
        "schema_version": 1,
        "generated_at": utc_now(),
        "root": str(root),
        "port": int(port),
        "base_url": f"http://127.0.0.1:{int(port)}",
        "doc_http": fetched["http"],
        "doc_text_sha256": fetched["doc_text_sha256"],
        "openapi_version": str(doc.get("openapi", "") or doc.get("swagger", "")),
        "info": doc.get("info", {}) if isinstance(doc.get("info", {}), dict) else {},
        "endpoints": endpoints,
        "all_required_endpoints_present": all(item.get("present") for item in endpoints),
        "all_payloads_executable": executable,
        "notes": [
            "GET /doc only. No mutating API was called while generating this schema artifact.",
            "submit-real must fail closed unless all_payloads_executable is true.",
        ],
    }
    fw = ensure_framework(root)
    write_json(fw / f"opencode_tui_endpoint_schema_{int(port)}.json", data)
    aggregate_path = fw / "opencode_tui_endpoint_schema.json"
    aggregate = read_json_safe(aggregate_path)
    if not aggregate:
        aggregate = {
            "schema_version": 1,
            "root": str(root),
            "ports": {},
        }
    aggregate["generated_at"] = utc_now()
    ports = aggregate.setdefault("ports", {})
    ports[str(int(port))] = data
    write_json(aggregate_path, aggregate)
    return data


def reset_endpoint_schema_for_port(root: Path, port: int) -> dict[str, Any]:
    fetched = fetch_openapi_doc(root, port)
    doc = fetched["doc"]
    endpoints = [endpoint_operation_schema(doc, RESET_COMMAND_ENDPOINT)]
    executable = all(item.get("executable") for item in endpoints)
    data = {
        "schema_version": 1,
        "generated_at": utc_now(),
        "root": str(root),
        "port": int(port),
        "base_url": f"http://127.0.0.1:{int(port)}",
        "doc_http": fetched["http"],
        "doc_text_sha256": fetched["doc_text_sha256"],
        "openapi_version": str(doc.get("openapi", "") or doc.get("swagger", "")),
        "info": doc.get("info", {}) if isinstance(doc.get("info", {}), dict) else {},
        "endpoints": endpoints,
        "all_required_endpoints_present": all(item.get("present") for item in endpoints),
        "all_payloads_executable": executable,
        "notes": [
            "GET /doc only. No mutating API was called while generating this reset schema artifact.",
            "execute-command-real must fail closed unless the reset endpoint payload is executable.",
        ],
    }
    fw = ensure_framework(root)
    write_json(fw / f"opencode_tui_reset_endpoint_schema_{int(port)}.json", data)
    return data


def schema_endpoint_by_path(schema_data: dict[str, Any]) -> dict[str, dict[str, Any]]:
    return {str(item.get("path")): item for item in schema_data.get("endpoints", []) if isinstance(item, dict)}


def keyword_presence(text: str) -> dict[str, bool]:
    lower = text.lower()
    return {keyword: keyword.lower() in lower for keyword in EVIDENCE_KEYWORDS}


def endpoint_presence(text: str) -> dict[str, bool]:
    return {endpoint: endpoint.lower() in text.lower() for endpoint in TUI_ENDPOINTS_ORDERED}


def all_required_endpoints(value: dict[str, bool] | list[str] | set[str]) -> bool:
    if isinstance(value, dict):
        return all(value.get(endpoint, False) for endpoint in TUI_ENDPOINTS_ORDERED)
    return all(endpoint in value for endpoint in TUI_ENDPOINTS_ORDERED)


def keyword_contexts(text: str, keywords: tuple[str, ...] = EVIDENCE_KEYWORDS, radius: int = 180, limit: int = 40) -> list[dict[str, str]]:
    contexts: list[dict[str, str]] = []
    lower = text.lower()
    for keyword in keywords:
        start = 0
        keyword_lower = keyword.lower()
        while len(contexts) < limit:
            index = lower.find(keyword_lower, start)
            if index < 0:
                break
            left = max(0, index - radius)
            right = min(len(text), index + len(keyword) + radius)
            contexts.append({
                "keyword": keyword,
                "snippet": text[left:right].replace("\x00", " "),
            })
            start = index + len(keyword)
        if len(contexts) >= limit:
            break
    return contexts


def same_origin_resource_path(value: str) -> str | None:
    value = html.unescape(value).strip()
    if not value or value.startswith(("#", "data:", "mailto:", "javascript:")):
        return None
    parsed = urlparse(value)
    if parsed.scheme or parsed.netloc:
        return None
    joined = urljoin("/doc", value)
    parsed_joined = urlparse(joined)
    if parsed_joined.scheme or parsed_joined.netloc:
        return None
    path = parsed_joined.path or "/"
    if not path.startswith("/"):
        path = "/" + path
    if parsed_joined.query:
        path += "?" + parsed_joined.query
    return path


def extract_doc_resources(doc_text: str) -> list[str]:
    refs: list[str] = []
    patterns = [
        r"<script\b[^>]*\bsrc=[\"']([^\"']+)[\"']",
        r"<link\b[^>]*\bhref=[\"']([^\"']+)[\"']",
    ]
    for pattern in patterns:
        for match in re.finditer(pattern, doc_text, flags=re.IGNORECASE):
            path = same_origin_resource_path(match.group(1))
            if path and path not in refs:
                refs.append(path)
            if len(refs) >= MAX_DOC_RESOURCES:
                return refs
    return refs


def sanitize_http_record(record: dict[str, Any], include_body_head: bool = True) -> dict[str, Any]:
    result = {
        "ok": record.get("ok"),
        "reachable": record.get("reachable"),
        "status": record.get("status"),
        "method": record.get("method"),
        "content_type": record.get("content_type", ""),
        "content_length": record.get("content_length"),
        "content_encoding": record.get("content_encoding", ""),
        "compressed": record.get("compressed", False),
        "bytes_read": record.get("bytes_read", 0),
        "decoded_bytes_read": record.get("decoded_bytes_read", 0),
        "truncated": record.get("truncated", False),
        "timed_out": record.get("timed_out", False),
        "elapsed_seconds": record.get("elapsed_seconds"),
        "error": record.get("error", ""),
        "headers": record.get("headers", {}),
    }
    if include_body_head:
        result["body_head"] = record.get("body_head", "")
    return result


def inspect_doc_for_port(root: Path, port: int) -> dict[str, Any]:
    head = safe_http_request("127.0.0.1", port, "/doc", "HEAD", timeout=2.0, limit=0)
    get = safe_http_request("127.0.0.1", port, "/doc", "GET", timeout=3.0, limit=MAX_DOC_BYTES, include_body_text=True)
    doc_text = str(get.get("body_text", ""))
    doc_keywords = keyword_presence(doc_text)
    doc_endpoints = endpoint_presence(doc_text)
    content_type = str(get.get("content_type", ""))
    is_html = "html" in content_type.lower() or bool(re.search(r"<html|<script|<link", doc_text, flags=re.IGNORECASE))
    is_json = "json" in content_type.lower() or doc_text.lstrip().startswith(("{", "["))

    resources: list[dict[str, Any]] = []
    for path in extract_doc_resources(doc_text) if is_html else []:
        resource = safe_http_request("127.0.0.1", port, path, "GET", timeout=2.0, limit=MAX_DOC_RESOURCE_BYTES, include_body_text=True)
        text = str(resource.get("body_text", ""))
        resources.append({
            "path": path,
            "http": sanitize_http_record(resource, include_body_head=False),
            "body_head": text[:1200],
            "keyword_hits": keyword_presence(text),
            "endpoint_hits": endpoint_presence(text),
            "contexts": keyword_contexts(text, limit=12),
        })
        if len(resources) >= MAX_DOC_RESOURCES:
            break

    resource_endpoint_union = {endpoint: False for endpoint in TUI_ENDPOINTS_ORDERED}
    for resource in resources:
        for endpoint, present in resource.get("endpoint_hits", {}).items():
            resource_endpoint_union[endpoint] = resource_endpoint_union.get(endpoint, False) or bool(present)

    embedded_script_hits: list[dict[str, Any]] = []
    for index, match in enumerate(re.finditer(r"<script\b[^>]*>([\s\S]*?)</script>", doc_text, flags=re.IGNORECASE)):
        body = match.group(1)
        hits = keyword_presence(body)
        endpoint_hits = endpoint_presence(body)
        if any(hits.values()):
            embedded_script_hits.append({
                "index": index,
                "keyword_hits": hits,
                "endpoint_hits": endpoint_hits,
                "contexts": keyword_contexts(body, limit=8),
            })
        if len(embedded_script_hits) >= 20:
            break

    data = {
        "schema_version": 1,
        "generated_at": utc_now(),
        "root": str(root),
        "port": int(port),
        "base_url": f"http://127.0.0.1:{int(port)}",
        "requests": {
            "HEAD /doc": sanitize_http_record(head, include_body_head=False),
            "GET /doc": sanitize_http_record(get, include_body_head=True),
        },
        "doc": {
            "content_type": content_type,
            "content_length": get.get("content_length"),
            "content_encoding": get.get("content_encoding", ""),
            "is_gzip_or_deflate": bool(get.get("compressed", False)),
            "body_head_2000": doc_text[:2000],
            "body_bytes_read": get.get("bytes_read", 0),
            "body_decoded_bytes_read": get.get("decoded_bytes_read", 0),
            "body_total_length": get.get("content_length") or get.get("decoded_bytes_read", 0),
            "truncated": get.get("truncated", False),
            "is_html": is_html,
            "is_json": is_json,
            "keyword_hits": doc_keywords,
            "endpoint_hits": doc_endpoints,
            "contexts": keyword_contexts(doc_text, limit=30),
        },
        "html_resources": {
            "script_src": [item for item in extract_doc_resources(doc_text) if item.endswith((".js", ".mjs")) or ".js" in item],
            "all_same_origin_refs": extract_doc_resources(doc_text),
            "resources_fetched": resources,
            "resource_endpoint_union": resource_endpoint_union,
            "embedded_script_hits": embedded_script_hits,
        },
        "doc_has_all_tui_endpoints": all_required_endpoints(doc_endpoints),
        "resources_have_all_tui_endpoints": all_required_endpoints(resource_endpoint_union),
        "notes": [
            "Only HEAD /doc and GET /doc plus same-origin relative GET resources were used.",
            "No POST, PUT, PATCH, or DELETE requests were sent.",
        ],
    }
    fw = ensure_framework(root)
    write_json(fw / f"opencode_doc_inspection_{int(port)}.json", data)
    snippets = [
        f"# OpenCode /doc snippets for port {int(port)}",
        "",
        "## /doc body head",
        "",
        doc_text[:2000],
        "",
        "## Keyword contexts",
        "",
    ]
    for context in data["doc"]["contexts"]:
        snippets.extend([f"### {context['keyword']}", "", context["snippet"], ""])
    for resource in resources:
        if any(resource.get("endpoint_hits", {}).values()) or any(resource.get("keyword_hits", {}).values()):
            snippets.extend([f"## Resource {resource['path']}", "", resource.get("body_head", ""), ""])
            for context in resource.get("contexts", []):
                snippets.extend([f"### {context['keyword']}", "", context["snippet"], ""])
    (fw / f"opencode_doc_snippets_{int(port)}.txt").write_text("\n".join(snippets), encoding="utf-8")
    return data


def inspect_openapi_candidates_for_port(root: Path, port: int) -> dict[str, Any]:
    candidates: list[dict[str, Any]] = []
    for path in OPENAPI_CANDIDATE_PATHS:
        head = safe_http_request("127.0.0.1", port, path, "HEAD", timeout=2.0, limit=0)
        get = safe_http_request("127.0.0.1", port, path, "GET", timeout=3.0, limit=MAX_DOC_BYTES, include_body_text=True)
        text = str(get.get("body_text", ""))
        content_type = str(get.get("content_type", ""))
        is_json = "json" in content_type.lower() or text.lstrip().startswith(("{", "["))
        is_html = "html" in content_type.lower() or bool(re.search(r"<html|<script|<link", text, flags=re.IGNORECASE))
        parsed_summary: dict[str, Any] = {
            "parsed": False,
            "openapi": "",
            "info_title": "",
            "info_version": "",
            "paths_count": 0,
            "paths_sample": [],
            "tui_paths": [],
            "has_all_required_tui_paths": False,
        }
        if is_json:
            try:
                parsed = json.loads(text)
            except Exception as exc:
                parsed_summary["parse_error"] = str(exc)[:300]
            else:
                if isinstance(parsed, dict):
                    parsed_summary["parsed"] = True
                    parsed_summary["openapi"] = str(parsed.get("openapi", "") or parsed.get("swagger", ""))
                    info = parsed.get("info", {})
                    if isinstance(info, dict):
                        parsed_summary["info_title"] = str(info.get("title", ""))
                        parsed_summary["info_version"] = str(info.get("version", ""))
                    paths = parsed.get("paths", {})
                    if isinstance(paths, dict):
                        keys = sorted(str(key) for key in paths.keys())
                        parsed_summary["paths_count"] = len(keys)
                        parsed_summary["paths_sample"] = keys[:80]
                        parsed_summary["tui_paths"] = [endpoint for endpoint in TUI_ENDPOINTS_ORDERED if endpoint in paths]
                        parsed_summary["has_all_required_tui_paths"] = all_required_endpoints(set(parsed_summary["tui_paths"]))
        candidates.append({
            "path": path,
            "head": sanitize_http_record(head, include_body_head=False),
            "get": sanitize_http_record(get, include_body_head=False),
            "body_head": text[:1000],
            "is_json": is_json,
            "is_html": is_html,
            "keyword_hits": keyword_presence(text),
            "endpoint_hits": endpoint_presence(text),
            "json_summary": parsed_summary,
        })

    data = {
        "schema_version": 1,
        "generated_at": utc_now(),
        "root": str(root),
        "port": int(port),
        "base_url": f"http://127.0.0.1:{int(port)}",
        "candidates": candidates,
        "any_candidate_has_all_tui_endpoints": any(all_required_endpoints(item.get("endpoint_hits", {})) for item in candidates),
        "any_json_has_all_tui_paths": any(item.get("json_summary", {}).get("has_all_required_tui_paths") for item in candidates),
        "notes": [
            "Only HEAD and GET were used against bounded localhost OpenAPI candidate paths.",
            "No POST, PUT, PATCH, or DELETE requests were sent.",
        ],
    }
    write_json(ensure_framework(root) / f"opencode_openapi_candidates_{int(port)}.json", data)
    return data


def route_judgement(head: dict[str, Any], options: dict[str, Any]) -> str:
    records = [head, options]
    for record in records:
        allow = header_value(record.get("headers", {}), "Allow")
        if int(record.get("status") or 0) == 405 and "POST" in allow.upper():
            return "likely_present"
        if record.get("method") == "OPTIONS" and "POST" in allow.upper():
            return "likely_present"
    for record in records:
        if int(record.get("status") or 0) in {200, 204}:
            return "likely_present"
    if all(int(record.get("status") or 0) == 404 for record in records if record.get("reachable")):
        return "likely_absent"
    if any(int(record.get("status") or 0) == 404 for record in records) and not any(int(record.get("status") or 0) in {200, 204, 405} for record in records):
        return "likely_absent"
    return "unknown"


def route_evidence_for_port(root: Path, port: int) -> dict[str, Any]:
    routes: list[dict[str, Any]] = []
    for path in ROUTE_EVIDENCE_PATHS:
        head = safe_http_request("127.0.0.1", port, path, "HEAD", timeout=2.0, limit=0)
        options = safe_http_request("127.0.0.1", port, path, "OPTIONS", timeout=2.0, limit=0)
        headers = {**head.get("headers", {}), **options.get("headers", {})}
        cors = {
            key: value
            for key, value in headers.items()
            if key.lower().startswith("access-control-")
        }
        routes.append({
            "path": path,
            "head": sanitize_http_record(head, include_body_head=False),
            "options": sanitize_http_record(options, include_body_head=False),
            "allow": header_value(options.get("headers", {}), "Allow") or header_value(head.get("headers", {}), "Allow"),
            "cors_headers": cors,
            "head_status": head.get("status"),
            "options_status": options.get("status"),
            "is_404": head.get("status") == 404 or options.get("status") == 404,
            "is_405": head.get("status") == 405 or options.get("status") == 405,
            "is_200_or_204": head.get("status") in {200, 204} or options.get("status") in {200, 204},
            "judgement": route_judgement(head, options),
        })
    required = {
        item["path"]: item["judgement"] == "likely_present"
        for item in routes
        if item["path"] in TUI_ENDPOINTS_ORDERED
    }
    data = {
        "schema_version": 1,
        "generated_at": utc_now(),
        "root": str(root),
        "port": int(port),
        "base_url": f"http://127.0.0.1:{int(port)}",
        "routes": routes,
        "required_route_presence": required,
        "all_required_routes_likely_present": all_required_endpoints(required),
        "notes": [
            "Only HEAD and OPTIONS were used.",
            "405 with Allow: POST, OPTIONS Allow: POST, or 200/204 is treated as likely route presence.",
            "No prompt body was sent and no mutating method was used.",
        ],
    }
    write_json(ensure_framework(root) / f"opencode_route_evidence_{int(port)}.json", data)
    return data


def source_search_scopes() -> tuple[list[Path], dict[str, Any]]:
    opencode_path = shutil.which("opencode")
    info: dict[str, Any] = {"command_v_opencode": opencode_path or "", "scopes": []}
    scopes: list[Path] = []

    def add(path: Path) -> None:
        try:
            resolved = path.resolve()
        except Exception:
            resolved = path
        if resolved.exists() and resolved not in scopes:
            scopes.append(resolved)

    if opencode_path:
        binary = Path(opencode_path)
        try:
            real = binary.resolve()
        except Exception:
            real = binary
        info["readlink_f_opencode"] = str(real)
        add(binary)
        add(real)
        for base in {binary.parent, real.parent}:
            add(base)
            add(base.parent)
            if "opencode" in str(base.parent.parent).lower():
                add(base.parent.parent)
    for scope in scopes:
        info["scopes"].append(str(scope))
    return scopes, info


def run_source_text_search(scopes: list[Path]) -> dict[str, Any]:
    terms = list(dict.fromkeys([*TUI_ENDPOINTS_ORDERED, "appendPrompt", "submitPrompt", "clearPrompt", "append-prompt", "submit-prompt", "clear-prompt"]))
    matches: list[dict[str, str]] = []
    commands: list[dict[str, Any]] = []
    rg = shutil.which("rg")
    if rg and scopes:
        argv = [
            rg,
            "-n",
            "--no-heading",
            "--fixed-strings",
            "--hidden",
            "--max-filesize",
            "5M",
        ]
        for term in terms:
            argv.extend(["-e", term])
        argv.extend(str(scope) for scope in scopes)
        result = run_argv(argv, timeout=20)
        commands.append({
            "tool": "rg",
            "argv": argv[:12] + ["..."],
            "returncode": result.returncode,
            "timed_out": result.timed_out,
            "stderr_head": result.stderr[:1000],
        })
        for line in result.stdout.splitlines()[:200]:
            matches.append({"source": "rg", "line": line[:2000]})
    elif scopes:
        pattern = r"tui/(append|submit|clear)-prompt|appendPrompt|submitPrompt|clearPrompt|append-prompt|submit-prompt|clear-prompt"
        for scope in scopes:
            result = run_argv(["grep", "-R", "-n", "-E", pattern, str(scope)], timeout=20)
            commands.append({
                "tool": "grep",
                "argv": ["grep", "-R", "-n", "-E", pattern, str(scope)],
                "returncode": result.returncode,
                "timed_out": result.timed_out,
                "stderr_head": result.stderr[:1000],
            })
            for line in result.stdout.splitlines():
                if len(matches) >= 200:
                    break
                matches.append({"source": "grep", "line": line[:2000]})
            if len(matches) >= 200:
                break
    return {"commands": commands, "matches": matches}


def run_binary_strings_search(scopes: list[Path]) -> dict[str, Any]:
    strings_path = shutil.which("strings")
    if not strings_path:
        return {"available": False, "matches": [], "commands": []}
    files: list[Path] = []
    for scope in scopes:
        if scope.is_file() and scope not in files:
            files.append(scope)
    matches: list[dict[str, str]] = []
    commands: list[dict[str, Any]] = []
    pattern = re.compile(r"tui/(append|submit|clear)-prompt|appendPrompt|submitPrompt|clearPrompt|append-prompt|submit-prompt|clear-prompt")
    for file_path in files[:8]:
        result = run_argv([strings_path, str(file_path)], timeout=15)
        commands.append({
            "tool": "strings",
            "argv": [strings_path, str(file_path)],
            "returncode": result.returncode,
            "timed_out": result.timed_out,
            "stderr_head": result.stderr[:1000],
        })
        for line in result.stdout.splitlines():
            if pattern.search(line):
                matches.append({"source": "strings", "file": str(file_path), "line": line[:2000]})
            if len(matches) >= 200:
                break
        if len(matches) >= 200:
            break
    return {"available": True, "commands": commands, "matches": matches}


def source_evidence(root: Path) -> dict[str, Any]:
    scopes, path_info = source_search_scopes()
    text_search = run_source_text_search(scopes)
    strings_search = run_binary_strings_search(scopes)
    all_lines = "\n".join(item.get("line", "") for item in [*text_search.get("matches", []), *strings_search.get("matches", [])])
    endpoints = endpoint_presence(all_lines)
    data = {
        "schema_version": 1,
        "generated_at": utc_now(),
        "root": str(root),
        "opencode_paths": path_info,
        "text_search": text_search,
        "strings_search": strings_search,
        "matches_reported": min(200, len(text_search.get("matches", [])) + len(strings_search.get("matches", []))),
        "endpoint_hits": endpoints,
        "has_all_required_tui_endpoints": all_required_endpoints(endpoints),
        "keyword_hits": keyword_presence(all_lines),
        "notes": [
            "Search scopes are limited to the opencode binary/realpath neighborhoods.",
            "At most 200 matches are reported.",
            "This is source/static evidence only and does not prove live route availability by itself.",
        ],
    }
    fw = ensure_framework(root)
    write_json(fw / "opencode_source_evidence.json", data)
    lines = [
        "# OpenCode Source Evidence",
        "",
        f"Generated at: {data['generated_at']}",
        f"opencode: {path_info.get('command_v_opencode', '')}",
        f"realpath: {path_info.get('readlink_f_opencode', '')}",
        "",
        "## Scopes",
        "",
        *[f"- {scope}" for scope in path_info.get("scopes", [])],
        "",
        "## Matches",
        "",
    ]
    for item in [*text_search.get("matches", []), *strings_search.get("matches", [])][:200]:
        lines.append(f"- `{item.get('source')}` {item.get('file', '')}: {item.get('line', '')}")
    (fw / "opencode_source_evidence.txt").write_text("\n".join(lines) + "\n", encoding="utf-8")
    return data


def route_summary(route_data: dict[str, Any]) -> dict[str, str]:
    return {
        route.get("path"): route.get("judgement", "unknown")
        for route in route_data.get("routes", [])
        if route.get("path") in TUI_ENDPOINTS_ORDERED
    }


def build_endpoint_evidence(root: Path) -> dict[str, Any]:
    registry = read_fixed_registry(root)
    ports = fixed_registry_ports(registry) or [4101, 4102, 4103]
    per_worker: list[dict[str, Any]] = []
    source = source_evidence(root)
    source_all = bool(source.get("has_all_required_tui_endpoints"))

    doc_any = False
    script_any = False
    openapi_any = False
    route_any = False
    ready_any = False
    ready_ports: list[int] = []

    for port in ports:
        doc = inspect_doc_for_port(root, port)
        openapi = inspect_openapi_candidates_for_port(root, port)
        routes = route_evidence_for_port(root, port)

        doc_all = bool(doc.get("doc_has_all_tui_endpoints"))
        script_all = bool(doc.get("resources_have_all_tui_endpoints"))
        openapi_all = bool(openapi.get("any_candidate_has_all_tui_endpoints") or openapi.get("any_json_has_all_tui_paths"))
        route_all = bool(routes.get("all_required_routes_likely_present"))
        confirmed_by_doc = doc_all or script_all or openapi_all
        confirmed_by_route = route_all and source_all
        ready = confirmed_by_doc or confirmed_by_route
        if ready:
            ready_ports.append(port)
        doc_any = doc_any or doc_all
        script_any = script_any or script_all
        openapi_any = openapi_any or openapi_all
        route_any = route_any or route_all
        ready_any = ready_any or ready
        basis = "not_confirmed"
        if confirmed_by_doc:
            basis = "confirmed_by_doc"
        elif confirmed_by_route:
            basis = "confirmed_by_route_and_source"

        per_worker.append({
            "port": port,
            "doc_status": doc.get("requests", {}).get("GET /doc", {}).get("status"),
            "doc_content_type": doc.get("doc", {}).get("content_type", ""),
            "doc_has_tui_paths": doc_all,
            "script_chunks_have_tui_paths": script_all,
            "openapi_candidate_has_tui_paths": openapi_all,
            "route_evidence_summary": route_summary(routes),
            "route_evidence_has_tui_paths": route_all,
            "source_has_tui_paths": source_all,
            "final_readiness": ready,
            "readiness_basis": basis,
        })

    confidence = "not_confirmed"
    if any(item.get("readiness_basis") == "confirmed_by_doc" for item in per_worker):
        confidence = "confirmed_by_doc"
    elif any(item.get("readiness_basis") == "confirmed_by_route_and_source" for item in per_worker):
        confidence = "confirmed_by_route"
    elif source_all:
        confidence = "confirmed_by_source_only"

    recommendation = {
        "ready_for_3B_submit_real": ready_any,
        "parser_fix_needed": doc_any or script_any or openapi_any,
        "runtime_endpoint_missing": not route_any and not (doc_any or script_any or openapi_any),
        "use_alternative_path": not ready_any,
    }
    data = {
        "schema_version": 1,
        "generated_at": utc_now(),
        "root": str(root),
        "workers_checked": ports,
        "doc_contains_tui_endpoints": doc_any,
        "script_chunks_contain_tui_endpoints": script_any,
        "openapi_json_contains_tui_endpoints": openapi_any,
        "route_evidence_contains_tui_endpoints": route_any,
        "source_contains_tui_endpoints": source_all,
        "endpoint_confidence": confidence,
        "ready_ports": ready_ports,
        "per_worker": per_worker,
        "recommendation": recommendation,
        "notes": [
            "Readiness requires doc/openapi/script evidence for all required endpoints, or HEAD/OPTIONS route evidence plus local source evidence.",
            "Source-only evidence does not make submit-real ready.",
            "No POST, PUT, PATCH, or DELETE requests were sent.",
        ],
    }
    fw = ensure_framework(root)
    write_json(fw / "opencode_tui_endpoint_evidence.json", data)
    (fw / "OPENCODE_TUI_ENDPOINT_EVIDENCE.md").write_text(render_endpoint_evidence_md(data), encoding="utf-8")
    return data


def read_endpoint_evidence(root: Path) -> dict[str, Any]:
    return read_json_safe(framework_root(root) / "opencode_tui_endpoint_evidence.json")


def evidence_by_port(evidence: dict[str, Any]) -> dict[int, dict[str, Any]]:
    result: dict[int, dict[str, Any]] = {}
    for item in evidence.get("per_worker", []):
        try:
            result[int(item.get("port"))] = item
        except Exception:
            continue
    return result


def render_endpoint_evidence_md(data: dict[str, Any]) -> str:
    lines = [
        "# OpenCode TUI Endpoint Evidence",
        "",
        f"Generated at: `{data.get('generated_at', '')}`",
        f"Workspace: `{data.get('root', '')}`",
        "",
        "## Why This Exists",
        "",
        "Phase 3B-0 proved the fixed workers were live, but `/doc` had not yet proven the prompt-control endpoints. Direct `submit-real` remains unsafe until endpoint evidence is explicit.",
        "",
        "## Evidence Checked",
        "",
        "- raw `HEAD /doc` and `GET /doc` body inspection",
        "- same-origin script/link resources referenced by `/doc`",
        "- bounded OpenAPI candidate paths",
        "- `HEAD`/`OPTIONS` route evidence for TUI paths",
        "- local OpenCode installation/source string evidence",
        "",
        "## Summary",
        "",
        f"- workers_checked: `{data.get('workers_checked', [])}`",
        f"- doc_contains_tui_endpoints: `{str(data.get('doc_contains_tui_endpoints', False)).lower()}`",
        f"- script_chunks_contain_tui_endpoints: `{str(data.get('script_chunks_contain_tui_endpoints', False)).lower()}`",
        f"- openapi_json_contains_tui_endpoints: `{str(data.get('openapi_json_contains_tui_endpoints', False)).lower()}`",
        f"- route_evidence_contains_tui_endpoints: `{str(data.get('route_evidence_contains_tui_endpoints', False)).lower()}`",
        f"- source_contains_tui_endpoints: `{str(data.get('source_contains_tui_endpoints', False)).lower()}`",
        f"- endpoint_confidence: `{data.get('endpoint_confidence', 'not_confirmed')}`",
        f"- ready_for_3B_submit_real: `{str(data.get('recommendation', {}).get('ready_for_3B_submit_real', False)).lower()}`",
        "",
        "## Per Port",
        "",
    ]
    for item in data.get("per_worker", []):
        lines.extend([
            f"### Port {item.get('port')}",
            "",
            f"- doc_status: `{item.get('doc_status')}`",
            f"- doc_has_tui_paths: `{str(item.get('doc_has_tui_paths', False)).lower()}`",
            f"- script_chunks_have_tui_paths: `{str(item.get('script_chunks_have_tui_paths', False)).lower()}`",
            f"- openapi_candidate_has_tui_paths: `{str(item.get('openapi_candidate_has_tui_paths', False)).lower()}`",
            f"- route_evidence_summary: `{item.get('route_evidence_summary', {})}`",
            f"- final_readiness: `{str(item.get('final_readiness', False)).lower()}`",
            f"- readiness_basis: `{item.get('readiness_basis', 'not_confirmed')}`",
            "",
        ])
    lines.extend([
        "## Safety Result",
        "",
        "This phase did not call `POST`, `PUT`, `PATCH`, or `DELETE`, and it did not submit any prompt.",
        "",
        "If readiness is false, use an alternative path: inspect OpenCode version/build differences, evaluate `opencode run` or `serve` as a non-TUI backend, and keep the TUI panes live but outside API submission.",
        "",
    ])
    return "\n".join(lines)


def probe_port(port: int, hostname: str = "127.0.0.1", *, include_events: bool = True) -> dict[str, Any]:
    if hostname not in {"127.0.0.1", "localhost"}:
        raise AdapterError("probe-server only allows 127.0.0.1 or localhost")
    if not (1 <= int(port) <= 65535):
        raise AdapterError(f"invalid port: {port}")

    base = f"http://{hostname}:{port}"
    endpoint_results: dict[str, Any] = {}
    for endpoint in PROBE_ENDPOINTS:
        if endpoint in EVENT_ENDPOINTS and not include_events:
            continue
        timeout = 2.0 if endpoint in EVENT_ENDPOINTS else 1.5
        limit = 1024 if endpoint in EVENT_ENDPOINTS else MAX_DOC_BYTES if endpoint == "/doc" else 4096
        endpoint_results[endpoint] = http_get_limited(
            base + endpoint,
            timeout=timeout,
            limit=limit,
            include_body_text=endpoint == "/doc",
        )

    doc_text = str(endpoint_results.get("/doc", {}).get("body_text", endpoint_results.get("/doc", {}).get("body_head", "")))
    doc_summary = summarize_doc(doc_text)
    errors = {
        endpoint: result.get("error", "")
        for endpoint, result in endpoint_results.items()
        if result.get("error")
    }
    reachable = any(result.get("reachable") for result in endpoint_results.values())
    observation_results = list(endpoint_results.values())
    # Explicit refusal only when every probed endpoint was positively
    # refused; mixed failures stay unknown (#934).
    connection_refused = bool(observation_results) and all(
        bool(result.get("connection_refused"))
        for result in observation_results
    )
    return {
        "port": int(port),
        "hostname": hostname,
        "base_url": base,
        "reachable": reachable,
        "connection_refused": connection_refused,
        "global_health_available": bool(endpoint_results["/global/health"].get("ok")),
        "global_health_status": endpoint_results["/global/health"].get("status"),
        "doc_available": bool(endpoint_results["/doc"].get("ok")),
        "doc_status": endpoint_results["/doc"].get("status"),
        "doc_content_type": endpoint_results["/doc"].get("content_type", ""),
        "doc_bytes_read": endpoint_results["/doc"].get("bytes_read", 0),
        "doc_summary": doc_summary,
        "session_status_available": bool(endpoint_results["/session/status"].get("ok")),
        "session_status_code": endpoint_results["/session/status"].get("status"),
        "global_event_available": bool(endpoint_results["/global/event"].get("reachable") and endpoint_results["/global/event"].get("status") == 200) if include_events else None,
        "global_event_status": endpoint_results.get("/global/event", {}).get("status"),
        "global_event_timed_out": endpoint_results["/global/event"].get("timed_out", False) if include_events else None,
        "event_available": bool(endpoint_results["/event"].get("reachable") and endpoint_results["/event"].get("status") == 200) if include_events else None,
        "event_status": endpoint_results.get("/event", {}).get("status"),
        "event_timed_out": endpoint_results["/event"].get("timed_out", False) if include_events else None,
        "detected_tui_methods": detect_tui_methods(doc_text),
        "endpoint_results": {
            endpoint: {
                "ok": result.get("ok"),
                "reachable": result.get("reachable"),
                "status": result.get("status"),
                "content_type": result.get("content_type", ""),
                "bytes_read": result.get("bytes_read", 0),
                "timed_out": result.get("timed_out", False),
                "connection_refused": result.get("connection_refused", False),
                "elapsed_seconds": result.get("elapsed_seconds"),
                "error": result.get("error", ""),
            }
            for endpoint, result in endpoint_results.items()
        },
        "errors": errors,
    }


def probe_servers(ports: list[int]) -> dict[str, Any]:
    ports = [port for port in unique_ints(ports) if 1 <= port <= 65535][:MAX_CANDIDATE_PORTS]
    servers = [probe_port(port) for port in ports]
    return {
        "schema_version": 1,
        "generated_at": utc_now(),
        "candidate_ports": ports,
        "servers": servers,
        "notes": [
            "Only localhost GET probes were used: /global/health, /doc, /session/status, /global/event, /event.",
            "No POST, PUT, PATCH, or DELETE requests were sent.",
        ],
    }


def revalidated_cross_boot_alias_probes(
    workers: list[Any],
    incoming: dict[str, Any],
) -> dict[str, dict[str, Any]]:
    """Return fresh unreachable localhost evidence for old same-pane records."""
    incoming_pane = str(incoming.get("pane_id") or "")
    incoming_boot = str(incoming.get("host_boot_id") or "").strip()
    if not incoming_pane or not incoming_boot:
        return {}

    probes: dict[str, dict[str, Any]] = {}
    incoming_port = int(incoming.get("port") or 0)
    for item in workers:
        if not isinstance(item, dict):
            continue
        worker_id = str(item.get("worker_id") or "")
        existing_boot = str(item.get("host_boot_id") or "").strip()
        if (
            not worker_id
            or not existing_boot
            or existing_boot == incoming_boot
            or str(item.get("pane_id") or "") != incoming_pane
            or not (
                bool(item.get("server_live"))
                or bool(item.get("doc_available"))
            )
        ):
            continue
        try:
            port = int(item.get("port") or 0)
        except (TypeError, ValueError):
            continue
        if not (1 <= port <= 65535):
            continue
        if port == incoming_port:
            # A genuine same-port collision (the incoming binding and this
            # old row share the port) stays a conflict (#934): suppression
            # targets historical pane collisions on other ports only.
            continue
        host = str(item.get("host") or "").strip()
        # Alias liveness/ownership needs health and identity endpoints only;
        # event streams legitimately stay open past the read timeout and are
        # irrelevant here, so keep them out of this observation.
        try:
            probe = probe_port(port, host, include_events=False)
        except AdapterError:
            continue
        endpoint_results = probe.get("endpoint_results") or {}
        timed_out = any(
            bool(result.get("timed_out"))
            for result in endpoint_results.values()
            if isinstance(result, dict)
        )
        refused = bool(probe.get("connection_refused"))
        ownership_evidence: dict[str, Any] | None = None
        if timed_out:
            # Timeout is an unknown result, not a reachability claim and not
            # suppression evidence (#934).
            continue
        if probe.get("reachable"):
            # A reachable endpoint proves availability, not that this old
            # row still owns the port (#934): a different fresh service can
            # occupy the old port number. Only a positive observation - the
            # row's recorded OpenCode instance is positively absent or its
            # pid was recycled (differing start-time ticks) - lets the row
            # be ignored; unknown observations keep the conflict.
            try:
                opencode_pid = int(item.get("opencode_pid") or 0)
                opencode_ticks = int(
                    item.get("opencode_start_time_ticks") or 0
                )
            except (TypeError, ValueError):
                continue
            if (
                opencode_pid <= 0
                or opencode_ticks <= 0
                or process_instance_state(opencode_pid, opencode_ticks)
                != "dead"
            ):
                continue
            ownership_evidence = {
                "old_opencode_process_dead": True,
                "recorded_opencode_pid": opencode_pid,
            }
        elif not refused:
            # Unknown or failed transport without an explicit refusal:
            # no truthful refusal claim and no suppression without positive
            # ownership evidence (#934).
            continue
        probes[worker_id] = {
            "worker_id": worker_id,
            "host": host,
            "port": port,
            "pane_id": str(item.get("pane_id") or ""),
            "host_boot_id": existing_boot,
            "pane_pid": item.get("pane_pid"),
            "opencode_pid": item.get("opencode_pid"),
            "binding_generation": item.get("binding_generation"),
            "checked_at": utc_now(),
            "reachable": bool(probe.get("reachable")),
            "connection_refused": refused,
            "ownership_evidence": ownership_evidence or {},
        }
    return probes


def cross_boot_alias_probe_matches(
    record: dict[str, Any],
    probe: dict[str, Any],
) -> bool:
    try:
        record_port = int(record.get("port") or 0)
        probe_port = int(probe.get("port") or 0)
    except (TypeError, ValueError):
        return False
    return bool(
        probe
        and str(record.get("worker_id") or "") == probe.get("worker_id")
        and str(record.get("host") or "").strip() == probe.get("host")
        and record_port == probe_port
        and str(record.get("pane_id") or "") == probe.get("pane_id")
        and str(record.get("host_boot_id") or "").strip()
        == probe.get("host_boot_id")
        and record.get("pane_pid") == probe.get("pane_pid")
        and record.get("opencode_pid") == probe.get("opencode_pid")
        and record.get("binding_generation") == probe.get(
            "binding_generation"
        )
    )


def write_capability_artifacts(root: Path, capabilities: dict[str, Any], servers: dict[str, Any]) -> None:
    fw = ensure_framework(root)
    write_json(fw / "opencode_tui_capabilities.json", capabilities)
    write_json(fw / "opencode_servers.json", servers)
    (fw / "OPENCODE_TUI_CAPABILITIES.md").write_text(render_capabilities_md(capabilities, servers), encoding="utf-8")


def fixed_registry_path(root: Path) -> Path:
    return framework_root(root) / FIXED_WORKER_REGISTRY


def read_fixed_registry(root: Path) -> dict[str, Any]:
    return read_json_safe(fixed_registry_path(root))


def fixed_registry_ports(registry: dict[str, Any]) -> list[int]:
    ports: list[int] = []
    for worker in registry.get("workers", []):
        try:
            port = int(worker.get("port"))
        except Exception:
            continue
        if 1 <= port <= 65535 and port not in ports:
            ports.append(port)
    return ports


def has_all_tui_methods(worker: dict[str, Any]) -> bool:
    if worker.get("final_readiness") or worker.get("route_evidence_ready"):
        return True
    if all(worker.get(key) for key in ("tui_clear_prompt", "tui_append_prompt", "tui_submit_prompt")):
        return True
    methods = set(worker.get("detected_tui_methods", []))
    return all(endpoint in methods for endpoint in TUI_ENDPOINTS)


def summarize_fixed_workers(root: Path, registry: dict[str, Any], servers: dict[str, Any]) -> dict[str, Any]:
    server_by_port = {int(item.get("port")): item for item in servers.get("servers", []) if str(item.get("port", "")).isdigit()}
    endpoint_evidence = evidence_by_port(read_endpoint_evidence(root))
    workers: list[dict[str, Any]] = []
    for worker in registry.get("workers", []):
        try:
            port = int(worker.get("port"))
        except Exception:
            port = 0
        probe = server_by_port.get(port, {})
        evidence = endpoint_evidence.get(port, {})
        detected = probe.get("detected_tui_methods", worker.get("detected_tui_methods", []))
        paths = probe.get("doc_summary", {}).get("paths", worker.get("doc_summary", {}).get("paths", {}))
        evidence_ready = bool(evidence.get("final_readiness", False))
        route_evidence_ready = bool(evidence.get("route_evidence_has_tui_paths", False))
        summary_worker = {
            "worker_id": worker.get("worker_id") or worker.get("worker"),
            "pane_id": worker.get("pane_id", ""),
            "pane_title": worker.get("pane_title", ""),
            "port": port,
            "base_url": worker.get("base_url") or f"http://127.0.0.1:{port}" if port else "",
            "server_live": bool(probe.get("reachable", worker.get("server_live", False))),
            "global_health_available": bool(probe.get("global_health_available", worker.get("global_health_available", False))),
            "doc_available": bool(probe.get("doc_available", worker.get("doc_available", False))),
            "session_status_available": bool(probe.get("session_status_available", worker.get("session_status_available", False))),
            "global_event_available": bool(probe.get("global_event_available", worker.get("global_event_available", False))),
            "event_available": bool(probe.get("event_available", worker.get("event_available", False))),
            "detected_tui_methods": detected,
            "tui_clear_prompt": bool(paths.get("/tui/clear-prompt") or "/tui/clear-prompt" in detected or worker.get("tui_clear_prompt")),
            "tui_append_prompt": bool(paths.get("/tui/append-prompt") or "/tui/append-prompt" in detected or worker.get("tui_append_prompt")),
            "tui_submit_prompt": bool(paths.get("/tui/submit-prompt") or "/tui/submit-prompt" in detected or worker.get("tui_submit_prompt")),
            "doc_evidence_ready": bool(evidence.get("readiness_basis") == "confirmed_by_doc"),
            "route_evidence_ready": route_evidence_ready,
            "final_readiness": evidence_ready,
            "readiness_basis": evidence.get("readiness_basis", "not_confirmed") if evidence else "not_confirmed",
        }
        workers.append(summary_worker)

    ready_any = any(
        worker.get("server_live") and worker.get("doc_available") and has_all_tui_methods(worker)
        for worker in workers
    )
    ready_all = bool(workers) and all(
        worker.get("server_live") and worker.get("doc_available") and has_all_tui_methods(worker)
        for worker in workers
    )
    return {
        "registry_path": rel(fixed_registry_path(root), root),
        "registry_exists": bool(registry),
        "tmux_window": registry.get("tmux_window", ""),
        "tmux_window_id": registry.get("tmux_window_id", ""),
        "tmux_window_name": registry.get("tmux_window_name", ""),
        "workers": workers,
        "fixed_workers_ready": ready_all,
        "ready_for_phase_3B_submit_real": ready_any,
    }


def run_full_discovery(root: Path) -> dict[str, Any]:
    capabilities = collect_cli_capabilities(root)
    tmux_data = discover_tmux_opencode()
    socket_data = perform_socket_discovery(root, tmux_data=tmux_data, capabilities=capabilities, write=True)
    fixed_registry = read_fixed_registry(root)
    ports = unique_ints(list(socket_data.get("candidate_ports", [])) + fixed_registry_ports(fixed_registry))
    servers = socket_data.get("probe_results", probe_servers(ports))
    if fixed_registry_ports(fixed_registry):
        servers = probe_servers(ports)
    write_capability_artifacts(root, capabilities, servers)
    fixed_workers = summarize_fixed_workers(root, fixed_registry, servers)
    discovery = {
        "schema_version": 1,
        "generated_at": utc_now(),
        "root": str(root),
        "tmux": tmux_data,
        "socket_discovery": socket_data,
        "candidate_ports": ports,
        "servers": servers,
        "fixed_workers": fixed_workers,
        "opencode": capabilities.get("opencode", {}),
        "features": capabilities.get("features", {}),
    }
    write_json(ensure_framework(root) / "opencode_discovery.json", discovery)
    return discovery


def task_dir(root: Path, run: str, task: str) -> Path:
    safe_slug(task, "task")
    return framework_run_dir(root, run) / "tasks" / task


def worker_dir(root: Path, run: str, worker: str) -> Path:
    safe_slug(worker, "worker")
    return framework_run_dir(root, run) / "workers" / worker


def write_worker(root: Path, run: str, worker: str, backend: str = "opencode_tui") -> None:
    wdir = worker_dir(root, run, worker)
    write_json(wdir / "identity.json", {
        "id": worker,
        "backend": backend,
        "created_by": "omx_opencode_tui_adapter",
        "framework_only": True,
    })


def prompt_text(root: Path, run: str, task: str, worker: str, title: str, body: str, port: int) -> str:
    tdir = task_dir(root, run, task)
    task_md = tdir / "task.md"
    report = tdir / "report.md"
    return f"""OMX_RUN_ID={run}
OMX_TASK_ID={task}
OMX_WORKER_ID={worker}
backend=opencode_tui
opencode_server=http://127.0.0.1:{port}

Task file:
{task_md}

Report file:
{report}

Title:
{title}

Task body:
{body}

Terminal marker rules:
- Success: write report.md and touch .done.
- Failure: write report.md and touch .fail.
- Blocked: write report.md and touch .blocked.

State protocol:
- Do not only say the task is complete verbally.
- idle is not completed.
- submitted is not received.
- The worker must explicitly write .received, .started, and .heartbeat, or a later adapter/plugin must write them after explicit acknowledgement.
"""


def dry_run_plan(root: Path, run: str, task: str, worker: str, port: int) -> dict[str, Any]:
    tdir = task_dir(root, run, task)
    return {
        "schema_version": 1,
        "created_at": utc_now(),
        "phase": "3A",
        "mode": "dry-run",
        "run": run,
        "task": task,
        "worker": worker,
        "backend": "opencode_tui",
        "server": f"http://127.0.0.1:{port}",
        "prompt_path": rel(tdir / "prompt.txt", root),
        "would_call_in_phase_3b": [
            "GET /doc to verify schema",
            "POST /tui/clear-prompt",
            "POST /tui/append-prompt",
            "POST /tui/submit-prompt",
            "write .submitted only after successful submit",
            "wait-receipt for .received",
        ],
        "phase_3a_boundary": "No POST requests are executed in phase 3A.",
    }


def prepare_task(root: Path, run: str, task: str, worker: str, port: int, title: str, body: str) -> Path:
    ensure_framework(root)
    tdir = task_dir(root, run, task)
    tdir.mkdir(parents=True, exist_ok=True)
    write_worker(root, run, worker)
    (tdir / "owner").write_text(worker + "\n", encoding="utf-8")
    (tdir / "backend").write_text("opencode_tui\n", encoding="utf-8")
    (tdir / "task.md").write_text(f"# {title}\n\n{body}\n", encoding="utf-8")
    write_json(tdir / "adapter.json", {
        "schema_version": 1,
        "created_at": utc_now(),
        "run": run,
        "task": task,
        "worker": worker,
        "backend": "opencode_tui",
        "server": {
            "hostname": "127.0.0.1",
            "port": port,
            "base_url": f"http://127.0.0.1:{port}",
        },
        "framework_only": True,
        "real_submit_enabled": False,
    })
    (tdir / "prompt.txt").write_text(prompt_text(root, run, task, worker, title, body, port), encoding="utf-8")
    write_json(tdir / "dry_run_plan.json", dry_run_plan(root, run, task, worker, port))
    return tdir


def reset_known_markers(tdir: Path) -> None:
    for name in [
        ".submitted",
        ".received",
        ".started",
        ".heartbeat",
        ".done",
        ".fail",
        ".blocked",
        ".idle",
        ".waiting_input",
        ".waiting_permission",
        "report.md",
    ]:
        target = tdir / name
        if target.exists() and target.is_file():
            target.unlink()


def ensure_state_team_clean(root: Path) -> None:
    state_team = team_root(root)
    if not state_team.exists():
        return
    polluted = sorted(path.name for path in state_team.iterdir() if path.is_dir() and path.name in STATE_POLLUTION_DIRS)
    if polluted:
        raise AdapterError(f".omx/state/team contains framework/internal dirs: {', '.join(polluted)}")


def append_event(path: Path, event: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(event, ensure_ascii=False, sort_keys=True) + "\n")


def fixed_registry_worker_by_id_or_port(root: Path, worker_id: str | None, port: int | None) -> dict[str, Any]:
    registry = read_fixed_registry(root)
    if not registry:
        raise AdapterError(f"fixed worker registry not found: {rel(fixed_registry_path(root), root)}")
    candidates = []
    for worker in registry.get("workers", []):
        if not isinstance(worker, dict):
            continue
        try:
            worker_port = int(worker.get("port"))
        except Exception:
            worker_port = 0
        matches_worker = worker_id is not None and str(worker.get("worker_id") or worker.get("worker")) == worker_id
        matches_port = port is not None and worker_port == int(port)
        if matches_worker or matches_port:
            candidates.append(worker)
    if not candidates:
        if worker_id and port:
            raise AdapterError(f"worker {worker_id!r} / port {port} was not found in fixed registry")
        if worker_id:
            raise AdapterError(f"worker {worker_id!r} was not found in fixed registry")
        raise AdapterError(f"port {port} was not found in fixed registry")
    selected = candidates[0]
    selected_id = str(selected.get("worker_id") or selected.get("worker") or "")
    selected_port = int(selected.get("port"))
    if worker_id and selected_id != worker_id:
        raise AdapterError(f"worker/port mismatch: port {port} belongs to {selected_id}, not {worker_id}")
    if port is not None and selected_port != int(port):
        raise AdapterError(f"worker/port mismatch: worker {worker_id} uses port {selected_port}, not {port}")
    backend = str(selected.get("backend") or registry.get("backend") or "")
    if backend != "opencode_tui":
        raise AdapterError(f"fixed worker backend is not opencode_tui: {backend}")
    return selected


def prompt_payloads_from_schema(schema_data: dict[str, Any], prompt_body: str) -> dict[str, dict[str, Any]]:
    endpoints = schema_endpoint_by_path(schema_data)
    missing = [endpoint for endpoint in TUI_ENDPOINTS_ORDERED if endpoint not in endpoints]
    if missing:
        raise AdapterError(f"endpoint schema missing required endpoint(s): {', '.join(missing)}")
    payloads: dict[str, dict[str, Any]] = {}
    for endpoint in TUI_ENDPOINTS_ORDERED:
        item = endpoints[endpoint]
        if not item.get("executable"):
            raise AdapterError(f"{endpoint} is not safely executable: {item.get('reason', 'unknown reason')}")
        if endpoint == "/tui/append-prompt":
            text_field = str(item.get("text_field") or "")
            if not text_field:
                raise AdapterError("append-prompt schema did not provide a text field")
            payloads[endpoint] = {text_field: prompt_body}
        else:
            payloads[endpoint] = {}
    return payloads


def execute_command_payload_from_schema(schema_data: dict[str, Any], command_body: str) -> dict[str, Any]:
    if command_body != RESET_SLASH_COMMAND_BODY:
        raise AdapterError("execute-command-real only supports the exact /new slash command")
    endpoints = schema_endpoint_by_path(schema_data)
    item = endpoints.get(RESET_COMMAND_ENDPOINT)
    if not item:
        raise AdapterError(f"endpoint schema missing reset endpoint: {RESET_COMMAND_ENDPOINT}")
    if not item.get("executable"):
        raise AdapterError(f"{RESET_COMMAND_ENDPOINT} is not safely executable: {item.get('reason', 'unknown reason')}")
    command_field = str(item.get("command_field") or "")
    if not command_field:
        raise AdapterError("execute-command schema did not provide a command field")
    return {command_field: RESET_TUI_COMMAND_BODY}


def _response_json_object(response: dict[str, Any]) -> dict[str, Any]:
    body_head = str(response.get("body_head") or "").strip()
    if not body_head:
        return {}
    try:
        parsed = json.loads(body_head)
    except Exception:
        return {}
    return parsed if isinstance(parsed, dict) else {}


def _first_text(mapping: dict[str, Any], *keys: str) -> str:
    for key in keys:
        value = mapping.get(key)
        if value is None:
            continue
        text = str(value).strip()
        if text:
            return text
    return ""


def reset_evidence_from_execute_command_response(response: dict[str, Any]) -> dict[str, Any]:
    response_body = _response_json_object(response)
    merged = {**response_body, **{key: value for key, value in response.items() if key.startswith("reset_")}}
    reset_session_id = _first_text(
        merged,
        "reset_session_id",
        "session_id",
        "sessionID",
        "sessionId",
        "context_id",
        "contextId",
    )
    reset_epoch_text = _first_text(
        merged,
        "reset_epoch",
        "context_epoch",
        "contextEpoch",
        "epoch",
    )
    try:
        reset_epoch = int(reset_epoch_text)
    except (TypeError, ValueError):
        reset_epoch = 0
    checked_at = _first_text(merged, "checked_at", "reset_checked_at") or utc_now()
    evidence_source = _first_text(merged, "evidence_source", "reset_evidence_source") or "sanctioned_tui_execute_command"
    reset_transport_executed = bool(response.get("ok"))
    reset_session_evidence_found = bool(
        reset_transport_executed
        and reset_session_id
        and not reset_session_id.startswith("visible-run-")
        and reset_epoch >= 1
    )
    return {
        "reset_transport_executed": reset_transport_executed,
        "reset_session_evidence_found": reset_session_evidence_found,
        "reset_session_id": "" if reset_session_id.startswith("visible-run-") else reset_session_id,
        "reset_epoch": reset_epoch,
        "checked_at": checked_at,
        "evidence_source": evidence_source,
        "blocked_reasons": [] if reset_session_evidence_found else ["reset_session_evidence_missing"],
    }


def reset_status_clear_evidence(
    root: Path,
    worker_id: str,
    before_status: dict[str, Any],
    *,
    runtime_backend: str | None = None,
    timeout_seconds: float = 6.0,
    poll_seconds: float = 0.5,
) -> dict[str, Any]:
    before_ids = {
        str(item).strip()
        for item in before_status.get("session_ids", [])
        if str(item).strip()
    }
    deadline = time.time() + timeout_seconds
    after_status: dict[str, Any] = {}
    after_ids: set[str] = set()
    while True:
        after_status = session_status_snapshot(root, worker_id, runtime_backend=runtime_backend)
        after_ids = {
            str(item).strip()
            for item in after_status.get("session_ids", [])
            if str(item).strip()
        }
        if before_ids and before_ids.isdisjoint(after_ids):
            break
        if time.time() >= deadline:
            break
        time.sleep(poll_seconds)
    return {
        "reset_status_before_ids": sorted(before_ids),
        "reset_status_after_ids": sorted(after_ids),
        "reset_status_cleared_found": bool(before_ids and before_ids.isdisjoint(after_ids)),
        "reset_status_empty_found": bool(
            after_status.get("status_count") == 0
            and after_status.get("session_status") == {}
        ),
        "reset_status_checked_at": after_status.get("checked_at", ""),
    }


def reset_tui_home_evidence(
    binding: dict[str, Any],
    *,
    timeout_seconds: float = 12.0,
    poll_seconds: float = 0.5,
    current_home_only: bool = False,
) -> dict[str, Any]:
    pane_id = str(binding.get("pane_id") or "").strip()
    if not pane_id.startswith("%"):
        return {
            "reset_tui_home_evidence_found": False,
            "reset_tui_capture_ok": False,
            "reset_tui_evidence_source": "",
            "reset_tui_capture_returncode": None,
            "reset_tui_capture_markers": [],
            "reset_tui_capture_attempts": 0,
        }
    deadline = time.time() + timeout_seconds
    attempts = 0
    capture = None
    markers_seen: set[str] = set()
    required_markers = {"ask_anything", "commands_hint"}
    home_found = False
    while True:
        attempts += 1
        capture = run_argv(
            ["tmux", "capture-pane", "-p", "-t", pane_id]
            + ([] if current_home_only else ["-S", "-80"])
        )
        if current_home_only:
            # No-op admission needs one current frame, never accumulated history.
            markers_seen = set()
        if capture.returncode == 0:
            if (
                "Ask anything..." in capture.stdout
                or "Ask anything\u2026" in capture.stdout
            ):
                markers_seen.add("ask_anything")
            if (
                "ctrl+p commands" in capture.stdout
                or (
                    "Use /models" in capture.stdout
                    and "ctrl+x m" in capture.stdout
                )
            ):
                markers_seen.add("commands_hint")
        home_found = required_markers.issubset(markers_seen)
        if current_home_only:
            # Default OpenCode home renders this logo before its prompt; the
            # prompt row itself starts with the ┃ input-box border. Session
            # transcripts and their ordinary footer are not home-route evidence.
            lines = [line.strip() for line in (capture.stdout or "").splitlines() if line.strip()]
            logo = [
                "▄",
                "█▀▀█ █▀▀█ █▀▀█ █▀▀▄ █▀▀▀ █▀▀█ █▀▀█ █▀▀█",
                "█  █ █  █ █▀▀▀ █  █ █    █  █ █  █ █▀▀▀",
                "▀▀▀▀ █▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀",
            ]
            frame_home_chrome = bool(
                lines[:4] == logo
                and any(re.match(r'^(?:┃\s*)?Ask anything(?:\.\.\.|…)(?:\s|$)', line) for line in lines[4:])
            )
            if frame_home_chrome:
                # Keep observed logo/prompt chrome reportable when the command
                # hint is missing (for example a clipped current viewport), so
                # a partial home frame stays distinguishable from a non-home
                # frame; admission below still requires every same-frame
                # marker, and history across frames never accumulates.
                markers_seen.add("current_home_logo")
            home_found = bool(home_found and frame_home_chrome)
        if home_found or time.time() >= deadline:
            break
        time.sleep(max(poll_seconds, 0.01))
    markers = [
        marker
        for marker in ("ask_anything", "commands_hint", "current_home_logo")
        if marker in markers_seen
    ]
    return {
        "reset_tui_home_evidence_found": home_found,
        "reset_tui_capture_ok": bool(capture and capture.returncode == 0),
        "reset_tui_evidence_source": "tmux_capture_home" if home_found else "",
        "reset_tui_capture_returncode": capture.returncode if capture else None,
        "reset_tui_capture_markers": markers,
        "reset_tui_capture_attempts": attempts,
    }


FRESH_PROCESS_HISTORY_MARKERS = (
    ".submitted",
    ".received",
    ".started",
    ".done",
    ".fail",
    ".blocked",
    ".heartbeat",
    "delivery.json",
    "submit_error.json",
    "report.md",
)


def verified_process_restart_evidence(
    root: Path,
    worker_id: str,
    evidence_text: str,
    binding_snapshot: dict[str, Any],
) -> dict[str, Any]:
    text = str(evidence_text or "").strip()
    if not text.startswith("{"):
        return {}
    try:
        evidence = json.loads(text)
    except json.JSONDecodeError:
        return {}
    if not isinstance(evidence, dict):
        return {}
    receipt_relative = Path(str(evidence.get("receipt_path") or ""))
    expected_relative = (
        Path(".omx/framework/team")
        / f"opencode_visible_replace_{worker_id}.json"
    )
    if (
        receipt_relative != expected_relative
        or receipt_relative.is_absolute()
        or ".." in receipt_relative.parts
    ):
        return {}
    receipt_path = root / receipt_relative
    if receipt_path.is_symlink() or not receipt_path.is_file():
        return {}
    receipt = read_json_safe(receipt_path)
    receipt_hash = hashlib.sha256(
        json.dumps(
            receipt,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
        ).encode("utf-8")
    ).hexdigest()
    rebind = (
        receipt.get("rebind")
        if isinstance(receipt.get("rebind"), dict)
        else {}
    )
    doctor = (
        receipt.get("doctor")
        if isinstance(receipt.get("doctor"), dict)
        else {}
    )
    expected = {
        "schema_version": 1,
        "status": "verified_fresh_process",
        "worker_id": worker_id,
        "receipt_sha256": receipt_hash,
        "instance_id": str(
            binding_snapshot.get("instance_id") or ""
        ),
        "binding_generation": int(
            binding_snapshot.get("binding_generation") or 0
        ),
        "fencing_generation": int(
            binding_snapshot.get("fencing_generation")
            or binding_snapshot.get("binding_generation")
            or 0
        ),
        "opencode_pid": int(
            binding_snapshot.get("opencode_pid") or 0
        ),
        "opencode_start_time_ticks": int(
            binding_snapshot.get("opencode_start_time_ticks") or 0
        ),
    }
    if (
        any(evidence.get(field) != value for field, value in expected.items())
        or int(receipt.get("schema_version") or 0) != 1
        or str(receipt.get("worker_id") or "") != worker_id
        or str(receipt.get("pane_id") or "")
        != str(binding_snapshot.get("pane_id") or "")
        or int(receipt.get("port") or 0)
        != int(binding_snapshot.get("port") or 0)
        or rebind.get("respawn_transition") is not True
        or rebind.get("post_rebind_status") != "current_binding_ok"
        or doctor.get("ok") is not True
    ):
        return {}
    return evidence


def worker_fresh_process_history(
    root: Path,
    worker_id: str,
    *,
    process_evidence: dict[str, Any] | None = None,
) -> dict[str, Any]:
    runs_root = framework_root(root) / "visible-runs"
    tasks: list[dict[str, Any]] = []
    errors: list[str] = []
    if not runs_root.exists():
        return {
            "worker_id": worker_id,
            "owned_task_count": 0,
            "prepared_only_count": 0,
            "submitted_count": 0,
            "submitted_tasks": [],
            "prepared_only_tasks": [],
            "errors": [],
            "safe_for_fresh_process_reset": False,
        }
    try:
        run_dirs = sorted(runs_root.iterdir(), key=lambda item: item.name)
    except OSError as exc:
        return {
            "worker_id": worker_id,
            "owned_task_count": 0,
            "prepared_only_count": 0,
            "submitted_count": 0,
            "submitted_tasks": [],
            "prepared_only_tasks": [],
            "errors": [f"visible_runs_unreadable:{exc}"],
            "safe_for_fresh_process_reset": False,
        }
    for run_dir in run_dirs:
        if run_dir.name == "_locks":
            continue
        if run_dir.is_symlink():
            errors.append(f"symlink_run:{rel(run_dir, root)}")
            continue
        tasks_dir = run_dir / "tasks"
        if tasks_dir.is_symlink():
            errors.append(f"symlink_tasks:{rel(tasks_dir, root)}")
            continue
        if not tasks_dir.is_dir():
            continue
        try:
            task_dirs = sorted(tasks_dir.iterdir(), key=lambda item: item.name)
        except OSError as exc:
            errors.append(f"tasks_unreadable:{rel(tasks_dir, root)}:{exc}")
            continue
        for task_dir in task_dirs:
            if task_dir.is_symlink():
                errors.append(f"symlink_task:{rel(task_dir, root)}")
                continue
            if not task_dir.is_dir():
                continue
            owner = ""
            owner_path = task_dir / "owner"
            if owner_path.is_file() and not owner_path.is_symlink():
                owner = read_text(owner_path).strip()
            task_json = read_json_safe(task_dir / "task.json")
            task_worker = owner or str(task_json.get("worker_id") or task_json.get("worker") or "").strip()
            if task_worker != worker_id:
                continue
            markers = [
                marker
                for marker in FRESH_PROCESS_HISTORY_MARKERS
                if (task_dir / marker).exists()
            ]
            dispatch = read_json_safe(task_dir / "dispatch.json")
            worker_record = (
                dispatch.get("worker_record")
                if isinstance(dispatch.get("worker_record"), dict)
                else {}
            )
            instance_id = visible_instance_id(worker_record)
            tasks.append(
                {
                    "run": run_dir.name,
                    "task": task_dir.name,
                    "path": rel(task_dir, root),
                    "markers": markers,
                    "instance_id": instance_id,
                    "binding_generation": _int_or_zero(
                        worker_record.get("binding_generation")
                    ),
                    "fencing_generation": _int_or_zero(
                        worker_record.get("fencing_generation")
                        or worker_record.get("binding_generation")
                    ),
                }
            )
    current_tasks = tasks
    prior_tasks: list[dict[str, Any]] = []
    if process_evidence:
        current_tasks = [
            task
            for task in tasks
            if (
                task["instance_id"] == process_evidence["instance_id"]
                and task["binding_generation"]
                == process_evidence["binding_generation"]
                and task["fencing_generation"]
                == process_evidence["fencing_generation"]
            )
        ]
        prior_tasks = [
            task for task in tasks if task not in current_tasks
        ]
        if (
            len(current_tasks)
            != int(process_evidence.get("current_process_task_count") or 0)
            or len(prior_tasks)
            != int(process_evidence.get("prior_process_task_count") or 0)
            or any(
                not task["instance_id"]
                or task["binding_generation"]
                >= int(process_evidence["binding_generation"])
                or task["fencing_generation"]
                >= int(process_evidence["fencing_generation"])
                for task in prior_tasks
            )
        ):
            errors.append("process_replacement_history_mismatch")
    submitted = [task for task in current_tasks if task["markers"]]
    prepared = [task for task in current_tasks if not task["markers"]]
    safe = (
        not errors
        and len(current_tasks) == 1
        and not submitted
        and (
            not process_evidence
            or (
                len(prepared)
                == int(process_evidence.get("prepared_only_count") or 0)
                and len(submitted)
                == int(process_evidence.get("submitted_count") or 0)
            )
        )
    )
    return {
        "worker_id": worker_id,
        "owned_task_count": len(tasks),
        "current_process_task_count": len(current_tasks),
        "prior_process_task_count": len(prior_tasks),
        "prepared_only_count": len(prepared),
        "submitted_count": len(submitted),
        "submitted_tasks": submitted,
        "prepared_only_tasks": prepared,
        "errors": errors,
        "safe_for_fresh_process_reset": safe,
    }


def context_domain_evidence(
    *,
    current_context_domain_id: str = "",
    previous_context_domain_id: str = "",
    same_context_domain_continuity_proven: bool = False,
) -> dict[str, Any]:
    current = str(current_context_domain_id or "").strip()
    previous = str(previous_context_domain_id or "").strip()
    continuity_proven = bool(same_context_domain_continuity_proven)
    changed = bool(current and previous and current != previous)
    if continuity_proven and (not current or current != previous):
        raise AdapterError(
            "same-domain continuity requires matching non-empty current and previous context-domain ids"
        )
    return {
        "current": current,
        "previous": previous,
        "changed": changed,
        "same_domain_continuity_proven": continuity_proven,
    }


def session_rotation_policy_decision(
    *,
    context_domain_changed: bool = False,
    current_context_domain_id: str = "",
    previous_context_domain_id: str = "",
    same_context_domain_continuity_proven: bool = False,
    worker_process_restarted_after_last_task: bool = False,
    independent_judgment_required: bool = False,
    role_policy_materially_changed: bool = False,
    contract_breaking_changed: bool = False,
    prior_context_contaminated: bool = False,
    context_stale_or_overloaded: bool = False,
    recovery_restart_required: bool = False,
    worker_reused_for_unrelated_work: bool = False,
    context_pressure: bool = False,
    context_healthy: bool = True,
    active_target_lock: bool = False,
) -> dict[str, Any]:
    context_domain = context_domain_evidence(
        current_context_domain_id=current_context_domain_id,
        previous_context_domain_id=previous_context_domain_id,
        same_context_domain_continuity_proven=same_context_domain_continuity_proven,
    )
    effective_context_domain_changed = bool(
        context_domain_changed or context_domain["changed"]
    )
    if effective_context_domain_changed and context_domain["same_domain_continuity_proven"]:
        raise AdapterError("changed context domain cannot claim same-domain continuity")
    context_domain["changed"] = effective_context_domain_changed
    reasons: list[str] = []
    checks = [
        (effective_context_domain_changed, "context_domain_changed"),
        (
            worker_process_restarted_after_last_task,
            "worker_process_restarted_after_last_task",
        ),
        (independent_judgment_required, "independent_judgment_required"),
        (role_policy_materially_changed, "role_policy_materially_changed"),
        (contract_breaking_changed, "contract_breaking_changed"),
        (prior_context_contaminated, "prior_context_contaminated"),
        (context_stale_or_overloaded, "context_stale_or_overloaded"),
        (recovery_restart_required, "recovery_restart_required"),
        (worker_reused_for_unrelated_work, "worker_reused_for_unrelated_work"),
    ]
    reasons.extend(reason for enabled, reason in checks if enabled)
    if context_pressure and not context_healthy:
        reasons.append("context_pressure_unhealthy")
    need_new = bool(reasons)
    blocked_reasons = ["active_target_lock"] if need_new and active_target_lock else []
    if blocked_reasons:
        action = "drain_or_abort_then_rotate"
    elif need_new:
        action = "rotate_session"
    elif context_pressure and context_healthy:
        action = "compact_or_prune"
    else:
        action = "keep"
    return {
        "schema_version": 1,
        "action": action,
        "need_new": need_new,
        "safe_to_new": need_new and not blocked_reasons,
        "reasons": reasons,
        "blocked_reasons": blocked_reasons,
        "context_domain": context_domain,
        "worker_process_restarted_after_last_task": bool(
            worker_process_restarted_after_last_task
        ),
    }


def rehydration_packet_template(packet_type: str) -> dict[str, Any]:
    packet_type = str(packet_type or "").strip()
    if packet_type not in REHYDRATION_PACKET_TYPES:
        raise AdapterError(f"rehydration packet type must be one of: {', '.join(sorted(REHYDRATION_PACKET_TYPES))}")
    common_fields = [
        "worker_id",
        "session_id",
        "task_id",
        "attempt_id",
        "role",
        "contract_hash",
        "input_manifest_hash",
    ]
    required_by_type = {
        "continuation": [
            "current_objective",
            "verified_findings",
            "failed_approaches",
            "remaining_work",
            "test_status",
        ],
        "clean-room-review": [
            "frozen_contract",
            "candidate_diff_or_commit",
            "artifact_manifest_hash",
            "test_evidence",
            "required_output_schema",
        ],
        "new-task": [
            "task_contract",
            "role_policy",
            "allowed_paths",
            "acceptance_criteria",
        ],
        "recovery": [
            "recovery_reason",
            "old_attempt_state",
            "partial_evidence",
            "new_attempt_contract",
        ],
    }
    allowed_inputs_by_type = {
        "continuation": [
            "trusted_summary",
            "verified_findings",
            "failed_approaches",
            "current_diff",
        ],
        "clean-room-review": [
            "frozen_contract",
            "candidate_diff_or_commit",
            "artifact_manifest",
            "test_evidence",
            "approved_waivers",
        ],
        "new-task": [
            "global_worker_contract",
            "task_contract",
            "role_policy",
            "workspace_binding",
        ],
        "recovery": [
            "fenced_attempt_summary",
            "partial_report",
            "failure_evidence",
            "new_attempt_contract",
        ],
    }
    return {
        "schema_version": 1,
        "packet_type": packet_type,
        "common_fields": common_fields,
        "required_fields": required_by_type[packet_type],
        "allowed_inputs": allowed_inputs_by_type[packet_type],
        "guidance": (
            "Point directly to the task-local prompt.txt for exact fenced finish commands, "
            "even before report.md exists. Use the existing remaining_work/verified_findings "
            "or partial_evidence fields and latest acknowledged supplement/brief reference "
            "when available; verify current artifact versions, not stale completion claims. "
            "A pending same-task supplement is acknowledged only by running its task-local "
            "supplement-*.json receipt's exact ack_command with a truthful adoption summary: "
            "only the exact checkpoint --name supplement:<id> satisfies the required "
            "acknowledgement, so re-read the current receipts instead of guessing older "
            "supplement names. This pointer does not expand authority or establish completion."
        ),
    }


def _first_session_id(ids: Any) -> str:
    if not isinstance(ids, list):
        return ""
    for item in ids:
        text = str(item or "").strip()
        if text:
            return text
    return ""


def visible_instance_id(record: dict[str, Any], binding: dict[str, Any] | None = None) -> str:
    binding = binding or {}
    explicit = str(binding.get("instance_id") or record.get("instance_id") or "").strip()
    if explicit:
        return explicit
    identity = {
        "worker_id": str(record.get("worker_id") or binding.get("worker_id") or ""),
        "pane_id": str(binding.get("pane_id") or record.get("pane_id") or ""),
        "pane_pid": str(binding.get("pane_pid", record.get("pane_pid", "")) or ""),
        "host": str(record.get("host") or "127.0.0.1"),
        "port": str(binding.get("port", record.get("port", "")) or ""),
    }
    digest = hashlib.sha256(json.dumps(identity, sort_keys=True).encode("utf-8")).hexdigest()[:16]
    return f"vw-inst-{digest}"


def _int_or_zero(value: Any) -> int:
    try:
        return int(value or 0)
    except (TypeError, ValueError):
        return 0


def _normalized_local_host(value: Any) -> str:
    host = str(value or "127.0.0.1").strip()
    if host == "localhost":
        return "127.0.0.1"
    return host


def verified_visible_transport_endpoint(
    record: dict[str, Any],
    binding: dict[str, Any],
) -> tuple[str, int]:
    """Return the verified live endpoint only when the compatibility row agrees."""
    binding_host = _normalized_local_host(binding.get("host"))
    record_host = _normalized_local_host(record.get("host"))
    binding_port = _int_or_zero(binding.get("port"))
    record_port = _int_or_zero(record.get("port"))
    if binding_host not in {"127.0.0.1"} or record_host not in {"127.0.0.1"}:
        raise AdapterError(
            f"{STALE_BINDING_ERROR_CODE}: visible transport must remain localhost"
        )
    if not binding_port or binding_port != record_port or binding_host != record_host:
        raise AdapterError(
            f"{STALE_BINDING_ERROR_CODE}: compatibility endpoint "
            f"{record_host}:{record_port} disagrees with verified binding "
            f"{binding_host}:{binding_port}"
        )
    return binding_host, binding_port


def visible_binding_snapshot(record: dict[str, Any], binding: dict[str, Any]) -> dict[str, Any]:
    port_value = binding.get("port", record.get("port", 0))
    try:
        port = int(port_value)
    except (TypeError, ValueError):
        port = 0
    generation_value = binding.get("binding_generation", record.get("binding_generation", 0))
    binding_generation = _int_or_zero(generation_value)
    fencing_generation = _int_or_zero(
        binding.get("fencing_generation", record.get("fencing_generation", binding_generation))
    )
    return {
        "worker_id": str(record.get("worker_id") or ""),
        "alias": str(record.get("alias") or record.get("worker_id") or ""),
        "alias_scope": str(record.get("alias_scope") or record.get("scope_id") or "global"),
        "instance_id": visible_instance_id(record, binding),
        "pane_id": str(binding.get("pane_id") or record.get("pane_id") or ""),
        "pane_pid": binding.get("pane_pid", record.get("pane_pid")),
        "port": port,
        "binding_generation": binding_generation,
        "fencing_generation": fencing_generation,
        "lease_id": str(binding.get("lease_id") or record.get("lease_id") or ""),
        "lease_owner": str(binding.get("lease_owner") or record.get("lease_owner") or ""),
        "lease_status": str(binding.get("lease_status") or record.get("lease_status") or "unmanaged"),
        "host": _normalized_local_host(binding.get("host", record.get("host"))),
        "binding_confidence": str(binding.get("binding_confidence") or ""),
        "tmux_session": str(binding.get("tmux_session") or record.get("tmux_session") or ""),
        "tmux_window": str(binding.get("tmux_window") or record.get("tmux_window") or ""),
        "tmux_pane_index": str(binding.get("tmux_pane_index") or record.get("tmux_pane_index") or ""),
        "opencode_pids": binding.get("opencode_pids", record.get("opencode_pids", [])),
        "opencode_pid": binding.get("opencode_pid", record.get("opencode_pid", 0)),
        "pane_start_time_ticks": binding.get("pane_start_time_ticks", record.get("pane_start_time_ticks", 0)),
        "opencode_start_time_ticks": binding.get("opencode_start_time_ticks", record.get("opencode_start_time_ticks", 0)),
        "launch_owned_match": bool(binding.get("launch_owned_match", False)),
        "launch_evidence": binding.get("launch_evidence", record.get("launch_evidence", {})),
        "listener_pids": binding.get("listener_pids", record.get("listener_pids", [])),
    }


def visible_binding_snapshots_match(before: dict[str, Any], after: dict[str, Any]) -> bool:
    for field in ("instance_id", "pane_id", "pane_pid", "port"):
        if str(before.get(field) or "") != str(after.get(field) or ""):
            return False
    before_generation = int(before.get("binding_generation") or 0)
    after_generation = int(after.get("binding_generation") or 0)
    if (before_generation or after_generation) and before_generation != after_generation:
        return False
    before_fence = int(before.get("fencing_generation") or before_generation or 0)
    after_fence = int(after.get("fencing_generation") or after_generation or 0)
    if (before_fence or after_fence) and before_fence != after_fence:
        return False
    before_lease = str(before.get("lease_id") or "")
    after_lease = str(after.get("lease_id") or "")
    if (before_lease or after_lease) and before_lease != after_lease:
        return False
    before_status = str(before.get("lease_status") or "unmanaged")
    after_status = str(after.get("lease_status") or "unmanaged")
    if before_status != after_status:
        return False
    return True


def visible_side_effect_fence(snapshot: dict[str, Any]) -> dict[str, Any]:
    return {
        "worker_id": str(snapshot.get("worker_id") or ""),
        "alias": str(snapshot.get("alias") or ""),
        "alias_scope": str(snapshot.get("alias_scope") or "global"),
        "instance_id": str(snapshot.get("instance_id") or ""),
        "binding_generation": int(snapshot.get("binding_generation") or 0),
        "fencing_generation": int(snapshot.get("fencing_generation") or snapshot.get("binding_generation") or 0),
        "lease_id": str(snapshot.get("lease_id") or ""),
        "lease_owner": str(snapshot.get("lease_owner") or ""),
        "lease_status": str(snapshot.get("lease_status") or "unmanaged"),
        "pane_id": str(snapshot.get("pane_id") or ""),
        "pane_pid": snapshot.get("pane_pid"),
        "port": int(snapshot.get("port") or 0),
    }


def acceptance_fence_matches_binding(
    fence: dict[str, Any],
    snapshot: dict[str, Any],
) -> bool:
    if not fence:
        return True
    for field in ("worker_id", "instance_id"):
        if str(fence.get(field) or "") != str(snapshot.get(field) or ""):
            return False
    for field in ("binding_generation", "fencing_generation"):
        if int(fence.get(field) or 0) != int(snapshot.get(field) or 0):
            return False
    return True


def terminal_protocol_submission_status(task_dir: Path) -> dict[str, Any]:
    classification = classify_terminal_protocol(task_dir)
    fence = read_json_object(task_dir / "acceptance_fence.json")
    if classification["classification"] == TERMINAL_PROTOCOL_CLASSIFICATION_INVALID:
        return {
            "ok": False,
            "status": "invalid_terminal_protocol_identity",
            "classification": classification,
            "fence": fence,
        }
    if (
        classification["classification"] == TERMINAL_PROTOCOL_CLASSIFICATION_MODERN
        and not fence
    ):
        return {
            "ok": False,
            "status": "terminal_acceptance_fence_missing",
            "classification": classification,
            "fence": {},
        }
    return {
        "ok": True,
        "status": str(classification.get("reason") or ""),
        "classification": classification,
        "fence": fence,
    }


def acceptance_session_observation(
    root: Path,
    worker_id: str,
    fence: dict[str, Any],
    *,
    runtime_backend: str,
    allow_pending: bool,
    allow_known_idle: bool = False,
    fence_path: Path | None = None,
    bind_pending_singleton: bool = True,
    allow_expected_idle_identity: bool = True,
) -> dict[str, Any]:
    if not fence:
        return {
            "required": False,
            "ok": True,
            "status": "legacy_task_without_acceptance_fence",
            "session_ids": [],
            "expected_session_id": "",
            "fence": {},
        }
    expected = str(fence.get("session_id") or "").strip()
    if expected and not expected.startswith("ses_"):
        return {
            "required": True,
            "ok": False,
            "status": "invalid_expected_session_id",
            "session_ids": [],
            "expected_session_id": expected,
            "fence": dict(fence),
        }
    try:
        snapshot = session_status_snapshot(
            root,
            worker_id,
            runtime_backend=runtime_backend,
        )
    except AdapterError as exc:
        return {
            "required": True,
            "ok": False,
            "status": "live_session_observation_failed",
            "error": str(exc),
            "session_ids": [],
            "expected_session_id": expected,
            "fence": dict(fence),
        }
    session_ids = sorted(
        {
            str(item or "").strip()
            for item in snapshot.get("session_ids", [])
            if str(item or "").strip().startswith("ses_")
        }
    )
    if not session_ids:
        if (
            allow_known_idle
            and expected
            and str(fence.get("session_fence_state") or "")
            == "live_observed"
        ):
            try:
                identity_snapshot = session_identity_snapshot(
                    root,
                    worker_id,
                    expected,
                    runtime_backend=runtime_backend,
                )
            except AdapterError as exc:
                return {
                    "required": True,
                    "ok": False,
                    "status": "known_idle_session_observation_failed",
                    "error": str(exc),
                    "session_ids": [],
                    "expected_session_id": expected,
                    "fence": dict(fence),
                    "snapshot": snapshot,
                }
            observed_session_id = str(
                identity_snapshot.get("observed_session_id")
                or ""
            )
            idle_observation = {
                "required": True,
                "session_ids": [],
                "expected_session_id": expected,
                "fence": dict(fence),
                "snapshot": snapshot,
                "identity_snapshot": identity_snapshot,
            }
            if identity_snapshot.get("exists") and observed_session_id == expected:
                return {
                    **idle_observation,
                    "ok": True,
                    "status": "known_idle_session_observed",
                }
            return {
                **idle_observation,
                "ok": False,
                "status": "known_idle_session_not_found",
            }
        return {
            "required": True,
            "ok": bool(allow_pending),
            "status": (
                "pending_live_session_observation"
                if allow_pending
                else "live_session_not_observed"
            ),
            "session_ids": [],
            "expected_session_id": expected,
            "fence": dict(fence),
            "snapshot": snapshot,
        }
    if expected and expected not in session_ids:
        if (
            allow_expected_idle_identity
            and str(fence.get("session_fence_state") or "") != "live_observed"
        ):
            # PRE-SUBMIT stage only (#1026): the status map only reports
            # sessions with an active runtime state, so a busy unrelated
            # session is not evidence that the expected session is absent.
            # Before any prompt input, verify the expected session identity
            # directly; an existing matching session may then receive the
            # explicit select bind. After delivery this existence check is
            # NOT execution evidence: the post-delivery wait disables it so a
            # session that merely exists never reports a successful
            # observation of the target actually running.
            try:
                identity_snapshot = session_identity_snapshot(
                    root,
                    worker_id,
                    expected,
                    runtime_backend=runtime_backend,
                )
            except AdapterError as exc:
                return {
                    "required": True,
                    "ok": False,
                    "status": "expected_session_observation_failed",
                    "error": str(exc),
                    "session_ids": session_ids,
                    "expected_session_id": expected,
                    "fence": dict(fence),
                    "snapshot": snapshot,
                }
            identity_observation = {
                "required": True,
                "session_ids": session_ids,
                "expected_session_id": expected,
                "fence": dict(fence),
                "snapshot": snapshot,
                "identity_snapshot": identity_snapshot,
            }
            if (
                identity_snapshot.get("exists")
                and str(identity_snapshot.get("observed_session_id") or "")
                == expected
            ):
                # Keep the fence provisional: only the busy-map path and the
                # task-signal reconciliation upgrade a fence to live_observed.
                return {
                    **identity_observation,
                    "ok": True,
                    "status": "expected_idle_session_observed",
                }
        return {
            "required": True,
            "ok": False,
            "status": "live_session_mismatch",
            "session_ids": session_ids,
            "expected_session_id": expected,
            "fence": dict(fence),
            "snapshot": snapshot,
        }
    if not expected and len(session_ids) != 1:
        return {
            "required": True,
            "ok": False,
            "status": "live_session_ambiguous",
            "session_ids": session_ids,
            "expected_session_id": "",
            "fence": dict(fence),
            "snapshot": snapshot,
        }
    if not expected and not bind_pending_singleton:
        return {
            "required": True,
            "ok": bool(allow_pending),
            "status": (
                "pending_live_session_observation"
                if allow_pending
                else "pending_singleton_not_bound"
            ),
            "session_ids": session_ids,
            "expected_session_id": "",
            "observed_session_ids": session_ids,
            "singleton_bound": False,
            "fence": dict(fence),
            "snapshot": snapshot,
        }
    observed_session_id = expected or session_ids[0]
    updated_fence = {
        **fence,
        "session_id": observed_session_id,
        "session_fence_state": "live_observed",
        "session_observed_at": str(snapshot.get("checked_at") or utc_now()),
        "session_observation_source": "opencode_session_status",
    }
    if fence_path is not None and updated_fence != fence:
        update_current_acceptance_fence_records(fence_path, updated_fence)
    return {
        "required": True,
        "ok": True,
        "status": "live_session_observed",
        "session_ids": session_ids,
        "expected_session_id": observed_session_id,
        "fence": updated_fence,
        "snapshot": snapshot,
    }


def wait_for_acceptance_session_observation(
    root: Path,
    worker_id: str,
    fence: dict[str, Any],
    *,
    runtime_backend: str,
    fence_path: Path,
    allow_known_idle: bool = False,
    timeout_seconds: float = 6.0,
    poll_seconds: float = 0.25,
) -> dict[str, Any]:
    deadline = time.time() + timeout_seconds
    observation: dict[str, Any] = {}
    while True:
        observation = acceptance_session_observation(
            root,
            worker_id,
            fence,
            runtime_backend=runtime_backend,
            allow_pending=False,
            allow_known_idle=allow_known_idle,
            fence_path=fence_path,
            allow_expected_idle_identity=False,
        )
        if observation.get("ok"):
            return observation
        if observation.get("status") not in {
            "live_session_not_observed",
            "live_session_observation_failed",
            "expected_session_observation_failed",
        }:
            return observation
        if time.time() >= deadline:
            return observation
        time.sleep(poll_seconds)


def check_visible_side_effect_fence(
    root: Path,
    worker_id: str,
    expected_snapshot: dict[str, Any],
    *,
    runtime_backend: str,
    operation: str,
) -> dict[str, Any]:
    error = ""
    try:
        current_record = require_visible_worker(root, worker_id)
        current_binding = runtime_binding_for_visible_worker(
            root,
            worker_id,
            runtime_backend,
        )
        verified_visible_transport_endpoint(current_record, current_binding)
        current_snapshot = visible_binding_snapshot(current_record, current_binding)
        ok = (
            current_binding.get("binding_confidence") == "strong"
            and visible_binding_snapshots_match(expected_snapshot, current_snapshot)
        )
    except AdapterError as exc:
        current_snapshot = {"error": str(exc)[:500]}
        ok = False
        error = str(exc)
    payload = {
        "schema_version": 1,
        "checked_at": utc_now(),
        "operation": operation,
        "worker_id": worker_id,
        "ok": ok,
        "error_code": "" if ok else STALE_BINDING_ERROR_CODE,
        "error": error,
        "expected_binding_snapshot": expected_snapshot,
        "current_binding_snapshot": current_snapshot,
    }
    if not ok:
        safe_worker = safe_slug(worker_id, "worker")
        digest = hashlib.sha256(
            json.dumps(payload, sort_keys=True, ensure_ascii=False).encode("utf-8")
        ).hexdigest()[:12]
        stamp = re.sub(r"[^0-9A-Za-z]+", "", payload["checked_at"])[:32]
        path = (
            ensure_framework(root)
            / "side-effect-fence"
            / safe_worker
            / f"{stamp}-{digest}.json"
        )
        write_json(path, payload)
        payload["diagnostic_path"] = rel(path, root)
    else:
        payload["diagnostic_path"] = ""
    return payload


def require_visible_side_effect_fence(
    root: Path,
    worker_id: str,
    expected_snapshot: dict[str, Any],
    *,
    runtime_backend: str,
    operation: str,
) -> dict[str, Any]:
    check = check_visible_side_effect_fence(
        root,
        worker_id,
        expected_snapshot,
        runtime_backend=runtime_backend,
        operation=operation,
    )
    if not check["ok"]:
        raise AdapterError(
            f"{STALE_BINDING_ERROR_CODE}: binding changed before {operation}; "
            f"diagnostic={check['diagnostic_path']}"
        )
    return check


def _rotation_receipt_filename(receipt: dict[str, Any]) -> str:
    checked_at = str(receipt.get("checked_at") or utc_now())
    stamp = re.sub(r"[^0-9A-Za-z]+", "", checked_at)[:32] or "rotation"
    digest = hashlib.sha256(json.dumps(receipt, sort_keys=True, ensure_ascii=False).encode("utf-8")).hexdigest()[:12]
    return f"{stamp}-{digest}.json"


def build_rotation_receipt(
    result: dict[str, Any],
    *,
    task_id: str = "",
    attempt_id: str = "",
    role: str = "",
    contract_hash: str = "",
    rotation_reason: str = "manual_new",
    rehydration_packet_type: str = "new-task",
    context_domain_id: str = "",
    previous_context_domain_id: str = "",
    same_context_domain_continuity_proven: bool = False,
    worker_process_restarted_after_last_task: bool = False,
    process_restart_evidence: str = "",
) -> dict[str, Any]:
    rotation_reason = str(rotation_reason or "manual_new").strip()
    rehydration_packet_type = str(rehydration_packet_type or "new-task").strip()
    if rotation_reason not in SESSION_ROTATION_REASONS:
        raise AdapterError(f"rotation reason must be one of: {', '.join(sorted(SESSION_ROTATION_REASONS))}")
    if rehydration_packet_type not in REHYDRATION_PACKET_TYPES:
        raise AdapterError(f"rehydration packet type must be one of: {', '.join(sorted(REHYDRATION_PACKET_TYPES))}")
    context_domain = context_domain_evidence(
        current_context_domain_id=context_domain_id,
        previous_context_domain_id=previous_context_domain_id,
        same_context_domain_continuity_proven=same_context_domain_continuity_proven,
    )
    if rotation_reason == "context_domain_changed" and not context_domain["changed"]:
        raise AdapterError(
            "context_domain_changed rotation requires different non-empty current and previous context-domain ids"
        )
    process_restart_evidence = str(process_restart_evidence or "").strip()
    if worker_process_restarted_after_last_task and not process_restart_evidence:
        raise AdapterError(
            "worker process restart classification requires non-empty process restart evidence"
        )
    old_session_id = str(result.get("rotation_source_session_id") or "") or _first_session_id(result.get("reset_status_before_ids"))
    new_session_id = str(result.get("reset_session_id") or "").strip() or _first_session_id(result.get("reset_status_after_ids"))
    fresh_home_without_session_proven = bool(
        not new_session_id
        and result.get("reset_evidence_found") is True
        and (
            result.get("reset_command_ack_found") is True
            or (result.get("selection_continuity") or {}).get("status") == "preserved_fresh_home"
        )
        and result.get("reset_status_empty_found") is True
        and result.get("reset_tui_home_evidence_found") is True
    )
    evidence_sources = [
        str(result.get("evidence_source") or "").strip(),
        str(result.get("reset_tui_home_before_evidence_source") or "").strip(),
        str(result.get("reset_tui_evidence_source") or "").strip(),
        "status_cleared" if result.get("reset_status_cleared_found") else "",
        "fresh_process_empty_status" if result.get("reset_fresh_process_evidence_found") else "",
    ]
    binding_snapshot = result.get("binding_snapshot") or {}
    side_effect_fence = result.get("side_effect_fence") or visible_side_effect_fence(binding_snapshot)
    return {
        "schema_version": 1,
        "receipt_kind": "worker_session_rotation",
        "worker_id": str(result.get("worker_id") or ""),
        "pane_id": str(result.get("pane_id") or ""),
        "pane_pid": result.get("pane_pid"),
        "port": int(result.get("port") or 0),
        "binding_generation": int(binding_snapshot.get("binding_generation") or 0),
        "binding_confidence": str(result.get("binding_confidence") or ""),
        "binding_snapshot": binding_snapshot,
        "post_binding_snapshot": result.get("post_binding_snapshot") or {},
        "side_effect_fence": side_effect_fence,
        "acceptance_fence": {
            **side_effect_fence,
            "session_id": new_session_id,
            "task_id": str(task_id or ""),
            "attempt_id": str(attempt_id or ""),
            "contract_hash": str(contract_hash or ""),
        },
        "session_id": new_session_id,
        "old_session_id": old_session_id,
        "new_session_id": new_session_id,
        "task_id": str(task_id or ""),
        "attempt_id": str(attempt_id or ""),
        "role": str(role or ""),
        "contract_hash": str(contract_hash or ""),
        "session_action": "rotate",
        "session_action_reason": rotation_reason,
        "rotation_reason": rotation_reason,
        "rehydration_packet_type": rehydration_packet_type,
        "fresh_process_status": (
            "verified_fresh_process"
            if result.get("reset_fresh_process_evidence_found")
            else ""
        ),
        "context_domain": context_domain,
        "selection_continuity": result.get("selection_continuity") or {
            "status": "unverified", "before": {}, "after": {},
            "limit": "reset evidence alone does not prove selected configuration continuity",
        },
        "reset_evidence": {
            "found": bool(result.get("reset_evidence_found")),
            "command_ack_found": bool(result.get("reset_command_ack_found")),
            "status_cleared_found": bool(result.get("reset_status_cleared_found")),
            "status_empty_found": bool(result.get("reset_status_empty_found")),
            "tui_home_evidence_found": bool(result.get("reset_tui_home_evidence_found")),
            "fresh_home_without_session_proven": fresh_home_without_session_proven,
            "source": ",".join(source for source in evidence_sources if source),
            "old_session_id": old_session_id,
            "new_session_id": new_session_id,
            "pane_pid": result.get("pane_pid"),
            "binding_generation": int(binding_snapshot.get("binding_generation") or 0),
            "worker_process_restarted_after_last_task": bool(
                worker_process_restarted_after_last_task
            ),
            "process_restart_evidence": process_restart_evidence,
            "fresh_process_history": result.get("reset_fresh_process_history") or {},
        },
        "evidence_source": ",".join(source for source in evidence_sources if source),
        "checked_at": str(result.get("checked_at") or result.get("executed_at") or utc_now()),
    }


def write_rotation_receipt(root: Path, receipt: dict[str, Any]) -> Path:
    safe_slug(str(receipt.get("worker_id") or ""), "worker")
    out_dir = ensure_framework(root) / "session-rotations" / str(receipt["worker_id"])
    out_dir.mkdir(parents=True, exist_ok=True)
    path = out_dir / _rotation_receipt_filename(receipt)
    write_json(path, receipt)
    write_json(out_dir / "latest.json", receipt)
    return path


def marker_path(tdir: Path, marker: str) -> Path:
    marker_name = VALID_WAIT_MARKERS.get(marker)
    if not marker_name:
        raise AdapterError(f"marker must be one of: {', '.join(sorted(VALID_WAIT_MARKERS))}")
    return tdir / marker_name


def visible_registry_path(root: Path) -> Path:
    return framework_root(root) / VISIBLE_WORKER_REGISTRY


def visible_launch_path(root: Path) -> Path:
    return framework_root(root) / VISIBLE_LAUNCH_REGISTRY


def visible_worker_launch_path(root: Path, worker_id: str) -> Path:
    worker = safe_slug(worker_id, "worker")
    return framework_root(root) / f"opencode_visible_launch_{worker}.json"


def default_visible_registry(root: Path) -> dict[str, Any]:
    return {
        "schema_version": 1,
        "root": str(root),
        "workers": [],
        "notes": [
            "Visible workers must be explicitly registered by pane_id and port.",
            "No worker is selected automatically.",
        ],
    }


def read_visible_registry(root: Path) -> dict[str, Any]:
    path = visible_registry_path(root)
    data = read_json_safe(path)
    if not data:
        return default_visible_registry(root)
    workers = data.get("workers", [])
    if not isinstance(workers, list):
        data["workers"] = []
    return data


def prepare_visible_registry(root: Path, registry: dict[str, Any]) -> dict[str, Any]:
    registry["schema_version"] = int(registry.get("schema_version") or 1)
    registry["root"] = str(root)
    registry["updated_at"] = utc_now()
    return registry


def visible_worker_record_from_registry(registry: dict[str, Any], worker_id: str) -> dict[str, Any] | None:
    for worker in registry.get("workers", []):
        if isinstance(worker, dict) and str(worker.get("worker_id", "")) == worker_id:
            return worker
    return None


def visible_worker_record(root: Path, worker_id: str) -> dict[str, Any] | None:
    return visible_worker_record_from_registry(read_visible_registry(root), worker_id)


def expected_port_from_worker_alias(worker_id: str) -> int | None:
    match = re.match(r"^vw-(?:current|port)-?([0-9]+)(?:[@:].*)?$", worker_id)
    if not match:
        return None
    try:
        return int(match.group(1))
    except ValueError:
        return None


def enforce_worker_alias_port(worker_id: str, port: int) -> None:
    expected_port = expected_port_from_worker_alias(worker_id)
    if expected_port is None:
        return
    observed_port = int(port)
    if observed_port != expected_port:
        raise AdapterError(
            "worker alias port mismatch: "
            f"{worker_id!r} implies port {expected_port}, got {observed_port}"
        )


def binding_generation(record: dict[str, Any] | None) -> int:
    if not isinstance(record, dict):
        return 0
    try:
        return max(0, int(record.get("binding_generation") or 0))
    except (TypeError, ValueError):
        return 0


def require_current_binding_lease(record: dict[str, Any]) -> None:
    lease_id = str(record.get("binding_lease_id") or "")
    expires_at = str(
        record.get("binding_expires_at")
        or record.get("expires_at")
        or ""
    )
    if not lease_id or not expires_at:
        raise AdapterError(
            "binding lease metadata is required for real TUI submission"
        )
    try:
        expires = datetime.fromisoformat(expires_at.replace("Z", "+00:00"))
        if expires.tzinfo is None:
            expires = expires.replace(tzinfo=timezone.utc)
    except ValueError as exc:
        raise AdapterError(
            f"binding lease expiry is invalid: {expires_at}"
        ) from exc
    if expires <= datetime.now(timezone.utc):
        raise AdapterError(f"binding lease expired at {expires_at}")


def binding_lease_seconds() -> int:
    raw = str(os.environ.get("OMX_VISIBLE_BINDING_LEASE_SECONDS") or "").strip()
    try:
        return max(300, int(raw)) if raw else BINDING_LEASE_SECONDS
    except ValueError:
        return BINDING_LEASE_SECONDS


def binding_expiration() -> str:
    expires = datetime.now(timezone.utc) + timedelta(
        seconds=binding_lease_seconds()
    )
    return expires.replace(microsecond=0).isoformat().replace("+00:00", "Z")


def binding_token(worker_id: str, action: str) -> str:
    seed = (
        f"{worker_id}\0{action}\0{time.time_ns()}\0{os.getpid()}\0"
        f"{os.environ.get('TMUX_PANE', '')}"
    )
    return hashlib.sha256(seed.encode("utf-8")).hexdigest()[:24]


def apply_binding_lease(
    record: dict[str, Any],
    *,
    existing: dict[str, Any] | None,
    action: str,
    new_lease: bool,
) -> None:
    now = utc_now()
    lease_id = ""
    if not new_lease and isinstance(existing, dict):
        lease_id = str(existing.get("binding_lease_id") or "")
    if not lease_id:
        lease_id = binding_token(
            str(record.get("worker_id") or "worker"),
            "lease",
        )
    created_at = (
        str(existing.get("binding_created_at") or existing.get("created_at") or "")
        if isinstance(existing, dict) and not new_lease
        else ""
    ) or now
    created_by = (
        str(existing.get("binding_created_by") or existing.get("created_by") or "")
        if isinstance(existing, dict) and not new_lease
        else ""
    ) or f"omx_opencode_tui_adapter:{action}"
    owner_run_id = (
        str(existing.get("binding_owner_run_id") or existing.get("owner_run_id") or "")
        if isinstance(existing, dict) and not new_lease
        else ""
    ) or str(os.environ.get("OMX_RUN_ID") or "")
    owner_task_id = (
        str(existing.get("binding_owner_task_id") or existing.get("owner_task_id") or "")
        if isinstance(existing, dict) and not new_lease
        else ""
    ) or str(os.environ.get("OMX_TASK_ID") or "")
    expires_at = binding_expiration()
    record.update(
        {
            "binding_lease_id": lease_id,
            "binding_created_at": created_at,
            "binding_expires_at": expires_at,
            "binding_created_by": created_by,
            "binding_owner_run_id": owner_run_id,
            "binding_owner_task_id": owner_task_id,
            "binding_owner_tmux_pane": str(os.environ.get("TMUX_PANE") or ""),
            "created_by": created_by,
            "owner_run_id": owner_run_id,
            "owner_task_id": owner_task_id,
            "expires_at": expires_at,
        }
    )


def binding_lease_is_current(record: dict[str, Any]) -> bool:
    lease_id = str(record.get("binding_lease_id") or "")
    expires_at = str(record.get("binding_expires_at") or record.get("expires_at") or "")
    if not lease_id or not expires_at:
        return False
    try:
        expires = datetime.fromisoformat(expires_at.replace("Z", "+00:00"))
        if expires.tzinfo is None:
            expires = expires.replace(tzinfo=timezone.utc)
    except ValueError:
        return False
    return expires > datetime.now(timezone.utc)


def _binding_identity_value(record: dict[str, Any], field: str) -> str:
    value = record.get(field)
    if value is None:
        return ""
    if field == "host":
        return _normalized_local_host(value)
    if field in {"port", "pane_pid"}:
        try:
            return str(int(value))
        except (TypeError, ValueError):
            return str(value)
    return str(value)


def visible_worker_binding_conflicts(existing: dict[str, Any], incoming: dict[str, Any]) -> list[str]:
    conflicts: list[str] = []
    for field in (
        "host",
        "port",
        "pane_id",
        "pane_pid",
        "tmux_session",
        "tmux_window",
    ):
        old_value = _binding_identity_value(existing, field)
        new_value = _binding_identity_value(incoming, field)
        if old_value and new_value and old_value != new_value:
            conflicts.append(f"{field}: existing={old_value!r} incoming={new_value!r}")
    return conflicts


def visible_worker_binding_fence_matches(
    expected: dict[str, Any],
    current: dict[str, Any],
) -> bool:
    expected_generation = binding_generation(expected)
    current_generation = binding_generation(current)
    if (
        (expected_generation or current_generation)
        and expected_generation != current_generation
    ):
        return False
    expected_lease = str(expected.get("binding_lease_id") or "")
    current_lease = str(current.get("binding_lease_id") or "")
    if (expected_lease or current_lease) and expected_lease != current_lease:
        return False
    return not visible_worker_binding_conflicts(expected, current)


def visible_worker_stop_fence(
    record: dict[str, Any],
    worker_id: str,
) -> dict[str, Any]:
    try:
        return normalize_visible_stop_fence(record, worker_id)
    except VisibleRegistryError as exc:
        raise AdapterError(str(exc)) from exc


def visible_worker_stop_fence_matches(
    expected: dict[str, Any],
    current: dict[str, Any],
    worker_id: str,
) -> bool:
    return visible_stop_fence_matches(expected, current, worker_id)


def parse_visible_worker_stop_fence(
    raw: str,
    worker_id: str,
) -> dict[str, Any]:
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise AdapterError("expected stop fence is invalid JSON") from exc
    return visible_worker_stop_fence(parsed, worker_id)


def write_visible_binding_audit(
    root: Path,
    worker_id: str,
    *,
    action: str,
    result: str,
    reason: str,
    cas_result: str = "",
    old_record: dict[str, Any] | None = None,
    new_record: dict[str, Any] | None = None,
    transaction_id: str = "",
    audit_path: Path | None = None,
    created_at: str = "",
    global_owner_lock_snapshot: list[str] | None = None,
    global_mutation_gate_result: str = "",
) -> Path:
    safe_worker = safe_slug(worker_id, "worker")
    created_at = created_at or utc_now()
    payload = {
        "schema_version": 1,
        "audit_kind": "visible_worker_binding_mutation",
        "worker_id": worker_id,
        "action": action,
        "result": result,
        "cas_result": cas_result,
        "reason": reason,
        "transaction_id": transaction_id,
        "old_record": old_record or {},
        "new_record": new_record or {},
        "caller": {
            "argv": list(sys.argv),
            "cwd": os.getcwd(),
            "TMUX": str(os.environ.get("TMUX") or ""),
            "TMUX_PANE": str(os.environ.get("TMUX_PANE") or ""),
            "tmux_session": str(
                os.environ.get("OMX_TMUX_SESSION")
                or (new_record or {}).get("tmux_session")
                or (old_record or {}).get("tmux_session")
                or ""
            ),
            "tmux_window": str(
                os.environ.get("OMX_TMUX_WINDOW")
                or (new_record or {}).get("tmux_window")
                or (old_record or {}).get("tmux_window")
                or ""
            ),
        },
        "created_at": created_at,
        "updated_at": utc_now(),
    }
    if global_owner_lock_snapshot is not None:
        payload["global_owner_lock_snapshot"] = list(
            global_owner_lock_snapshot
        )
    if global_mutation_gate_result:
        payload["global_mutation_gate_result"] = (
            global_mutation_gate_result
        )
    path = audit_path
    if path is None:
        stamp = re.sub(r"[^0-9A-Za-z]+", "", created_at)[:32] or "audit"
        digest = hashlib.sha256(
            json.dumps(payload, sort_keys=True, ensure_ascii=False).encode("utf-8")
        ).hexdigest()[:12]
        path = (
            ensure_framework(root)
            / "visible-binding-audit"
            / safe_worker
            / f"{stamp}-{time.time_ns()}-{digest}.json"
        )
    write_json_atomic(path, payload)
    return path


def global_owner_lock_names(root: Path) -> list[str]:
    lock_root = framework_root(root) / "visible-runs" / "_locks"
    return sorted(
        path.name
        for path in lock_root.glob("*.lock.json")
        if path.is_file()
    )


def visible_launch_record(root: Path, worker_id: str) -> dict[str, Any]:
    scoped = read_json_safe(visible_worker_launch_path(root, worker_id))
    if str(scoped.get("worker_id", "")) == worker_id:
        return scoped
    data = read_json_safe(visible_launch_path(root))
    if str(data.get("worker_id", "")) == worker_id:
        return data
    workers = data.get("workers", [])
    if isinstance(workers, list):
        for worker in workers:
            if isinstance(worker, dict) and str(worker.get("worker_id", "")) == worker_id:
                return worker
    return {}


def registry_with_visible_worker(
    root: Path,
    registry: dict[str, Any],
    record: dict[str, Any],
) -> dict[str, Any]:
    worker_id = str(record.get("worker_id", ""))
    workers = [
        worker
        for worker in registry.get("workers", [])
        if not (isinstance(worker, dict) and str(worker.get("worker_id", "")) == worker_id)
    ]
    workers.append(record)
    workers.sort(key=lambda item: str(item.get("worker_id", "")))
    registry["workers"] = workers
    return prepare_visible_registry(root, registry)


def current_window_pane(
    root: Path,
    pane_id: str,
    *,
    runtime_substrate: str = "",
) -> tuple[dict[str, Any], dict[str, Any] | None]:
    if not pane_id.startswith("%"):
        raise AdapterError("--pane must be a tmux pane id such as %38")
    tmux_data = (
        discover_tmux_opencode(
            pane_target=pane_id,
            runtime_substrate=runtime_substrate,
        )
        if runtime_substrate
        else discover_tmux_opencode(pane_target=pane_id)
    )
    for pane in tmux_data.get("panes", []):
        if pane.get("pane_id") == pane_id:
            return tmux_data, pane
    return tmux_data, None


def pane_ref_parts(pane: dict[str, Any]) -> tuple[str, str, str]:
    pane_ref = str(pane.get("pane_ref", ""))
    session = pane_ref.split(":", 1)[0] if ":" in pane_ref else ""
    window = pane_ref.rsplit(".", 1)[0] if "." in pane_ref else pane_ref
    pane_index = pane_ref.rsplit(".", 1)[1] if "." in pane_ref else ""
    return session, window, pane_index


def socket_listeners_for_port(port: int) -> dict[str, Any]:
    matches: list[dict[str, Any]] = []
    warnings: list[str] = []
    complete = False
    commands = {"ss": ["ss", "-H", "-ltnp", f"sport = :{int(port)}"],
                "lsof": ["lsof", "-nP", f"-iTCP:{int(port)}", "-sTCP:LISTEN"],
                "netstat": ["netstat", "-ltnp"]}
    for key, argv in commands.items():
        record = run_socket_command(argv, " ".join(argv))
        if not record.get("available"):
            warnings.append(f"{record.get('name')} returned {record.get('returncode')}: {str(record.get('stderr', '')).strip()[:200]}")
            continue
        rows, tool_complete = target_listeners(key, record.get("stdout", ""), port)
        matches.extend(rows)
        complete = complete or tool_complete
        if key == "ss" and tool_complete:
            break
    pids: list[int] = []
    for match in matches:
        pids.extend(int(pid) for pid in match.get("pids", []) if str(pid).isdigit())
    return {
        "port": int(port),
        "matches": matches,
        "listener_pids": unique_ints(pids),
        "warnings": warnings,
        "errors": [] if complete and len(unique_ints(pids)) == 1 else ["listener ownership incomplete or ambiguous"],
    }


def verify_visible_binding(
    root: Path,
    worker_id: str,
    pane_id: str,
    host: str,
    port: int,
    backend: str = "opencode_tui",
    *,
    runtime_substrate: str = "",
) -> dict[str, Any]:
    errors: list[str] = []
    warnings: list[str] = []
    substrate = runtime_substrate or current_runtime_substrate()
    if backend != "opencode_tui":
        errors.append(f"unsupported backend: {backend}")
    if host not in {"127.0.0.1", "localhost"}:
        errors.append(f"host must be 127.0.0.1 or localhost, got {host}")
    host = "127.0.0.1" if host == "localhost" else host
    if not (1 <= int(port) <= 65535):
        errors.append(f"invalid port: {port}")

    tmux_data: dict[str, Any] = {}
    pane: dict[str, Any] | None = None
    tree: dict[str, Any] = {"nodes": {}, "edges": []}
    opencode_pids: list[int] = []
    related_pids: list[int] = []
    opencode_cmdline_contains_port = False
    launch_evidence = visible_launch_record(root, worker_id)
    if not errors:
        tmux_data, pane = current_window_pane(
            root,
            pane_id,
            runtime_substrate=substrate,
        )
        if not pane:
            errors.append(f"pane {pane_id} was not found in the current tmux window")
        else:
            pane_pid = pane.get("pane_pid")
            if not pane_pid:
                errors.append(f"pane {pane_id} has no pane_pid")
            else:
                tree = recursive_process_tree(int(pane_pid), max_depth=5)
                related_pids = unique_ints([int(pid) for pid in tree.get("nodes", {}).keys() if str(pid).isdigit()])
                opencode_pids = find_opencode_pids(tree)
                tree_text = process_tree_text(tree)
                opencode_cmdline_contains_port = bool(
                    re.search(rf"--port(?:=|\s+){int(port)}(?:\s|$)", tree_text)
                )
                if not opencode_pids:
                    errors.append(f"pane {pane_id} process tree does not contain opencode")

    probe: dict[str, Any] = {}
    missing_endpoints: list[str] = []
    if not errors:
        probe = probe_port(int(port), hostname=host, include_events=False)
        if not probe.get("reachable") or not probe.get("global_health_available") or not probe.get("doc_available"):
            errors.append(f"port {port} is not live with /global/health and /doc")
        methods = set(probe.get("detected_tui_methods", []))
        missing_endpoints = [endpoint for endpoint in TUI_ENDPOINTS_ORDERED if endpoint not in methods]
        if missing_endpoints:
            errors.append(f"/doc on port {port} does not confirm: {', '.join(missing_endpoints)}")

    socket_evidence = socket_listeners_for_port(int(port)) if not errors else {"matches": [], "listener_pids": [], "warnings": [], "errors": []}
    warnings.extend(socket_evidence.get("warnings", []))
    errors.extend(socket_evidence.get("errors", []))
    listener_pids = [int(pid) for pid in socket_evidence.get("listener_pids", []) if str(pid).isdigit()]
    nodes = tree.get("nodes", {})
    checked = set()
    for pid in set(opencode_pids).union(listener_pids):
        while str(pid) in nodes and pid not in checked:
            checked.add(pid)
            node = nodes[str(pid)]
            fresh = process_record(pid)
            if (fresh.get("start_time_ticks"), fresh.get("ppid"), fresh.get("cmdline")) != (node["start_time_ticks"], node["ppid"], node["cmdline"]):
                errors.append(f"process identity changed during binding: {pid}")
            pid = node["ppid"]
    if len(opencode_pids) != 1 or len(listener_pids) != 1:
        errors.append(
            "process identity is ambiguous: expected one opencode "
            "process and one port listener"
        )
    related_set = set(related_pids)
    opencode_set = set(opencode_pids)
    strong_pid_matches = sorted(set(listener_pids).intersection(related_set.union(opencode_set)))
    opencode_pid = (
        strong_pid_matches[0]
        if strong_pid_matches
        else listener_pids[0]
        if len(listener_pids) == 1
        else opencode_pids[0]
        if opencode_pids
        else 0
    )
    process_environment = (
        read_process_environment(opencode_pid)
        if opencode_pid > 0
        else {}
    )
    launch_owned_match = bool(
        launch_evidence
        and str(launch_evidence.get("worker_id", "")) == worker_id
        and str(launch_evidence.get("pane_id", "")) == pane_id
        and int(launch_evidence.get("port", 0) or 0) == int(port)
        and str(launch_evidence.get("host", "127.0.0.1")) in {"127.0.0.1", "localhost"}
        and bool(launch_evidence.get("launch_owned", False))
        and bool(launch_evidence.get("port_was_free_before_launch", False))
        and opencode_cmdline_contains_port
    )
    if not errors:
        if strong_pid_matches or launch_owned_match:
            binding_confidence = "strong"
        else:
            binding_confidence = "weak"
            if listener_pids:
                warnings.append(
                    f"port {port} is live, but listener pid(s) {listener_pids} are not in pane {pane_id} process tree"
                )
            else:
                warnings.append(f"port {port} is live, but no listener pid could be associated with pane {pane_id}")
    else:
        binding_confidence = "failed"

    session, window, pane_index = pane_ref_parts(pane or {})
    return {
        "schema_version": 1,
        "verified_at": utc_now(),
        "worker_id": worker_id,
        "backend": backend,
        "runtime_substrate": substrate,
        "host": host,
        "port": int(port),
        "pane_id": pane_id,
        "pane_exists": pane is not None,
        "pane_pid": pane.get("pane_pid") if pane else None,
        "pane_start_time_ticks": process_start_time_ticks(
            int(pane.get("pane_pid") or 0)
        )
        if pane
        else 0,
        "pane_title": pane.get("pane_title", "") if pane else "",
        "host_boot_id": host_boot_id(),
        "tmux_server_pid": tmux_server_pid(substrate),
        "opencode_pid": opencode_pid,
        "opencode_start_time_ticks": process_start_time_ticks(opencode_pid),
        "process_environment_projection": {
            key: process_environment.get(key, "")
            for key in (
                "OMX_WORKER_ID",
                "OMX_OPENCODE_HOST",
                "OMX_OPENCODE_PORT",
                "OMX_LAUNCH_ATTEMPT_ID",
            )
        },
        "tmux_session": session,
        "tmux_window": window,
        "tmux_pane_index": pane_index,
        "opencode_pids": opencode_pids,
        "opencode_cmdline_contains_port": opencode_cmdline_contains_port,
        "related_pids": related_pids,
        "listener_pids": listener_pids,
        "strong_pid_matches": strong_pid_matches,
        "launch_owned_match": launch_owned_match,
        "launch_evidence": {
            "path": rel(visible_launch_path(root), root),
            "present": bool(launch_evidence),
            "launch_owned": bool(launch_evidence.get("launch_owned", False)) if launch_evidence else False,
            "port_was_free_before_launch": bool(launch_evidence.get("port_was_free_before_launch", False)) if launch_evidence else False,
        },
        "binding_confidence": binding_confidence,
        "server_live": bool(probe.get("reachable") and probe.get("global_health_available")),
        "doc_available": bool(probe.get("doc_available")),
        "detected_tui_methods": probe.get("detected_tui_methods", []),
        "missing_tui_endpoints": missing_endpoints,
        "probe": {
            "global_health_available": probe.get("global_health_available", False),
            "doc_available": probe.get("doc_available", False),
            "session_status_available": probe.get("session_status_available", False),
            "global_event_available": probe.get("global_event_available", False),
            "event_available": probe.get("event_available", False),
            "doc_summary": probe.get("doc_summary", {}),
        },
        "socket_evidence": socket_evidence,
        "process_tree": {
            "root_pid": tree.get("root_pid"),
            "nodes": tree.get("nodes", {}),
            "edges": tree.get("edges", []),
        },
        "errors": errors,
        "warnings": warnings,
        "notes": [
            "Only current tmux session/window panes are inspected.",
            "No tmux input is sent.",
            "HTTP verification uses localhost GET only.",
        ],
    }


def revalidate_registration_instance(
    root: Path,
    pane_id: str,
    port: int,
    expected: dict[str, Any],
    *,
    runtime_substrate: str = "",
) -> None:
    """Bounded in-transaction identity revalidation for launch-fenced registration.

    Replaces the full verify_visible_binding probe inside the registry
    transaction: re-checks only the current pane PID and start ticks, port
    listener ownership, boot id, and tmux server identity against the launch
    fence that the outer full verification already established.
    """
    substrate = runtime_substrate or current_runtime_substrate()
    errors: list[str] = []
    _tmux_data, pane = current_window_pane(
        root,
        pane_id,
        runtime_substrate=substrate,
    )
    fresh_pane_pid = int(pane.get("pane_pid") or 0) if pane else 0
    if (
        not pane
        or fresh_pane_pid != int(expected.get("pane_pid") or 0)
        or process_start_time_ticks(fresh_pane_pid)
        != int(expected.get("pane_start_time_ticks") or 0)
    ):
        errors.append("pane identity")
    listener_pids = [
        int(pid)
        for pid in socket_listeners_for_port(port).get("listener_pids", [])
        if str(pid).isdigit()
    ]
    if listener_pids != [int(expected.get("opencode_pid") or 0)]:
        errors.append("listener ownership")
    if host_boot_id() != str(expected.get("host_boot_id") or ""):
        errors.append("host boot id")
    if tmux_server_pid(substrate) != int(expected.get("tmux_server_pid") or 0):
        errors.append("tmux server identity")
    if process_start_time_ticks(int(expected.get("opencode_pid") or 0)) != int(
        expected.get("opencode_start_time_ticks") or 0
    ):
        errors.append("opencode process identity")
    if errors:
        raise AdapterError(
            "target instance changed during launch-fenced registration: "
            + ", ".join(errors)
        )


def record_pid_set(record: dict[str, Any]) -> set[int]:
    values: list[Any] = [
        record.get("pane_pid"),
        record.get("opencode_pid"),
    ]
    for field in ("listener_pids", "opencode_pids", "strong_pid_matches"):
        raw = record.get(field)
        if isinstance(raw, list):
            values.extend(raw)
    result: set[int] = set()
    for value in values:
        try:
            parsed = int(value)
        except (TypeError, ValueError):
            continue
        if parsed > 0:
            result.add(parsed)
    return result


def registration_target_occupancy_conflicts(
    root: Path,
    worker_id: str,
    candidate: dict[str, Any],
    registry: dict[str, Any],
) -> tuple[list[str], bool]:
    """Target/instance occupancy check for registration at the commit boundary.

    Mirrors the rebind quiescence attribution: a lock naming the target worker,
    an unattributable or malformed lock, or a same-boot instance collision with
    another worker's lock blocks registration; attributable unrelated locks are
    allowed, and cross-boot pane/pid/port numbers alone are not a
    current-instance conflict.
    """
    lock_root = framework_root(root) / "visible-runs" / "_locks"
    registry_workers = {
        str(item.get("worker_id") or ""): item
        for item in registry.get("workers", [])
        if isinstance(item, dict) and str(item.get("worker_id") or "")
    }
    conflicts: list[str] = []
    integrity_problem = False
    for path in sorted(lock_root.glob("*.lock.json")):
        if not path.is_file():
            continue
        filename_worker_id = path.name.removesuffix(".lock.json")
        payload = read_json_safe(path)
        payload_worker_id = payload.get("worker_id")
        if filename_worker_id == worker_id or payload_worker_id == worker_id:
            conflicts.append(
                f"{path.name}: target owner lock "
                f"(owner={payload.get('owner') or '-'} "
                f"run={payload.get('run') or '-'} "
                f"task={payload.get('task') or '-'})"
            )
            continue
        if (
            not isinstance(payload_worker_id, str)
            or not payload_worker_id
            or payload_worker_id != filename_worker_id
        ):
            integrity_problem = True
            conflicts.append(f"{path.name}: unattributable owner lock")
            continue
        lock_binding = {
            **registry_workers.get(payload_worker_id, {}),
            **payload,
        }
        lock_boot = str(lock_binding.get("host_boot_id") or "")
        candidate_boot = str(candidate.get("host_boot_id") or "")
        if lock_boot and candidate_boot and lock_boot != candidate_boot:
            continue
        reasons: list[str] = []
        lock_pane = str(lock_binding.get("pane_id") or "")
        candidate_pane = str(candidate.get("pane_id") or "")
        if lock_pane and candidate_pane and lock_pane == candidate_pane:
            reasons.append(f"same pane {candidate_pane}")
        try:
            lock_port = int(lock_binding.get("port") or 0)
        except (TypeError, ValueError):
            lock_port = 0
        try:
            candidate_port = int(candidate.get("port") or 0)
        except (TypeError, ValueError):
            candidate_port = 0
        if lock_port and candidate_port and lock_port == candidate_port:
            reasons.append(f"same port {candidate_port}")
        shared_pids = sorted(
            record_pid_set(lock_binding) & record_pid_set(candidate)
        )
        if shared_pids:
            reasons.append(
                "same binding pid " + ",".join(str(pid) for pid in shared_pids)
            )
        if reasons:
            conflicts.append(
                f"{path.name}: instance conflict ({', '.join(reasons)}; "
                f"owner={payload.get('owner') or '-'} "
                f"run={payload.get('run') or '-'} "
                f"task={payload.get('task') or '-'})"
            )
    return conflicts, integrity_problem


def require_visible_worker(root: Path, worker_id: str) -> dict[str, Any]:
    record = visible_worker_record(root, worker_id)
    if not record:
        raise AdapterError(f"visible worker {worker_id!r} is not registered in {rel(visible_registry_path(root), root)}")
    return record


def _evidence_detail(item: Any) -> dict[str, Any]:
    if hasattr(item, "to_dict"):
        data = item.to_dict()
        return data.get("detail", {}) if isinstance(data, dict) else {}
    if isinstance(item, dict):
        return item.get("detail", {}) if isinstance(item.get("detail"), dict) else {}
    return {}


def _binding_from_rebind_check(root: Path, worker_id: str, backend: str) -> dict[str, Any]:
    result = run_argv(
        [
            str(root / "bin" / "omx_visible_rebind"),
            "check",
            "--root",
            str(root),
            "--worker",
            worker_id,
            "--runtime-backend",
            backend,
            "--json",
        ],
        timeout=45,
    )
    if result.returncode != 0:
        return {}
    try:
        parsed = json.loads(result.stdout or "{}")
    except Exception:
        return {}
    if not isinstance(parsed, dict):
        return {}
    live = parsed.get("live", {}) if isinstance(parsed.get("live"), dict) else {}
    methods = list(live.get("detected_tui_methods", [])) if isinstance(live.get("detected_tui_methods"), list) else []
    checks = live.get("checks", {}) if isinstance(live.get("checks"), dict) else {}
    if str(parsed.get("status") or "") != "current_binding_ok":
        return {}
    if str(live.get("binding_confidence") or parsed.get("binding_confidence") or "") != "strong":
        return {}
    return {
        "worker_id": worker_id,
        "backend": backend,
        "host": "127.0.0.1",
        "port": int(live.get("port") or 0),
        "pane_id": str(live.get("pane_id") or ""),
        "binding_confidence": "strong",
        "server_live": bool(checks.get("required_tui_present") or checks.get("runtime_adapter_verify_ok")),
        "doc_available": bool(methods),
        "detected_tui_methods": methods,
        "errors": [],
        "warnings": [f"fallback_binding_source: rebind-check:{worker_id}"],
    }


def runtime_binding_for_visible_worker(root: Path, worker_id: str, backend: str) -> dict[str, Any]:
    record = require_visible_worker(root, worker_id)
    if backend == "tmux-reference":
        direct = verify_visible_binding(
            root,
            worker_id,
            str(record.get("pane_id", "")),
            str(record.get("host", "127.0.0.1")),
            int(record.get("port")),
            str(record.get("backend", "opencode_tui")),
        )
        if direct.get("binding_confidence") == "strong":
            direct["binding_generation"] = int(record.get("binding_generation") or 0)
            return direct
        if any("current tmux window" in str(item) for item in direct.get("errors", [])):
            rebound = _binding_from_rebind_check(root, worker_id, backend)
            if rebound:
                rebound["binding_generation"] = int(record.get("binding_generation") or 0)
                return rebound
    try:
        adapter = get_backend(backend)
        resolved = adapter.resolve_worker(root, worker_id)
        verify = adapter.verify_binding(root, worker_id)
    except RuntimeAdapterError as exc:
        raise AdapterError(str(exc)) from exc
    binding = verify.binding or resolved.binding
    live_probe = {}
    for item in verify.evidence:
        detail = _evidence_detail(item)
        if detail.get("port") == binding.port and ("health_ok" in detail or "doc_ok" in detail):
            live_probe = detail
            break
    return {
        "worker_id": worker_id,
        "backend": backend,
        "host": binding.host or str(record.get("host", "127.0.0.1")),
        "port": binding.port or int(record.get("port")),
        "pane_id": binding.pane_id or str(record.get("pane_id", "")),
        "binding_generation": int(record.get("binding_generation") or 0),
        "binding_confidence": binding.binding_confidence or "failed",
        "server_live": bool(live_probe.get("health_ok") and live_probe.get("doc_ok")),
        "doc_available": bool(live_probe.get("doc_ok")),
        "detected_tui_methods": list(live_probe.get("detected_tui_methods", [])),
        "errors": list(verify.errors) + list(resolved.errors),
        "warnings": list(verify.warnings) + list(resolved.warnings),
    }


def compact_http_result(record: dict[str, Any], *, include_body_head: bool = False) -> dict[str, Any]:
    data = {
        "ok": bool(record.get("ok")),
        "reachable": bool(record.get("reachable")),
        "status": record.get("status"),
        "content_type": record.get("content_type", ""),
        "bytes_read": record.get("bytes_read", 0),
        "elapsed_seconds": record.get("elapsed_seconds"),
        "timed_out": bool(record.get("timed_out", False)),
        "error": str(record.get("error", ""))[:500],
    }
    if include_body_head:
        data["body_head"] = str(record.get("body_head", ""))[:1000]
    return data


def compact_recovery_http_result(record: dict[str, Any]) -> dict[str, Any]:
    ok = bool(record.get("ok"))
    timed_out = bool(record.get("timed_out", False))
    if ok:
        error_class = ""
    elif timed_out:
        error_class = "timeout"
    elif record.get("reachable") and record.get("status") is not None:
        error_class = "http_error"
    else:
        error_class = "transport_error"
    return {
        "ok": ok,
        "reachable": bool(record.get("reachable")),
        "status": record.get("status"),
        "elapsed_seconds": record.get("elapsed_seconds"),
        "timed_out": timed_out,
        "error_class": error_class,
    }


def classify_session_readiness(status_record: dict[str, Any]) -> dict[str, Any]:
    text = str(status_record.get("body_text", "") or status_record.get("body_head", ""))
    lowered = text.lower()
    parsed: Any = None
    parsed_ok = False
    busy_hits: list[str] = []
    ready_hits: list[str] = []

    try:
        parsed = json.loads(text) if text.strip() else None
        parsed_ok = parsed is not None
    except Exception:
        parsed = None

    busy_keys = {"busy", "running", "working", "streaming", "loading", "processing", "generating", "responding", "in_progress", "inprogress"}
    status_keys = {"status", "state", "readiness", "mode", "type"}
    busy_values = {"busy", "running", "working", "streaming", "loading", "processing", "generating", "responding"}
    ready_values = {"ready", "idle", "waiting", "available"}

    def walk(value: Any, path: str = "$") -> None:
        if isinstance(value, dict):
            for key, item in value.items():
                key_text = str(key).lower()
                item_path = f"{path}.{key_text}"
                if key_text in busy_keys and item is True:
                    busy_hits.append(item_path)
                if key_text in busy_keys and item is False:
                    ready_hits.append(item_path + "=false")
                if key_text in status_keys and isinstance(item, str):
                    item_lower = item.lower()
                    if item_lower in busy_values:
                        busy_hits.append(f"{item_path}={item_lower}")
                    elif item_lower in ready_values:
                        ready_hits.append(f"{item_path}={item_lower}")
                if key_text == "idle" and item is True:
                    ready_hits.append(item_path)
                walk(item, item_path)
        elif isinstance(value, list):
            for index, item in enumerate(value[:20]):
                walk(item, f"{path}[{index}]")

    if parsed_ok:
        walk(parsed)
    else:
        for pattern in (
            r'"(?:busy|running|working|streaming|loading|processing|generating|responding)"\s*:\s*true',
            r'"(?:status|state|readiness)"\s*:\s*"(?:busy|running|working|streaming|loading|processing|generating|responding)"',
        ):
            if re.search(pattern, lowered):
                busy_hits.append(pattern)
        for pattern in (
            r'"(?:busy|running|working|streaming|loading|processing|generating|responding)"\s*:\s*false',
            r'"(?:status|state|readiness)"\s*:\s*"(?:ready|idle|waiting|available)"',
        ):
            if re.search(pattern, lowered):
                ready_hits.append(pattern)

    if busy_hits:
        readiness = "busy"
        reason = "session/status contains busy/running/streaming evidence"
    elif ready_hits:
        readiness = "ready"
        reason = "session/status contains ready/idle evidence and no busy evidence"
    else:
        readiness = "unknown"
        reason = "session/status schema did not expose a clear ready/busy signal"

    return {
        "readiness": readiness,
        "reason": reason,
        "parsed_json": parsed_ok,
        "busy_hits": busy_hits[:20],
        "ready_hits": ready_hits[:20],
        "raw_summary": text[:1000],
    }


def visible_tui_readiness(root: Path, worker_id: str) -> dict[str, Any]:
    safe_slug(worker_id, "worker")
    ensure_state_team_clean(root)
    record = require_visible_worker(root, worker_id)
    host = "127.0.0.1" if str(record.get("host", "127.0.0.1")) == "localhost" else str(record.get("host", "127.0.0.1"))
    if host not in {"127.0.0.1", "localhost"}:
        raise AdapterError(f"visible worker {worker_id!r} has non-localhost host: {host}")
    port = int(record.get("port"))

    health = safe_http_request(host, port, "/global/health", "GET", timeout=1.5, limit=4096, include_body_text=True)
    status = safe_http_request(host, port, "/session/status", "GET", timeout=1.5, limit=8192, include_body_text=True)
    doc = safe_http_request(host, port, "/doc", "GET", timeout=2.0, limit=MAX_DOC_BYTES, include_body_text=True)
    doc_text = str(doc.get("body_text", ""))
    doc_summary = summarize_doc(doc_text)
    session = classify_session_readiness(status) if status.get("ok") else {
        "readiness": "unknown",
        "reason": "GET /session/status did not return 2xx",
        "parsed_json": False,
        "busy_hits": [],
        "ready_hits": [],
        "raw_summary": str(status.get("body_head", ""))[:1000],
    }

    server_live = bool(health.get("ok"))
    doc_ok = bool(doc.get("ok"))
    if not server_live or not doc_ok:
        readiness = "unhealthy"
        reason = "server health or /doc check failed"
    elif session["readiness"] == "busy":
        readiness = "busy"
        reason = session["reason"]
    elif session["readiness"] == "ready":
        readiness = "ready"
        reason = session["reason"]
    else:
        readiness = "unknown"
        reason = session["reason"]

    data = {
        "schema_version": 1,
        "generated_at": utc_now(),
        "root": str(root),
        "worker_id": worker_id,
        "pane_id": record.get("pane_id", ""),
        "host": host,
        "port": port,
        "base_url": f"http://{host}:{port}",
        "server_live": server_live,
        "doc_ok": doc_ok,
        "session_status_ok": bool(status.get("ok")),
        "readiness": readiness,
        "reason": reason,
        "session_status_raw_summary": session["raw_summary"],
        "session_status_summary": {
            "parsed_json": session["parsed_json"],
            "busy_hits": session["busy_hits"],
            "ready_hits": session["ready_hits"],
            "reason": session["reason"],
        },
        "doc_summary": doc_summary,
        "detected_tui_methods": detect_tui_methods(doc_text),
        "checks": {
            "/global/health": compact_http_result(health, include_body_head=True),
            "/session/status": compact_http_result(status, include_body_head=True),
            "/doc": compact_http_result(doc, include_body_head=False),
        },
        "notes": [
            "Only localhost GET requests were used.",
            "readiness=unknown is not treated as ready by the adapter; dispatch may decide whether unknown is warning-only.",
            "No tmux input was sent and no OpenCode prompt mutation endpoint was called.",
        ],
    }
    out_dir = ensure_framework(root) / "tui-readiness"
    write_json(out_dir / "latest.json", data)
    write_json(out_dir / f"{worker_id}.json", data)
    return data


def _visible_worker_local_binding(
    root: Path,
    worker_id: str,
    runtime_backend: str | None = None,
) -> tuple[dict[str, Any], dict[str, Any], str, int]:
    safe_slug(worker_id, "worker")
    ensure_state_team_clean(root)
    record = require_visible_worker(root, worker_id)
    binding = runtime_binding_for_visible_worker(root, worker_id, runtime_backend or default_backend_name())
    if binding.get("binding_confidence") != "strong":
        raise AdapterError(f"visible binding is not strong: {binding.get('binding_confidence')}")
    host, port = verified_visible_transport_endpoint(record, binding)
    return record, binding, host, port


def _json_body(record: dict[str, Any], *, label: str) -> Any:
    text = str(record.get("body_text", "") or record.get("body_head", ""))
    try:
        return json.loads(text)
    except json.JSONDecodeError as exc:
        raise AdapterError(f"{label} did not return valid JSON") from exc


def _try_json_body(record: dict[str, Any]) -> Any:
    text = str(record.get("body_text", "") or record.get("body_head", ""))
    try:
        return json.loads(text)
    except (json.JSONDecodeError, TypeError, ValueError):
        return None


def _sse_event_from_fields(fields: dict[str, Any]) -> dict[str, Any]:
    data_text = "\n".join(str(line) for line in fields.get("data_lines", []))
    event: dict[str, Any] = {
        "event": str(fields.get("event") or "message"),
        "id": str(fields.get("id") or ""),
        "retry": str(fields.get("retry") or ""),
        "data": data_text,
        "data_head": data_text[:4000],
        "data_json_parse_ok": False,
        "data_json_type": "",
    }
    if data_text and len(data_text) <= 64_000:
        try:
            parsed = json.loads(data_text)
        except Exception:
            parsed = None
        if parsed is not None:
            event["data_json_parse_ok"] = True
            event["data_json_type"] = type(parsed).__name__
            if isinstance(parsed, (dict, list)):
                event["data_json"] = parsed
            if isinstance(parsed, dict):
                payload = parsed.get("payload")
                payload_type = ""
                if isinstance(parsed.get("type"), str):
                    payload_type = str(parsed.get("type"))
                elif isinstance(payload, dict) and isinstance(payload.get("type"), str):
                    payload_type = str(payload.get("type"))
                if payload_type:
                    event["data_event_type"] = payload_type
    return event


def parse_sse_lines(lines: list[str], *, max_events: int = 20) -> list[dict[str, Any]]:
    events: list[dict[str, Any]] = []
    current: dict[str, Any] = {"event": "", "id": "", "retry": "", "data_lines": []}

    def flush() -> None:
        nonlocal current
        if current.get("event") or current.get("id") or current.get("retry") or current.get("data_lines"):
            events.append(_sse_event_from_fields(current))
        current = {"event": "", "id": "", "retry": "", "data_lines": []}

    for raw_line in lines:
        if len(events) >= max_events:
            break
        line = raw_line.rstrip("\r\n")
        if line == "":
            flush()
            continue
        if line.startswith(":"):
            continue
        if ":" in line:
            field, value = line.split(":", 1)
            if value.startswith(" "):
                value = value[1:]
        else:
            field, value = line, ""
        if field == "event":
            current["event"] = value
        elif field == "data":
            current.setdefault("data_lines", []).append(value)
        elif field == "id":
            current["id"] = value
        elif field == "retry":
            current["retry"] = value
    if len(events) < max_events:
        flush()
    return events[:max_events]


def safe_sse_event_sample(
    hostname: str,
    port: int,
    path: str,
    *,
    duration_seconds: float = 2.0,
    max_events: int = 20,
    max_bytes: int = 65_536,
) -> dict[str, Any]:
    if hostname not in {"127.0.0.1", "localhost"}:
        raise AdapterError("SSE sampling only allows 127.0.0.1 or localhost")
    if path not in EVENT_ENDPOINTS:
        raise AdapterError(f"SSE endpoint is not whitelisted: {path}")
    if not (1 <= int(port) <= 65535):
        raise AdapterError(f"invalid port: {port}")
    if duration_seconds <= 0 or duration_seconds > 10:
        raise AdapterError("duration_seconds must be > 0 and <= 10")
    if max_events <= 0 or max_events > 200:
        raise AdapterError("max_events must be > 0 and <= 200")
    if max_bytes <= 0 or max_bytes > 1_000_000:
        raise AdapterError("max_bytes must be > 0 and <= 1000000")

    url = f"http://{hostname}:{int(port)}{path}"
    request = Request(
        url,
        method="GET",
        headers={
            "User-Agent": "omx-opencode-tui-adapter/sse-sample",
            "Accept": "text/event-stream",
            "Accept-Encoding": "identity",
            "Cache-Control": "no-cache",
        },
    )
    started = time.time()
    deadline = started + float(duration_seconds)
    lines: list[str] = []
    bytes_read = 0
    timed_out = False
    stream_closed = False
    status: int | None = None
    headers: dict[str, str] = {}
    error = ""

    try:
        with urlopen(request, timeout=min(max(float(duration_seconds), 0.25), 1.0)) as response:
            status = int(getattr(response, "status", 200))
            headers = normalize_header_map(response.headers)
            while time.time() < deadline and bytes_read < max_bytes:
                try:
                    raw_line = response.readline(min(4096, max_bytes - bytes_read))
                except socket.timeout:
                    timed_out = True
                    break
                if not raw_line:
                    stream_closed = True
                    break
                bytes_read += len(raw_line)
                lines.append(raw_line.decode("utf-8", errors="replace"))
                if len(parse_sse_lines(lines, max_events=max_events)) >= max_events:
                    break
    except HTTPError as exc:
        status = int(exc.code)
        headers = normalize_header_map(exc.headers)
        error = str(exc)
    except (URLError, TimeoutError, socket.timeout, ConnectionError, OSError) as exc:
        timed_out = isinstance(exc, (TimeoutError, socket.timeout))
        error = str(exc)

    elapsed = round(time.time() - started, 3)
    events = parse_sse_lines(lines, max_events=max_events)
    return {
        "ok": bool(status is not None and 200 <= int(status) < 300),
        "reachable": bool(status is not None),
        "status": status,
        "url": url,
        "endpoint": path,
        "headers": headers,
        "content_type": header_value(headers, "Content-Type"),
        "bytes_read": bytes_read,
        "line_count": len(lines),
        "event_count": len(events),
        "events": events,
        "event_types": [str(item.get("event") or "") for item in events],
        "payload_event_types": [str(item.get("data_event_type") or "") for item in events if item.get("data_event_type")],
        "timed_out": timed_out,
        "stream_closed": stream_closed,
        "elapsed_seconds": elapsed,
        "error": error,
    }


def session_list_snapshot(root: Path, worker_id: str, *, runtime_backend: str | None = None) -> dict[str, Any]:
    _record, binding, host, port = _visible_worker_local_binding(root, worker_id, runtime_backend)
    response = safe_http_request(host, port, "/session", "GET", timeout=3.0, limit=2_000_000, include_body_text=True)
    if not response.get("ok"):
        raise AdapterError(f"GET /session failed: status={response.get('status')} error={response.get('error', '')}")
    sessions = _json_body(response, label="GET /session")
    if not isinstance(sessions, list):
        raise AdapterError("GET /session JSON was not an array")
    ids = [
        str(item.get("id") or "").strip()
        for item in sessions
        if isinstance(item, dict) and str(item.get("id") or "").strip()
    ]
    return {
        "schema_version": 1,
        "snapshot_kind": "opencode_session_list_snapshot",
        "checked_at": utc_now(),
        "worker_id": worker_id,
        "pane_id": binding.get("pane_id", ""),
        "port": port,
        "base_url": f"http://{host}:{port}",
        "session_count": len(sessions),
        "session_ids": ids,
        "sessions": sessions,
        "response": compact_http_result(response),
        "adapter_writes_visible_run_task": False,
        "adapter_writes_terminal_markers": False,
    }


def session_status_snapshot(root: Path, worker_id: str, *, runtime_backend: str | None = None) -> dict[str, Any]:
    _record, binding, host, port = _visible_worker_local_binding(root, worker_id, runtime_backend)
    response = safe_http_request(host, port, "/session/status", "GET", timeout=3.0, limit=2_000_000, include_body_text=True)
    if not response.get("ok"):
        raise AdapterError(f"GET /session/status failed: status={response.get('status')} error={response.get('error', '')}")
    status_map = _json_body(response, label="GET /session/status")
    if not isinstance(status_map, dict):
        raise AdapterError("GET /session/status JSON was not an object")
    ids = [str(key).strip() for key in status_map.keys() if str(key).strip()]
    return {
        "schema_version": 1,
        "snapshot_kind": "opencode_session_status_snapshot",
        "checked_at": utc_now(),
        "worker_id": worker_id,
        "pane_id": binding.get("pane_id", ""),
        "port": port,
        "base_url": f"http://{host}:{port}",
        "status_count": len(status_map),
        "session_ids": ids,
        "session_status": status_map,
        "response": compact_http_result(response),
        "adapter_writes_visible_run_task": False,
        "adapter_writes_terminal_markers": False,
    }


def session_identity_snapshot(
    root: Path,
    worker_id: str,
    session_id: str,
    *,
    runtime_backend: str | None = None,
) -> dict[str, Any]:
    _record, binding, host, port = _visible_worker_local_binding(
        root,
        worker_id,
        runtime_backend,
    )
    response = safe_http_request(
        host,
        port,
        f"/session/{quote(session_id, safe='')}",
        "GET",
        timeout=3.0,
        limit=2_000_000,
        include_body_text=True,
    )
    snapshot = {
        "schema_version": 1,
        "snapshot_kind": "opencode_session_identity_snapshot",
        "checked_at": utc_now(),
        "worker_id": worker_id,
        "pane_id": binding.get("pane_id", ""),
        "port": port,
        "expected_session_id": session_id,
        "response": compact_http_result(response),
    }
    if int(response.get("status") or 0) == 404:
        return {
            **snapshot,
            "observed_session_id": "",
            "exists": False,
        }
    if not response.get("ok"):
        raise AdapterError(
            "GET /session/{sessionID} failed: "
            f"status={response.get('status')} error={response.get('error', '')}"
        )
    session = _json_body(response, label="GET /session/{sessionID}")
    if not isinstance(session, dict):
        raise AdapterError("GET /session/{sessionID} JSON was not an object")
    observed_session_id = str(session.get("id") or "").strip()
    observed_model = session.get("model") if isinstance(session.get("model"), dict) else {}
    return {
        **snapshot,
        "observed_session_id": observed_session_id,
        "observed_title": str(session.get("title") or ""),
        "observed_directory": str(session.get("directory") or ""),
        "observed_agent": str(session.get("agent") or ""),
        "observed_model": {
            "providerID": str(observed_model.get("providerID") or ""),
            "id": str(observed_model.get("id") or ""),
            "variant": str(observed_model.get("variant") or ""),
        },
        "exists": observed_session_id == session_id,
    }


def _slim_session_identity(identity: dict[str, Any]) -> dict[str, Any]:
    return {
        "exists": bool(identity.get("exists")),
        "observed_session_id": str(identity.get("observed_session_id") or ""),
        "observed_title": str(identity.get("observed_title") or ""),
        "observed_agent": str(identity.get("observed_agent") or ""),
        "observed_model": dict(identity.get("observed_model") or {}),
    }


def _session_title_update_identity_mismatch(
    root: Path,
    tdir: Path,
    *,
    run: str,
    task: str,
    worker_id: str,
    attempt_id: str,
    session_id: str,
    binding_snapshot: dict[str, Any],
) -> str:
    """Return the first trust-boundary mismatch for the pinned identity, or ''.

    Reads the live fence, task owner file, owner lock, and current binding
    snapshot, so calling it twice (before the probes and again immediately
    before the PATCH) proves the task/owner/attempt did not move across the
    network probes rather than only once up front.
    """
    fence = read_json_object(tdir / "acceptance_fence.json")
    session_action = read_json_safe(tdir / "session_action.json")
    owner_path = tdir / "owner"
    owner = read_text(owner_path).strip() if owner_path.is_file() else ""
    lock = read_json_safe(visible_owner_lock_path(root, worker_id))
    lock_run = str(lock.get("run") or "").removeprefix("visible-runs/")
    if str(session_action.get("session_action") or "") != "keep":
        return "session_action_is_not_keep"
    if str(fence.get("run_id") or "").removeprefix("visible-runs/") != run:
        return "acceptance_fence_run_mismatch"
    if str(fence.get("task_id") or "") != task:
        return "acceptance_fence_task_mismatch"
    if str(fence.get("worker_id") or "") != worker_id:
        return "acceptance_fence_worker_mismatch"
    if str(fence.get("attempt_id") or "") != attempt_id:
        return "acceptance_fence_attempt_moved"
    if str(fence.get("session_id") or "") != session_id:
        return "acceptance_fence_session_moved"
    if str(fence.get("session_fence_state") or "") != "live_observed":
        return "acceptance_fence_session_not_live_observed"
    if not PROMPT_ASYNC_SESSION_ID_RE.fullmatch(session_id or ""):
        return "invalid_session_id"
    if not acceptance_fence_matches_binding(fence, binding_snapshot):
        return STALE_ACCEPTANCE_FENCE_ERROR_CODE
    if owner != worker_id:
        return "task_owner_mismatch"
    if (
        str(lock.get("worker_id") or worker_id) != worker_id
        or lock_run != run
        or str(lock.get("task") or "") != task
    ):
        return "owner_lock_mismatch"
    return ""


def session_title_update_real_runtime(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    attempt_id: str,
    session_id: str,
    runtime_backend: str | None = None,
) -> dict[str, Any]:
    """#1010: display-only keep session title refresh through a narrowed entry.

    Called only after this task's own flow signal reconciled its pending keep
    fence, with the exact reconciled attempt/session identity pinned. The
    title derives from the fence itself (never the caller), the session is
    never switched, and the agent/model/variant selection is read back
    unchanged. The identity chain is re-proven immediately before the one
    PATCH. Failures record ``status=failed`` evidence and stay non-blocking
    for the task protocol.
    """
    safe_slug(worker_id, "worker")
    ensure_state_team_clean(root)
    backend_name = runtime_backend or default_backend_name()
    record, binding, host, port = _visible_worker_local_binding(
        root,
        worker_id,
        backend_name,
    )
    binding_snapshot = visible_binding_snapshot(record, binding)
    tdir = visible_task_dir(root, run, task)
    if not is_relative_to(tdir, framework_root(root)):
        raise AdapterError(
            "session title update task must be under .omx/framework/team"
        )
    canonical_run = str(run).removeprefix("visible-runs/")
    mismatch = _session_title_update_identity_mismatch(
        root,
        tdir,
        run=canonical_run,
        task=task,
        worker_id=worker_id,
        attempt_id=attempt_id,
        session_id=session_id,
        binding_snapshot=binding_snapshot,
    )
    if mismatch:
        raise AdapterError(f"session_title_update_refused: {mismatch}")

    title = f"omx:{task}:{attempt_id}"
    base_record = {
        "schema_version": 1,
        "record_kind": "keep_session_title_update",
        "worker_id": worker_id,
        "run_id": canonical_run,
        "task_id": task,
        "attempt_id": attempt_id,
        "session_id": session_id,
        "title": title,
        "pane_id": binding.get("pane_id", ""),
        "port": port,
        "adapter_writes_terminal_markers": False,
        "note": (
            "display-only title refresh; identity authority stays with the "
            "task-attributed acceptance fence, never the title"
        ),
    }
    current_doc = fetch_openapi_doc(root, port)["doc"]
    canonical_session_title_update_operation(current_doc)
    identity_before = session_identity_snapshot(
        root,
        worker_id,
        session_id,
        runtime_backend=backend_name,
    )
    if not identity_before.get("exists"):
        record = {
            **base_record,
            "status": "failed",
            "failed_at": utc_now(),
            "error": "target_session_not_live",
            "identity_before": _slim_session_identity(identity_before),
        }
        write_json(tdir / "session_title_update.json", record)
        return record
    require_visible_side_effect_fence(
        root,
        worker_id,
        binding_snapshot,
        runtime_backend=backend_name,
        operation="session-title-update-real:patch-session-title",
    )
    mismatch = _session_title_update_identity_mismatch(
        root,
        tdir,
        run=canonical_run,
        task=task,
        worker_id=worker_id,
        attempt_id=attempt_id,
        session_id=session_id,
        binding_snapshot=binding_snapshot,
    )
    if mismatch:
        raise AdapterError(
            f"session_title_update_refused_before_patch: {mismatch}"
        )
    patch_response = safe_http_session_title_patch(host, port, session_id, title)
    identity_after = session_identity_snapshot(
        root,
        worker_id,
        session_id,
        runtime_backend=backend_name,
    )
    read_back_ok = bool(
        identity_after.get("exists")
        and str(identity_after.get("observed_title") or "") == title
    )
    selection_preserved = (
        str(identity_after.get("observed_agent") or "")
        == str(identity_before.get("observed_agent") or "")
        and dict(identity_after.get("observed_model") or {})
        == dict(identity_before.get("observed_model") or {})
    )
    updated = bool(patch_response.get("ok") and read_back_ok)
    record = {
        **base_record,
        "status": "updated" if updated else "failed",
        "updated_at" if updated else "failed_at": utc_now(),
        "previous_title": str(identity_before.get("observed_title") or ""),
        "identity_before": _slim_session_identity(identity_before),
        "identity_after": _slim_session_identity(identity_after),
        "patch_response": compact_http_result(
            patch_response,
            include_body_head=True,
        ),
        "read_back_ok": read_back_ok,
        "selection_preserved": selection_preserved,
        "error": "" if updated else "patch_or_read_back_failed",
    }
    write_json(tdir / "session_title_update.json", record)
    return record


def event_stream_sample_snapshot(
    root: Path,
    worker_id: str,
    *,
    endpoint: str,
    duration_seconds: float = 2.0,
    max_events: int = 20,
    max_bytes: int = 65_536,
    runtime_backend: str | None = None,
) -> dict[str, Any]:
    _record, binding, host, port = _visible_worker_local_binding(root, worker_id, runtime_backend)
    sample = safe_sse_event_sample(
        host,
        port,
        endpoint,
        duration_seconds=duration_seconds,
        max_events=max_events,
        max_bytes=max_bytes,
    )
    return {
        "schema_version": 1,
        "snapshot_kind": "opencode_event_stream_sample",
        "checked_at": utc_now(),
        "worker_id": worker_id,
        "pane_id": binding.get("pane_id", ""),
        "port": port,
        "base_url": f"http://{host}:{port}",
        "endpoint": endpoint,
        "duration_seconds": float(duration_seconds),
        "max_events": int(max_events),
        "max_bytes": int(max_bytes),
        "event_count": int(sample.get("event_count", 0)),
        "event_types": sample.get("event_types", []),
        "payload_event_types": sample.get("payload_event_types", []),
        "events": sample.get("events", []),
        "response": compact_http_result(sample),
        "stream_timed_out": bool(sample.get("timed_out")),
        "stream_closed": bool(sample.get("stream_closed")),
        "adapter_writes_visible_run_task": False,
        "adapter_writes_terminal_markers": False,
    }


def session_messages_snapshot(
    root: Path,
    worker_id: str,
    session_id: str,
    *,
    runtime_backend: str | None = None,
) -> dict[str, Any]:
    if not str(session_id or "").startswith("ses"):
        raise AdapterError("session-messages requires an OpenCode session id starting with 'ses'")
    _record, binding, host, port = _visible_worker_local_binding(root, worker_id, runtime_backend)

    def snapshot_payload(
        *,
        ok: bool,
        messages: list[Any],
        capture_scope: str,
        recovery: dict[str, Any],
        response: dict[str, Any],
        errors: list[str],
    ) -> dict[str, Any]:
        return {
            "schema_version": 1,
            "snapshot_kind": "opencode_session_messages_snapshot",
            "checked_at": utc_now(),
            "ok": ok,
            "worker_id": worker_id,
            "pane_id": binding.get("pane_id", ""),
            "port": port,
            "base_url": f"http://{host}:{port}",
            "session_id": session_id,
            "message_count": len(messages),
            "messages": messages,
            "capture_scope": capture_scope,
            "recovery": recovery,
            "response": compact_http_result(response),
            "errors": errors,
            "adapter_writes_visible_run_task": False,
            "adapter_writes_terminal_markers": False,
        }

    def fail_capture(
        *,
        message: str,
        classification: str,
        capture_scope: str,
        recovery: dict[str, Any],
        response: dict[str, Any],
    ) -> None:
        failed_recovery = {
            **recovery,
            "outcome": "failed",
            "failure_classification": classification,
        }
        raise SessionMessagesCaptureError(
            message,
            snapshot_payload(
                ok=False,
                messages=[],
                capture_scope=capture_scope,
                recovery=failed_recovery,
                response=response,
                errors=[classification],
            ),
        )

    def request_messages(
        endpoint: str,
        *,
        retry_truncated: bool,
    ) -> dict[str, Any]:
        response = safe_http_request(
            host,
            port,
            endpoint,
            "GET",
            timeout=3.0,
            limit=2_000_000,
            include_body_text=True,
        )
        if (
            not response.get("ok")
            or not response.get("truncated")
            or not retry_truncated
        ):
            return response
        content_length = response.get("content_length")
        read_failure_recovery = {
            "attempted": False,
            "classification": "initial_truncated",
            "outcome": "pending",
            "failure_classification": "",
            "retry_limit": 0,
            "initial_response": compact_http_result(response),
        }
        # ponytail: bounded snapshot; add API pagination if one response exceeds 16 MB.
        if not isinstance(content_length, int):
            fail_capture(
                message="GET /session/{sessionID}/message has no usable Content-Length",
                classification="full_snapshot_content_length_invalid",
                capture_scope="full",
                recovery=read_failure_recovery,
                response=response,
            )
        if content_length + 1 > 16_000_000:
            fail_capture(
                message="GET /session/{sessionID}/message exceeds the bounded full-snapshot limit",
                classification="full_snapshot_too_large",
                capture_scope="full",
                recovery=read_failure_recovery,
                response=response,
            )
        retry = safe_http_request(
            host,
            port,
            endpoint,
            "GET",
            timeout=3.0,
            limit=content_length + 1,
            include_body_text=True,
        )
        read_failure_recovery["attempted"] = True
        if not retry.get("ok"):
            fail_capture(
                message="GET /session/{sessionID}/message bounded retry failed",
                classification="full_snapshot_retry_http_error",
                capture_scope="full",
                recovery=read_failure_recovery,
                response=retry,
            )
        if retry.get("content_length") != content_length:
            fail_capture(
                message="GET /session/{sessionID}/message Content-Length changed during bounded retry",
                classification="full_snapshot_content_length_changed",
                capture_scope="full",
                recovery=read_failure_recovery,
                response=retry,
            )
        if retry.get("truncated"):
            fail_capture(
                message="GET /session/{sessionID}/message remained truncated after bounded retry",
                classification="full_snapshot_retry_truncated",
                capture_scope="full",
                recovery=read_failure_recovery,
                response=retry,
            )
        if retry.get("bytes_read") != content_length:
            fail_capture(
                message="GET /session/{sessionID}/message bounded retry ended early",
                classification="full_snapshot_retry_early_eof",
                capture_scope="full",
                recovery=read_failure_recovery,
                response=retry,
            )
        return retry

    endpoint = f"/session/{session_id}/message"
    response = request_messages(endpoint, retry_truncated=True)
    messages = _try_json_body(response) if response.get("ok") else None
    recovery = {
        "attempted": False,
        "classification": "not_needed",
        "outcome": "not_needed",
        "failure_classification": "",
        "retry_limit": 0,
        "initial_response": {},
    }
    capture_scope = "full"
    if not response.get("ok") or not isinstance(messages, list):
        if int(response.get("status") or 0) == 404:
            fail_capture(
                message=(
                    "GET /session/{sessionID}/message failed: "
                    f"status={response.get('status')} error={response.get('error', '')}"
                ),
                classification="session_missing",
                capture_scope=capture_scope,
                recovery=recovery,
                response=response,
            )
        if not response.get("ok"):
            classification = (
                compact_recovery_http_result(response).get("error_class")
                or "http_error"
            )
        elif messages is None:
            classification = "invalid_json"
        else:
            classification = "invalid_shape"
        recovery = {
            "attempted": True,
            "classification": f"initial_{classification}",
            "outcome": "pending",
            "failure_classification": "",
            "retry_limit": SESSION_MESSAGES_RECOVERY_LIMIT,
            "initial_response": compact_http_result(response),
        }
        # ponytail: one tail GET only; fail closed if 20 messages are insufficient.
        response = request_messages(
            f"{endpoint}?limit={SESSION_MESSAGES_RECOVERY_LIMIT}",
            retry_truncated=False,
        )
        capture_scope = "bounded_tail"
        if response.get("truncated"):
            fail_capture(
                message="GET /session/{sessionID}/message recovery was truncated",
                classification="recovery_truncated",
                capture_scope=capture_scope,
                recovery=recovery,
                response=response,
            )
        if not response.get("ok"):
            error_class = (
                compact_recovery_http_result(response).get("error_class")
                or "http_error"
            )
            fail_capture(
                message=(
                    "GET /session/{sessionID}/message recovery failed: "
                    f"status={response.get('status')} error={response.get('error', '')}"
                ),
                classification=f"recovery_{error_class}",
                capture_scope=capture_scope,
                recovery=recovery,
                response=response,
            )
        messages = _try_json_body(response)
        if messages is None:
            fail_capture(
                message="GET /session/{sessionID}/message recovery returned invalid JSON",
                classification="recovery_invalid_json",
                capture_scope=capture_scope,
                recovery=recovery,
                response=response,
            )
        if not isinstance(messages, list):
            fail_capture(
                message="GET /session/{sessionID}/message recovery JSON was not an array",
                classification="recovery_invalid_shape",
                capture_scope=capture_scope,
                recovery=recovery,
                response=response,
            )
        recovery["outcome"] = "recovered"

    return snapshot_payload(
        ok=True,
        messages=messages,
        capture_scope=capture_scope,
        recovery=recovery,
        response=response,
        errors=[],
    )


def capabilities_snapshot(
    root: Path,
    worker_id: str,
    *,
    runtime_backend: str | None = None,
) -> dict[str, Any]:
    _record, binding, host, port = _visible_worker_local_binding(root, worker_id, runtime_backend)
    response = safe_http_request(
        host,
        port,
        CAPABILITIES_ENDPOINT,
        "GET",
        timeout=3.0,
        limit=2_000_000,
        include_body_text=True,
    )
    if not response.get("ok"):
        raise AdapterError(
            f"GET /experimental/capabilities failed: status={response.get('status')} error={response.get('error', '')}"
        )
    capabilities = _json_body(response, label="GET /experimental/capabilities")
    if not isinstance(capabilities, dict):
        raise AdapterError("GET /experimental/capabilities JSON was not an object")
    return {
        "schema_version": 1,
        "snapshot_kind": "opencode_capabilities_snapshot",
        "checked_at": utc_now(),
        "worker_id": worker_id,
        "pane_id": binding.get("pane_id", ""),
        "port": port,
        "base_url": f"http://{host}:{port}",
        "capabilities": capabilities,
        "background_subagents": bool(capabilities.get("backgroundSubagents")),
        "response": compact_http_result(response),
        "adapter_writes_visible_run_task": False,
        "adapter_writes_terminal_markers": False,
    }


def command_session_list(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    data = session_list_snapshot(
        root,
        args.worker,
        runtime_backend=getattr(args, "runtime_backend", default_backend_name()),
    )
    if args.json:
        print(json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False))
        return 0
    print("OpenCode session list snapshot")
    print(f"worker: {data['worker_id']}")
    print(f"pane: {data.get('pane_id') or '-'}")
    print(f"port: {data['port']}")
    print(f"session_count: {data['session_count']}")
    print(f"session_ids: {','.join(data['session_ids'])}")
    print(f"session_snapshot_json: {json.dumps(data['sessions'], separators=(',', ':'), ensure_ascii=False)}")
    print(f"checked_at: {data['checked_at']}")
    return 0


