def command_inspect_openapi_candidates(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    data = inspect_openapi_candidates_for_port(root, args.port)
    print(f"openapi_candidates: {rel(framework_root(root) / f'opencode_openapi_candidates_{args.port}.json', root)}")
    print(f"port: {args.port}")
    print(f"any_candidate_has_all_tui_endpoints: {str(data.get('any_candidate_has_all_tui_endpoints', False)).lower()}")
    print(f"any_json_has_all_tui_paths: {str(data.get('any_json_has_all_tui_paths', False)).lower()}")
    for item in data.get("candidates", []):
        if item.get("get", {}).get("status") in {200, 204} or item.get("head", {}).get("status") in {200, 204}:
            print(
                f"  {item.get('path')}: head={item.get('head', {}).get('status')} "
                f"get={item.get('get', {}).get('status')} json={str(item.get('is_json')).lower()} "
                f"tui_paths={item.get('json_summary', {}).get('tui_paths', [])}"
            )
    return 0


