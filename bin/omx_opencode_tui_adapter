def command_session_messages(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    try:
        data = session_messages_snapshot(
            root,
            args.worker,
            args.session_id,
            runtime_backend=getattr(args, "runtime_backend", default_backend_name()),
        )
    except SessionMessagesCaptureError as exc:
        if args.json:
            print(json.dumps(exc.receipt, indent=2, sort_keys=True, ensure_ascii=False))
        else:
            print(
                "session_messages_error_json: "
                + json.dumps(exc.receipt, separators=(",", ":"), ensure_ascii=False)
            )
        return 1
    if args.json:
        print(json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False))
        return 0
    print("OpenCode session messages snapshot")
    print(f"worker: {data['worker_id']}")
    print(f"pane: {data.get('pane_id') or '-'}")
    print(f"port: {data['port']}")
    print(f"session_id: {data['session_id']}")
    print(f"message_count: {data['message_count']}")
    print(f"session_messages_json: {json.dumps(data['messages'], separators=(',', ':'), ensure_ascii=False)}")
    print(f"checked_at: {data['checked_at']}")
    return 0


