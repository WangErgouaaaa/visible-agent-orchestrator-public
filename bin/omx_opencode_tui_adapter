def command_mock_demo(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    run = "opencode-adapter-demo"
    tasks = [
        ("task-001", "w1", 4101, "OpenCode TUI adapter completed demo", "Simulated completed task."),
        ("task-002", "w2", 4101, "OpenCode TUI adapter blocked demo", "Simulated blocked task."),
        ("task-003", "w3", 4101, "OpenCode TUI adapter uncertain delivery demo", "Simulated submitted-only task."),
    ]
    statuses: list[dict[str, str]] = []
    for task, worker, port, title, body in tasks:
        tdir = prepare_task(root, run, task, worker, port, title, body)
        reset_known_markers(tdir)
        write_marker(tdir / ".submitted")
        if task == "task-001":
            write_marker(tdir / ".received")
            write_marker(tdir / ".started")
            write_marker(tdir / ".heartbeat")
            (tdir / "report.md").write_text("Simulated OpenCode adapter task completed.\n", encoding="utf-8")
            write_marker(tdir / ".done")
            statuses.append({"task": task, "status": "completed"})
        elif task == "task-002":
            write_marker(tdir / ".received")
            write_marker(tdir / ".started")
            write_marker(tdir / ".heartbeat")
            (tdir / "report.md").write_text("Simulated OpenCode adapter task blocked.\n", encoding="utf-8")
            write_marker(tdir / ".blocked")
            statuses.append({"task": task, "status": "blocked"})
        else:
            statuses.append({"task": task, "status": "delivery_uncertain"})

    results = {
        "schema_version": 1,
        "generated_at": utc_now(),
        "run": run,
        "path": rel(framework_root(root) / run, root),
        "tasks": statuses,
    }
    write_json(framework_root(root) / run / "mock-demo-results.json", results)
    print(json.dumps(results, indent=2, ensure_ascii=False))
    return 0


def command_socket_discover(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    capabilities_path = framework_root(root) / "opencode_tui_capabilities.json"
    capabilities = read_json_safe(capabilities_path)
    if not capabilities:
        capabilities = collect_cli_capabilities(root)
    data = perform_socket_discovery(root, capabilities=capabilities, write=True)
    print(f"socket_discovery: {rel(framework_root(root) / 'opencode_socket_discovery.json', root)}")
    print(f"opencode_panes: {len(data.get('opencode_panes', []))}")
    print(f"opencode_pids: {data.get('opencode_pids', [])}")
    print(f"args_ports: {data.get('args_ports', [])}")
    print(f"socket_ports: {data.get('socket_ports', [])}")
    print(f"candidate_ports: {data.get('candidate_ports', [])}")
    reachable = [item for item in data.get("probe_results", {}).get("servers", []) if item.get("reachable")]
    print(f"reachable_servers: {len(reachable)}")
    if data.get("warnings"):
        print("Warnings:")
        for warning in data.get("warnings", []):
            print(f"  - {warning}")
    if data.get("errors"):
        print("Errors:")
        for error in data.get("errors", []):
            print(f"  - {error}")
    return 0


def merge_probe_result(root: Path, probe: dict[str, Any]) -> dict[str, Any]:
    fw = ensure_framework(root)
    path = fw / "opencode_servers.json"
    data = read_json_safe(path)
    if not data:
        data = {
            "schema_version": 1,
            "generated_at": utc_now(),
            "candidate_ports": [],
            "servers": [],
            "notes": [
                "Only localhost GET probes were used.",
                "No POST, PUT, PATCH, or DELETE requests were sent.",
            ],
        }
    servers = [item for item in data.get("servers", []) if item.get("port") != probe.get("port")]
    servers.append(probe)
    servers.sort(key=lambda item: int(item.get("port", 0)))
    candidates = [
        port
        for port in unique_ints([int(port) for port in data.get("candidate_ports", []) if str(port).isdigit()] + [int(probe["port"])])
        if 1 <= port <= 65535
    ]
    data["generated_at"] = utc_now()
    data["candidate_ports"] = candidates
    data["servers"] = servers
    write_json(path, data)
    return data


def command_probe_server(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    probe = probe_port(args.port, hostname=args.host)
    merge_probe_result(root, probe)
    print(json.dumps({
        "port": probe.get("port"),
        "base_url": probe.get("base_url"),
        "reachable": probe.get("reachable"),
        "global_health_available": probe.get("global_health_available"),
        "doc_available": probe.get("doc_available"),
        "session_status_available": probe.get("session_status_available"),
        "global_event_available": probe.get("global_event_available"),
        "event_available": probe.get("event_available"),
        "detected_tui_methods": probe.get("detected_tui_methods", []),
        "doc_summary": probe.get("doc_summary", {}),
        "errors": probe.get("errors", {}),
    }, indent=2, ensure_ascii=False))
    return 0


def command_launch_plan(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    if args.workers < 1:
        raise AdapterError("--workers must be >= 1")
    if not (1 <= args.base_port <= 65535):
        raise AdapterError("--base-port must be a valid TCP port")
    if args.base_port + args.workers - 1 > 65535:
        raise AdapterError("worker port range exceeds 65535")

    fw = ensure_framework(root)
    workers: list[dict[str, Any]] = []
    lines = [
        "# OpenCode Fixed-Port Worker Launch Plan",
        "",
        f"Generated at: `{utc_now()}`",
        f"Workspace: `{root}`",
        "",
        "This is a launch plan only. It does not start OpenCode, create tmux panes, replace existing panes, or submit prompts.",
        "",
        "## Recommended Commands",
        "",
    ]
    for index in range(args.workers):
        worker_id = f"w{index + 1}"
        port = args.base_port + index
        command = shlex.join(
            ["opencode", str(root), "--hostname", "127.0.0.1", "--port", str(port)]
        )
        workers.append({
            "worker": worker_id,
            "backend": "opencode_tui",
            "hostname": "127.0.0.1",
            "port": port,
            "base_url": f"http://127.0.0.1:{port}",
            "command": command,
        })
        lines.extend([
            f"- worker `{worker_id}`:",
            "",
            "```bash",
            command,
            "```",
            "",
        ])

    lines.extend([
        "## Constraints",
        "",
        "- These commands must be started by the user or by a later explicitly authorized team-start wrapper in new panes.",
        "- Do not replace, interrupt, or kill the existing `%31` OpenCode pane.",
        "- Later adapter submit must verify `http://127.0.0.1:<port>/doc` before sending anything.",
        "- Later real submit, if authorized, will call `clear-prompt`, `append-prompt`, then `submit-prompt` through the server API.",
        "- Worker completion still requires non-empty `report.md` plus exactly one `.done`, `.fail`, or `.blocked` marker.",
        "- `submitted` is not `received`; without `.received`, status remains `delivery_uncertain`.",
        "",
    ])

    plan = {
        "schema_version": 1,
        "generated_at": utc_now(),
        "root": str(root),
        "workers": workers,
        "constraints": [
            "plan-only; no process is started",
            "no tmux command is executed",
            "do not replace or kill existing %31 pane",
            "future submit-real must verify /doc first and require explicit authorization",
        ],
    }
    write_json(fw / "opencode_worker_launch_plan.json", plan)
    (fw / "OPENCODE_WORKER_LAUNCH_PLAN.md").write_text("\n".join(lines), encoding="utf-8")
    print(f"launch_plan_md: {rel(fw / 'OPENCODE_WORKER_LAUNCH_PLAN.md', root)}")
    print(f"launch_plan_json: {rel(fw / 'opencode_worker_launch_plan.json', root)}")
    for worker in workers:
        print(f"{worker['worker']}: {worker['command']}")
    return 0


