class AdapterError(Exception):
    """Expected operator-facing failure."""


class SessionMessagesCaptureError(AdapterError):
    def __init__(self, message: str, receipt: dict[str, Any]):
        super().__init__(message)
        self.receipt = receipt


@dataclass
class CommandResult:
    argv: list[str]
    returncode: int
    stdout: str
    stderr: str
    timed_out: bool = False


def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def root_path(root_arg: str | None) -> Path:
    return runtime_root(root_arg)


def team_root(root: Path) -> Path:
    return root / ".omx" / "state" / "team"


def framework_root(root: Path) -> Path:
    return root / ".omx" / "framework" / "team"


def ensure_framework(root: Path) -> Path:
    path = framework_root(root)
    path.mkdir(parents=True, exist_ok=True)
    return path


@contextmanager
def launch_serialization_lock(
    root: Path,
    *,
    shared: bool = False,
) -> Iterator[None]:
    path = ensure_framework(root) / ".opencode-launch.lock"
    with path.open("a+", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_SH if shared else fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def rel(path: Path, root: Path) -> str:
    try:
        return str(path.resolve().relative_to(root.resolve()))
    except Exception:
        return str(path)


def is_relative_to(path: Path, base: Path) -> bool:
    try:
        path.resolve().relative_to(base.resolve())
        return True
    except ValueError:
        return False


def safe_slug(value: str, label: str) -> str:
    if not value:
        raise AdapterError(f"{label} is required")
    if value in {".", ".."} or "/" in value or "\\" in value or "\x00" in value:
        raise AdapterError(f"{label} must be a simple id, got: {value!r}")
    return value


def safe_framework_run_parts(value: str, label: str = "run") -> tuple[str, ...]:
    """Validate a framework-relative run id such as 'visible-runs/run-001'."""
    if not value:
        raise AdapterError(f"{label} is required")
    if "\\" in value or "\x00" in value:
        raise AdapterError(f"{label} must be a framework-relative path without backslashes")
    posix = PurePosixPath(value)
    if posix.is_absolute():
        raise AdapterError(f"{label} must not be an absolute path: {value!r}")
    parts = tuple(part for part in posix.parts if part not in {"", "."})
    if not parts or any(part == ".." for part in parts):
        raise AdapterError(f"{label} must not contain path traversal: {value!r}")
    for part in parts:
        safe_slug(part, f"{label} component")
    return parts


def framework_run_dir(root: Path, run: str) -> Path:
    parts = safe_framework_run_parts(run, "run")
    path = framework_root(root).joinpath(*parts)
    if not is_relative_to(path, framework_root(root)):
        raise AdapterError("run path escaped .omx/framework/team")
    return path


def write_json(path: Path, data: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False) + "\n", encoding="utf-8")


def write_json_atomic(path: Path, data: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(
        f".{path.name}.{os.getpid()}.{time.time_ns()}.tmp"
    )
    try:
        temporary.write_text(
            json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False) + "\n",
            encoding="utf-8",
        )
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()


def read_json_safe(path: Path) -> dict[str, Any]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def update_current_acceptance_fence_records(
    fence_path: Path,
    updated_fence: dict[str, Any],
) -> None:
    for name in ("task.json", "dispatch.json"):
        path = fence_path.parent / name
        payload = read_json_object(path)
        if not payload:
            continue
        if isinstance(payload.get("acceptance_fence"), dict):
            payload["acceptance_fence"] = dict(updated_fence)
        for field in (
            "worker_id",
            "session_id",
            "instance_id",
            "binding_generation",
            "fencing_generation",
        ):
            if field in payload:
                payload[field] = updated_fence.get(field)
        write_json_atomic(path, payload)
    write_json_atomic(fence_path, updated_fence)


def read_text(path: Path) -> str:
    return path.read_bytes().decode("utf-8", errors="replace")


def write_marker(path: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("", encoding="utf-8")


def reserve_session_creation(path: Path, record: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = (
        json.dumps(record, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
    ).encode("utf-8")
    try:
        descriptor = os.open(
            path,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL,
            0o600,
        )
    except FileExistsError as exc:
        raise AdapterError(
            "session creation was already reserved; automatic retry is forbidden"
        ) from exc
    try:
        written = 0
        while written < len(payload):
            count = os.write(descriptor, payload[written:])
            if count <= 0:
                raise AdapterError("session creation reservation write failed")
            written += count
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    parent_descriptor = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(parent_descriptor)
    finally:
        os.close(parent_descriptor)


def run_argv(argv: list[str], timeout: int = 12) -> CommandResult:
    try:
        proc = subprocess.run(
            argv,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
        return CommandResult(argv=argv, returncode=proc.returncode, stdout=proc.stdout, stderr=proc.stderr)
    except subprocess.TimeoutExpired as exc:
        return CommandResult(
            argv=argv,
            returncode=124,
            stdout=exc.stdout or "",
            stderr=exc.stderr or "command timed out",
            timed_out=True,
        )
    except FileNotFoundError as exc:
        return CommandResult(argv=argv, returncode=127, stdout="", stderr=str(exc))


def run_shell(command: str, timeout: int = 10) -> CommandResult:
    return run_argv(["bash", "-lc", command], timeout=timeout)


def command_record(command: str, argv: list[str], timeout: int = 12) -> dict[str, Any]:
    result = run_argv(argv, timeout=timeout)
    text = (result.stdout or "") + ("\n" + result.stderr if result.stderr else "")
    return {
        "command": command,
        "argv": argv,
        "available": result.returncode == 0,
        "returncode": result.returncode,
        "timed_out": result.timed_out,
        "stdout_head": (result.stdout or "")[:4000],
        "stderr_head": (result.stderr or "")[:2000],
        "supports_hostname": "--hostname" in text,
        "supports_port": "--port" in text,
        "supports_format_json": bool(re.search(r"--format[\s\S]{0,240}\bjson\b", text)),
        "mentions_json": "json" in text.lower(),
    }


def parse_ports_from_text(text: str) -> list[int]:
    ports: list[int] = []
    for match in re.finditer(r"(?:localhost|127\.0\.0\.1):(\d{2,5})", text):
        port = int(match.group(1))
        if 1 <= port <= 65535 and port not in ports:
            ports.append(port)
    for match in re.finditer(r"(?:--port(?:=|\s+)|port\s+)(\d{2,5})", text):
        port = int(match.group(1))
        if 1 <= port <= 65535 and port not in ports:
            ports.append(port)
    return ports


def parse_hostnames_from_text(text: str) -> list[str]:
    hosts: list[str] = []
    for match in re.finditer(r"--hostname(?:=|\s+)([^\s]+)", text):
        host = match.group(1).strip("'\"")
        if host and host not in hosts:
            hosts.append(host)
    for match in re.finditer(r"https?://([^:/\s]+):\d{2,5}", text):
        host = match.group(1)
        if host and host not in hosts:
            hosts.append(host)
    return hosts


def unique_ints(values: list[int] | tuple[int, ...]) -> list[int]:
    result: list[int] = []
    for value in values:
        try:
            item = int(value)
        except Exception:
            continue
        if item not in result:
            result.append(item)
    return result


def collect_cli_capabilities(root: Path) -> dict[str, Any]:
    opencode_path = shutil.which("opencode")
    commands: dict[str, dict[str, Any]] = {}
    probes = {
        "opencode --help": ["opencode", "--help"],
        "opencode --version": ["opencode", "--version"],
        "opencode tui --help": ["opencode", "tui", "--help"],
        "opencode serve --help": ["opencode", "serve", "--help"],
        "opencode web --help": ["opencode", "web", "--help"],
        "opencode attach --help": ["opencode", "attach", "--help"],
        "opencode run --help": ["opencode", "run", "--help"],
    }
    if opencode_path:
        for name, argv in probes.items():
            commands[name] = command_record(name, argv)
    else:
        for name, argv in probes.items():
            commands[name] = {
                "command": name,
                "argv": argv,
                "available": False,
                "returncode": 127,
                "timed_out": False,
                "stdout_head": "",
                "stderr_head": "opencode not found",
                "supports_hostname": False,
                "supports_port": False,
                "supports_format_json": False,
                "mentions_json": False,
            }

    combined = "\n".join((item.get("stdout_head", "") + "\n" + item.get("stderr_head", "")) for item in commands.values())
    version = (commands.get("opencode --version", {}).get("stdout_head") or "").strip().splitlines()
    features = {
        "supports_hostname": any(item.get("supports_hostname") for item in commands.values()),
        "supports_port": any(item.get("supports_port") for item in commands.values()),
        "supports_attach": "opencode attach" in combined or commands.get("opencode attach --help", {}).get("available", False),
        "supports_serve": "opencode serve" in combined or commands.get("opencode serve --help", {}).get("available", False),
        "supports_web": "opencode web" in combined or commands.get("opencode web --help", {}).get("available", False),
        "supports_run": "opencode run" in combined or commands.get("opencode run --help", {}).get("available", False),
        "supports_format_json": any(item.get("supports_format_json") for item in commands.values()),
        "mentions_json": any(item.get("mentions_json") for item in commands.values()),
        "can_fix_tui_server_address": bool(
            commands.get("opencode --help", {}).get("supports_hostname")
            and commands.get("opencode --help", {}).get("supports_port")
        ),
    }

    return {
        "schema_version": 1,
        "generated_at": utc_now(),
        "root": str(root),
        "opencode": {
            "available": bool(opencode_path),
            "path": opencode_path or "",
            "version": version[0] if version else "",
        },
        "commands": commands,
        "features": features,
        "candidate_ports_from_help": parse_ports_from_text(combined),
        "notes": [
            "Only help/version commands were executed.",
            "No OpenCode TUI/server was started and no prompt submission endpoint was called.",
        ],
    }


def render_capabilities_md(data: dict[str, Any], servers: dict[str, Any] | None = None) -> str:
    opencode = data.get("opencode", {})
    features = data.get("features", {})
    lines = [
        "# OpenCode TUI Adapter Capabilities",
        "",
        f"Generated at: `{data.get('generated_at', '')}`",
        f"Workspace: `{data.get('root', '')}`",
        "",
        "## CLI",
        "",
        f"- available: `{str(opencode.get('available', False)).lower()}`",
        f"- path: `{opencode.get('path', '')}`",
        f"- version: `{opencode.get('version', '')}`",
        "",
        "## Help-Derived Features",
        "",
    ]
    for key in [
        "supports_hostname",
        "supports_port",
        "supports_attach",
        "supports_serve",
        "supports_web",
        "supports_run",
        "supports_format_json",
        "mentions_json",
        "can_fix_tui_server_address",
    ]:
        lines.append(f"- {key}: `{str(features.get(key, False)).lower()}`")

    lines.extend(["", "## Command Help Probes", ""])
    for name, probe in data.get("commands", {}).items():
        lines.append(f"- `{name}`: returncode `{probe.get('returncode')}`, available `{str(probe.get('available', False)).lower()}`")

    if servers:
        server_rows = servers.get("servers", [])
        lines.extend(["", "## Local Server Probe", ""])
        lines.append(f"- candidates: `{servers.get('candidate_ports', [])}`")
        lines.append(f"- reachable_servers: `{len([item for item in server_rows if item.get('reachable')])}`")
        for item in server_rows:
            if not item.get("reachable"):
                continue
            lines.append(
                f"- port `{item.get('port')}`: /doc `{str(item.get('doc_available')).lower()}`, "
                f"/global/health `{str(item.get('global_health_available')).lower()}`, "
                f"/session/status `{str(item.get('session_status_available')).lower()}`, "
                f"/global/event `{str(item.get('global_event_available')).lower()}`, "
                f"/event `{str(item.get('event_available')).lower()}`, "
                f"tui_methods `{item.get('detected_tui_methods', [])}`"
            )

    lines.extend([
        "",
        "## Boundaries",
        "",
        "- This file is generated from help/version, read-only socket discovery, and localhost GET/HEAD/OPTIONS probes only.",
        "- The adapter never calls `/tui/append-prompt`, `/tui/submit-prompt`, `/tui/clear-prompt`, or any other mutating endpoint in discovery/evidence phases.",
        "- The adapter never sends tmux input.",
    ])
    return "\n".join(lines) + "\n"


def current_runtime_substrate() -> str:
    if os.environ.get("RMUX") or str(os.environ.get("TERM_PROGRAM", "")).lower() == "rmux":
        return "rmux"
    if os.environ.get("TMUX"):
        return "tmux"
    return ""


def is_in_tmux() -> bool:
    return current_runtime_substrate() == "tmux"


def parse_tmux_panes(output: str) -> list[dict[str, Any]]:
    panes: list[dict[str, Any]] = []
    for line in output.splitlines():
        if not line.strip():
            continue
        parts = line.split("\t", 6)
        if len(parts) == 7:
            pane_ref, pane_id, command, title, active, pane_pid, current_path = parts
        else:
            parts = line.split()
        if len(parts) >= 7 and "\t" not in line:
            pane_ref = parts[0]
            pane_id = parts[1]
            command = parts[2]
            active = parts[-3]
            pane_pid = parts[-2]
            current_path = parts[-1]
            title = " ".join(parts[3:-3])
        else:
            padded = parts + [""] * (7 - len(parts))
            pane_ref, pane_id, command, title, active, pane_pid, current_path = padded[:7]
        panes.append({
            "pane_ref": pane_ref,
            "pane_id": pane_id,
            "pane_current_command": command,
            "pane_title": title,
            "pane_active": active == "1",
            "pane_pid": int(pane_pid) if pane_pid.isdigit() else None,
            "pane_current_path": current_path,
            "raw": line,
        })
    return panes


def process_info(pid: int | None) -> dict[str, Any]:
    if not pid:
        return {"pid": None, "ps": "", "children": [], "tree": []}

    nodes = recursive_process_tree(pid)["nodes"]
    record = nodes.get(str(pid), {})
    tree = [{"pid": node["pid"], "args": node["cmdline"]} for node in nodes.values() if node["pid"] != pid]
    return {"pid": pid, "ps": record.get("ps", ""), "cmdline": record.get("cmdline", ""),
            "children": [f"{node['pid']} {node['args']}" for node in tree], "tree": tree}


def read_process_environment(pid: int) -> dict[str, str]:
    try:
        raw = (Path("/proc") / str(int(pid)) / "environ").read_bytes()
    except (OSError, TypeError, ValueError):
        return {}
    environment: dict[str, str] = {}
    for item in raw.split(b"\0"):
        if b"=" not in item:
            continue
        key, value = item.split(b"=", 1)
        environment[key.decode(errors="replace")] = value.decode(
            errors="replace"
        )
    return environment


def process_start_time_ticks(pid: int) -> int:
    try:
        text = (Path("/proc") / str(int(pid)) / "stat").read_text(
            encoding="utf-8",
            errors="replace",
        )
    except (OSError, TypeError, ValueError):
        return 0
    close = text.rfind(")")
    if close < 0:
        return 0
    fields = text[close + 1 :].strip().split()
    try:
        return int(fields[19])
    except (IndexError, TypeError, ValueError):
        return 0


def host_boot_id() -> str:
    try:
        return Path("/proc/sys/kernel/random/boot_id").read_text(
            encoding="utf-8",
            errors="replace",
        ).strip()
    except OSError:
        return ""


def tmux_server_pid(runtime_substrate: str = "") -> int:
    substrate = runtime_substrate or current_runtime_substrate()
    if substrate != "tmux":
        return 0
    result = run_argv(["tmux", "display-message", "-p", "#{pid}"])
    try:
        return int(result.stdout.strip()) if result.returncode == 0 else 0
    except ValueError:
        return 0


def recursive_process_tree(root_pid: int, max_depth: int = 5) -> dict[str, Any]:
    return proc_tree(root_pid, max_depth)


def looks_like_opencode_pane(pane: dict[str, Any], proc: dict[str, Any]) -> bool:
    command = str(pane.get("pane_current_command", "")).lower()
    title = str(pane.get("pane_title", "")).lower()
    if command == "opencode":
        return True
    if "opencode" in title and "bash:" not in title and "omx_opencode_tui_adapter" not in title:
        return True

    process_text = "\n".join([
        str(proc.get("ps", "")),
        "\n".join(str(line) for line in proc.get("children", [])),
    ])
    if "omx_opencode_tui_adapter" in process_text and "prefix/bin/opencode" not in process_text:
        return False
    return bool(re.search(r"(?:^|\s|/)opencode(?:\s|$)", process_text, flags=re.IGNORECASE | re.MULTILINE))


def discover_tmux_opencode(
    *,
    pane_target: str = "",
    runtime_substrate: str = "",
) -> dict[str, Any]:
    substrate = runtime_substrate or current_runtime_substrate()
    if substrate not in {"", "tmux", "rmux"}:
        raise AdapterError(
            f"unsupported runtime substrate: {substrate}"
        )
    data: dict[str, Any] = {
        "in_tmux": substrate == "tmux",
        "in_rmux": substrate == "rmux",
        "runtime_substrate": substrate,
        "display": "",
        "panes": [],
        "opencode_panes": [],
        "notes": ["Only current tmux/rmux session/window list-panes and display-message are used."],
    }
    if not substrate:
        data["notes"].append("Not running inside tmux/rmux.")
        return data

    mux = substrate
    target_args: list[str] = []
    target = ""
    if substrate == "tmux":
        target = pane_target or str(os.environ.get("TMUX_PANE") or "")
        if not re.fullmatch(r"%[0-9]+", target):
            raise AdapterError(
                "TMUX_PANE must identify the caller pane for scoped tmux discovery"
            )
        target_args = ["-t", target]
    display = run_argv(
        [mux, "display-message", *target_args, "-p", "#S:#I.#P #{pane_id}"]
    )
    pane_list = run_argv([
        mux,
        "list-panes",
        *target_args,
        "-F",
        "#{session_name}:#{window_index}.#{pane_index}\t#{pane_id}\t#{pane_current_command}\t#{pane_title}\t#{pane_active}\t#{pane_pid}\t#{pane_current_path}",
    ])
    if substrate == "tmux":
        if display.timed_out or display.returncode != 0:
            detail = display.stderr.strip() or "no pane evidence returned"
            raise AdapterError(
                f"tmux display-message failed for caller pane {target}: {detail}"
            )
        if pane_list.timed_out or pane_list.returncode != 0:
            detail = pane_list.stderr.strip() or "no pane evidence returned"
            raise AdapterError(
                f"tmux list-panes failed for caller pane {target}: {detail}"
            )
    data["display"] = display.stdout.strip()
    panes = parse_tmux_panes(pane_list.stdout)
    if substrate == "tmux":
        display_lines = [
            line.strip()
            for line in display.stdout.splitlines()
            if line.strip()
        ]
        displayed_pane = (
            display_lines[0].rsplit(maxsplit=1)[-1]
            if len(display_lines) == 1
            else ""
        )
        exact_panes = [
            pane
            for pane in panes
            if str(pane.get("pane_id") or "") == target
        ]
        if displayed_pane != target or not exact_panes:
            raise AdapterError(
                f"tmux discovery could not prove exact caller pane {target}"
            )
    for pane in panes:
        proc = process_info(pane.get("pane_pid"))
        pane["process"] = proc
        pane["suspected_opencode"] = looks_like_opencode_pane(pane, proc)
    data["panes"] = panes
    data["opencode_panes"] = [pane for pane in panes if pane.get("suspected_opencode")]
    return data


def candidate_ports(
    capabilities: dict[str, Any] | None,
    tmux_data: dict[str, Any] | None,
    socket_data: dict[str, Any] | None = None,
) -> list[int]:
    ports: list[int] = []

    def add(items: list[int]) -> None:
        for port in items:
            if 1 <= int(port) <= 65535 and int(port) not in ports:
                ports.append(int(port))

    if capabilities:
        add([int(port) for port in capabilities.get("candidate_ports_from_help", []) if str(port).isdigit()])
        combined = json.dumps(capabilities, ensure_ascii=False)
        add(parse_ports_from_text(combined))

    for key, value in sorted(os.environ.items()):
        if "OPENCODE" in key.upper():
            add(parse_ports_from_text(value))

    if tmux_data:
        add(parse_ports_from_text(json.dumps(tmux_data, ensure_ascii=False)))

    if socket_data:
        add([int(port) for port in socket_data.get("args_ports", []) if str(port).isdigit()])
        add([int(port) for port in socket_data.get("socket_ports", []) if str(port).isdigit()])
        add([int(port) for port in socket_data.get("candidate_ports", []) if str(port).isdigit()])

    add(list(COMMON_PORTS))
    return ports[:MAX_CANDIDATE_PORTS]


def process_tree_text(tree: dict[str, Any]) -> str:
    chunks: list[str] = []
    for node in tree.get("nodes", {}).values():
        chunks.append(str(node.get("ps", "")))
        chunks.append(str(node.get("cmdline", "")))
    return "\n".join(chunks)


def find_opencode_pids(tree: dict[str, Any]) -> list[int]:
    pids: list[int] = []
    for key, node in tree.get("nodes", {}).items():
        text = f"{node.get('ps', '')}\n{node.get('cmdline', '')}".lower()
        if re.search(r"(?:^|\s|/)opencode(?:\s|$)", text):
            try:
                pids.append(int(key))
            except Exception:
                continue
    return unique_ints(pids)


def run_socket_command(argv: list[str], name: str) -> dict[str, Any]:
    if not shutil.which(argv[0]):
        return {
            "name": name,
            "argv": argv,
            "available": False,
            "returncode": 127,
            "stdout": "",
            "stderr": f"{argv[0]} not found",
        }
    result = run_argv(argv, timeout=8)
    return {
        "name": name,
        "argv": argv,
        "available": result.returncode == 0,
        "returncode": result.returncode,
        "stdout": result.stdout,
        "stderr": result.stderr,
        "timed_out": result.timed_out,
    }


def socket_command_outputs() -> dict[str, dict[str, Any]]:
    return {
        "ss": run_socket_command(["ss", "-H", "-ltnp"], "ss -H -ltnp"),
        "lsof": run_socket_command(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN"], "lsof -nP -iTCP -sTCP:LISTEN"),
        "netstat": run_socket_command(["netstat", "-ltnp"], "netstat -ltnp"),
    }


def pids_from_socket_line(line: str) -> list[int]:
    pids: list[int] = []
    for match in re.finditer(r"pid=(\d+)", line):
        pids.append(int(match.group(1)))
    for match in re.finditer(r"\b(\d+)/[^\s]+", line):
        pids.append(int(match.group(1)))
    parts = line.split()
    if (
        len(parts) > 1
        and parts[1].isdigit()
        and parts[0].lower() not in {"proto", "listen", "tcp", "tcp6", "udp", "udp6"}
    ):
        pids.append(int(parts[1]))
    return unique_ints(pids)


def ports_from_socket_line(line: str) -> list[int]:
    ports: list[int] = []
    patterns = [
        r"(?:127\.0\.0\.1|0\.0\.0\.0|\*|localhost):(\d{2,5})",
        r"\[(?:::1|::)\]:(\d{2,5})",
        r":(\d{2,5})\s+\(LISTEN\)",
        r":(\d{2,5})\s+\S+\s+users:",
    ]
    for pattern in patterns:
        for match in re.finditer(pattern, line):
            ports.append(int(match.group(1)))
    return unique_ints(ports)


def discover_socket_ports(related_pids: list[int]) -> tuple[list[int], dict[str, Any], list[str], list[str]]:
    ports: list[int] = []
    evidence: dict[str, Any] = {"commands": {}, "matches": []}
    errors: list[str] = []
    warnings: list[str] = []
    pid_set = set(related_pids)

    outputs = socket_command_outputs()
    for key, record in outputs.items():
        safe_record = dict(record)
        stdout = str(safe_record.pop("stdout", ""))
        safe_record["stdout_line_count"] = len(stdout.splitlines())
        safe_record["stdout_head"] = ""
        evidence["commands"][key] = safe_record
        if not record.get("available"):
            if record.get("returncode") == 127:
                warnings.append(f"{record.get('name')} unavailable")
            else:
                errors.append(f"{record.get('name')} returned {record.get('returncode')}: {str(record.get('stderr', '')).strip()[:200]}")
            continue
        for line in stdout.splitlines():
            line_pids = pids_from_socket_line(line)
            if not line_pids or not pid_set.intersection(line_pids):
                continue
            line_ports = ports_from_socket_line(line)
            for port in line_ports:
                if port not in ports:
                    ports.append(port)
            if line_ports:
                evidence["matches"].append({
                    "command": key,
                    "line": line,
                    "pids": line_pids,
                    "ports": line_ports,
                })
    return ports, evidence, errors, warnings


def perform_socket_discovery(
    root: Path,
    tmux_data: dict[str, Any] | None = None,
    capabilities: dict[str, Any] | None = None,
    write: bool = True,
) -> dict[str, Any]:
    errors: list[str] = []
    warnings: list[str] = []
    tmux_data = tmux_data or discover_tmux_opencode()
    process_trees: dict[str, Any] = {}
    opencode_pids: list[int] = []
    related_pids: list[int] = []
    args_ports: list[int] = []
    args_hostnames: list[str] = []

    for pane in tmux_data.get("opencode_panes", []):
        pane_pid = pane.get("pane_pid")
        if not pane_pid:
            continue
        tree = recursive_process_tree(int(pane_pid), max_depth=5)
        process_trees[str(pane_pid)] = tree
        related_pids.extend(int(pid) for pid in tree.get("nodes", {}).keys() if str(pid).isdigit())
        opencode_pids.extend(find_opencode_pids(tree))
        text = process_tree_text(tree)
        args_ports.extend(parse_ports_from_text(text))
        args_hostnames.extend(parse_hostnames_from_text(text))

    opencode_pids = unique_ints(opencode_pids)
    related_pids = unique_ints(related_pids)
    args_ports = unique_ints(args_ports)
    args_hostnames = sorted(set(args_hostnames))

    if not tmux_data.get("opencode_panes"):
        warnings.append("no OpenCode pane found in current tmux window")
    if not opencode_pids and tmux_data.get("opencode_panes"):
        warnings.append("OpenCode pane found, but no child process with opencode in argv was identified")

    socket_ports, socket_evidence, socket_errors, socket_warnings = discover_socket_ports(related_pids)
    errors.extend(socket_errors)
    warnings.extend(socket_warnings)
    if related_pids and not socket_ports:
        warnings.append("no listening socket could be associated with OpenCode pane process tree")

    ports = candidate_ports(capabilities, tmux_data, {
        "args_ports": args_ports,
        "socket_ports": socket_ports,
    })
    probe_results = probe_servers(ports)
    reachable = [item for item in probe_results.get("servers", []) if item.get("reachable")]
    if not reachable:
        warnings.append("no reachable OpenCode server found from candidate ports")

    data = {
        "schema_version": 1,
        "generated_at": utc_now(),
        "root": str(root),
        "tmux_panes": tmux_data.get("panes", []),
        "opencode_panes": tmux_data.get("opencode_panes", []),
        "opencode_pids": opencode_pids,
        "opencode_related_pids": related_pids,
        "process_tree": process_trees,
        "args_ports": args_ports,
        "args_hostnames": args_hostnames,
        "socket_ports": socket_ports,
        "socket_evidence": socket_evidence,
        "candidate_ports": ports,
        "probe_results": probe_results,
        "errors": errors,
        "warnings": warnings,
        "notes": [
            "Only the current tmux session/window is inspected.",
            "Socket discovery uses read-only /proc process metadata and ss/lsof/netstat.",
            "HTTP probing is limited to localhost GET endpoints.",
        ],
    }
    if write:
        write_json(ensure_framework(root) / "opencode_socket_discovery.json", data)
        write_json(ensure_framework(root) / "opencode_servers.json", probe_results)
    return data


def normalize_header_map(headers: Any) -> dict[str, str]:
    return {str(key): str(value) for key, value in dict(headers.items()).items()}


def header_value(headers: dict[str, str], name: str) -> str:
    for key, value in headers.items():
        if key.lower() == name.lower():
            return value
    return ""


def decode_body(raw: bytes, headers: dict[str, str]) -> tuple[bytes, str, bool]:
    encoding = header_value(headers, "Content-Encoding").lower()
    decoded = raw
    compressed = encoding in {"gzip", "deflate"}
    try:
        if encoding == "gzip":
            decoded = gzip.decompress(raw)
        elif encoding == "deflate":
            try:
                decoded = zlib.decompress(raw)
            except zlib.error:
                decoded = zlib.decompress(raw, -zlib.MAX_WBITS)
    except Exception:
        decoded = raw

    charset = "utf-8"
    content_type = header_value(headers, "Content-Type")
    match = re.search(r"charset=([^;\s]+)", content_type, flags=re.IGNORECASE)
    if match:
        charset = match.group(1).strip("\"'")
    return decoded, decoded.decode(charset, errors="replace"), compressed


def safe_http_request(
    hostname: str,
    port: int,
    path: str,
    method: str,
    timeout: float = 2.0,
    limit: int = 8192,
    include_body_text: bool = False,
) -> dict[str, Any]:
    if hostname not in {"127.0.0.1", "localhost"}:
        raise AdapterError("HTTP probing only allows 127.0.0.1 or localhost")
    if method not in {"GET", "HEAD", "OPTIONS"}:
        raise AdapterError(f"HTTP method not allowed in this phase: {method}")
    if not path.startswith("/") or "\x00" in path:
        raise AdapterError(f"invalid localhost path: {path!r}")
    if not (1 <= int(port) <= 65535):
        raise AdapterError(f"invalid port: {port}")

    url = f"http://{hostname}:{int(port)}{path}"
    request = Request(
        url,
        method=method,
        headers={
            "User-Agent": "omx-opencode-tui-adapter/3B-0.5",
            "Accept-Encoding": "identity",
        },
    )
    started = time.time()
    try:
        with urlopen(request, timeout=timeout) as response:
            status = getattr(response, "status", 200)
            headers = normalize_header_map(response.headers)
            body = b""
            timed_out = False
            if method != "HEAD":
                try:
                    body = response.read(limit)
                except socket.timeout:
                    timed_out = True
            elapsed = round(time.time() - started, 3)
            decoded, body_text, compressed = decode_body(body, headers)
            content_length = header_value(headers, "Content-Length")
            result = {
                "ok": 200 <= int(status) < 300,
                "reachable": True,
                "status": int(status),
                "method": method,
                "url": url,
                "headers": headers,
                "content_type": header_value(headers, "Content-Type"),
                "content_length": int(content_length) if content_length.isdigit() else None,
                "content_encoding": header_value(headers, "Content-Encoding"),
                "compressed": compressed,
                "bytes_read": len(body),
                "decoded_bytes_read": len(decoded),
                "truncated": method != "HEAD" and len(body) >= limit,
                "timed_out": timed_out,
                "elapsed_seconds": elapsed,
                "body_head": body_text[:2000],
            }
            if include_body_text:
                result["body_text"] = body_text
            return result
    except HTTPError as exc:
        headers = normalize_header_map(exc.headers)
        body = b""
        if method != "HEAD":
            body = exc.read(limit)
        decoded, body_text, compressed = decode_body(body, headers)
        content_length = header_value(headers, "Content-Length")
        result = {
            "ok": 200 <= int(exc.code) < 300,
            "reachable": True,
            "status": int(exc.code),
            "method": method,
            "url": url,
            "headers": headers,
            "content_type": header_value(headers, "Content-Type"),
            "content_length": int(content_length) if content_length.isdigit() else None,
            "content_encoding": header_value(headers, "Content-Encoding"),
            "compressed": compressed,
            "bytes_read": len(body),
            "decoded_bytes_read": len(decoded),
            "truncated": method != "HEAD" and len(body) >= limit,
            "timed_out": False,
            "elapsed_seconds": round(time.time() - started, 3),
            "body_head": body_text[:2000],
            "error": str(exc),
        }
        if include_body_text:
            result["body_text"] = body_text
        return result
    except (URLError, TimeoutError, socket.timeout, ConnectionError, OSError) as exc:
        # Classify the transport root cause (#934): urllib wraps the real
        # cause (timeout, refusal, generic I/O failure) in URLError.reason.
        # A wrapped timeout is a timeout, an explicit refusal is a refusal,
        # and anything else is an unknown/failed observation - never a
        # silent stand-in for a definite refusal.
        reason = getattr(exc, "reason", None)
        if not isinstance(reason, BaseException):
            reason = exc
        timed_out = isinstance(exc, (TimeoutError, socket.timeout)) or isinstance(
            reason, (TimeoutError, socket.timeout)
        )
        connection_refused = isinstance(exc, ConnectionRefusedError) or isinstance(
            reason, ConnectionRefusedError
        )
        return {
            "ok": False,
            "reachable": False,
            "status": None,
            "method": method,
            "url": url,
            "headers": {},
            "content_type": "",
            "content_length": None,
            "content_encoding": "",
            "compressed": False,
            "bytes_read": 0,
            "decoded_bytes_read": 0,
            "truncated": False,
            "timed_out": timed_out,
            "connection_refused": connection_refused,
            "elapsed_seconds": round(time.time() - started, 3),
            "body_head": "",
            "error": str(exc),
        }


_ALLOWED_JSON_REQUEST_METHODS = frozenset({"POST", "PATCH"})


def _safe_http_json_post(
    hostname: str,
    port: int,
    path: str,
    payload: dict[str, Any] | None,
    *,
    timeout: float = 6.0,
    allowed_paths: set[str],
    label: str,
    method: str = "POST",
) -> dict[str, Any]:
    if method not in _ALLOWED_JSON_REQUEST_METHODS:
        raise AdapterError(f"{label} only allows POST or PATCH")
    if hostname != "127.0.0.1":
        raise AdapterError(f"{label} only allows 127.0.0.1")
    if path not in allowed_paths:
        raise AdapterError(f"{method} path is not whitelisted: {path}")
    if not (1 <= int(port) <= 65535):
        raise AdapterError(f"invalid port: {port}")
    if payload is not None and not isinstance(payload, dict):
        raise AdapterError(f"{method} payload must be a JSON object")

    if payload is None:
        body = None
        request_headers = {
            "User-Agent": "omx-opencode-tui-adapter/3B",
            "Accept": "application/json",
            "Accept-Encoding": "identity",
        }
    else:
        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        request_headers = {
            "User-Agent": "omx-opencode-tui-adapter/3B",
            "Accept": "application/json",
            "Content-Type": "application/json",
            "Accept-Encoding": "identity",
        }
    url = f"http://{hostname}:{int(port)}{path}"
    request = Request(
        url,
        method=method,
        data=body,
        headers=request_headers,
    )
    started = time.time()

    def result_from_response(status: int, headers: dict[str, str], raw: bytes, error: str = "") -> dict[str, Any]:
        decoded, body_text, compressed = decode_body(raw, headers)
        content_length = header_value(headers, "Content-Length")
        return {
            "ok": 200 <= int(status) < 300,
            "reachable": True,
            "status": int(status),
            "method": method,
            "url": url,
            "path": path,
            "content_type": header_value(headers, "Content-Type"),
            "content_length": int(content_length) if content_length.isdigit() else None,
            "content_encoding": header_value(headers, "Content-Encoding"),
            "compressed": compressed,
            "bytes_read": len(raw),
            "decoded_bytes_read": len(decoded),
            "body_head": body_text[:HTTP_RESPONSE_LOG_LIMIT],
            "truncated": len(raw) > HTTP_RESPONSE_LOG_LIMIT,
            "elapsed_seconds": round(time.time() - started, 3),
            "error": error,
        }

    try:
        with urlopen(request, timeout=timeout) as response:
            headers = normalize_header_map(response.headers)
            return result_from_response(int(getattr(response, "status", 200)), headers, response.read(HTTP_RESPONSE_LOG_LIMIT + 1))
    except HTTPError as exc:
        headers = normalize_header_map(exc.headers)
        return result_from_response(
            int(exc.code),
            headers,
            exc.read(HTTP_RESPONSE_LOG_LIMIT + 1),
            str(exc),
        )
    except (URLError, TimeoutError, socket.timeout, ConnectionError, OSError) as exc:
        return {
            "ok": False,
            "reachable": False,
            "status": None,
            "method": method,
            "url": url,
            "path": path,
            "content_type": "",
            "content_length": None,
            "content_encoding": "",
            "compressed": False,
            "bytes_read": 0,
            "decoded_bytes_read": 0,
            "body_head": "",
            "elapsed_seconds": round(time.time() - started, 3),
            "error": str(exc),
        }


def safe_http_json_post(hostname: str, port: int, path: str, payload: dict[str, Any], timeout: float = 6.0) -> dict[str, Any]:
    return _safe_http_json_post(
        hostname,
        port,
        path,
        payload,
        timeout=timeout,
        allowed_paths=TUI_POST_ENDPOINTS,
        label="submit-real",
    )


def safe_http_json_post_reset(hostname: str, port: int, path: str, payload: dict[str, Any], timeout: float = 6.0) -> dict[str, Any]:
    return _safe_http_json_post(
        hostname,
        port,
        path,
        payload,
        timeout=timeout,
        allowed_paths=RESET_TUI_POST_ENDPOINTS,
        label="execute-command-real",
    )


