def submit_tui_capability(root: Path, worker_id: str, binding: dict[str, Any]) -> dict[str, Any]:
    methods = []
    seen: set[str] = set()
    for endpoint in binding.get("detected_tui_methods", []):
        endpoint_text = str(endpoint)
        if endpoint_text and endpoint_text not in seen:
            methods.append(endpoint_text)
            seen.add(endpoint_text)

    live_readiness: dict[str, Any] = {}
    missing = [endpoint for endpoint in TUI_ENDPOINTS_ORDERED if endpoint not in seen]
    source = "binding"
    if missing:
        live_readiness = visible_tui_readiness(root, worker_id)
        if bool(live_readiness.get("doc_ok")):
            for endpoint in live_readiness.get("detected_tui_methods", []):
                endpoint_text = str(endpoint)
                if endpoint_text and endpoint_text not in seen:
                    methods.append(endpoint_text)
                    seen.add(endpoint_text)
            source = "binding+live_readiness"
        elif live_readiness:
            source = "binding+live_readiness_probe_failed"

    ordered_methods = [endpoint for endpoint in TUI_ENDPOINTS_ORDERED if endpoint in seen]
    ordered_methods.extend(endpoint for endpoint in methods if endpoint not in ordered_methods)
    return {
        "detected_tui_methods": ordered_methods,
        "missing_required_endpoints": [endpoint for endpoint in TUI_ENDPOINTS_ORDERED if endpoint not in set(ordered_methods)],
        "source": source,
        "live_readiness": live_readiness,
    }


def command_tui_readiness(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    data = visible_tui_readiness(root, args.worker)
    if args.json:
        print(json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print(f"worker: {data['worker_id']}")
        print(f"pane: {data.get('pane_id') or '-'}")
        print(f"port: {data.get('port')}")
        print(f"server_live: {str(bool(data.get('server_live'))).lower()}")
        print(f"doc_ok: {str(bool(data.get('doc_ok'))).lower()}")
        print(f"session_status_ok: {str(bool(data.get('session_status_ok'))).lower()}")
        print(f"readiness: {data.get('readiness')}")
        print(f"reason: {data.get('reason')}")
        print(f"snapshot: {rel(framework_root(root) / 'tui-readiness' / 'latest.json', root)}")
        print("session_status_raw_summary:")
        print(str(data.get("session_status_raw_summary", ""))[:1000] or "(empty)")
    if data.get("readiness") in {"busy", "unhealthy"}:
        return 1
    return 0


def visible_prompt_text(root: Path, run: str, task: str, worker: str, title: str, body: str) -> str:
    tdir = task_dir(root, run, task)
    task_md = tdir / "task.md"
    report = tdir / "report.md"
    signal = root / "bin" / "omx_task_signal"
    return f"""OMX_RUN_ID={run}
OMX_TASK_ID={task}
OMX_WORKER_ID={worker}
backend=opencode_tui
task_dir={tdir}
task.md={task_md}
report.md={report}

Title:
{title}

Task body:
{body}

Protocol:
- First command: `{signal} received --root "{root}" --task-dir "{tdir}" --worker "{worker}"`
- Before work: `{signal} started --root "{root}" --task-dir "{tdir}" --worker "{worker}"`
- If work takes longer than 30 seconds: `{signal} heartbeat --root "{root}" --task-dir "{tdir}" --worker "{worker}"`
- Write a non-empty `{report}` before finishing.
- Finish exactly once with `{signal} finish --root "{root}" --task-dir "{tdir}" --worker "{worker}" --state done|fail|blocked`.

Write scope:
- Inside `{tdir}`: `{report}`, task-signal protocol artifacts, the task-local subagent ledger, and task files this prompt explicitly requires; use task-owned temporary paths under `{tdir}` for scratch output.
- Supplied task paths are literal (#1038/#986): use the task_dir/task.md/report.md paths above exactly as rendered; do not reconstruct run ids or task-id segments and do not synthesize shortened or placeholder sibling paths - a string that omits or alters one segment is a different path. Before the first write, locate the exact authorized parent with one bounded check of the literal TASK_DIR (`test -d`); if it is unavailable, surface the exact literal and the observed error through the still-available reporting channel and stop - no replacement directory, placeholder-sibling write, implicit write-domain expansion, or claim of an accepted terminal marker.
- Before reporting a supplied source path as missing (#986): compare the failed lookup string with the contract literal segment by segment, then run at most one narrow exact probe of the literal path itself; do not scan the filesystem broadly. Separate the author's or a child's lookup claim from the observed state of the exact original - a failed lookup of an altered or shortened string is not evidence about it, and a false existence probe is unconfirmed (absent or unreadable); never silently fix, create, or delete either path.
- Referenced local files may carry narrower task constraints that further restrict this scope; they never expand it, and referencing a file as an input does not by itself restrict anything.
- Task-directory write permission does not authorize hand-writing authoritative protocol records (fence, identity records, status, markers, claims; use the control plane's generated protocol commands for those.
- Deliverables stay inside `{report}` unless this prompt explicitly authorizes outside-task writes through the control-plane delivery that carries that authorization.

Required OpenCode native subagent ledger when used:
- If this task uses native subagents or Task-style artifact lanes, append task-local `subagent_ledger.jsonl` rows inside the task directory as soon as each subagent/lane is launched or completed so the board can show running/completed subagent use.
- Prefer `./bin/omx_subagent_ledger append --root "{root}" --task-dir "{tdir}" --worker "{worker}" ... --write-task-local` when available; otherwise append JSONL directly.
- Before the first helper call, run `./bin/omx_subagent_ledger append --help`; use only listed enum values and omit optional enum flags rather than inferring values from prose.
- Use the same subagent_id for one native subagent lifecycle, for example `status=launched` when it starts and `status=completed|failed|blocked` when it ends.
- Use one JSONL row per subagent/lane with parent_worker_id, parent_run_id, parent_task_id, subagent_id, agent, lane, purpose, status, and optional artifact/semantic_status/retry_scope fields. `subagent_ledger.json` is allowed only when rewriting the complete task-local ledger atomically is safer.
- This ledger is advisory evidence only and does not change completion truth; report.md + exactly one of .done/.fail/.blocked remains the terminal signal.
- Do not write subagent ledger files outside this task-local directory. `omx_task_signal` does not manage the ledger.

Important:
- Do not only say the task is complete verbally.
- Do not hand-write `.received`, `.started`, `.heartbeat`, `.done`, `.fail`, or `.blocked`; use `{signal}`.
- Do not modify business files.
- submitted is not received.
- idle is not completed.
- report.md is the formal deliverable.
- This prompt will be automatically submitted by the adapter to a user-visible OpenCode TUI.

IMPORTANT TERMINATION RULE:
After `finish --state done|fail|blocked` succeeds, stop. Do not repeat the completion summary, restate the file list, continue reasoning, or start another loop. Your final visible response must be at most one line:
OMX_TASK_CLOSED {task} <state>
"""


def visible_task_dir(root: Path, run: str, task: str) -> Path:
    visible_run = run if run.startswith("visible-runs/") else f"visible-runs/{run}"
    return task_dir(root, visible_run, task)


def visible_owner_lock_path(root: Path, worker_id: str) -> Path:
    return (
        framework_root(root)
        / "visible-runs"
        / "_locks"
        / f"{safe_slug(worker_id, 'worker')}.lock.json"
    )


@contextmanager
def reset_recovery_owner_reservation(
    root: Path,
    worker_id: str,
    *,
    source_run: str,
    source_task: str,
    record: dict[str, Any],
    contract_hash: str,
    recovery_reservation_id: str,
    target_run_root: Path,
    expected_first_lane_id: str,
    expected_first_request_hash: str,
    expected_first_dispatch_hash: str,
) -> Iterator[dict[str, Any]]:
    lock_path = visible_owner_lock_path(root, worker_id)
    owner_lock_id = recovery_reservation_id
    created_at = utc_now()
    lock_data = {
        "schema_version": 1,
        "owner_lock_id": owner_lock_id,
        "owner_lock_version": 1,
        "worker_id": worker_id,
        "runtime_backend": "tmux-reference",
        "run": source_run.removeprefix("visible-runs/"),
        "task": source_task,
        "created_at": created_at,
        "pane_id": record.get("pane_id"),
        "pane_pid": record.get("pane_pid"),
        "port": int(record.get("port") or 0),
        "tmux_session": record.get("tmux_session"),
        "tmux_window": record.get("tmux_window"),
        "listener_pids": record.get("listener_pids", []),
        "opencode_pids": record.get("opencode_pids", []),
        "binding_generation": record.get("binding_generation"),
        "binding_lease_id": record.get("binding_lease_id"),
        "binding_expires_at": record.get("binding_expires_at"),
        "status": "reset_recovery_verifying",
        "task_dir": rel(
            visible_task_dir(root, source_run, source_task),
            root,
        ),
        "owner": (
            "omx_opencode_tui_adapter:"
            "verify-reset-recovery-real"
        ),
        "rotation_contract_hash": contract_hash,
        "rotation_reason": "worker_reuse",
        "recovery_kind": "verify_only_consumed_reset",
        "target_run_root": str(target_run_root),
        "expected_first_lane_id": expected_first_lane_id,
        "expected_first_request_hash": expected_first_request_hash,
        "expected_first_dispatch_hash": expected_first_dispatch_hash,
        "verification_pid": os.getpid(),
        "verification_host_boot_id": host_boot_id(),
        "verification_started_at": created_at,
    }
    payload = (
        json.dumps(
            lock_data,
            indent=2,
            sort_keys=True,
            ensure_ascii=False,
        )
        + "\n"
    )
    owns_uncommitted_reservation = False
    expected_status = "reset_recovery_verifying"
    expected_version = 1
    with global_mutation_gate(root, exclusive=False):
        with visible_registry_lock(root):
            lock_path.parent.mkdir(parents=True, exist_ok=True)
            descriptor: int | None = None
            try:
                descriptor = os.open(
                    lock_path,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                    0o600,
                )
                owns_uncommitted_reservation = True
            except FileExistsError as exc:
                existing = read_json_safe(lock_path)
                expected = {
                    "owner_lock_id": owner_lock_id,
                    "worker_id": worker_id,
                    "run": source_run.removeprefix("visible-runs/"),
                    "task": source_task,
                    "target_run_root": str(target_run_root),
                    "rotation_contract_hash": contract_hash,
                    "recovery_kind": "verify_only_consumed_reset",
                    "expected_first_lane_id": expected_first_lane_id,
                    "expected_first_request_hash": (
                        expected_first_request_hash
                    ),
                    "expected_first_dispatch_hash": (
                        expected_first_dispatch_hash
                    ),
                }
                mismatches = [
                    field
                    for field, value in expected.items()
                    if str(existing.get(field) or "") != str(value)
                ]
                existing_status = str(existing.get("status") or "")
                if mismatches or existing_status not in {
                    "reset_recovery_verifying",
                    "reset_recovery_reserved",
                }:
                    raise AdapterError(
                        "reset recovery target worker is already owned:"
                        f" run={existing.get('run') or '-'}"
                        f" task={existing.get('task') or '-'}"
                    ) from exc
                if existing_status == "reset_recovery_verifying":
                    verifier_pid = int(
                        existing.get("verification_pid") or 0
                    )
                    verifier_boot = str(
                        existing.get("verification_host_boot_id") or ""
                    )
                    verifier_alive = False
                    if (
                        verifier_pid > 0
                        and verifier_boot == host_boot_id()
                    ):
                        try:
                            os.kill(verifier_pid, 0)
                        except ProcessLookupError:
                            verifier_alive = False
                        except PermissionError:
                            verifier_alive = True
                        else:
                            verifier_alive = True
                    if verifier_alive:
                        raise AdapterError(
                            "reset recovery verification is already "
                            "in progress"
                        ) from exc
                    if verifier_pid <= 0 or not verifier_boot:
                        raise AdapterError(
                            "reset recovery verifying reservation has "
                            "no stale-owner evidence"
                        ) from exc
                    lock_data = {
                        **existing,
                        "owner_lock_version": (
                            int(
                                existing.get(
                                    "owner_lock_version"
                                )
                                or 0
                            )
                            + 1
                        ),
                        "verification_pid": os.getpid(),
                        "verification_host_boot_id": host_boot_id(),
                        "verification_started_at": utc_now(),
                        "verification_takeover": True,
                    }
                    write_json_atomic(lock_path, lock_data)
                    owns_uncommitted_reservation = True
                else:
                    lock_data = dict(existing)
                expected_status = str(lock_data["status"])
                expected_version = int(
                    lock_data.get("owner_lock_version") or 0
                )
            try:
                if descriptor is not None:
                    with os.fdopen(
                        descriptor,
                        "w",
                        encoding="utf-8",
                    ) as handle:
                        handle.write(payload)
                        handle.flush()
                        os.fsync(handle.fileno())
            except Exception:
                lock_path.unlink(missing_ok=True)
                raise

        try:
            yield lock_data
        except BaseException:
            if owns_uncommitted_reservation:
                with visible_registry_lock(root):
                    current = read_json_safe(lock_path)
                    if (
                        str(current.get("owner_lock_id") or "")
                        != owner_lock_id
                        or str(current.get("status") or "")
                        != expected_status
                        or int(
                            current.get("owner_lock_version") or 0
                        )
                        != expected_version
                    ):
                        raise AdapterError(
                            "reset recovery owner lock changed before "
                            "release"
                        )
                    released_at = utc_now()
                    released = {
                        **current,
                        "status": "released",
                        "released_at": released_at,
                        "release_reason": (
                            "verify_reset_recovery_failed"
                        ),
                    }
                    archive_root = lock_path.parent / "archive"
                    archive_name = (
                        f"{worker_id}."
                        f"{source_run.removeprefix('visible-runs/')}."
                        f"{source_task}."
                        f"{released_at.replace(':', '').replace('-', '')}."
                        f"{owner_lock_id[:8]}.lock.json"
                    )
                    write_json(archive_root / archive_name, released)
                    lock_path.unlink()
            raise
        else:
            with visible_registry_lock(root):
                current = read_json_safe(lock_path)
                if (
                    str(current.get("owner_lock_id") or "")
                    != owner_lock_id
                    or str(current.get("status") or "")
                    != expected_status
                    or int(current.get("owner_lock_version") or 0)
                    != expected_version
                ):
                    raise AdapterError(
                        "reset recovery owner lock changed before commit"
                    )
                committed = {
                    **current,
                    **lock_data,
                    "owner_lock_version": (
                        expected_version + 1
                    ),
                    "status": "reset_recovery_reserved",
                    "updated_at": utc_now(),
                }
                write_json_atomic(lock_path, committed)


def require_visible_owner_lock(root: Path, worker_id: str) -> dict[str, Any]:
    path = visible_owner_lock_path(root, worker_id)
    lock = read_json_safe(path)
    if not lock:
        raise AdapterError(
            f"visible owner lock is missing: {rel(path, root)}"
        )
    return lock


def validate_visible_submission_guard(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    expected_record: dict[str, Any],
    expected_binding: dict[str, Any],
    expected_owner_lock: dict[str, Any],
    runtime_backend: str,
    require_submitted: bool,
    require_started: bool = False,
    allow_reviewed_report: bool = False,
) -> None:
    canonical_run = run.removeprefix("visible-runs/")
    tdir = visible_task_dir(root, run, task)
    current_record = require_visible_worker(root, worker_id)
    if not current_record.get("allow_auto_submit"):
        raise AdapterError(
            f"visible worker {worker_id!r} has allow_auto_submit=false"
        )
    require_current_binding_lease(current_record)
    if not visible_worker_binding_fence_matches(
        expected_record,
        current_record,
    ):
        raise AdapterError(
            "visible binding ownership changed before TUI submission"
        )
    owner_path = tdir / "owner"
    owner = read_text(owner_path).strip() if owner_path.is_file() else ""
    if owner != worker_id:
        raise AdapterError(
            "visible task owner changed before TUI submission"
        )

    lock = read_json_safe(visible_owner_lock_path(root, worker_id))
    if owner_lock_transition_fence(lock) != owner_lock_transition_fence(
        expected_owner_lock
    ):
        raise AdapterError(
            "visible owner lock transition changed before TUI submission"
        )
    lock_run = str(lock.get("run") or "").removeprefix("visible-runs/")
    if (
        str(lock.get("worker_id") or worker_id) != worker_id
        or lock_run != canonical_run
        or str(lock.get("task") or "") != task
    ):
        raise AdapterError(
            "visible owner lock changed before TUI submission"
        )
    for field in ("binding_generation", "binding_lease_id"):
        lock_value = lock.get(field)
        current_value = current_record.get(field)
        if lock_value not in {None, ""} and current_value != lock_value:
            raise AdapterError(
                f"visible owner lock {field} no longer matches the binding"
            )

    submitted = (tdir / ".submitted").is_file()
    if require_submitted and not submitted:
        raise AdapterError(
            "visible recovery requires submitted evidence at TUI submission"
        )
    if not require_submitted and submitted:
        raise AdapterError(
            "visible task became submitted before TUI submission completed"
        )
    if require_started and not (tdir / ".started").is_file():
        raise AdapterError(
            "visible recovery requires started evidence at TUI submission"
        )
    terminal = [
        name
        for name in ("done", "fail", "blocked")
        if (tdir / f".{name}").is_file()
    ]
    report = tdir / "report.md"
    if terminal or (
        not allow_reviewed_report
        and report.is_file()
        and report.stat().st_size > 0
    ):
        raise AdapterError(
            "visible submission refuses terminal task evidence"
        )


def validate_recovery_submission_guard(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    expected_record: dict[str, Any],
    expected_binding: dict[str, Any],
    expected_owner_lock: dict[str, Any],
    runtime_backend: str,
    reviewed_replacement_session_id: str = "",
) -> None:
    tdir = visible_task_dir(root, run, task)
    handshake = read_json_safe(tdir / "recovery_handshake.json")
    reviewed_replacement = bool(reviewed_replacement_session_id)
    validate_visible_submission_guard(
        root,
        run,
        task,
        worker_id,
        expected_record=expected_record,
        expected_binding=expected_binding,
        expected_owner_lock=expected_owner_lock,
        runtime_backend=runtime_backend,
        require_submitted=True,
        require_started=True,
        allow_reviewed_report=reviewed_replacement,
    )
    canonical_run = run.removeprefix("visible-runs/")
    if (
        str(handshake.get("status") or "") != "prepared"
        or str(handshake.get("worker_id") or "") != worker_id
        or str(handshake.get("run_id") or "").removeprefix("visible-runs/")
        != canonical_run
        or str(handshake.get("task_id") or "") != task
        or str(handshake.get("reviewed_replacement_session_id") or "")
        != reviewed_replacement_session_id
    ):
        raise AdapterError(
            "recovery handshake claim changed before TUI submission"
        )
    if reviewed_replacement:
        current_worker_identity = [
            str(expected_record.get("worker_id") or ""),
            str(expected_record.get("instance_id") or ""),
            int(expected_record.get("binding_generation") or 0),
            int(
                expected_record.get("fencing_generation")
                or expected_record.get("binding_generation")
                or 0
            ),
            str(expected_record.get("host") or "127.0.0.1"),
            int(expected_record.get("port") or 0),
            str(expected_record.get("pane_id") or ""),
            expected_record.get("pane_pid"),
        ]
        report = tdir / "report.md"
        protocol_status = read_json_safe(tdir / "protocol_status.json")
        reviewed_worker_identity = handshake.get(
            "reviewed_worker_identity"
        )
        reviewed_worker_matches = bool(
            isinstance(reviewed_worker_identity, list)
            and len(reviewed_worker_identity) == 8
            and reviewed_worker_identity[:7] == current_worker_identity[:7]
            and (
                reviewed_worker_identity[7] is None
                or reviewed_worker_identity[7] == current_worker_identity[7]
            )
        )
        if (
            not reviewed_worker_matches
            or handshake.get("reviewed_owner_lock_transition")
            != list(owner_lock_transition_fence(expected_owner_lock))
            or not report.is_file()
            or report.stat().st_size <= 0
            or any(
                (tdir / f".{name}").is_file()
                for name in ("done", "fail", "blocked")
            )
            or str(protocol_status.get("status") or "")
            != "finish_refused_acceptance_fence"
            or protocol_status.get("finish_refused_missing_report")
            is not False
            or protocol_status.get("terminal_markers") != []
            or not isinstance(
                protocol_status.get("terminal_acceptance"),
                dict,
            )
            or protocol_status["terminal_acceptance"].get("accepted")
            is not False
        ):
            raise AdapterError(
                "reviewed replacement recovery evidence changed before TUI submission"
            )


def visible_payload_attempt(
    root: Path,
    tdir: Path,
    run: str,
    task: str,
    worker_id: str,
    binding: dict[str, Any],
    prompt_path: Path,
    prompt_body: str,
    submitted_prompt_body: str,
    prompt_delivery_mode: str,
    visual_prompt_exposure: bool,
    schema_data: dict[str, Any],
) -> dict[str, Any]:
    return {
        "schema_version": 1,
        "attempted_at": utc_now(),
        "mode": "visible-real",
        "run": run,
        "task": task,
        "worker": worker_id,
        "pane_id": binding.get("pane_id"),
        "pane_pid": binding.get("pane_pid"),
        "port": binding.get("port"),
        "host": "127.0.0.1",
        "binding_confidence": binding.get("binding_confidence"),
        "prompt_path": rel(prompt_path, root),
        "prompt_sha256": hashlib.sha256(prompt_body.encode("utf-8")).hexdigest(),
        "prompt_bytes": len(prompt_body.encode("utf-8")),
        "submitted_prompt_sha256": hashlib.sha256(
            submitted_prompt_body.encode("utf-8")
        ).hexdigest(),
        "submitted_prompt_bytes": len(
            submitted_prompt_body.encode("utf-8")
        ),
        "prompt_delivery_mode": prompt_delivery_mode,
        "visual_prompt_exposure": visual_prompt_exposure,
        "allowed_post_paths": list(TUI_ENDPOINTS_ORDERED),
        "schema_path": rel(framework_root(root) / f"opencode_tui_endpoint_schema_{int(binding.get('port'))}.json", root),
        "task_path": rel(tdir, root),
        "adapter_writes_only": [".submitted", "delivery.json", "delivery_attempt.json", "events.jsonl"],
        "adapter_never_writes": [".received", ".started", ".heartbeat", ".done", ".fail", ".blocked"],
        "endpoint_schema_all_payloads_executable": bool(schema_data.get("all_payloads_executable")),
    }


def visible_prompt_envelope(
    run: str,
    task: str,
    worker_id: str,
    prompt_path: Path,
    *,
    root: Path,
    acceptance_fence: dict[str, Any],
) -> str:
    tdir = prompt_path.resolve().parent
    return f"""OMX visible task
OMX_RUN_ID={run}
OMX_TASK_ID={task}
OMX_WORKER_ID={worker_id}
OMX_ATTEMPT_ID={acceptance_fence["attempt_id"]}
OMX_CONTRACT_HASH={acceptance_fence["contract_hash"]}
Full task instructions: {prompt_path.resolve()}

Read the full task instructions from that file before acting.
Do not treat this short envelope as the complete task.

Write authorization for this task/attempt covers exactly these classes:
1. Protocol writes inside the task directory: {tdir / "report.md"} plus the
   {root / "bin/omx_task_signal"} protocol artifacts (received, started,
   heartbeat, and exactly one fenced finish with --root {root} --task-dir
   {tdir} --worker {worker_id}) and the task-local subagent ledger
   (subagent_ledger.jsonl inside {tdir}).
2. Task files the full task instructions explicitly require you to create or
   write inside the task directory (evidence, checkpoints, drafts) stay
   inside {tdir}; use task-owned temporary paths under {tdir} for scratch
   output.
3. Placing deliverables outside the task directory is not authorized in this
   delivery mode: deliverables live inside this task directory, never in the
   project tree - {tdir / "report.md"} may reference task-local deliverable
   files concisely (relative path, scope, verification result) without
   duplicating their full content, embedding full content inline only when
   the exact task contract requires inline delivery - and the leader lands
   project-tree artifacts. Outside-task writes require the control plane to
   deliver the full prompt with its explicit write grants
   (--allow-visible-full-prompt); this envelope cannot grant them.
Use the generated exact commands and current {tdir / "acceptance_fence.json"}; preserve all owner, authorization, and fence checks. After report and finish, emit the exact current-task OMX_TASK_CLOSED sentinel once and stop.
Referenced local files may carry narrower task constraints (permitted paths, acceptance conditions) that further restrict this scope; they never expand it, and merely referencing a file as an input does not by itself restrict anything.
Permission to write files inside the task directory does not authorize hand-writing authoritative protocol records (acceptance_fence.json, task/dispatch identity records, protocol_status.json, markers, claims); those are produced only by the control plane and its generated protocol commands.
No other shared-checkout, external, Git, installation, or deployment writes are authorized.
"""


def visible_prompt_exposure_enabled(
    task_contract: dict[str, Any] | None,
    *,
    explicit: bool = False,
) -> bool:
    value = (
        task_contract.get("allow_visible_full_prompt", False)
        if isinstance(task_contract, dict)
        else False
    )
    if not isinstance(value, bool):
        raise AdapterError(
            "task contract allow_visible_full_prompt must be a boolean"
        )
    return explicit or value


def visible_prompt_submission(
    run: str,
    task: str,
    worker_id: str,
    prompt_path: Path,
    prompt_body: str,
    task_contract: dict[str, Any] | None,
    *,
    root: Path,
    acceptance_fence: dict[str, Any],
    visual_prompt_exposure: bool,
) -> tuple[str, str]:
    # Single mode selector shared with the leader's advisory output (#904);
    # visible_prompt_exposure_enabled above already validated the contract's
    # allow_visible_full_prompt boolean and resolved the effective exposure.
    mode = selected_prompt_delivery_mode(
        task_contract,
        explicit_full_prompt=visual_prompt_exposure,
    )
    if mode != "hidden-artifact-envelope":
        return prompt_body, mode
    return (
        visible_prompt_envelope(
            run, task, worker_id, prompt_path,
            root=root, acceptance_fence=acceptance_fence,
        ),
        mode,
    )


def command_capabilities(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    discovery = run_full_discovery(root)
    reachable = [item for item in discovery.get("servers", {}).get("servers", []) if item.get("reachable")]
    fixed_workers = discovery.get("fixed_workers", {})
    visible_registry = read_visible_registry(root)
    caps = {
        "opencode": discovery.get("opencode", {}),
        "features": discovery.get("features", {}),
        "opencode_panes": len(discovery.get("tmux", {}).get("opencode_panes", [])),
        "opencode_pids": discovery.get("socket_discovery", {}).get("opencode_pids", []),
        "args_ports": discovery.get("socket_discovery", {}).get("args_ports", []),
        "socket_ports": discovery.get("socket_discovery", {}).get("socket_ports", []),
        "candidate_ports": discovery.get("candidate_ports", []),
        "live_server_count": len(reachable),
        "servers": [
            {
                "port": item.get("port"),
                "global_health_available": item.get("global_health_available"),
                "doc_available": item.get("doc_available"),
                "session_status_available": item.get("session_status_available"),
                "global_event_available": item.get("global_event_available"),
                "event_available": item.get("event_available"),
                "detected_tui_methods": item.get("detected_tui_methods", []),
                "doc_paths": item.get("doc_summary", {}).get("paths", {}),
            }
            for item in reachable
        ],
        "fixed_workers": fixed_workers,
        "visible_workers": visible_registry,
        "fixed_workers_ready": bool(fixed_workers.get("fixed_workers_ready", False)),
        "ready_for_phase_3B_submit_real": bool(fixed_workers.get("ready_for_phase_3B_submit_real", False)),
        "ready_visible_workers": [
            worker.get("worker_id")
            for worker in visible_registry.get("workers", [])
            if isinstance(worker, dict)
            and worker.get("allow_auto_submit")
            and worker.get("binding_confidence") == "strong"
        ],
        "ready_for_visible_submit_real": any(
            isinstance(worker, dict)
            and worker.get("allow_auto_submit")
            and worker.get("binding_confidence") == "strong"
            for worker in visible_registry.get("workers", [])
        ),
        "can_enter_phase_3b": any(
            item.get("doc_available")
            and all(endpoint in set(item.get("detected_tui_methods", [])) for endpoint in TUI_ENDPOINTS)
            for item in reachable
        ) or bool(fixed_workers.get("ready_for_phase_3B_submit_real", False)),
    }
    print(json.dumps(caps, indent=2, ensure_ascii=False))
    return 0


def command_discover(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    discovery = run_full_discovery(root)
    print(f"discovery: {rel(framework_root(root) / 'opencode_discovery.json', root)}")
    print(f"socket_discovery: {rel(framework_root(root) / 'opencode_socket_discovery.json', root)}")
    print(f"opencode_available: {str(discovery.get('opencode', {}).get('available', False)).lower()}")
    print(f"opencode_panes: {len(discovery.get('tmux', {}).get('opencode_panes', []))}")
    print(f"opencode_pids: {discovery.get('socket_discovery', {}).get('opencode_pids', [])}")
    print(f"args_ports: {discovery.get('socket_discovery', {}).get('args_ports', [])}")
    print(f"socket_ports: {discovery.get('socket_discovery', {}).get('socket_ports', [])}")
    print(f"candidate_ports: {discovery.get('candidate_ports', [])}")
    reachable = [item for item in discovery.get("servers", {}).get("servers", []) if item.get("reachable")]
    print(f"reachable_servers: {len(reachable)}")
    fixed_workers = discovery.get("fixed_workers", {})
    print(f"fixed_worker_registry: {str(fixed_workers.get('registry_exists', False)).lower()}")
    print(f"fixed_workers_ready: {str(fixed_workers.get('fixed_workers_ready', False)).lower()}")
    print(f"ready_for_phase_3B_submit_real: {str(fixed_workers.get('ready_for_phase_3B_submit_real', False)).lower()}")
    for worker in fixed_workers.get("workers", []):
        print(
            f"  fixed {worker.get('worker_id')}: port={worker.get('port')} "
            f"server={str(worker.get('server_live')).lower()} "
            f"doc={str(worker.get('doc_available')).lower()} "
            f"clear={str(worker.get('tui_clear_prompt')).lower()} "
            f"append={str(worker.get('tui_append_prompt')).lower()} "
            f"submit={str(worker.get('tui_submit_prompt')).lower()}"
        )
    for item in reachable:
        print(
            f"  port {item.get('port')}: health={str(item.get('global_health_available')).lower()} "
            f"doc={str(item.get('doc_available')).lower()} "
            f"status={str(item.get('session_status_available')).lower()} "
            f"global_event={str(item.get('global_event_available')).lower()} "
            f"event={str(item.get('event_available')).lower()} "
            f"tui_methods={','.join(item.get('detected_tui_methods', [])) or '-'}"
        )
    return 0


def command_preflight(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    errors: list[str] = []
    warnings: list[str] = []

    if not (root / "bin" / "omx_team_dispatch").is_file():
        errors.append("missing bin/omx_team_dispatch")
    if not framework_root(root).is_dir():
        errors.append("missing .omx/framework/team")
    state_team = team_root(root)
    if state_team.is_dir():
        polluted = sorted(path.name for path in state_team.iterdir() if path.is_dir() and path.name in STATE_POLLUTION_DIRS)
        if polluted:
            errors.append(f".omx/state/team contains framework/internal dirs: {', '.join(polluted)}")
    else:
        warnings.append(".omx/state/team does not exist")

    discovery = run_full_discovery(root)
    if not discovery.get("opencode", {}).get("available"):
        warnings.append("opencode CLI unavailable")
    if not discovery.get("features", {}).get("can_fix_tui_server_address"):
        warnings.append("opencode help did not confirm fixed --hostname/--port support")
    opencode_pane_count = len(discovery.get("tmux", {}).get("opencode_panes", []))
    if not opencode_pane_count:
        warnings.append("no OpenCode pane found in current tmux window")
    reachable = [item for item in discovery.get("servers", {}).get("servers", []) if item.get("reachable")]
    if not reachable:
        if opencode_pane_count:
            warnings.append("OpenCode pane found but no live server; start future workers with explicit --hostname/--port")
        else:
            warnings.append("no accessible OpenCode server found; later phases should start TUI with explicit --hostname/--port")
    else:
        for item in reachable:
            methods = set(item.get("detected_tui_methods", []))
            missing = [endpoint for endpoint in TUI_ENDPOINTS if endpoint not in methods]
            if missing:
                warnings.append(f"server port {item.get('port')} missing doc evidence for: {', '.join(missing)}")
    ready_servers = [
        item
        for item in reachable
        if item.get("doc_available") and all(endpoint in set(item.get("detected_tui_methods", [])) for endpoint in TUI_ENDPOINTS)
    ]
    fixed_workers = discovery.get("fixed_workers", {})
    visible_registry = read_visible_registry(root)
    visible_ready = [
        worker
        for worker in visible_registry.get("workers", [])
        if isinstance(worker, dict)
        and worker.get("allow_auto_submit")
        and worker.get("binding_confidence") == "strong"
    ]
    if fixed_workers.get("registry_exists"):
        if fixed_workers.get("ready_for_phase_3B_submit_real"):
            ready_ports = [worker.get("port") for worker in fixed_workers.get("workers", []) if worker.get("server_live") and worker.get("doc_available") and has_all_tui_methods(worker)]
            print(f"fixed_worker_ready_ports: {ready_ports}")
        else:
            warnings.append("fixed worker registry exists, but no worker has live /doc with all required /tui endpoints")
    route_ready = any(worker.get("route_evidence_ready") for worker in fixed_workers.get("workers", []))
    doc_evidence_ready = any(worker.get("doc_evidence_ready") for worker in fixed_workers.get("workers", []))
    readiness_bases = sorted(set(str(worker.get("readiness_basis", "not_confirmed")) for worker in fixed_workers.get("workers", [])))

    print(f"root: {root}")
    print(f"team_root: {state_team}")
    print(f"framework_root: {framework_root(root)}")
    print(f"opencode_panes: {opencode_pane_count}")
    print(f"reachable_servers: {len(reachable)}")
    print(f"phase_3b_ready_servers: {[item.get('port') for item in ready_servers]}")
    print(f"fixed_workers_ready: {str(fixed_workers.get('fixed_workers_ready', False)).lower()}")
    print(f"visible_workers_registered: {len(visible_registry.get('workers', []))}")
    print(f"visible_workers_auto_submit_ready: {[worker.get('worker_id') for worker in visible_ready]}")
    print(f"ready_for_visible_submit_real: {str(bool(visible_ready)).lower()}")
    print(f"doc_evidence_ready: {str(doc_evidence_ready).lower()}")
    print(f"route_evidence_ready: {str(route_ready).lower()}")
    print(f"readiness_basis: {','.join(readiness_bases) if readiness_bases else 'not_confirmed'}")
    print(f"ready_for_phase_3B_submit_real: {str(fixed_workers.get('ready_for_phase_3B_submit_real', False)).lower()}")
    if errors:
        print("Errors:")
        for error in errors:
            print(f"  - {error}")
    else:
        print("Errors: none")
    if warnings:
        print("Warnings:")
        for warning in warnings:
            print(f"  - {warning}")
    else:
        print("Warnings: none")
    return 1 if errors else 0


def command_prepare(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    tdir = prepare_task(root, args.run, args.task, args.worker, args.port, args.title, args.body)
    print(f"prepared: {rel(tdir, root)}")
    print(f"prompt: {rel(tdir / 'prompt.txt', root)}")
    return 0


def command_submit_dry_run(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    tdir = task_dir(root, args.run, args.task)
    prompt = tdir / "prompt.txt"
    if not prompt.is_file():
        raise AdapterError(f"prompt not found: {rel(prompt, root)}")
    prompt_body = read_text(prompt)
    if not prompt_body.strip():
        raise AdapterError(f"prompt is empty: {rel(prompt, root)}")
    plan = dry_run_plan(root, args.run, args.task, args.worker, args.port)
    plan["prompt_bytes"] = len(prompt_body.encode("utf-8"))
    plan["generated_at"] = utc_now()
    write_json(tdir / "submit_dry_run.json", plan)
    print("OpenCode TUI submit dry-run")
    print(f"task: {rel(tdir, root)}")
    print(f"server: http://127.0.0.1:{args.port}")
    for item in plan["would_call_in_phase_3b"]:
        print(f"  - {item}")
    print("phase_3a_boundary: no POST requests were sent")
    return 0


def command_plan_submit(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    fixture_dir = Path(args.fixture).resolve() if args.fixture else None
    plan = build_opencode_tui_submit_plan(
        root,
        args.worker,
        backend=args.backend,
        fixture_dir=fixture_dir,
    )
    payload = plan.to_dict()
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print("OpenCode TUI submit plan")
        print(f"worker_id: {payload.get('worker_id') or '-'}")
        print(f"backend_name: {payload.get('backend_name') or '-'}")
        print(f"backend_type: {payload.get('backend_type') or '-'}")
        print(f"dispatch_allowed: {str(bool(payload.get('dispatch_allowed'))).lower()}")
        print(f"submit_supported: {str(bool(payload.get('submit_supported'))).lower()}")
        print(f"submit_endpoint_kind: {payload.get('submit_endpoint_kind') or '-'}")
        print(f"target_host: {payload.get('target_host') or '-'}")
        print(f"target_port: {payload.get('target_port') if payload.get('target_port') is not None else '-'}")
        print(f"target_pane: {payload.get('target_pane') or '-'}")
        for path in payload.get("required_api_paths", []):
            print(f"required_api_path: {path}")
        for action in payload.get("planned_actions", []):
            print(f"planned_action: {action}")
        if payload.get("blocked_reason"):
            print(f"blocked_reason: {payload.get('blocked_reason')}")
        for warning in payload.get("warnings", []):
            print(f"warning: {warning}")
        print("No POST was sent and no report/marker was written.")
    return 0 if payload.get("dispatch_allowed") and payload.get("submit_supported") else 1


def command_dry_run_submit_check(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    fixture_dir = Path(args.fixture).resolve() if args.fixture else None
    plan = build_opencode_tui_submit_plan(
        root,
        args.worker,
        backend=args.backend,
        fixture_dir=fixture_dir,
    )
    payload = plan.to_dict()
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print("OpenCode TUI dry-run submit check")
        print(f"worker_id: {payload.get('worker_id') or '-'}")
        print(f"backend_name: {payload.get('backend_name') or '-'}")
        print(f"backend_type: {payload.get('backend_type') or '-'}")
        print(f"dispatch_allowed: {str(bool(payload.get('dispatch_allowed'))).lower()}")
        print(f"submit_supported: {str(bool(payload.get('submit_supported'))).lower()}")
        print(f"target: {payload.get('target_host') or '-'}:{payload.get('target_port') or '-'} pane={payload.get('target_pane') or '-'}")
        print("No POST was sent and no report/marker was written.")
        if payload.get("blocked_reason"):
            print(f"blocked_reason: {payload.get('blocked_reason')}")
    return 0 if payload.get("dispatch_allowed") and payload.get("submit_supported") else 1


def command_submit_real(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    if not args.allow_real:
        raise AdapterError("submit-real requires --allow-real")
    raise AdapterError(
        "legacy submit-real is disabled; use submit-visible-real"
    )
    if not args.worker and args.port is None:
        raise AdapterError("submit-real requires explicit --worker or --port")
    ensure_state_team_clean(root)
    fw = ensure_framework(root)
    worker_record = fixed_registry_worker_by_id_or_port(root, args.worker, args.port)
    worker_id = str(worker_record.get("worker_id") or worker_record.get("worker") or args.worker or "")
    port = int(worker_record.get("port"))
    if args.port is not None and int(args.port) != port:
        raise AdapterError(f"requested port {args.port} does not match registry port {port}")

    probe = probe_port(port)
    if not probe.get("reachable") or not probe.get("global_health_available") or not probe.get("doc_available"):
        raise AdapterError(f"fixed worker {worker_id or port} is not live with /global/health and /doc on port {port}")
    methods = set(probe.get("detected_tui_methods", []))
    missing = [endpoint for endpoint in TUI_ENDPOINTS_ORDERED if endpoint not in methods]
    if missing:
        raise AdapterError(f"/doc on port {port} does not confirm required endpoint(s): {', '.join(missing)}")

    schema_data = endpoint_schema_for_port(root, port)
    if not schema_data.get("all_payloads_executable"):
        reasons = [
            f"{item.get('path')}: {item.get('reason')}"
            for item in schema_data.get("endpoints", [])
            if not item.get("executable")
        ]
        raise AdapterError("endpoint schema is not safely executable: " + "; ".join(reasons))

    tdir = task_dir(root, args.run, args.task)
    prompt_path = tdir / "prompt.txt"
    if not prompt_path.is_file():
        raise AdapterError(f"prompt not found: {rel(prompt_path, root)}")
    prompt_body = read_text(prompt_path)
    if not prompt_body.strip():
        raise AdapterError(f"prompt is empty: {rel(prompt_path, root)}")
    submitted_path = tdir / ".submitted"
    if submitted_path.exists():
        raise AdapterError(f"task already has .submitted marker: {rel(submitted_path, root)}")

    payloads = prompt_payloads_from_schema(schema_data, prompt_body)
    prompt_sha256 = hashlib.sha256(prompt_body.encode("utf-8")).hexdigest()
    attempt = {
        "schema_version": 1,
        "attempted_at": utc_now(),
        "mode": "real",
        "run": args.run,
        "task": args.task,
        "worker": worker_id,
        "port": port,
        "base_url": f"http://127.0.0.1:{port}",
        "prompt_path": rel(prompt_path, root),
        "prompt_sha256": prompt_sha256,
        "prompt_bytes": len(prompt_body.encode("utf-8")),
        "allowed_post_paths": list(TUI_ENDPOINTS_ORDERED),
        "schema_path": rel(fw / f"opencode_tui_endpoint_schema_{port}.json", root),
        "adapter_writes_only": [".submitted", "delivery.json", "delivery_attempt.json", "events.jsonl"],
        "adapter_never_writes": [".received", ".started", ".heartbeat", ".done", ".fail", ".blocked"],
    }
    write_json(tdir / "delivery_attempt.json", attempt)

    responses: dict[str, Any] = {}
    success = False
    try:
        for endpoint in TUI_ENDPOINTS_ORDERED:
            payload = payloads[endpoint]
            response = safe_http_json_post("127.0.0.1", port, endpoint, payload)
            responses[endpoint] = response
            if not response.get("ok"):
                error_doc = {
                    **attempt,
                    "failed_at": utc_now(),
                    "failed_endpoint": endpoint,
                    "responses": responses,
                    "submitted_written": False,
                }
                write_json(tdir / "delivery_error.json", error_doc)
                print(f"submit-real failed at {endpoint}: status={response.get('status')} error={response.get('error', '')}", file=sys.stderr)
                return 1
        success = True
    finally:
        if not success:
            pass

    write_marker(submitted_path)
    delivery = {
        **attempt,
        "submitted_at": utc_now(),
        "responses": responses,
        "submitted_marker": rel(submitted_path, root),
        "received_written_by_adapter": False,
        "received": False,
        "state_note": "submitted is not received; wait for worker/plugin to write .received",
    }
    write_json(tdir / "delivery.json", delivery)
    append_event(tdir / "events.jsonl", {
        "ts": delivery["submitted_at"],
        "event": "submitted",
        "source": "omx_opencode_tui_adapter",
        "worker": worker_id,
        "port": port,
        "prompt_sha256": prompt_sha256,
    })
    print("OpenCode TUI submit-real completed")
    print(f"task: {rel(tdir, root)}")
    print(f"worker: {worker_id}")
    print(f"port: {port}")
    print(f"clear status: {responses['/tui/clear-prompt'].get('status')}")
    print(f"append status: {responses['/tui/append-prompt'].get('status')}")
    print(f"submit status: {responses['/tui/submit-prompt'].get('status')}")
    print(f"submitted marker: {rel(submitted_path, root)}")
    print("received: false unless the worker later writes .received")
    return 0


def command_endpoint_schema(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    data = endpoint_schema_for_port(root, args.port)
    print(f"endpoint_schema: {rel(framework_root(root) / f'opencode_tui_endpoint_schema_{args.port}.json', root)}")
    print(f"endpoint_schema_aggregate: {rel(framework_root(root) / 'opencode_tui_endpoint_schema.json', root)}")
    print(f"port: {args.port}")
    print(f"all_required_endpoints_present: {str(data.get('all_required_endpoints_present', False)).lower()}")
    print(f"all_payloads_executable: {str(data.get('all_payloads_executable', False)).lower()}")
    for item in data.get("endpoints", []):
        print(
            f"  {item.get('path')}: operationId={item.get('operationId') or '-'} "
            f"body_required={str(item.get('requestBody_required', False)).lower()} "
            f"required_fields={item.get('required_fields', [])} "
            f"text_field={item.get('text_field') or '-'} "
            f"executable={str(item.get('executable', False)).lower()}"
        )
    return 0


def command_wait_marker(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    tdir = task_dir(root, args.run, args.task)
    target = marker_path(tdir, args.marker)
    deadline = time.time() + max(0, int(args.timeout))
    while time.time() <= deadline:
        if target.exists():
            print(f"marker_present: {rel(target, root)}")
            return 0
        time.sleep(1)
    print(f"marker_absent: {rel(target, root)}")
    return 1


def expected_launch_registration_fence(
    args: argparse.Namespace,
) -> dict[str, Any]:
    attempt_id = str(
        getattr(args, "expected_launch_attempt_id", "") or ""
    )
    if not attempt_id:
        return {}
    if not re.fullmatch(r"[0-9a-f]{32}", attempt_id):
        raise AdapterError("expected launch fence attempt id is invalid")
    fence = {
        "launch_attempt_id": attempt_id,
        "runtime_substrate": str(
            getattr(
                args,
                "expected_runtime_substrate",
                "auto",
            )
            or "auto"
        ),
        "pane_id": str(args.pane),
        "pane_pid": int(getattr(args, "expected_pane_pid", 0)),
        "pane_start_time_ticks": int(
            getattr(args, "expected_pane_start_time_ticks", 0)
        ),
        "opencode_pid": int(
            getattr(args, "expected_opencode_pid", 0)
        ),
        "opencode_start_time_ticks": int(
            getattr(
                args,
                "expected_opencode_start_time_ticks",
                0,
            )
        ),
        "host_boot_id": str(
            getattr(args, "expected_host_boot_id", "") or ""
        ),
        "tmux_server_pid": int(
            getattr(args, "expected_tmux_server_pid", 0)
        ),
        "tmux_session": str(
            getattr(args, "expected_tmux_session", "") or ""
        ),
        "tmux_window": str(
            getattr(args, "expected_tmux_window", "") or ""
        ),
        "port": int(args.port),
    }
    if any(
        fence[field] <= 0
        for field in (
            "pane_pid",
            "pane_start_time_ticks",
            "opencode_pid",
            "opencode_start_time_ticks",
            "port",
        )
    ) or any(
        not fence[field]
        for field in (
            "pane_id",
            "host_boot_id",
            "tmux_session",
            "tmux_window",
        )
    ) or (
        fence["runtime_substrate"] == "tmux"
        and fence["tmux_server_pid"] <= 0
    ) or (
        fence["runtime_substrate"] == "rmux"
        and fence["tmux_server_pid"] != 0
    ) or fence["runtime_substrate"] not in {"tmux", "rmux"}:
        raise AdapterError("expected launch fence is incomplete")
    return fence


def require_expected_launch_registration_fence(
    binding: dict[str, Any],
    expected: dict[str, Any],
) -> None:
    if not expected:
        return
    actual = {
        field: binding.get(field)
        for field in (
            "runtime_substrate",
            "pane_id",
            "pane_pid",
            "pane_start_time_ticks",
            "opencode_pid",
            "opencode_start_time_ticks",
            "host_boot_id",
            "tmux_server_pid",
            "tmux_session",
            "tmux_window",
            "port",
        )
    }
    actual["launch_attempt_id"] = str(
        binding.get("process_environment_projection", {}).get(
            "OMX_LAUNCH_ATTEMPT_ID"
        )
        or ""
    )
    mismatches = [
        field
        for field, value in expected.items()
        if actual.get(field) != value
    ]
    expected_pid = expected["opencode_pid"]
    if binding.get("opencode_pids") != [expected_pid]:
        mismatches.append("opencode_pids")
    if binding.get("listener_pids") != [expected_pid]:
        mismatches.append("listener_pids")
    if (
        binding.get("binding_confidence") != "strong"
        or mismatches
    ):
        detail = ", ".join(mismatches) or "binding_confidence"
        raise AdapterError(
            "expected launch fence no longer matches: "
            + detail
        )


def command_register_visible(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    ensure_state_team_clean(root)
    safe_slug(args.worker, "worker")
    host = "127.0.0.1" if args.host == "localhost" else args.host
    try:
        enforce_worker_alias_port(args.worker, int(args.port))
    except AdapterError as exc:
        write_visible_binding_audit(
            root,
            args.worker,
            action="register-visible",
            result="rejected",
            reason=str(exc),
            new_record={
                "worker_id": args.worker,
                "pane_id": args.pane,
                "host": host,
                "port": int(args.port),
                "backend": args.backend,
            },
        )
        raise
    expected_launch_fence = expected_launch_registration_fence(
        args
    )
    requested_substrate = str(
        getattr(args, "expected_runtime_substrate", "auto")
        or "auto"
    )
    registration_substrate = (
        "" if requested_substrate == "auto" else requested_substrate
    )
    with launch_serialization_lock(root, shared=True):
        with global_mutation_gate(root, exclusive=False):
            binding = verify_visible_binding(
                root,
                args.worker,
                args.pane,
                host,
                args.port,
                args.backend,
                runtime_substrate=registration_substrate,
            )
            require_expected_launch_registration_fence(
                binding,
                expected_launch_fence,
            )
            launch_record = visible_launch_record(root, args.worker)
            expected_attempt_id = str(
                expected_launch_fence.get("launch_attempt_id") or ""
            )
            launch_attempt_id = str(
                launch_record.get("launch_attempt_id") or ""
            )
            if launch_attempt_id:
                if not expected_attempt_id:
                    raise AdapterError(
                        "expected launch fence is required for nonce-backed launch"
                    )
                if launch_attempt_id != expected_attempt_id:
                    raise AdapterError(
                        "expected launch fence does not match nonce-backed launch"
                    )
            confidence = str(binding.get("binding_confidence", "failed"))
            if confidence == "failed":
                raise AdapterError("; ".join(binding.get("errors", [])) or "visible binding failed")
            if args.allow_auto_submit and confidence != "strong" and not args.allow_weak_binding:
                raise AdapterError("visible binding is weak; auto-submit is refused unless --allow-weak-binding is explicitly used")

            record = {
                "schema_version": 1,
                "worker_id": args.worker,
                "backend": args.backend,
                "pane_id": args.pane,
                "pane_pid": binding.get("pane_pid"),
                "pane_start_time_ticks": binding.get("pane_start_time_ticks", 0),
                "opencode_pids": binding.get("opencode_pids", []),
                "opencode_pid": binding.get("opencode_pid", 0),
                "opencode_start_time_ticks": binding.get("opencode_start_time_ticks", 0),
                "host_boot_id": binding.get("host_boot_id", ""),
                "tmux_server_pid": binding.get("tmux_server_pid", 0),
                "host": host,
                "port": int(args.port),
                "base_url": f"http://{host}:{int(args.port)}",
                "tmux_session": binding.get("tmux_session", ""),
                "tmux_window": binding.get("tmux_window", ""),
                "tmux_pane_index": binding.get("tmux_pane_index", ""),
                "pane_title": binding.get("pane_title", ""),
                "project": str(launch_record.get("project", root)) if launch_record else str(root),
                "registered_at": utc_now(),
                "last_verified_at": binding.get("verified_at"),
                "user_visible": True,
                "user_started": bool(args.user_started),
                "allow_auto_submit": bool(args.allow_auto_submit and (confidence == "strong" or args.allow_weak_binding)),
                "allow_weak_binding": bool(args.allow_weak_binding),
                "binding_confidence": confidence,
                "launch_owned": bool(launch_record.get("launch_owned", False)) if launch_record else False,
                "launch_attempt_id": str(
                    expected_launch_fence.get("launch_attempt_id") or ""
                ),
                "port_was_free_before_launch": bool(launch_record.get("port_was_free_before_launch", False)) if launch_record else False,
                "default_for_new_tasks": bool(args.default_for_new_tasks),
                "status": args.status,
                "server_live": binding.get("server_live", False),
                "doc_available": binding.get("doc_available", False),
                "detected_tui_methods": binding.get("detected_tui_methods", []),
                "opencode_cmdline_contains_port": binding.get("opencode_cmdline_contains_port", False),
                "listener_pids": binding.get("listener_pids", []),
                "strong_pid_matches": binding.get("strong_pid_matches", []),
                "launch_owned_match": binding.get("launch_owned_match", False),
                "warnings": binding.get("warnings", []),
                "errors": binding.get("errors", []),
                "notes": [
                    "Registered visible worker. No tmux input was sent.",
                    "Auto submit requires binding_confidence=strong unless --allow-weak-binding was explicitly used.",
                ],
            }
            rejected: dict[str, Any] = {}
            mutation_context: dict[str, Any] = {}
            registry_snapshot = read_visible_registry(root)
            cross_boot_liveness_probes = revalidated_cross_boot_alias_probes(
                list(registry_snapshot.get("workers", [])),
                record,
            )

            def register_mutation(registry: dict[str, Any]) -> dict[str, Any]:
                existing_record = visible_worker_record_from_registry(registry, args.worker)
                existing_attempt_id = str(
                    (existing_record or {}).get("launch_attempt_id") or ""
                )
                if existing_attempt_id:
                    if not expected_attempt_id:
                        raise AdapterError(
                            "expected launch fence is required for nonce-backed binding"
                        )
                    if existing_attempt_id != expected_attempt_id:
                        raise AdapterError(
                            "expected launch fence does not match nonce-backed binding"
                        )
                if expected_launch_fence:
                    revalidate_registration_instance(
                        root,
                        args.pane,
                        int(args.port),
                        expected_launch_fence,
                        runtime_substrate=registration_substrate,
                    )
                next_record = {**(existing_record or {}), **record}
                if existing_record and not bool(binding.get("launch_owned_match")):
                    for field in ("project",):
                        if field in existing_record:
                            next_record[field] = existing_record[field]
                if existing_record:
                    try:
                        next_record["binding_generation"] = int(existing_record.get("binding_generation") or 1)
                    except (TypeError, ValueError):
                        next_record["binding_generation"] = 1
                else:
                    next_record["binding_generation"] = 1
                next_record["fencing_generation"] = (
                    int(existing_record.get("fencing_generation") or next_record["binding_generation"])
                    if existing_record
                    else next_record["binding_generation"]
                )
                next_record["alias"] = str((existing_record or {}).get("alias") or args.worker)
                next_record["alias_scope"] = str((existing_record or {}).get("alias_scope") or "global")
                next_record["instance_id"] = str(
                    (existing_record or {}).get("instance_id") or visible_instance_id(next_record, binding)
                )
                next_record["lease_id"] = str((existing_record or {}).get("lease_id") or "")
                next_record["lease_owner"] = str((existing_record or {}).get("lease_owner") or "")
                next_record["lease_status"] = str((existing_record or {}).get("lease_status") or "unmanaged")
                occupancy_reasons, occupancy_integrity = (
                    registration_target_occupancy_conflicts(
                        root,
                        args.worker,
                        next_record,
                        registry,
                    )
                )
                if occupancy_reasons:
                    rejected.update(
                        {
                            "reason": (
                                "target instance occupancy conflict: "
                                + "; ".join(occupancy_reasons)
                            ),
                            "cas_result": (
                                "owner_lock_integrity"
                                if occupancy_integrity
                                else "target_owner_lock_conflict"
                            ),
                            "old_record": dict(existing_record or {}),
                            "new_record": next_record,
                        }
                    )
                    raise AdapterError(str(rejected["reason"]))
                conflicts = visible_worker_binding_conflicts(existing_record, next_record) if existing_record else []
                if conflicts:
                    rejected.update(
                        {
                            "reason": "visible worker binding conflict: " + "; ".join(conflicts),
                            "cas_result": "binding_conflict",
                            "old_record": dict(existing_record),
                            "new_record": next_record,
                        }
                    )
                    raise AdapterError(str(rejected["reason"]))
                ignored_cross_boot_aliases: list[str] = []
                ignored_cross_tmux_server_aliases: list[str] = []
                alias_candidates: list[Any] = []
                for item in registry.get("workers", []):
                    if not isinstance(item, dict):
                        alias_candidates.append(item)
                        continue
                    probe = cross_boot_liveness_probes.get(
                        str(item.get("worker_id") or "")
                    )
                    if probe and cross_boot_alias_probe_matches(item, probe):
                        # ponytail: this read-only probe is a point-in-time fence; use
                        # a versioned transport receipt if concurrent port reuse matters.
                        alias_candidates.append(
                            {**item, "server_live": False, "doc_available": False}
                        )
                        continue
                    alias_candidates.append(item)
                alias_conflicts = visible_binding_alias_conflicts(
                    alias_candidates,
                    next_record,
                    ignore_worker_id=args.worker,
                    ignore_inactive_stale_aliases=True,
                    ignore_cross_boot_pane_reuse=True,
                    ignored_cross_boot_aliases=ignored_cross_boot_aliases,
                    ignore_cross_tmux_server_pane_reuse=True,
                    ignored_cross_tmux_server_aliases=(
                        ignored_cross_tmux_server_aliases
                    ),
                )
                if alias_conflicts:
                    rejected.update(
                        {
                            "reason": (
                                "physical binding alias conflict: "
                                + "; ".join(alias_conflicts)
                            ),
                            "cas_result": "binding_alias_conflict",
                            "old_record": dict(existing_record or {}),
                            "new_record": next_record,
                        }
                    )
                    raise AdapterError(str(rejected["reason"]))
                normalized_cross_boot_aliases = set(ignored_cross_boot_aliases)
                normalized_cross_tmux_server_aliases = set(
                    ignored_cross_tmux_server_aliases
                )
                normalized_aliases = (
                    normalized_cross_boot_aliases
                    | normalized_cross_tmux_server_aliases
                )
                if normalized_aliases:
                    stale_disabled_at = utc_now()
                    for item in registry.get("workers", []):
                        worker_id = (
                            str(item.get("worker_id") or "")
                            if isinstance(item, dict)
                            else ""
                        )
                        if (
                            isinstance(item, dict)
                            and worker_id in normalized_aliases
                        ):
                            update = {
                                "allow_auto_submit": False,
                                "default_for_new_tasks": False,
                                "status": "stale_binding_disabled",
                                "stale_binding_disabled_at": stale_disabled_at,
                                "stale_binding_disabled_reason": (
                                    "cross_boot_pane_id_reused"
                                    if worker_id in normalized_cross_boot_aliases
                                    else "tmux_server_pane_id_reused"
                                ),
                            }
                            probe = cross_boot_liveness_probes.get(worker_id)
                            if probe and cross_boot_alias_probe_matches(item, probe):
                                update.update(
                                    {
                                        "server_live": False,
                                        "doc_available": False,
                                        "stale_binding_liveness_checked_at": (
                                            probe["checked_at"]
                                        ),
                                        "stale_binding_liveness_probe_port": (
                                            probe["port"]
                                        ),
                                        "stale_binding_liveness_probe_reachable": (
                                            bool(probe.get("reachable"))
                                        ),
                                        "stale_binding_liveness_probe_timed_out": (
                                            False
                                        ),
                                        "stale_binding_liveness_ownership_evidence": (
                                            probe.get("ownership_evidence") or {}
                                        ),
                                    }
                                )
                            item.update(update)
                apply_binding_lease(
                    next_record,
                    existing=existing_record,
                    action="register-visible",
                    new_lease=existing_record is None,
                )
                demoted_default_worker_ids: list[str] = []
                if next_record["default_for_new_tasks"]:
                    for item in registry.get("workers", []):
                        if not isinstance(item, dict):
                            continue
                        item_worker_id = str(item.get("worker_id") or "")
                        if item_worker_id == args.worker:
                            continue
                        if bool(item.get("default_for_new_tasks")):
                            item["default_for_new_tasks"] = False
                            if item_worker_id:
                                demoted_default_worker_ids.append(item_worker_id)
                transaction_id = binding_token(args.worker, "register-visible")
                next_record["binding_transaction_id"] = transaction_id
                next_record["binding_transaction_state"] = "committed"
                mutation_context.update(
                    {
                        "old_record": dict(existing_record or {}),
                        "new_record": next_record,
                        "transaction_id": transaction_id,
                        "demoted_default_worker_ids": sorted(
                            demoted_default_worker_ids
                        ),
                            "ignored_cross_boot_aliases": sorted(
                                normalized_cross_boot_aliases
                            ),
                            "ignored_cross_tmux_server_aliases": sorted(
                                normalized_cross_tmux_server_aliases
                            ),
                            "revalidated_cross_boot_aliases": sorted(
                                worker_id
                                for worker_id in normalized_cross_boot_aliases
                                if worker_id in cross_boot_liveness_probes
                            ),
                    }
                )
                registry = registry_with_visible_worker(root, registry, next_record)
                return normalize_visible_registry(
                    registry,
                    controller_id=str(binding.get("tmux_session") or ""),
                    observed_at=str(binding.get("verified_at") or utc_now()),
                )

            global_lock_snapshot: list[str] = []
            try:
                current_launch = visible_launch_record(root, args.worker)
                current_launch_attempt = str(
                    current_launch.get("launch_attempt_id") or ""
                )
                if expected_attempt_id:
                    if current_launch_attempt != expected_attempt_id:
                        raise AdapterError(
                            "launch attempt changed before registry commit"
                        )
                elif current_launch_attempt:
                    raise AdapterError(
                        "expected launch fence is required for nonce-backed launch"
                    )
                mutation = mutate_visible_registry(
                    visible_registry_path(root),
                    register_mutation,
                    default_payload=default_visible_registry(root),
                )
            except AdapterError as exc:
                if rejected:
                    write_visible_binding_audit(
                        root,
                        args.worker,
                        action="register-visible",
                        result="rejected",
                        reason=str(rejected["reason"]),
                        cas_result=str(rejected.get("cas_result") or "rejected"),
                        old_record=rejected["old_record"],
                        new_record=rejected["new_record"],
                        global_owner_lock_snapshot=global_lock_snapshot,
                        global_mutation_gate_result="passed_shared_mutation_gate",
                    )
                    raise AdapterError(
                        f"{rejected['reason']}; use sanctioned rebind to replace an existing visible worker binding"
                    ) from exc
                raise
    record = visible_worker_record_from_registry(mutation["after"], args.worker) or record
    sidecar = {
        **binding,
        "schema_version": 1,
        "worker_id": args.worker,
        "host": str(record.get("host") or host),
        "port": record.get("port"),
        "pane_id": str(record.get("pane_id") or ""),
        "pane_pid": record.get("pane_pid"),
        "binding_generation": binding_generation(record),
        "fencing_generation": int(
            record.get("fencing_generation")
            or binding_generation(record)
            or 0
        ),
        "binding_lease_id": str(record.get("binding_lease_id") or ""),
        "binding_expires_at": str(record.get("binding_expires_at") or ""),
        "transaction_id": str(record.get("binding_transaction_id") or ""),
        "transaction_state": "committed",
        "registered_binding": record,
        "canonical_registry": rel(visible_registry_path(root), root),
    }
    write_json_atomic(
        framework_root(root) / f"opencode_visible_binding_{args.worker}.json",
        sidecar,
    )
    demoted_defaults = mutation_context.get(
        "demoted_default_worker_ids",
        [],
    )
    audit_reason = (
        "visible worker binding registered under the registry mutation fence"
    )
    if demoted_defaults:
        audit_reason += "; demoted previous defaults: " + ", ".join(
            demoted_defaults
        )
    normalized_cross_boot_aliases = mutation_context.get(
        "ignored_cross_boot_aliases",
        [],
    )
    if normalized_cross_boot_aliases:
        audit_reason += "; normalized cross-boot pane aliases: " + ", ".join(
            normalized_cross_boot_aliases
        )
    revalidated_cross_boot_aliases = mutation_context.get(
        "revalidated_cross_boot_aliases",
        [],
    )
    if revalidated_cross_boot_aliases:
        audit_reason += (
            "; revalidated unreachable cross-boot ports: "
            + ", ".join(revalidated_cross_boot_aliases)
        )
    normalized_cross_tmux_server_aliases = mutation_context.get(
        "ignored_cross_tmux_server_aliases",
        [],
    )
    if normalized_cross_tmux_server_aliases:
        audit_reason += (
            "; normalized tmux-server pane aliases: "
            + ", ".join(normalized_cross_tmux_server_aliases)
        )
    audit_path = write_visible_binding_audit(
        root,
        args.worker,
        action="register-visible",
        result="applied",
        reason=audit_reason,
        cas_result=(
            "idempotent_refresh"
            if mutation_context.get("old_record")
            else "new_binding"
        ),
        old_record=mutation_context.get("old_record", {}),
        new_record=record,
        transaction_id=str(record.get("binding_transaction_id") or ""),
        global_owner_lock_snapshot=global_lock_snapshot,
        global_mutation_gate_result="passed_shared_mutation_gate",
    )
    print(f"registered_visible: {args.worker}")
    print(f"registry: {rel(visible_registry_path(root), root)}")
    print(f"binding_audit: {rel(audit_path, root)}")
    print(f"pane: {args.pane}")
    print(f"port: {int(args.port)}")
    print(f"binding_confidence: {confidence}")
    print(f"allow_auto_submit: {str(record['allow_auto_submit']).lower()}")
    print(f"user_started: {str(record['user_started']).lower()}")
    print(f"default_for_new_tasks: {str(record['default_for_new_tasks']).lower()}")
    print(
        "demoted_default_workers: "
        + (", ".join(demoted_defaults) if demoted_defaults else "-")
    )
    if binding.get("warnings"):
        print("Warnings:")
        for warning in binding.get("warnings", []):
            print(f"  - {warning}")
    return 0


def command_list_visible(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    registry = read_visible_registry(root)
    print(f"registry: {rel(visible_registry_path(root), root)}")
    workers = registry.get("workers", [])
    if not workers:
        print("visible_workers: none")
        return 0
    print("WORKER  PANE   PORT  AUTO  BINDING  SERVER  DOC  TITLE")
    for worker in workers:
        if not isinstance(worker, dict):
            continue
        print(
            f"{str(worker.get('worker_id', '-')):<7} "
            f"{str(worker.get('pane_id', '-')):<6} "
            f"{str(worker.get('port', '-')):<5} "
            f"{str(bool(worker.get('allow_auto_submit'))).lower():<5} "
            f"{str(worker.get('binding_confidence', '-')):<8} "
            f"{str(bool(worker.get('server_live'))).lower():<7} "
            f"{str(bool(worker.get('doc_available'))).lower():<4} "
            f"{worker.get('pane_title', '')}"
        )
    return 0


def command_lease_visible(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    ensure_state_team_clean(root)
    action = str(args.action)
    now = str(args.now or utc_now())
    result: dict[str, Any] = {}

    def mutate_lease(registry: dict[str, Any]) -> dict[str, Any]:
        nonlocal result
        registry = normalize_visible_registry(
            registry,
            controller_id=str(args.controller_id or ""),
            observed_at=now,
        )
        common = {
            "scope_id": str(args.scope_id),
            "alias": str(args.alias),
        }
        if action == "claim":
            result = claim_visible_binding(
                registry,
                **common,
                owner_controller_id=str(args.owner_controller_id),
                lease_id=str(args.lease_id),
                now=now,
                expires_at=str(args.expires_at),
            )
        elif action == "renew":
            result = renew_visible_binding(
                registry,
                **common,
                owner_controller_id=str(args.owner_controller_id),
                lease_id=str(args.lease_id),
                now=now,
                expires_at=str(args.expires_at),
            )
        elif action == "release":
            result = release_visible_binding(
                registry,
                **common,
                owner_controller_id=str(args.owner_controller_id),
                lease_id=str(args.lease_id),
                now=now,
                reason=str(args.reason),
            )
        else:
            result = reconcile_visible_binding_lease(
                registry,
                **common,
                now=now,
                worker_health=str(args.worker_health),
            )
        return prepare_visible_registry(root, registry)

    mutation = mutate_visible_registry(
        visible_registry_path(root),
        mutate_lease,
        default_payload=default_visible_registry(root),
    )
    payload = {
        "schema_version": 1,
        "action": action,
        "changed": bool(mutation.get("changed")),
        "binding": dict(result),
        "pre_hash": str(mutation.get("pre_hash") or ""),
        "post_hash": str(mutation.get("post_hash") or ""),
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(f"visible_lease_{action}: {args.scope_id}:{args.alias}")
        print(f"lease_status: {result.get('lease_status') or '-'}")
        print(f"lease_owner: {result.get('lease_owner') or '-'}")
        print(f"lease_id: {result.get('lease_id') or '-'}")
    return 0


def command_verify_visible(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    record = require_visible_worker(root, args.worker)
    binding = runtime_binding_for_visible_worker(root, args.worker, "tmux-reference")
    verification_updates = {
        "last_verified_at": binding.get("verified_at"),
        "pane_pid": binding.get("pane_pid"),
        "opencode_pids": binding.get("opencode_pids", []),
        "tmux_session": binding.get("tmux_session", ""),
        "tmux_window": binding.get("tmux_window", ""),
        "tmux_pane_index": binding.get("tmux_pane_index", ""),
        "pane_title": binding.get("pane_title", ""),
        "binding_confidence": binding.get("binding_confidence"),
        "server_live": binding.get("server_live"),
        "doc_available": binding.get("doc_available"),
        "detected_tui_methods": binding.get("detected_tui_methods", []),
        "opencode_cmdline_contains_port": binding.get("opencode_cmdline_contains_port", False),
        "listener_pids": binding.get("listener_pids", []),
        "strong_pid_matches": binding.get("strong_pid_matches", []),
        "launch_owned_match": binding.get("launch_owned_match", False),
        "warnings": binding.get("warnings", []),
        "errors": binding.get("errors", []),
    }
    updated = dict(record)
    updated.update(verification_updates)
    if args.update_registry:
        if binding.get("binding_confidence") != "strong":
            raise AdapterError("same-instance verification requires a strong live binding")
        for field in (
            "host_boot_id", "tmux_server_pid", "pane_start_time_ticks",
            "opencode_pid", "opencode_start_time_ticks", "opencode_pids",
        ):
            if record.get(field) and record[field] != binding.get(field):
                raise AdapterError(f"same-instance verification identity changed: {field}")
        if binding.get("instance_id") and binding["instance_id"] != visible_instance_id(record):
            raise AdapterError("same-instance verification identity changed: instance_id")
        transaction_id = binding_token(args.worker, "verify-visible")
        mutation_context: dict[str, Any] = {}
        rejected: dict[str, Any] = {}

        def verify_mutation(registry: dict[str, Any]) -> dict[str, Any]:
            current = visible_worker_record_from_registry(registry, args.worker)
            if not current:
                rejected.update(
                    {
                        "reason": (
                            f"visible worker {args.worker!r} disappeared during verification"
                        ),
                        "current": {},
                    }
                )
                raise AdapterError(str(rejected["reason"]))
            if not visible_worker_binding_fence_matches(record, current) or any(
                record.get(field) != current.get(field)
                for field in (
                    "instance_id", "fencing_generation", "host_boot_id",
                    "tmux_server_pid", "pane_start_time_ticks", "opencode_pid",
                    "opencode_start_time_ticks", "opencode_pids",
                )
            ):
                rejected.update(
                    {
                        "reason": (
                            f"visible worker {args.worker!r} binding changed during verification"
                        ),
                        "current": dict(current),
                    }
                )
                raise AdapterError(
                    str(rejected["reason"])
                )
            next_record = dict(current)
            for field, value in verification_updates.items():
                if field in {
                    "pane_pid",
                    "opencode_pids",
                    "tmux_session",
                    "tmux_window",
                    "tmux_pane_index",
                } and (value is None or value == "" or value == ()):
                    continue
                if field == "opencode_pids" and value == []:
                    continue
                next_record[field] = value
            conflicts = visible_worker_binding_conflicts(current, next_record)
            if conflicts:
                rejected.update(
                    {
                        "reason": (
                            "verification observed a different binding identity: "
                            + "; ".join(conflicts)
                        ),
                        "current": dict(current),
                        "incoming": next_record,
                    }
                )
                raise AdapterError(str(rejected["reason"]))
            apply_binding_lease(
                next_record,
                existing=current,
                action="verify-visible",
                new_lease=False,
            )
            next_record["binding_transaction_id"] = transaction_id
            next_record["binding_transaction_state"] = "committed"
            mutation_context.update(
                {
                    "old_record": dict(current),
                    "new_record": next_record,
                }
            )
            return registry_with_visible_worker(root, registry, next_record)

        try:
            mutation = mutate_visible_registry(
                visible_registry_path(root),
                verify_mutation,
            )
        except AdapterError:
            write_visible_binding_audit(
                root,
                args.worker,
                action="verify-visible",
                result="rejected",
                reason=str(rejected.get("reason") or "verification CAS rejected"),
                cas_result="stale_generation",
                old_record=record,
                new_record=rejected.get("current", {}),
                transaction_id=transaction_id,
            )
            raise
        updated = visible_worker_record_from_registry(mutation["after"], args.worker) or updated
        sidecar = {
            **binding,
            "schema_version": 1,
            "worker_id": args.worker,
            "host": str(updated.get("host") or "127.0.0.1"),
            "port": updated.get("port"),
            "pane_id": str(updated.get("pane_id") or ""),
            "pane_pid": updated.get("pane_pid"),
            "binding_generation": binding_generation(updated),
            "fencing_generation": int(
                updated.get("fencing_generation")
                or binding_generation(updated)
                or 0
            ),
            "binding_lease_id": str(updated.get("binding_lease_id") or ""),
            "binding_expires_at": str(updated.get("binding_expires_at") or ""),
            "transaction_id": transaction_id,
            "transaction_state": "committed",
            "registered_binding": updated,
            "canonical_registry": rel(visible_registry_path(root), root),
        }
        write_json_atomic(
            framework_root(root) / f"opencode_visible_binding_{args.worker}.json",
            sidecar,
        )
        write_visible_binding_audit(
            root,
            args.worker,
            action="verify-visible",
            result="applied",
            reason="visible worker verification persisted under the registry mutation fence",
            cas_result="generation_matched",
            old_record=mutation_context.get("old_record", record),
            new_record=updated,
            transaction_id=transaction_id,
        )
    confidence = str(binding.get("binding_confidence", "failed"))
    print(f"visible_worker: {args.worker}")
    print(f"pane: {record.get('pane_id')}")
    print(f"port: {record.get('port')}")
    print(f"binding_confidence: {confidence}")
    print(f"server_live: {str(bool(binding.get('server_live'))).lower()}")
    print(f"doc_available: {str(bool(binding.get('doc_available'))).lower()}")
    print(f"opencode_cmdline_contains_port: {str(bool(binding.get('opencode_cmdline_contains_port'))).lower()}")
    print(f"launch_owned_match: {str(bool(binding.get('launch_owned_match'))).lower()}")
    print(f"allow_auto_submit: {str(bool(updated.get('allow_auto_submit'))).lower()}")
    print(f"registry_updated: {str(bool(args.update_registry)).lower()}")
    if binding.get("warnings"):
        print("Warnings:")
        for warning in binding.get("warnings", []):
            print(f"  - {warning}")
    if binding.get("errors"):
        print("Errors:")
        for error in binding.get("errors", []):
            print(f"  - {error}")
    return 0 if confidence == "strong" else 1


def command_unregister_visible(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    raw_stop_fence = str(
        getattr(args, "expected_stop_fence_json", "") or ""
    ).strip()
    expected = (
        parse_visible_worker_stop_fence(raw_stop_fence, args.worker)
        if raw_stop_fence
        else visible_worker_record(root, args.worker)
    )
    counts: dict[str, int] = {}
    mutation_context: dict[str, Any] = {}
    rejected: dict[str, Any] = {}
    transaction_id = binding_token(args.worker, "unregister-visible")

    def unregister_mutation(registry: dict[str, Any]) -> dict[str, Any]:
        registry = normalize_visible_registry(registry)
        workers = registry.get("workers", [])
        if not isinstance(workers, list):
            workers = []
        current = visible_worker_record_from_registry(registry, args.worker)
        if current is not None and (
            expected is None
            or (
                raw_stop_fence
                and not visible_worker_stop_fence_matches(
                    expected,
                    current,
                    args.worker,
                )
            )
            or (
                not raw_stop_fence
                and not visible_worker_binding_fence_matches(
                    expected,
                    current,
                )
            )
        ):
            rejected.update(
                {
                    "reason": (
                        f"visible worker {args.worker} binding changed before unregister"
                    ),
                    "current": dict(current),
                }
            )
            raise AdapterError(str(rejected["reason"]))
        removed_instance_ids = {
            str(worker.get("instance_id") or "")
            for worker in workers
            if isinstance(worker, dict)
            and str(worker.get("worker_id", "")) == args.worker
            and str(worker.get("instance_id") or "")
        }
        counts["before"] = len(workers)
        registry["workers"] = [
            worker
            for worker in workers
            if not (isinstance(worker, dict) and str(worker.get("worker_id", "")) == args.worker)
        ]
        registry["bindings"] = [
            binding
            for binding in registry.get("bindings", [])
            if not (
                isinstance(binding, dict)
                and str(binding.get("instance_id") or "") in removed_instance_ids
            )
        ]
        counts["after"] = len(registry["workers"])
        mutation_context["old_record"] = dict(current or {})
        return prepare_visible_registry(root, registry)

    global_lock_snapshot: list[str] = []
    blocking_owner_lock_snapshot: list[str] = []
    try:
        with global_mutation_gate(root, exclusive=True):
            global_lock_snapshot = global_owner_lock_names(root)
            blocking_owner_lock_snapshot = (
                [
                    lock_name
                    for lock_name in global_lock_snapshot
                    if lock_name == f"{args.worker}.lock.json"
                ]
                if raw_stop_fence
                else global_lock_snapshot
            )
            if blocking_owner_lock_snapshot:
                if raw_stop_fence:
                    raise AdapterError(
                        "target owner lock present; refusing visible worker "
                        "unregistration: "
                        + ", ".join(blocking_owner_lock_snapshot)
                    )
                raise AdapterError(
                    "global owner lock present; refusing visible worker "
                    "unregistration: "
                    + ", ".join(blocking_owner_lock_snapshot)
                )
            mutate_visible_registry(
                visible_registry_path(root),
                unregister_mutation,
                default_payload=default_visible_registry(root),
            )
    except AdapterError as exc:
        active_locks = bool(blocking_owner_lock_snapshot)
        write_visible_binding_audit(
            root,
            args.worker,
            action="unregister-visible",
            result="rejected",
            reason=(
                str(exc)
                if active_locks
                else str(
                    rejected.get("reason")
                    or "unregister CAS rejected"
                )
            ),
            cas_result=(
                "active_owner_locks"
                if active_locks
                else "stale_generation"
            ),
            old_record=expected,
            new_record=rejected.get("current", {}),
            transaction_id=transaction_id,
            global_owner_lock_snapshot=global_lock_snapshot,
            global_mutation_gate_result=(
                (
                    "rejected_target_owner_lock"
                    if raw_stop_fence
                    else "rejected_active_owner_locks"
                )
                if active_locks
                else (
                    "passed_stop_fence_target_zero_locks"
                    if raw_stop_fence
                    else "passed_zero_locks"
                )
            ),
        )
        raise
    removed = counts["before"] - counts["after"]
    old_record = mutation_context.get("old_record", {})
    if old_record:
        sidecar = {
            "schema_version": 1,
            "worker_id": args.worker,
            "binding_generation": binding_generation(old_record),
            "binding_lease_id": str(old_record.get("binding_lease_id") or ""),
            "transaction_id": transaction_id,
            "transaction_state": "unregistered",
            "previous_binding": old_record,
            "canonical_registry": rel(visible_registry_path(root), root),
            "unregistered_at": utc_now(),
        }
        write_json_atomic(
            framework_root(root) / f"opencode_visible_binding_{args.worker}.json",
            sidecar,
        )
    write_visible_binding_audit(
        root,
        args.worker,
        action="unregister-visible",
        result="applied",
        reason="visible worker unregistered without touching the pane",
        cas_result="generation_matched" if old_record else "already_absent",
        old_record=old_record,
        new_record={},
        transaction_id=transaction_id,
        global_owner_lock_snapshot=global_lock_snapshot,
        global_mutation_gate_result=(
            "passed_stop_fence_target_zero_locks"
            if raw_stop_fence
            else "passed_zero_locks"
        ),
    )
    print(f"unregistered_visible: {args.worker}")
    print(f"removed: {removed}")
    print("No pane was stopped, killed, cleared, or sent input.")
    return 0


def command_prepare_visible(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    ensure_state_team_clean(root)
    safe_framework_run_parts(args.run, "run")
    safe_slug(args.task, "task")
    safe_slug(args.worker, "worker")
    tdir = visible_task_dir(root, args.run, args.task)
    tdir.mkdir(parents=True, exist_ok=True)
    (tdir / "owner").write_text(args.worker + "\n", encoding="utf-8")
    (tdir / "backend").write_text("opencode_tui\n", encoding="utf-8")
    (tdir / "task.md").write_text(f"# {args.title}\n\n{args.body}\n", encoding="utf-8")
    prompt = visible_prompt_text(root, args.run, args.task, args.worker, args.title, args.body)
    (tdir / "prompt.txt").write_text(prompt, encoding="utf-8")
    worker = visible_worker_record(root, args.worker)
    visible_delivery = {
        "schema_version": 1,
        "created_at": utc_now(),
        "mode": "visible-prepare",
        "run": args.run,
        "task": args.task,
        "worker": args.worker,
        "task_dir": rel(tdir, root),
        "prompt_path": rel(tdir / "prompt.txt", root),
        "task_path": rel(tdir / "task.md", root),
        "report_path": rel(tdir / "report.md", root),
        "worker_registered": bool(worker),
        "registered_worker": worker or {},
        "writes_markers": False,
        "submitted": False,
        "notes": [
            "Prepared only. No OpenCode API was called.",
            "No .submitted/.received/.started/.done/.fail/.blocked marker was written.",
        ],
    }
    write_json(tdir / "visible_delivery.json", visible_delivery)
    append_event(tdir / "events.jsonl", {
        "ts": visible_delivery["created_at"],
        "event": "visible_task_prepared",
        "source": "omx_opencode_tui_adapter",
        "worker": args.worker,
    })
    print(f"prepared_visible: {rel(tdir, root)}")
    print(f"prompt: {rel(tdir / 'prompt.txt', root)}")
    print(f"worker_registered: {str(bool(worker)).lower()}")
    return 0


def command_submit_visible_dry_run(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    tdir = visible_task_dir(root, args.run, args.task)
    prompt_path = tdir / "prompt.txt"
    if not prompt_path.is_file():
        raise AdapterError(f"prompt not found: {rel(prompt_path, root)}")
    prompt_body = read_text(prompt_path)
    plan: dict[str, Any] = {
        "schema_version": 1,
        "generated_at": utc_now(),
        "mode": "visible-dry-run",
        "run": args.run,
        "task": args.task,
        "worker": args.worker,
        "task_path": rel(tdir, root),
        "prompt_path": rel(prompt_path, root),
        "prompt_bytes": len(prompt_body.encode("utf-8")),
        "would_post": list(TUI_ENDPOINTS_ORDERED),
        "posted": False,
        "submitted_written": False,
    }
    record = visible_worker_record(root, args.worker)
    if not record:
        plan["worker_registered"] = False
        plan["error"] = f"visible worker {args.worker!r} is not registered"
        write_json(tdir / "submit_visible_dry_run.json", plan)
        print(plan["error"])
        print(f"dry_run: {rel(tdir / 'submit_visible_dry_run.json', root)}")
        return 1

    binding = runtime_binding_for_visible_worker(root, args.worker, getattr(args, "runtime_backend", default_backend_name()))
    plan.update({
        "worker_registered": True,
        "target": {
            "worker_id": args.worker,
            "pane_id": record.get("pane_id"),
            "port": record.get("port"),
            "binding_confidence": binding.get("binding_confidence"),
            "allow_auto_submit": record.get("allow_auto_submit", False),
        },
        "verification": {
            "server_live": binding.get("server_live"),
            "doc_available": binding.get("doc_available"),
            "detected_tui_methods": binding.get("detected_tui_methods", []),
            "errors": binding.get("errors", []),
            "warnings": binding.get("warnings", []),
        },
    })
    write_json(tdir / "submit_visible_dry_run.json", plan)
    print("OpenCode visible TUI submit dry-run")
    print(f"target worker: {args.worker}")
    print(f"pane: {record.get('pane_id')}")
    print(f"port: {record.get('port')}")
    print(f"binding_confidence: {binding.get('binding_confidence')}")
    for endpoint in TUI_ENDPOINTS_ORDERED:
        print(f"  would POST {endpoint}")
    print("No POST was sent and .submitted was not written.")
    return 0 if binding.get("binding_confidence") == "strong" else 1


def command_session_title_update_real(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    if not args.allow_real:
        raise AdapterError("session-title-update-real requires --allow-real")
    result = session_title_update_real_runtime(
        root,
        args.run,
        args.task,
        args.worker,
        attempt_id=args.attempt_id,
        session_id=args.session_id,
        runtime_backend=getattr(args, "runtime_backend", default_backend_name()),
    )
    if result.get("status") == "updated":
        print("OpenCode session title update completed")
        print(f"task: {result['task_id']}")
        print(f"worker: {result['worker_id']}")
        print(f"session: {result['session_id']}")
        print(f"title: {result['title']}")
        print(f"previous_title: {result.get('previous_title', '')}")
        print(f"selection_preserved: {result.get('selection_preserved')}")
        return 0
    print(
        f"ERROR: session title update failed: {result.get('error', '')}",
        file=sys.stderr,
    )
    return 1


def command_submit_visible_real(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    if not args.allow_real:
        raise AdapterError("submit-visible-real requires --allow-real")
    result = submit_visible_real_runtime(
        root,
        args.run,
        args.task,
        args.worker,
        runtime_backend=getattr(args, "runtime_backend", default_backend_name()),
        visual_prompt_exposure=bool(
            getattr(args, "allow_visible_full_prompt", False)
        ),
    )
    print("OpenCode visible TUI submit-real completed")
    print(f"task: {result['task_path']}")
    print(f"worker: {result['worker_id']}")
    print(f"pane: {result['pane_id']}")
    print(f"port: {result['port']}")
    print(f"binding_confidence: {result['binding_confidence']}")
    responses = result.get("responses") if isinstance(result.get("responses"), dict) else {}
    if PROMPT_ASYNC_ENDPOINT in responses:
        print(
            "prompt_async status: "
            f"{responses[PROMPT_ASYNC_ENDPOINT].get('status')}"
        )
    else:
        print(f"clear status: {responses['/tui/clear-prompt'].get('status')}")
        print(f"append status: {responses['/tui/append-prompt'].get('status')}")
        print(f"submit status: {responses['/tui/submit-prompt'].get('status')}")
    print(f"submitted marker: {result['submitted_marker']}")
    print("received: false unless the worker later writes .received")
    return 0


def submit_visible_real_runtime(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    runtime_backend: str | None = None,
    visual_prompt_exposure: bool = False,
) -> dict[str, Any]:
    safe_slug(worker_id, "worker")
    ensure_state_team_clean(root)
    backend_name = runtime_backend or default_backend_name()
    record = require_visible_worker(root, worker_id)
    if not record.get("allow_auto_submit"):
        raise AdapterError(f"visible worker {worker_id!r} has allow_auto_submit=false")
    require_current_binding_lease(record)

    binding = runtime_binding_for_visible_worker(root, worker_id, backend_name)
    if binding.get("binding_confidence") != "strong":
        raise AdapterError(f"visible binding is not strong: {binding.get('binding_confidence')}")
    host, port = verified_visible_transport_endpoint(record, binding)
    binding_snapshot = visible_binding_snapshot(record, binding)
    side_effect_fence = visible_side_effect_fence(binding_snapshot)

    tdir = visible_task_dir(root, run, task)
    if not is_relative_to(tdir, framework_root(root)):
        raise AdapterError("visible submit task must be under .omx/framework/team")
    try:
        task_contract = load_clean_room_task_contract(tdir / "task.json")
    except CleanRoomStartupError as exc:
        raise AdapterError(str(exc)) from exc
    visual_prompt_exposure = visible_prompt_exposure_enabled(
        task_contract,
        explicit=visual_prompt_exposure,
    )
    try:
        server_selector = extract_opencode_server_prompt_async_canary(task_contract)
    except OperationAuthorizationError as exc:
        raise AdapterError(str(exc)) from exc

    if server_selector is None:
        capability = submit_tui_capability(root, worker_id, binding)
        methods = set(capability.get("detected_tui_methods", []))
        missing = list(capability.get("missing_required_endpoints", []))
        if missing:
            raise AdapterError(f"/doc does not confirm required endpoint(s): {', '.join(missing)}")

        schema_data = endpoint_schema_for_port(root, port)
        if not schema_data.get("all_payloads_executable"):
            reasons = [
                f"{item.get('path')}: {item.get('reason')}"
                for item in schema_data.get("endpoints", [])
                if not item.get("executable")
            ]
            raise AdapterError("endpoint schema is not safely executable: " + "; ".join(reasons))
    else:
        try:
            server_admission = admit_opencode_server_prompt_async_canary(server_selector)
        except OperationAuthorizationError as exc:
            raise AdapterError(str(exc)) from exc
        capability = {
            "source": "server-prompt-async-canary",
            "detected_tui_methods": [],
            "missing_required_endpoints": [],
        }
        schema_data = {
            "schema_version": 1,
            "all_payloads_executable": True,
            "submit_backend": "server-prompt-async",
            "endpoints": [],
        }
    cold_start = bool(
        server_selector is not None
        and server_selector.get("session_mode") == "create"
    )
    clean_room_startup = (
        task_contract.get("clean_room_startup")
        if isinstance(task_contract, dict)
        and isinstance(task_contract.get("clean_room_startup"), dict)
        else None
    )
    if cold_start:
        if clean_room_startup is not None:
            raise AdapterError("cold-start session creation forbids clean_room_startup")
        session_action = read_json_safe(tdir / "session_action.json")
        if session_action.get("session_action") != "keep":
            raise AdapterError("cold-start session creation requires session_action=keep")
    try:
        require_clean_room_startup_gate(root, record, task_contract)
    except CleanRoomStartupError as exc:
        raise AdapterError(str(exc)) from exc
    prompt_path = tdir / "prompt.txt"
    if not prompt_path.is_file():
        raise AdapterError(f"prompt not found: {rel(prompt_path, root)}")
    prompt_body = read_text(prompt_path)
    if not prompt_body.strip():
        raise AdapterError(f"prompt is empty: {rel(prompt_path, root)}")
    submitted_path = tdir / ".submitted"
    if submitted_path.exists():
        raise AdapterError(f"task already has .submitted marker: {rel(submitted_path, root)}")
    expected_owner_lock = require_visible_owner_lock(root, worker_id)
    validate_visible_submission_guard(
        root,
        run,
        task,
        worker_id,
        expected_record=record,
        expected_binding=binding,
        expected_owner_lock=expected_owner_lock,
        runtime_backend=backend_name,
        require_submitted=False,
    )
    acceptance_fence_path = tdir / "acceptance_fence.json"
    protocol_status = terminal_protocol_submission_status(tdir)
    acceptance_fence = dict(protocol_status.get("fence") or {})
    if not protocol_status.get("ok"):
        error_doc = {
            "schema_version": 1,
            "failed_at": utc_now(),
            "failed_endpoint": "terminal_protocol_identity",
            "blocked_reason": str(protocol_status.get("status") or ""),
            "terminal_protocol": protocol_status.get("classification", {}),
            "acceptance_fence": acceptance_fence,
            "submitted_written": False,
        }
        write_json(tdir / "delivery_error.json", error_doc)
        raise AdapterError(str(protocol_status.get("status") or "terminal protocol is invalid"))
    if not acceptance_fence_matches_binding(acceptance_fence, binding_snapshot):
        error_doc = {
            "schema_version": 1,
            "failed_at": utc_now(),
            "failed_endpoint": "acceptance_fence",
            "blocked_reason": STALE_ACCEPTANCE_FENCE_ERROR_CODE,
            "acceptance_fence": acceptance_fence,
            "binding_snapshot": binding_snapshot,
            "submitted_written": False,
        }
        write_json(tdir / "delivery_error.json", error_doc)
        raise AdapterError(STALE_ACCEPTANCE_FENCE_ERROR_CODE)
    if (task_contract or {}).get("allow_visible_full_prompt") is True:
        try:
            grant = require_active_external_harness_capability(
                root, task_contract, task_id=task,
                attempt_id=str(acceptance_fence["attempt_id"]),
            )
            expected_hash = _external_harness_derived_contract_hash(
                task_contract=task_contract,
                operation_contract=derive_operation_contract("worker_dispatch", task_contract),
                worker_id=worker_id, task_id=task,
                attempt_id=str(acceptance_fence["attempt_id"]),
            )
            if (
                grant["capability"]["scope"] != {"kind": "worker", "id": worker_id}
                or grant["contract_hash"] != expected_hash
            ):
                raise OperationAuthorizationError("full-prompt task contract does not match its grant")
        except OperationAuthorizationError as exc:
            raise AdapterError(str(exc)) from exc
    submitted_prompt_body, prompt_delivery_mode = visible_prompt_submission(
        run,
        task,
        worker_id,
        prompt_path,
        prompt_body,
        task_contract,
        root=root,
        acceptance_fence=acceptance_fence,
        visual_prompt_exposure=visual_prompt_exposure,
    )
    session_preflight = acceptance_session_observation(
        root,
        worker_id,
        acceptance_fence,
        runtime_backend=backend_name,
        allow_pending=clean_room_startup is None,
        bind_pending_singleton=False,
        fence_path=acceptance_fence_path,
        allow_expected_idle_identity=True,
    )
    strict_session_unobserved = (
        clean_room_startup is not None
        and str(
            (session_preflight.get("fence") or {}).get(
                "session_fence_state"
            )
            or ""
        )
        != "live_observed"
    )
    if not session_preflight.get("ok") or strict_session_unobserved:
        blocked_reason = (
            "clean_room_startup_session_not_live_observed"
            if strict_session_unobserved
            else STALE_ACCEPTANCE_FENCE_ERROR_CODE
        )
        error_doc = {
            "schema_version": 1,
            "failed_at": utc_now(),
            "failed_endpoint": "acceptance_session_fence",
            "blocked_reason": blocked_reason,
            "acceptance_fence": acceptance_fence,
            "binding_snapshot": binding_snapshot,
            "live_session_observation": session_preflight,
            "submitted_written": False,
        }
        write_json(tdir / "delivery_error.json", error_doc)
        raise AdapterError(
            f"{blocked_reason}: "
            f"{session_preflight.get('status')}"
        )
    acceptance_fence = dict(session_preflight.get("fence") or acceptance_fence)

    keep_target_unbound = False
    keep_target_session_id = ""
    if (
        server_selector is None
        and clean_room_startup is None
        and not cold_start
    ):
        # #1027: a keep task's fenced session is inherited provenance, never
        # request-bound target authority, and no supported interface reads
        # the TUI's current selection (the status map is activity evidence:
        # an inherited target being busy does not prove it is the selected
        # target, and a busy singleton is not task attribution). Keep
        # therefore never select-binds a session before input and the
        # adapter never binds a pending keep fence from the activity map;
        # task identity stays unknown here and binds only through the
        # existing task-attributed receipt/signal reconciliation. Rotate,
        # cold-start and the selection-bound server entry keep their own
        # request-bound binding; post-delivery drift rejection is unchanged.
        session_action_record = read_json_safe(
            tdir / "session_action.json"
        )
        if str(session_action_record.get("session_action") or "") == "keep":
            keep_target_unbound = True
            keep_target_session_id = str(
                acceptance_fence.get("session_id") or ""
            )

    server_session_id = (
        str(server_selector.get("session_id") or "")
        if server_selector is not None
        else ""
    )
    if server_selector is not None and not cold_start:
        exact_identity = session_identity_snapshot(
            root,
            worker_id,
            server_session_id,
            runtime_backend=backend_name,
        )
        if exact_identity.get("exists") and str(acceptance_fence.get("session_id") or "") in {"", server_session_id}:
            acceptance_fence = {
                **acceptance_fence,
                "session_id": server_session_id,
                "session_fence_state": "live_observed",
            }
            update_current_acceptance_fence_records(
                acceptance_fence_path,
                acceptance_fence,
            )
    if server_selector is not None and not cold_start:
        fence_session_id = str(acceptance_fence.get("session_id") or "")
        fence_session_state = str(acceptance_fence.get("session_fence_state") or "")
        if fence_session_id != server_selector["session_id"] or fence_session_state != "live_observed":
            error_doc = {
                "schema_version": 1,
                "failed_at": utc_now(),
                "failed_endpoint": "server_selector_session_fence",
                "blocked_reason": "server_selector_session_mismatch",
                "acceptance_fence": acceptance_fence,
                "server_selector_session_id": server_selector["session_id"],
                "submitted_written": False,
            }
            write_json(tdir / "delivery_error.json", error_doc)
            raise AdapterError(
                "server_selector_session_mismatch: "
                f"fence session {fence_session_id!r} state {fence_session_state!r} "
                f"does not match selector session {server_selector['session_id']!r}"
            )
    elif cold_start:
        if (
            str(acceptance_fence.get("session_id") or "")
            or str(acceptance_fence.get("session_fence_state") or "")
            != "pending_live_observation"
        ):
            raise AdapterError(
                "cold-start session creation requires a pending empty session fence"
            )
        session_list = session_list_snapshot(
            root,
            worker_id,
            runtime_backend=backend_name,
        )
        session_status = session_status_snapshot(
            root,
            worker_id,
            runtime_backend=backend_name,
        )
        if (
            int(session_list.get("session_count") or 0) != 0
            or int(session_status.get("status_count") or 0) != 0
        ):
            raise AdapterError(
                "cold-start session creation requires empty session list and status"
            )
    if server_selector is not None:
        fetched_doc = fetch_openapi_doc(root, port)
        admitted_digest = str(
            (server_admission.get("manifest") or {}).get("openapi_schema_digest") or ""
        )
        supplement_admitted = (
            admitted_digest == prompt_async_supplement_consumed_schema_digest()
        )
        if supplement_admitted:
            server_operation = supplement_prompt_async_operation_schema(
                fetched_doc["doc"]
            )
        else:
            server_operation = server_prompt_async_operation_schema(
                fetched_doc["doc"]
            )
        if cold_start:
            session_create_operation = canonical_session_create_operation(
                fetched_doc["doc"]
            )
            session_select_operation = canonical_tui_select_session_operation(
                fetched_doc["doc"]
            )
            live_digest = cold_start_consumed_schema_digest()
        else:
            session_create_operation = None
            session_select_operation = None
            live_digest = str(server_operation.get("projection_digest") or "")
        if not admitted_digest or live_digest != admitted_digest:
            error_doc = {
                "schema_version": 1,
                "failed_at": utc_now(),
                "failed_endpoint": "server_selector_schema_digest",
                "blocked_reason": "server_selector_schema_digest_mismatch",
                "admitted_openapi_schema_digest": admitted_digest,
                "live_projection_digest": live_digest,
                "submitted_written": False,
            }
            write_json(tdir / "delivery_error.json", error_doc)
            raise AdapterError(
                "server selector consumed OpenAPI projection digest mismatch"
            )
        initial_submit_operation = server_operation
        initial_selection: dict[str, Any] | None = None
        initial_selection_source = ""
        if supplement_admitted and not cold_start:
            # Preserve the exact target session's observed selection on the
            # initial POST: upstream v1.18.29 resolves an omitted agent to the
            # default agent and an omitted model to agent.model before the
            # session current model, so a parts-only initial request is not a
            # selection-preserving request. Derivation is GET-only, reuses the
            # supplement selection helpers, and refuses before any POST when
            # the bounded identity cannot prove the original selection.
            initial_selection_source = "session_identity_snapshot"
            try:
                initial_selection = observed_session_selection(exact_identity)
                supplement_selection_guard(
                    original_selection=initial_selection,
                    selection_evidence=initial_selection_source,
                )
            except AdapterError as exc:
                error_doc = {
                    "schema_version": 1,
                    "failed_at": utc_now(),
                    "failed_endpoint": "server_selector_initial_selection",
                    "blocked_reason": "server_selector_initial_selection_unsupported",
                    "server_selector_session_id": server_session_id,
                    "detail": str(exc),
                    "submitted_written": False,
                }
                write_json(tdir / "delivery_error.json", error_doc)
                raise AdapterError(
                    f"server_selector_initial_selection_unsupported: {exc}"
                ) from exc
        schema_data = {
            "schema_version": 1,
            "generated_at": utc_now(),
            "port": int(port),
            "doc_http": fetched_doc["http"],
            "doc_text_sha256": fetched_doc["doc_text_sha256"],
            "endpoints": [
                *([session_create_operation] if session_create_operation else []),
                *([session_select_operation] if session_select_operation else []),
                initial_submit_operation,
            ],
            "all_payloads_executable": True,
            "submit_backend": "server-prompt-async",
        }
        payloads: dict[str, dict[str, Any]] = {}
    else:
        payloads = prompt_payloads_from_schema(
            schema_data,
            submitted_prompt_body,
        )
    attempt = visible_payload_attempt(
        root,
        tdir,
        run,
        task,
        worker_id,
        binding,
        prompt_path,
        prompt_body,
        submitted_prompt_body,
        prompt_delivery_mode,
        visual_prompt_exposure,
        schema_data,
    )
    attempt["binding_snapshot"] = binding_snapshot
    attempt["side_effect_fence"] = side_effect_fence
    attempt["acceptance_fence"] = acceptance_fence
    attempt["submit_tui_method_source"] = capability.get("source", "binding")
    if server_selector is not None:
        attempt["allowed_post_paths"] = (
            [
                SESSION_CREATE_ENDPOINT,
                TUI_SELECT_SESSION_ENDPOINT,
                PROMPT_ASYNC_ENDPOINT,
            ]
            if cold_start
            else [PROMPT_ASYNC_ENDPOINT]
        )
        attempt["submit_backend"] = "server-prompt-async"
        attempt["server_prompt_async_operation"] = initial_submit_operation
        if cold_start:
            attempt["adapter_writes_only"] += [
                "session_creation.json", "acceptance_fence.json", "task.json",
                "dispatch.json", "delivery_error.json",
            ]
        attempt["server_selector"] = {
            "candidate_bundle_digest": server_selector["candidate_bundle_digest"],
            "candidate_manifest_path": server_selector["candidate_manifest_path"],
            **(
                {"session_mode": "create"}
                if cold_start
                else {"session_id": server_session_id}
            ),
        }
        if initial_selection is not None:
            attempt["initial_selection"] = {
                "preserved_from_session": True,
                "session_id": server_session_id,
                "selection": supplement_selection_payload(initial_selection),
                "observed_session_selection": initial_selection,
                "selection_source": initial_selection_source,
                "selection_evidence": initial_selection_source,
                "identity_checked_at": str(exact_identity.get("checked_at") or ""),
                "emitted_optional_fields": list(SUPPLEMENT_SELECTION_FIELDS),
            }
    if clean_room_startup is not None:
        attempt["adapter_writes_only"] = [
            *attempt["adapter_writes_only"],
            "startup_gate_armed.json",
            rel(
                clean_room_session_binding_path(
                    root,
                    str(acceptance_fence.get("session_id") or ""),
                ),
                root,
            ),
        ]
    live_readiness = capability.get("live_readiness", {})
    if isinstance(live_readiness, dict) and live_readiness:
        attempt["live_readiness"] = {
            "readiness": live_readiness.get("readiness"),
            "reason": live_readiness.get("reason"),
            "doc_ok": bool(live_readiness.get("doc_ok")),
            "detected_tui_methods": live_readiness.get("detected_tui_methods", []),
        }
    if keep_target_unbound:
        attempt["keep_session_binding"] = {
            "bound_before_input": False,
            "current_selection": "unknown",
            "fence_session_id": keep_target_session_id,
            "note": (
                "keep target authority is inherited provenance, not a "
                "request-bound selection; no select bind and no "
                "activity-based pending bind; identity binds only through "
                "task-attributed signal reconciliation"
            ),
        }
    write_json(tdir / "delivery_attempt.json", attempt)

    pre_effect_check = check_visible_side_effect_fence(
        root,
        worker_id,
        binding_snapshot,
        runtime_backend=backend_name,
        operation="submit-visible-real:preflight",
    )
    pre_effect_snapshot = pre_effect_check["current_binding_snapshot"]
    pre_effect_ok = bool(pre_effect_check["ok"])
    if not pre_effect_ok:
        error_doc = {
            **attempt,
            "failed_at": utc_now(),
            "failed_endpoint": "binding_fence",
            "pre_side_effect_binding_snapshot": pre_effect_snapshot,
            "blocked_reason": "binding_fence_mismatch_before_submit",
            "submitted_written": False,
        }
        write_json(tdir / "delivery_error.json", error_doc)
        raise AdapterError("binding_fence_mismatch_before_submit")

    if cold_start:
        attempt_id = str(acceptance_fence.get("attempt_id") or "")
        try:
            require_active_external_harness_capability(
                root,
                task_contract,
                task_id=task,
                attempt_id=attempt_id,
            )
        except OperationAuthorizationError as exc:
            raise AdapterError(str(exc)) from exc
        title = f"omx:{task}:{attempt_id}"
        reservation_path = tdir / "session_creation.json"
        reservation = {
            "schema_version": 1,
            "status": "reserved",
            "reserved_at": utc_now(),
            "worker_id": worker_id,
            "task_id": task,
            "attempt_id": attempt_id,
            "title": title,
            "candidate_bundle_digest": server_selector["candidate_bundle_digest"],
            "binding_snapshot": binding_snapshot,
        }
        reserve_session_creation(reservation_path, reservation)
        try:
            require_active_external_harness_capability(
                root,
                task_contract,
                task_id=task,
                attempt_id=attempt_id,
            )
            validate_visible_submission_guard(
                root,
                run,
                task,
                worker_id,
                expected_record=record,
                expected_binding=binding,
                expected_owner_lock=expected_owner_lock,
                runtime_backend=backend_name,
                require_submitted=False,
            )
            admit_opencode_server_prompt_async_canary(server_selector)
            current_doc = fetch_openapi_doc(root, port)["doc"]
            canonical_session_create_operation(current_doc)
            canonical_tui_select_session_operation(current_doc)
            server_prompt_async_operation_schema(current_doc)
            if not check_visible_side_effect_fence(
                root,
                worker_id,
                binding_snapshot,
                runtime_backend=backend_name,
                operation="submit-visible-real:/session",
            )["ok"]:
                raise AdapterError("binding changed before POST /session")
            current_sessions = session_list_snapshot(
                root,
                worker_id,
                runtime_backend=backend_name,
            )
            current_status = session_status_snapshot(
                root,
                worker_id,
                runtime_backend=backend_name,
            )
            if (
                int(current_sessions.get("session_count") or 0) != 0
                or int(current_status.get("status_count") or 0) != 0
            ):
                raise AdapterError(
                    "cold-start session state changed before POST /session"
                )
            creation_response = safe_http_session_create_post(
                host,
                port,
                title,
                cold_start_task_directory_permission(tdir),
            )
            reservation.update(
                status="response_received",
                response=compact_http_result(creation_response, include_body_head=True),
            )
            write_json_atomic(reservation_path, reservation)
            if not creation_response.get("ok"):
                raise AdapterError("POST /session did not return a bounded JSON HTTP 200")
            try:
                created_session = json.loads(
                    str(creation_response.get("body_head") or "")
                )
            except (TypeError, ValueError, json.JSONDecodeError) as exc:
                raise AdapterError("POST /session returned malformed JSON") from exc
            if not isinstance(created_session, dict):
                raise AdapterError("POST /session returned a non-object JSON value")
            server_session_id = str(created_session.get("id") or "")
            created_title = str(created_session.get("title") or "")
            created_directory = str(created_session.get("directory") or "")
            project = str(record.get("project") or "")
            if (
                not PROMPT_ASYNC_SESSION_ID_RE.fullmatch(server_session_id)
                or created_title != title
                or not project
                or os.path.realpath(created_directory) != os.path.realpath(project)
            ):
                raise AdapterError("POST /session returned mismatched session identity")
            identity = session_identity_snapshot(
                root,
                worker_id,
                server_session_id,
                runtime_backend=backend_name,
            )
            reservation["identity"] = identity
            write_json_atomic(reservation_path, reservation)
            if (
                not identity.get("exists")
                or identity.get("observed_title") != title
                or os.path.realpath(str(identity.get("observed_directory") or ""))
                != os.path.realpath(project)
            ):
                raise AdapterError("created session GET identity did not match")
            created_list = session_list_snapshot(
                root,
                worker_id,
                runtime_backend=backend_name,
            )
            reservation["session_list"] = created_list
            write_json_atomic(reservation_path, reservation)
            if created_list.get("session_ids") != [server_session_id]:
                raise AdapterError(
                    "created session list did not contain exactly the new identity"
                )
            acceptance_fence = {
                **acceptance_fence,
                "session_id": server_session_id,
                "session_fence_state": "live_observed",
            }
            update_current_acceptance_fence_records(
                acceptance_fence_path,
                acceptance_fence,
            )
            write_json_atomic(
                reservation_path,
                {
                    **reservation,
                    "status": "created",
                    "created_at": utc_now(),
                    "session_id": server_session_id,
                    "identity": identity,
                },
            )
        except (OperationAuthorizationError, AdapterError, OSError, ValueError, TypeError) as exc:
            reservation.update(status="ambiguous", failed_at=utc_now(), error=str(exc))
            write_json_atomic(reservation_path, reservation)
            write_json(
                tdir / "delivery_error.json",
                {
                    **attempt,
                    "failed_at": reservation["failed_at"],
                    "failed_endpoint": SESSION_CREATE_ENDPOINT,
                    "session_creation": reservation,
                    "submitted_written": False,
                },
            )
            raise AdapterError(str(exc)) from exc
        attempt["acceptance_fence"] = acceptance_fence
        attempt["session_creation"] = read_json_safe(reservation_path)
        write_json(tdir / "delivery_attempt.json", attempt)

    responses: dict[str, Any] = {}
    fenced_session_bind = str(acceptance_fence.get("session_id") or "")
    submit_endpoints = (
        (
            [TUI_SELECT_SESSION_ENDPOINT, PROMPT_ASYNC_ENDPOINT]
            if cold_start
            else [PROMPT_ASYNC_ENDPOINT]
        )
        if server_selector is not None
        else (
            [TUI_SELECT_SESSION_ENDPOINT, *TUI_ENDPOINTS_ORDERED]
            if fenced_session_bind.startswith("ses_")
            and not keep_target_unbound
            else list(TUI_ENDPOINTS_ORDERED)
        )
    )
    for endpoint in submit_endpoints:
        validate_visible_submission_guard(
            root,
            run,
            task,
            worker_id,
            expected_record=record,
            expected_binding=binding,
            expected_owner_lock=expected_owner_lock,
            runtime_backend=backend_name,
            require_submitted=False,
        )
        fence_check = check_visible_side_effect_fence(
            root,
            worker_id,
            binding_snapshot,
            runtime_backend=backend_name,
            operation=f"submit-visible-real:{endpoint}",
        )
        if not fence_check["ok"]:
            error_doc = {
                **attempt,
                "failed_at": utc_now(),
                "failed_endpoint": "binding_fence",
                "blocked_reason": STALE_BINDING_ERROR_CODE,
                "fence_check": fence_check,
                "responses": responses,
                "submitted_written": False,
            }
            write_json(tdir / "delivery_error.json", error_doc)
            raise AdapterError(
                f"{STALE_BINDING_ERROR_CODE}: binding changed before {endpoint}"
            )
        if clean_room_startup is not None and (
            endpoint == "/tui/submit-prompt" or server_selector is not None
        ):
            try:
                arm_clean_room_startup_session(
                    root,
                    tdir,
                    worker_id,
                    str(acceptance_fence.get("session_id") or ""),
                    task_contract,
                )
            except CleanRoomStartupError as exc:
                raise AdapterError(str(exc)) from exc
        if server_selector is None and endpoint == TUI_SELECT_SESSION_ENDPOINT:
            # Session existence does not prove the TUI's current selection
            # (#1026 review): bind the exact fenced target through the public
            # select ACK before any prompt input, and refuse before input when
            # the selection cannot be confirmed.
            try:
                current_doc = fetch_openapi_doc(root, port)["doc"]
                canonical_tui_select_session_operation(current_doc)
            except (AdapterError, KeyError, TypeError, ValueError) as exc:
                error_doc = {
                    **attempt,
                    "failed_at": utc_now(),
                    "failed_endpoint": TUI_SELECT_SESSION_ENDPOINT,
                    "blocked_reason": "tui_selection_bind_unsupported",
                    "detail": str(exc),
                    "responses": responses,
                    "submitted_written": False,
                }
                write_json(tdir / "delivery_error.json", error_doc)
                raise AdapterError(
                    f"tui_selection_bind_unsupported: {exc}"
                ) from exc
            response = safe_http_tui_select_session_post(
                host,
                port,
                fenced_session_bind,
            )
            responses[endpoint] = response
            if not response.get("ok"):
                error_doc = {
                    **attempt,
                    "failed_at": utc_now(),
                    "failed_endpoint": TUI_SELECT_SESSION_ENDPOINT,
                    "blocked_reason": "tui_selection_bind_failed",
                    "bound_session_id": fenced_session_bind,
                    "responses": responses,
                    "submitted_written": False,
                }
                write_json(tdir / "delivery_error.json", error_doc)
                raise AdapterError(
                    "tui_selection_bind_failed: exact fenced session "
                    f"{fenced_session_bind!r} could not be selected before input; "
                    "no prompt was sent"
                )
        elif server_selector is not None:
            identity = session_identity_snapshot(
                root,
                worker_id,
                server_session_id,
                runtime_backend=backend_name,
            )
            if not identity.get("exists"):
                error_doc = {
                    **attempt,
                    "failed_at": utc_now(),
                    "failed_endpoint": endpoint,
                    "blocked_reason": "server_selector_session_not_live",
                    "session_identity": identity,
                    "submitted_written": False,
                }
                write_json(tdir / "delivery_error.json", error_doc)
                raise AdapterError("server_selector_session_not_live")
            if initial_selection is not None:
                observed_now = observed_session_selection(identity)
                selection_errors = session_selection_errors(
                    observed_now,
                    initial_selection,
                )
                if selection_errors:
                    error_doc = {
                        **attempt,
                        "failed_at": utc_now(),
                        "failed_endpoint": endpoint,
                        "blocked_reason": "server_selector_initial_selection_changed",
                        "selection_errors": selection_errors,
                        "bound_initial_selection": supplement_selection_payload(
                            initial_selection
                        ),
                        "observed_session_selection": observed_now,
                        "submitted_written": False,
                    }
                    write_json(tdir / "delivery_error.json", error_doc)
                    raise AdapterError(
                        "server_selector_initial_selection_changed: "
                        + "; ".join(selection_errors)
                    )
            try:
                admit_opencode_server_prompt_async_canary(server_selector)
                if cold_start:
                    require_active_external_harness_capability(
                        root,
                        task_contract,
                        task_id=task,
                        attempt_id=str(
                            acceptance_fence.get("attempt_id") or ""
                        ),
                    )
                current_doc = fetch_openapi_doc(root, port)["doc"]
                if cold_start:
                    canonical_session_create_operation(current_doc)
                    canonical_tui_select_session_operation(current_doc)
                admitted_digest_pre_post = str(
                    (server_admission.get("manifest") or {}).get(
                        "openapi_schema_digest"
                    )
                    or ""
                )
                if (
                    admitted_digest_pre_post
                    == prompt_async_supplement_consumed_schema_digest()
                ):
                    supplement_prompt_async_operation_schema(current_doc)
                else:
                    server_prompt_async_operation_schema(current_doc)
            except (OperationAuthorizationError, AdapterError) as exc:
                error_doc = {
                    **attempt,
                    "failed_at": utc_now(),
                    "failed_endpoint": endpoint,
                    "blocked_reason": "server_selector_manifest_readmit_failed",
                    "submitted_written": False,
                }
                write_json(tdir / "delivery_error.json", error_doc)
                raise AdapterError(str(exc)) from exc
            if endpoint == TUI_SELECT_SESSION_ENDPOINT:
                response = safe_http_tui_select_session_post(
                    host,
                    port,
                    server_session_id,
                )
            else:
                response = safe_http_prompt_async_post(
                    host,
                    port,
                    server_session_id,
                    submitted_prompt_body,
                    extra_fields=(
                        supplement_selection_payload(initial_selection)
                        if initial_selection is not None
                        else None
                    ),
                )
        else:
            response = safe_http_json_post(host, port, endpoint, payloads[endpoint])
        responses[endpoint] = response
        if not response.get("ok"):
            error_doc = {
                **attempt,
                "failed_at": utc_now(),
                "failed_endpoint": endpoint,
                "responses": responses,
                "submitted_written": False,
            }
            write_json(tdir / "delivery_error.json", error_doc)
            raise AdapterError(
                f"submit-visible-real failed at {endpoint}: status={response.get('status')} error={response.get('error', '')}"
            )

    write_marker(submitted_path)
    if keep_target_unbound:
        session_final = {
            "required": True,
            "ok": False,
            "status": "keep_session_binding_deferred_to_signal",
            "expected_session_id": keep_target_session_id,
            "session_ids": [],
            "fence": dict(acceptance_fence),
            "note": (
                "keep identity is bound only by the task-attributed "
                "signal reconciliation, never by adapter activity "
                "observation"
            ),
        }
    else:
        session_final = wait_for_acceptance_session_observation(
            root,
            worker_id,
            acceptance_fence,
            runtime_backend=backend_name,
            fence_path=acceptance_fence_path,
            allow_known_idle=server_selector is not None,
        )
    if session_final.get("ok"):
        acceptance_fence = dict(
            session_final.get("fence") or acceptance_fence
        )
    attempt["acceptance_fence"] = acceptance_fence
    attempt["live_session_observation"] = session_final
    attempt["post_delivery_session_observation_ok"] = bool(
        session_final.get("ok")
    )
    submitted_at = utc_now()
    delivery = {
        **attempt,
        "submitted_at": submitted_at,
        "responses": responses,
        "submitted_marker": rel(submitted_path, root),
        "received_written_by_adapter": False,
        "received": False,
        "state_note": "submitted is not received; wait for worker/plugin to write .received",
    }
    write_json(tdir / "delivery.json", delivery)
    append_event(tdir / "events.jsonl", {
        "ts": submitted_at,
        "event": "visible_submitted",
        "source": "omx_opencode_tui_adapter",
        "worker": worker_id,
        "pane_id": binding.get("pane_id"),
        "port": port,
        "prompt_sha256": attempt["prompt_sha256"],
    })
    return {
        "worker_id": worker_id,
        "task_path": rel(tdir, root),
        "pane_id": binding.get("pane_id"),
        "port": port,
        "binding_confidence": binding.get("binding_confidence"),
        "prompt_delivery_mode": prompt_delivery_mode,
        "visual_prompt_exposure": visual_prompt_exposure,
        "responses": responses,
        "submitted_marker": rel(submitted_path, root),
    }


SUPPLEMENT_TEXT_BYTE_LIMIT = 8192


def supplement_request_hash(text: str) -> str:
    return "sha256:" + hashlib.sha256(text.encode("utf-8")).hexdigest()


def deliver_visible_supplement_runtime(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    supplement_id: str,
    text: str,
    request_hash: str,
    reservation_path: Path,
    original_selection: dict[str, Any],
    selection_evidence: str,
    runtime_backend: str | None = None,
) -> dict[str, Any]:
    """Deliver one same-task supplementary instruction over the fenced
    session's public ``prompt_async`` transport, including default TUI tasks.

    Transport only: at most one POST per call, no retry, no reservation
    bookkeeping, no ownership change and no terminal truth. The caller owns
    the durable pre-send reservation; this function refuses unless that
    reservation exists, matches the delivered request, and lives inside the
    task directory. The bound original agent/model/variant selection must be
    expressible in the admitted request contract; otherwise this fails before
    any POST. HTTP 204 proves request acceptance by the backend, not model
    consumption.
    """
    safe_slug(worker_id, "worker")
    safe_slug(supplement_id, "supplement")
    if not text.strip():
        raise AdapterError("supplement text is empty")
    if len(text.encode("utf-8")) > SUPPLEMENT_TEXT_BYTE_LIMIT:
        raise AdapterError(
            f"supplement text exceeds {SUPPLEMENT_TEXT_BYTE_LIMIT} bytes"
        )
    if supplement_request_hash(text) != request_hash:
        raise AdapterError("supplement request hash does not match its text")
    selection_admission = supplement_selection_guard(
        original_selection=dict(original_selection),
        selection_evidence=selection_evidence,
    )
    backend_name = runtime_backend or default_backend_name()
    record = require_visible_worker(root, worker_id)
    if not record.get("allow_auto_submit"):
        raise AdapterError(f"visible worker {worker_id!r} has allow_auto_submit=false")
    try:
        require_current_binding_lease(record)
    except AdapterError as exc:
        if str(exc).startswith("binding lease expired at "):
            command = shlex.join([
                str(root / "bin/omx_opencode_tui_adapter"), "verify-visible",
                "--root", str(root), "--worker", worker_id, "--update-registry",
            ])
            raise AdapterError(
                f"{exc}; same-instance revalidation: {command}; "
                "requires the same strong live identity; preserve the task fence "
                "and owner lock, then use a fresh supplement/event id after "
                "this pre-send refusal (replay never resends)"
            ) from exc
        raise
    ensure_state_team_clean(root)
    tdir = visible_task_dir(root, run, task)
    if not is_relative_to(tdir, framework_root(root)):
        raise AdapterError("visible supplement task must be under .omx/framework/team")
    binding = runtime_binding_for_visible_worker(root, worker_id, backend_name)
    if binding.get("binding_confidence") != "strong":
        raise AdapterError(
            f"visible binding is not strong: {binding.get('binding_confidence')}"
        )
    host, port = verified_visible_transport_endpoint(record, binding)
    binding_snapshot = visible_binding_snapshot(record, binding)
    if not is_relative_to(reservation_path, tdir):
        raise AdapterError(
            "supplement reservation must stay inside the owning task directory"
        )
    reservation = read_json_safe(reservation_path)
    if (
        str(reservation.get("supplement_id") or "") != supplement_id
        or str(reservation.get("request_hash") or "") != request_hash
        or str(reservation.get("status") or "") != "reserved"
    ):
        raise AdapterError(
            "supplement reservation is missing, mismatched, or already resolved"
        )
    task_contract = load_clean_room_task_contract(tdir / "task.json")
    try:
        server_selector = extract_opencode_server_prompt_async_canary(task_contract)
    except OperationAuthorizationError as exc:
        raise AdapterError(str(exc)) from exc
    if server_selector is None:
        if read_text(tdir / "backend").strip() != "opencode_tui":
            raise AdapterError(
                "supplement_transport_unsupported: target is not a default "
                "OpenCode TUI task or an admitted server task"
            )
    elif server_selector.get("session_mode") == "create":
        raise AdapterError(
            "supplement_transport_unsupported: cold-start session creation has "
            "no running task to supplement"
        )
    expected_owner_lock = require_visible_owner_lock(root, worker_id)
    validate_visible_submission_guard(
        root,
        run,
        task,
        worker_id,
        expected_record=record,
        expected_binding=binding,
        expected_owner_lock=expected_owner_lock,
        runtime_backend=backend_name,
        require_submitted=True,
        require_started=True,
        allow_reviewed_report=True,
    )
    acceptance_fence = read_json_object(tdir / "acceptance_fence.json")
    if not acceptance_fence_matches_binding(acceptance_fence, binding_snapshot):
        raise AdapterError(STALE_ACCEPTANCE_FENCE_ERROR_CODE)
    session_id = str(acceptance_fence.get("session_id") or "")
    if (
        not session_id.startswith("ses_")
        or str(acceptance_fence.get("session_fence_state") or "")
        != "live_observed"
    ):
        raise AdapterError(
            "supplement refused: acceptance fence has no live observed session"
        )
    if server_selector is not None and session_id != str(
        server_selector.get("session_id") or ""
    ):
        raise AdapterError(
            "supplement refused: fence session does not match the pinned "
            "selector session"
        )
    if server_selector is not None:
        try:
            admit_opencode_server_supplement_canary(server_selector)
        except OperationAuthorizationError as exc:
            raise AdapterError(
                f"supplement refused: pinned transport contract re-admission failed: {exc}"
            ) from exc
    try:
        fetched_doc = fetch_openapi_doc(root, port)["doc"]
    except AdapterError as exc:
        raise AdapterError(
            f"supplement refused: live /doc read failed: {exc}"
        ) from exc
    try:
        live_schema = supplement_prompt_async_operation_schema(fetched_doc)
    except AdapterError as exc:
        raise AdapterError(
            "supplement_original_selection_unsupported: the live "
            f"prompt_async schema cannot carry the bound selection: {exc}"
        ) from exc
    missing_fields = [
        field
        for field in SUPPLEMENT_SELECTION_FIELDS
        if field not in live_schema["admitted_fields"]
    ]
    if missing_fields:
        raise AdapterError(
            "supplement_original_selection_unsupported: the live prompt_async "
            f"schema does not admit {missing_fields}"
        )
    identity = session_identity_snapshot(
        root,
        worker_id,
        session_id,
        runtime_backend=backend_name,
    )
    if not identity.get("exists"):
        raise AdapterError(
            "supplement refused: the pinned session is not live on the bound worker"
        )
    observed_selection = observed_session_selection(identity)
    selection_errors = session_selection_errors(observed_selection, original_selection)
    if selection_errors:
        raise AdapterError(
            "supplement_original_selection_unsupported: "
            + "; ".join(selection_errors)
        )
    selection_fields = supplement_selection_payload(original_selection)
    response = safe_http_prompt_async_post(
        host,
        port,
        session_id,
        text,
        extra_fields=selection_fields,
    )
    accepted = bool(response.get("ok") and response.get("status") == 204)
    if accepted:
        delivery = "sent"
    elif response.get("reachable"):
        delivery = "backend_rejected"
    else:
        delivery = "ambiguous"
    return {
        "supplement_id": supplement_id,
        "request_hash": request_hash,
        "run": run,
        "task": task,
        "worker_id": worker_id,
        "transport": "server_prompt_async",
        "endpoint": PROMPT_ASYNC_ENDPOINT,
        "session_id": session_id,
        "delivery": delivery,
        "backend_accepted": accepted,
        "selection_binding": {
            "sent_fields": sorted(selection_fields),
            "admitted_fields": list(live_schema["admitted_fields"]),
            "selection_evidence": selection_admission["selection_evidence"],
            "observed_session_selection": observed_selection,
        },
        "consumption": "unknown",
        "consumption_note": (
            "HTTP 204 is backend request acceptance only; no consumption "
            "evidence exists at delivery time"
        ),
        "response": {
            key: response.get(key)
            for key in (
                "ok",
                "reachable",
                "status",
                "error",
                "elapsed_seconds",
                "bytes_read",
            )
        },
    }


_PINNED_SESSION_STATUS_TYPES = frozenset({"idle", "retry", "busy"})


def _read_session_status_entry(host: str, port: int, session_id: str) -> dict[str, Any]:
    """One bounded GET /session/status read mapped to the exact session entry."""
    response = safe_http_request(
        host,
        port,
        "/session/status",
        "GET",
        timeout=3.0,
        limit=65_536,
        include_body_text=True,
    )
    observed_at = utc_now()
    if not response.get("ok") or response.get("truncated"):
        return {
            "ok": False,
            "reachable": bool(response.get("reachable")),
            "session_id": session_id,
            "status_type": "unknown",
            "readiness": "unknown",
            "raw_status": {},
            "observed_at": observed_at,
            "note": "GET /session/status failed or exceeded the bounded read limit",
        }
    try:
        payload = json.loads(str(response.get("body_text") or ""))
    except json.JSONDecodeError:
        payload = None

    if not isinstance(payload, dict):
        # Malformed JSON or a non-object root is unknown evidence, never idle.
        return {
            "ok": True,
            "reachable": True,
            "session_id": session_id,
            "status_type": "unknown",
            "readiness": "unknown",
            "raw_status": {},
            "observed_at": observed_at,
            "note": (
                "GET /session/status returned malformed JSON or a non-object "
                "map; observed as unknown"
            ),
        }

    if not all(
        isinstance(value, dict)
        and isinstance(value.get("type"), str)
        and value.get("type") in _PINNED_SESSION_STATUS_TYPES
        for value in payload.values()
    ):
        # A dict root alone is not a status map: an error object or any
        # malformed entry makes the whole reading unknown, never idle.
        return {
            "ok": True,
            "reachable": True,
            "session_id": session_id,
            "status_type": "unknown",
            "readiness": "unknown",
            "raw_status": {},
            "observed_at": observed_at,
            "note": (
                "GET /session/status returned an invalid status map; "
                "observed as unknown"
            ),
        }

    if session_id not in payload:
        # Valid map, exact key absent: the pinned backend deletes idle
        # entries, so a missing session entry is the only idle projection.
        status_type = "idle"
    else:
        status_type = str(payload[session_id]["type"])

    if status_type == "idle":
        readiness = "idle"
    elif status_type in {"busy", "retry"}:
        # retry is a documented pinned non-idle value, not an inferred
        # synonym: the pinned schema declares idle/retry/busy only.
        readiness = "busy"
    else:
        readiness = "unknown"
    raw_entry = payload.get(session_id)
    return {
        "ok": True,
        "reachable": True,
        "session_id": session_id,
        "status_type": status_type,
        "readiness": readiness,
        "raw_status": raw_entry if isinstance(raw_entry, dict) else {},
        "observed_at": observed_at,
        "note": (
            "exact-session observation only; it is not proof that every "
            "external tool, plugin, MCP or remote writer stopped"
        ),
    }


def observe_session_status_runtime(
    root: Path,
    worker_id: str,
    session_id: str,
    *,
    runtime_backend: str | None = None,
) -> dict[str, Any]:
    """Read-only exact-session status observation for interrupt-status."""
    if not PROMPT_ASYNC_SESSION_ID_RE.fullmatch(session_id or ""):
        raise AdapterError(
            f"unsafe opencode session id for status observation: {session_id!r}"
        )
    _record, _binding, host, port = _visible_worker_local_binding(
        root,
        worker_id,
        runtime_backend,
    )
    observation = _read_session_status_entry(host, port, session_id)
    observation["observes_only"] = True
    return observation


def request_session_abort_runtime(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    interrupt_id: str,
    request_hash: str,
    reservation_path: Path,
    original_selection: dict[str, Any] | None = None,
    selection_evidence: str = "",
    runtime_backend: str | None = None,
) -> dict[str, Any]:
    """Deliver one task-bound interrupt over the pinned session abort transport.

    Transport only: at most one bodyless POST to the fenced session's abort
    endpoint, no retry, no reservation bookkeeping, no ownership change and no
    terminal truth. The caller owns the durable pre-send reservation; this
    function refuses unless that reservation exists, matches the interrupt
    request, and lives inside the task directory. The abort-only entry
    capability is the bound worker's live ``/doc`` declaring the pinned abort
    schema plus the exact fenced session existing live; the original
    submission transport, its prompt_async supplement manifest, and the
    runtime version never gate the cancellation, and the model-preserving
    selection match belongs to supplement/resume. A supplied original
    selection is still validated and recorded as request identity. The
    measured 200 JSON boolean is the tracked-run cancel result — it is not
    proof that every external tool, plugin, MCP or remote writer has stopped.
    """
    safe_slug(worker_id, "worker")
    safe_slug(interrupt_id, "interrupt")
    if not str(request_hash or "").startswith("sha256:"):
        raise AdapterError("interrupt request hash must be a sha256 digest")
    if original_selection:
        selection_admission = interrupt_selection_guard(
            original_selection=dict(original_selection),
            selection_evidence=selection_evidence,
        )
    else:
        selection_admission = {
            "admitted": True,
            "selection_fields": [],
            "selection_evidence": "",
        }
    backend_name = runtime_backend or default_backend_name()
    record = require_visible_worker(root, worker_id)
    if not record.get("allow_auto_submit"):
        raise AdapterError(f"visible worker {worker_id!r} has allow_auto_submit=false")
    require_current_binding_lease(record)
    ensure_state_team_clean(root)
    tdir = visible_task_dir(root, run, task)
    if not is_relative_to(tdir, framework_root(root)):
        raise AdapterError("visible interrupt task must be under .omx/framework/team")
    binding = runtime_binding_for_visible_worker(root, worker_id, backend_name)
    if binding.get("binding_confidence") != "strong":
        raise AdapterError(
            f"visible binding is not strong: {binding.get('binding_confidence')}"
        )
    host, port = verified_visible_transport_endpoint(record, binding)
    binding_snapshot = visible_binding_snapshot(record, binding)
    if not is_relative_to(reservation_path, tdir):
        raise AdapterError(
            "interrupt reservation must stay inside the owning task directory"
        )
    reservation = read_json_safe(reservation_path)
    if (
        str(reservation.get("interrupt_id") or "") != interrupt_id
        or str(reservation.get("request_hash") or "") != request_hash
        or str(reservation.get("status") or "") != "reserved"
    ):
        raise AdapterError(
            "interrupt reservation is missing, mismatched, or already resolved"
        )
    expected_owner_lock = require_visible_owner_lock(root, worker_id)
    validate_visible_submission_guard(
        root,
        run,
        task,
        worker_id,
        expected_record=record,
        expected_binding=binding,
        expected_owner_lock=expected_owner_lock,
        runtime_backend=backend_name,
        require_submitted=True,
        require_started=True,
        allow_reviewed_report=True,
    )
    acceptance_fence = read_json_object(tdir / "acceptance_fence.json")
    if not acceptance_fence_matches_binding(acceptance_fence, binding_snapshot):
        raise AdapterError(STALE_ACCEPTANCE_FENCE_ERROR_CODE)
    session_id = str(acceptance_fence.get("session_id") or "")
    if (
        not session_id.startswith("ses_")
        or str(acceptance_fence.get("session_fence_state") or "")
        != "live_observed"
    ):
        raise AdapterError(
            "interrupt refused: acceptance fence has no live observed session"
        )
    try:
        fetched_doc = fetch_openapi_doc(root, port)["doc"]
    except AdapterError as exc:
        raise AdapterError(
            f"interrupt refused: live /doc read failed: {exc}"
        ) from exc
    try:
        abort_schema = session_abort_operation_schema(fetched_doc)
    except AdapterError as exc:
        raise AdapterError(
            "interrupt_transport_unsupported: the live server does not "
            f"declare the pinned abort contract: {exc}"
        ) from exc
    identity = session_identity_snapshot(
        root,
        worker_id,
        session_id,
        runtime_backend=backend_name,
    )
    if not identity.get("exists"):
        raise AdapterError(
            "interrupt refused: the pinned session is not live on the bound worker"
        )
    observed_selection = observed_session_selection(identity)
    pre_status = _read_session_status_entry(host, port, session_id)
    response = safe_http_session_abort_post(host, port, session_id)
    post_status = _read_session_status_entry(host, port, session_id)
    accepted = bool(response.get("ok"))
    if accepted:
        delivery = "sent"
    elif (
        response.get("reachable")
        and response.get("status") is not None
        and response.get("status") != 200
    ):
        # A known non-200 HTTP rejection is a distinct recorded outcome.
        delivery = "backend_rejected"
    else:
        # A reachable 200 with a missing, malformed, or non-boolean body has
        # an unknown outcome: ambiguous, retained, and never resent.
        delivery = "ambiguous"
    return {
        "interrupt_id": interrupt_id,
        "request_hash": request_hash,
        "run": run,
        "task": task,
        "worker_id": worker_id,
        "transport": "server_session_abort",
        "endpoint": SESSION_ABORT_ENDPOINT,
        "session_id": session_id,
        "delivery": delivery,
        "backend_accepted": (
            response.get("response_boolean") if accepted else None
        ),
        "response_boolean": response.get("response_boolean"),
        "abort_schema": abort_schema,
        "selection_binding": {
            "sent_fields": [],
            "selection_evidence": selection_admission["selection_evidence"],
            "observed_session_selection": observed_selection,
        },
        "pre_status": pre_status,
        "post_status": post_status,
        "consumption": "unknown",
        "consumption_note": (
            "the measured 200 boolean is the tracked-run cancel result only; "
            "external tool, plugin, MCP and remote writers are not proven "
            "stopped, and future correction consumption is not implied"
        ),
        "response": {
            key: response.get(key)
            for key in (
                "ok",
                "reachable",
                "status",
                "content_type",
                "error",
                "elapsed_seconds",
            )
        },
    }


SELECTION_CANDIDATE_RECORD_KIND = "opencode_selection_candidate_preparation"
SELECTION_CANDIDATE_STATUS = "candidate"
SELECTION_CANDIDATE_OMO_MARKER = "oh-my-openagent"
SELECTION_CANDIDATE_OMO_PINNED_VERSION = re.compile(
    r"\d+(?:\.\d+)+(?:[-+][0-9A-Za-z.-]+)?"
)
SELECTION_CANDIDATE_HEALTH_ENDPOINT = "/global/health"
SELECTION_CANDIDATE_HEALTH_HTTP_LIMIT = 65_536
SELECTION_CANDIDATE_CONFIG_ENDPOINT = "/config"
SELECTION_CANDIDATE_CONFIG_HTTP_LIMIT = 4_000_000


def _observed_opencode_runtime_version(host: str, port: int) -> str:
    """Measure the opencode runtime version from the bound endpoint health.

    The bound worker's own ``GET /global/health`` is the measured source; the
    ambient PATH ``opencode`` CLI is deliberately not consulted because it
    does not prove the exact bound runtime.
    """

    response = safe_http_request(
        host,
        port,
        SELECTION_CANDIDATE_HEALTH_ENDPOINT,
        "GET",
        timeout=3.0,
        limit=SELECTION_CANDIDATE_HEALTH_HTTP_LIMIT,
        include_body_text=True,
    )
    if not response.get("reachable") or not response.get("ok"):
        raise AdapterError(
            "prepare-selection-candidate missing fact: GET "
            f"{SELECTION_CANDIDATE_HEALTH_ENDPOINT} failed on the bound worker "
            f"endpoint (status={response.get('status')} "
            f"error={response.get('error', '')})"
        )
    if response.get("truncated"):
        raise AdapterError(
            "prepare-selection-candidate missing fact: the observed health "
            "response exceeded the bounded read limit"
        )
    try:
        health = json.loads(str(response.get("body_text") or ""))
    except json.JSONDecodeError as exc:
        raise AdapterError(
            "prepare-selection-candidate missing fact: the observed health "
            f"endpoint returned malformed JSON: {exc}"
        ) from exc
    if not isinstance(health, dict):
        raise AdapterError(
            "prepare-selection-candidate missing fact: the observed health "
            "endpoint JSON was not an object"
        )
    version = health.get("version")
    if not isinstance(version, str) or not version.strip():
        raise AdapterError(
            "prepare-selection-candidate missing fact: the bound endpoint "
            "health reports no runtime version"
        )
    return version.strip()


def _read_control_plane_identity_receipt() -> dict[str, Any]:
    """Read the installed control-plane runtime identity receipt."""

    from visible_agent_orchestrator.companion_runtime_identity import (
        RuntimeIdentityError,
        read_receipt,
    )

    try:
        return read_receipt(str(companion_control_root()))
    except RuntimeIdentityError as exc:
        raise AdapterError(
            "prepare-selection-candidate missing fact: the control-plane "
            f"runtime identity receipt is unavailable: {exc}"
        ) from exc


def _observed_omo_facts(config: dict[str, Any]) -> dict[str, Any]:
    """Derive bounded OMO provenance facts from the observed config plugins.

    This is provenance recording, not a capability gate: the binding,
    session-selection, schema, health, and config facts measured elsewhere
    in candidate preparation remain mandatory. A pinned exact-version
    plugin form (``oh-my-openagent@<x.y.z>``) yields that measured version;
    any other marked form (bare name, local path, tag or range selector)
    is recorded as the explicit unknown marker ``"unknown"`` — never a
    fabricated version. Absence is reported only against the observed
    effective config.
    """

    plugins = config.get("plugin")
    markers = [
        str(item or "")
        for item in (plugins if isinstance(plugins, list) else [])
        if SELECTION_CANDIDATE_OMO_MARKER in str(item or "")
    ]
    if not markers:
        return {"present": False, "version": ""}
    match = re.search(r"oh-my-openagent@([^/@\s]+)", markers[0])
    if match and SELECTION_CANDIDATE_OMO_PINNED_VERSION.fullmatch(match.group(1)):
        return {"present": True, "version": match.group(1)}
    return {"present": True, "version": "unknown"}


def observed_effective_config_facts(host: str, port: int) -> dict[str, Any]:
    """GET the effective config, hash it in memory, emit allowlisted facts.

    The raw config body is never persisted: only its sha256 digest plus the
    allowlisted default-agent/model and OMO marker facts are returned.
    """

    response = safe_http_request(
        host,
        port,
        SELECTION_CANDIDATE_CONFIG_ENDPOINT,
        "GET",
        timeout=4.0,
        limit=SELECTION_CANDIDATE_CONFIG_HTTP_LIMIT,
        include_body_text=True,
    )
    if not response.get("reachable") or not response.get("ok"):
        raise AdapterError(
            "prepare-selection-candidate missing fact: GET "
            f"{SELECTION_CANDIDATE_CONFIG_ENDPOINT} failed on the bound worker "
            f"endpoint (status={response.get('status')} "
            f"error={response.get('error', '')})"
        )
    if response.get("truncated"):
        raise AdapterError(
            "prepare-selection-candidate missing fact: the observed config "
            "response exceeded the bounded read limit; refusing to hash a "
            "partial config"
        )
    raw = str(response.get("body_text") or "")
    try:
        config = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise AdapterError(
            "prepare-selection-candidate missing fact: the observed config "
            f"returned malformed JSON: {exc}"
        ) from exc
    if not isinstance(config, dict):
        raise AdapterError(
            "prepare-selection-candidate missing fact: the observed config "
            "JSON was not an object"
        )
    default_agent = config.get("default_agent")
    if not isinstance(default_agent, str) or not default_agent.strip():
        raise AdapterError(
            "prepare-selection-candidate missing fact: the observed config "
            "default_agent is not a nonempty string"
        )
    agent_definitions = config.get("agent")
    if agent_definitions is not None and not isinstance(agent_definitions, dict):
        raise AdapterError(
            "prepare-selection-candidate missing fact: the observed config "
            "agent definition map is not an object"
        )
    agent_entry = (
        agent_definitions.get(default_agent)
        if isinstance(agent_definitions, dict)
        else None
    )
    if not isinstance(agent_entry, dict):
        raise AdapterError(
            "prepare-selection-candidate missing fact: the observed config "
            f"has no definition entry for the default agent {default_agent!r}"
        )
    default_agent_model = agent_entry.get("model")
    if not isinstance(default_agent_model, str) or not default_agent_model.strip():
        raise AdapterError(
            "prepare-selection-candidate missing fact: the observed config "
            f"default agent {default_agent!r} entry reports no model string"
        )
    default_model = config.get("model")
    if not isinstance(default_model, str) or not default_model.strip():
        raise AdapterError(
            "prepare-selection-candidate missing fact: the observed config "
            "model is not a nonempty string"
        )
    return {
        "config_digest": hashlib.sha256(raw.encode("utf-8")).hexdigest(),
        "default_agent": default_agent,
        "default_agent_model": default_agent_model,
        "default_model": default_model,
        "omo": _observed_omo_facts(config),
    }


def prepare_selection_candidate(
    root: Path,
    worker_id: str,
    session_id: str,
    *,
    runtime_backend: str,
    output_dir: Path,
) -> dict[str, Any]:
    """Prepare one measured, selection-capable initial-dispatch candidate.

    GET-only and local: it performs no POST, creates or selects no session,
    launches or rebinds no worker, touches no owner lock, and grants no
    dispatch. It does not require or look up an existing visible task, so it
    stays usable before dispatch or task creation; the caller chooses its own
    task-owned output directory explicitly. Every manifest fact is measured
    through existing helpers; a fact that cannot be derived refuses with the
    specific missing detail instead of a fixture constant. The output
    directory must be fresh: an already existing directory or symlink leaf is
    refused instead of overwritten, and the directory is created only after
    every required fact validates. The only writes are the content-addressed
    candidate manifest, the ready-to-pin selector file, the supplement
    selection file, and the preparation record inside that directory. The emitted manifest is always
    ``status=candidate``; it is candidate evidence, never task authority.
    """

    safe_slug(worker_id, "worker")
    if not PROMPT_ASYNC_SESSION_ID_RE.fullmatch(session_id or ""):
        raise AdapterError(
            f"prepare-selection-candidate requires a safe ses_ session id: {session_id!r}"
        )
    if not output_dir.is_absolute():
        raise AdapterError(
            "prepare-selection-candidate requires an absolute --output-dir"
        )
    if output_dir.exists() or output_dir.is_symlink():
        raise AdapterError(
            "prepare-selection-candidate refused: --output-dir already "
            "exists; a fresh task-owned directory is required and existing "
            "evidence is never overwritten"
        )
    record = require_visible_worker(root, worker_id)
    binding = runtime_binding_for_visible_worker(root, worker_id, runtime_backend)
    if binding.get("binding_confidence") != "strong":
        raise AdapterError(
            "prepare-selection-candidate requires a strong binding: "
            f"{binding.get('binding_confidence')}"
        )
    host, port = verified_visible_transport_endpoint(record, binding)
    binding_snapshot = visible_binding_snapshot(record, binding)

    identity = session_identity_snapshot(
        root,
        worker_id,
        session_id,
        runtime_backend=runtime_backend,
    )
    if not identity.get("exists"):
        raise AdapterError(
            "prepare-selection-candidate refused: session "
            f"{session_id!r} is not live on worker {worker_id!r}"
        )
    selection = observed_session_selection(identity)
    supplement_selection_guard(
        original_selection=selection,
        selection_evidence="session_identity_snapshot",
    )

    fetched_doc = fetch_openapi_doc(root, port)
    live_schema = supplement_prompt_async_operation_schema(fetched_doc["doc"])
    live_digest = str(live_schema.get("projection_digest") or "")
    if live_digest != prompt_async_supplement_consumed_schema_digest():
        raise AdapterError(
            "prepare-selection-candidate refused: the live prompt_async "
            "projection does not carry the selection-capable consumed digest"
        )

    runtime_version = _observed_opencode_runtime_version(host, port)
    receipt = _read_control_plane_identity_receipt()
    source_commit = str(receipt.get("source_commit") or "")
    if os.path.realpath(str(receipt.get("target_root") or "")) != os.path.realpath(str(root)):
        raise AdapterError(
            "prepare-selection-candidate missing fact: the control-plane "
            "runtime identity receipt targets "
            f"{receipt.get('target_root')!r}, not {str(root)!r}"
        )
    config_facts = observed_effective_config_facts(host, port)

    profile = f"effective-config-sha256:{config_facts['config_digest']}"
    manifest = build_candidate_bundle_manifest(
        runtime={"type": "opencode", "version": runtime_version},
        adapters=[{"name": "omx_opencode_tui_adapter", "version": source_commit}],
        omo=dict(config_facts["omo"]),
        profile=profile,
        control_plane_revision=source_commit,
        config_digest=config_facts["config_digest"],
        openapi_schema_digest=live_digest,
        consumed_api_contract={
            "endpoints": [
                {
                    "method": "POST",
                    "path": PROMPT_ASYNC_CONSUMED_PROJECTION["path"],
                    "request_fields": ["parts"],
                    "response_fields": [],
                }
            ]
        },
        probed_at=utc_now(),
    )
    manifest_path = write_candidate_bundle_manifest(output_dir, manifest)
    selector = {
        "candidate_manifest_path": str(manifest_path),
        "candidate_bundle_digest": manifest["bundle_digest"],
        "session_id": session_id,
    }
    selector_path = output_dir / "selection-candidate-selector.json"
    write_json(selector_path, selector)
    provenance = {
        "binding": {
            "worker_id": binding_snapshot["worker_id"],
            "pane_id": binding_snapshot["pane_id"],
            "instance_id": binding_snapshot["instance_id"],
            "binding_generation": binding_snapshot["binding_generation"],
            "fencing_generation": binding_snapshot["fencing_generation"],
            "binding_confidence": binding_snapshot["binding_confidence"],
            "port": port,
        },
        "runtime": {"type": "opencode", "version": runtime_version},
        "control_plane": {
            "source_commit": source_commit,
            "receipt_target_root": str(receipt.get("target_root") or ""),
            "receipt_install_event_id": str(receipt.get("install_event_id") or ""),
        },
        "config": {
            "digest": config_facts["config_digest"],
            "digest_prefix": "sha256",
            "default_agent": config_facts["default_agent"],
            "default_agent_model": config_facts["default_agent_model"],
            "default_model": config_facts["default_model"],
            "note": (
                "raw effective config hashed in memory only; only these "
                "scalar facts are allowlisted, never the agent definition map"
            ),
        },
        "omo": dict(config_facts["omo"]),
        "profile": {
            "value": profile,
            "basis": (
                "observed effective-configuration content identity from the "
                "measured GET /config bytes; not a human-named profile, "
                "permission profile, or capability qualification"
            ),
        },
        "substrate": {
            "runtime_backend": runtime_backend,
            "note": "transport substrate evidence, separate from the profile",
        },
        "live_schema": {
            "projection_digest": live_digest,
            "admitted_fields": list(live_schema.get("admitted_fields") or []),
            "doc_text_sha256": fetched_doc.get("doc_text_sha256"),
            "doc_http_status": (fetched_doc.get("http") or {}).get("status"),
        },
        "selection_evidence": {
            "source": "session_identity_snapshot",
            "checked_at": str(identity.get("checked_at") or ""),
        },
    }
    supplement_selection_path = output_dir / "supplement-selection.json"
    write_json(
        supplement_selection_path,
        {**selection, "selection_evidence": provenance["selection_evidence"]["source"]},
    )
    record_payload = {
        "schema_version": 1,
        "record_kind": SELECTION_CANDIDATE_RECORD_KIND,
        "status": SELECTION_CANDIDATE_STATUS,
        "generated_at": utc_now(),
        "worker_id": worker_id,
        "session_id": session_id,
        "selection": supplement_selection_payload(selection),
        "observed_session_selection": selection,
        "selector": selector,
        "manifest": {
            "path": str(manifest_path),
            "bundle_digest": manifest["bundle_digest"],
            "openapi_schema_digest": manifest["openapi_schema_digest"],
            "consumed_projection": "prompt_async_supplement",
        },
        "provenance": provenance,
        "would_post": False,
        "grants_dispatch": False,
        "authority_note": (
            "candidate evidence only; the public initial/supplement commands "
            "re-admit the pinned manifest and still require their own grants"
        ),
    }
    record_path = output_dir / "selection-candidate.json"
    write_json(record_path, record_payload)
    record_payload["record_path"] = str(record_path)
    record_payload["selector_path"] = str(selector_path)
    record_payload["supplement_selection_path"] = str(supplement_selection_path)
    return record_payload


def command_prepare_selection_candidate(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    output_dir = Path(str(args.output_dir or "")).expanduser()
    result = prepare_selection_candidate(
        root,
        str(args.worker),
        str(args.session_id or "").strip(),
        runtime_backend=str(getattr(args, "runtime_backend", default_backend_name())),
        output_dir=output_dir,
    )
    print("OpenCode selection candidate prepared (status=candidate; no POST sent)")
    print(f"worker: {result['worker_id']}")
    print(f"session: {result['session_id']}")
    print(f"selection: {json.dumps(result['selection'], sort_keys=True)}")
    print(f"manifest: {result['manifest']['path']}")
    print(f"bundle digest: {result['manifest']['bundle_digest']}")
    print(f"selector object: {json.dumps(result['selector'], sort_keys=True)}")
    print(f"record: {result['record_path']}")
    print(f"supplement --selection-file: {result['supplement_selection_path']}")
    print(f"selection_candidate_json: {json.dumps(result, sort_keys=True)}")
    return 0


def submit_visible_recovery_runtime(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    runtime_backend: str | None = None,
    reviewed_replacement_session_id: str | None = None,
) -> dict[str, Any]:
    safe_slug(worker_id, "worker")
    ensure_state_team_clean(root)
    backend_name = runtime_backend or default_backend_name()
    record = require_visible_worker(root, worker_id)
    if not record.get("allow_auto_submit"):
        raise AdapterError(
            f"visible worker {worker_id!r} has allow_auto_submit=false"
        )
    require_current_binding_lease(record)

    binding = runtime_binding_for_visible_worker(
        root,
        worker_id,
        backend_name,
    )
    if binding.get("binding_confidence") != "strong":
        raise AdapterError(
            "visible binding is not strong: "
            f"{binding.get('binding_confidence')}"
        )
    host, port = verified_visible_transport_endpoint(record, binding)
    binding_snapshot = visible_binding_snapshot(record, binding)
    side_effect_fence = visible_side_effect_fence(binding_snapshot)
    capability = submit_tui_capability(root, worker_id, binding)
    missing = list(capability.get("missing_required_endpoints", []))
    if missing:
        raise AdapterError(
            "/doc does not confirm required endpoint(s): "
            + ", ".join(missing)
        )

    schema_data = endpoint_schema_for_port(root, port)
    if not schema_data.get("all_payloads_executable"):
        reasons = [
            f"{item.get('path')}: {item.get('reason')}"
            for item in schema_data.get("endpoints", [])
            if not item.get("executable")
        ]
        raise AdapterError(
            "endpoint schema is not safely executable: "
            + "; ".join(reasons)
        )

    tdir = visible_task_dir(root, run, task)
    if not is_relative_to(tdir, framework_root(root)):
        raise AdapterError(
            "visible recovery task must be under .omx/framework/team"
        )
    try:
        task_contract = load_clean_room_task_contract(tdir / "task.json")
    except CleanRoomStartupError as exc:
        raise AdapterError(str(exc)) from exc
    try:
        require_clean_room_startup_gate(root, record, task_contract)
    except CleanRoomStartupError as exc:
        raise AdapterError(str(exc)) from exc
    if not (tdir / ".submitted").is_file():
        raise AdapterError(
            "recovery requires existing .submitted marker: "
            f"{rel(tdir / '.submitted', root)}"
        )
    prompt_path = tdir / "recovery_handshake_prompt.txt"
    if not prompt_path.is_file():
        raise AdapterError(
            f"recovery prompt not found: {rel(prompt_path, root)}"
        )
    prompt_body = read_text(prompt_path)
    if not prompt_body.strip():
        raise AdapterError(
            f"recovery prompt is empty: {rel(prompt_path, root)}"
        )
    expected_owner_lock = require_visible_owner_lock(root, worker_id)
    reviewed_session_id = str(reviewed_replacement_session_id or "")
    validate_recovery_submission_guard(
        root,
        run,
        task,
        worker_id,
        expected_record=record,
        expected_binding=binding,
        expected_owner_lock=expected_owner_lock,
        runtime_backend=backend_name,
        reviewed_replacement_session_id=reviewed_session_id,
    )
    acceptance_fence_path = tdir / "acceptance_fence.json"
    protocol_status = terminal_protocol_submission_status(tdir)
    acceptance_fence = dict(protocol_status.get("fence") or {})
    if not protocol_status.get("ok"):
        write_json(
            tdir / "recovery_handshake_delivery_error.json",
            {
                "schema_version": 1,
                "failed_at": utc_now(),
                "failed_endpoint": "terminal_protocol_identity",
                "blocked_reason": str(protocol_status.get("status") or ""),
                "terminal_protocol": protocol_status.get("classification", {}),
                "acceptance_fence": acceptance_fence,
            },
        )
        raise AdapterError(str(protocol_status.get("status") or "terminal protocol is invalid"))
    if not acceptance_fence_matches_binding(acceptance_fence, binding_snapshot):
        write_json(
            tdir / "recovery_handshake_delivery_error.json",
            {
                "schema_version": 1,
                "failed_at": utc_now(),
                "failed_endpoint": "acceptance_fence",
                "blocked_reason": STALE_ACCEPTANCE_FENCE_ERROR_CODE,
                "acceptance_fence": acceptance_fence,
                "binding_snapshot": binding_snapshot,
            },
        )
        raise AdapterError(STALE_ACCEPTANCE_FENCE_ERROR_CODE)
    reviewed_fence = dict(acceptance_fence)
    if reviewed_session_id:
        reviewed_fence["session_id"] = reviewed_session_id
        reviewed_fence["session_fence_state"] = "live_observed"
    session_preflight = acceptance_session_observation(
        root,
        worker_id,
        reviewed_fence,
        runtime_backend=backend_name,
        allow_pending=False,
        allow_known_idle=True,
        fence_path=(None if reviewed_session_id else acceptance_fence_path),
        allow_expected_idle_identity=False,
    )
    if not session_preflight.get("ok"):
        write_json(
            tdir / "recovery_handshake_delivery_error.json",
            {
                "schema_version": 1,
                "failed_at": utc_now(),
                "failed_endpoint": "acceptance_session_fence",
                "blocked_reason": STALE_ACCEPTANCE_FENCE_ERROR_CODE,
                "acceptance_fence": acceptance_fence,
                "binding_snapshot": binding_snapshot,
                "live_session_observation": session_preflight,
            },
        )
        raise AdapterError(
            f"{STALE_ACCEPTANCE_FENCE_ERROR_CODE}: "
            f"{session_preflight.get('status')}"
        )
    observed_fence = dict(
        session_preflight.get("fence") or reviewed_fence
    )

    payloads = prompt_payloads_from_schema(schema_data, prompt_body)
    attempt = visible_payload_attempt(
        root,
        tdir,
        run,
        task,
        worker_id,
        binding,
        prompt_path,
        prompt_body,
        prompt_body,
        "visible-recovery-handshake",
        True,
        schema_data,
    )
    attempt.update({
        "mode": "visible-recovery-handshake",
        "binding_snapshot": binding_snapshot,
        "side_effect_fence": side_effect_fence,
        "acceptance_fence": acceptance_fence,
        "reviewed_replacement_session_id": reviewed_session_id,
        "adapter_writes_only": [
            "recovery_handshake_delivery.json",
            "recovery_handshake_delivery_error.json",
            "events.jsonl",
        ],
    })

    try:
        pre_effect_record = visible_worker_record(root, worker_id) or record
        pre_effect_binding = runtime_binding_for_visible_worker(root, worker_id, backend_name)
        pre_effect_snapshot = visible_binding_snapshot(pre_effect_record, pre_effect_binding)
        pre_effect_ok = pre_effect_binding.get("binding_confidence") == "strong" and visible_binding_snapshots_match(
            binding_snapshot,
            pre_effect_snapshot,
        )
    except AdapterError as exc:
        pre_effect_snapshot = {"error": str(exc)[:500]}
        pre_effect_ok = False
    if not pre_effect_ok:
        write_json(
            tdir / "recovery_handshake_delivery_error.json",
            {
                **attempt,
                "failed_at": utc_now(),
                "failed_endpoint": "binding_fence",
                "pre_side_effect_binding_snapshot": pre_effect_snapshot,
                "blocked_reason": "binding_fence_mismatch_before_recovery_submit",
            },
        )
        raise AdapterError("binding_fence_mismatch_before_recovery_submit")

    responses: dict[str, Any] = {}
    for endpoint in TUI_ENDPOINTS_ORDERED:
        validate_recovery_submission_guard(
            root,
            run,
            task,
            worker_id,
            expected_record=record,
            expected_binding=binding,
            expected_owner_lock=expected_owner_lock,
            runtime_backend=backend_name,
            reviewed_replacement_session_id=reviewed_session_id,
        )
        fence_check = check_visible_side_effect_fence(
            root,
            worker_id,
            binding_snapshot,
            runtime_backend=backend_name,
            operation=f"visible-recovery-handshake:{endpoint}",
        )
        if not fence_check["ok"]:
            write_json(
                tdir / "recovery_handshake_delivery_error.json",
                {
                    **attempt,
                    "failed_at": utc_now(),
                    "failed_endpoint": "binding_fence",
                    "blocked_reason": STALE_BINDING_ERROR_CODE,
                    "fence_check": fence_check,
                    "responses": responses,
                },
            )
            raise AdapterError(
                f"{STALE_BINDING_ERROR_CODE}: binding changed before recovery {endpoint}"
            )
        session_check = acceptance_session_observation(
            root,
            worker_id,
            observed_fence,
            runtime_backend=backend_name,
            allow_pending=False,
            allow_known_idle=True,
            fence_path=None,
            allow_expected_idle_identity=False,
        )
        if not session_check.get("ok"):
            write_json(
                tdir / "recovery_handshake_delivery_error.json",
                {
                    **attempt,
                    "failed_at": utc_now(),
                    "failed_endpoint": "acceptance_session_fence",
                    "blocked_reason": STALE_ACCEPTANCE_FENCE_ERROR_CODE,
                    "live_session_observation": session_check,
                    "responses": responses,
                },
            )
            raise AdapterError(
                f"{STALE_ACCEPTANCE_FENCE_ERROR_CODE}: "
                f"recovery session changed before recovery {endpoint}"
            )
        if (
            str(session_check.get("status") or "")
            == "known_idle_session_observed"
        ):
            target_session_id = str(observed_fence.get("session_id") or "")
            try:
                canonical_tui_select_session_operation(
                    fetch_openapi_doc(root, port)["doc"]
                )
            except AdapterError as exc:
                write_json(
                    tdir / "recovery_handshake_delivery_error.json",
                    {
                        **attempt,
                        "failed_at": utc_now(),
                        "failed_endpoint": "session_target_binding",
                        "blocked_reason": (
                            "recovery_session_target_binding_unavailable"
                        ),
                        "binding_error": str(exc)[:500],
                        "responses": responses,
                    },
                )
                raise AdapterError(
                    "recovery session target binding unavailable; a saved "
                    "session GET alone does not prove the active TUI "
                    f"target: {str(exc)[:200]}"
                ) from exc
            validate_recovery_submission_guard(
                root,
                run,
                task,
                worker_id,
                expected_record=record,
                expected_binding=binding,
                expected_owner_lock=expected_owner_lock,
                runtime_backend=backend_name,
                reviewed_replacement_session_id=reviewed_session_id,
            )
            binding_fence_check = check_visible_side_effect_fence(
                root,
                worker_id,
                binding_snapshot,
                runtime_backend=backend_name,
                operation=(
                    "visible-recovery-handshake:session-target-binding"
                ),
            )
            if not binding_fence_check["ok"]:
                write_json(
                    tdir / "recovery_handshake_delivery_error.json",
                    {
                        **attempt,
                        "failed_at": utc_now(),
                        "failed_endpoint": "binding_fence",
                        "blocked_reason": STALE_BINDING_ERROR_CODE,
                        "fence_check": binding_fence_check,
                        "responses": responses,
                    },
                )
                raise AdapterError(
                    f"{STALE_BINDING_ERROR_CODE}: binding changed before "
                    "recovery session target binding"
                )
            select_response = safe_http_tui_select_session_post(
                host,
                port,
                target_session_id,
            )
            session_target_binding = {
                "target_session_id": target_session_id,
                "reason": "known_idle_target_binding",
                "endpoint": TUI_SELECT_SESSION_ENDPOINT,
                "response": select_response,
            }
            attempt["session_target_binding"] = session_target_binding
            if not select_response.get("ok"):
                write_json(
                    tdir / "recovery_handshake_delivery_error.json",
                    {
                        **attempt,
                        "failed_at": utc_now(),
                        "failed_endpoint": "session_target_binding",
                        "blocked_reason": (
                            "recovery_session_target_binding_failed"
                        ),
                        "responses": responses,
                    },
                )
                raise AdapterError(
                    "recovery session target binding failed; select-session "
                    "refused the fenced session, so no recovery input "
                    "was sent"
                )
            validate_recovery_submission_guard(
                root,
                run,
                task,
                worker_id,
                expected_record=record,
                expected_binding=binding,
                expected_owner_lock=expected_owner_lock,
                runtime_backend=backend_name,
                reviewed_replacement_session_id=reviewed_session_id,
            )
        response = compact_recovery_http_result(
            safe_http_json_post(
                host,
                port,
                endpoint,
                payloads[endpoint],
            )
        )
        responses[endpoint] = response
        if not response.get("ok"):
            write_json(
                tdir / "recovery_handshake_delivery_error.json",
                {
                    **attempt,
                    "failed_at": utc_now(),
                    "failed_endpoint": endpoint,
                    "responses": responses,
                },
            )
            raise AdapterError(
                "recovery submit failed at "
                f"{endpoint}: status={response.get('status')} "
                f"error_class={response.get('error_class')}"
            )

    session_final = wait_for_acceptance_session_observation(
        root,
        worker_id,
        observed_fence,
        runtime_backend=backend_name,
        fence_path=(None if reviewed_session_id else acceptance_fence_path),
    )
    if session_final.get("ok"):
        observed_fence = dict(
            session_final.get("fence") or observed_fence
        )
    attempt["acceptance_fence"] = acceptance_fence
    attempt["live_session_observation"] = session_final
    attempt["post_delivery_session_observation_ok"] = bool(
        session_final.get("ok")
    )
    submitted_at = utc_now()
    delivery = {
        **attempt,
        "submitted_at": submitted_at,
        "responses": responses,
        "submitted_marker_unchanged": rel(
            tdir / ".submitted",
            root,
        ),
        "received_written_by_adapter": False,
        "terminal_written_by_adapter": False,
    }
    delivery_path = tdir / "recovery_handshake_delivery.json"
    write_json(delivery_path, delivery)
    append_event(tdir / "events.jsonl", {
        "ts": submitted_at,
        "event": "visible_recovery_handshake_submitted",
        "source": "omx_opencode_tui_adapter",
        "worker": worker_id,
        "pane_id": binding.get("pane_id"),
        "port": port,
        "prompt_sha256": attempt["prompt_sha256"],
    })
    post_delivery_session_ok = bool(session_final.get("ok"))
    if not post_delivery_session_ok:
        operator_closeout_command = (
            "./bin/omx_visible_recovery close-interrupted-task "
            f"--root . --run {run.removeprefix('visible-runs/')} "
            f"--task {task} --state blocked "
            "--reason recovery_handshake_session_unverified "
            "--allow-recovery"
        )
    elif reviewed_session_id:
        operator_closeout_command = (
            "./bin/omx_visible_recovery close-interrupted-task "
            f"--root . --run {run.removeprefix('visible-runs/')} "
            f"--task {task} --state blocked --reason '<reason>' "
            "--allow-recovery"
        )
    else:
        operator_closeout_command = ""
    return {
        "mode": "visible-recovery-handshake",
        "worker_id": worker_id,
        "task_path": rel(tdir, root),
        "pane_id": binding.get("pane_id"),
        "port": port,
        "binding_confidence": binding.get("binding_confidence"),
        "responses": responses,
        "delivery_path": rel(delivery_path, root),
        "reviewed_replacement_session_id": reviewed_session_id,
        "post_delivery_session_observation_ok": post_delivery_session_ok,
        "live_session_observation_status": str(
            session_final.get("status") or ""
        ),
        "operator_recovery_closeout_command": operator_closeout_command,
    }


def rotation_instance_directory(host: str, port: int) -> str:
    response = safe_http_request(
        host, port, "/path", "GET", timeout=3.0, limit=8192,
        include_body_text=True,
    )
    if (
        not response.get("ok") or response.get("status") != 200
        or response.get("truncated") or response.get("timed_out")
    ):
        raise AdapterError("model_selection_unsupported: current instance directory unavailable")
    payload = _json_body(response, label="GET /path")
    directory = payload.get("directory") if isinstance(payload, dict) else None
    if not isinstance(directory, str) or not directory or not os.path.isabs(directory):
        raise AdapterError("model_selection_unsupported: current instance directory unavailable")
    return os.path.realpath(directory)


def rotate_with_session_selection(
    root: Path, worker_id: str, *, record: dict[str, Any], binding: dict[str, Any],
    binding_snapshot: dict[str, Any], before_status: dict[str, Any],
    before_tui_evidence: dict[str, Any], runtime_backend: str,
    selection_session_id: str, task_id: str, attempt_id: str,
) -> dict[str, Any]:
    """Rotate through supported session APIs; never infer a model from TUI labels."""
    host, port = verified_visible_transport_endpoint(record, binding)
    ids = before_status.get("session_ids") or []
    continuity: dict[str, Any] = {
        "status": "model_selection_unsupported", "before": {}, "after": {},
        "before_source": "unavailable", "after_source": "unavailable",
        "limit": "Session metadata measures selection, not the model actually invoked by a future prompt.",
    }
    result: dict[str, Any] = {
        "schema_version": 1, "mode": "execute-command-real", "worker_id": worker_id,
        "pane_id": binding.get("pane_id"), "pane_pid": binding.get("pane_pid"),
        "port": port, "binding_confidence": binding.get("binding_confidence"),
        "binding_snapshot": binding_snapshot, "post_binding_snapshot": {},
        "side_effect_fence": visible_side_effect_fence(binding_snapshot),
        "endpoint": SESSION_CREATE_ENDPOINT, "command_body": RESET_SLASH_COMMAND_BODY,
        "transport_command_body": "", "reset_transport_executed": False,
        "reset_evidence_found": False, "reset_command_ack_found": False,
        "reset_status_before_ids": ids, "reset_status_after_ids": [],
        "reset_session_id": "", "reset_epoch": 0, "reset_session_evidence_found": False,
        "reset_status_cleared_found": False, "reset_status_empty_found": False,
        "reset_tui_home_evidence_found": False, "reset_tui_capture_markers": [],
        "selection_continuity": continuity, "responses": {}, "blocked_reasons": [],
        "adapter_writes_visible_run_task": False, "adapter_writes_terminal_markers": False,
        **before_tui_evidence,
    }
    try:
        current_home = reset_tui_home_evidence(binding, timeout_seconds=0, current_home_only=True) if not ids else {}
        home = bool(
            not ids and before_status.get("status_count") == 0
            and before_status.get("session_status") == {}
            and current_home.get("reset_tui_home_evidence_found")
            and current_home.get("reset_tui_capture_ok")
        )
        if home:
            after = session_status_snapshot(root, worker_id, runtime_backend=runtime_backend)
            tui = reset_tui_home_evidence(binding, timeout_seconds=0, current_home_only=True)
            result.update(tui)
            if (
                after.get("status_count") != 0 or after.get("session_status") != {}
                or after.get("session_ids") != []
                or not tui.get("reset_tui_capture_ok")
                or not tui.get("reset_tui_home_evidence_found")
            ):
                raise AdapterError("model_selection_observation_conflict: fresh home changed")
            result.update(reset_status_empty_found=True, reset_evidence_found=True,
                          evidence_source="fresh_home_reobserved_without_reset")
            continuity.update(status="preserved_fresh_home",
                              before_source="visible_fresh_home", after_source="visible_fresh_home",
                              limit="No reset/create/select was sent; in-memory selection untouched; exact IDs unavailable at home.")
        else:
            source_id = selection_session_id or str(record.get("session_id") or "")
            if selection_session_id and record.get("session_id") and selection_session_id != record["session_id"]:
                raise AdapterError("model_selection_observation_conflict: bound/source sessions disagree")
            if not PROMPT_ASYNC_SESSION_ID_RE.fullmatch(source_id):
                current_markers = set(
                    current_home.get("reset_tui_capture_markers") or []
                )
                if (
                    not ids
                    and current_home.get("reset_tui_capture_ok")
                    and "current_home_logo" in current_markers
                    and "commands_hint" not in current_markers
                ):
                    # Insufficient current-frame viewport evidence, not proof of
                    # an unsupported model/session: keep the observed partial
                    # home markers and the blocked reason/remedy on the refused
                    # runtime result, which the CLI output prints; the persisted
                    # rotation receipt carries selection_continuity.status, not
                    # these markers.
                    result.update(
                        reset_tui_capture_ok=True,
                        reset_tui_capture_returncode=current_home.get(
                            "reset_tui_capture_returncode"
                        ),
                        reset_tui_capture_markers=[
                            marker
                            for marker in (
                                "ask_anything",
                                "commands_hint",
                                "current_home_logo",
                            )
                            if marker in current_markers
                        ],
                    )
                    raise AdapterError(
                        "model_selection_current_frame_home_hint_missing: current"
                        " frame shows the default home logo and Ask anything prompt"
                        " without the ctrl+p commands hint; a missing hint alone"
                        " does not prove viewport clipping or an unsupported model."
                        " Bounded reversible remedy for a user-owned pane:"
                        " temporarily zoom the same pane (tmux resize-pane -Z"
                        " -t target-pane), rerun this check so it re-observes one full"
                        " current frame, then restore the layout with the same"
                        " toggle; no automatic layout, session or model change."
                    )
                raise AdapterError("model_selection_unsupported: no exact source session")
            if ids and ids != [source_id]:
                raise AdapterError("model_selection_observation_conflict: source/status disagree")
            source = session_identity_snapshot(root, worker_id, source_id, runtime_backend=runtime_backend)
            if not source.get("exists") or source.get("observed_session_id") != source_id:
                raise AdapterError("model_selection_unsupported: source identity unavailable")
            selection = observed_session_selection(source)
            continuity.update(before=selection, before_source="GET /session/{sessionID}")
            supplement_selection_guard(original_selection=selection, selection_evidence="rotation source session")
            require_rotation_selection_schema(fetch_openapi_doc(root, port)["doc"])
            title = f"omx:{task_id}:{attempt_id}:rotation"
            project = rotation_instance_directory(host, port)
            result["rotation_project_directory"] = project
            if not source.get("observed_directory") or os.path.realpath(str(source["observed_directory"])) != project:
                raise AdapterError("model_selection_observation_conflict: source project mismatch")
            require_visible_side_effect_fence(root, worker_id, binding_snapshot,
                runtime_backend=runtime_backend, operation="rotation:/session")
            # Re-read the exact source immediately before creating a replacement.
            current = session_identity_snapshot(root, worker_id, source_id, runtime_backend=runtime_backend)
            if not current.get("exists") or session_selection_errors(observed_session_selection(current), selection):
                raise AdapterError("model_selection_observation_conflict: source selection changed")
            if (
                current.get("observed_session_id") != source_id
                or not current.get("observed_directory")
                or os.path.realpath(str(current["observed_directory"])) != project
                or rotation_instance_directory(host, port) != project
            ):
                raise AdapterError("model_selection_observation_conflict: source project changed")
            created = safe_http_session_create_post(host, port, title, [], selection=selection)
            result["responses"][SESSION_CREATE_ENDPOINT] = compact_http_result(created, include_body_head=True)
            result["reset_transport_executed"] = True
            if not created.get("ok"):
                raise AdapterError("model_selection_unsupported: session creation failed or uncertain; do not retry")
            session = json.loads(str(created.get("body_head") or ""))
            new_id = str(session.get("id") or "") if isinstance(session, dict) else ""
            result["reset_session_id"] = new_id
            result["rotation_source_session_id"] = source_id
            if (
                not PROMPT_ASYNC_SESSION_ID_RE.fullmatch(new_id) or new_id == source_id
                or session.get("title") != title
                or os.path.realpath(str(session.get("directory") or "")) != os.path.realpath(project)
            ):
                raise AdapterError("model_selection_observation_conflict: created identity mismatch")
            identity = session_identity_snapshot(root, worker_id, new_id, runtime_backend=runtime_backend)
            continuity.update(after=observed_session_selection(identity), after_source="GET /session/{sessionID}")
            if not identity.get("exists") or session_selection_errors(continuity["after"], selection):
                raise AdapterError("model_selection_drift: created selection differs")
            if not identity.get("observed_directory") or os.path.realpath(str(identity["observed_directory"])) != project:
                raise AdapterError("model_selection_observation_conflict: created project mismatch")
            messages = session_messages_snapshot(root, worker_id, new_id, runtime_backend=runtime_backend)
            if messages.get("ok") is not True or messages.get("messages") != [] or messages.get("message_count") != 0:
                raise AdapterError("model_selection_observation_conflict: new session is not proven empty")
            require_visible_side_effect_fence(root, worker_id, binding_snapshot,
                runtime_backend=runtime_backend, operation="rotation:/tui/select-session")
            selected = safe_http_tui_select_session_post(host, port, new_id)
            result["responses"][TUI_SELECT_SESSION_ENDPOINT] = compact_http_result(selected)
            if not selected.get("ok"):
                raise AdapterError("model_selection_observation_conflict: visible session selection failed or uncertain")
            after = session_identity_snapshot(root, worker_id, new_id, runtime_backend=runtime_backend)
            continuity["after"] = observed_session_selection(after)
            if not after.get("exists") or session_selection_errors(continuity["after"], selection):
                raise AdapterError("model_selection_drift: post-select identity differs")
            if not after.get("observed_directory") or os.path.realpath(str(after["observed_directory"])) != project:
                raise AdapterError("model_selection_observation_conflict: post-select project mismatch")
            result.update(reset_evidence_found=True, reset_session_evidence_found=True,
                          evidence_source="empty_session_created_exact_selection_and_tui_select_ack")
            continuity.update(status="preserved_session_selection", visible_select_ack=True,
                              limit="Exact session GET selection plus public TUI select ACK; no independent TUI selection getter and no prompt invoked.")
        post_binding = runtime_binding_for_visible_worker(root, worker_id, runtime_backend)
        result["post_binding_snapshot"] = visible_binding_snapshot(record, post_binding)
        if not visible_binding_snapshots_match(binding_snapshot, result["post_binding_snapshot"]):
            raise AdapterError("binding_changed_during_reset")
    except (AdapterError, ValueError, TypeError, KeyError) as exc:
        result["reset_evidence_found"] = False
        error = str(exc)
        continuity["status"] = error.split(":", 1)[0] if error.startswith("model_selection_") else "model_selection_unsupported"
        result["blocked_reasons"].append(error)
    result["checked_at"] = result["executed_at"] = utc_now()
    result.setdefault("evidence_source", "selection_rotation_preflight")
    return result


def execute_command_real_runtime(
    root: Path,
    worker_id: str,
    command_body: str,
    *,
    runtime_backend: str | None = None,
    task_id: str = "",
    attempt_id: str = "",
    role: str = "",
    contract_hash: str = "",
    rotation_reason: str = "manual_new",
    rehydration_packet_type: str = "new-task",
    context_domain_id: str = "",
    previous_context_domain_id: str = "",
    same_context_domain_continuity_proven: bool = False,
    worker_process_restarted_after_last_task: bool = False,
    process_restart_evidence: str = "",
    selection_session_id: str = "",
) -> dict[str, Any]:
    safe_slug(worker_id, "worker")
    if command_body != RESET_SLASH_COMMAND_BODY:
        raise AdapterError("execute-command-real only supports the exact /new slash command")
    context_domain = context_domain_evidence(
        current_context_domain_id=context_domain_id,
        previous_context_domain_id=previous_context_domain_id,
        same_context_domain_continuity_proven=same_context_domain_continuity_proven,
    )
    if rotation_reason == "context_domain_changed" and not context_domain["changed"]:
        raise AdapterError(
            "context_domain_changed rotation requires different non-empty current and previous context-domain ids"
        )
    if worker_process_restarted_after_last_task and not str(process_restart_evidence or "").strip():
        raise AdapterError(
            "worker process restart classification requires non-empty process restart evidence"
        )
    ensure_state_team_clean(root)
    backend_name = runtime_backend or default_backend_name()
    record = require_visible_worker(root, worker_id)
    if not record.get("allow_auto_submit"):
        raise AdapterError(f"visible worker {worker_id!r} has allow_auto_submit=false")

    binding = runtime_binding_for_visible_worker(root, worker_id, backend_name)
    binding_snapshot = visible_binding_snapshot(record, binding)
    side_effect_fence = visible_side_effect_fence(binding_snapshot)
    if binding.get("binding_confidence") != "strong":
        checked_at = utc_now()
        return {
            "schema_version": 1,
            "executed_at": checked_at,
            "mode": "execute-command-real",
            "worker_id": worker_id,
            "pane_id": binding_snapshot.get("pane_id"),
            "pane_pid": binding_snapshot.get("pane_pid"),
            "port": int(binding_snapshot.get("port") or 0),
            "binding_confidence": binding_snapshot.get("binding_confidence"),
            "binding_snapshot": binding_snapshot,
            "side_effect_fence": side_effect_fence,
            "endpoint": RESET_COMMAND_ENDPOINT,
            "command_body": command_body,
            "transport_command_body": RESET_TUI_COMMAND_BODY,
            "payload_field": "",
            "response": {},
            "reset_transport_executed": False,
            "reset_session_evidence_found": False,
            "reset_session_id": "",
            "reset_epoch": 0,
            "checked_at": checked_at,
            "evidence_source": "binding_preflight",
            "reset_status_before_ids": [],
            "reset_status_after_ids": [],
            "reset_status_cleared_found": False,
            "reset_status_checked_at": checked_at,
            "reset_tui_home_before_evidence_found": False,
            "reset_tui_home_before_capture_ok": False,
            "reset_tui_home_before_evidence_source": "",
            "reset_tui_home_before_capture_returncode": None,
            "reset_tui_home_before_capture_markers": [],
            "reset_tui_home_refresh_attempted": False,
            "reset_tui_home_refresh_response": {},
            "reset_tui_home_refresh_evidence_found": False,
            "reset_tui_home_evidence_found": False,
            "reset_tui_capture_ok": False,
            "reset_tui_evidence_source": "",
            "reset_tui_capture_returncode": None,
            "reset_tui_capture_markers": [],
            "reset_command_ack_found": False,
            "reset_evidence_found": False,
            "blocked_reasons": ["stale_or_weak_binding"],
            "adapter_writes_visible_run_task": False,
            "adapter_writes_terminal_markers": False,
            "rotation_receipt_path": "",
            "rotation_receipt": {},
        }

    host, port = verified_visible_transport_endpoint(record, binding)
    schema_data = reset_endpoint_schema_for_port(root, port)
    if not schema_data.get("all_payloads_executable"):
        reasons = [
            f"{item.get('path')}: {item.get('reason')}"
            for item in schema_data.get("endpoints", [])
            if not item.get("executable")
        ]
        raise AdapterError("reset endpoint schema is not safely executable: " + "; ".join(reasons))

    payload = execute_command_payload_from_schema(schema_data, command_body)
    pre_effect_check = check_visible_side_effect_fence(
        root,
        worker_id,
        binding_snapshot,
        runtime_backend=backend_name,
        operation="execute-command-real:/new",
    )
    pre_effect_snapshot = pre_effect_check["current_binding_snapshot"]
    pre_effect_ok = bool(pre_effect_check["ok"])
    if not pre_effect_ok:
        checked_at = utc_now()
        return {
            "schema_version": 1,
            "executed_at": checked_at,
            "mode": "execute-command-real",
            "worker_id": worker_id,
            "pane_id": binding_snapshot.get("pane_id"),
            "pane_pid": binding_snapshot.get("pane_pid"),
            "port": port,
            "binding_confidence": binding_snapshot.get("binding_confidence"),
            "binding_snapshot": binding_snapshot,
            "pre_side_effect_binding_snapshot": pre_effect_snapshot,
            "side_effect_fence": side_effect_fence,
            "endpoint": RESET_COMMAND_ENDPOINT,
            "command_body": command_body,
            "transport_command_body": RESET_TUI_COMMAND_BODY,
            "payload_field": next(iter(payload.keys()), ""),
            "response": {},
            "reset_transport_executed": False,
            "reset_session_evidence_found": False,
            "reset_session_id": "",
            "reset_epoch": 0,
            "checked_at": checked_at,
            "evidence_source": "binding_fence_preflight",
            "reset_status_before_ids": [],
            "reset_status_after_ids": [],
            "reset_status_cleared_found": False,
            "reset_status_checked_at": checked_at,
            "reset_tui_home_before_evidence_found": False,
            "reset_tui_home_before_capture_ok": False,
            "reset_tui_home_before_evidence_source": "",
            "reset_tui_home_before_capture_returncode": None,
            "reset_tui_home_before_capture_markers": [],
            "reset_tui_home_refresh_attempted": False,
            "reset_tui_home_refresh_response": {},
            "reset_tui_home_refresh_evidence_found": False,
            "reset_tui_home_evidence_found": False,
            "reset_tui_capture_ok": False,
            "reset_tui_evidence_source": "",
            "reset_tui_capture_returncode": None,
            "reset_tui_capture_markers": [],
            "reset_command_ack_found": False,
            "reset_evidence_found": False,
            "blocked_reasons": ["binding_fence_mismatch_before_reset"],
            "error_code": STALE_BINDING_ERROR_CODE,
            "fence_diagnostic_path": pre_effect_check["diagnostic_path"],
            "adapter_writes_visible_run_task": False,
            "adapter_writes_terminal_markers": False,
            "rotation_receipt_path": "",
            "rotation_receipt": {},
        }
    before_status = session_status_snapshot(root, worker_id, runtime_backend=backend_name)
    before_session_ids = {
        str(item).strip()
        for item in before_status.get("session_ids", [])
        if str(item).strip()
    }
    before_tui_raw = (
        reset_tui_home_evidence(binding)
        if not before_session_ids and backend_name == "tmux-reference"
        else {
            "reset_tui_home_evidence_found": False,
            "reset_tui_capture_ok": False,
            "reset_tui_evidence_source": "",
            "reset_tui_capture_returncode": None,
            "reset_tui_capture_markers": [],
        }
    )
    before_tui_evidence = {
        "reset_tui_home_before_evidence_found": bool(
            before_tui_raw.get("reset_tui_home_evidence_found")
        ),
        "reset_tui_home_before_capture_ok": bool(
            before_tui_raw.get("reset_tui_capture_ok")
        ),
        "reset_tui_home_before_evidence_source": (
            "tmux_capture_home_before_reset"
            if before_tui_raw.get("reset_tui_home_evidence_found")
            else ""
        ),
        "reset_tui_home_before_capture_returncode": before_tui_raw.get(
            "reset_tui_capture_returncode"
        ),
        "reset_tui_home_before_capture_markers": list(
            before_tui_raw.get("reset_tui_capture_markers") or []
        ),
    }
    if task_id:
        result = rotate_with_session_selection(
            root, worker_id, record=record, binding=binding,
            binding_snapshot=binding_snapshot, before_status=before_status,
            before_tui_evidence=before_tui_evidence,
            runtime_backend=backend_name, selection_session_id=selection_session_id,
            task_id=task_id, attempt_id=attempt_id,
        )
        receipt = build_rotation_receipt(
            result, task_id=task_id, attempt_id=attempt_id, role=role,
            contract_hash=contract_hash, rotation_reason=rotation_reason,
            rehydration_packet_type=rehydration_packet_type,
            context_domain_id=context_domain_id,
            previous_context_domain_id=previous_context_domain_id,
            same_context_domain_continuity_proven=same_context_domain_continuity_proven,
            worker_process_restarted_after_last_task=worker_process_restarted_after_last_task,
            process_restart_evidence=process_restart_evidence,
        )
        result["rotation_receipt_path"] = rel(write_rotation_receipt(root, receipt), root)
        result["rotation_receipt"] = receipt
        return result
    response = safe_http_json_post_reset(host, port, RESET_COMMAND_ENDPOINT, payload)
    evidence = reset_evidence_from_execute_command_response(response)
    reset_command_ack_found = bool(response.get("ok") and RESET_TUI_COMMAND_BODY in payload.values())
    status_evidence = (
        reset_status_clear_evidence(root, worker_id, before_status, runtime_backend=backend_name)
        if response.get("ok")
        else {
            "reset_status_before_ids": before_status.get("session_ids", []),
            "reset_status_after_ids": [],
            "reset_status_cleared_found": False,
            "reset_status_checked_at": "",
        }
    )
    tui_evidence = (
        reset_tui_home_evidence(binding)
        if response.get("ok") and backend_name == "tmux-reference"
        else {
            "reset_tui_home_evidence_found": False,
            "reset_tui_capture_ok": False,
            "reset_tui_evidence_source": "",
            "reset_tui_capture_returncode": None,
            "reset_tui_capture_markers": [],
        }
    )
    reset_idle_home_evidence_found = bool(
        reset_command_ack_found
        and before_tui_evidence["reset_tui_home_before_evidence_found"]
        and not before_session_ids
        and not status_evidence.get("reset_status_after_ids")
    )
    structured_process_evidence = verified_process_restart_evidence(
        root,
        worker_id,
        process_restart_evidence,
        binding_snapshot,
    )
    process_restart_evidence_valid = bool(
        process_restart_evidence
        and (
            not process_restart_evidence.startswith("{")
            or structured_process_evidence
        )
    )
    reset_fresh_process_history = worker_fresh_process_history(
        root,
        worker_id,
        process_evidence=structured_process_evidence or None,
    )
    reset_fresh_process_evidence_found = bool(
        reset_command_ack_found
        and bool(worker_process_restarted_after_last_task)
        and process_restart_evidence_valid
        and binding_snapshot.get("binding_confidence") == "strong"
        and bool(binding_snapshot.get("launch_owned_match"))
        and not before_session_ids
        and not status_evidence.get("reset_status_after_ids")
        and reset_fresh_process_history.get("safe_for_fresh_process_reset")
    )
    reset_tui_home_refresh_attempted = bool(
        reset_command_ack_found
        and backend_name == "tmux-reference"
        and not status_evidence.get("reset_status_after_ids")
        and not tui_evidence.get("reset_tui_home_evidence_found")
        and not reset_idle_home_evidence_found
    )
    reset_tui_home_refresh_response: dict[str, Any] = {}
    reset_tui_home_refresh_evidence_found = False
    reset_tui_home_refresh_fence_mismatch = False
    if reset_tui_home_refresh_attempted:
        refresh_schema = endpoint_schema_for_port(root, port)
        refresh_item = schema_endpoint_by_path(refresh_schema).get(
            "/tui/clear-prompt"
        )
        if refresh_item and refresh_item.get("executable"):
            refresh_fence_check = check_visible_side_effect_fence(
                root,
                worker_id,
                binding_snapshot,
                runtime_backend=backend_name,
                operation="execute-command-real:/new:clear-prompt",
            )
            if not refresh_fence_check["ok"]:
                reset_tui_home_refresh_fence_mismatch = True
                reset_tui_home_refresh_response = {
                    "ok": False,
                    "status": 0,
                    "error": "binding changed before clear-prompt refresh",
                    "error_code": STALE_BINDING_ERROR_CODE,
                    "diagnostic_path": refresh_fence_check["diagnostic_path"],
                }
            else:
                reset_tui_home_refresh_response = safe_http_json_post(
                    host,
                    port,
                    "/tui/clear-prompt",
                    {},
                )
                if reset_tui_home_refresh_response.get("ok"):
                    refreshed_tui_evidence = reset_tui_home_evidence(binding)
                    reset_tui_home_refresh_evidence_found = bool(
                        refreshed_tui_evidence.get(
                            "reset_tui_home_evidence_found"
                        )
                    )
                    if reset_tui_home_refresh_evidence_found:
                        tui_evidence = {
                            **refreshed_tui_evidence,
                            "reset_tui_evidence_source": (
                                "tmux_capture_home_after_clear_prompt"
                            ),
                        }
        else:
            reset_tui_home_refresh_response = {
                "ok": False,
                "status": 0,
                "error": "clear_prompt_endpoint_not_executable",
            }
    reset_evidence_found = bool(
        evidence.get("reset_session_evidence_found")
        or status_evidence.get("reset_status_cleared_found")
        or tui_evidence.get("reset_tui_home_evidence_found")
        or reset_idle_home_evidence_found
        or reset_fresh_process_evidence_found
    )
    blocked_reasons = [] if reset_evidence_found else list(evidence.get("blocked_reasons", []))
    if reset_command_ack_found and not reset_evidence_found:
        blocked_reasons.append("reset_status_not_cleared")
    if reset_tui_home_refresh_fence_mismatch:
        blocked_reasons.append("binding_fence_mismatch_before_clear_prompt")
    post_binding_snapshot: dict[str, Any] = {}
    if reset_evidence_found:
        try:
            post_record = visible_worker_record(root, worker_id) or record
            post_binding = runtime_binding_for_visible_worker(root, worker_id, backend_name)
            post_binding_snapshot = visible_binding_snapshot(post_record, post_binding)
            if post_binding.get("binding_confidence") != "strong" or not visible_binding_snapshots_match(
                binding_snapshot,
                post_binding_snapshot,
            ):
                reset_evidence_found = False
                blocked_reasons.append("binding_changed_during_reset")
        except AdapterError as exc:
            reset_evidence_found = False
            post_binding_snapshot = {"error": str(exc)[:500]}
            blocked_reasons.append("binding_changed_during_reset")
    result = {
        "schema_version": 1,
        "executed_at": utc_now(),
        "mode": "execute-command-real",
        "worker_id": worker_id,
        "pane_id": binding.get("pane_id"),
        "pane_pid": binding.get("pane_pid"),
        "port": port,
        "binding_confidence": binding.get("binding_confidence"),
        "binding_snapshot": binding_snapshot,
        "post_binding_snapshot": post_binding_snapshot,
        "pre_side_effect_binding_snapshot": pre_effect_snapshot,
        "side_effect_fence": side_effect_fence,
        "endpoint": RESET_COMMAND_ENDPOINT,
        "command_body": command_body,
        "transport_command_body": RESET_TUI_COMMAND_BODY,
        "payload_field": next(iter(payload.keys()), ""),
        "response": response,
        **evidence,
        **status_evidence,
        **before_tui_evidence,
        **tui_evidence,
        "reset_idle_home_evidence_found": reset_idle_home_evidence_found,
        "reset_fresh_process_evidence_found": reset_fresh_process_evidence_found,
        "reset_fresh_process_history": reset_fresh_process_history,
        "process_restart_evidence": str(process_restart_evidence or "").strip(),
        "reset_tui_home_refresh_attempted": reset_tui_home_refresh_attempted,
        "reset_tui_home_refresh_response": reset_tui_home_refresh_response,
        "reset_tui_home_refresh_evidence_found": (
            reset_tui_home_refresh_evidence_found
        ),
        "reset_command_ack_found": reset_command_ack_found,
        "reset_evidence_found": reset_evidence_found,
        "blocked_reasons": blocked_reasons,
        "adapter_writes_visible_run_task": False,
        "adapter_writes_terminal_markers": False,
        "rotation_receipt_path": "",
        "rotation_receipt": {},
    }
    if reset_evidence_found:
        receipt = build_rotation_receipt(
            result,
            task_id=task_id,
            attempt_id=attempt_id,
            role=role,
            contract_hash=contract_hash,
            rotation_reason=rotation_reason,
            rehydration_packet_type=rehydration_packet_type,
            context_domain_id=context_domain_id,
            previous_context_domain_id=previous_context_domain_id,
            same_context_domain_continuity_proven=same_context_domain_continuity_proven,
            worker_process_restarted_after_last_task=worker_process_restarted_after_last_task,
            process_restart_evidence=process_restart_evidence,
        )
        receipt_path = write_rotation_receipt(root, receipt)
        result["rotation_receipt_path"] = rel(receipt_path, root)
        result["rotation_receipt"] = receipt
    if not response.get("ok"):
        blocked_reasons.append("execute_command_endpoint_failed")
    return result


def verify_reset_recovery_real_runtime(
    root: Path,
    worker_id: str,
    *,
    source_run: str,
    source_task: str,
    runtime_backend: str | None = None,
    task_id: str = "",
    attempt_id: str = "",
    role: str = "",
    contract_hash: str = "",
    rotation_reason: str = "manual_new",
    rehydration_packet_type: str = "new-task",
    context_domain_id: str = "",
    previous_context_domain_id: str = "",
    recovery_reservation_id: str,
    target_run_root: Path,
    expected_first_lane_id: str,
    expected_first_request_hash: str,
    expected_first_dispatch_hash: str,
) -> dict[str, Any]:
    safe_slug(worker_id, "worker")
    safe_slug(source_task, "source task")
    safe_framework_run_parts(source_run, "source run")
    safe_slug(expected_first_lane_id, "expected first lane")
    if (
        not expected_first_request_hash
        or not expected_first_dispatch_hash
    ):
        raise AdapterError(
            "reset recovery first-dispatch hashes are required"
        )
    try:
        parsed_reservation_id = str(
            uuid.UUID(recovery_reservation_id)
        )
    except ValueError as exc:
        raise AdapterError(
            "recovery reservation id must be a UUID"
        ) from exc
    if parsed_reservation_id != recovery_reservation_id:
        raise AdapterError(
            "recovery reservation id must use canonical UUID form"
        )
    if (
        not target_run_root.is_absolute()
        or ".." in target_run_root.parts
        or any(
            path.is_symlink()
            for path in (target_run_root, *target_run_root.parents)
        )
    ):
        raise AdapterError(
            "reset recovery target run root is invalid"
        )
    target_run_root = target_run_root.resolve(strict=False)
    unsafe_runtime_root = (
        root.resolve(strict=False) / ".omx"
    ).resolve(strict=False)
    if (
        target_run_root == unsafe_runtime_root
        or unsafe_runtime_root in target_run_root.parents
        or not target_run_root.is_dir()
    ):
        raise AdapterError(
            "reset recovery target run root is invalid"
        )
    ensure_state_team_clean(root)
    backend_name = runtime_backend or default_backend_name()
    if backend_name != "tmux-reference":
        raise AdapterError(
            "verify-reset-recovery-real requires tmux-reference"
        )

    task_directory = visible_task_dir(root, source_run, source_task)
    task_segments = (
        task_directory,
        task_directory.parent,
        task_directory.parent.parent,
    )
    if any(path.is_symlink() for path in task_segments):
        raise AdapterError("reset recovery source task must not use symlinks")
    if not task_directory.is_dir():
        raise AdapterError("reset recovery source task is missing")
    owner = read_text(task_directory / "owner").strip()
    if owner != worker_id:
        raise AdapterError("reset recovery source task owner mismatch")
    forbidden = (
        ".submitted",
        ".started",
        ".done",
        ".fail",
        ".blocked",
        "report.md",
        "session_rotation.json",
    )
    if any((task_directory / name).exists() for name in forbidden):
        raise AdapterError(
            "reset recovery source task has dispatch or prior receipt evidence"
        )
    expected_action = {
        "worker_id": worker_id,
        "session_action": "rotate",
        "session_action_reason": rotation_reason,
        "task_id": task_id,
        "attempt_id": attempt_id,
        "role": role,
        "contract_hash": contract_hash,
        "rotation_reason": rotation_reason,
        "rehydration_packet_type": rehydration_packet_type,
        "context_domain_id": context_domain_id,
        "previous_context_domain_id": previous_context_domain_id,
    }
    action = read_json_safe(task_directory / "session_action.json")
    action_mismatches = [
        field
        for field, value in expected_action.items()
        if str(action.get(field) or "") != str(value or "")
    ]
    if action_mismatches:
        raise AdapterError(
            "reset recovery session action mismatch: "
            + ", ".join(action_mismatches)
        )

    error_sidecar = read_json_safe(
        task_directory / "session_rotation_error.json"
    )
    expected_error_identity = {
        "worker": worker_id,
        "run": source_run.removeprefix("visible-runs/"),
        "task": source_task,
    }
    error_mismatches = [
        field
        for field, value in expected_error_identity.items()
        if str(error_sidecar.get(field) or "") != value
    ]
    error_lines = {
        line.strip()
        for line in str(error_sidecar.get("error") or "").splitlines()
    }
    required_error_lines = {
        "reset_transport_executed: true",
        "reset_command_ack_found: true",
        "reset_evidence_found: false",
        "rotation_receipt:",
    }
    if error_mismatches or not required_error_lines <= error_lines:
        raise AdapterError(
            "reset recovery source does not prove an acknowledged "
            "unreceipted reset"
        )

    finalizer = read_json_safe(task_directory / "finalizer_event.json")
    if (
        str(finalizer.get("run") or "")
        != source_run.removeprefix("visible-runs/")
        or str(finalizer.get("task") or "") != source_task
        or str(finalizer.get("final_protocol_terminal_state") or "")
        != "prepared"
        or finalizer.get("active_lock_before") is not False
        or str(finalizer.get("lock_state_after_run_one") or "") != "none"
    ):
        raise AdapterError(
            "reset recovery source task did not finalize without a lock"
        )

    record = require_visible_worker(root, worker_id)
    if not record.get("allow_auto_submit"):
        raise AdapterError(
            f"visible worker {worker_id!r} has allow_auto_submit=false"
        )
    binding = runtime_binding_for_visible_worker(
        root,
        worker_id,
        backend_name,
    )
    if binding.get("binding_confidence") != "strong":
        raise AdapterError("reset recovery requires a strong binding")
    binding_snapshot = visible_binding_snapshot(record, binding)
    acceptance_fence = read_json_safe(
        task_directory / "acceptance_fence.json"
    )
    if (
        str(acceptance_fence.get("task_id") or "") != source_task
        or not acceptance_fence_matches_binding(
            acceptance_fence,
            binding_snapshot,
        )
    ):
        raise AdapterError(
            "reset recovery source acceptance fence no longer matches"
        )
    dispatch = read_json_safe(task_directory / "dispatch.json")
    source_record = dispatch.get("worker_record")
    if (
        str(dispatch.get("run") or "").removeprefix("visible-runs/")
        != source_run.removeprefix("visible-runs/")
        or str(dispatch.get("task") or "") != source_task
        or str(dispatch.get("worker") or "") != worker_id
        or dispatch.get("submitted") is not False
        or not isinstance(source_record, dict)
    ):
        raise AdapterError("reset recovery source dispatch identity mismatch")
    source_snapshot = visible_binding_snapshot(
        source_record,
        source_record,
    )
    lifecycle_fields = (
        "host_boot_id",
        "opencode_pid",
        "opencode_start_time_ticks",
        "pane_start_time_ticks",
        "tmux_server_pid",
    )
    if (
        not visible_binding_snapshots_match(
            source_snapshot,
            binding_snapshot,
        )
        or any(
            str(source_record.get(field) or "")
            != str(record.get(field) or "")
            for field in lifecycle_fields
        )
    ):
        raise AdapterError(
            "reset recovery source worker process no longer matches"
        )

    with reset_recovery_owner_reservation(
        root,
        worker_id,
        source_run=source_run,
        source_task=source_task,
        record=record,
        contract_hash=contract_hash,
        recovery_reservation_id=recovery_reservation_id,
        target_run_root=target_run_root,
        expected_first_lane_id=expected_first_lane_id,
        expected_first_request_hash=expected_first_request_hash,
        expected_first_dispatch_hash=expected_first_dispatch_hash,
    ) as reservation_lock:
        status = session_status_snapshot(
            root,
            worker_id,
            runtime_backend=backend_name,
        )
        if status.get("session_ids") or int(
            status.get("status_count") or 0
        ):
            raise AdapterError(
                "reset recovery requires an empty session status"
            )
        tui_evidence = reset_tui_home_evidence(binding)
        if not tui_evidence.get("reset_tui_home_evidence_found"):
            raise AdapterError(
                "reset recovery requires complete TUI home evidence"
            )

        post_record = require_visible_worker(root, worker_id)
        post_binding = runtime_binding_for_visible_worker(
            root,
            worker_id,
            backend_name,
        )
        post_binding_snapshot = visible_binding_snapshot(
            post_record,
            post_binding,
        )
        if (
            post_binding.get("binding_confidence") != "strong"
            or not visible_binding_snapshots_match(
                binding_snapshot,
                post_binding_snapshot,
            )
        ):
            raise AdapterError(
                "binding changed during reset recovery verification"
            )

        checked_at = utc_now()
        result = {
            "schema_version": 1,
            "executed_at": checked_at,
            "mode": "verify-reset-recovery-real",
            "worker_id": worker_id,
            "pane_id": binding_snapshot.get("pane_id"),
            "pane_pid": binding_snapshot.get("pane_pid"),
            "port": int(binding_snapshot.get("port") or 0),
            "binding_confidence": "strong",
            "binding_snapshot": binding_snapshot,
            "post_binding_snapshot": post_binding_snapshot,
            "side_effect_fence": visible_side_effect_fence(
                binding_snapshot
            ),
            "reset_transport_executed": False,
            "reset_session_evidence_found": False,
            "reset_session_id": "",
            "reset_status_before_ids": [],
            "reset_status_after_ids": [],
            "reset_status_cleared_found": False,
            "reset_tui_home_before_evidence_found": False,
            "reset_tui_home_before_evidence_source": "",
            "reset_tui_home_evidence_found": True,
            "reset_tui_evidence_source": (
                "tmux_capture_home_after_acknowledged_reset"
            ),
            "reset_tui_capture_ok": bool(
                tui_evidence.get("reset_tui_capture_ok")
            ),
            "reset_tui_capture_markers": list(
                tui_evidence.get("reset_tui_capture_markers") or []
            ),
            "reset_command_ack_found": True,
            "reset_evidence_found": True,
            "evidence_source": "acknowledged_reset_task_sidecar",
            "checked_at": checked_at,
            "blocked_reasons": [],
            "adapter_writes_visible_run_task": False,
            "adapter_writes_terminal_markers": False,
            "rotation_receipt_path": "",
            "rotation_receipt": {},
        }
        receipt = build_rotation_receipt(
            result,
            task_id=task_id,
            attempt_id=attempt_id,
            role=role,
            contract_hash=contract_hash,
            rotation_reason=rotation_reason,
            rehydration_packet_type=rehydration_packet_type,
            context_domain_id=context_domain_id,
            previous_context_domain_id=previous_context_domain_id,
        )
        receipt["recovery_evidence"] = {
            "kind": "verify_only_consumed_reset",
            "source_run": source_run.removeprefix("visible-runs/"),
            "source_task": source_task,
            "prior_reset_transport_executed": True,
            "prior_reset_command_ack_found": True,
            "verified_without_reset_transport": True,
        }
        receipt["recovery_reservation"] = {
            "reservation_id": recovery_reservation_id,
            "status": "reset_recovery_reserved",
            "worker_id": worker_id,
            "target_run_root": str(target_run_root),
            "contract_hash": contract_hash,
            "source_run": source_run.removeprefix("visible-runs/"),
            "source_task": source_task,
            "expected_first_lane_id": expected_first_lane_id,
            "expected_first_request_hash": (
                expected_first_request_hash
            ),
            "expected_first_dispatch_hash": (
                expected_first_dispatch_hash
            ),
        }
        receipt_path = write_rotation_receipt(root, receipt)
        result["rotation_receipt_path"] = rel(receipt_path, root)
        result["rotation_receipt"] = receipt
        reservation_lock["rotation_receipt_path"] = rel(
            receipt_path,
            root,
        )
        reservation_lock["rotation_receipt_hash"] = (
            "sha256:"
            + hashlib.sha256(
                json.dumps(
                    receipt,
                    sort_keys=True,
                    separators=(",", ":"),
                    ensure_ascii=False,
                ).encode("utf-8")
            ).hexdigest()
        )
        return result


def adopt_manual_reset_real_runtime(
    root: Path,
    worker_id: str,
    *,
    runtime_backend: str | None = None,
    task_id: str,
    attempt_id: str,
    role: str,
    contract_hash: str,
    rotation_reason: str,
    rehydration_packet_type: str,
    context_domain_id: str = "",
    previous_context_domain_id: str = "",
) -> dict[str, Any]:
    """Record an explicitly confirmed user-run /new without sending another."""
    safe_slug(worker_id, "worker")
    ensure_state_team_clean(root)
    backend_name = runtime_backend or default_backend_name()
    if backend_name != "tmux-reference":
        raise AdapterError(
            "adopt-manual-reset-real requires runtime-backend=tmux-reference"
        )

    record = require_visible_worker(root, worker_id)
    if not record.get("allow_auto_submit"):
        raise AdapterError(
            f"visible worker {worker_id!r} has allow_auto_submit=false"
        )
    lock_path = visible_owner_lock_path(root, worker_id)
    if lock_path.exists() or lock_path.is_symlink():
        raise AdapterError(
            "manual reset adoption requires no active target owner lock"
        )

    binding = runtime_binding_for_visible_worker(
        root,
        worker_id,
        backend_name,
    )
    binding_snapshot = visible_binding_snapshot(record, binding)
    if binding.get("binding_confidence") != "strong":
        raise AdapterError(
            "manual reset adoption requires a strong current binding"
        )
    _host, port = verified_visible_transport_endpoint(record, binding)

    status = session_status_snapshot(
        root,
        worker_id,
        runtime_backend=backend_name,
    )
    if status.get("session_ids") or int(status.get("status_count") or 0):
        raise AdapterError(
            "manual reset adoption requires an empty session status"
        )
    tui_evidence = reset_tui_home_evidence(binding)
    if not tui_evidence.get("reset_tui_home_evidence_found"):
        raise AdapterError(
            "manual reset adoption requires complete TUI home evidence"
        )

    post_record = require_visible_worker(root, worker_id)
    if not post_record.get("allow_auto_submit"):
        raise AdapterError(
            f"visible worker {worker_id!r} has allow_auto_submit=false"
        )
    post_binding = runtime_binding_for_visible_worker(
        root,
        worker_id,
        backend_name,
    )
    post_binding_snapshot = visible_binding_snapshot(
        post_record,
        post_binding,
    )
    if (
        post_binding.get("binding_confidence") != "strong"
        or not visible_binding_snapshots_match(
            binding_snapshot,
            post_binding_snapshot,
        )
    ):
        raise AdapterError(
            "binding changed during manual reset adoption verification"
        )
    if lock_path.exists() or lock_path.is_symlink():
        raise AdapterError(
            "target owner lock appeared during manual reset adoption"
        )

    checked_at = utc_now()
    result = {
        "schema_version": 1,
        "executed_at": checked_at,
        "mode": "adopt-manual-reset-real",
        "worker_id": worker_id,
        "pane_id": binding_snapshot.get("pane_id"),
        "pane_pid": binding_snapshot.get("pane_pid"),
        "port": port,
        "binding_confidence": "strong",
        "binding_snapshot": binding_snapshot,
        "post_binding_snapshot": post_binding_snapshot,
        "side_effect_fence": visible_side_effect_fence(binding_snapshot),
        "reset_transport_executed": False,
        "manual_reset_user_confirmed": True,
        "reset_session_evidence_found": False,
        "reset_session_id": "",
        "reset_status_before_ids": [],
        "reset_status_after_ids": [],
        "reset_status_cleared_found": False,
        "reset_tui_home_before_evidence_found": False,
        "reset_tui_home_before_evidence_source": "",
        "reset_tui_home_evidence_found": True,
        "reset_tui_evidence_source": (
            "tmux_capture_home_after_user_confirmed_manual_new"
        ),
        "reset_tui_capture_ok": bool(
            tui_evidence.get("reset_tui_capture_ok")
        ),
        "reset_tui_capture_markers": list(
            tui_evidence.get("reset_tui_capture_markers") or []
        ),
        "reset_command_ack_found": False,
        "reset_evidence_found": True,
        "evidence_source": "user_confirmed_manual_new",
        "checked_at": checked_at,
        "blocked_reasons": [],
        "adapter_writes_visible_run_task": False,
        "adapter_writes_terminal_markers": False,
        "rotation_receipt_path": "",
        "rotation_receipt": {},
    }
    receipt = build_rotation_receipt(
        result,
        task_id=task_id,
        attempt_id=attempt_id,
        role=role,
        contract_hash=contract_hash,
        rotation_reason=rotation_reason,
        rehydration_packet_type=rehydration_packet_type,
        context_domain_id=context_domain_id,
        previous_context_domain_id=previous_context_domain_id,
    )
    receipt["manual_reset_adoption"] = {
        "kind": "user_confirmed_manual_new",
        "reset_transport_executed": False,
        "target_owner_lock_clear": True,
        "verified_without_reset_transport": True,
    }
    receipt_path = write_rotation_receipt(root, receipt)
    result["rotation_receipt_path"] = rel(receipt_path, root)
    result["rotation_receipt"] = receipt
    return result


def background_output_real_runtime(
    root: Path,
    worker_id: str,
    session_id: str,
    task_id: str,
    *,
    runtime_backend: str | None = None,
) -> dict[str, Any]:
    if not str(session_id or "").startswith("ses"):
        raise AdapterError("background-output-real requires a session id starting with 'ses'")
    if not str(task_id or "").strip():
        raise AdapterError("background-output-real requires a non-empty task id")
    _record, binding, host, port = _visible_worker_local_binding(root, worker_id, runtime_backend)
    response = safe_http_request(
        host,
        port,
        BACKGROUND_OUTPUT_ENDPOINT.format(sessionID=session_id, taskID=task_id),
        "GET",
        timeout=6.0,
        limit=2_000_000,
        include_body_text=True,
    )
    blocked_reasons: list[str] = []
    payload: dict[str, Any] = {}
    if response.get("ok"):
        body = _json_body(response, label="GET background_output")
        payload = body if isinstance(body, dict) else {}
        if not isinstance(body, dict):
            blocked_reasons.append("background_output_invalid_response")
    else:
        blocked_reasons.append("background_output_endpoint_failed")
        error_body = _try_json_body(response)
        if isinstance(error_body, dict):
            err_name = str(error_body.get("name") or "")
            err_data = error_body.get("data")
            if err_name == "BadRequest" and isinstance(err_data, dict):
                server_msg = str(err_data.get("message") or "").strip()
                if server_msg:
                    blocked_reasons.append(f"tui_server_rejected:{server_msg}")
    return {
        "schema_version": 1,
        "checked_at": utc_now(),
        "mode": "background-output-real",
        "worker_id": worker_id,
        "pane_id": binding.get("pane_id"),
        "port": port,
        "binding_confidence": binding.get("binding_confidence"),
        "endpoint": BACKGROUND_OUTPUT_ENDPOINT.format(sessionID=session_id, taskID=task_id),
        "session_id": session_id,
        "task_id": task_id,
        "response": response,
        "state": _first_text(payload, "state"),
        "raw_status": _first_text(payload, "raw_status"),
        "completion_seen": bool(payload.get("completion_seen") is True),
        "output_present": "output" in payload and payload.get("output") is not None,
        "output_chars": len(str(payload.get("output") or "")),
        "retrieval_ready": _first_text(payload, "retrieval_ready"),
        "canonical_retrieval_handle": _first_text(payload, "canonical_retrieval_handle"),
        "fallback_session_id": _first_text(payload, "fallback_session_id"),
        "retry_after_ms": _first_text(payload, "retry_after_ms"),
        "message": _first_text(payload, "message"),
        "blocked_reasons": blocked_reasons,
        "adapter_writes_visible_run_task": False,
        "adapter_writes_terminal_markers": False,
    }


def background_control_real_runtime(
    root: Path,
    worker_id: str,
    session_id: str,
    task_id: str,
    request_body: dict[str, Any],
    *,
    runtime_backend: str | None = None,
) -> dict[str, Any]:
    if not str(session_id or "").startswith("ses"):
        raise AdapterError("background-control-real requires a session id starting with 'ses'")
    if not str(task_id or "").strip():
        raise AdapterError("background-control-real requires a non-empty task id")
    body = request_body if isinstance(request_body, dict) else {}
    action = str(body.get("action") or "").strip()
    if action not in {"cancel_late_optional_lane", "ignore_late_optional_lane"}:
        raise AdapterError(f"background-control-real invalid action: {action}")
    backend_name = runtime_backend or default_backend_name()
    record, binding, host, port = _visible_worker_local_binding(
        root,
        worker_id,
        backend_name,
    )
    binding_snapshot = visible_binding_snapshot(record, binding)
    require_visible_side_effect_fence(
        root,
        worker_id,
        binding_snapshot,
        runtime_backend=backend_name,
        operation=f"background-control-real:{action}",
    )
    response = safe_http_json_post_background_control(
        host,
        port,
        session_id=session_id,
        task_id=task_id,
        payload=dict(body),
        timeout=6.0,
    )
    blocked_reasons: list[str] = []
    payload: dict[str, Any] = {}
    if response.get("ok"):
        body = _json_body(response, label="POST background_control")
        payload = body if isinstance(body, dict) else {}
        if not isinstance(body, dict):
            blocked_reasons.append("background_control_invalid_response")
    else:
        blocked_reasons.append("background_control_endpoint_failed")
    return {
        "schema_version": 1,
        "checked_at": utc_now(),
        "mode": "background-control-real",
        "worker_id": worker_id,
        "pane_id": binding.get("pane_id"),
        "port": port,
        "binding_confidence": binding.get("binding_confidence"),
        "binding_snapshot": binding_snapshot,
        "side_effect_fence": visible_side_effect_fence(binding_snapshot),
        "endpoint": BACKGROUND_CONTROL_ENDPOINT.format(sessionID=session_id, taskID=task_id),
        "session_id": session_id,
        "task_id": task_id,
        "request_body": dict(request_body),
        "response": response,
        "action_requested": _first_text(payload, "action_requested"),
        "action_applied": _first_text(payload, "action_applied"),
        "state": _first_text(payload, "state"),
        "canonical_retrieval_handle": _first_text(payload, "canonical_retrieval_handle"),
        "required_or_optional": _first_text(payload, "required_or_optional"),
        "actuation_gate": _first_text(payload, "actuation_gate"),
        "message": _first_text(payload, "message"),
        "blocked_reasons": blocked_reasons,
        "adapter_writes_visible_run_task": False,
        "adapter_writes_terminal_markers": False,
    }


def command_execute_command_real(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    if not args.allow_real:
        raise AdapterError("execute-command-real requires --allow-real")
    result = execute_command_real_runtime(
        root,
        args.worker,
        args.command_body,
        runtime_backend=getattr(args, "runtime_backend", default_backend_name()),
        task_id=getattr(args, "task_id", ""),
        attempt_id=getattr(args, "attempt_id", ""),
        role=getattr(args, "role", ""),
        contract_hash=getattr(args, "contract_hash", ""),
        rotation_reason=getattr(args, "rotation_reason", "manual_new"),
        rehydration_packet_type=getattr(args, "rehydration_packet_type", "new-task"),
        context_domain_id=getattr(args, "context_domain_id", ""),
        previous_context_domain_id=getattr(args, "previous_context_domain_id", ""),
        same_context_domain_continuity_proven=getattr(
            args,
            "same_context_domain_continuity_proven",
            False,
        ),
        worker_process_restarted_after_last_task=getattr(
            args,
            "worker_process_restarted_after_last_task",
            False,
        ),
        process_restart_evidence=getattr(args, "process_restart_evidence", ""),
        selection_session_id=getattr(args, "selection_session_id", ""),
    )
    print("OpenCode TUI execute-command completed")
    print(f"worker: {result['worker_id']}")
    print(f"pane: {result.get('pane_id') or '-'}")
    print(f"port: {result['port']}")
    print(f"endpoint: {result['endpoint']}")
    print(f"command_body: {result['command_body']}")
    print(f"transport_command_body: {result.get('transport_command_body') or ''}")
    print(f"reset_transport_executed: {str(bool(result.get('reset_transport_executed'))).lower()}")
    print(f"reset_session_evidence_found: {str(bool(result.get('reset_session_evidence_found'))).lower()}")
    print(f"reset_command_ack_found: {str(bool(result.get('reset_command_ack_found'))).lower()}")
    print(f"reset_status_cleared_found: {str(bool(result.get('reset_status_cleared_found'))).lower()}")
    print(f"reset_tui_home_before_evidence_found: {str(bool(result.get('reset_tui_home_before_evidence_found'))).lower()}")
    print(f"reset_tui_home_before_capture_markers: {','.join(result.get('reset_tui_home_before_capture_markers') or [])}")
    print(f"reset_tui_home_refresh_attempted: {str(bool(result.get('reset_tui_home_refresh_attempted'))).lower()}")
    print(f"reset_tui_home_refresh_evidence_found: {str(bool(result.get('reset_tui_home_refresh_evidence_found'))).lower()}")
    print(f"reset_tui_home_evidence_found: {str(bool(result.get('reset_tui_home_evidence_found'))).lower()}")
    print(f"reset_fresh_process_evidence_found: {str(bool(result.get('reset_fresh_process_evidence_found'))).lower()}")
    print(f"reset_tui_capture_markers: {','.join(result.get('reset_tui_capture_markers') or [])}")
    print(f"reset_evidence_found: {str(bool(result.get('reset_evidence_found'))).lower()}")
    print(f"reset_status_before_ids: {','.join(result.get('reset_status_before_ids') or [])}")
    print(f"reset_status_after_ids: {','.join(result.get('reset_status_after_ids') or [])}")
    print(f"reset_session_id: {result.get('reset_session_id') or ''}")
    print(f"reset_epoch: {result.get('reset_epoch') or 0}")
    print(f"checked_at: {result.get('checked_at') or ''}")
    print(f"evidence_source: {result.get('evidence_source') or ''}")
    print(f"rotation_receipt: {result.get('rotation_receipt_path') or ''}")
    print(f"selection_continuity_status: {(result.get('selection_continuity') or {}).get('status') or ''}")
    receipt = result.get("rotation_receipt") or {}
    print(f"session_action: {receipt.get('session_action') or ''}")
    print(f"session_action_reason: {receipt.get('session_action_reason') or ''}")
    context_domain = receipt.get("context_domain") or {}
    print(f"context_domain_current: {context_domain.get('current') or ''}")
    print(f"context_domain_previous: {context_domain.get('previous') or ''}")
    print(f"context_domain_changed: {str(bool(context_domain.get('changed'))).lower()}")
    if result.get("blocked_reasons"):
        print(f"blocked_reasons: {','.join(result['blocked_reasons'])}")
    return 0 if result.get("reset_evidence_found") else 1


def command_verify_reset_real(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    if not args.allow_real:
        raise AdapterError("verify-reset-real requires --allow-real")
    result = execute_command_real_runtime(
        root,
        args.worker,
        RESET_SLASH_COMMAND_BODY,
        runtime_backend=getattr(args, "runtime_backend", default_backend_name()),
        task_id=getattr(args, "task_id", ""),
        attempt_id=getattr(args, "attempt_id", ""),
        role=getattr(args, "role", ""),
        contract_hash=getattr(args, "contract_hash", ""),
        rotation_reason=getattr(args, "rotation_reason", "manual_new"),
        rehydration_packet_type=getattr(args, "rehydration_packet_type", "new-task"),
        context_domain_id=getattr(args, "context_domain_id", ""),
        previous_context_domain_id=getattr(args, "previous_context_domain_id", ""),
        same_context_domain_continuity_proven=getattr(
            args,
            "same_context_domain_continuity_proven",
            False,
        ),
        worker_process_restarted_after_last_task=getattr(
            args,
            "worker_process_restarted_after_last_task",
            False,
        ),
        process_restart_evidence=getattr(args, "process_restart_evidence", ""),
    )
    print("OpenCode TUI verify reset completion")
    print(f"worker: {result['worker_id']}")
    print(f"pane: {result.get('pane_id') or '-'}")
    print(f"port: {result['port']}")
    print(f"reset_requested: {str(bool(result.get('reset_transport_executed'))).lower()}")
    print(f"reset_command_ack_found: {str(bool(result.get('reset_command_ack_found'))).lower()}")
    print(f"reset_session_evidence_found: {str(bool(result.get('reset_session_evidence_found'))).lower()}")
    print(f"reset_status_cleared_found: {str(bool(result.get('reset_status_cleared_found'))).lower()}")
    print(f"reset_tui_home_before_evidence_found: {str(bool(result.get('reset_tui_home_before_evidence_found'))).lower()}")
    print(f"reset_tui_home_before_capture_markers: {','.join(result.get('reset_tui_home_before_capture_markers') or [])}")
    print(f"reset_tui_home_refresh_attempted: {str(bool(result.get('reset_tui_home_refresh_attempted'))).lower()}")
    print(f"reset_tui_home_refresh_evidence_found: {str(bool(result.get('reset_tui_home_refresh_evidence_found'))).lower()}")
    print(f"reset_tui_home_evidence_found: {str(bool(result.get('reset_tui_home_evidence_found'))).lower()}")
    print(f"reset_fresh_process_evidence_found: {str(bool(result.get('reset_fresh_process_evidence_found'))).lower()}")
    print(f"reset_tui_capture_markers: {','.join(result.get('reset_tui_capture_markers') or [])}")
    print(f"reset_evidence_found: {str(bool(result.get('reset_evidence_found'))).lower()}")
    print(f"reset_status_before_ids: {','.join(result.get('reset_status_before_ids') or [])}")
    print(f"reset_status_after_ids: {','.join(result.get('reset_status_after_ids') or [])}")
    print(f"rotation_receipt: {result.get('rotation_receipt_path') or ''}")
    receipt = result.get("rotation_receipt") or {}
    print(f"session_action: {receipt.get('session_action') or ''}")
    print(f"session_action_reason: {receipt.get('session_action_reason') or ''}")
    context_domain = receipt.get("context_domain") or {}
    print(f"context_domain_current: {context_domain.get('current') or ''}")
    print(f"context_domain_previous: {context_domain.get('previous') or ''}")
    print(f"context_domain_changed: {str(bool(context_domain.get('changed'))).lower()}")
    if result.get("blocked_reasons"):
        print(f"blocked_reasons: {','.join(result['blocked_reasons'])}")
    return 0 if result.get("reset_evidence_found") else 1


