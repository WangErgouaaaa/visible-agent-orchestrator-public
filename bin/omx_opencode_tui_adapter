        )
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "OpenCode TUI adapter for discovery, dry-run, and visible TUI auto-submit. "
            "Discovery uses localhost GET/HEAD/OPTIONS; visible real submit requires explicit registry and --allow-real."
        )
    )
    parser.add_argument("--version", action="version", version="omx_opencode_tui_adapter phase-3B-visible-auto")
    sub = parser.add_subparsers(dest="command", required=True)

    capabilities = sub.add_parser("capabilities", help="probe opencode help/version and localhost GET capabilities")
    capabilities.add_argument("--root", default=".")
    capabilities.set_defaults(func=command_capabilities)

    discover = sub.add_parser("discover", help="discover current-window opencode panes and localhost servers")
    discover.add_argument("--root", default=".")
    discover.set_defaults(func=command_discover)

    socket_discover = sub.add_parser("socket-discover", help="discover OpenCode pane process tree, args ports, sockets, and localhost GET probes")
    socket_discover.add_argument("--root", default=".")
    socket_discover.set_defaults(func=command_socket_discover)

    probe = sub.add_parser("probe-server", help="read-only GET probe of a single localhost OpenCode server port")
    probe.add_argument("--root", default=".")
    probe.add_argument("--port", type=int, required=True)
    probe.add_argument("--host", default="127.0.0.1", choices=["127.0.0.1", "localhost"])
    probe.set_defaults(func=command_probe_server)

    preflight = sub.add_parser("preflight", help="check framework isolation and adapter readiness")
    preflight.add_argument("--root", default=".")
