def build_ag2_run_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Run an AG2-style meeting through the project-local meeting adapter seam.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
Phase 42 recommended entries:
  mock group chat:
    bin/omx_meeting_plan ag2-run --runtime mock --preset idea-review --max-rounds 3 --task "Review idea"

  gated live group chat:
    bin/omx_meeting_plan ag2-run --runtime real --real-runtime-mode live --allow-real-model-call \\
      --ag2-effective-approval-json /host/local/approval.json \\
      --ag2-runtime-config-json /host/local/runtime-config.json \\
      --preset idea-review --max-rounds 3 --task "Review idea"

  idea-review max_rounds <= 3. Live mode requires explicit approval and host-local config only.
""",
    )
    parser.add_argument("--root", default=None)
    parser.add_argument("--thread-id", default="")
    parser.add_argument("--task", required=True)
    parser.add_argument("--runtime", choices=["mock", "real"], required=True)
    parser.add_argument(
        "--real-runtime-mode",
        choices=["fake", "live"],
        default="fake",
        help="real runtime model-client mode; live additionally requires --allow-real-model-call",
    )
    parser.add_argument(
        "--ag2-effective-approval-json",
        default="",
        help="host-local effective approval JSON required for --runtime real",
    )
    parser.add_argument(
        "--ag2-runtime-config-json",
        default="",
        help="host-local runtime config JSON required for --runtime real",
    )
    parser.add_argument(
        "--allow-real-model-call",
        action="store_true",
        help="explicitly allow the live OpenAI-compatible model call for --runtime real --real-runtime-mode live",
    )
    parser.add_argument("--preset", choices=MEETING_PRESET_NAMES, required=True)
    parser.add_argument("--max-rounds", type=int, default=None)
    parser.add_argument(
        "--propose-control-plane-dry-run-worker",
        action="append",
        default=[],
        help="append a visible worker id to a deterministic no-live control_plane_dry_run proposed action",
    )
    parser.add_argument("--propose-control-plane-dry-run-title", default="")
    parser.add_argument("--propose-control-plane-dry-run-body", default="")
    parser.add_argument("--propose-control-plane-dry-run-timeout", type=int, default=300)
    parser.add_argument("--json", action="store_true")
    return parser


def build_ag2_adapter_plan_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Print the local no-live AG2 host-local adapter plan.")
    parser.add_argument("--root", default=None)
    parser.add_argument("--json", action="store_true")
    return parser


def build_ag2_approval_status_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Print the local no-live AG2 human approval artifact status.")
    parser.add_argument("--root", default=None)
    parser.add_argument("--json", action="store_true")
    return parser


