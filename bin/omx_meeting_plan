def command_ag2_release_readiness(args: argparse.Namespace) -> int:
    root = workspace_root(args.root)
    try:
        live_smoke_evidence = load_live_smoke_evidence_validation(args.ag2_live_smoke_evidence_json)
        release_proof_bundle = load_release_proof_bundle_validation(args.ag2_release_proof_bundle_json)
    except (OSError, json.JSONDecodeError, ValueError) as exc:
        payload = {
            "ok": False,
            "command": "ag2-release-readiness",
            "root": str(root),
            "would_execute_live": False,
            "error": str(exc),
        }
        if args.json:
            print(json.dumps(payload, indent=2, ensure_ascii=False))
        else:
            print("command: ag2-release-readiness")
            print("would_execute_live: false")
            print(f"error: {exc}")
        return 2
    release_readiness = build_ag2_release_readiness()
    release_readiness["real_runtime_release_gate"] = build_ag2_real_runtime_release_gate(
        live_smoke_evidence=live_smoke_evidence,
        release_proof_bundle=release_proof_bundle,
    )
    payload = {
        "ok": True,
        "command": "ag2-release-readiness",
        "root": str(root),
        "would_execute_live": False,
        "release_readiness": release_readiness,
    }
    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    else:
        print("command: ag2-release-readiness")
        print("would_execute_live: false")
        print(f"release_state: {release_readiness['release_state']}")
        print(f"go_no_go: {release_readiness['go_no_go']}")
        print(f"packaging_decision: {release_readiness['packaging_decision']}")
        print("supported_modes:")
        for mode in release_readiness["supported_modes"]:
            print(f"  - {mode}")
        print("unsupported_modes:")
        for mode in release_readiness["unsupported_modes"]:
            print(f"  - {mode}")
    return 0


def command_ag2_runtime_preflight(args: argparse.Namespace) -> int:
    root = workspace_root(args.root)
    try:
        preflight = build_ag2_real_runtime_preflight(
            ag2_human_approval_validation=load_optional_validation_evidence(args.ag2_approval_evidence_json),
            ag2_host_local_config_reference_validation=load_optional_validation_evidence(
                args.ag2_host_local_config_reference_evidence_json
            ),
        )
    except (OSError, json.JSONDecodeError, ValueError) as exc:
        payload = {
            "ok": False,
            "command": "ag2-runtime-preflight",
            "root": str(root),
            "would_execute_live": False,
            "error": str(exc),
        }
        if args.json:
            print(json.dumps(payload, indent=2, ensure_ascii=False))
        else:
            print("command: ag2-runtime-preflight")
            print("would_execute_live: false")
            print(f"error: {exc}")
        return 2

    ready = bool(preflight["ready_for_real_runtime"])
    payload = {
        "ok": ready,
        "command": "ag2-runtime-preflight",
        "root": str(root),
        "would_execute_live": False,
        "preflight": preflight,
    }
    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    else:
        print("command: ag2-runtime-preflight")
        print("would_execute_live: false")
        print(f"preflight_state: {preflight['preflight_state']}")
        print(f"ready_for_real_runtime: {str(ready).lower()}")
        print("missing_gates:")
        for missing_gate in preflight["missing_gates"]:
            print(f"  - {missing_gate}")
    return 0 if ready else 2


