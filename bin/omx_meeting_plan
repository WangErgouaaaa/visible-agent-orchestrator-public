def command_ag2_approval_validate(args: argparse.Namespace) -> int:
    root = workspace_root(args.root)
    payload_json = Path(args.payload_json).resolve()
    try:
        payload = json.loads(payload_json.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        validation = {
            "schema_version": 1,
            "validation_kind": "ag2_human_approval_payload_validation",
            "valid": False,
            "normalized_payload": None,
            "errors": [str(exc)],
            "warnings": [],
            "effective_runtime_import_allowed": False,
            "effective_adapter_eligibility_granted": False,
            "would_install_dependency": False,
            "would_import_ag2": False,
            "would_execute_live": False,
            "provider_or_model_config_required": False,
        }
    else:
        validation = validate_ag2_human_approval_payload(payload)
    ok = bool(validation["valid"])
    output = {
        "ok": ok,
        "command": "ag2-approval-validate",
        "root": str(root),
        "payload_json": str(payload_json),
        "would_execute_live": False,
        "validation": validation,
    }
    if args.json:
        print(json.dumps(output, indent=2, ensure_ascii=False))
    else:
        print("command: ag2-approval-validate")
        print("would_execute_live: false")
        print(f"valid: {str(ok).lower()}")
        for error in validation["errors"]:
            print(f"error: {error}")
    return 0 if ok else 2


