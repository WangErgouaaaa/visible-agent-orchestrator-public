def build_run_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
Run `omx_meeting_plan <command> --help` for command-specific options.
""",
    )
    parser.add_argument("--root", default=None)
    parser.add_argument("--thread-id", default="")
    parser.add_argument("--task", required=True)
    parser.add_argument("--participant", action="append", type=parse_participant, required=True)
    parser.add_argument("--max-rounds", type=int, default=3)
    parser.add_argument("--policy", choices=sorted(BUILTIN_SELECTOR_POLICIES), default="round_robin")
    parser.add_argument(
        "--termination-condition",
        choices=sorted(BUILTIN_TERMINATION_CONDITIONS),
        default="",
        help="optional built-in no-live termination condition name",
    )
    parser.add_argument(
        "--propose-control-plane-dry-run-worker",
        action="append",
        default=[],
        help="append a visible worker id to a deterministic no-live control_plane_dry_run proposed action",
    )
    parser.add_argument("--propose-control-plane-dry-run-title", default="")
    parser.add_argument("--propose-control-plane-dry-run-body", default="")
    parser.add_argument("--propose-control-plane-dry-run-timeout", type=int, default=300)
    parser.add_argument(
        "--ag2-approval-evidence-json",
        default="",
        help="optional AG2 approval validation evidence JSON produced by ag2-approval-validate",
    )
    parser.add_argument(
        "--ag2-host-local-config-reference-evidence-json",
        default="",
        help="optional AG2 host-local config reference validation evidence JSON produced by ag2-host-local-config-validate",
    )
    parser.add_argument("--json", action="store_true")
    return parser


