def build_safety_check_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Run static no-live safety checks for the meeting layer.")
    parser.add_argument("--root", default=None)
    parser.add_argument("--json", action="store_true")
    return parser


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "ag2-run":
        parser = build_ag2_run_parser()
        return command_ag2_run(parser.parse_args(argv[1:]))
    if argv and argv[0] == "safety-check":
        parser = build_safety_check_parser()
        return command_safety_check(parser.parse_args(argv[1:]))
    if argv and argv[0] == "ag2-status":
        parser = build_ag2_status_parser()
        return command_ag2_status(parser.parse_args(argv[1:]))
    if argv and argv[0] == "ag2-release-readiness":
        parser = build_ag2_release_readiness_parser()
        return command_ag2_release_readiness(parser.parse_args(argv[1:]))
    if argv and argv[0] == "ag2-runtime-preflight":
        parser = build_ag2_runtime_preflight_parser()
        return command_ag2_runtime_preflight(parser.parse_args(argv[1:]))
    if argv and argv[0] == "ag2-host-local-config-validate":
        parser = build_ag2_host_local_config_validate_parser()
        return command_ag2_host_local_config_validate(parser.parse_args(argv[1:]))
    if argv and argv[0] == "ag2-host-local-config-status":
        parser = build_ag2_host_local_config_status_parser()
        return command_ag2_host_local_config_status(parser.parse_args(argv[1:]))
    if argv and argv[0] == "ag2-approval-validate":
        parser = build_ag2_approval_validate_parser()
        return command_ag2_approval_validate(parser.parse_args(argv[1:]))
    if argv and argv[0] == "ag2-approval-status":
        parser = build_ag2_approval_status_parser()
        return command_ag2_approval_status(parser.parse_args(argv[1:]))
    if argv and argv[0] == "ag2-adapter-plan":
        parser = build_ag2_adapter_plan_parser()
        return command_ag2_adapter_plan(parser.parse_args(argv[1:]))
    if argv and argv[0] == "ag2-import-gate":
        parser = build_ag2_import_gate_parser()
        return command_ag2_import_gate(parser.parse_args(argv[1:]))
    if argv and argv[0] == "bridge-dry-run":
        parser = build_bridge_parser()
        return command_bridge_dry_run(parser.parse_args(argv[1:]))
    if argv and argv[0] == "build-transcript":
        parser = build_shared_transcript_parser()
        return command_build_transcript(parser.parse_args(argv[1:]))
    if argv and argv[0] == "worker-group-review":
        parser = build_worker_group_review_parser()
        return command_worker_group_review(parser.parse_args(argv[1:]))
    if argv and argv[0] == "run":
        argv = argv[1:]
    parser = build_run_parser()
    if argv and not argv[0].startswith("-"):
        parser.error(f"unknown command: {argv[0]}")
    args = parser.parse_args(argv)
    return command_run(args)


if __name__ == "__main__":
    raise SystemExit(main())
