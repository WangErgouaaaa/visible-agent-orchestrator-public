def watcher_board_path(root: Path) -> Path:
    return watcher_root(root) / "visible_board.json"


def safe_id(value: str, label: str) -> str:
    if not value:
        raise DispatchError(f"{label} is required")
    if value in {".", ".."} or "/" in value or "\\" in value or "\x00" in value:
        raise DispatchError(f"{label} must be a simple id, got: {value!r}")
    return value


def is_relative_to(path: Path, base: Path) -> bool:
    try:
        path.resolve().relative_to(base.resolve())
        return True
    except ValueError:
        return False


def rel(path: Path, root: Path) -> str:
    try:
        return str(path.resolve().relative_to(root.resolve()))
    except Exception:
        return str(path)


def read_json(path: Path) -> dict[str, Any]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def require_clean_room_startup_gate(
    root: Path,
    worker: dict[str, Any],
    task_contract: dict[str, Any] | None,
) -> dict[str, Any]:
    try:
        return _require_clean_room_startup_gate(
            root,
            worker,
            task_contract,
        )
    except CleanRoomStartupError as exc:
        raise DispatchError(str(exc)) from exc


def require_draft_check_contract(
    task_contract: dict[str, Any] | None,
) -> dict[str, Any] | None:
    """Validate the closed opt-in draft_check contract at dispatch time."""

    try:
        return validate_draft_check_contract(task_contract)
    except DraftCheckError as exc:
        raise DispatchError(str(exc)) from exc


def read_watcher_board(root: Path) -> dict[str, Any]:
    return read_json(watcher_board_path(root))


def infer_alert_worker_id(root: Path, alert: dict[str, Any]) -> str:
    worker_id = str(alert.get("worker_id") or alert.get("worker") or "").strip()
    if worker_id:
        return worker_id
    run = str(alert.get("run") or "").strip()
    task = str(alert.get("task") or "").strip()
    if not run or not task:
        return ""
    owner_path = visible_runs_root(root) / run / "tasks" / task / "owner"
    try:
        return owner_path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def filter_watcher_board_for_worker(root: Path, board: dict[str, Any], worker_id: str | None) -> dict[str, Any]:
    if not worker_id or not isinstance(board, dict):
        return board
    alerts = board.get("alerts", []) if isinstance(board.get("alerts"), list) else []
    filtered = [
        dict(alert)
        for alert in alerts
        if isinstance(alert, dict) and infer_alert_worker_id(root, alert) == worker_id
    ]
    scoped = dict(board)
    scoped["alerts"] = filtered
    scoped["alert_count"] = len(filtered)
    scoped["active_alerts"] = len(filtered)
    scoped["scope_worker_id"] = worker_id
    return scoped


def write_json(path: Path, data: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False) + "\n", encoding="utf-8")


def write_observation_if_changed(
    path: Path,
    observation: dict[str, Any],
) -> None:
    volatile_fields = {
        "observed_at",
        "window_first_message_id",
        "window_last_message_id",
        "response_bytes",
        "probe_duration_ms",
        "request_timestamp",
        "scan_timestamp",
    }
    existing = read_json(path)
    semantic_existing = {
        key: value
        for key, value in existing.items()
        if key not in volatile_fields
    }
    semantic_observation = {
        key: value
        for key, value in observation.items()
        if key not in volatile_fields
    }
    if existing and semantic_existing == semantic_observation:
        return
    write_json_atomic(path, observation)


def create_owner_lock(path: Path, data: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    host_boot_id = current_host_boot_id()
    if not host_boot_id:
        raise DispatchError("cannot create owner lock without host boot id")
    payload = (
        json.dumps(
            {**data, "host_boot_id": host_boot_id},
            indent=2,
            sort_keys=True,
            ensure_ascii=False,
        )
        + "\n"
    )
    try:
        descriptor = os.open(
            path,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL,
            0o600,
        )
    except FileExistsError as exc:
        existing = read_json(path)
        raise DispatchError(
            "owner lock already exists"
            f" for worker={data.get('worker_id')}:"
            f" run={existing.get('run') or '-'}"
            f" task={existing.get('task') or '-'}"
        ) from exc
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
    except Exception:
        path.unlink(missing_ok=True)
        raise


def write_json_exclusive_or_equal(
    path: Path,
    data: dict[str, Any],
) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = (
        json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False)
        + "\n"
    )
    try:
        descriptor = os.open(
            path,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL,
            0o600,
        )
    except FileExistsError as exc:
        try:
            existing = path.read_bytes()
        except OSError:
            existing = b""
        if existing != payload.encode("utf-8"):
            raise DispatchError(
                f"immutable JSON claim differs: {path}"
            ) from exc
        return
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
    except Exception:
        path.unlink(missing_ok=True)
        raise


def _run_one_dispatch_claim_contract(
    args: argparse.Namespace,
    *,
    worker_id: str,
) -> dict[str, Any]:
    contract = {
        "worker_id": worker_id,
        "runtime_backend": str(
            getattr(args, "backend", RUNTIME_BACKEND)
        ),
        "title_body_hash": _canonical_json_hash(
            {
                "title": str(getattr(args, "title", "") or ""),
                "body": str(getattr(args, "body", "") or ""),
            }
        ),
        "session_action": str(
            getattr(args, "session_action", "") or ""
        ),
        "session_action_reason": str(
            getattr(args, "session_action_reason", "") or ""
        ),
        "rotate_before_submit": bool(
            getattr(args, "rotate_before_submit", False)
        ),
        "rotation_task_id": str(
            getattr(args, "rotation_task_id", "") or ""
        ),
        "rotation_attempt_id": str(
            getattr(args, "rotation_attempt_id", "") or ""
        ),
        "rotation_role": str(
            getattr(args, "rotation_role", "") or ""
        ),
        "rotation_contract_hash": str(
            getattr(args, "rotation_contract_hash", "") or ""
        ),
        "rotation_reason": str(
            getattr(args, "rotation_reason", "") or ""
        ),
        "rehydration_packet_type": str(
            getattr(args, "rehydration_packet_type", "") or ""
        ),
        "context_domain_id": str(
            getattr(args, "context_domain_id", "") or ""
        ).strip(),
        "previous_context_domain_id": str(
            getattr(args, "previous_context_domain_id", "") or ""
        ).strip(),
        "recovery_reservation_id": str(
            getattr(args, "recovery_reservation_id", "") or ""
        ),
        "recovery_target_run_root": str(
            getattr(args, "recovery_target_run_root", "") or ""
        ),
        "recovery_contract_hash": str(
            getattr(args, "recovery_contract_hash", "") or ""
        ),
        "recovery_first_lane_id": str(
            getattr(args, "recovery_first_lane_id", "") or ""
        ),
        "recovery_first_request_hash": str(
            getattr(args, "recovery_first_request_hash", "") or ""
        ),
        "recovery_first_dispatch_hash": str(
            getattr(args, "recovery_first_dispatch_hash", "") or ""
        ),
    }
    task_contract = parse_task_contract_json(
        getattr(args, "task_contract_json", "")
    )
    operation_contract = _run_one_operation_contract(task_contract)
    contract["operation_contract"] = operation_contract
    if task_contract is not None:
        contract["task_contract_hash"] = _canonical_json_hash(task_contract)
    return contract


def _run_one_dispatch_claim_path(root: Path, claim_id: str) -> Path:
    match = re.fullmatch(r"sha256:([0-9a-f]{64})", claim_id)
    if match is None:
        raise DispatchError(
            "run-one dispatch claim id must be a canonical sha256"
        )
    return (
        framework_root(root)
        / "visible-runs"
        / "_dispatch-claims"
        / f"{match.group(1)}.json"
    )


def _open_nofollow_parent(
    *,
    root: Path,
    path: Path,
    create_parents: bool,
) -> tuple[int, str]:
    root = Path(root)
    path = Path(path)
    if (
        not root.is_absolute()
        or not path.is_absolute()
        or ".." in root.parts
        or ".." in path.parts
    ):
        raise DispatchError(
            "run-one dispatch claim path must be absolute and contained"
        )
    try:
        relative = path.relative_to(root)
    except ValueError as exc:
        raise DispatchError(
            "run-one dispatch claim path escapes control root"
        ) from exc
    if not relative.parts:
        raise DispatchError("run-one dispatch claim path must name a file")

    directory_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    current = -1
    try:
        current = os.open(root, directory_flags)
        for part in relative.parts[:-1]:
            try:
                child = os.open(
                    part,
                    directory_flags,
                    dir_fd=current,
                )
            except FileNotFoundError:
                if not create_parents:
                    raise
                os.mkdir(part, 0o700, dir_fd=current)
                child = os.open(
                    part,
                    directory_flags,
                    dir_fd=current,
                )
            os.close(current)
            current = child
        return current, relative.parts[-1]
    except OSError as exc:
        if current >= 0:
            os.close(current)
        raise DispatchError(
            "run-one dispatch claim path must not use symlinks "
            "or unsafe files"
        ) from exc


def _read_json_at(
    directory_fd: int,
    name: str,
    *,
    missing_ok: bool,
) -> dict[str, Any] | None:
    try:
        descriptor = os.open(
            name,
            os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
            dir_fd=directory_fd,
        )
    except FileNotFoundError:
        if missing_ok:
            return None
        raise DispatchError(
            "run-one dispatch claim evidence is missing"
        )
    except OSError as exc:
        raise DispatchError(
            "run-one dispatch claim path must not use symlinks "
            "or unsafe files"
        ) from exc
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise DispatchError(
                "run-one dispatch claim path must name a regular file"
            )
        with os.fdopen(os.dup(descriptor), "r", encoding="utf-8") as handle:
            payload = json.load(handle)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        raise DispatchError(
            "run-one dispatch claim evidence is invalid"
        ) from exc
    finally:
        os.close(descriptor)
    if not isinstance(payload, dict):
        raise DispatchError(
            "run-one dispatch claim evidence must be a JSON object"
        )
    return payload


def _read_json_nofollow(
    *,
    root: Path,
    path: Path,
    missing_ok: bool = False,
    create_parents: bool = False,
) -> dict[str, Any] | None:
    directory_fd, name = _open_nofollow_parent(
        root=root,
        path=path,
        create_parents=create_parents,
    )
    try:
        return _read_json_at(
            directory_fd,
            name,
            missing_ok=missing_ok,
        )
    finally:
        os.close(directory_fd)


def _write_all(descriptor: int, payload: bytes) -> None:
    remaining = memoryview(payload)
    while remaining:
        written = os.write(descriptor, remaining)
        if written <= 0:
            raise OSError("run-one dispatch claim write made no progress")
        remaining = remaining[written:]


def _write_json_nofollow(
    *,
    root: Path,
    path: Path,
    payload: dict[str, Any],
    expected: dict[str, Any] | None = None,
    existing_equal_ok: bool = False,
) -> None:
    directory_fd, name = _open_nofollow_parent(
        root=root,
        path=path,
        create_parents=True,
    )
    encoded = (
        json.dumps(
            payload,
            indent=2,
            sort_keys=True,
            ensure_ascii=False,
        )
        + "\n"
    ).encode("utf-8")
    try:
        if expected is None:
            temporary = (
                f".{name}.{os.getpid()}.{uuid.uuid4().hex}.tmp"
            )
            descriptor = os.open(
                temporary,
                (
                    os.O_WRONLY
                    | os.O_CREAT
                    | os.O_EXCL
                    | os.O_NOFOLLOW
                ),
                0o600,
                dir_fd=directory_fd,
            )
            temporary_exists = True
            try:
                _write_all(descriptor, encoded)
                os.fsync(descriptor)
                os.close(descriptor)
                descriptor = -1
                try:
                    os.link(
                        temporary,
                        name,
                        src_dir_fd=directory_fd,
                        dst_dir_fd=directory_fd,
                        follow_symlinks=False,
                    )
                except FileExistsError as exc:
                    existing = _read_json_at(
                        directory_fd,
                        name,
                        missing_ok=False,
                    )
                    if not (
                        existing_equal_ok and existing == payload
                    ):
                        raise DispatchError(
                            "run-one dispatch claim already exists"
                        ) from exc
                os.unlink(temporary, dir_fd=directory_fd)
                temporary_exists = False
                os.fsync(directory_fd)
            finally:
                if descriptor >= 0:
                    os.close(descriptor)
                if temporary_exists:
                    try:
                        os.unlink(temporary, dir_fd=directory_fd)
                    except FileNotFoundError:
                        pass
            return

        current = _read_json_at(
            directory_fd,
            name,
            missing_ok=False,
        )
        if current != expected:
            raise DispatchError(
                "run-one dispatch claim changed before update"
            )
        temporary = f".{name}.{os.getpid()}.{uuid.uuid4().hex}.tmp"
        descriptor = os.open(
            temporary,
            (
                os.O_WRONLY
                | os.O_CREAT
                | os.O_EXCL
                | os.O_NOFOLLOW
            ),
            0o600,
            dir_fd=directory_fd,
        )
        temporary_exists = True
        try:
            _write_all(descriptor, encoded)
            os.fsync(descriptor)
            os.close(descriptor)
            descriptor = -1
            os.replace(
                temporary,
                name,
                src_dir_fd=directory_fd,
                dst_dir_fd=directory_fd,
            )
            temporary_exists = False
            os.fsync(directory_fd)
        finally:
            if descriptor >= 0:
                os.close(descriptor)
            if temporary_exists:
                try:
                    os.unlink(temporary, dir_fd=directory_fd)
                except FileNotFoundError:
                    pass
    finally:
        os.close(directory_fd)


def _validate_run_one_dispatch_claim_task_binding(
    *,
    root: Path,
    claim: dict[str, Any],
) -> None:
    if claim.get("status") != "prepared":
        return
    run_id = str(claim.get("run_id") or "")
    task_id = str(claim.get("task_id") or "")
    task_root = task_dir(root, run_id, task_id)
    task = _read_json_nofollow(
        root=root,
        path=task_root / "task.json",
    )
    session_action = _read_json_nofollow(
        root=root,
        path=task_root / "session_action.json",
    )
    binding = _read_json_nofollow(
        root=root,
        path=task_root / "dispatch_claim.json",
    )
    claim_path = _run_one_dispatch_claim_path(
        root,
        str(claim.get("claim_id") or ""),
    )
    expected_binding = {
        "schema_version": 1,
        "claim_kind": "visible-run-one-dispatch-task-binding",
        "claim_id": claim.get("claim_id"),
        "contract_hash": claim.get("contract_hash"),
        "claim_path": rel(claim_path, root),
    }
    if (
        not isinstance(task, dict)
        or not isinstance(session_action, dict)
        or claim.get("task_json_hash") != _canonical_json_hash(task)
        or claim.get("session_action_hash")
        != _canonical_json_hash(session_action)
        or binding != expected_binding
    ):
        raise DispatchError(
            "run-one dispatch claim task binding mismatch"
        )


def _dispatch_claim_owner_is_live(claim: dict[str, Any]) -> bool:
    pid = int(claim.get("owner_pid") or 0)
    start_ticks = int(claim.get("owner_start_time_ticks") or 0)
    boot_id = str(claim.get("owner_host_boot_id") or "")
    return bool(
        pid > 0
        and start_ticks > 0
        and boot_id
        and boot_id == current_host_boot_id()
        and process_start_time_ticks(pid) == start_ticks
    )


def _dispatch_claim_has_submit_activity(
    root: Path,
    claim: dict[str, Any],
) -> bool:
    tdir = task_dir(
        root,
        str(claim.get("run_id") or ""),
        str(claim.get("task_id") or ""),
    )
    activity_names = {
        ".submitted",
        ".received",
        ".started",
        ".heartbeat",
        ".done",
        ".fail",
        ".blocked",
        "report.md",
        "delivery.json",
        "session_rotation.json",
        "session_rotation_error.json",
        "submit_interrupted.json",
        "submit_error.json",
    }
    if any(
        (tdir / name).exists() or (tdir / name).is_symlink()
        for name in activity_names
    ):
        return True
    worker_id = str(claim.get("worker_id") or "")
    owner_path = lock_path(root, worker_id)
    if not (owner_path.exists() or owner_path.is_symlink()):
        return False
    if owner_path.is_symlink() or not owner_path.is_file():
        return True
    try:
        owner = read_json(owner_path)
    except (OSError, ValueError, json.JSONDecodeError):
        return True
    contract = claim.get("contract")
    if not isinstance(contract, dict):
        return True
    reservation_id = str(
        contract.get("recovery_reservation_id") or ""
    )
    if not reservation_id:
        return True
    expected_reservation = {
        "owner_lock_id": reservation_id,
        "worker_id": worker_id,
        "status": "reset_recovery_reserved",
        "target_run_root": str(
            contract.get("recovery_target_run_root") or ""
        ),
        "rotation_contract_hash": str(
            contract.get("recovery_contract_hash") or ""
        ),
        "recovery_kind": "verify_only_consumed_reset",
        "expected_first_lane_id": str(
            contract.get("recovery_first_lane_id") or ""
        ),
        "expected_first_request_hash": str(
            contract.get("recovery_first_request_hash") or ""
        ),
        "expected_first_dispatch_hash": str(
            contract.get("recovery_first_dispatch_hash") or ""
        ),
    }
    return any(
        owner.get(field) != value
        for field, value in expected_reservation.items()
    )


def reserve_run_one_dispatch_claim(
    *,
    root: Path,
    args: argparse.Namespace,
    worker_id: str,
    task_id: str = "task-001",
    run_id: str = "",
) -> dict[str, Any]:
    claim_id = str(getattr(args, "dispatch_claim_id", "") or "")
    if not claim_id:
        raise DispatchError("run-one dispatch claim id is required")
    path = _run_one_dispatch_claim_path(root, claim_id)
    contract = {
        **_run_one_dispatch_claim_contract(
            args,
            worker_id=worker_id,
        ),
        "task_id": task_id,
        "requested_run_id": run_id,
    }
    contract_hash = _canonical_json_hash(contract)
    with visible_registry_lock(root):
        claim = _read_json_nofollow(
            root=root,
            path=path,
            missing_ok=True,
            create_parents=True,
        )
        if claim is not None:
            if (
                claim.get("schema_version") != 1
                or claim.get("claim_kind")
                != "visible-run-one-dispatch"
                or claim.get("claim_id") != claim_id
                or claim.get("worker_id") != worker_id
                or claim.get("contract_hash") != contract_hash
                or claim.get("contract") != contract
            ):
                raise DispatchError(
                    "run-one dispatch claim contract mismatch"
                )
            _validate_run_one_dispatch_claim_task_binding(
                root=root,
                claim=claim,
            )
            action = "reuse"
            if (
                not _dispatch_claim_owner_is_live(claim)
                and not _dispatch_claim_has_submit_activity(root, claim)
            ):
                previous_claim = claim
                claim = {
                    **claim,
                    "claim_version": int(
                        claim.get("claim_version") or 0
                    )
                    + 1,
                    "status": "reserved",
                    "owner_pid": os.getpid(),
                    "owner_start_time_ticks": (
                        process_start_time_ticks(os.getpid())
                    ),
                    "owner_host_boot_id": current_host_boot_id(),
                    "taken_over_at": utc_now(),
                }
                _write_json_nofollow(
                    root=root,
                    path=path,
                    payload=claim,
                    expected=previous_claim,
                )
                action = "takeover"
            return {
                **claim,
                "action": action,
                "claim_path": str(path),
            }

        reserved_run_id = run_id or unique_run_id(root)
        claim = {
            "schema_version": 1,
            "claim_kind": "visible-run-one-dispatch",
            "claim_id": claim_id,
            "claim_version": 1,
            "status": "reserved",
            "worker_id": worker_id,
            "run_id": reserved_run_id,
            "task_id": task_id,
            "task_dir": str(
                Path(".omx/framework/team/visible-runs")
                / reserved_run_id
                / "tasks"
                / task_id
            ),
            "contract": contract,
            "contract_hash": contract_hash,
            "owner_pid": os.getpid(),
            "owner_start_time_ticks": process_start_time_ticks(
                os.getpid()
            ),
            "owner_host_boot_id": current_host_boot_id(),
            "created_at": utc_now(),
        }
        _write_json_nofollow(
            root=root,
            path=path,
            payload=claim,
        )
        return {
            **claim,
            "action": "create",
            "claim_path": str(path),
        }


def _write_run_one_receipt_out(
    path_value: str,
    *,
    phase: str,
    fields: dict[str, Any],
) -> None:
    """Child-side early run receipt (#816/#800).

    Written at the dispatch child's own creation boundaries while the
    parent is still blocked in its wait: after the dispatch claim is
    reserved the exact run/task/task_dir and claim path are queryable from
    the receipt file alone. Write failures are honest stderr warnings and
    never fail the dispatch itself; the parent owns the final phase.
    """
    if not str(path_value or "").strip():
        return
    payload = {
        "schema": "visible-orchestrate-run-receipt/v1",
        "phase": phase,
        "written_at": utc_now(),
        **fields,
    }
    try:
        durable_atomic_write(
            Path(str(path_value)),
            json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False)
            + "\n",
        )
    except OSError as exc:
        print(
            f"receipt_out_write_failed: {phase}: {exc}",
            file=sys.stderr,
        )


def _reserve_worker_dispatch_claim(
    *,
    root: Path,
    args: argparse.Namespace,
    capability: dict[str, Any],
    worker_id: str,
    task_id: str,
    run_id: str = "",
) -> dict[str, Any]:
    expected_claim_id = _canonical_json_hash(capability)
    supplied_claim_id = str(getattr(args, "dispatch_claim_id", "") or "")
    if supplied_claim_id and supplied_claim_id != expected_claim_id:
        raise DispatchError(
            "run-one dispatch claim id does not match capability"
        )
    args.dispatch_claim_id = expected_claim_id
    return reserve_run_one_dispatch_claim(
        root=root,
        args=args,
        worker_id=worker_id,
        task_id=task_id,
        run_id=run_id,
    )


def mark_run_one_dispatch_claim_prepared(
    *,
    root: Path,
    claim: dict[str, Any],
    tdir: Path,
) -> dict[str, Any]:
    claim_id = str(claim.get("claim_id") or "")
    if not claim_id:
        return claim
    path = _run_one_dispatch_claim_path(root, claim_id)
    with visible_registry_lock(root):
        current = _read_json_nofollow(root=root, path=path)
        assert isinstance(current, dict)
        if (
            current.get("claim_id") != claim_id
            or current.get("contract_hash")
            != claim.get("contract_hash")
            or current.get("run_id") != claim.get("run_id")
            or current.get("task_id") != claim.get("task_id")
            or current.get("owner_pid") != os.getpid()
            or current.get("owner_start_time_ticks")
            != process_start_time_ticks(os.getpid())
        ):
            raise DispatchError(
                "run-one dispatch claim changed before task preparation"
            )
        prepared = {
            **current,
            "status": "prepared",
            "prepared_at": utc_now(),
            "task_json_hash": _canonical_json_hash(
                _read_json_nofollow(
                    root=root,
                    path=tdir / "task.json",
                )
            ),
            "session_action_hash": _canonical_json_hash(
                _read_json_nofollow(
                    root=root,
                    path=tdir / "session_action.json",
                )
            ),
        }
        _write_json_nofollow(
            root=root,
            path=tdir / "dispatch_claim.json",
            payload={
                "schema_version": 1,
                "claim_kind": "visible-run-one-dispatch-task-binding",
                "claim_id": claim_id,
                "contract_hash": prepared["contract_hash"],
                "claim_path": rel(path, root),
            },
            existing_equal_ok=True,
        )
        _write_json_nofollow(
            root=root,
            path=path,
            payload=prepared,
            expected=current,
        )
        return {**prepared, "claim_path": str(path)}


def owner_lock_root(path: Path) -> Path:
    locks_dir = path.resolve().parent
    expected_names = (
        "_locks",
        "visible-runs",
        "team",
        "framework",
        ".omx",
    )
    actual_names = (
        locks_dir.name,
        locks_dir.parent.name,
        locks_dir.parent.parent.name,
        locks_dir.parent.parent.parent.name,
        locks_dir.parent.parent.parent.parent.name,
    )
    if actual_names != expected_names:
        raise DispatchError(f"cannot infer root from owner lock path: {path}")
    return locks_dir.parents[4]


def update_owner_lock(
    path: Path,
    data: dict[str, Any],
    *,
    expected_status: str,
    expected_version: int,
) -> None:
    root = owner_lock_root(path)
    expected = owner_lock_identity(data)
    next_version = owner_lock_version(data)
    if next_version != expected_version + 1:
        raise DispatchError(
            "owner lock next version is invalid:"
            f" expected={expected_version + 1} actual={next_version}"
        )
    with visible_registry_lock(root):
        current = read_json(path)
        actual = owner_lock_identity(current)
        if actual != expected:
            raise DispatchError(
                "owner lock identity changed"
                f" before update: expected={expected!r} actual={actual!r}"
            )
        actual_status = str(current.get("status") or "")
        actual_version = owner_lock_version(current)
        if (
            actual_status != expected_status
            or actual_version != expected_version
        ):
            raise DispatchError(
                "owner lock transition changed before update:"
                f" expected_status={expected_status!r}"
                f" actual_status={actual_status!r}"
                f" expected_version={expected_version}"
                f" actual_version={actual_version}"
            )
        path.parent.mkdir(parents=True, exist_ok=True)
        temporary = path.with_name(
            f".{path.name}.{os.getpid()}.{time.time_ns()}.tmp"
        )
        try:
            temporary.write_text(
                json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False)
                + "\n",
                encoding="utf-8",
            )
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)


def worker_binding_fence(record: dict[str, Any]) -> tuple[str, ...]:
    return (
        str(record.get("worker_id") or ""),
        str(record.get("binding_generation") or ""),
        str(record.get("binding_lease_id") or ""),
        str(record.get("pane_id") or record.get("pane") or ""),
        str(record.get("pane_pid") or ""),
        str(record.get("host") or "127.0.0.1"),
        str(record.get("port") or ""),
    )


def require_expected_worker_binding(
    worker: dict[str, Any],
    *,
    expected_instance_id: str = "",
    expected_binding_generation: int | None = None,
    expected_fencing_generation: int | None = None,
) -> None:
    """Fail closed when a caller's preflight binding changed before submission."""
    has_expectation = (
        bool(expected_instance_id)
        or expected_binding_generation is not None
        or expected_fencing_generation is not None
    )
    if not has_expectation:
        return
    if (
        not expected_instance_id
        or type(expected_binding_generation) is not int
        or expected_binding_generation < 1
        or type(expected_fencing_generation) is not int
        or expected_fencing_generation < 1
    ):
        raise DispatchError("expected binding fence is incomplete")
    instance = derive_process_instance(worker)
    actual_instance_id = str(instance.get("instance_id") or "")
    actual_binding_generation = int(worker.get("binding_generation") or 0)
    actual_fencing_generation = int(
        worker.get("fencing_generation")
        or worker.get("binding_generation")
        or 0
    )
    if (
        actual_instance_id != expected_instance_id
        or actual_binding_generation != expected_binding_generation
        or actual_fencing_generation != expected_fencing_generation
    ):
        raise DispatchError(
            "worker binding drift before dispatch: "
            f"expected=({expected_instance_id},"
            f"{expected_binding_generation},{expected_fencing_generation}) "
            f"actual=({actual_instance_id},"
            f"{actual_binding_generation},{actual_fencing_generation})"
        )


def require_supervision_dispatch_claim(
    root: Path,
    *,
    supervision_run_id: str = "",
    supervision_logical_action_id: str = "",
    supervision_lease_epoch: int | None = None,
    supervision_fencing_token: str = "",
) -> None:
    """Revalidate a supervisor lease/claim while the worker registry is locked."""
    has_claim = (
        bool(supervision_run_id)
        or bool(supervision_logical_action_id)
        or supervision_lease_epoch is not None
        or bool(supervision_fencing_token)
    )
    if not has_claim:
        return
    if (
        not supervision_run_id
        or not supervision_logical_action_id
        or type(supervision_lease_epoch) is not int
        or supervision_lease_epoch < 1
        or not supervision_fencing_token
    ):
        raise DispatchError("supervision dispatch claim is incomplete")
    try:
        validate_dispatch_claim(
            root,
            run_id=supervision_run_id,
            logical_action_id=supervision_logical_action_id,
            fencing_token=supervision_fencing_token,
            lease_epoch=supervision_lease_epoch,
        )
    except SupervisionControlError as exc:
        raise DispatchError(f"supervision dispatch claim rejected: {exc}") from exc


def require_binding_lease_for_submit(worker: dict[str, Any]) -> None:
    lease_id = str(worker.get("binding_lease_id") or "")
    expires_at = str(
        worker.get("binding_expires_at")
        or worker.get("expires_at")
        or ""
    )
    if not lease_id or not expires_at:
        raise DispatchError(
            "binding lease metadata is required for real submission"
        )
    try:
        expires = datetime.fromisoformat(expires_at.replace("Z", "+00:00"))
        if expires.tzinfo is None:
            expires = expires.replace(tzinfo=timezone.utc)
    except ValueError as exc:
        raise DispatchError(
            f"binding lease expiry is invalid: {expires_at}"
        ) from exc
    if expires <= datetime.now(timezone.utc):
        raise DispatchError(f"binding lease expired at {expires_at}")


def binding_lease_seconds_remaining(worker: dict[str, Any]) -> float | None:
    """Seconds until the binding lease expires; None when unusable."""
    expires_at = str(
        worker.get("binding_expires_at")
        or worker.get("expires_at")
        or ""
    )
    try:
        expires = datetime.fromisoformat(expires_at.replace("Z", "+00:00"))
    except ValueError:
        return None
    if expires.tzinfo is None:
        expires = expires.replace(tzinfo=timezone.utc)
    return (expires - datetime.now(timezone.utc)).total_seconds()


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except Exception:
        return ""


def write_text(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


def append_event(path: Path, event: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(event, sort_keys=True, ensure_ascii=False) + "\n")


def finalize_delivered_owner_lock(
    root: Path,
    tdir: Path,
    lock_file: Path,
    lock_data: dict[str, Any],
    *,
    event_name: str,
) -> None:
    submitted_path = tdir / ".submitted"
    if not submitted_path.is_file():
        raise DispatchError(
            "submission transport returned success without "
            f"{rel(submitted_path, root)}"
        )

    transition_error: Exception | None = None
    try:
        update_owner_lock(
            lock_file,
            lock_data,
            expected_status="submitting",
            expected_version=owner_lock_version(lock_data) - 1,
        )
    except Exception as exc:
        transition_error = exc
        transition = {
            "schema_version": 1,
            "observed_at": utc_now(),
            "submitted_exists": True,
            "owner_lock_updated": False,
            "lock": rel(lock_file, root),
            "error_class": type(exc).__name__,
            "error": str(exc),
        }
        try:
            write_json(tdir / "post_submit_lock_transition.json", transition)
        except Exception as sidecar_exc:
            print(
                "warning: delivered task owner-lock transition and warning "
                f"sidecar both failed: {sidecar_exc}",
                file=sys.stderr,
            )

    event = {
        "ts": lock_data["submitted_at"],
        "event": event_name,
        "source": "omx_visible_dispatch",
        "worker": lock_data["worker_id"],
        "lock": rel(lock_file, root),
        "owner_lock_updated": transition_error is None,
    }
    if transition_error is not None:
        event["owner_lock_transition_error"] = str(transition_error)
    try:
        append_event(tdir / "events.jsonl", event)
    except Exception as exc:
        print(
            f"warning: delivered task event append failed: {exc}",
            file=sys.stderr,
        )


def task_truth(root: Path, run: str, task: str, *, fixture: str | None = None, runs_root: Path | None = None) -> dict[str, Any]:
    base = runs_root or visible_task_state.runs_root_for(root, fixture)
    try:
        return visible_task_state.truth_for_task(root, run, task, runs_root=base)
    except visible_task_state.TaskStateError as exc:
        raise DispatchError(str(exc)) from exc


def summary_state_value(summary: dict[str, Any]) -> str:
    return str(
        summary.get("final_protocol_terminal_state")
        or summary.get("protocol_terminal_state")
        or summary.get("terminal_state")
        or ""
    )


def settle_command_for(run: str, task: str) -> str:
    return (
        f"./bin/omx_visible_dispatch settle --root . --run {run} "
        f"--task {task} --allow-terminal-archive"
    )


def interrupted_recovery_command_for(
    run: str,
    task: str,
    reason: str,
    root: Path | None = None,
) -> str:
    safe_id(run, "run")
    safe_id(task, "task")
    if root is None:
        return (
            f"./bin/omx_visible_recovery close-interrupted-task --root . --run {run} "
            f"--task {task} --state blocked --reason {reason} --allow-recovery"
        )
    return " ".join(
        [
            shlex.quote(str(root / "bin" / "omx_visible_recovery")),
            "close-interrupted-task",
            "--root",
            shlex.quote(str(root)),
            "--run",
            run,
            "--task",
            task,
            "--state",
            "blocked",
            "--reason",
            reason,
            "--allow-recovery",
        ]
    )


def task_state_query_command_for(root: Path, run: str, task: str) -> str:
    safe_id(run, "run")
    safe_id(task, "task")
    return " ".join(
        [
            shlex.quote(str(root / "bin" / "omx_visible_task_state")),
            "--root",
            shlex.quote(str(root)),
            "--run",
            run,
            "--task",
            task,
        ]
    )


def recovery_handshake_command_for(worker_id: str, run: str, task: str) -> str:
    safe_id(worker_id, "worker")
    safe_id(run, "run")
    safe_id(task, "task")
    return (
        "./bin/omx_visible_dispatch recovery-handshake --root . "
        f"--worker {worker_id} --run {run} --task {task} "
        "--session-action recovery "
        "--session-action-reason recovery_handshake "
        "--allow-recovery"
    )


def settle_latest_command(worker_id: str | None = None) -> str:
    base = "./bin/omx_visible_dispatch settle-latest --root ."
    if worker_id:
        safe_id(worker_id, "worker")
        return f"{base} --worker {worker_id} --allow-terminal-archive"
    return f"{base} --allow-terminal-archive"


def parse_wait_result_label(result: dict[str, Any]) -> str:
    stdout = str(result.get("stdout") or "")
    for line in reversed(stdout.splitlines()):
        stripped = line.strip()
        if stripped.startswith("wait_result:"):
            return stripped.split(":", 1)[1].strip()
    return ""


def parse_collect_completed(result: dict[str, Any]) -> bool:
    if result.get("timed_out"):
        return False
    try:
        completion = json.loads(str(result.get("stdout") or ""))
    except ValueError:
        return False
    return (
        isinstance(completion, dict)
        and set(completion) == {"collect_completed", "output"}
        and completion["collect_completed"] is True
        and isinstance(completion["output"], str)
    )


def parse_opencode_run_json_events(stdout: str) -> dict[str, Any]:
    events: list[dict[str, Any]] = []
    final_text = ""
    session_id = ""
    for line in stdout.splitlines():
        stripped = line.strip()
        if not stripped.startswith("{"):
            continue
        try:
            item = json.loads(stripped)
        except Exception:
            continue
        if not isinstance(item, dict):
            continue
        events.append(item)
        if not session_id and item.get("sessionID"):
            session_id = str(item.get("sessionID") or "")
        if item.get("type") == "text":
            part = item.get("part", {})
            if isinstance(part, dict) and part.get("text"):
                final_text = str(part.get("text") or "")
    return {
        "events": events,
        "event_count": len(events),
        "session_id": session_id,
        "final_text": final_text,
    }


def recoverable_lock_state(truth: dict[str, Any]) -> str:
    if truth.get("lock_is_terminal_stale"):
        return "stale_terminal_lock"
    if truth.get("has_active_lock"):
        return "active_lock"
    return "none"


