def write_finalizer_event(root: Path, run: str, task: str, event: dict[str, Any], *, runs_root: Path | None = None) -> None:
    base = runs_root or visible_runs_root(root)
    tdir = visible_task_state.task_dir(root, run, task, runs_root=base)
    write_json(tdir / "finalizer_event.json", event)
    if base == visible_runs_root(root):
        recovery_dir = framework_root(root) / "recovery"
        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        write_json(recovery_dir / f"finalize_{run}_{task}_{stamp}.json", event)


def delayed_finalize_scan(
    root: Path,
    run: str,
    task: str,
    *,
    linger_seconds: int,
    linger_interval: int,
    max_total_seconds: int | None = None,
    fixture: str | None = None,
    runs_root: Path | None = None,
) -> dict[str, Any]:
    seconds = max(0, int(linger_seconds))
    interval = max(1, int(linger_interval))
    hard_cap = max(seconds, int(max_total_seconds or 0), 120)
    report_closeout_grace = max(seconds, 60)
    result = {
        "delayed_finalize_enabled": seconds > 0,
        "delayed_finalize_seconds": seconds,
        "delayed_finalize_interval": interval,
        "delayed_finalize_attempts": 0,
        "delayed_finalize_observed_terminal": False,
        "delayed_finalize_terminal_state": "",
    }
    if seconds <= 0:
        return result

    started_at = time.time()
    deadline = started_at + seconds
    hard_deadline = started_at + hard_cap
    last_state = ""
    last_progress_signature = ""
    while time.time() < deadline:
        result["delayed_finalize_attempts"] += 1
        truth = task_truth(root, run, task, fixture=fixture, runs_root=runs_root)
        last_state = str(truth.get("protocol_terminal_state") or "")
        progress_signature = "|".join(
            [
                str(truth.get("last_event_ts") or ""),
                str(truth.get("report_bytes") or 0),
                ",".join(truth.get("flow_markers", [])),
                ",".join(truth.get("terminal_markers", [])),
            ]
        )
        if last_state in VALID_TERMINAL_STATES:
            result["delayed_finalize_observed_terminal"] = True
            result["delayed_finalize_terminal_state"] = last_state
            return result
        if progress_signature != last_progress_signature:
            last_progress_signature = progress_signature
            extension = report_closeout_grace if int(truth.get("report_bytes") or 0) > 0 else seconds
            deadline = min(hard_deadline, time.time() + extension)
        remaining = deadline - time.time()
        if remaining <= 0:
            break
        time.sleep(min(interval, remaining))

    final_truth = task_truth(root, run, task, fixture=fixture, runs_root=runs_root)
    owner = str(final_truth.get("owner") or "")
    if (
        fixture is None
        and runs_root is None
        and owner
        and str(final_truth.get("protocol_terminal_state") or "")
        not in VALID_TERMINAL_STATES
    ):
        readiness = tui_readiness(root, owner)
        observed = record_provider_error_observation(
            root,
            run,
            task,
            owner,
            readiness=readiness,
        )
        if observed.get("detected"):
            final_truth = task_truth(root, run, task)
    final_state = str(final_truth.get("protocol_terminal_state") or last_state or "")
    if final_state in VALID_TERMINAL_STATES:
        result["delayed_finalize_observed_terminal"] = True
    result["delayed_finalize_terminal_state"] = final_state
    return result


def run_one_summary_overrides(run: str, task: str, truth: dict[str, Any], wait_result_label: str) -> dict[str, Any]:
    current_state = str(truth.get("protocol_terminal_state") or "")
    quarantine_projection = str(
        truth.get("quarantine_projection_status") or ""
    )
    pending_after_timeout = bool(
        wait_result_label in RUN_ONE_DELAYED_FINALIZE_WAIT_RESULTS
        and current_state in NONTERMINAL_PROTOCOL_STATES
    )
    settle_admissible = bool(truth.get("lock_is_terminal_stale"))
    recommended = settle_command_for(run, task) if settle_admissible else ""
    if current_state in VALID_TERMINAL_STATES:
        run_one_exit_state = current_state
        needs_settle = False
        next_safe_action = "none"
        pending_after_timeout = False
    elif current_state == "verbal_terminal_without_protocol_signal":
        run_one_exit_state = current_state
        needs_settle = False
        next_safe_action = "manual_operator_review_or_recovery_handshake"
        pending_after_timeout = False
    elif (
        quarantine_projection == "quarantined_nonterminal"
        or current_state == "quarantined"
    ):
        run_one_exit_state = (
            quarantine_projection
            or "quarantined"
        )
        needs_settle = False
        next_safe_action = "inspect_quarantine_reason"
        pending_after_timeout = False
    elif current_state == "blocked_provider_error":
        run_one_exit_state = current_state
        needs_settle = False
        next_safe_action = (
            str(truth.get("provider_error_next_safe_action") or "")
            or "collect_task_bound_session_provider_evidence"
        )
        pending_after_timeout = False
    elif current_state in INVALID_TERMINAL_STATES:
        run_one_exit_state = wait_result_label or current_state
        needs_settle = False
        next_safe_action = "inspect_invalid_terminal_state"
        pending_after_timeout = False
    else:
        run_one_exit_state = "pending_after_timeout" if pending_after_timeout else (wait_result_label or current_state or "prepared")
        needs_settle = False
        if pending_after_timeout:
            next_safe_action = (
                "manual_operator_review_or_recovery_handshake"
                if truth.get("has_submitted") and truth.get("has_started")
                else "manual_operator_review"
            )
        else:
            next_safe_action = "none"
    return {
        "run_one_exit_state": run_one_exit_state,
        "pending_after_timeout": pending_after_timeout,
        "needs_settle": needs_settle,
        "recommended_settle_command": recommended,
        "lock_state_after_run_one": truth.get("lock_state") or "none",
        "next_safe_action": next_safe_action,
    }


def marker(path: Path, name: str) -> Path:
    return path / f".{name}"


def file_nonempty(path: Path) -> bool:
    try:
        return path.is_file() and path.stat().st_size > 0
    except OSError:
        return False


def task_dir(root: Path, run: str, task: str) -> Path:
    safe_id(run, "run")
    safe_id(task, "task")
    path = visible_runs_root(root) / run / "tasks" / task
    if not is_relative_to(path, visible_runs_root(root)):
        raise DispatchError("task path escaped .omx/framework/team/visible-runs")
    return path


def framework_run_arg(run: str) -> str:
    safe_id(run, "run")
    return f"visible-runs/{run}"


def registry_path(root: Path) -> Path:
    return framework_root(root) / "opencode_visible_workers.json"


def runtime_fixture_dir() -> Path | None:
    value = os.environ.get("OMX_RUNTIME_FIXTURE_DIR", "").strip()
    return Path(value).resolve() if value else None


def _runtime_registry_call(func: Any, *args: Any, **kwargs: Any) -> Any:
    try:
        return func(*args, **kwargs)
    except RegistryError as exc:
        raise DispatchError(str(exc)) from exc


def load_visible_workers(root: Path) -> list[dict[str, Any]]:
    return _runtime_registry_call(runtime_registry.load_visible_workers, root, runtime_fixture_dir())


def infer_worker_role(worker: dict[str, Any]) -> str:
    return runtime_registry.infer_worker_role(worker)


def is_production_visible_worker(worker: dict[str, Any]) -> bool:
    return str(worker.get("role") or infer_worker_role(worker)) in {"default", "production_candidate"}


def default_worker_record(root: Path) -> dict[str, Any]:
    return _runtime_registry_call(runtime_registry.resolve_default_worker, root, runtime_fixture_dir())


def default_worker_rebind_readiness(
    root: Path,
    *,
    backend: str = RUNTIME_BACKEND,
) -> tuple[dict[str, Any], dict[str, Any]]:
    worker = default_worker_record(root)
    ensure_worker_allowed(root, worker, must_be_default=True)
    return worker, worker_rebind_readiness(
        root,
        str(worker["worker_id"]),
        backend=backend,
    )


def dispatchable_visible_workers(root: Path) -> list[dict[str, Any]]:
    workers = _runtime_registry_call(runtime_registry.load_visible_workers, root, runtime_fixture_dir())
    result: list[dict[str, Any]] = []
    for worker in workers:
        checked = runtime_registry.validate_worker_for_dispatch(worker)
        if checked.get("dispatch_allowed"):
            result.append(checked.get("worker", worker))
    return result


def dispatchable_visible_worker_ids(root: Path) -> list[str]:
    return [str(worker.get("worker_id") or "") for worker in dispatchable_visible_workers(root)]


def worker_record(root: Path, worker_id: str | None) -> dict[str, Any]:
    if worker_id:
        safe_id(worker_id, "worker")
    return _runtime_registry_call(runtime_registry.resolve_worker_record, root, worker_id or "", runtime_fixture_dir())


def ensure_worker_allowed(root: Path, worker: dict[str, Any], *, must_be_default: bool = False) -> None:
    validation = runtime_registry.validate_worker_for_dispatch(worker, must_be_default=must_be_default)
    if validation["errors"]:
        raise DispatchError("; ".join(validation["errors"]))


def resolve_dispatch_worker(
    root: Path,
    requested_worker_id: str | None,
    *,
    backend: str = RUNTIME_BACKEND,
) -> tuple[dict[str, Any], str]:
    if requested_worker_id:
        worker = worker_record(root, requested_worker_id)
        ensure_worker_allowed(root, worker, must_be_default=False)
        return worker, "explicit"
    worker, readiness = default_worker_rebind_readiness(root, backend=backend)
    if not readiness.get("rebind_ok"):
        raise DispatchError(
            "no healthy default worker: "
            f"{worker['worker_id']} rebind_status={readiness.get('rebind_status')}; "
            "pass --worker <healthy-worker-id>"
        )
    return worker, "default"


def backend_type_for(backend: str) -> str:
    return "rmux" if str(backend).startswith("rmux") else "tmux"


def run_command(argv: list[str], cwd: Path, timeout: int = 60) -> dict[str, Any]:
    started = time.time()
    try:
        proc = subprocess.run(
            argv,
            cwd=str(cwd),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
        return {
            "argv": argv,
            "returncode": proc.returncode,
            "stdout": proc.stdout,
            "stderr": proc.stderr,
            "elapsed_seconds": round(time.time() - started, 3),
            "timed_out": False,
        }
    except subprocess.TimeoutExpired as exc:
        return {
            "argv": argv,
            "returncode": 124,
            "stdout": exc.stdout or "",
            "stderr": exc.stderr or "command timed out",
            "elapsed_seconds": round(time.time() - started, 3),
            "timed_out": True,
        }
    except FileNotFoundError as exc:
        return {
            "argv": argv,
            "returncode": 127,
            "stdout": "",
            "stderr": str(exc),
            "elapsed_seconds": round(time.time() - started, 3),
            "timed_out": False,
        }


def strong_replacement_binding_evidence(
    root: Path,
    worker_id: str,
) -> dict[str, Any]:
    command = run_command(
        [
            str(rebind_path(root)),
            "check",
            "--root",
            str(root),
            "--worker",
            worker_id,
            "--runtime-backend",
            RUNTIME_BACKEND,
            "--json",
        ],
        root,
        timeout=20,
    )
    try:
        payload = json.loads(command.get("stdout") or "{}")
    except json.JSONDecodeError:
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    live = payload.get("live", {})
    if not isinstance(live, dict):
        live = {}
    status = str(payload.get("status") or "")
    binding_confidence = str(
        live.get("binding_confidence")
        or payload.get("binding_confidence")
        or ""
    )
    live_host_boot_id = str(live.get("host_boot_id") or "")
    current_boot_id = current_host_boot_id()
    allowed_statuses = {
        "current_binding_ok",
        "stale_pane_rebind_available",
        "rebind_available",
        "registry_session_mismatch_rebind_available",
    }
    identity_complete = bool(
        str(live.get("pane_id") or "").startswith("%")
        and nonnegative_int(live.get("pane_pid")) > 0
        and nonnegative_int(live.get("opencode_pid")) > 0
        and nonnegative_int(live.get("port")) > 0
    )
    returncode = command.get("returncode")
    timed_out = bool(command.get("timed_out"))
    documented_exit_paired = bool(
        status == "current_binding_ok"
        and returncode == 0
    ) or bool(
        status
        in {
            "stale_pane_rebind_available",
            "rebind_available",
            "registry_session_mismatch_rebind_available",
        }
        and returncode == 1
    )
    ok = bool(
        status in allowed_statuses
        and documented_exit_paired
        and not timed_out
        and binding_confidence == "strong"
        and identity_complete
        and live_host_boot_id
        and current_boot_id
        and live_host_boot_id == current_boot_id
    )
    return {
        **payload,
        "ok": ok,
        "status": status,
        "binding_confidence": binding_confidence,
        "live": live,
        "current_host_boot_id": current_boot_id,
        "documented_exit_paired": documented_exit_paired,
        "command_returncode": returncode,
        "command_timed_out": timed_out,
        "command_stderr": str(command.get("stderr") or "")[:1000],
    }


def stalled_recovery_owner_absence_evidence(
    root: Path,
    worker_id: str,
    lock_data: dict[str, Any],
) -> dict[str, Any]:
    command = run_command(
        [
            str(rebind_path(root)),
            "check",
            "--root",
            str(root),
            "--worker",
            worker_id,
            "--runtime-backend",
            RUNTIME_BACKEND,
            "--json",
        ],
        root,
        timeout=20,
    )
    try:
        payload = json.loads(command.get("stdout") or "{}")
    except json.JSONDecodeError:
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    registry = payload.get("registry", {})
    live = payload.get("live", {})
    if not isinstance(registry, dict):
        registry = {}
    if not isinstance(live, dict):
        live = {}
    checks = live.get("checks", {})
    if not isinstance(checks, dict):
        checks = {}
    lock_pids = {
        nonnegative_int(value)
        for key in ("listener_pids", "opencode_pids")
        for value in (
            lock_data.get(key)
            if isinstance(lock_data.get(key), list)
            else []
        )
        if nonnegative_int(value)
    }
    lock_scalar_opencode_pid = nonnegative_int(
        lock_data.get("opencode_pid")
    )
    if lock_scalar_opencode_pid:
        lock_pids.add(lock_scalar_opencode_pid)
    lock_pane_id = str(lock_data.get("pane_id") or "")
    lock_pane_pid = nonnegative_int(lock_data.get("pane_pid"))
    lock_port = nonnegative_int(lock_data.get("port"))
    registry_opencode_pid = nonnegative_int(registry.get("opencode_pid"))
    live_pane_instances, pane_inventory_available, pane_record = (
        _live_pane_inventory()
    )
    conditions = {
        "rebind_check_completed": not bool(command.get("timed_out")),
        "worker_matches": str(payload.get("worker_id") or "") == worker_id,
        "status_port_not_live": str(payload.get("status") or "")
        == "port_not_live",
        "registry_identity_matches_lock": bool(
            lock_pane_id
            and lock_pane_pid
            and lock_port
            and str(registry.get("pane_id") or "") == lock_pane_id
            and nonnegative_int(registry.get("pane_pid")) == lock_pane_pid
            and nonnegative_int(registry.get("port")) == lock_port
        ),
        "registry_process_matches_lock": bool(
            lock_pids
            and registry_opencode_pid
            and registry_opencode_pid in lock_pids
        ),
        "recorded_processes_absent": bool(
            lock_pids
            and all(
                not (Path("/proc") / str(pid)).exists()
                for pid in lock_pids
            )
        ),
        "registry_pane_absent": payload.get(
            "registry_pane_exists_in_current_window"
        )
        is False,
        "recorded_pane_instance_absent": bool(
            lock_pane_id
            and lock_pane_pid
            and pane_inventory_available
            and live_pane_instances.get(lock_pane_id) != lock_pane_pid
        ),
        "live_pane_absent": not str(live.get("pane_id") or "")
        and nonnegative_int(live.get("pane_pid")) == 0,
        "live_process_absent": nonnegative_int(live.get("opencode_pid")) == 0
        and checks.get("listener_pid_found") is False
        and checks.get("opencode_pid_in_current_window_pane_tree") is False,
        "live_port_absent": nonnegative_int(live.get("port")) == lock_port
        and checks.get("port_live") is False,
        "task_session_unreachable": checks.get("session_status_ok") is False,
    }
    return {
        "ok": all(conditions.values()),
        "observed_at": utc_now(),
        "worker_id": worker_id,
        "conditions": conditions,
        "registry": registry,
        "live": live,
        "rebind_command": {
            "argv": command.get("argv", []),
            "returncode": command.get("returncode"),
            "stderr": command.get("stderr", ""),
            "timed_out": bool(command.get("timed_out")),
        },
        "pane_command": pane_record,
    }


def _live_pane_inventory() -> tuple[dict[str, int], bool, dict[str, Any]]:
    """Read the live tmux pane inventory with shape validation.

    Returns the pane-id to pane-pid mapping, whether the inventory is
    usable (command succeeded, not timed out, every row well formed, and
    at least one pane row parsed - a zero-row or malformed read is not
    proof that any pane is absent), and the command record.
    """
    pane_command = run_command(
        ["tmux", "list-panes", "-a", "-F", "#{pane_id}\t#{pane_pid}"],
        _THIS_FILE.parent.parent,
        timeout=5,
    )
    live_pane_instances: dict[str, int] = {}
    rows_well_formed = True
    for line in str(pane_command.get("stdout") or "").splitlines():
        pane_id, separator, pane_pid = line.strip().partition("\t")
        pane_pid_value = nonnegative_int(pane_pid)
        if not (pane_id.startswith("%") and separator and pane_pid_value):
            rows_well_formed = False
            continue
        live_pane_instances[pane_id] = pane_pid_value
    inventory_usable = bool(
        pane_command.get("returncode") == 0
        and not bool(pane_command.get("timed_out"))
        and rows_well_formed
        and live_pane_instances
    )
    return live_pane_instances, inventory_usable, {
        "argv": pane_command.get("argv", []),
        "returncode": pane_command.get("returncode"),
        "stderr": pane_command.get("stderr", ""),
        "timed_out": bool(pane_command.get("timed_out")),
        "parsed_rows": len(live_pane_instances),
        "rows_well_formed": rows_well_formed,
    }


def _recorded_owner_absence_probe(
    lock_data: dict[str, Any],
    boot_conditions: dict[str, bool],
) -> dict[str, Any]:
    """Shared recorded-instance owner-absence probe.

    Proves the lock-recorded pane/process instance cannot still be the
    owner: every recorded process pid (listener and opencode lists, the
    scalar opencode_pid, and the recorded pane_pid) is absent from /proc
    and the recorded pane instance is absent from a shape-validated live
    tmux inventory (a reused pane number carries a different pane pid, and
    a reused pid would still exist in /proc, so both reuse shapes fail
    closed). A still-existing recorded pane process means unknown owner
    absence even when the inventory no longer lists that pane. The
    boot-generation predicate is caller-specific and stays explicit.
    """
    lock_host_boot_id = str(lock_data.get("host_boot_id") or "")
    current_boot_id = current_host_boot_id()
    lock_pids = {
        nonnegative_int(value)
        for key in ("listener_pids", "opencode_pids")
        for value in (
            lock_data.get(key)
            if isinstance(lock_data.get(key), list)
            else []
        )
        if nonnegative_int(value)
    }
    lock_scalar_opencode_pid = nonnegative_int(
        lock_data.get("opencode_pid")
    )
    if lock_scalar_opencode_pid:
        lock_pids.add(lock_scalar_opencode_pid)
    lock_pane_id = str(lock_data.get("pane_id") or "")
    lock_pane_pid = nonnegative_int(lock_data.get("pane_pid"))
    lock_port = nonnegative_int(lock_data.get("port"))
    recorded_process_pids = set(lock_pids)
    if lock_pane_pid:
        recorded_process_pids.add(lock_pane_pid)
    live_pane_instances, inventory_usable, pane_record = (
        _live_pane_inventory()
    )
    conditions = {
        **boot_conditions,
        "lock_identity_recorded": bool(
            lock_pane_id.startswith("%")
            and lock_pane_pid > 0
            and lock_port > 0
        ),
        "lock_processes_recorded": bool(lock_pids),
        "recorded_processes_absent": bool(
            recorded_process_pids
            and all(
                not (Path("/proc") / str(pid)).exists()
                for pid in recorded_process_pids
            )
        ),
        "pane_inventory_available": inventory_usable,
        "recorded_pane_instance_absent": bool(
            lock_pane_id
            and lock_pane_pid
            and inventory_usable
            and live_pane_instances.get(lock_pane_id) != lock_pane_pid
        ),
    }
    return {
        "ok": all(conditions.values()),
        "observed_at": utc_now(),
        "conditions": conditions,
        "lock_host_boot_id": lock_host_boot_id,
        "current_host_boot_id": current_boot_id,
        "lock_pane_id": lock_pane_id,
        "lock_pane_pid": lock_pane_pid,
        "lock_port": lock_port,
        "lock_process_pids": sorted(recorded_process_pids),
        "live_pane_instances": live_pane_instances,
        "pane_command": pane_record,
    }


def same_boot_owner_absence_evidence(
    lock_data: dict[str, Any],
) -> dict[str, Any]:
    """Prove a same-boot owner instance is gone from its recorded lock identity.

    Unlike ``stalled_recovery_owner_absence_evidence`` the port may be live
    with a reviewed replacement instance, so this evidence only proves the
    lock-recorded pane/process instance cannot still be the owner; the boot
    generation must be recorded in the lock and match the current boot.
    """
    lock_host_boot_id = str(lock_data.get("host_boot_id") or "")
    current_boot_id = current_host_boot_id()
    return _recorded_owner_absence_probe(
        lock_data,
        {
            "lock_boot_matches_current": bool(
                lock_host_boot_id
                and current_boot_id
                and lock_host_boot_id == current_boot_id
            ),
        },
    )


def missing_boot_owner_absence_evidence(
    lock_data: dict[str, Any],
) -> dict[str, Any]:
    """Prove a legacy no-boot lock's owner instance is gone (#774).

    For locks written before host boot stamping, the boot generation is
    unknown - it stays unknown and is never reinterpreted as a mismatch.
    This evidence instead proves the lock-recorded pane/process identity
    cannot still be the owner, and additionally requires a readable
    current boot id so a live replacement can be paired with it by the
    caller through strong replacement binding evidence.
    """
    lock_host_boot_id = str(lock_data.get("host_boot_id") or "")
    current_boot_id = current_host_boot_id()
    return _recorded_owner_absence_probe(
        lock_data,
        {
            "lock_boot_unrecorded": not lock_host_boot_id,
            "current_boot_id_available": bool(current_boot_id),
        },
    )


def legacy_owner_absence_task_eligibility(
    root: Path,
    tdir: Path,
    *,
    run: str,
    task: str,
    worker_id: str,
) -> dict[str, Any]:
    """Exact legacy owner-absence eligibility for one task (#774).

    Reads the current task state so the same predicate gates the reviewed
    pre-check and the registry-locked re-verification immediately before
    archive: the task owner is exactly the named worker, the task is
    protocol-running with started receipt, and report, terminal markers,
    and recovery handshake are all absent.
    """
    truth = task_truth(root, run, task)
    report_path = tdir / "report.md"
    report_bytes = (
        report_path.stat().st_size if report_path.is_file() else 0
    )
    terminal_marker_count = sum(
        1
        for name in (".done", ".fail", ".blocked")
        if (tdir / name).is_file()
    )
    recovery_handshake = read_json(tdir / "recovery_handshake.json")
    conditions = {
        "owner_is_named_worker": (
            read_text(tdir / "owner").strip() == worker_id
        ),
        "protocol_running": (
            str(truth.get("protocol_terminal_state") or "") == "running"
        ),
        "receipt_started": protocol_receipt_state(truth) == "started",
        "report_empty": report_bytes == 0,
        "no_terminal_markers": terminal_marker_count == 0,
        "no_recovery_handshake": not recovery_handshake,
    }
    return {
        "eligible": all(conditions.values()),
        "conditions": conditions,
        "report_bytes": report_bytes,
        "terminal_marker_count": terminal_marker_count,
    }


def predelivery_rotation_task_eligibility(
    tdir: Path,
    lock_data: dict[str, Any],
    *,
    run: str,
    task: str,
    worker_id: str,
) -> dict[str, Any]:
    """Exact pre-delivery rotation-reservation eligibility for one task.

    Reads only the task directory and the caller's lock data so the same
    predicate gates the reviewed pre-check and the final registry-locked
    re-verification: strictly empty pending fence session, current modern
    terminal-protocol identity for this fence, matching task owner and lock
    worker, and no delivered, receipted, reported, or terminal evidence.
    """
    fence = read_json(tdir / "acceptance_fence.json")
    fence_matches_task = bool(
        fence
        and str(fence.get("run_id") or "") == run
        and str(fence.get("task_id") or "") == task
        and str(fence.get("worker_id") or "") == worker_id
    )
    fence_pending_empty_session = bool(
        fence_matches_task
        and str(fence.get("session_fence_state") or "")
        == "pending_live_observation"
        and fence.get("session_id") == ""
    )
    protocol_identity_current = bool(
        classify_terminal_protocol(tdir).get("classification")
        == "modern_v2"
        and _current_fence_attempt_contract(tdir, fence) is not None
    )
    owner = read_text(tdir / "owner").strip()
    flow_markers = [
        name for name in FLOW_MARKERS if marker(tdir, name).is_file()
    ]
    report_path = tdir / "report.md"
    report_bytes = (
        report_path.stat().st_size if report_path.is_file() else 0
    )
    terminal_marker_count = sum(
        1 for name in TERMINAL_MARKERS if marker(tdir, name).is_file()
    )
    evidence = {
        "lock_status": str(lock_data.get("status") or ""),
        "fence_present": bool(fence),
        "fence_matches_task": fence_matches_task,
        "fence_pending_empty_session": fence_pending_empty_session,
        "protocol_identity_current": protocol_identity_current,
        "owner_matches": owner == worker_id,
        "lock_worker_matches": (
            str(lock_data.get("worker_id") or "") == worker_id
        ),
        "flow_markers": flow_markers,
        "recovery_handshake_present": bool(
            read_json(tdir / "recovery_handshake.json")
        ),
        "report_bytes": report_bytes,
        "terminal_marker_count": terminal_marker_count,
        "delivery_record_present": (tdir / "delivery.json").is_file(),
    }
    evidence["eligible"] = all(
        (
            evidence["lock_status"] == "rotation_reserved",
            fence_pending_empty_session,
            protocol_identity_current,
            evidence["owner_matches"],
            evidence["lock_worker_matches"],
            flow_markers == [],
            not evidence["recovery_handshake_present"],
            report_bytes == 0,
            terminal_marker_count == 0,
            not evidence["delivery_record_present"],
        )
    )
    return evidence


def intermediate_wait_timeout_state(
    wait_result: dict[str, Any],
    summary: dict[str, Any],
) -> str:
    if not bool(wait_result.get("timed_out")):
        return ""
    final_state = str(
        summary.get("final_protocol_terminal_state")
        or summary.get("protocol_terminal_state")
        or ""
    )
    if final_state in VALID_TERMINAL_STATES:
        return "recovered_by_finalization"
    return "pending_after_timeout"


def tool_status(root: Path, path: Path) -> dict[str, Any]:
    return {
        "path": rel(path, root),
        "exists": path.is_file(),
        "executable": os.access(path, os.X_OK) if path.exists() else False,
    }


def ensure_state_team_clean(root: Path) -> None:
    state = team_root(root)
    if not state.exists():
        return
    polluted = sorted(path.name for path in state.iterdir() if path.is_dir() and path.name in {"_framework", "demo-run", "dispatch-demo"})
    if polluted:
        raise DispatchError(f".omx/state/team contains framework/internal dirs: {', '.join(polluted)}")


def task_state(tdir: Path) -> dict[str, Any]:
    terminal = [name for name in TERMINAL_MARKERS if marker(tdir, name).is_file()]
    flows = [name for name in FLOW_MARKERS if marker(tdir, name).is_file()]
    report = tdir / "report.md"
    report_exists = report.is_file()
    report_nonempty = file_nonempty(report)
    report_bytes = report.stat().st_size if report.exists() else 0
    quarantine = visible_task_state.quarantine_for_task(
        tdir,
        tdir.parent.parent.name,
        tdir.name,
    )
    quarantine_valid = bool(quarantine)
    status = "created"
    reason = "task directory exists"
    if len(terminal) > 1:
        status = "invalid_conflicting_terminal_markers"
        reason = "multiple terminal markers exist"
    elif terminal:
        term = terminal[0]
        if not report_nonempty:
            status = "invalid_terminal_no_report"
            reason = f".{term} without non-empty report.md"
        elif term == "done":
            status = "completed"
            reason = "report.md plus .done"
        elif term == "fail":
            status = "failed"
            reason = "report.md plus .fail"
        elif term == "blocked":
            status = "blocked"
            reason = "report.md plus .blocked"
    elif quarantine_valid:
        status = "quarantined_nonterminal"
        reason = (
            str(quarantine.get("quarantine_reason") or "")
            or "reviewed nonterminal task quarantine"
        )
    elif (tdir / "submit_interrupted.json").is_file():
        status = "delivery_uncertain"
        reason = "submitter interrupted before delivery outcome was classified"
    elif "submitted" in flows and "received" not in flows:
        status = "delivery_uncertain"
        reason = ".submitted exists without .received"
    elif "received" in flows and "started" not in flows:
        status = "received"
        reason = ".received exists without .started"
    elif "started" in flows or "heartbeat" in flows:
        status = "running"
        reason = ".started or .heartbeat exists"
    elif (tdir / "owner").is_file():
        status = "assigned"
        reason = "owner exists without lifecycle marker"
    elif (tdir / "task.md").is_file():
        status = "created"
        reason = "task.md exists"
    owner = read_text(tdir / "owner").strip()
    backend = read_text(tdir / "backend").strip()
    updated_at = ""
    mtimes: list[float] = []
    if tdir.exists():
        for path in tdir.iterdir():
            if path.is_file():
                try:
                    mtimes.append(path.stat().st_mtime)
                except OSError:
                    pass
    if mtimes:
        updated_at = datetime.fromtimestamp(max(mtimes), timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    return {
        "status": status,
        "reason": reason,
        "terminal_markers": terminal,
        "flow_markers": flows,
        "report_exists": report_exists,
        "report_nonempty": report_nonempty,
        "report_bytes": report_bytes,
        "owner": owner,
        "backend": backend,
        "updated_at": updated_at,
        "quarantine_state": "quarantined" if quarantine_valid else "",
        "quarantine_reason": (
            str(quarantine.get("quarantine_reason") or "")
            if quarantine_valid
            else ""
        ),
    }


def lock_path(root: Path, worker_id: str) -> Path:
    safe_id(worker_id, "worker")
    return locks_root(root) / f"{worker_id}.lock.json"


def archive_lock(
    root: Path,
    lock_file: Path,
    reason: str,
    *,
    expected: dict[str, Any] | None = None,
    archive_root: Path | None = None,
    registry_locked: bool = False,
) -> Path:
    expected_data = dict(expected) if isinstance(expected, dict) else read_json(lock_file)
    expected_fence = owner_lock_transition_fence(expected_data)
    lock_context = (
        nullcontext()
        if registry_locked
        else visible_registry_lock(root)
    )
    with lock_context:
        data = read_json(lock_file)
        actual_fence = owner_lock_transition_fence(data)
        if actual_fence != expected_fence:
            raise DispatchError(
                "owner lock identity changed"
                f" before archive: expected={expected_fence!r}"
                f" actual={actual_fence!r}"
            )
        now = utc_now()
        data["status"] = "released"
        data["released_at"] = now
        data["release_reason"] = reason
        worker = safe_id(
            str(data.get("worker_id") or lock_file.stem.replace(".lock", "")),
            "worker",
        )
        run = str(data.get("run") or "unknown")
        task = str(data.get("task") or "unknown")
        provider_error = read_json(
            task_dir(root, run, task)
            / "provider_error_observation.json"
        )
        visible_task_state.record_provider_error_rotation_requirement_locked(
            root,
            worker,
            run=run,
            task=task,
            provider_error=provider_error,
        )
        safe_run = "".join(
            ch if ch.isalnum() or ch in {"-", "_"} else "_" for ch in run
        )
        safe_task = "".join(
            ch if ch.isalnum() or ch in {"-", "_"} else "_" for ch in task
        )
        destination = archive_root or lock_archive_root(root)
        archive = destination / (
            f"{worker}.{safe_run}.{safe_task}."
            f"{now.replace(':', '').replace('-', '')}.lock.json"
        )
        try:
            durable_atomic_write(
                archive,
                json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False)
                + "\n",
            )
        except OSError as exc:
            raise DispatchError(
                f"owner lock archive was not durable before release: {exc}"
            ) from exc
        lock_file.unlink(missing_ok=True)
        try:
            fsync_directory(lock_file.parent)
        except OSError as exc:
            raise DispatchError(
                "owner lock was removed but the removal is not confirmed "
                f"durable: {exc}; a stale terminal lock may reappear and "
                "must be settled through the existing idempotent stale-lock "
                "handling"
            ) from exc
        return archive


def is_stale_acceptance_fence_submit_error(result: dict[str, Any]) -> bool:
    output = f"{result.get('stdout') or ''}\n{result.get('stderr') or ''}"
    return "E_STALE_ACCEPTANCE_FENCE" in output


def record_submit_interruption(
    root: Path,
    tdir: Path,
    lock_file: Path,
    lock_data: dict[str, Any],
    *,
    run: str,
    task: str,
    worker_id: str,
) -> None:
    interrupted_at = utc_now()
    record = {
        "schema_version": 1,
        "interrupted_at": interrupted_at,
        "run": run,
        "task": task,
        "worker": worker_id,
        "phase": "adapter_submit",
        "submitted_exists": (tdir / ".submitted").exists(),
        "delivery_attempt_exists": (tdir / "delivery_attempt.json").exists(),
        "owner_lock_updated": False,
    }
    write_json(tdir / "submit_interrupted.json", record)

    try:
        current_lock = read_json(lock_file)
        if (
            owner_lock_identity(current_lock) != owner_lock_identity(lock_data)
            or str(current_lock.get("status") or "") != "submitting"
        ):
            record["owner_lock_update_error"] = "owner_lock_changed"
        else:
            interrupted_lock = {
                **current_lock,
                "owner_lock_version": owner_lock_version(current_lock) + 1,
                "status": "submit_interrupted",
                "updated_at": interrupted_at,
                "submit_interruption_path": rel(
                    tdir / "submit_interrupted.json",
                    root,
                ),
            }
            update_owner_lock(
                lock_file,
                interrupted_lock,
                expected_status="submitting",
                expected_version=owner_lock_version(current_lock),
            )
            record["owner_lock_updated"] = True
    except Exception as exc:
        record["owner_lock_update_error"] = str(exc)

    write_json(tdir / "submit_interrupted.json", record)
    append_event(
        tdir / "events.jsonl",
        {
            "ts": interrupted_at,
            "event": "visible_dispatch_submit_interrupted",
            "source": "omx_visible_dispatch",
            "worker": worker_id,
            "owner_lock_updated": record["owner_lock_updated"],
        },
    )


def resolve_lock(root: Path, worker_id: str, *, auto_release_terminal: bool = True) -> dict[str, Any]:
    path = lock_path(root, worker_id)
    if not path.is_file():
        return {"active": False, "path": rel(path, root)}
    data = read_json(path)
    run = str(data.get("run", ""))
    task = str(data.get("task", ""))
    if run and task:
        truth = task_truth(root, run, task)
        if auto_release_terminal and truth["protocol_terminal_state"] in VALID_TERMINAL_STATES:
            durability = pin_terminal_authority(task_dir(root, run, task))
            if not durability.get("ok"):
                data["task_truth"] = truth
                return {
                    "active": True,
                    "path": rel(path, root),
                    "lock": data,
                    "release_blocked_reason": str(durability.get("reason") or ""),
                }
            try:
                archive = archive_lock(
                    root,
                    path,
                    "stale_terminal_task",
                    expected=data,
                )
            except DispatchError as exc:
                data["task_truth"] = truth
                return {
                    "active": True,
                    "path": rel(path, root),
                    "lock": data,
                    "release_blocked_reason": f"owner_lock_archive_failed: {exc}",
                }
            return {"active": False, "released_stale_terminal": True, "archive": rel(archive, root), "previous": data}
        data["task_truth"] = truth
    return {"active": True, "path": rel(path, root), "lock": data}


def validate_native_submit_guard(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    expected_worker: dict[str, Any],
    expected_lock: dict[str, Any],
) -> None:
    tdir = task_dir(root, run, task)
    with visible_registry_lock(root):
        current_worker = worker_record(root, worker_id)
        if not current_worker.get("allow_auto_submit"):
            raise DispatchError(
                f"visible worker {worker_id!r} has allow_auto_submit=false"
            )
        require_binding_lease_for_submit(current_worker)
        if worker_binding_fence(current_worker) != worker_binding_fence(
            expected_worker
        ):
            raise DispatchError(
                f"worker {worker_id} binding changed before native submit"
            )

        current_lock = read_json(lock_path(root, worker_id))
        if owner_lock_identity(current_lock) != owner_lock_identity(
            expected_lock
        ):
            raise DispatchError(
                "owner lock identity changed before native submit"
            )
        if str(current_lock.get("status") or "") != "submitting":
            raise DispatchError(
                "owner lock status changed before native submit"
            )
        if owner_lock_version(current_lock) != owner_lock_version(
            expected_lock
        ):
            raise DispatchError(
                "owner lock version changed before native submit"
            )
        for field in ("binding_generation", "binding_lease_id"):
            lock_value = current_lock.get(field)
            worker_value = current_worker.get(field)
            if lock_value not in {None, ""} and lock_value != worker_value:
                raise DispatchError(
                    f"owner lock {field} changed before native submit"
                )

        if read_text(tdir / "owner").strip() != worker_id:
            raise DispatchError(
                "visible task owner changed before native submit"
            )
        if (tdir / ".submitted").is_file():
            raise DispatchError(
                "visible task became submitted before native submit"
            )
        terminal = any(
            (tdir / f".{name}").is_file()
            for name in TERMINAL_MARKERS
        )
        report = tdir / "report.md"
        if terminal or (report.is_file() and report.stat().st_size > 0):
            raise DispatchError(
                "visible native submit refuses terminal task evidence"
            )


BLOCKING_LOCK_DIAGNOSES = frozenset(
    {
        "active_nonterminal_lock",
        "active_inner_reviewer_progress",
        "provider_error_blocked_lock",
        "provider_interruption_recoverable",
        "context_compaction_review_lock",
        "context_overflow_blocked_lock",
        "delivery_uncertain_provider_error",
        "running_provider_error",
        "needs_settle_lock",
        "nonterminal_owner_instance_gone",
        "nonterminal_heartbeat_stale",
        "started_without_heartbeat_stale",
        "verbal_terminal_without_protocol_signal",
        "report_without_terminal_marker_stale",
        "recovery_handshake_pending",
        "recovery_handshake_prepared",
        "recovery_handshake_prepared_stalled",
        "recovery_handshake_session_unverified",
        "recovery_handshake_stalled",
        "recovery_handshake_submission_failed",
        "terminal_protocol_conflict",
        "invalid_terminal_state",
        "invalid_lock_reference",
        "missing_run_or_task",
        "active_unknown",
    }
)


def dispatch_binding_gate_reason(
    rebind: Any,
    worker_id: str,
    *,
    expected_root: str = "",
) -> str:
    if not isinstance(rebind, dict) or not rebind:
        return "observation_unknown"
    if type(rebind.get("schema_version")) is not int or rebind["schema_version"] != 1:
        return "observation_unknown"
    if str(rebind.get("worker_id") or "") != str(worker_id):
        return "wrong_target"
    if expected_root and str(rebind.get("root") or "") != expected_root:
        return "wrong_root"
    if str(rebind.get("status") or "") != "current_binding_ok":
        status = str(rebind.get("status") or "unknown")
        return f"binding_not_current:{status}"
    if rebind.get("ok") is not True:
        return "observation_unknown"
    if rebind.get("ready_for_dispatch") is not True:
        return "not_ready_for_dispatch"
    confidence = rebind.get("binding_confidence")
    live = rebind.get("live") if isinstance(rebind.get("live"), dict) else {}
    registry = rebind.get("registry") if isinstance(rebind.get("registry"), dict) else {}
    if confidence != "strong":
        return "binding_not_strong"
    if "registry_pane_exists_in_current_window" not in rebind:
        return "observation_unknown"
    if rebind.get("registry_pane_exists_in_current_window") is not True:
        return "window_mismatch"
    if not live or not registry:
        return "observation_unknown"
    registry_pane = registry.get("pane_id")
    live_pane = live.get("pane_id")
    if not isinstance(registry_pane, str) or not registry_pane.startswith("%"):
        return "observation_unknown"
    if live_pane != registry_pane:
        return "window_mismatch"
    mismatches = rebind.get("identity_mismatches")
    if not isinstance(mismatches, list):
        return "observation_unknown"
    if mismatches:
        return "window_mismatch"
    return ""


def evaluate_run_dispatch_preflight(worker_id: str, doctor_report: dict[str, Any]) -> dict[str, Any]:
    rebind = doctor_report.get("rebind_check")
    rebind_payload = rebind if isinstance(rebind, dict) else {}
    binding_reason = ""
    if rebind_payload:
        binding_reason = dispatch_binding_gate_reason(
            rebind_payload,
            worker_id,
            expected_root=str(doctor_report.get("root") or ""),
        )
    elif doctor_report.get("ok") is not True:
        binding_reason = "observation_unknown"
    errors = [
        str(item)
        for item in (doctor_report.get("errors") or [])
        if str(item).strip()
    ]
    lock_reason = ""
    diagnosis = doctor_report.get("lock_diagnosis")
    if isinstance(diagnosis, dict) and int(diagnosis.get("blocking_count") or 0) > 0:
        counts = diagnosis.get("counts") if isinstance(diagnosis.get("counts"), dict) else {}
        lock_reason = next(
            (
                name
                for name in BLOCKING_LOCK_DIAGNOSES
                if int(counts.get(name) or 0) > 0
            ),
            "target_busy",
        )
    elif any(item.startswith("active_lock_status:") for item in errors):
        lock_reason = "target_busy"
    failed_reason = binding_reason or lock_reason
    if not failed_reason and doctor_report.get("ok") is not True:
        failed_reason = errors[0] if errors else "doctor_failed"
    ok = not failed_reason and doctor_report.get("ok") is True
    return {
        "ok": ok,
        "worker_id": str(worker_id),
        "status": "passed" if ok else "failed",
        "failed_reason": failed_reason,
        "binding_status": str(rebind_payload.get("status") or ""),
    }


def print_run_dispatch_preflight(preflight: dict[str, Any]) -> None:
    print(f"run_preflight: {preflight.get('status') or 'failed'}")
    print(f"run_preflight_worker: {preflight.get('worker_id') or '-'}")
    if preflight.get("failed_reason"):
        print(f"run_preflight_reason: {preflight['failed_reason']}")
    print(
        "run_preflight_json: "
        + json.dumps(preflight, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    )


def _print_prompt_delivery_scope_notice(
    task_contract: dict[str, Any] | None,
) -> None:
    """Pre-submit delivery-scope explanation from the parsed task contract
    (#904). Deterministic advisory output through the single shared mode
    selector and notice wording; it explains the already-selected mode and
    grants nothing."""
    from visible_agent_orchestrator.leader_orchestrate import (
        selected_prompt_delivery_mode,
        prompt_delivery_scope_notice_lines,
    )

    mode = selected_prompt_delivery_mode(task_contract)
    for line in prompt_delivery_scope_notice_lines(mode):
        print(line)


def verify_worker(
    root: Path,
    worker_id: str,
    *,
    backend: str = RUNTIME_BACKEND,
    require_tui_endpoints: bool = True,
    rebind_command: dict[str, Any] | None = None,
) -> dict[str, Any]:
    try:
        codex_candidate = worker_record(root, worker_id)
    except DispatchError:
        codex_candidate = None
    if codex_candidate and str(
        codex_candidate.get("backend") or ""
    ) == "codex_tui":
        result = load_codex_adapter_module(root).verify_binding(
            root, worker_id
        )
        if result.get("binding_confidence") != "strong":
            raise DispatchError(
                f"codex binding verification failed for {worker_id}: "
                f"{json.dumps(result.get('checks') or {}, default=str)}"
            )
        return {
            "command": {"codex_binding_verify": result},
            "binding": result,
        }
    if rebind_command is None:
        argv = [str(rebind_path(root)), "check", "--root", str(root), "--worker", worker_id, "--runtime-backend", backend, "--json"]
        rebind_command = run_command(argv, root, timeout=45)
    result = rebind_command
    if result["returncode"] != 0:
        raise DispatchError(f"read-only rebind check failed for {worker_id}: {result['stderr'] or result['stdout']}")
    try:
        parsed = json.loads(result.get("stdout") or "{}")
    except Exception as exc:
        raise DispatchError(f"read-only rebind check did not return JSON: {exc}") from exc
    if not isinstance(parsed, dict) or parsed.get("status") != "current_binding_ok":
        raise DispatchError(f"read-only rebind check status is {parsed.get('status') if isinstance(parsed, dict) else 'invalid'}")
    live = parsed.get("live", {}) if isinstance(parsed.get("live"), dict) else {}
    registry = parsed.get("registry", {}) if isinstance(parsed.get("registry"), dict) else {}
    checks = live.get("checks", {}) if isinstance(live.get("checks"), dict) else {}
    binding = {
        "binding_confidence": live.get("binding_confidence") or registry.get("binding_confidence"),
        "pane_id": live.get("pane_id") or registry.get("pane_id"),
        "pane_pid": live.get("pane_pid") or registry.get("pane_pid"),
        "port": live.get("port") or registry.get("port"),
        "checks": checks,
        "detected_tui_methods": ["/tui/clear-prompt", "/tui/append-prompt", "/tui/submit-prompt"]
        if checks.get("required_tui_present") else [],
    }
    if binding.get("binding_confidence") != "strong":
        raise DispatchError(f"read-only rebind check did not produce strong binding for {worker_id}")
    if require_tui_endpoints:
        methods = set(binding.get("detected_tui_methods", []))
        required = {"/tui/clear-prompt", "/tui/append-prompt", "/tui/submit-prompt"}
        missing = sorted(required - methods)
        if missing:
            raise DispatchError(f"verified /doc missing required endpoint(s): {', '.join(missing)}")
    return {"command": result, "binding": binding}


def endpoint_schema(root: Path, port: int) -> dict[str, Any]:
    argv = [str(adapter_path(root)), "endpoint-schema", "--root", str(root), "--port", str(int(port))]
    result = run_command(argv, root, timeout=45)
    if result["returncode"] != 0:
        raise DispatchError(f"endpoint-schema failed for port {port}: {result['stderr'] or result['stdout']}")
    path = framework_root(root) / f"opencode_tui_endpoint_schema_{int(port)}.json"
    data = read_json(path)
    if not data.get("all_required_endpoints_present"):
        raise DispatchError(f"endpoint schema does not confirm required endpoints on port {port}")
    if not data.get("all_payloads_executable"):
        raise DispatchError(f"endpoint schema is not executable on port {port}")
    return data


def tui_readiness(root: Path, worker_id: str) -> dict[str, Any]:
    argv = [
        str(adapter_path(root)),
        "tui-readiness",
        "--root",
        str(root),
        "--worker",
        worker_id,
        "--json",
    ]
    result = run_command(argv, root, timeout=20)
    payload: dict[str, Any] = {}
    try:
        parsed = json.loads(result.get("stdout") or "{}")
        if isinstance(parsed, dict):
            payload = parsed
    except Exception:
        payload = {}
    payload.setdefault("readiness", "unknown")
    payload.setdefault("reason", "tui-readiness output could not be parsed" if not payload else "")
    try:
        runtime_health = build_runtime_health_summary(root, worker_id=worker_id, backend=RUNTIME_BACKEND)
    except Exception as exc:
        payload["runtime_health_error"] = str(exc)
    else:
        readiness = runtime_health.get("readiness", {}) if isinstance(runtime_health.get("readiness"), dict) else {}
        if readiness:
            payload["readiness"] = str(readiness.get("readiness") or payload.get("readiness") or "unknown")
            payload["reason"] = str(readiness.get("reason") or payload.get("reason") or "")
            payload["submit_safe"] = bool(readiness.get("submit_safe", False))
            payload["runtime_health_ok"] = bool(runtime_health.get("ok", False))
            payload["runtime_backend"] = str(runtime_health.get("runtime_backend") or RUNTIME_BACKEND)
    payload["command"] = {
        "argv": argv,
        "returncode": result.get("returncode"),
        "stderr": result.get("stderr", ""),
        "elapsed_seconds": result.get("elapsed_seconds"),
        "timed_out": result.get("timed_out", False),
    }
    return payload


def ensure_tui_ready_for_submit(root: Path, worker_id: str) -> dict[str, Any]:
    readiness = tui_readiness(root, worker_id)
    state = str(readiness.get("readiness", "unknown"))
    if state in {"busy", "unhealthy"}:
        raise DispatchError(f"TUI readiness is {state}: {readiness.get('reason', '')}")
    return readiness


def record_post_terminal_readiness(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    append_busy_event: bool = False,
) -> dict[str, Any]:
    if not worker_id:
        return {}
    tdir = task_dir(root, run, task)
    truth = task_truth(root, run, task)
    if truth.get("protocol_terminal_state") not in VALID_TERMINAL_STATES:
        return {}
    data = tui_readiness(root, worker_id)
    write_json(tdir / "post_terminal_tui_readiness.json", data)
    if append_busy_event and str(data.get("readiness")) == "busy":
        append_event(tdir / "events.jsonl", {
            "ts": utc_now(),
            "event": "post_terminal_tui_busy",
            "source": "omx_visible_dispatch",
            "worker": worker_id,
            "readiness": data.get("readiness"),
            "reason": data.get("reason", ""),
        })
    return data


def _int_value(value: Any) -> int:
    if isinstance(value, bool):
        return 0
    if isinstance(value, int):
        return value
    if isinstance(value, float):
        return int(value)
    if isinstance(value, str):
        try:
            return int(value.strip())
        except ValueError:
            return 0
    return 0


def _timestamp_iso(value: Any) -> str:
    try:
        parsed = float(value)
    except (TypeError, ValueError):
        return ""
    if parsed <= 0:
        return ""
    if parsed > 10_000_000_000:
        parsed = parsed / 1000
    try:
        return datetime.fromtimestamp(parsed, timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    except (OverflowError, OSError, ValueError):
        return ""


def _compacted_timestamps(value: Any) -> list[Any]:
    found: list[Any] = []
    if isinstance(value, dict):
        state = value.get("state")
        time_data = state.get("time") if isinstance(state, dict) else {}
        compacted = time_data.get("compacted") if isinstance(time_data, dict) else None
        if compacted not in (None, "", 0, False):
            found.append(compacted)
        for item in value.values():
            found.extend(_compacted_timestamps(item))
    elif isinstance(value, list):
        for item in value:
            found.extend(_compacted_timestamps(item))
    return found


def compacted_tool_part_stats(payload: Any) -> dict[str, Any]:
    timestamps = _compacted_timestamps(payload)
    numeric = [_int_value(item) for item in timestamps if _int_value(item) > 0]
    latest = max(numeric) if numeric else 0
    return {
        "tool_part_compacted_count": len(timestamps),
        "latest_compacted": latest,
        "latest_compacted_iso": _timestamp_iso(latest),
    }


def _session_id_from_readiness(readiness: dict[str, Any]) -> str:
    raw = str(readiness.get("session_status_raw_summary") or "")
    if not raw.strip():
        return ""
    try:
        data = json.loads(raw)
    except Exception:
        return ""
    if not isinstance(data, dict):
        return ""
    for key in data.keys():
        text = str(key)
        if text.startswith("ses_"):
            return text
    return ""


def fetch_opencode_session_message(
    base_url: str,
    session_id: str,
    *,
    limit: int = SESSION_MESSAGE_LIMIT,
) -> dict[str, Any]:
    parsed = urlparse(str(base_url or ""))
    if parsed.scheme != "http" or parsed.hostname not in {"127.0.0.1", "localhost"} or not parsed.port:
        return {"ok": False, "error": "base_url must be localhost http with an explicit port"}
    if not session_id.startswith("ses_"):
        return {"ok": False, "error": "session_id must start with ses_"}
    if limit <= 0:
        return {"ok": False, "error": "session message limit must be positive"}
    url = (
        f"http://{parsed.hostname}:{int(parsed.port)}/session/"
        f"{quote(session_id, safe='')}/message?limit={int(limit)}"
    )
    request = Request(url, method="GET", headers={"User-Agent": "omx-visible-dispatch/late-prune", "Accept-Encoding": "identity"})
    try:
        with urlopen(request, timeout=2.0) as response:
            raw = response.read(SESSION_MESSAGE_MAX_BYTES + 1)
            if len(raw) > SESSION_MESSAGE_MAX_BYTES:
                return {
                    "ok": False,
                    "error": "session_message_payload_too_large",
                    "payload_bytes_at_least": len(raw),
                    "payload_limit_bytes": SESSION_MESSAGE_MAX_BYTES,
                }
            data = json.loads(raw.decode("utf-8", errors="replace"))
            if not isinstance(data, list):
                return {
                    "ok": False,
                    "error": "invalid_session_message_shape",
                }
            return {
                "payload": data,
                "message_limit": int(limit),
                "response_bytes": len(raw),
            }
    except (HTTPError, URLError, TimeoutError, OSError, json.JSONDecodeError) as exc:
        return {"ok": False, "error": str(exc)}


def _message_payload_from_fetch_result(result: Any) -> Any:
    if isinstance(result, dict) and "payload" in result:
        return result.get("payload")
    return result


def _session_ids_from_readiness(readiness: dict[str, Any]) -> list[str]:
    raw = str(readiness.get("session_status_raw_summary") or "")
    if not raw.strip():
        return []
    try:
        data = json.loads(raw)
    except Exception:
        return []
    if not isinstance(data, dict):
        return []
    return [
        str(key)
        for key in data
        if str(key).startswith("ses_")
    ][:20]


def _task_bound_session_ids(
    tdir: Path,
    readiness: dict[str, Any],
    worker_id: str,
    worker: dict[str, Any],
    *,
    preferred_recovery_session_id: str = "",
) -> list[str]:
    session_ids = _session_ids_from_readiness(readiness)
    fence = read_json(tdir / "acceptance_fence.json")
    fence_session_id = str(fence.get("session_id") or "")
    if (
        fence_session_id.startswith("ses_")
        and str(fence.get("session_fence_state") or "") == "live_observed"
        and str(fence.get("worker_id") or "") == worker_id
    ):
        current_instance = derive_process_instance(worker)
        if (
            str(fence.get("instance_id") or "")
            == str(current_instance.get("instance_id") or "")
            and int(fence.get("binding_generation") or 0)
            == int(worker.get("binding_generation") or 0)
            and int(fence.get("fencing_generation") or 0)
            == int(
                worker.get("fencing_generation")
                or worker.get("binding_generation")
                or 0
            )
        ):
            if preferred_recovery_session_id.startswith("ses_"):
                return [preferred_recovery_session_id]
            return [fence_session_id]
    return session_ids[:20]


_CURRENT_RECOVERY_SESSION_STATUSES = {
    "live_session_observed",
    "known_idle_session_observed",
}


def _nonempty_identity_str(value: object) -> str | None:
    if type(value) is not str:
        return None
    text = value.strip()
    return text if text else None


def _current_fence_attempt_contract(
    tdir: Path,
    fence: dict[str, Any],
) -> tuple[str, str] | None:
    fence_attempt = _nonempty_identity_str(fence.get("attempt_id"))
    fence_contract = _nonempty_identity_str(fence.get("contract_hash"))
    if fence_attempt is None or fence_contract is None:
        return None
    task_record = read_json(tdir / "task.json")
    if not isinstance(task_record, dict) or not task_record:
        return None
    task_attempt = _nonempty_identity_str(task_record.get("attempt_id"))
    task_contract = _nonempty_identity_str(task_record.get("contract_hash"))
    if task_attempt is None or task_contract is None:
        return None
    if task_attempt != fence_attempt or task_contract != fence_contract:
        return None
    operation = task_record.get("operation_contract")
    if isinstance(operation, dict) and "attempt_id" in operation:
        op_attempt = _nonempty_identity_str(operation.get("attempt_id"))
        if op_attempt is None or op_attempt != fence_attempt:
            return None
    return fence_attempt, fence_contract


def _recovery_fence_identity_current(
    fence: dict[str, Any],
    *,
    tdir: Path,
    worker: dict[str, Any],
    worker_id: str,
) -> bool:
    fence_session_id = str(fence.get("session_id") or "")
    recovery_backend = str(worker.get("backend") or "opencode_tui")
    if recovery_backend == "codex_tui":
        if (not fence_session_id
                or fence_session_id != str(worker.get("codex_thread") or "")):
            return False
    elif not fence_session_id.startswith("ses_"):
        return False
    if str(fence.get("session_fence_state") or "") != "live_observed":
        return False
    if str(fence.get("run_id") or "") != tdir.parents[1].name:
        return False
    if str(fence.get("task_id") or "") != tdir.name:
        return False
    if str(fence.get("worker_id") or "") != worker_id:
        return False
    current_instance = derive_process_instance(worker)
    if str(fence.get("instance_id") or "") != str(
        current_instance.get("instance_id") or ""
    ):
        return False
    if _nonnegative_int_or_none(fence.get("binding_generation")) != (
        _nonnegative_int_or_none(worker.get("binding_generation"))
    ):
        return False
    if _nonnegative_int_or_none(fence.get("fencing_generation")) != (
        _nonnegative_int_or_none(
            worker.get("fencing_generation")
            if worker.get("fencing_generation") is not None
            else worker.get("binding_generation")
        )
    ):
        return False
    return True


def _observe_recovery_handshake_session(
    root: Path,
    worker_id: str,
    fence: dict[str, Any],
    *,
    backend: str,
) -> dict[str, Any]:
    module = load_adapter_module(root)
    try:
        observe = module.acceptance_session_observation
    except AttributeError as exc:
        raise DispatchError(
            "recovery-handshake requires adapter acceptance_session_observation"
        ) from exc
    return observe(
        root,
        worker_id,
        fence,
        runtime_backend=backend,
        allow_pending=False,
        allow_known_idle=True,
        fence_path=None,
        bind_pending_singleton=False,
    )


def _recovery_handshake_no_send_reason(status: str) -> str:
    mapping = {
        "known_idle_session_not_found": (
            "recovery-handshake exact fenced session vanished; "
            "preserve the owner lock and inspect the current fence"
        ),
        "live_session_mismatch": (
            "recovery-handshake fenced session drifted; "
            "preserve the owner lock and do not migrate the ordinary continuation"
        ),
        "known_idle_session_observation_failed": (
            "recovery-handshake exact-session inspection failed; "
            "preserve the owner lock and retry read-only inspection"
        ),
        "live_session_observation_failed": (
            "recovery-handshake live session inspection failed; "
            "preserve the owner lock and retry read-only inspection"
        ),
        "live_session_ambiguous": (
            "recovery-handshake session observation is ambiguous; "
            "preserve the owner lock and inspect the current fence"
        ),
        "invalid_expected_session_id": (
            "recovery-handshake fence session id is invalid; "
            "preserve the owner lock and inspect acceptance_fence.json"
        ),
        "live_session_not_observed": (
            "recovery-handshake empty status did not prove the fenced session; "
            "preserve the owner lock and inspect the current fence"
        ),
    }
    return mapping.get(
        status,
        "recovery-handshake current session evidence is insufficient; "
        "preserve the owner lock and inspect task-local fence records",
    )


def _task_local_handshake_guidance(
    root: Path,
    run: str,
    task: str,
    worker_id: str = "",
) -> dict[str, str] | None:
    tdir = task_dir(root, run, task)
    fence = read_json(tdir / "acceptance_fence.json")
    session_id = str(fence.get("session_id") or "")
    if (
        not session_id.startswith("ses_")
        or str(fence.get("session_fence_state") or "") != "live_observed"
    ):
        return {
            "recommended_action": "inspect_task_local_acceptance_fence",
            "reason": (
                "current fence session is missing or not live_observed; "
                "do not send recovery-handshake"
            ),
        }
    attempt_contract = _current_fence_attempt_contract(tdir, fence)
    if attempt_contract is None:
        return {
            "recommended_action": "inspect_task_local_attempt_and_contract",
            "reason": (
                "current fence attempt/contract does not match the task record; "
                "do not send recovery-handshake"
            ),
        }
    fence_attempt, _fence_contract = attempt_contract
    observation = read_json(tdir / "provider_error_observation.json")
    if not observation:
        return None
    if (
        type(observation.get("schema_version")) is not int
        or observation.get("schema_version") != 1
    ):
        return None
    source = observation.get("source")
    if type(source) is not str or source not in {
        "opencode_session_message_api",
        "opencode_background_output",
    }:
        return None
    obs_run = _nonempty_identity_str(observation.get("run"))
    obs_task = _nonempty_identity_str(observation.get("task"))
    obs_worker = _nonempty_identity_str(observation.get("worker_id"))
    obs_attempt = _nonempty_identity_str(observation.get("attempt_id"))
    fence_worker = _nonempty_identity_str(fence.get("worker_id"))
    expected_worker = _nonempty_identity_str(worker_id) or fence_worker
    if (
        obs_run != run
        or obs_task != task
        or obs_worker is None
        or expected_worker is None
        or obs_worker != expected_worker
        or obs_attempt is None
        or obs_attempt != fence_attempt
        or observation.get("resolved") is True
        or observation.get("detected") is True
    ):
        return None
    status = observation.get("status")
    if type(status) is not str or status not in {
        "session_not_observed",
        "task_session_not_found",
        "task_scope_not_observed",
        "session_message_payload_too_large",
    }:
        return None
    return {
        "recommended_action": "inspect_task_local_provider_evidence",
        "reason": (
            "current-attempt provider evidence is insufficient; "
            "do not send recovery-handshake"
        ),
    }


def _terminal_rejection_session_id(
    tdir: Path,
    fence: dict[str, Any],
    worker_id: str,
) -> dict[str, Any]:
    rejection = read_json(tdir / "terminal_output_rejection.json")
    expected = (
        rejection.get("expected")
        if isinstance(rejection.get("expected"), dict)
        else {}
    )
    claim = (
        rejection.get("claim")
        if isinstance(rejection.get("claim"), dict)
        else {}
    )
    observation = (
        rejection.get("live_session_observation")
        if isinstance(rejection.get("live_session_observation"), dict)
        else {}
    )
    claim_observation = (
        claim.get("live_session_observation")
        if isinstance(claim.get("live_session_observation"), dict)
        else {}
    )
    guard_before = (
        rejection.get("guard_before")
        if isinstance(rejection.get("guard_before"), dict)
        else {}
    )
    guard_after = (
        rejection.get("guard_after")
        if isinstance(rejection.get("guard_after"), dict)
        else {}
    )
    session_ids = observation.get("session_ids")
    created_at = str(rejection.get("created_at") or "")
    state = str(rejection.get("state") or "")
    before_worker_identity = _guard_worker_identity(
        guard_before.get("worker")
    )
    after_worker_identity = _guard_worker_identity(
        guard_after.get("worker")
    )
    before_lock_transition = owner_lock_transition_fence(
        guard_before.get("owner_lock")
        if isinstance(guard_before.get("owner_lock"), dict)
        else {}
    )
    after_lock_transition = owner_lock_transition_fence(
        guard_after.get("owner_lock")
        if isinstance(guard_after.get("owner_lock"), dict)
        else {}
    )
    guards_have_producer_identity = all(
        _guard_has_producer_identity(
            guard,
            tdir,
            worker_id,
            fence,
        )
        for guard in (guard_before, guard_after)
    )
    if (
        rejection.get("schema_version") != 1
        or rejection.get("rejection_kind")
        != "terminal_output_acceptance_fence"
        or rejection.get("mismatched_fields") != ["live_session_id"]
        or not created_at
        or state not in {"done", "fail", "blocked"}
        or str(rejection.get("worker") or "") != worker_id
        or expected != fence
        or str(fence.get("run_id") or "") != tdir.parents[1].name
        or str(fence.get("task_id") or "") != tdir.name
        or str(fence.get("worker_id") or "") != worker_id
        or str(claim.get("claim_kind") or "") != "visible_terminal_output"
        or claim.get("schema_version") != 1
        or claim.get("task_protocol_version") != TASK_PROTOCOL_VERSION
        or claim.get("terminal_protocol_version")
        != TERMINAL_PROTOCOL_VERSION
        or claim.get("terminal_acceptance_required") is not True
        or str(claim.get("state") or "") != state
        or str(claim.get("created_at") or "") != created_at
        or compare_acceptance_identity(fence, claim)
        or str(claim.get("acceptance_fence_hash") or "")
        != acceptance_fence_hash(fence)
        or observation != claim_observation
        or observation.get("source") != "opencode_session_status"
        or observation.get("status") != "live_session_mismatch"
        or observation.get("matches") is not False
        or str(observation.get("observed_at") or "") != created_at
        or str(observation.get("error") or "")
        or str(observation.get("worker_id") or "") != worker_id
        or str(observation.get("expected_session_id") or "")
        != str(fence.get("session_id") or "")
        or not isinstance(session_ids, list)
        or len(session_ids) != 1
        or not str(session_ids[0]).startswith("ses_")
        or str(session_ids[0]) == str(fence.get("session_id") or "")
        or not guard_before
        or not guard_after
        or guard_before.get("ok") is not True
        or guard_after.get("ok") is not True
        or guard_before.get("status") != "ok"
        or guard_after.get("status") != "ok"
        or guard_before.get("invalid_fields") != []
        or guard_after.get("invalid_fields") != []
        or guard_before.get("binding_matches") is not True
        or guard_after.get("binding_matches") is not True
        or guard_before.get("owner_lock_matches") is not True
        or guard_after.get("owner_lock_matches") is not True
        or not guards_have_producer_identity
        or guard_before.get("binding_generation")
        != fence.get("binding_generation")
        or guard_after.get("binding_generation")
        != fence.get("binding_generation")
        or guard_before.get("fencing_generation")
        != fence.get("fencing_generation")
        or guard_after.get("fencing_generation")
        != fence.get("fencing_generation")
        or list(before_worker_identity)
        != guard_before.get("worker_identity")
        or list(after_worker_identity)
        != guard_after.get("worker_identity")
        or before_worker_identity != after_worker_identity
        or not guard_before.get("owner_lock_id")
        or guard_before.get("owner_lock_id")
        != guard_after.get("owner_lock_id")
        or list(before_lock_transition)
        != guard_before.get("owner_lock_transition")
        or list(after_lock_transition)
        != guard_after.get("owner_lock_transition")
        or before_lock_transition != after_lock_transition
    ):
        return {}
    return {
        "session_id": str(session_ids[0]),
        "worker_identity": list(after_worker_identity),
        "owner_lock_transition": list(after_lock_transition),
    }


def _guard_worker_identity(worker: Any) -> tuple[Any, ...]:
    if not isinstance(worker, dict):
        return ()
    return (
        str(worker.get("worker_id") or ""),
        str(worker.get("instance_id") or ""),
        _nonnegative_int_or_none(worker.get("binding_generation")),
        _nonnegative_int_or_none(
            worker.get("fencing_generation")
            if worker.get("fencing_generation") is not None
            else worker.get("binding_generation")
        ),
        str(worker.get("host") or "127.0.0.1"),
        _nonnegative_int_or_none(worker.get("port")),
        str(worker.get("pane_id") or ""),
        _nonnegative_int_or_none(worker.get("pane_pid")),
    )


def _guard_has_producer_identity(
    guard: dict[str, Any],
    tdir: Path,
    worker_id: str,
    fence: dict[str, Any],
) -> bool:
    worker = guard.get("worker")
    lock = guard.get("owner_lock")
    if not isinstance(worker, dict) or not isinstance(lock, dict):
        return False
    binding_generation = _nonnegative_int_or_none(
        worker.get("binding_generation")
    )
    fencing_generation = _nonnegative_int_or_none(
        worker.get("fencing_generation")
        if worker.get("fencing_generation") is not None
        else worker.get("binding_generation")
    )
    port = _nonnegative_int_or_none(worker.get("port"))
    return bool(
        str(worker.get("worker_id") or "") == worker_id
        and str(worker.get("instance_id") or "")
        == str(fence.get("instance_id") or "")
        and str(worker.get("pane_id") or "")
        and binding_generation is not None
        and binding_generation
        == _nonnegative_int_or_none(fence.get("binding_generation"))
        and binding_generation
        == _nonnegative_int_or_none(guard.get("binding_generation"))
        and fencing_generation is not None
        and fencing_generation
        == _nonnegative_int_or_none(fence.get("fencing_generation"))
        and fencing_generation
        == _nonnegative_int_or_none(guard.get("fencing_generation"))
        and port is not None
        and port > 0
        and str(lock.get("owner_lock_id") or "")
        == str(guard.get("owner_lock_id") or "")
        and str(lock.get("worker_id") or "") == worker_id
        and str(lock.get("run") or "") == tdir.parents[1].name
        and str(lock.get("task") or "") == tdir.name
        and str(lock.get("task_dir") or "")
        == (
            ".omx/framework/team/visible-runs/"
            f"{tdir.parents[1].name}/tasks/{tdir.name}"
        )
        and str(lock.get("status") or "")
        in {"submitting", "submitted"}
        and _nonnegative_int_or_none(lock.get("binding_generation"))
        == binding_generation
        and str(lock.get("pane_id") or "")
        == str(worker.get("pane_id") or "")
        and _nonnegative_int_or_none(lock.get("port")) == port
    )


def _nonnegative_int_or_none(value: Any) -> int | None:
    try:
        parsed = int(value)
    except (TypeError, ValueError):
        return None
    return parsed if parsed >= 0 else None


def _reviewed_session_drift_candidate(
    root: Path,
    tdir: Path,
    worker_id: str,
    backend: str,
) -> tuple[dict[str, Any], dict[str, Any], dict[str, bool]]:
    """Evaluate the reviewed session-drift replacement predicates, returning
    (proof, readiness, terms). Terms are filled in as each predicate is
    actually evaluated, so a refusal lists only predicates that genuinely
    evaluated false; unevaluated predicates are never reported as failures.
    Unknown or twice-rotated live sessions stay failures, never matches."""
    terms: dict[str, bool] = {}
    if not _reviewed_session_drift_eligible(tdir):
        terms["finish_refused_shape_eligible"] = False
        return {}, {}, terms
    terms["finish_refused_shape_eligible"] = True
    proof = _terminal_rejection_session_id(
        tdir,
        read_json(tdir / "acceptance_fence.json"),
        worker_id,
    )
    session_id = str(proof.get("session_id") or "")
    terms["rejection_proof_session_id_present"] = bool(session_id)
    if not session_id:
        return {}, {}, terms
    verify_worker(root, worker_id, backend=backend)
    current_worker = worker_record(root, worker_id)
    current_lock = read_json(lock_path(root, worker_id))
    identity_matches = _reviewed_worker_identity_matches(
        proof.get("worker_identity"),
        current_worker,
    )
    transition_matches = (
        list(owner_lock_transition_fence(current_lock))
        == proof.get("owner_lock_transition")
    )
    terms["worker_identity_matches"] = identity_matches
    terms["owner_lock_transition_matches"] = transition_matches
    if not (identity_matches and transition_matches):
        return {}, {}, terms
    readiness = tui_readiness(root, worker_id)
    live_matches = _session_ids_from_readiness(readiness) == [session_id]
    terms["live_session_matches_rejection"] = live_matches
    if not live_matches:
        return {}, readiness, terms
    return proof, readiness, terms


def _failed_drift_terms(terms: dict[str, bool]) -> list[str]:
    return sorted(name for name, ok in terms.items() if ok is False)


def _drift_terms_suffix(
    terms: dict[str, bool],
    root: Path,
    tdir: Path,
) -> str:
    failed = _failed_drift_terms(terms)
    if not failed:
        return ""
    return (
        "; session-drift conditions failed: "
        + ", ".join(failed)
        + f"; evidence: {rel(tdir / 'acceptance_fence.json', root)}"
    )


def _reviewed_session_drift_eligible(tdir: Path) -> bool:
    report_path = tdir / "report.md"
    protocol_status = read_json(tdir / "protocol_status.json")
    terminal_acceptance = protocol_status.get("terminal_acceptance")
    return bool(
        report_path.is_file()
        and report_path.stat().st_size > 0
        and not any(
            (tdir / marker).is_file()
            for marker in (".done", ".fail", ".blocked")
        )
        and not (tdir / "recovery_handshake.json").exists()
        and str(protocol_status.get("status") or "")
        == "finish_refused_acceptance_fence"
        and protocol_status.get("finish_refused_missing_report") is False
        and isinstance(terminal_acceptance, dict)
        and terminal_acceptance.get("accepted") is False
        and protocol_status.get("terminal_markers") == []
    )


def _reviewed_worker_identity_matches(
    historical: Any,
    current_worker: dict[str, Any],
) -> bool:
    if not isinstance(historical, list) or len(historical) != 8:
        return False
    current = list(_guard_worker_identity(current_worker))
    return bool(
        historical[:7] == current[:7]
        and (historical[7] is None or historical[7] == current[7])
    )


def capture_worker_pane_text(root: Path, worker: dict[str, Any]) -> str:
    pane_id = str(worker.get("pane_id") or "")
    if not pane_id:
        return ""
    result = run_command(
        ["tmux", "capture-pane", "-p", "-t", pane_id, "-S", "-200"],
        root,
        timeout=5,
    )
    if result.get("returncode") != 0 or result.get("timed_out"):
        return ""
    return str(result.get("stdout") or "")


def _owner_lock_matches_task_and_worker(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    worker: dict[str, Any],
) -> bool:
    lock = read_json(lock_path(root, worker_id))
    if (
        str(lock.get("worker_id") or "") != worker_id
        or str(lock.get("run") or "") != run
        or str(lock.get("task") or "") != task
    ):
        return False
    for key in ("pane_id", "port", "binding_generation"):
        expected = str(worker.get(key) or "")
        observed = str(lock.get(key) or "")
        if expected and observed != expected:
            return False
    return True


def _provider_error_from_pane_text(text: str) -> dict[str, Any]:
    excerpt = _provider_error_excerpt(text)
    kind, retryable = _provider_error_kind(excerpt)
    if not kind:
        return {"task_bound": True, "detected": False}
    result = {
        "task_bound": True,
        "detected": True,
        "kind": kind,
        "retryable": retryable,
        "message_id": "",
        "message_created_ms": 0,
        "error_name": (
            "TransferEncodingError"
            if "transferencodingerror" in excerpt.lower()
            else "UpstreamServerError"
        ),
        "error_message": excerpt,
        "request_id": _provider_request_id(excerpt),
    }
    if kind == "upstream_request_timeout":
        attach_token_count = str(text or "").upper().count(
            "ATTACH"
        )
        result.update(
            {
                "error_name": "UnknownError",
                "retry_scope": "fresh_session_only",
                "response_text_chars": len(str(text or "")),
                "attach_token_count": attach_token_count,
                "output_degeneration_detected": bool(
                    attach_token_count
                    >= ATTACH_DEGENERATION_THRESHOLD
                ),
            }
        )
    return result


def _message_text(message: dict[str, Any]) -> str:
    parts = message.get("parts", [])
    if not isinstance(parts, list):
        return ""
    return "\n".join(
        str(part.get("text") or "")
        for part in parts
        if isinstance(part, dict) and part.get("type") == "text"
    )


def _message_created_ms(message: dict[str, Any]) -> int:
    info = message.get("info", {}) if isinstance(message.get("info"), dict) else {}
    time_data = info.get("time", {}) if isinstance(info.get("time"), dict) else {}
    return _int_value(time_data.get("created"))


def _message_completed_ms(message: dict[str, Any]) -> int:
    info = message.get("info", {}) if isinstance(message.get("info"), dict) else {}
    time_data = info.get("time", {}) if isinstance(info.get("time"), dict) else {}
    return _int_value(time_data.get("completed"))


def _message_token_counts(message: dict[str, Any]) -> tuple[int, int]:
    info = message.get("info", {}) if isinstance(message.get("info"), dict) else {}
    tokens = info.get("tokens", {}) if isinstance(info.get("tokens"), dict) else {}
    output = _int_value(tokens.get("output"))
    if "total" in tokens:
        return _int_value(tokens.get("total")), output
    cache = tokens.get("cache", {}) if isinstance(tokens.get("cache"), dict) else {}
    total = sum(
        (
            _int_value(tokens.get("input")),
            output,
            _int_value(tokens.get("reasoning")),
            _int_value(cache.get("read")),
            _int_value(cache.get("write")),
        )
    )
    return total, output


def _explicit_message_error(message: dict[str, Any]) -> tuple[str, str]:
    info = message.get("info", {}) if isinstance(message.get("info"), dict) else {}
    error = info.get("error")
    if isinstance(error, str):
        return "", error.strip()
    if not isinstance(error, dict):
        return "", ""
    data = error.get("data") if isinstance(error.get("data"), dict) else {}
    error_name = str(error.get("name") or "").strip()
    error_message = str(
        data.get("message")
        or error.get("message")
        or ""
    ).strip()
    return error_name, error_message


def _provider_error_kind(error_message: str) -> tuple[str, bool]:
    lowered = str(error_message or "").lower()
    if "upstream_request_timeout" in lowered:
        return "upstream_request_timeout", False
    if (
        "transferencodingerror" in lowered
        or "response payload is not completed" in lowered
        or "not enough data to satisfy transfer length header" in lowered
    ):
        return "upstream_transport_error", True
    if "currently overloaded" in lowered or "servers are currently overloaded" in lowered:
        return "provider_overloaded", True
    if "proxy request budget exhausted" in lowered:
        return "proxy_request_budget_exhausted", True
    if (
        "personal-team-blocked" in lowered
        or "spending-limit" in lowered
        or "have run out of credits" in lowered
    ):
        return "provider_spending_limit", True
    if (
        "your input exceeds the context window" in lowered
        or "context window of this model" in lowered
        or "context_length_exceeded" in lowered
    ):
        return "context_window_overflow", False
    if (
        "an error occurred while processing your request" in lowered
        or "upstream server error" in lowered
        or "internal server error" in lowered
    ):
        return "upstream_server_error", True
    return "", False


def _provider_error_evidence_rank(
    evidence: dict[str, Any],
) -> tuple[int, int, int, int, int, int, int]:
    detected = bool(evidence.get("detected"))
    if not detected:
        return (0, 0, 0, 0, 0, 0, 0)
    completed_ms = _int_value(
        evidence.get("message_completed_ms")
    )
    timeout = bool(
        evidence.get("kind") == "upstream_request_timeout"
    )
    return (
        1,
        int(not bool(evidence.get("retryable"))),
        int(
            visible_task_state.provider_error_quarantine_eligible(
                evidence
            )
        ),
        int(
            evidence.get("source")
            == "opencode_session_message_api"
        ),
        int(timeout and completed_ms > 0),
        completed_ms,
        int(timeout),
    )


def provider_inspection_pending_path(
    root: Path,
    worker_id: str,
) -> Path:
    safe_id(worker_id, "worker")
    return (
        framework_root(root)
        / "provider-inspection-pending"
        / f"{worker_id}.json"
    )


def process_start_time_ticks(pid: int) -> int:
    try:
        text = Path(f"/proc/{int(pid)}/stat").read_text(
            encoding="utf-8",
            errors="replace",
        )
    except (OSError, TypeError, ValueError):
        return 0
    close = text.rfind(")")
    if close < 0:
        return 0
    fields = text[close + 1 :].strip().split()
    try:
        return int(fields[19])
    except (IndexError, TypeError, ValueError):
        return 0


def _provider_inspection_entries(
    pending: dict[str, Any],
) -> dict[str, dict[str, Any]]:
    raw = pending.get("inspections")
    entries = (
        {
            str(key): dict(value)
            for key, value in raw.items()
            if isinstance(value, dict)
        }
        if isinstance(raw, dict)
        else {}
    )
    legacy_id = str(pending.get("inspection_id") or "")
    if pending.get("status") == "pending" and legacy_id and not entries:
        entries[legacy_id] = {
            key: pending.get(key)
            for key in (
                "inspection_id",
                "worker_id",
                "run",
                "task",
                "pid",
                "pid_start_time_ticks",
                "host_boot_id",
                "started_at",
            )
        }
    return entries


def _provider_inspection_is_live(
    entry: dict[str, Any],
    current_boot: str,
) -> bool:
    entry_boot = str(entry.get("host_boot_id") or "")
    pid = _int_value(entry.get("pid"))
    start_ticks = _int_value(
        entry.get("pid_start_time_ticks")
    )
    return bool(
        entry_boot
        and current_boot
        and entry_boot == current_boot
        and pid > 0
        and start_ticks > 0
        and process_start_time_ticks(pid) == start_ticks
    )


def prune_stale_provider_inspections_locked(
    root: Path,
    worker_id: str,
) -> dict[str, dict[str, Any]]:
    path = provider_inspection_pending_path(root, worker_id)
    pending = read_json(path)
    entries = _provider_inspection_entries(pending)
    current_boot = current_host_boot_id()
    live_entries = {
        inspection_id: entry
        for inspection_id, entry in entries.items()
        if _provider_inspection_is_live(entry, current_boot)
    }
    if live_entries:
        if live_entries != entries or pending.get("inspection_id"):
            write_json_atomic(
                path,
                {
                    "schema_version": 1,
                    "status": "pending",
                    "worker_id": worker_id,
                    "updated_at": utc_now(),
                    "inspections": live_entries,
                    "path": str(path),
                },
            )
    elif path.exists():
        path.unlink(missing_ok=True)
    return live_entries


def begin_provider_inspection(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
) -> dict[str, Any]:
    path = provider_inspection_pending_path(root, worker_id)
    inspection_id = f"inspection-{uuid.uuid4().hex}"
    inspection = {
        "inspection_id": inspection_id,
        "worker_id": worker_id,
        "run": run,
        "task": task,
        "pid": os.getpid(),
        "pid_start_time_ticks": process_start_time_ticks(
            os.getpid()
        ),
        "host_boot_id": current_host_boot_id(),
        "started_at": utc_now(),
        "path": str(path),
    }
    with visible_registry_lock(root):
        entries = prune_stale_provider_inspections_locked(
            root,
            worker_id,
        )
        active_owner = read_json(lock_path(root, worker_id))
        if (
            active_owner
            and str(active_owner.get("status") or "")
            != "released"
            and (
                str(active_owner.get("run") or "") != run
                or str(active_owner.get("task") or "") != task
            )
        ):
            raise DispatchError(
                "provider inspection active owner belongs to another task: "
                f"{active_owner.get('run') or '-'}"
                f"/{active_owner.get('task') or '-'}"
            )
        entries[inspection_id] = inspection
        write_json_atomic(
            path,
            {
                "schema_version": 1,
                "status": "pending",
                "worker_id": worker_id,
                "updated_at": utc_now(),
                "inspections": entries,
                "path": str(path),
            },
        )
    return inspection


def require_no_provider_inspection_pending_for_submit_locked(
    root: Path,
    worker_id: str,
) -> None:
    pending_entries = prune_stale_provider_inspections_locked(
        root,
        worker_id,
    )
    if pending_entries:
        raise DispatchError(
            f"provider inspection pending for {worker_id}; "
            "retry after the task-bound observation is committed"
        )


def finish_provider_inspection_locked(
    root: Path,
    worker_id: str,
    inspection: dict[str, Any],
) -> None:
    path = provider_inspection_pending_path(root, worker_id)
    current = read_json(path)
    entries = _provider_inspection_entries(current)
    inspection_id = str(
        inspection.get("inspection_id") or ""
    )
    if current.get("status") != "pending" or inspection_id not in entries:
        raise DispatchError(
            f"provider inspection ownership changed for {worker_id}"
        )
    entries.pop(inspection_id, None)
    if entries:
        write_json_atomic(
            path,
            {
                **current,
                "updated_at": utc_now(),
                "inspections": entries,
            },
        )
    else:
        path.unlink(missing_ok=True)


def _provider_request_id(error_message: str) -> str:
    match = re.search(
        r"\brequest\s+id\s+([0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})\b",
        str(error_message or ""),
        flags=re.IGNORECASE,
    )
    return match.group(1) if match else ""


def _provider_error_excerpt(text: str) -> str:
    compact = " ".join(str(text or "").split())
    lowered = compact.lower()
    positions = [
        lowered.rfind(marker)
        for marker in (
            "proxy request budget exhausted",
            "upstream_request_timeout",
            "response payload is not completed",
            "an error occurred while processing your request",
            "our servers are currently overloaded",
            "servers are currently overloaded",
            "upstream server error",
            "internal server error",
            "personal-team-blocked",
            "spending-limit",
            "have run out of credits",
        )
    ]
    start = max(positions)
    if start < 0:
        start = max(0, len(compact) - 500)
    return compact[start : start + 500]


def _task_message_header(text: str) -> dict[str, str]:
    expected_keys = ("OMX_RUN_ID", "OMX_TASK_ID", "OMX_WORKER_ID")
    lines = str(text or "").splitlines()
    if lines[:1] == ["OMX visible task"]:
        lines = lines[1:]
    if len(lines) < len(expected_keys):
        return {}
    header: dict[str, str] = {}
    for line, expected_key in zip(lines, expected_keys):
        prefix = f"{expected_key}="
        if not line.startswith(prefix):
            return {}
        value = line[len(prefix):]
        if not value or value != value.strip():
            return {}
        if expected_key == "OMX_RUN_ID" and value.startswith("visible-runs/"):
            value = value.removeprefix("visible-runs/")
            if not value or "/" in value:
                return {}
        header[expected_key] = value
    if len(lines) > len(expected_keys) and lines[len(expected_keys)].startswith(
        "OMX_ATTEMPT_ID="
    ):
        attempt_id = lines[len(expected_keys)].removeprefix(
            "OMX_ATTEMPT_ID="
        )
        if not attempt_id or attempt_id != attempt_id.strip():
            return {}
        header["OMX_ATTEMPT_ID"] = attempt_id
    run_id = header["OMX_RUN_ID"]
    if run_id.startswith("visible-runs/"):
        run_id = run_id.removeprefix("visible-runs/")
    try:
        header["OMX_RUN_ID"] = safe_id(run_id, "OMX_RUN_ID")
    except DispatchError:
        return {}
    return header


def _task_message_segment(
    messages: list[dict[str, Any]],
    expected_header: dict[str, str],
) -> tuple[int, int]:
    task_start_index = -1
    for index, message in enumerate(messages):
        info = (
            message.get("info", {})
            if isinstance(message.get("info"), dict)
            else {}
        )
        if str(info.get("role") or "") != "user":
            continue
        header = _task_message_header(_message_text(message))
        if header and all(
            header.get(key) == value
            for key, value in expected_header.items()
        ):
            task_start_index = index
    if task_start_index < 0:
        return -1, -1

    task_end_index = len(messages)
    for index in range(task_start_index + 1, len(messages)):
        message = messages[index]
        info = (
            message.get("info", {})
            if isinstance(message.get("info"), dict)
            else {}
        )
        if (
            str(info.get("role") or "") == "user"
            and _task_message_header(_message_text(message))
        ):
            task_end_index = index
            break
    return task_start_index, task_end_index


def _provider_error_from_session_messages(
    payload: Any,
    *,
    run: str,
    task: str,
    worker_id: str,
    attempt_id: str = "",
) -> dict[str, Any]:
    messages = [
        item
        for item in (payload if isinstance(payload, list) else [])
        if isinstance(item, dict)
    ]
    expected_header = {
        "OMX_RUN_ID": run,
        "OMX_TASK_ID": task,
        "OMX_WORKER_ID": worker_id,
    }
    if attempt_id:
        expected_header["OMX_ATTEMPT_ID"] = attempt_id
    task_start_index, task_end_index = _task_message_segment(
        messages,
        expected_header,
    )
    if task_start_index < 0:
        if not attempt_id:
            return {"task_bound": False, "detected": False}
        return {
            "task_bound": False,
            "detected": False,
            "attempt_id": attempt_id,
            "evidence_scope": "insufficient",
            "classification": "insufficient",
            "confirmed": False,
            "resolved": False,
        }

    task_messages = messages[task_start_index + 1:task_end_index]
    final_assistant_index = max(
        (
            index
            for index, message in enumerate(task_messages)
            if str(
                (
                    message.get("info", {})
                    if isinstance(message.get("info"), dict)
                    else {}
                ).get("role")
                or ""
            )
            == "assistant"
        ),
        default=-1,
    )
    detected: dict[str, Any] = {}
    detected_index = -1
    for message_index, message in enumerate(task_messages):
        info = message.get("info", {}) if isinstance(message.get("info"), dict) else {}
        error_name, error_message = _explicit_message_error(message)
        message_text = _message_text(message).strip()
        structured_error_message = bool(error_message)
        if not error_message:
            error_message = message_text
        kind, retryable = _provider_error_kind(error_message)
        if (
            kind == "provider_spending_limit"
            and not structured_error_message
        ):
            # #789: quota markers in ordinary assistant/user/tool prose are
            # not provider-error evidence; the replenishable quota kind
            # requires the message's explicit structured error context.
            continue
        completed_ms = _message_completed_ms(message)
        message_finish = str(info.get("finish") or "")
        if (
            not kind
            and message_index == final_assistant_index
            and str(info.get("role") or "") == "assistant"
            and message_finish == "error"
            and completed_ms > 0
        ):
            kind, retryable = "provider_finish_error", False
            error_message = (
                "assistant message completed with finish=error"
            )
        if not kind:
            continue
        if (
            kind == "proxy_request_budget_exhausted"
            and completed_ms > 0
        ):
            kind, retryable = "upstream_request_timeout", False
        error = (
            info.get("error")
            if isinstance(info.get("error"), dict)
            else {}
        )
        error_data = (
            error.get("data")
            if isinstance(error.get("data"), dict)
            else {}
        )
        fatal = bool(
            error.get("fatal") is True
            or error_data.get("fatal") is True
        )
        retry_exhausted = bool(
            error.get("retry_exhausted") is True
            or error.get("retryExhausted") is True
            or error_data.get("retry_exhausted") is True
            or error_data.get("retryExhausted") is True
        )
        quota_replenishable = kind == "provider_spending_limit"
        if quota_replenishable:
            # #789: exhausting one provider request for quota does not prove
            # the owning session is contaminated; the blockage stays
            # replenishable and never becomes confirmed/non-retryable from
            # these generic flags. The flags are preserved as failure detail.
            confirmed = False
        else:
            confirmed = bool(fatal or retry_exhausted)
            if confirmed:
                retryable = False
        token_total, token_output = _message_token_counts(message)
        candidate = {
            "task_bound": True,
            "detected": True,
            "attempt_id": attempt_id,
            "evidence_scope": "scoped",
            "classification": (
                "blocked_provider_error"
                if confirmed and not retryable
                else "provider_error_observed"
            ),
            "confirmed": confirmed,
            "resolved": False,
            "kind": kind,
            "retryable": retryable,
            "message_id": str(info.get("id") or ""),
            "message_created_ms": _message_created_ms(message),
            "message_completed_ms": completed_ms,
            "message_finish": message_finish,
            "message_reason": str(info.get("reason") or ""),
            "message_token_total": token_total,
            "message_token_output": token_output,
            "structured_error_present": isinstance(
                info.get("error"),
                dict,
            ),
            "error_name": error_name,
            "error_message": " ".join(error_message.split())[:500],
            "request_id": (
                _provider_request_id(error_message)
                or _provider_request_id(message_text)
            ),
        }
        if quota_replenishable and (fatal or retry_exhausted):
            candidate.update(
                {
                    "provider_quota_request_exhausted": True,
                    "error_fatal": fatal,
                    "error_retry_exhausted": retry_exhausted,
                }
            )
        if kind in {
            "upstream_request_timeout",
            "provider_finish_error",
        }:
            attach_token_count = message_text.upper().count("ATTACH")
            candidate.update(
                {
                    "retry_scope": "fresh_session_only",
                    "response_text_chars": len(message_text),
                    "attach_token_count": attach_token_count,
                    "output_degeneration_detected": bool(
                        attach_token_count
                        >= ATTACH_DEGENERATION_THRESHOLD
                    ),
                }
            )
        if _provider_error_evidence_rank(
            detected
        ) > _provider_error_evidence_rank(candidate):
            continue
        detected = candidate
        detected_index = message_index
    if detected:
        final_assistant = (
            task_messages[final_assistant_index]
            if final_assistant_index >= 0
            else {}
        )
        final_info = (
            final_assistant.get("info", {})
            if isinstance(final_assistant.get("info"), dict)
            else {}
        )
        final_error_name, final_error_message = _explicit_message_error(
            final_assistant
        )
        final_finish = str(final_info.get("finish") or "")
        if (
            final_assistant_index > detected_index
            and not final_error_name
            and not final_error_message
            and final_finish in {"stop", "end_turn"}
            and _message_completed_ms(final_assistant) > 0
        ):
            return {
                "task_bound": True,
                "detected": False,
                "attempt_id": attempt_id,
                "evidence_scope": "scoped",
                "classification": "resolved",
                "confirmed": False,
                "resolved": True,
            }
        return detected
    if not attempt_id:
        return {"task_bound": True, "detected": False}
    return {
        "task_bound": True,
        "detected": False,
        "attempt_id": attempt_id,
        "evidence_scope": "scoped",
        "classification": "no_provider_error",
        "confirmed": False,
        "resolved": False,
    }


def _terminal_sentinel_line(
    text: str,
    task: str,
    attempt_id: str = "",
) -> tuple[str, str]:
    for raw_line in str(text or "").splitlines():
        line = raw_line.strip()
        if not line.startswith("OMX_TASK_CLOSED "):
            continue
        parts = line.split()
        if attempt_id:
            if (
                len(parts) != 4
                or parts[1] != task
                or parts[2] != attempt_id
                or parts[3].removeprefix(".") not in TERMINAL_MARKERS
            ):
                continue
            return line, parts[3].removeprefix(".")
        if (
            len(parts) != 3
            or parts[1] != task
            or parts[2] not in TERMINAL_MARKERS
        ):
            continue
        return line, parts[2]
    return "", ""


def _terminal_sentinel_from_session_messages(
    payload: Any,
    *,
    run: str,
    task: str,
    worker_id: str,
    attempt_id: str = "",
) -> dict[str, Any]:
    messages = [
        item
        for item in (payload if isinstance(payload, list) else [])
        if isinstance(item, dict)
    ]
    expected_header = {
        "OMX_RUN_ID": run,
        "OMX_TASK_ID": task,
        "OMX_WORKER_ID": worker_id,
    }
    if attempt_id:
        for message in messages:
            info = (
                message.get("info", {})
                if isinstance(message.get("info"), dict)
                else {}
            )
            if str(info.get("role") or "") != "assistant":
                continue
            line, state = _terminal_sentinel_line(
                _message_text(message),
                task,
                attempt_id,
            )
            if line:
                return {
                    "task_bound": True,
                    "detected": True,
                    "attempt_id": attempt_id,
                    "evidence_scope": "scoped",
                    "kind": visible_task_state.VERBAL_TERMINAL_STATUS,
                    "sentinel_line": line,
                    "sentinel_state": state,
                    "message_id": str(info.get("id") or ""),
                    "message_created_ms": _message_created_ms(message),
                }
        expected_header["OMX_ATTEMPT_ID"] = attempt_id
    task_start_index, task_end_index = _task_message_segment(
        messages,
        expected_header,
    )
    if task_start_index < 0:
        return {
            "task_bound": False,
            "detected": False,
            "attempt_id": attempt_id,
            "evidence_scope": "insufficient",
        }

    detected: dict[str, Any] = {}
    for message in messages[task_start_index + 1:task_end_index]:
        info = message.get("info", {}) if isinstance(message.get("info"), dict) else {}
        if str(info.get("role") or "") != "assistant":
            continue
        line, state = _terminal_sentinel_line(
            _message_text(message),
            task,
            attempt_id,
        )
        if not line:
            continue
        detected = {
            "task_bound": True,
            "detected": True,
            "attempt_id": attempt_id,
            "evidence_scope": "scoped",
            "kind": visible_task_state.VERBAL_TERMINAL_STATUS,
            "sentinel_line": line,
            "sentinel_state": state,
            "message_id": str(info.get("id") or ""),
            "message_created_ms": _message_created_ms(message),
        }
    if detected:
        return detected
    return {
        "task_bound": True,
        "detected": False,
        "attempt_id": attempt_id,
        "evidence_scope": "scoped",
    }


def record_terminal_sentinel_observation(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    readiness: dict[str, Any],
    fetcher: Any | None = None,
) -> dict[str, Any]:
    tdir = task_dir(root, run, task)
    observation_path = tdir / visible_task_state.TERMINAL_SENTINEL_OBSERVATION_FILES[0]
    attempt_id = str(
        read_json(tdir / "acceptance_fence.json").get("attempt_id")
        or ""
    )
    try:
        worker = worker_record(root, worker_id)
    except DispatchError as exc:
        observation = {
            "schema_version": 1,
            "observed_at": utc_now(),
            "source": "opencode_session_message_api",
            "run_id": run,
            "task_id": task,
            "worker_id": worker_id,
            "attempt_id": attempt_id,
            "evidence_scope": "insufficient",
            "session_ids_checked": [],
            "session_id": "",
            "task_bound": False,
            "detected": False,
            "kind": "",
            "sentinel_line": "",
            "sentinel_state": "",
            "message_id": "",
            "message_created_ms": 0,
            "status": "worker_lookup_failed",
            "error": str(exc),
        }
        write_observation_if_changed(observation_path, observation)
        return observation
    session_ids = _task_bound_session_ids(
        tdir,
        readiness,
        worker_id,
        worker,
    )
    observation: dict[str, Any] = {
        "schema_version": 1,
        "observed_at": utc_now(),
        "source": "opencode_session_message_api",
        "run_id": run,
        "task_id": task,
        "worker_id": worker_id,
        "attempt_id": attempt_id,
        "evidence_scope": "insufficient",
        "session_ids_checked": session_ids,
        "session_id": "",
        "task_bound": False,
        "detected": False,
        "kind": "",
        "sentinel_line": "",
        "sentinel_state": "",
        "message_id": "",
        "message_created_ms": 0,
        "status": "session_not_observed" if not session_ids else "task_session_not_found",
    }
    if not session_ids:
        write_observation_if_changed(observation_path, observation)
        return observation
    base_url = str(worker.get("base_url") or "").strip()
    if not base_url and worker.get("port"):
        base_url = f"http://127.0.0.1:{int(worker['port'])}"
    fetch = fetcher or fetch_opencode_session_message
    for session_id in session_ids:
        try:
            fetched = fetch(base_url, session_id)
        except Exception as exc:
            observation.setdefault("fetch_errors", []).append(f"{session_id}:{exc}")
            if (
                not observation.get("task_bound")
                and observation["status"] == "task_scope_not_observed"
            ):
                observation["status"] = "task_session_not_found"
            continue
        if isinstance(fetched, dict) and fetched.get("ok") is False:
            error = str(fetched.get("error") or "fetch_failed")
            observation.setdefault("fetch_errors", []).append(
                f"{session_id}:{error}"
            )
            if not observation.get("task_bound"):
                observation["status"] = error
            continue
        classified = _terminal_sentinel_from_session_messages(
            _message_payload_from_fetch_result(fetched),
            run=run,
            task=task,
            worker_id=worker_id,
            attempt_id=attempt_id,
        )
        if not classified.get("task_bound"):
            if not observation.get("task_bound") and not observation.get("fetch_errors"):
                # A successful read does not prove this task's header was in
                # the inspected window, nor that missing history was truncated.
                observation["status"] = "task_scope_not_observed"
            continue
        observation.update(classified)
        observation["session_id"] = session_id
        observation["status"] = (
            "terminal_sentinel_detected"
            if classified.get("detected")
            else "task_session_no_terminal_sentinel"
        )
        if classified.get("detected"):
            break
    write_observation_if_changed(observation_path, observation)
    return observation


def _background_child_failure_from_output(
    result: dict[str, Any],
    *,
    attempt_id: str,
    session_id: str,
    child_task_id: str,
) -> dict[str, Any]:
    state = str(result.get("state") or "")
    raw_status = str(result.get("raw_status") or "").strip()
    completion_seen = result.get("completion_seen") is True
    output_present = result.get("output_present") is True
    output_chars = _int_value(result.get("output_chars") or 0)
    response = result.get("response")
    blocked = bool(result.get("blocked_reasons")) or bool(
        isinstance(response, dict) and response.get("ok") is False
    )
    if (
        not blocked
        and state == "retrieval_not_ready_or_unknown"
        and raw_status == "error"
        and completion_seen
        and not output_present
        and output_chars == 0
    ):
        return {
            "task_bound": True,
            "detected": True,
            "attempt_id": attempt_id,
            "evidence_scope": "scoped",
            "classification": "background_child_terminal_error",
            "confirmed": True,
            "resolved": False,
            "kind": "background_child_finish_error",
            "retryable": False,
            "session_ids_checked": [session_id],
            "session_id": session_id,
            "raw_status": raw_status,
            "completion_seen": completion_seen,
            "output_present": output_present,
            "output_chars": output_chars,
            "child_task_id": child_task_id,
            "status": "background_child_failure_detected",
        }
    return {}


def _background_child_failure_observation(
    root: Path,
    tdir: Path,
    *,
    run: str,
    task: str,
    worker_id: str,
    attempt_id: str,
    session_id: str,
    adapter: Any,
) -> dict[str, Any]:
    if not session_id.startswith("ses_"):
        return {}
    ledger_path = tdir / "subagent_ledger.jsonl"
    if not ledger_path.is_file():
        return {}
    expected_run = f"visible-runs/{run}"
    seen: set[tuple[str, str]] = set()
    for line in read_text(ledger_path).splitlines():
        if not line.strip():
            continue
        try:
            row = json.loads(line)
        except Exception:
            continue
        if not isinstance(row, dict):
            continue
        if (
            str(row.get("parent_worker_id") or "") != worker_id
            or str(row.get("parent_run_id") or "") != expected_run
            or str(row.get("parent_task_id") or "") != task
        ):
            continue
        child_task_id = str(
            row.get("trace_task_id") or row.get("subagent_id") or ""
        ).strip()
        if not child_task_id:
            continue
        pair = (session_id, child_task_id)
        if pair in seen:
            continue
        seen.add(pair)
        try:
            result = adapter.background_output_real_runtime(
                root,
                worker_id,
                session_id,
                child_task_id,
            )
        except Exception:
            continue
        if not isinstance(result, dict):
            continue
        classified = _background_child_failure_from_output(
            result,
            attempt_id=attempt_id,
            session_id=session_id,
            child_task_id=child_task_id,
        )
        if classified:
            return classified
    return {}


def record_provider_error_observation(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    readiness: dict[str, Any],
    fetcher: Any | None = None,
    pane_fetcher: Any | None = None,
    preferred_recovery_session_id: str = "",
) -> dict[str, Any]:
    tdir = task_dir(root, run, task)
    observation_path = tdir / "provider_error_observation.json"
    attempt_id = str(
        read_json(tdir / "acceptance_fence.json").get("attempt_id")
        or ""
    )
    inspection = begin_provider_inspection(
        root,
        run,
        task,
        worker_id,
    )

    def persist(candidate: dict[str, Any]) -> dict[str, Any]:
        # ponytail: reuse the short global control-plane lock; split per task
        # only if provider-observation contention becomes measurable.
        with visible_registry_lock(root):
            if (
                preferred_recovery_session_id
                and not _reviewed_session_drift_eligible(tdir)
            ):
                finish_provider_inspection_locked(
                    root,
                    worker_id,
                    inspection,
                )
                raise DispatchError(
                    "reviewed recovery eligibility changed before provider persistence"
                )
            existing = read_json(observation_path)
            existing_valid = bool(
                existing.get("schema_version") == 1
                and str(existing.get("run") or "") == run
                and str(existing.get("task") or "") == task
                and str(existing.get("worker_id") or "") == worker_id
                and str(existing.get("source") or "")
                in {
                    "opencode_session_message_api",
                    "tmux_pane_capture",
                    "opencode_background_output",
                }
            )
            same_attempt = bool(
                attempt_id
                and str(existing.get("attempt_id") or "")
                == str(candidate.get("attempt_id") or "")
                == attempt_id
            )
            if (
                same_attempt
                and existing.get("detected") is True
                and candidate.get("task_bound") is True
                and candidate.get("detected") is False
                and candidate.get("evidence_scope") == "scoped"
                and candidate.get("classification")
                == "no_provider_error"
            ):
                candidate = {
                    **candidate,
                    "classification": "resolved",
                    "resolved": True,
                    "status": "provider_error_resolved",
                }
            semantic_keys = (
                "attempt_id",
                "status",
                "classification",
                "evidence_scope",
                "kind",
                "retryable",
                "confirmed",
                "resolved",
            )
            same_semantics = bool(
                existing_valid
                and all(
                    existing.get(key) == candidate.get(key)
                    for key in semantic_keys
                )
            )
            if same_semantics:
                selected = (
                    existing
                    if candidate.get("detected")
                    else candidate
                )
                write_candidate = False
            elif (
                same_attempt
                and candidate.get("resolved") is True
            ):
                selected = candidate
                write_candidate = True
            elif (
                attempt_id
                and str(existing.get("attempt_id") or "")
                != attempt_id
            ):
                selected = candidate
                write_candidate = True
            elif (
                existing_valid
                and _provider_error_evidence_rank(existing)
                > _provider_error_evidence_rank(candidate)
            ):
                selected = existing
                write_candidate = False
            else:
                selected = candidate
                write_candidate = True
            visible_task_state.record_provider_error_rotation_requirement_locked(
                root,
                worker_id,
                run=run,
                task=task,
                provider_error=selected,
            )
            if write_candidate:
                write_observation_if_changed(
                    observation_path,
                    candidate,
                )
            finish_provider_inspection_locked(
                root,
                worker_id,
                inspection,
            )
            return selected

    try:
        worker = worker_record(root, worker_id)
    except DispatchError as exc:
        observation = {
            "schema_version": 1,
            "observed_at": utc_now(),
            "source": "opencode_session_message_api",
            "run": run,
            "task": task,
            "worker_id": worker_id,
            "attempt_id": attempt_id,
            "evidence_scope": "insufficient",
            "classification": "insufficient",
            "confirmed": False,
            "resolved": False,
            "session_ids_checked": [],
            "session_id": "",
            "task_bound": False,
            "detected": False,
            "kind": "",
            "retryable": False,
            "message_id": "",
            "message_created_ms": 0,
            "message_completed_ms": 0,
            "message_finish": "",
            "message_reason": "",
            "message_token_total": 0,
            "message_token_output": 0,
            "structured_error_present": False,
            "error_name": "",
            "error_message": "",
            "request_id": "",
            "status": "worker_lookup_failed",
            "error": str(exc),
        }
        return persist(observation)
    session_ids = _task_bound_session_ids(
        tdir,
        readiness,
        worker_id,
        worker,
        preferred_recovery_session_id=preferred_recovery_session_id,
    )
    observation: dict[str, Any] = {
        "schema_version": 1,
        "observed_at": utc_now(),
        "source": "opencode_session_message_api",
        "run": run,
        "task": task,
        "worker_id": worker_id,
        "attempt_id": attempt_id,
        "evidence_scope": "insufficient",
        "classification": "insufficient",
        "confirmed": False,
        "resolved": False,
        "session_ids_checked": session_ids,
        "session_id": "",
        "task_bound": False,
        "detected": False,
        "kind": "",
        "retryable": False,
        "message_id": "",
        "message_created_ms": 0,
        "message_completed_ms": 0,
        "message_finish": "",
        "message_reason": "",
        "message_token_total": 0,
        "message_token_output": 0,
        "structured_error_present": False,
        "error_name": "",
        "error_message": "",
        "request_id": "",
        "status": "session_not_observed" if not session_ids else "task_session_not_found",
    }
    base_url = str(worker.get("base_url") or "").strip()
    if not base_url and worker.get("port"):
        base_url = f"http://127.0.0.1:{int(worker['port'])}"
    fetch = fetcher or fetch_opencode_session_message
    for session_id in session_ids:
        try:
            fetched = fetch(base_url, session_id)
        except Exception as exc:
            observation.setdefault("fetch_errors", []).append(f"{session_id}:{exc}")
            if (
                not observation.get("task_bound")
                and observation["status"] == "task_scope_not_observed"
            ):
                observation["status"] = "task_session_not_found"
            continue
        if (
            isinstance(fetched, dict)
            and fetched.get("ok") is False
        ):
            error = str(fetched.get("error") or "fetch_failed")
            observation.setdefault("fetch_errors", []).append(
                f"{session_id}:{error}"
            )
            # #823: a payload cap stop keeps an explicit insufficient
            # status; task/lock projection surfaces it as non-authoritative
            # insufficiency instead of reading detected=false as "no error".
            if not observation.get("task_bound"):
                observation["status"] = error
            if error == "session_message_payload_too_large":
                observation["payload_limit_bytes"] = int(
                    fetched.get("payload_limit_bytes")
                    or SESSION_MESSAGE_MAX_BYTES
                )
            continue
        classified = _provider_error_from_session_messages(
            _message_payload_from_fetch_result(fetched),
            run=run,
            task=task,
            worker_id=worker_id,
            attempt_id=attempt_id,
        )
        if not classified.get("task_bound"):
            if not observation.get("task_bound") and not observation.get("fetch_errors"):
                # Keep successful but unbound windows distinct from fetch
                # failures; absence is not clean or task-attributed evidence.
                observation["status"] = "task_scope_not_observed"
            continue
        observation.update(classified)
        observation["session_id"] = session_id
        observation["status"] = (
            "provider_error_detected"
            if classified.get("detected")
            else "task_session_no_provider_error"
        )
        if classified.get("detected"):
            break
    if (
        not observation.get("detected")
        and not (
            attempt_id
            and observation.get("task_bound") is True
        )
        and _owner_lock_matches_task_and_worker(
            root,
            run,
            task,
            worker_id,
            worker,
        )
    ):
        capture = pane_fetcher or capture_worker_pane_text
        try:
            pane_text = str(capture(root, worker) or "")
        except Exception as exc:
            observation["pane_capture_error"] = str(exc)
        else:
            classified = _provider_error_from_pane_text(pane_text)
            if classified.get("detected"):
                observation.update(classified)
                observation["source"] = "tmux_pane_capture"
                observation["attempt_id"] = attempt_id
                observation["evidence_scope"] = "unscoped"
                observation["classification"] = "provider_error_observed"
                observation["confirmed"] = False
                observation["resolved"] = False
                observation["pane_id"] = str(worker.get("pane_id") or "")
                observation["status"] = "provider_error_detected"
    if not observation.get("detected"):
        parent_session_id = (
            preferred_recovery_session_id
            if preferred_recovery_session_id.startswith("ses_")
            else str(
                observation.get("session_id")
                or read_json(tdir / "acceptance_fence.json").get(
                    "session_id"
                )
                or ""
            )
        )
        if parent_session_id.startswith("ses_"):
            try:
                background_adapter = load_adapter_module(root)
            except Exception:
                background_adapter = None
            if (
                background_adapter is not None
                and callable(
                    getattr(
                        background_adapter,
                        "background_output_real_runtime",
                        None,
                    )
                )
            ):
                captured = _background_child_failure_observation(
                    root,
                    tdir,
                    run=run,
                    task=task,
                    worker_id=worker_id,
                    attempt_id=attempt_id,
                    session_id=parent_session_id,
                    adapter=background_adapter,
                )
                if captured:
                    observation.update(captured)
                    observation["source"] = "opencode_background_output"
    return persist(observation)


def record_session_observations(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    readiness: dict[str, Any],
    fetcher: Any | None = None,
) -> dict[str, dict[str, Any]]:
    fetch = fetcher or fetch_opencode_session_message
    fetched: dict[tuple[str, str], Any] = {}

    def fetch_once(base_url: str, session_id: str) -> Any:
        key = (base_url, session_id)
        if key not in fetched:
            fetched[key] = fetch(base_url, session_id)
        return fetched[key]

    terminal = record_terminal_sentinel_observation(
        root,
        run,
        task,
        worker_id,
        readiness=readiness,
        fetcher=fetch_once,
    )
    provider = record_provider_error_observation(
        root,
        run,
        task,
        worker_id,
        readiness=readiness,
        fetcher=fetch_once,
    )
    return {
        "terminal": terminal,
        "provider": provider,
    }


def record_late_context_compaction_observation(
    root: Path,
    run: str,
    task: str,
    *,
    worker: dict[str, Any] | None = None,
    post_terminal_readiness: dict[str, Any] | None = None,
    fetcher: Any | None = None,
    runs_root: Path | None = None,
) -> dict[str, Any]:
    base = runs_root or visible_runs_root(root)
    tdir = visible_task_state.task_dir(root, run, task, runs_root=base)
    observation_path = tdir / visible_task_state.CONTEXT_COMPACTION_OBSERVATION_FILES[0]
    previous = read_json(observation_path)
    if not previous:
        return {
            "schema_version": 1,
            "detected": False,
            "status": "missing_baseline_observation",
            "evidence_path": rel(observation_path, root),
            "session_id": "",
            "baseline_tool_part_compacted_count": 0,
            "tool_part_compacted_count": 0,
            "new_tool_part_compacted_count": 0,
        }
    previous_message_api = previous.get("message_api") if isinstance(previous.get("message_api"), dict) else {}
    previous_log = previous.get("log") if isinstance(previous.get("log"), dict) else {}
    previous_kind = str(previous.get("observed_kind") or "")
    previous_classification = str(previous.get("classification") or "")
    baseline_count = _int_value(previous_message_api.get("tool_part_compacted_count"))
    session_id = str(previous.get("session_id") or "")
    if not session_id:
        session_id = _session_id_from_readiness(post_terminal_readiness or {})

    result = {
        "schema_version": 1,
        "detected": False,
        "status": "skipped",
        "evidence_path": rel(observation_path, root),
        "session_id": session_id,
        "baseline_tool_part_compacted_count": baseline_count,
        "tool_part_compacted_count": baseline_count,
        "new_tool_part_compacted_count": 0,
    }
    if previous_kind == "automatic_prune" or "automatic_prune" in previous_classification:
        result.update({"detected": True, "status": "existing_positive_observation"})
        return result
    if not session_id:
        result["status"] = "missing_session_id"
        return result

    worker_data = worker or {}
    port = _int_value(worker_data.get("port"))
    base_url = str(worker_data.get("base_url") or (f"http://127.0.0.1:{port}" if port else ""))
    if not base_url:
        result["status"] = "missing_worker_port"
        return result

    fetch = fetcher or fetch_opencode_session_message
    fetched = fetch(base_url, session_id)
    stats = compacted_tool_part_stats(_message_payload_from_fetch_result(fetched))
    current_count = _int_value(stats.get("tool_part_compacted_count"))
    new_count = max(0, current_count - baseline_count)
    result.update({
        "status": "no_new_compaction",
        "tool_part_compacted_count": current_count,
        "new_tool_part_compacted_count": new_count,
        "latest_compacted": stats.get("latest_compacted", 0),
        "latest_compacted_iso": stats.get("latest_compacted_iso", ""),
    })
    if current_count <= baseline_count:
        return result

    sidecar = {
        "schema_version": 1,
        "observed_at": utc_now(),
        "observed_kind": "automatic_prune",
        "classification": "automatic_prune_after_worker_closeout_observed_without_session_compacted_event",
        "session_id": session_id,
        "log": {
            "pruned_count": _int_value(previous_log.get("pruned_count")),
        },
        "message_api": {
            "baseline_tool_part_compacted_count": baseline_count,
            "tool_part_compacted_count": current_count,
            "new_tool_part_compacted_count": new_count,
            "latest_compacted": stats.get("latest_compacted", 0),
            "latest_compacted_iso": stats.get("latest_compacted_iso", ""),
        },
        "session_compacted_event_observed": False,
        "summary_compaction_observed": False,
        "observer": {
            "source": "omx_visible_dispatch.finalize_summary",
            "worker": str(worker_data.get("worker_id") or ""),
            "port": port,
            "base_url": base_url,
            "previous_observed_kind": previous_kind,
            "previous_classification": previous_classification,
        },
    }
    write_json(observation_path, sidecar)
    result.update({"detected": True, "status": "late_automatic_prune_observed"})
    return result


def record_runtime_snapshot(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    runtime_backend: str,
) -> dict[str, Any]:
    observation = record_runtime_observation(root, run, task, worker_id, runtime_backend)
    return runtime_snapshot_from_observation(observation)


def _runtime_observation_field(*values: Any) -> Any:
    for value in values:
        if value is None:
            continue
        if isinstance(value, str) and not value:
            continue
        if isinstance(value, (dict, list, tuple, set)) and not value:
            continue
        return value
    return None


def summarize_runtime_observation(payload: dict[str, Any], runtime_backend: str, worker_id: str) -> dict[str, Any]:
    status_value = payload.get("status")
    status_payload = status_value if isinstance(status_value, dict) else {}
    substrate_status = payload.get("substrate_status") if isinstance(payload.get("substrate_status"), dict) else {}
    metadata = payload.get("metadata") if isinstance(payload.get("metadata"), dict) else {}
    binding = status_payload.get("binding") if isinstance(status_payload.get("binding"), dict) else {}
    pane_id = _runtime_observation_field(
        status_payload.get("pane_id"),
        substrate_status.get("pane_id"),
        binding.get("pane_id"),
        metadata.get("pane_id"),
        metadata.get("pane"),
        "",
    )
    summary = {
        "captured_at": utc_now(),
        "runtime_backend": runtime_backend,
        "worker_id": worker_id,
        "ok": bool(payload.get("ok")) if isinstance(payload, dict) else False,
        "backend_type": str(
            _runtime_observation_field(
                payload.get("backend_type"),
                status_payload.get("backend_type"),
                substrate_status.get("backend_type"),
                metadata.get("backend_type"),
                backend_type_for(runtime_backend),
            )
            or ""
        ),
        "status": str(
            _runtime_observation_field(
                status_payload.get("status"),
                substrate_status.get("status"),
                status_payload.get("readiness"),
                substrate_status.get("readiness"),
                status_value if isinstance(status_value, str) else "",
                "",
            )
            or ""
        ),
        "readiness": str(
            _runtime_observation_field(
                status_payload.get("readiness"),
                substrate_status.get("readiness"),
                status_payload.get("status"),
                substrate_status.get("status"),
                status_value if isinstance(status_value, str) else "",
                "",
            )
            or ""
        ),
        "session_id": str(
            _runtime_observation_field(
                status_payload.get("session_id"),
                substrate_status.get("session_id"),
                metadata.get("session_id"),
                "",
            )
            or ""
        ),
        "window_id": str(
            _runtime_observation_field(
                status_payload.get("window_id"),
                substrate_status.get("window_id"),
                metadata.get("window_id"),
                "",
            )
            or ""
        ),
        "pane_id": str(pane_id or ""),
        "process_id": _runtime_observation_field(
            status_payload.get("process_id"),
            substrate_status.get("process_id"),
            metadata.get("process_id"),
            None,
        ),
        "payload": payload,
    }
    if "parse_error" in payload:
        summary["parse_error"] = bool(payload.get("parse_error"))
    return summary


def runtime_snapshot_from_observation(observation: dict[str, Any]) -> dict[str, Any]:
    snapshot = {
        "captured_at": observation.get("captured_at", utc_now()),
        "runtime_backend": observation.get("runtime_backend", ""),
        "worker_id": observation.get("worker_id", ""),
        "command": observation.get("command", {}),
        "ok": bool(observation.get("ok")),
        "status": str(observation.get("status") or ""),
        "readiness": str(observation.get("readiness") or ""),
        "backend_type": str(observation.get("backend_type") or ""),
        "session_id": str(observation.get("session_id") or ""),
        "window_id": str(observation.get("window_id") or ""),
        "pane_id": str(observation.get("pane_id") or ""),
        "process_id": observation.get("process_id"),
        "payload": observation.get("payload", {}),
    }
    return snapshot


def record_runtime_observation(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    runtime_backend: str,
) -> dict[str, Any]:
    if not worker_id:
        return {}
    tdir = task_dir(root, run, task)
    argv = [
        str(root / "bin" / "omx_runtime_adapter"),
        "status",
        "--root",
        str(root),
        "--backend",
        runtime_backend,
        "--worker",
        worker_id,
        "--json",
    ]
    result = run_command(argv, root, timeout=45)
    payload: dict[str, Any] = {}
    try:
        parsed = json.loads(result.get("stdout") or "{}")
        if isinstance(parsed, dict):
            payload = parsed
    except Exception:
        payload = {}
    if not payload:
        payload = {
            "ok": False,
            "status": "adapter_output_invalid",
            "backend_type": backend_type_for(runtime_backend),
            "parse_error": True,
            "raw_stdout": result.get("stdout", ""),
            "raw_stderr": result.get("stderr", ""),
        }
    observation = summarize_runtime_observation(payload, runtime_backend, worker_id)
    observation["command"] = {
        "argv": argv,
        "returncode": result.get("returncode"),
        "stderr": result.get("stderr", ""),
        "timed_out": result.get("timed_out", False),
    }
    snapshot = runtime_snapshot_from_observation(observation)
    write_json(tdir / "runtime_observation.json", observation)
    write_json(tdir / "runtime_snapshot.json", snapshot)
    return observation


def _task_contract_prompt_material(
    task_contract: dict[str, Any] | None,
) -> tuple[str, str]:
    contract = task_contract if isinstance(task_contract, dict) else {}
    required_headings = [
        str(item).strip()
        for item in contract.get("required_report_headings", [])
        if str(item).strip()
    ]
    required_report_lines = [
        str(item).strip()
        for item in contract.get("required_report_lines", [])
        if str(item).strip()
    ]
    allowed_changed_files = [
        " ".join(str(item).split())
        for item in contract.get("allowed_changed_files", [])
        if str(item).strip()
    ]
    target_repo = " ".join(str(contract.get("contract_target_repo") or "").split())
    if (
        not required_headings
        and not required_report_lines
        and not allowed_changed_files
        and not target_repo
    ):
        return (
            "\n".join(
                [
                    "Default report guidance (no custom report contract is set):",
                    "- State the conclusion and the scope it covers.",
                    "- Separate actually executed results, static-only checks, and "
                    "unverified parts; do not present intended work as executed.",
                    "- Each executed entry carries the command's real captured "
                    "producer exit (`$?` or Bash `PIPESTATUS`, not the wrapper, tee "
                    "or log status) with its retained log path; keep failed "
                    "attempts - including preparation failures and invocation or "
                    "overwrite rejections - listed separately from successful "
                    "computations, and report a check without a retained direct "
                    "exit record as unknown.",
                    "- Give evidence locations (paths/line ranges) for key claims "
                    "and list open questions.",
                    "",
                ]
            ),
            "Summary:\n"
            "- <conclusion and scope: what this delivery concludes and what it covers>\n"
            "\n"
            "Files changed:\n"
            "-\n"
            "\n"
            "Verification:\n"
            "- Executed: <commands actually run, each with its real producer exit "
            "(code or unknown) and retained log path, including failed attempts>\n"
            "- Static: <results checked by reading/matching source, not executed>\n"
            "- Unverified: <explicitly not covered>\n"
            "\n"
            "Risks:\n"
            "- Evidence: <paths/line ranges of the key evidence>\n"
            "- Open questions: <unresolved items the reader must decide>",
        )

    guidance = [
        "Task report contract (enforced):",
        "- Use the exact Markdown headings below; validation runs after completion.",
        f"- Required Markdown headings: {', '.join(required_headings) or '-'}",
        f"- Required standalone report lines: {', '.join(required_report_lines) or '-'}",
        f"- Allowed changed files: {', '.join(allowed_changed_files) or '-'}",
        f"- Target repo: {target_repo or '-'}",
        "",
    ]
    sections: list[tuple[str, str]] = [("Summary", "-")]
    seen = {"summary"}
    for heading in required_headings:
        key = heading.casefold()
        if key in seen:
            continue
        seen.add(key)
        if key == "files":
            placeholder = "- <path relative to Target repo>"
        elif key == "commit":
            placeholder = "<commit SHA>"
        else:
            placeholder = "-"
        sections.append((heading, placeholder))
    for heading in ("Verification", "Risks"):
        if heading.casefold() not in seen:
            sections.append((heading, "-"))
    report_template = "\n\n".join(
        f"## {heading}\n{placeholder}"
        for heading, placeholder in sections
    )
    if required_report_lines:
        report_template += "\n\n" + "\n".join(required_report_lines)
    return "\n".join(guidance), report_template


def latest_rotation_session_id(
    root: Path,
    worker_id: str,
    *,
    instance_id: str,
    binding_generation: int,
    fencing_generation: int,
) -> str:
    receipt = read_json(
        framework_root(root)
        / "session-rotations"
        / worker_id
        / "latest.json"
    )
    fence = (
        receipt.get("acceptance_fence", {})
        if isinstance(receipt.get("acceptance_fence"), dict)
        else {}
    )
    if str(fence.get("worker_id") or receipt.get("worker_id") or "") != worker_id:
        return ""
    if instance_id and str(fence.get("instance_id") or "") != instance_id:
        return ""
    if int(fence.get("binding_generation") or 0) != int(binding_generation):
        return ""
    if int(fence.get("fencing_generation") or binding_generation or 0) != int(
        fencing_generation
    ):
        return ""
    return str(
        fence.get("session_id")
        or receipt.get("new_session_id")
        or receipt.get("session_id")
        or ""
    )


def _validated_signal_executable(root: Path) -> Path:
    """Return the installed signal executable's validated absolute path."""
    try:
        resolved_root = root.resolve(strict=True)
        bin_dir = resolved_root / "bin"
        bin_info = bin_dir.lstat()
        candidate_path = bin_dir / "omx_task_signal"
        stat_info = candidate_path.lstat()
    except OSError as exc:
        raise DispatchError(
            f"task signal executable is unavailable: {root / 'bin' / 'omx_task_signal'}"
        ) from exc
    if stat.S_ISLNK(bin_info.st_mode) or not stat.S_ISDIR(bin_info.st_mode):
        raise DispatchError(f"task signal bin directory is unsafe: {bin_dir}")
    if stat.S_ISLNK(stat_info.st_mode) or not stat.S_ISREG(stat_info.st_mode):
        raise DispatchError(
            f"task signal executable is not a regular file: {candidate_path}"
        )
    if stat_info.st_mode & 0o111 == 0:
        raise DispatchError(
            f"task signal executable is not executable: {candidate_path}"
        )
    return candidate_path


_WORKER_CONTRACTS_REFERENCE_RELATIVE = (
    "companion-skill-sources/visible-agent-orchestrator/references/worker-contracts.md"
)


def _worker_contracts_reference() -> str:
    """Resolve the worker-contracts reference for the execution-boundary
    reading entry: this tree's canonical package when the entrypoint runs from
    a source checkout, otherwise the installed codex-user companion-skill
    location pinned by the companion registry. Absolute, so the worker's cwd
    never matters."""
    source = _THIS_FILE.parent.parent / _WORKER_CONTRACTS_REFERENCE_RELATIVE
    if source.is_file():
        return str(source)
    home = os.environ.get("HOME") or str(Path.home())
    codex_root = os.environ.get("CODEX_HOME") or f"{home}/.codex"
    return str(
        Path(codex_root)
        / "skills"
        / "visible-agent-orchestrator"
        / "references"
        / "worker-contracts.md"
    )


def prompt_text(
    root: Path,
    run: str,
    task: str,
    worker: str,
    title: str,
    body: str,
    *,
    task_contract: dict[str, Any] | None = None,
    evidence_budget: dict[str, Any] | None = None,
    acceptance_fence: dict[str, Any] | None = None,
    signal_executable: Path | None = None,
    agent_backend: str = "opencode_tui",
) -> str:
    tdir = task_dir(root, run, task)
    task_md = tdir / "task.md"
    report = tdir / "report.md"
    signal = signal_executable or _validated_signal_executable(root)
    signal_quoted = shlex.quote(str(signal))
    root_quoted = shlex.quote(str(root))
    tdir_quoted = shlex.quote(str(tdir))
    worker_quoted = shlex.quote(worker)
    contract_guidance, report_template = _task_contract_prompt_material(task_contract)
    budget_guidance = ""
    if evidence_budget:
        budget_guidance = f"""Task-local evidence budget:
- Warning threshold: {int(evidence_budget["warning_bytes"]) // (1024 * 1024)} MiB. This is advisory; reduce unnecessary raw evidence.
- Terminal-acceptance limit: {int(evidence_budget["hard_limit_bytes"]) // (1024 * 1024)} MiB, including a {int(evidence_budget["terminal_reserve_bytes"]) // 1024} KiB terminal reserve.
- A success request above the limit closes as blocked, never done.
- Evidence is never silently truncated or deleted.
- Before the first finish, run {signal_quoted} status --root {root_quoted} --task-dir {tdir_quoted} --worker {worker_quoted} --json --record status-pre-finish.json, passing this literal task path unchanged. The tool validates the `<run>/tasks/<task>` shape and the task's recorded owner against `--worker` first and, with `--record <relative-name>`, writes the snapshot itself into that exact task directory as task-local evidence; a wrong parent shape (for example the run root), a task owned by a different worker, a reserved top-level name (also not through an in-task alias), or an existing record target is refused with exit 1 before anything is written anywhere (#1048). Shape and owner checks do not prove this is your current contract task - a different task owned by the same worker still records - so do not retype or substitute the path. Do not shell-redirect this command's output into hand-built paths. Without `--record` the check writes nothing; the recorded file is evidence, not a marker or protocol artifact.
- Inspect `evidence_budget.state`, `entry_count`/`entry_limit`, and `directory_count`/`directory_limit`; leave room for the remaining protocol artifacts that finish will create. This pre-check does not guarantee terminal acceptance.
- `warning` alone does not block `done`: retain necessary evidence and finish normally, stop unnecessary growth, and recheck only after a substantive evidence change. Neither `ok` nor `warning` requires cleanup.
- Only for actual `exceeded` or `scan_failed`, before the first terminal request, may clearly owned, quiescent scratch with no unfinished references be safely handled under existing authorization and then rechecked. If that state cannot be safely resolved within existing authorization, report the blocker and finish `blocked`.
- After a terminal marker exists, stop: do not clean evidence and retry `done`; use the existing closeout/new-task flow.

"""
    clean_room = (
        task_contract.get("clean_room_startup")
        if isinstance(task_contract, dict)
        and isinstance(task_contract.get("clean_room_startup"), dict)
        else {}
    )
    draft_check_selected = (
        isinstance(task_contract, dict)
        and isinstance(task_contract.get("draft_check"), dict)
        and task_contract["draft_check"].get("enabled") is True
    )
    draft_json_path = tdir / "draft.json"
    fence = acceptance_fence or {}
    session_id = str(fence.get("session_id") or "")
    pending_session_id = not clean_room and not session_id
    cold_start = False
    if isinstance(task_contract, dict):
        try:
            selector = extract_opencode_server_prompt_async_canary(task_contract)
        except OperationAuthorizationError:
            selector = None
        cold_start = bool(
            selector is not None and selector.get("session_mode") == "create"
        )
    protocol_cwd = "" if cold_start else 'cd "$ROOT"\n'
    clean_room_guidance = ""
    protocol_block = f"""```bash
ROOT={root_quoted}
TASK_DIR={tdir_quoted}
WORKER_ID={worker_quoted}
{protocol_cwd}
# First command after receiving this task:
{signal_quoted} received --root "$ROOT" --task-dir "$TASK_DIR" --worker "$WORKER_ID"

# Second command before doing the work:
{signal_quoted} started --root "$ROOT" --task-dir "$TASK_DIR" --worker "$WORKER_ID"

# If work takes longer than 30 seconds, run this after each major step:
{signal_quoted} heartbeat --root "$ROOT" --task-dir "$TASK_DIR" --worker "$WORKER_ID"
```"""
    report_write_block = f"""```bash
cat > "$TASK_DIR/report.md" <<'EOF'
{report_template}
EOF
```"""
    finish_commands = f"""```bash
ROOT={root_quoted}
TASK_DIR={tdir_quoted}
WORKER_ID={worker_quoted}
{protocol_cwd}# success
{{finish_command}} --state done {{finish_identity_args}}

# failure
{{finish_command}} --state fail {{finish_identity_args}}

# blocked
{{finish_command}} --state blocked {{finish_identity_args}}
```"""
    recursive_search_fallback = (
        "- If your shell does not have `rg`, use `grep -R` or `find`; "
        "missing `rg` alone is not a blocker."
    )
    boundary_reference = _worker_contracts_reference()
    cold_start_workdir_rule = (
        "- Do not set an extra bash working directory; keep the session cwd.\n"
        if cold_start
        else ""
    )
    if clean_room:
        clean_room_guidance = f"""CLEAN_ROOM_STARTUP_GATE={clean_room.get("mode", "")}
CLEAN_ROOM_PARENT_PATH={clean_room.get("parent_path", "")}
CLEAN_ROOM_PARENT_SHA256={clean_room.get("parent_sha256", "")}

Machine-enforced startup:
- Before Parent admission, the runtime gate permits only task protocol signals and one direct OpenCode `read` of CLEAN_ROOM_PARENT_PATH.
- The gate verifies CLEAN_ROOM_PARENT_SHA256 itself. Do not run Git, title helpers, shell inspection, directory reads, search, glob, list, LSP, skills, or native reviewers first.
- Any other attempted tool is rejected and recorded as `startup_contamination.json`; after that, use the OpenCode write tool for the exact report path and the literal blocked signal below.
- After the exact read succeeds, `startup_admission.json` releases this startup gate. Follow the admitted Parent literally.

"""
        protocol_block = f"""```bash
# These literal one-line protocol signals are allowed before admission.
{signal_quoted} received --root {root_quoted} --task-dir {tdir_quoted} --worker {worker_quoted}
{signal_quoted} started --root {root_quoted} --task-dir {tdir_quoted} --worker {worker_quoted}
{signal_quoted} heartbeat --root {root_quoted} --task-dir {tdir_quoted} --worker {worker_quoted}
```"""
        report_write_block = f"""Use the OpenCode write tool, not shell redirection.

Target: `{report}`

```markdown
{report_template}
```"""
        recursive_search_fallback = ""
    finish_command = (
        f"{signal_quoted} finish --root {root_quoted} "
        f"--task-dir {tdir_quoted} --worker {worker_quoted}"
    )
    finish_session_arg = (
        ""
        if pending_session_id
        else f"--session-id {json.dumps(session_id)} "
    )
    finish_identity_args = (
        f'--task-id {json.dumps(str(fence.get("task_id") or task))} '
        f'--attempt-id {json.dumps(str(fence.get("attempt_id") or ""))} '
        f'--contract-hash {json.dumps(str(fence.get("contract_hash") or ""))} '
        f"{finish_session_arg}"
        f'--instance-id {json.dumps(str(fence.get("instance_id") or ""))} '
        f'--binding-generation {int(fence.get("binding_generation") or 0)} '
        f'--fencing-generation {int(fence.get("fencing_generation") or 0)}'
    )
    if clean_room:
        finish_commands = f"""```bash
# success
{signal_quoted} finish --root {root_quoted} --task-dir {tdir_quoted} --worker {worker_quoted} --state done {finish_identity_args}

# failure
{signal_quoted} finish --root {root_quoted} --task-dir {tdir_quoted} --worker {worker_quoted} --state fail {finish_identity_args}

# blocked
{signal_quoted} finish --root {root_quoted} --task-dir {tdir_quoted} --worker {worker_quoted} --state blocked {finish_identity_args}
```"""
    else:
        finish_commands = finish_commands.format(
            finish_command=finish_command,
            finish_identity_args=finish_identity_args
        )
    draft_check_guidance = ""
    if draft_check_selected:
        live_root = ""
        if (
            isinstance(task_contract["draft_check"].get("jev_live"), bool)
            and task_contract["draft_check"]["jev_live"] is True
            and isinstance(task_contract["draft_check"].get("evidence_root"), str)
        ):
            live_root = task_contract["draft_check"]["evidence_root"]
        check_mode = "authorized live" if live_root else "offline"
        draft_check_live_clause = (
            ""
            if not live_root
            else (
                f"   - The leader authorized one live Jev claim question for this task "
                f"with the evidence root `{live_root}`. The automatic check sends it "
                "only when the draft's `root` resolves to exactly that path; a "
                "mismatch is an intentional local rejection — nothing is sent, no "
                "feedback index is produced for it, and no attempt is consumed. The "
                "one live attempt is consumed by the first complete check, including "
                "`not_asked` and unavailable outcomes; every later or changed draft "
                "is re-checked offline. Default checks without the leader's live "
                "selection stay offline.\n"
            )
        )
        draft_check_guidance = f"""Draft-check delivery contract (selected for this task):

1. Before writing report.md, write the single draft deliverable `{draft_json_path}` using the OpenCode write/edit/apply_patch tool. It is the existing handoff-evidence JSON object, and nothing else:
   {{"handoff_id": {json.dumps(task)}, "root": <one absolute evidence root>, "expect_commit": <optional 7-40 hex Git commit id>, "claims": [{{"claim_id": <id>, "text": <claim>, "evidence": [{{"path": <relative path>, "lines": <optional range>, "expect_sha256": <optional sha256 digest>, "kind": "static"|"execution"}}]}}]}}
   - `handoff_id` must be exactly the task id above; the check state is keyed by it.
   - Claims summarize the delivery's actually executed results with their evidence references; the draft is the check-time input only.
   - One claim is one independent falsifiable assertion — a support label applies to the whole claim, so a bundled absolute negation can ride along on the main part's support unchecked. Split a composite conclusion only when its parts can differ in truth value, and put each part's decisive conditions and exception evidence with the claim they decide; do not mechanically split sentences or pad the claim count.
2. Each supported write of exactly that path automatically runs the {check_mode} draft-delivery check (`omx_draft_delivery`); the advisory feedback is appended to that tool's output. Stale, missing, mismatched, or truncated references each carry a concrete per-reference fix hint (requested range vs observed line count with a corrected range, path/digest corrections, or range-narrowing advice; a truncated excerpt is incomplete evidence, not proof a claim is false) placed before the excerpt. Read it, fix the draft or the work, and write the draft again as needed. A repeated identical draft reuses the recorded feedback; a changed draft is checked again offline.
{draft_check_live_clause}3. Consume the feedback completely: when the appended advisory is truncated, read the complete recorded feedback file `{tdir}/draft-check/{task}.feedback.md` with the read tool; if that file is missing, run `{root_quoted}/bin/omx_handoff_evidence --input {tdir_quoted}/draft.json` for the complete offline index. ok, zero truncation, and Jev supported do not establish correctness: verify the decisive conditions behind each conclusion you keep. A revision is an actual change to the claim text, its references, or the work; merely stating that feedback was adopted revises nothing. Feedback the evidence does not support leaves an already-correct claim unchanged — do not fabricate a change to close. Handling a label may adopt, revise, or rebut it with grounds; the complete original feedback stays recorded under `draft-check/` for review, so report.md need not relist feedback label by label — only feedback that changes a kept conclusion or marks a major disagreement needs one brief line of the handling and its basis. After revising, keep the final draft, evidence, and report consistent: actually executed results and static inference stay separate in the draft and report.md, an execution claim carries retained execution evidence (command, exit code, log), test statistics without retained execution evidence are withdrawn or narrowed instead of relabeled as author-reported, and a broader conclusion the draft already narrowed or withdrew is not restored in report.md without new grounds — when new retained evidence appears, verify it and update the draft and report.md together. Reuse a recorded result only when neither the draft nor its referenced evidence changed, and a recorded Jev answer still corresponds only to the draft bytes it checked (a changed draft is re-checked offline only). Whatever cannot be verified stays an explicitly named unverified item in report.md, which states the completion degree, the important results, and the direct locations of their key evidence together and keeps remaining issues clear — the existing report template already covers this, so add no extra form; close out with the report and the unchanged finish command instead of open-ended fixing or polling.
4. The check is advisory only: it does not replace or modify report.md, does not call finish, and does not change the terminal protocol; Jev labels are advisory feedback, never delivery approval. Do not describe finish, lock release, or any step that has not actually run as already successful — report.md records what actually ran (commands, exit codes) and leaves the rest explicitly pending. After the draft, still write report.md and use exactly the finish command below. If the automatic feedback does not appear, do not block on it: the formal delivery never depends on this check.
5. The draft and the `draft-check/` state files inside {tdir_quoted} are task-local artifacts of this delivery.

"""
    return f"""OMX_RUN_ID={run}
OMX_TASK_ID={task}
OMX_WORKER_ID={worker}
OMX_ATTEMPT_ID={str(fence.get("attempt_id") or "")}
backend={agent_backend}
task_dir={tdir}
task.md={task_md}
prompt.txt={tdir / "prompt.txt"}
report.md={report}

{clean_room_guidance}\
Title:
{title}

Task body:
{body}

Required protocol:

{protocol_block}

{draft_check_guidance}{contract_guidance}
{budget_guidance}\
Optional advisory checkpoint:
- Follow any startup gate before this optional command. Checkpoints are not required to finish; checkpoint failure does not block delivery or replace report+finish.
- `--evidence-path` is an optional task-local relative path to an existing real file, with no symlink escape. External delivery authorization does not widen this field.
- For an authorized external delivery, omit `--evidence-path` and describe the delivered brief in `--summary`:

```bash
{signal_quoted} checkpoint --root {root_quoted} --task-dir {tdir_quoted} --worker {worker_quoted} --attempt-id {shlex.quote(str(fence.get("attempt_id") or "<attempt>"))} --request-id "<unique request id>" --summary "Delivered external brief: <authorized external brief path>"
```

- If machine evidence is useful, optionally write a small task-local pointer/hash file with the external path, hash, and brief conclusion, then reference its task-local relative path with `--evidence-path`; this is not compulsory report duplication.

Same-task supplement acknowledgement (only when a supplement is delivered to this task):
- A delivered supplement is recorded durably as `supplement-<id>.json` in this task directory. After actually reading it and adopting or refusing it within the original scope, run that receipt's exact `ack_command` (already bound to this invocation's root/task-dir/worker/attempt/name/request-id), replacing only its `--summary` placeholder with your truthful one-line adoption summary.
- Only the exact checkpoint `--name supplement:<id>` satisfies the required acknowledgement: a checkpoint carrying just the request-id, a summary, or a paraphrased name does not satisfy the required acknowledgement, and finish stays refused while such a supplement is pending.
- After context compaction or any continuation reread, recover the current pending supplement ids and their exact ACK commands by re-reading this task directory's `supplement-*.json` receipts (newest `reserved_at` first); never guess or reuse an older supplement's name.

Completion:

Before report/finish, reconcile any local TODO list with actual outcomes: complete only finished work and cancel only genuinely unneeded items; never falsely complete unfinished required work to suppress reminders. Resolve launched children under the existing task closeout rules before the report; when none were launched, no child cancellation call is needed. After an accepted terminal, an automatic TODO reminder is not a new human task or authority for further work. This is mitigation, not guaranteed upstream continuation suppression (#953).

1. Write a non-empty report first. The report is the formal deliverable. Once conclusions and the required checks are complete, write the one concise formal report and call the official fenced finish command promptly: do not insert optional report expansion, repeated status polling, historical rereading, or new child work between the finished report and finish; an automatic context compaction between them delays closeout without adding evidence, and a written report, verbal completion, or a compaction event is never the terminal marker (#933).

Write scope (applies to this task):
- Inside {tdir_quoted}: report.md, task-signal protocol artifacts, the task-local subagent ledger, and task files this task body explicitly requires. Use the usable task-owned scratch path explicitly authorized in this task body, or a compatible path under {tdir_quoted}; do not substitute a personal/shared or merely host-allowed root.
- Supplied task paths are literal (#1038/#986): use the task_dir/task.md/prompt.txt/report.md paths from this prompt's header and protocol blocks exactly as rendered; do not reconstruct run ids or task-id segments and do not synthesize shortened or placeholder sibling paths - a string that omits or alters one segment is a different path. Before the first write, locate the exact authorized parent with one bounded check of the literal TASK_DIR (for example `test -d`); if it is unavailable, surface the exact literal and the observed error through the still-available reporting channel and stop - no replacement directory, placeholder-sibling write-then-move, implicit write-domain expansion, or claim of an accepted terminal marker.
- Before reporting a supplied source path as missing (#986): compare the failed lookup string with the contract literal segment by segment, then run at most one narrow exact probe of the literal path itself; do not scan the filesystem broadly. Separate the author's or a child's lookup claim from the observed state of the exact original: a failed lookup of an altered or shortened string is not evidence about the exact original, and a false existence probe is unconfirmed (absent or unreadable). Do not silently fix, create, or delete either path.
- Placing deliverables outside the task directory is authorized only where this task body explicitly states it and only through the delivery mode that carries that authorization; in hidden-envelope delivery, deliverables live inside this task directory, never in the project tree: report.md may reference task-local deliverable files concisely (relative path, scope, verification result) without duplicating their full content, and embeds full content inline only when the exact task contract requires inline delivery.
- Referenced local files may carry narrower task constraints (permitted paths, acceptance conditions) that further restrict this write scope; they never expand it, and referencing a file as an input does not by itself restrict anything.
- Permission to write files inside the task directory does not authorize hand-writing authoritative protocol records (acceptance_fence.json, task/dispatch identity records, protocol_status.json, markers, claims); those are produced only by the control plane and its generated protocol commands.
- If this task launches subprocesses, verify their actual configuration/data roots before launch; allowing a process is not allowing arbitrary HOME-default writes.
- Operational writable scope (#957): use explicit prefix/cache/config permissions and existing tool options; installation still requires authorization. Do not redefine HOME/CODEX_HOME or every XDG variable, or construct wrappers just to enumerate paths. For an authorized Conda install, a direct example is `CONDA_PKGS_DIRS=<authorized-cache> conda create --prefix <authorized-prefix> <approved-package=version>` with logs in the authorized evidence path; this example grants no additional cache/config writes.
- The report's write-domain declarations must match actually observed artifacts; disclose any out-of-scope write explicitly instead of summarizing it as read-only.
- Output ownership (#980): distinguish worker-authored deliverables/scratch, control-plane protocol artifacts, and host-managed tool-output/session artifacts. One brief disclosure of an observed external host artifact (path, size/owner when known, attribution limits) is enough; it is not included in TASK_DIR accounting and does not by itself create a terminal blocker. Keep deliberate worker writes within the authorized scope; do not delete shared spool or claim control over host retention.
- Usable write scope (#996/#998): host capability is not task authorization. Preserve exact paths/actions, prohibitions and source-access routing (including download/access routes and output/cache boundaries) in every nested handoff; narrow child ownership without broadening parent authority. If the authorized scratch fails a test-root restriction, report the precise missing directory/action through existing parent/supplement coordination, retain the failure and continue independent work; do not invent a host-preapproved replacement or a new approval ritual. Distinguish explicit deliverables, deliberate scratch, protocol writes and normal incidental cache/log writes of a specifically authorized existing diagnostic tool. A narrow deliverable root alone does not forbid that tool's disclosed, bounded incidental behavior already authorized by the task body/supplement. Tool availability alone grants none of it; unknown production side effects remain unresolved. This never grants arbitrary HOME/config/install/model/session-lifecycle or mutable production changes; use existing options, not blanket HOME/XDG redirection, with no new permission schema or terminal gate.

{report_write_block}

Execution boundary (environment, baselines, fixtures):
- Real producer exits: capture each executed command's real exit (`$?`, or Bash `PIPESTATUS` before any other command); wrapper, tee or display-filter status is never the producer exit; missing direct exit evidence stays unknown (#984/#1019).
- Failure evidence: preserve failed validation artifacts and matching input manifests; a justified retry uses a fresh attempt directory, never deletion or overwrite; report the actual invocation count, including input/overwrite rejections, separately from successful computations; if artifacts were lost, disclose reconstructed evidence and missing originals (#984/#982).
- Original versus summary: label material `original`/`verbatim` only when it is a byte-preserving copy of the exact bounded source verified by a retained direct byte compare; otherwise keep it a retrospective summary with provenance and the missing original disclosed (#1030).
- Narrow reads and secrets: answer config/launcher/plugin questions from the named repository entrypoints and the exact known launcher/config files, projecting only the safe fields needed; never dump an effective config, never recursively search the whole profile/config/history for a narrow question; secret-bearing values stay out of stdout, stderr and retained logs (#863).
- Precise paths: use supplied task and source paths exactly as rendered; compare a failed lookup with the contract literal segment by segment and run at most one narrow exact probe of the literal before reporting a path missing; never reconstruct, shorten or substitute paths (#1038/#986). Resolved references: when this prompt references a document by a resolved absolute path, read that exact path; if it is unreadable, report the exact path and error, answer independently answerable work from the frozen task contract, and mark only genuinely reference-dependent claims unresolved (#945).
- Input and nested scope: authorized project/dir inputs include necessary provenance traversal; independent engineering review is not automatically a blinded comparison - only an explicitly blinded comparison restricts compared identities, and current controller private gold and unshared review answers stay preserved in every task; an unlisted read is disclosed with its source, use and actual impact and does not automatically invalidate the work; input scope and local references never expand write or transport authority; every nested handoff preserves exact paths, actions, prohibitions and source-access routing, narrowing child ownership without broadening this grant (#951/#996).
- Proportional verification: prefer existing focused tests, targeted diff and short hash checks; reuse valid unchanged evidence; keep hard ceilings, resource cleanup and security refusals (#969). Enforce formal hard resource limits and explicit hard format constraints exactly; soft size suggestions guide concision only (#973).
- Current-role versus contract-owned next stages (#1024): deliver your assigned current-role work and outputs, then hand them to Main; a next stage consuming them (for example the separately assigned independent/external review) is owned by the actual task contract - Main chooses, dispatches and accepts it unless the contract explicitly assigns those stages or coordination to you, which is authorized scope, not a violation; task materials describing a next stage's requirements (for example a non-author stage-1 judgment) do not assign them to you. A worker-side internal review/self-check of your own output stays allowed and may be called an internal review; it must not silently count as the separately assigned external/non-author acceptance stage - label it truthfully when handing off.
- Read-only source paths: a read-only source path appearing in this task does not authorize source development or installation; production plan/check stays read-only and an explicitly authorized apply retains its install gates (#887).
- Conditional operational detail, read on actual action (never by role name): the complete rules for the action kinds below are published in the generated worker-contracts reference `{boundary_reference}`. That absolute path was resolved by the generator that produced this prompt - a source run points at this tree's canonical package, an installed run at the active companion-skill generation - and is readable without depending on your current cwd. Before an actual action of a listed kind, read that action's named section in that file; the quoted headings are the anchors (issue numbers are not anchors). Read only the triggered section(s), not the whole package:
  - GUI observation or resumption: "Mixed GUI observation (#780)"; "GUI resumption (#787)"; and, before waiting for an existing Main cue, "Readable evidence handoff (#780)" in this same reference.
  - Fixtures, ports, background shell launches, fresh CLI/HUD acceptance: in "Environment, baselines and fixtures", the items "Owned fixtures (#899)", "Fixture cleanup (#921)", "Background shell composition (#932)", "Fresh-process acceptance boundaries (#938)".
  - Long-running or potentially billed commands, timeout handling and retries: in "Environment, baselines and fixtures", the items "Long command budgets and attempt evidence (#825)", "Tool-timeout retry ownership (#1000)"; and the item "Responsive long I/O (#981, with or without subagents)".
  - Git writes, baseline comparison or old-baseline checks: in "Environment, baselines and fixtures", the items "Assigned Git writer (#865)", "Git-writer identity is ownership, not blanket permission (#939)", "Isolated baseline copies (#1015)".
  - Verifying network-capable entrypoints, or Python syntax checks that must not write: in "Environment, baselines and fixtures", the item "No-live preparation (#869)"; and the py_compile/ast.parse guidance in "Usable write scope and nested authority (#996/#998)".
  - visible-agent-orchestrator source-worktree preparation and test selection (these routes apply only when the task handoff names a visible-agent-orchestrator source worktree; an unrelated project skips this framework-only read and these preparation/test routes entirely and keeps its own scoped test runner, without guessing project identity from path or body strings): in "Environment, baselines and fixtures", the items "Release preparation (#887, applicability first per #1020)" and "Scoped tests (#866, same #1020 applicability scope as the release preparation item)".
  - Task-contract phase questions: "Permission Versus Expected Product Success (#784)"; "Preparation Versus Frozen/Executed Phases (#788)".
  - Review timing, or waiting for a named delivery artifact: "Review Stage Versus Final Verdict, and Pending-Artifact Waiting (#990/#991)".
  - Lane handoff and early partial publication: "Lane handoff (#954)".
  Fuller statements of the universal obligations above, with executable evidence examples, live in "Validation evidence and real command status (#984/#982)", "Original Bytes and Verbatim Labels in Evidence Handoff (#1030)", "Current-Role Outputs Versus Contract-Owned Next Stages (#1024)", the evidence-capture and display-filter examples in "Usable write scope and nested authority (#996/#998)", and the labeled items "Sensitive configuration (#863)", "Input scope (#951/#837/#826)", "Verification is proportional (#969)" and "Length guidance (#973)" in "Environment, baselines and fixtures"; read one when its obligation is actually load-bearing for your next action, not upfront. If the reference file itself is unreadable, report the exact path and error and proceed under the universal obligations above (#945).

Required OpenCode native subagent ledger when used:
- If this task uses native subagents or Task-style artifact lanes, append lifecycle rows to task-local `subagent_ledger.jsonl` inside `$TASK_DIR` so the board can show running/completed subagent use.
- Prefer `./bin/omx_subagent_ledger append --root "$ROOT" --task-dir "$TASK_DIR" --worker "$WORKER_ID" ... --write-task-local` when available; otherwise append JSONL directly.
- Before the first helper call, run `./bin/omx_subagent_ledger append --help`; use only listed enum values and omit optional enum flags rather than inferring values from prose.
- Append one JSONL row when a subagent/lane is launched and a second terminal row with the same subagent_id when it is completed, failed, or blocked. Include parent_worker_id, parent_run_id, parent_task_id, subagent_id, agent, lane, purpose, status, and optional artifact/semantic_status/retry_scope fields in each row. `subagent_ledger.json` is allowed only when rewriting the complete task-local ledger atomically is safer.
- This ledger is advisory evidence only and does not change completion truth; report.md + exactly one of .done/.fail/.blocked remains the terminal signal.
- Do not write subagent ledger files outside this task-local directory. `omx_task_signal` does not manage the ledger.

Worker-internal subagent discipline (applies only when this task uses internal subagents):
- Dependency boundary (#958): no-install/no-new-dependencies applies to inner delegation too. Pass the known build/dependency directory and call the already-installed executable directly (for example `<known-build-dir>/node_modules/.bin/eslint <authorized-source>`). npm exec/npx can download; do not use them as an implicit fallback. Missing tools remain unrun/unknown; report that limit instead of installing or claiming a check passed.
- A launch acknowledgement or transport completion alone does not establish the child's outcome: a return whose body is timeout/error text (whatever the tool state says), a `Task failed to start` return, or an empty child session leaves the child's real state unknown until checked, and a `completed` transport state never proves the child started or succeeded. Inspect native terminal evidence and delivered content.
- After such a return, narrow the child state with what you already have — the returned task handle, a returned child-session identity, or an exact-parent child-session lookup — and record the best-known state in the task-local ledger with that identity: `running` when the lookup shows it, `unknown` when the child state is not established, and a terminal `completed`/`failed`/`blocked` row only when the terminal state is actually measured; an observed cancellation goes into the row's existing free-text fields (for example `artifact_summary`), never a new status value. Do not assume the child still runs, and do not assume it never ran.
- Retry a failed internal delegation only with new evidence (a confirmed recoverable cause or a changed approach); repeating an identical dispatch is not recovery. A refused active continuation is not accepted/queued/consumed: retain the correction and original child, retrieve its native result, then integrate the correction in the parent after delivery; no retry/cancel/relaunch or duplicate writer to manufacture delivery. Label parent integration separately from independent child review.
- Native background result handles (bg_...) and child-session IDs (ses_...) have distinct scopes. session_info/session_read not-found is a discovery/read gap, not child absence: prefer the original native completion notification/result and follow the actual tool schema. Only if identity diagnosis matters use a bounded read-only GET of the exact child on the original bound instance, verifying id/parentID against the current parent; existence is not delivery. Judge session-tool misses in three separate branches (#944/#1025): tool miss with exact GET 200 is an index/read miss, not child absence; exact GET 404 after the native result or a non-empty report was already delivered leaves that result evidence standing and proves neither non-execution nor duplicate-dispatch authorization; a read returning `Error fetching messages` or another unknown error stays unknown. The original bg_ handle and delivered reports are the result evidence, and session readability is reported as its own fact. No cross-instance search or replacement writer on a discovery miss.
- Native result/state (#976): preserve the real bg_ result handle; where notification is required, await it before background_output(task_id=<bg handle>, from_end=true), never immediate polling or sleep+ls. Native running/no-file means not yet delivered; native failed/no-file is failure; transport-unknown/no-file stays unknown. Native completed/no-file still needs substantive result assessment: a reply-based contract may be satisfied by the native result, but a required file is still missing. File presence/absence alone establishes none of these states.
- Reuse partial evidence the child already produced, stating its limits. An optional lane that fails does not block this task: complete the work directly in the parent and label that fallback in report.md. A contract-required independent review stays honest — parent-verified work is reported as parent-verified, never as the independent review.
- Optional late/failed children (#976) do not gate independent work or sufficient parent evidence; necessary substantive verification remains required. Consume delivered results or cancel outstanding optional work and record the observed outcome before report/finish; do not merge late output after report freeze. Cancellation is not successful verification and cannot satisfy a required independent review. Bounded observations are permitted safe points, not mandatory polling cadence.
- Keep the parent/child ownership record (delegated task id, child session, and the exact delegated write scope, for example an OWNERSHIP file) stable and re-readable: after child compaction or recovery, a child that can re-derive unchanged ownership resumes directly, and only actual ambiguity is escalated to the parent while other work proceeds. As the parent, watch for child questions or blocked outputs, not only file counts or heartbeats.
- While internal subagents run, do not hold long blocking waits (sync `sleep`, or blocking background-output reads of several minutes): keep each synchronous wait bounded (about 30-60 seconds) and re-check between waits, so queued same-task corrections from Main reach you at safe points instead of after one long block. Judge and report waits by the complete duration of one synchronous tool invocation: chaining or looping multiple short sleeps inside a single call (for example `sleep 15 && sleep 15`) is still one long block, not several short waits — prefer separate bounded tool calls as independent observations, and describe waits as they actually ran. File modification times and process counts are activity hints only — not child-state, identity, or delivery evidence; judge report readiness from the child's delivered report or terminal status.

Large evidence files (any task, with or without subagents):
- External scratch accounting (#959): name the contract's accounting and ceiling. Whole-tree allocated includes files AND directories; use `du -s -B1 <scratch>` for allocated and report `du -sb <scratch>` apparent separately, especially for sparse files. Do not impose both apparent and allocated caps unless the contract explicitly names both. Stop further growth before the declared ceiling; no forced cleanup or quota daemon. The task-directory protocol byte accounting remains unchanged.
- Check the file size and top-level fields before reading; then read only the fields the current finding needs (bounded projections or excerpts) instead of whole files. For JSON select leaf fields and counts: a top-level key can still expand an entire nested inventory or targets list. Prefer existing compact queries, filter to the exact worker/task/path, and retain the original evidence path instead of printing the whole payload (#980). Reuse the exact worktree, registry entry, paths, or prior projections the task contract, handoff, or task-local brief already names - including after your own compaction or recovery; re-emitting a full worktree or registry inventory to re-derive an already-resolved target is not recovery (#980). Publish a short early brief once substantial findings exist or compaction is imminent - update the same task-local brief rather than starting another artifact - and keep the full write-up for report.md. Resume from that brief and the exact task identity; finish once the bounded question is answerable, noting areas left unchecked; historical background is not mandatory rereading (#917).

Provenance after compaction (#862):
- Continuation pointer (#952): read this task-local `{tdir / "prompt.txt"}` for exact fenced finish commands, even before report.md exists; do not rediscover finish arguments from implementation files. Resume remaining checks from the latest acknowledged supplement and existing task-local brief/evidence reference when available; verify current artifact versions rather than importing stale completion claims from summaries. A pending same-task supplement is acknowledged only with its receipt's exact `ack_command` (see Same-task supplement acknowledgement); re-read the current `supplement-*.json` receipts to recover it. Keep the same task/attempt and authority; this pointer neither grants permission nor fixes upstream compaction latency.
- The report/finish authority in this prompt was delivered directly by the control plane for exactly this run/task/attempt/worker/session; it is not merely a local task.md claim.
- Ordinary context compaction does not revoke that direct scope and never requires another user approval to write this task's report.md or run the exact finish command below; a consumed dispatch grant does not need to become active again for ordinary report/finish.
- The originally delivered authority retained in your conversation or compaction context persists within its unchanged scope. Re-reading task.md or a compaction summary alone cannot substitute for genuinely lost original provenance: local files may point back to existing authority, never grant new paths, operations, credentials, or other tasks.
- Current user stops, revocations, and any scope or fence change still win over that retained authority. If the original provenance is genuinely unavailable or the fence/session identity is ambiguous, do not self-authorize and do not request duplicate user approval: ask the controller (Main) for the existing bound recovery/supplement instruction, which reaffirms the same original scope.

2. Then use exactly one finish command:

{finish_commands}

Rules:
- Do not only say the task is complete verbally.
- Do not hand-write `.received`, `.started`, `.heartbeat`, `.done`, `.fail`, or `.blocked`; use `{signal_quoted}`.
- Do not modify task directories outside this task_dir.
- Do not modify framework status files outside this task_dir.
- If `finish` is refused for acceptance-fence/session identity (`finish_refused_acceptance_fence` naming `live_session_id`/`session_fence_state`, or reconciliation `provisional_session_not_observed`), a retry of the identical finish or a heartbeat loop cannot satisfy the old fence: preserve the fence, owner lock, report and refusal evidence exactly as refused, state the refusal in your report, and ask the controller (Main) for the existing bounded recovery instruction instead of re-running finish unchanged (#1007).
{recursive_search_fallback}
{cold_start_workdir_rule}- submitted is not received.
- idle is not completed.
- report.md + exactly one of .done/.fail/.blocked is the terminal signal.
- If you modify business files, list every modified file and verification command in report.md.

IMPORTANT TERMINATION RULE:
After you successfully run:
{signal_quoted} finish --root "$ROOT" --task-dir "$TASK_DIR" --worker "$WORKER_ID" --state done|fail|blocked

you must stop. Do not repeat the completion summary. Do not restate the file list. Do not continue reasoning. Do not start another loop. The report.md is the deliverable. Your final visible response must be at most one line:
OMX_TASK_CLOSED {task} {str(fence.get("attempt_id") or "")} .<state>
"""


def resolve_body_file_argument(args: argparse.Namespace) -> None:
    """Resolve --body-file into args.body before any grant, task, or lock
    mutation. The CLI enforces --body/--body-file exclusivity at parse time;
    programmatic callers select file input by setting body_file. The path is
    used exactly as provided, the file is consumed as exact UTF-8 bytes
    without newline translation, and only the regular file actually opened is
    accepted, so non-regular inputs such as FIFOs are rejected without
    waiting for a writer."""
    if not hasattr(args, "body_file"):
        return
    body_file = getattr(args, "body_file", None)
    if body_file is None:
        if getattr(args, "body", None) is None:
            raise DispatchError("run-one requires --body or --body-file")
        return
    descriptor = -1
    try:
        descriptor = os.open(str(body_file), os.O_RDONLY | os.O_NONBLOCK)
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise DispatchError(f"body_file_unreadable: not a regular file: {body_file}")
        chunks = []
        while True:
            chunk = os.read(descriptor, 65536)
            if not chunk:
                break
            chunks.append(chunk)
        raw = b"".join(chunks)
    except OSError as exc:
        raise DispatchError(f"body_file_unreadable: {body_file}: {exc}") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    try:
        args.body = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise DispatchError(f"body_file_invalid_utf8: {body_file}: {exc}") from exc


def ensure_nonempty_task_body(body: str) -> None:
    if not str(body).strip():
        raise DispatchError(
            "empty_task_body: --body must contain the non-empty task contract body"
        )


def create_task(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    title: str,
    body: str,
    *,
    demo: bool = False,
    runtime_backend: str = RUNTIME_BACKEND,
    runtime_backend_type: str | None = None,
    task_contract: dict[str, Any] | None = None,
    operation_contract: dict[str, Any] | None = None,
    session_action: str = "",
) -> Path:
    worker = worker_record(root, worker_id) if not demo else {"worker_id": worker_id, "backend": "opencode_tui"}
    if not demo:
        ensure_worker_allowed(root, worker)
    clean_room_gate = require_clean_room_startup_gate(
        root,
        worker,
        task_contract,
    )
    require_draft_check_contract(task_contract)
    if operation_contract is None:
        if not demo:
            raise DispatchError("operation capability is required")
        operation_contract = {
            "operation_kind": "demo",
            "task_id": task,
            "attempt_id": f"attempt-{uuid.uuid4().hex[:16]}",
            "authorization": {
                "authorization_mode": "demo",
                "authorization_id": "demo-only",
                "ledger_boundary": 0,
            },
        }
    signal_executable = _validated_signal_executable(root)
    runtime_backend_type = runtime_backend_type or backend_type_for(runtime_backend)
    tdir = task_dir(root, run, task)
    _validate_real_directory_chain(root, tdir, create=True)
    if tdir.exists() and any(tdir.iterdir()):
        raise DispatchError(f"task directory already exists and is not empty: {rel(tdir, root)}")
    created_at = utc_now()
    evidence_budget = default_task_evidence_budget()
    evidence_budget_contract_path = (
        tdir.parent.parent
        / "task-contracts"
        / f"{task}.evidence-budget.json"
    )
    _write_json_nofollow(
        root=root,
        path=evidence_budget_contract_path,
        payload={
            "schema_version": 1,
            "contract_kind": "task_evidence_budget",
            "task_id": task,
            "evidence_budget": evidence_budget,
        },
        existing_equal_ok=True,
    )
    evidence_budget_contract_rel = rel(evidence_budget_contract_path, root)
    instance = derive_process_instance(worker, observed_at=created_at)
    contract_material = (
        task_contract
        if isinstance(task_contract, dict)
        else {"title": title, "body": body}
    )
    contract_hash = hashlib.sha256(
        json.dumps(
            contract_material,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
        ).encode("utf-8")
    ).hexdigest()
    binding_generation = int(worker.get("binding_generation") or 0)
    fencing_generation = int(
        worker.get("fencing_generation")
        or worker.get("binding_generation")
        or 0
    )
    if str(session_action) == "keep":
        # #1027: keep must not silently adopt a historical session as the
        # new task's identity. No supported interface proves the current
        # TUI selection at preparation time, so the new keep task starts
        # with an unknown (pending) session and binds later through the
        # existing task-attributed observation machinery.
        session_id = ""
    else:
        session_id = str(worker.get("session_id") or "") or latest_rotation_session_id(
            root,
            worker_id,
            instance_id=instance["instance_id"],
            binding_generation=binding_generation,
            fencing_generation=fencing_generation,
        )
    operation_attempt_id = (
        str(operation_contract.get("attempt_id") or "")
        if isinstance(operation_contract, dict)
        else ""
    )
    acceptance_fence = {
        "schema_version": 1,
        "fence_kind": "visible_terminal_output_acceptance",
        "task_protocol_version": TASK_PROTOCOL_VERSION,
        "terminal_protocol_version": TERMINAL_PROTOCOL_VERSION,
        "terminal_acceptance_required": True,
        "run_id": run,
        "worker_id": worker_id,
        "session_id": session_id,
        "task_id": task,
        "attempt_id": operation_attempt_id or f"attempt-{uuid.uuid4().hex[:16]}",
        "contract_hash": contract_hash,
        "instance_id": instance["instance_id"],
        "binding_generation": binding_generation,
        "fencing_generation": fencing_generation,
        "session_fence_state": (
            "provisional"
            if session_id.startswith("ses_")
            else "pending_live_observation"
        ),
        "created_at": created_at,
    }
    creation_record = {
        "schema_version": 1,
        "record_kind": "terminal_protocol_creation",
        "task_protocol_version": TASK_PROTOCOL_VERSION,
        "terminal_protocol_version": TERMINAL_PROTOCOL_VERSION,
        "terminal_acceptance_required": True,
        "run_id": run,
        "task_id": task,
        "attempt_id": acceptance_fence["attempt_id"],
        "contract_hash": acceptance_fence["contract_hash"],
        "worker_id": worker_id,
        "session_id": acceptance_fence["session_id"],
        "instance_id": acceptance_fence["instance_id"],
        "binding_generation": acceptance_fence["binding_generation"],
        "fencing_generation": acceptance_fence["fencing_generation"],
        "created_at": created_at,
    }
    creation_record_path_value = creation_record_path(tdir)
    _write_json_nofollow(
        root=root,
        path=creation_record_path_value,
        payload=creation_record,
        existing_equal_ok=True,
    )
    creation_record_rel = rel(creation_record_path_value, root)
    write_text(tdir / "owner", worker_id + "\n")
    write_text(tdir / "backend", str(worker.get("backend") or "opencode_tui") + "\n")
    write_text(
        tdir / "task.md",
        f"# {title}\n\n{body}\n\n"
        f"## Continuation pointer\n\n"
        f"Read `{tdir / 'prompt.txt'}` for the exact fenced finish commands, "
        "even before report.md exists; do not rediscover finish arguments. "
        "Resume remaining checks from the latest acknowledged supplement and "
        "existing task-local brief/evidence reference when available. Check current "
        "artifact versions; do not import stale completion claims. This pointer "
        "does not expand task/attempt authority or create terminal truth.\n"
        "A delivered same-task supplement is recorded as "
        f"`supplement-<id>.json` in this task directory; acknowledge it with "
        "that receipt's exact `ack_command` and your truthful one-line "
        "adoption summary - only the exact checkpoint "
        "`--name supplement:<id>` satisfies the required acknowledgement, and "
        "current receipts (newest `reserved_at` first) are re-read after any "
        "continuation instead of guessing ids.\n",
    )
    write_json(tdir / "acceptance_fence.json", acceptance_fence)
    prompt = prompt_text(
        root,
        run,
        task,
        worker_id,
        title,
        body,
        task_contract=task_contract,
        evidence_budget=evidence_budget,
        acceptance_fence=acceptance_fence,
        signal_executable=signal_executable,
        agent_backend=str(worker.get("backend") or "opencode_tui"),
    )
    write_text(tdir / "prompt.txt", prompt)
    dispatch = {
        "schema_version": 1,
        "created_at": created_at,
        "run": run,
        "task": task,
        "worker": worker_id,
        "runtime_backend": runtime_backend,
        "runtime_backend_type": runtime_backend_type,
        "rmux_default": RMUX_DEFAULT,
        "dispatch_adapter": DISPATCH_ADAPTER,
        "backend": str(worker.get("backend") or "opencode_tui"),
        "mode": "visible-dispatch",
        "task_protocol_version": TASK_PROTOCOL_VERSION,
        "terminal_protocol_version": TERMINAL_PROTOCOL_VERSION,
        "terminal_acceptance_required": True,
        "attempt_id": acceptance_fence["attempt_id"],
        "contract_hash": acceptance_fence["contract_hash"],
        "task_dir": rel(tdir, root),
        "task_path": rel(tdir / "task.md", root),
        "prompt_path": rel(tdir / "prompt.txt", root),
        "report_path": rel(tdir / "report.md", root),
        "worker_record": worker,
        "acceptance_fence": acceptance_fence,
        "evidence_budget": evidence_budget,
        "evidence_budget_contract_path": evidence_budget_contract_rel,
        "terminal_protocol_creation_path": creation_record_rel,
        "submitted": False,
        "dispatch_writes_only": ["task.md", "prompt.txt", "dispatch.json", "task.json", "acceptance_fence.json", "owner", "backend", "events.jsonl", evidence_budget_contract_rel, creation_record_rel],
        "dispatch_never_writes": [".received", ".started", ".heartbeat", ".done", ".fail", ".blocked"],
    }
    if clean_room_gate:
        dispatch["clean_room_startup_gate"] = clean_room_gate
    if operation_contract is not None:
        dispatch["operation_contract"] = dict(operation_contract)
    write_json(tdir / "dispatch.json", dispatch)
    task_metadata = {
        "id": task,
        "run": run,
        "owner": worker_id,
        "schema_version": 1,
        "backend": str(worker.get("backend") or "opencode_tui"),
        "runtime_backend": runtime_backend,
        "runtime_backend_type": runtime_backend_type,
        "rmux_default": RMUX_DEFAULT,
        "dispatch_adapter": DISPATCH_ADAPTER,
        "task_protocol_version": TASK_PROTOCOL_VERSION,
        "terminal_protocol_version": TERMINAL_PROTOCOL_VERSION,
        "terminal_acceptance_required": True,
        "title": title,
        "body": body,
        "created_at": dispatch["created_at"],
        "attempt_id": acceptance_fence["attempt_id"],
        "contract_hash": acceptance_fence["contract_hash"],
        "acceptance_fence": acceptance_fence,
        "evidence_budget": evidence_budget,
        "evidence_budget_contract_path": evidence_budget_contract_rel,
        "terminal_protocol_creation_path": creation_record_rel,
    }
    if task_contract is not None:
        task_metadata["task_contract"] = dict(task_contract)
    if operation_contract is not None:
        task_metadata["operation_contract"] = dict(operation_contract)
    if clean_room_gate:
        task_metadata["clean_room_startup_gate"] = clean_room_gate
    write_json(tdir / "task.json", task_metadata)
    append_event(tdir / "events.jsonl", {
        "ts": dispatch["created_at"],
        "event": "visible_dispatch_task_created",
        "source": "omx_visible_dispatch",
        "worker": worker_id,
        "runtime_backend": runtime_backend,
        "runtime_backend_type": runtime_backend_type,
        "dispatch_adapter": DISPATCH_ADAPTER,
        "task_protocol_version": TASK_PROTOCOL_VERSION,
        "terminal_protocol_version": TERMINAL_PROTOCOL_VERSION,
        "terminal_acceptance_required": True,
        "attempt_id": acceptance_fence["attempt_id"],
        "contract_hash": acceptance_fence["contract_hash"],
    })
    return tdir


def refresh_task_acceptance_fence(
    root: Path,
    run: str,
    task: str,
    worker: dict[str, Any],
    *,
    rotation_session_id: str | None = None,
) -> dict[str, Any]:
    tdir = task_dir(root, run, task)
    fence_path = tdir / "acceptance_fence.json"
    existing = _read_json_nofollow(
        root=root,
        path=fence_path,
        missing_ok=True,
    )
    if existing is None:
        return {}

    classification = classify_terminal_protocol(tdir)
    if classification.get("classification") != "modern_v2":
        mismatched = ", ".join(
            str(field)
            for field in classification.get("mismatched_fields", [])
        ) or "missing modern identity"
        raise DispatchError(
            f"terminal protocol identity is not refreshable: {mismatched}"
        )

    existing = _read_json_nofollow(
        root=root,
        path=fence_path,
    )
    if existing is None:
        raise DispatchError(
            f"acceptance fence is missing: {rel(fence_path, root)}"
        )
    attempt_id = str(existing.get("attempt_id") or "")
    contract_hash = str(existing.get("contract_hash") or "")
    if not attempt_id or not contract_hash:
        raise DispatchError(
            f"acceptance fence is invalid: {rel(fence_path, root)}"
        )
    stable_identity = {
        "task_protocol_version": TASK_PROTOCOL_VERSION,
        "terminal_acceptance_required": True,
        "run_id": run,
        "task_id": task,
        "attempt_id": attempt_id,
        "contract_hash": contract_hash,
    }
    for field, expected in stable_identity.items():
        if existing.get(field) != expected:
            raise DispatchError(
                f"terminal protocol stable identity conflicts in acceptance fence: {field}"
            )
    creation_path = creation_record_path(tdir)
    creation = _read_json_nofollow(
        root=root,
        path=creation_path,
    )
    if creation is None:
        raise DispatchError(
            f"terminal protocol creation record is missing: {rel(creation_path, root)}"
        )
    if creation.get("record_kind") != CREATION_RECORD_KIND:
        raise DispatchError(
            f"terminal protocol creation record is invalid: {rel(creation_path, root)}"
        )
    for field, expected in stable_identity.items():
        if creation.get(field) != expected:
            raise DispatchError(
                f"terminal protocol stable identity conflicts in creation record: {field}"
            )

    worker_id = str(worker.get("worker_id") or "")
    refreshed_at = utc_now()
    instance = derive_process_instance(worker, observed_at=refreshed_at)
    binding_generation = int(worker.get("binding_generation") or 0)
    fencing_generation = int(
        worker.get("fencing_generation")
        or worker.get("binding_generation")
        or 0
    )
    task_session_action = read_json(tdir / "session_action.json")
    # Only the current submit transaction supplies this validated replacement.
    # An empty replacement means proven home, not fallback to the old session.
    # For keep (#1027) a concrete session is never derived from history: the
    # new task's session stays unknown until task-attributed observation
    # binds it, so an obsolete session cannot be silently adopted.
    if str(task_session_action.get("session_action") or "") == "keep":
        session_id = rotation_session_id if rotation_session_id is not None else ""
    else:
        session_id = rotation_session_id if rotation_session_id is not None else (
            str(worker.get("session_id") or "") or latest_rotation_session_id(
                root,
                worker_id,
                instance_id=instance["instance_id"],
                binding_generation=binding_generation,
                fencing_generation=fencing_generation,
            )
        )
    refreshed = {
        **existing,
        "task_protocol_version": TASK_PROTOCOL_VERSION,
        "terminal_protocol_version": TERMINAL_PROTOCOL_VERSION,
        "terminal_acceptance_required": True,
        "worker_id": worker_id,
        "session_id": session_id,
        "task_id": task,
        "attempt_id": attempt_id,
        "contract_hash": contract_hash,
        "instance_id": instance["instance_id"],
        "binding_generation": binding_generation,
        "fencing_generation": fencing_generation,
        "session_fence_state": (
            "provisional"
            if session_id.startswith("ses_")
            else "pending_live_observation"
        ),
        "refreshed_at": refreshed_at,
    }

    task_metadata = read_json(tdir / "task.json")
    title = str(task_metadata.get("title") or "").strip()
    stored_body = task_metadata.get("body")
    body = stored_body if isinstance(stored_body, str) else ""
    if not title or not isinstance(stored_body, str):
        task_doc = read_text(tdir / "task.md")
        heading, separator, remainder = task_doc.partition("\n\n")
        if not title:
            title = heading.removeprefix("# ").strip()
        if not isinstance(stored_body, str):
            body = remainder.rstrip("\n") if separator else ""
    if not title:
        raise DispatchError(
            f"task title is unavailable for acceptance fence refresh: {rel(tdir, root)}"
        )

    task_contract = (
        dict(task_metadata["task_contract"])
        if isinstance(task_metadata.get("task_contract"), dict)
        else None
    )
    evidence_budget = (
        dict(task_metadata["evidence_budget"])
        if isinstance(task_metadata.get("evidence_budget"), dict)
        else None
    )
    prompt = prompt_text(
        root,
        run,
        task,
        worker_id,
        title,
        body,
        task_contract=task_contract,
        evidence_budget=evidence_budget,
        acceptance_fence=refreshed,
        agent_backend=str(worker.get("backend") or "opencode_tui"),
    )
    dispatch = read_json(tdir / "dispatch.json")
    dispatch["worker"] = worker_id
    dispatch["worker_record"] = dict(worker)
    dispatch["task_protocol_version"] = TASK_PROTOCOL_VERSION
    dispatch["terminal_protocol_version"] = TERMINAL_PROTOCOL_VERSION
    dispatch["terminal_acceptance_required"] = True
    dispatch["acceptance_fence"] = refreshed
    dispatch["acceptance_fence_refreshed_at"] = refreshed_at
    task_metadata["owner"] = worker_id
    task_metadata["title"] = title
    task_metadata["body"] = body
    task_metadata["task_protocol_version"] = TASK_PROTOCOL_VERSION
    task_metadata["terminal_protocol_version"] = TERMINAL_PROTOCOL_VERSION
    task_metadata["terminal_acceptance_required"] = True
    task_metadata["attempt_id"] = attempt_id
    task_metadata["contract_hash"] = contract_hash
    task_metadata["acceptance_fence"] = refreshed
    task_metadata["acceptance_fence_refreshed_at"] = refreshed_at

    write_json(fence_path, refreshed)
    write_text(tdir / "prompt.txt", prompt)
    write_json(tdir / "dispatch.json", dispatch)
    write_json(tdir / "task.json", task_metadata)
    append_event(
        tdir / "events.jsonl",
        {
            "ts": refreshed_at,
            "event": "visible_dispatch_acceptance_fence_refreshed",
            "source": "omx_visible_dispatch",
            "worker": worker_id,
            "task_protocol_version": TASK_PROTOCOL_VERSION,
            "terminal_protocol_version": TERMINAL_PROTOCOL_VERSION,
            "terminal_acceptance_required": True,
            "attempt_id": attempt_id,
            "contract_hash": contract_hash,
            "instance_id": refreshed["instance_id"],
            "session_id": refreshed["session_id"],
            "binding_generation": binding_generation,
            "fencing_generation": fencing_generation,
        },
    )
    return refreshed


def visible_tasks(root: Path, worker_id: str | None = None, *, runs_root_override: Path | None = None) -> list[dict[str, Any]]:
    base = runs_root_override or visible_runs_root(root)
    tasks: list[dict[str, Any]] = []
    if not base.is_dir():
        return tasks
    scope_worker = safe_id(worker_id, "worker") if worker_id else ""
    for run_dir in sorted(path for path in base.iterdir() if path.is_dir() and path.name != "_locks"):
        tasks_dir = run_dir / "tasks"
        if not tasks_dir.is_dir():
            continue
        for tdir in sorted(path for path in tasks_dir.iterdir() if path.is_dir()):
            if scope_worker and visible_task_state.owner_backend_for_task(tdir)[0] != scope_worker:
                continue
            truth = task_truth(root, run_dir.name, tdir.name, runs_root=base)
            owner = str(truth.get("owner", ""))
            tasks.append({
                "run": run_dir.name,
                "task": tdir.name,
                "path": rel(tdir, root),
                "status": truth.get("protocol_terminal_state"),
                "reason": truth.get("state_reason"),
                "terminal_markers": truth.get("terminal_markers", []),
                "flow_markers": truth.get("flow_markers", []),
                "report_exists": bool(truth.get("report_bytes")),
                "report_nonempty": bool(truth.get("report_nonempty")),
                "report_bytes": truth.get("report_bytes", 0),
                "owner": owner,
                "backend": truth.get("backend", ""),
                "updated_at": truth.get("last_event_ts", ""),
                "protocol_terminal_state": truth.get("protocol_terminal_state"),
                "lock_state": truth.get("lock_state"),
            })
    return tasks


def current_locks(root: Path, worker_id: str | None = None, *, runs_root_override: Path | None = None) -> list[dict[str, Any]]:
    base = (runs_root_override or visible_runs_root(root)) / "_locks"
    if not base.is_dir():
        return []
    locks: list[dict[str, Any]] = []
    scope_worker = safe_id(worker_id, "worker") if worker_id else ""
    for path in sorted(base.glob("*.lock.json")):
        data = read_json(path)
        if scope_worker and str(data.get("worker_id", "")) != scope_worker:
            continue
        data["path"] = rel(path, root)
        locks.append(data)
    return locks


def command_default_worker(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    backend = getattr(args, "backend", RUNTIME_BACKEND)
    worker, readiness = default_worker_rebind_readiness(root, backend=backend)
    if not readiness.get("rebind_ok"):
        print("worker_id: none")
        print(f"stale_default_worker: {worker.get('worker_id')}")
        print(f"runtime_backend: {backend}")
        print(f"rebind_status: {readiness.get('rebind_status')}")
        return 1
    print(f"worker_id: {worker.get('worker_id')}")
    print(f"runtime_backend: {backend}")
    print("source: .omx/framework/team/opencode_visible_workers.json default_for_new_tasks=true")
    print(f"pane: {worker.get('pane_id')}")
    print(f"port: {worker.get('port')}")
    print(f"binding_confidence: {worker.get('binding_confidence')}")
    print(f"allow_auto_submit: {str(bool(worker.get('allow_auto_submit'))).lower()}")
    print(f"default_for_new_tasks: {str(bool(worker.get('default_for_new_tasks'))).lower()}")
    print(f"status: {worker.get('status')}")
    return 0


def command_preflight(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    backend = getattr(args, "backend", RUNTIME_BACKEND)
    requested_worker_id = str(getattr(args, "worker", "") or "").strip()
    worker_scope = "explicit" if requested_worker_id else "default"
    errors: list[str] = []
    warnings: list[str] = []
    try:
        ensure_state_team_clean(root)
    except DispatchError as exc:
        errors.append(str(exc))
    if not adapter_path(root).is_file():
        errors.append(f"missing adapter: {rel(adapter_path(root), root)}")
    try:
        worker, _scope = resolve_dispatch_worker(
            root,
            requested_worker_id or None,
            backend=backend,
        )
        verify = verify_worker(root, str(worker["worker_id"]), backend=backend)
        if str(worker.get("backend") or "") == "codex_tui":
            codex_verified = load_codex_adapter_module(root).verify_binding(
                root, str(worker["worker_id"])
            )
            if codex_verified.get("binding_confidence") != "strong":
                raise DispatchError(
                    "codex binding verification failed: "
                    + json.dumps(codex_verified.get("checks") or {},
                                 default=str)
                )
        else:
            endpoint_schema(root, int(worker["port"]))
        lock = resolve_lock(root, str(worker["worker_id"]), auto_release_terminal=False)
        if lock.get("active"):
            errors.append(f"active_task_exists for {worker['worker_id']}: {lock.get('path')}")
        if lock.get("released_stale_terminal"):
            warnings.append(f"released stale terminal lock: {lock.get('archive')}")
        binding = verify["binding"]
    except DispatchError as exc:
        worker = {}
        binding = {}
        errors.append(str(exc))
    try:
        visible_runs_root(root).mkdir(parents=True, exist_ok=True)
    except Exception as exc:
        errors.append(f"cannot create visible-runs: {exc}")
    watch_dir = watcher_root(root)
    if watch_dir.exists():
        if not os.access(watch_dir, os.W_OK):
            errors.append(f"watcher directory is not writable: {rel(watch_dir, root)}")
    elif not os.access(visible_runs_root(root), os.W_OK):
        errors.append(f"watcher parent is not writable: {rel(visible_runs_root(root), root)}")

    print(f"root: {root}")
    print(f"visible_runs: {visible_runs_root(root)}")
    print(f"watcher_root: {watch_dir}")
    print(f"worker_scope: {worker_scope}")
    if requested_worker_id:
        print(f"requested_worker: {requested_worker_id}")
    else:
        print(f"default_worker: {worker.get('worker_id', '-')}")
    print(f"runtime_backend: {backend}")
    print(f"pane: {worker.get('pane_id', '-')}")
    print(f"port: {worker.get('port', '-')}")
    print(f"binding_confidence: {binding.get('binding_confidence', worker.get('binding_confidence', '-'))}")
    print(f"allow_auto_submit: {str(bool(worker.get('allow_auto_submit'))).lower()}")
    print(f"active_lock: {'yes' if any('active_task_exists' in item for item in errors) else 'no'}")
    if errors:
        print("preflight: error")
        for item in errors:
            print(f"  - {item}")
        return 1
    print("preflight: ok")
    if warnings:
        print("Warnings:")
        for item in warnings:
            print(f"  - {item}")
    return 0


def inspect_locks_readonly(root: Path, worker_id: str | None = None) -> list[dict[str, Any]]:
    return diagnose_worker_locks(root, worker_id=worker_id)


def protocol_receipt_state(truth: dict[str, Any]) -> str:
    if truth.get("has_submitted") and not truth.get("has_received"):
        return "submitted_without_received"
    if truth.get("has_received") and not truth.get("has_started"):
        return "received_without_started"
    if truth.get("has_started") or truth.get("has_heartbeat"):
        return "started"
    if truth.get("has_submitted"):
        return "submitted"
    return ""


def missing_protocol_evidence(truth: dict[str, Any]) -> list[str]:
    missing: list[str] = []
    if not truth.get("has_received"):
        missing.append(".received")
    if not truth.get("has_started"):
        missing.append(".started")
    if not truth.get("has_heartbeat"):
        missing.append(".heartbeat")
    if not truth.get("report_nonempty"):
        missing.append("report.md")
    return missing


def recovery_handshake_observation(
    root: Path,
    run: str,
    task: str,
    *,
    progress_at: str = "",
) -> dict[str, Any]:
    path = task_dir(root, run, task) / "recovery_handshake.json"
    data = read_json(path)
    if not data:
        return {}
    status = str(data.get("status") or "")
    timestamp_text = str(
        data.get("submitted_at")
        or data.get("failed_at")
        or data.get("prepared_at")
        or ""
    )
    def parse_timestamp(value: str) -> datetime | None:
        if not value:
            return None
        try:
            parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
            if parsed.tzinfo is None:
                parsed = parsed.replace(tzinfo=timezone.utc)
            return parsed
        except ValueError:
            return None

    observed_at = parse_timestamp(timestamp_text)
    if observed_at is None:
        try:
            observed_at = datetime.fromtimestamp(path.stat().st_mtime, timezone.utc)
        except OSError:
            observed_at = None
    progress_timestamp = parse_timestamp(progress_at)
    progress_after_handshake = bool(
        observed_at is not None
        and progress_timestamp is not None
        and progress_timestamp > observed_at
    )
    effective_observed_at = (
        progress_timestamp
        if progress_after_handshake and progress_timestamp is not None
        else observed_at
    )
    age_seconds = 0
    if effective_observed_at is not None:
        age_seconds = max(
            0,
            int(
                (
                    datetime.now(timezone.utc) - effective_observed_at
                ).total_seconds()
            ),
        )
    timed_out = (
        status in {"prepared", "submitted"}
        and age_seconds >= RECOVERY_HANDSHAKE_STALL_SECONDS
    )
    return {
        "path": rel(path, root),
        "status": status,
        "recovery_attempt": nonnegative_int(data.get("recovery_attempt")),
        "observed_at": timestamp_text,
        "age_seconds": age_seconds,
        "timed_out": timed_out,
        "progress_at": progress_at,
        "progress_after_handshake": progress_after_handshake,
    }


def current_tmux_server_pid() -> int:
    result = run_command(
        ["tmux", "display-message", "-p", "#{pid}"],
        Path("."),
        timeout=5,
    )
    if result.get("returncode") != 0 or result.get("timed_out"):
        return 0
    try:
        return max(0, int(str(result.get("stdout") or "").strip()))
    except (TypeError, ValueError):
        return 0


def _recorded_process_alive(
    pid: int,
    expected_start_time_ticks: int,
) -> bool:
    if pid <= 0:
        return False
    if not (Path("/proc") / str(pid)).exists():
        return False
    observed_start_time_ticks = process_start_time_ticks(pid)
    if (
        expected_start_time_ticks <= 0
        or observed_start_time_ticks <= 0
    ):
        # Unmeasured identity on either side (unknown expected ticks or a
        # failed /proc read) is not measured PID reuse; treat as alive.
        return True
    return (
        observed_start_time_ticks
        == expected_start_time_ticks
    )


def owner_instance_gone_evidence(
    item: dict[str, Any],
) -> dict[str, Any]:
    lock_host_boot_id = str(item.get("host_boot_id") or "")
    current_boot_id = current_host_boot_id()
    host_boot_id_mismatch = bool(
        lock_host_boot_id
        and current_boot_id
        and lock_host_boot_id != current_boot_id
    )
    lock_tmux_server_pid = nonnegative_int(
        item.get("tmux_server_pid")
    )
    current_server_pid = (
        current_tmux_server_pid()
        if lock_tmux_server_pid > 0 and lock_host_boot_id
        else 0
    )
    tmux_server_generation_changed = bool(
        lock_host_boot_id
        and current_boot_id
        and lock_host_boot_id == current_boot_id
        and lock_tmux_server_pid > 0
        and current_server_pid > 0
        and lock_tmux_server_pid != current_server_pid
    )
    recorded_pids = {
        pid
        for pid in (
            nonnegative_int(item.get("opencode_pid")),
            *(
                nonnegative_int(value)
                for value in (
                    item.get("listener_pids")
                    if isinstance(item.get("listener_pids"), list)
                    else []
                )
            ),
            *(
                nonnegative_int(value)
                for value in (
                    item.get("opencode_pids")
                    if isinstance(item.get("opencode_pids"), list)
                    else []
                )
            ),
        )
        if pid > 0
    }
    recorded_opencode_pid = nonnegative_int(item.get("opencode_pid"))
    recorded_opencode_start_ticks = nonnegative_int(
        item.get("opencode_start_time_ticks")
    )

    def _expected_ticks_for(pid: int) -> int:
        return (
            recorded_opencode_start_ticks
            if pid == recorded_opencode_pid
            and recorded_opencode_start_ticks > 0
            else 0
        )

    measured_alive = {
        pid: _recorded_process_alive(pid, _expected_ticks_for(pid))
        for pid in recorded_pids
    }
    recorded_processes_absent = bool(
        recorded_pids and not any(measured_alive.values())
    )
    recorded_processes_live = bool(
        recorded_pids and any(measured_alive.values())
    )
    # The pid+start-ticks liveness boundary is only meaningful within one
    # host boot: across boots the recorded generation is gone by definition
    # and a matching pid number is mere reuse. A changed tmux server
    # generation alone never proves the recorded OpenCode process died, so
    # there the owner is gone only with measured positive evidence that
    # every recorded process is gone; an empty or unreadable recorded pid
    # set cannot satisfy that fact.
    owner_generation_gone = bool(
        host_boot_id_mismatch
        or (
            tmux_server_generation_changed
            and recorded_processes_absent
        )
    )
    return {
        "owner_instance_gone": owner_generation_gone,
        "host_boot_id_mismatch": host_boot_id_mismatch,
        "tmux_server_generation_changed": tmux_server_generation_changed,
        "recorded_processes_absent": recorded_processes_absent,
        "recorded_processes_live": recorded_processes_live,
        "lock_host_boot_id": lock_host_boot_id,
        "current_host_boot_id": current_boot_id,
        "lock_tmux_server_pid": lock_tmux_server_pid,
        "current_tmux_server_pid": current_server_pid,
        "lock_instance_id": str(item.get("instance_id") or ""),
        "lock_pane_id": str(item.get("pane_id") or ""),
        "lock_pane_pid": nonnegative_int(item.get("pane_pid")),
        "lock_opencode_pid": recorded_opencode_pid,
        "lock_port": nonnegative_int(item.get("port")),
        "lock_binding_generation": nonnegative_int(
            item.get("binding_generation")
        ),
        "lock_fencing_generation": nonnegative_int(
            item.get("fencing_generation")
        ),
    }


def diagnose_lock_item(root: Path, item: dict[str, Any]) -> dict[str, Any]:
    worker_id = str(item.get("worker_id") or "")
    run = str(item.get("run", ""))
    task = str(item.get("task", ""))
    truth: dict[str, Any] = {}
    diagnosis = "active_unknown"
    severity = "warning"
    recommended_action = "inspect_worker_status"
    safe_command = settle_latest_command(worker_id) if worker_id else ""
    reason = "lock exists but task state could not be classified"
    if not run or not task:
        return {
            **item,
            "run_id": run,
            "task_id": task,
            "state": "",
            "task_truth": truth,
            "terminal": False,
            "diagnosis": "missing_run_or_task",
            "severity": "error",
            "recommended_action": "inspect_lock_file",
            "safe_command": "",
            "reason": "lock file is missing run/task metadata",
        }
    try:
        truth = task_truth(root, run, task)
    except DispatchError as exc:
        return {
            **item,
            "run_id": run,
            "task_id": task,
            "state": "invalid_lock_reference",
            "task_truth": {"protocol_terminal_state": "invalid_lock_reference", "state_reason": str(exc)},
            "terminal": False,
            "diagnosis": "invalid_lock_reference",
            "severity": "error",
            "recommended_action": "inspect_lock_reference",
            "safe_command": "",
            "reason": str(exc),
        }

    state = str(truth.get("protocol_terminal_state") or "")
    receipt_state = protocol_receipt_state(truth)
    protocol_missing = missing_protocol_evidence(truth) if state in NONTERMINAL_PROTOCOL_STATES else []
    safe_handling = ""
    operator_recovery_command = ""
    required_session_action = ""
    required_rotation_reason = ""
    summary_data = truth.get("summary_data", {}) if isinstance(truth.get("summary_data"), dict) else {}
    pending_after_timeout = bool(
        summary_data.get("pending_after_timeout")
        or summary_data.get("run_one_exit_state") == "pending_after_timeout"
    )
    summary_needs_settle = bool(
        summary_data.get("needs_settle")
        or str(summary_data.get("next_safe_action") or "").startswith("./bin/omx_visible_dispatch settle ")
    )
    flow_markers = [str(value) for value in truth.get("flow_markers") or []]
    has_heartbeat_evidence = bool(truth.get("has_heartbeat")) or "heartbeat" in flow_markers
    report_missing = not bool(truth.get("report_nonempty")) and nonnegative_int(truth.get("report_bytes")) == 0
    stale_heartbeat_without_report = (
        state == "running"
        and has_heartbeat_evidence
        and report_missing
        and bool(pending_after_timeout or summary_needs_settle)
    )
    stale_started_without_heartbeat = (
        state == "running"
        and receipt_state == "started"
        and not has_heartbeat_evidence
        and report_missing
        and bool(pending_after_timeout or summary_needs_settle)
    )
    report_without_terminal_marker_stale = (
        state == "running"
        and bool(truth.get("report_nonempty"))
        and not bool(truth.get("terminal_markers"))
        and bool(pending_after_timeout or summary_needs_settle)
    )
    sidecar_progress_recent = (
        state == "running"
        and report_missing
        and bool(truth.get("sidecar_progress_recent"))
    )
    reviewer_call_in_flight = sidecar_progress_recent
    recovery_handshake = recovery_handshake_observation(
        root,
        run,
        task,
        progress_at=str(truth.get("last_event_ts") or ""),
    )
    owner_gone = owner_instance_gone_evidence(item)
    provider_nonretryable = bool(
        truth.get("provider_error_detected")
        and not truth.get("provider_error_retryable")
        and state == "blocked_provider_error"
    )
    provider_quarantine_eligible = bool(
        provider_nonretryable
        and truth.get("provider_error_quarantine_eligible")
    )
    provider_continuation_eligible = bool(
        provider_nonretryable
        and truth.get("provider_error_continuation_eligible")
    )
    provider_hard_blocked = bool(
        provider_nonretryable
        and not provider_continuation_eligible
    )

    def classify_terminal_truth_bucket(truth: dict[str, Any]) -> str:
        terminal_state = str(truth.get("protocol_terminal_state") or "").strip()
        markers = [str(value).strip() for value in truth.get("terminal_markers", []) if str(value).strip()]
        report_nonempty = bool(truth.get("report_nonempty"))
        if len(markers) > 1:
            return "terminal_protocol_conflict"
        if terminal_state in {"blocked", "failed"} and len(markers) == 1 and report_nonempty:
            return "terminal_expected_non_success"
        if terminal_state == "completed" and len(markers) == 1 and report_nonempty:
            return "terminal_success"
        return ""

    terminal_bucket = classify_terminal_truth_bucket(truth)
    if truth.get("lock_state") == "stale_terminal_lock":
        if terminal_bucket == "terminal_protocol_conflict":
            diagnosis = "terminal_protocol_conflict"
            severity = "error"
            recommended_action = "manual_protocol_review"
            safe_command = ""
            reason = "task has conflicting terminal markers and requires manual review"
        elif terminal_bucket == "terminal_expected_non_success":
            diagnosis = "terminal_expected_non_success"
            severity = "warning"
            recommended_action = "settle_terminal_lock"
            safe_command = settle_command_for(run, task)
            reason = "task ended in an expected non-success terminal state but worker lock still exists"
        else:
            diagnosis = "terminal_stale_lock"
            severity = "warning"
            recommended_action = "settle_terminal_lock"
            safe_command = settle_command_for(run, task)
            reason = "task is terminal but worker lock still exists"
    elif state == "submit_failed":
        diagnosis = "submit_failed_lock"
        severity = "warning"
        recommended_action = "settle_submit_failed_lock"
        safe_command = settle_command_for(run, task)
        reason = "submit failed and settle can reconcile the lock"
    elif state in INVALID_TERMINAL_STATES:
        diagnosis = "invalid_terminal_state"
        severity = "error"
        recommended_action = "inspect_invalid_terminal_state"
        safe_command = ""
        reason = str(truth.get("state_reason") or state)
    elif item.get("status") == "reset_recovery_reserved":
        diagnosis = "reset_recovery_reserved"
        severity = "attention"
        recommended_action = (
            "resume_or_cancel_unconsumed_reset_recovery"
        )
        safe_command = ""
        reservation_id = str(item.get("owner_lock_id") or "")
        target_run_root = str(item.get("target_run_root") or "")
        if worker_id and reservation_id and target_run_root:
            operator_recovery_command = (
                "./bin/omx_visible_dispatch cancel-reset-recovery "
                f"--root . --worker {worker_id} "
                f"--run {run} --task {task} "
                f"--reservation-id {reservation_id} "
                "--target-run-root "
                f"{shlex.quote(target_run_root)} "
                "--allow-unconsumed-cancel "
                "--reason reviewed_pre_dispatch_recovery_abandonment"
            )
        safe_handling = (
            "resume_exact_target_or_cancel_only_if_abandoning_"
            "before_dispatch"
        )
        reason = (
            "worker capacity is reserved for the exact recovered first "
            "dispatch and may be cancelled only while unconsumed"
        )
    elif (
        state in NONTERMINAL_PROTOCOL_STATES
        and owner_gone.get("owner_instance_gone")
    ):
        diagnosis = "nonterminal_owner_instance_gone"
        severity = "attention"
        recommended_action = (
            "review_exact_old_owner_then_quarantine"
            if owner_gone.get("host_boot_id_mismatch")
            else "review_strong_replacement_then_quarantine"
        )
        safe_command = ""
        operator_recovery_command = (
            "./bin/omx_visible_dispatch quarantine-lock --root . "
            f"--worker {worker_id} --run {run} --task {task} "
            "--allow-nonterminal-quarantine "
            "--reason reviewed_reboot_stale_owner_instance"
        )
        safe_handling = (
            "preserve_protocol_truth_archive_exact_cross_boot_owner_only"
            if owner_gone.get("host_boot_id_mismatch")
            else "preserve_protocol_truth_quarantine_lock_only_after_"
            "strong_replacement_review"
        )
        if provider_hard_blocked:
            required_session_action = "rotate"
            required_rotation_reason = "context_contaminated"
            safe_handling += (
                "_then_rotate_contaminated_session"
            )
        reason = (
            "the nonterminal owner lock belongs to a previous host boot "
            "and that process instance cannot still complete"
            if owner_gone.get("host_boot_id_mismatch")
            else "the same-boot tmux generation changed and recorded processes are absent; "
            "strong replacement review is still required"
        )
    elif provider_hard_blocked:
        diagnosis = "provider_error_blocked_lock"
        severity = "error"
        safe_command = ""
        required_session_action = "rotate"
        required_rotation_reason = "context_contaminated"
        safe_handling = (
            "preserve_evidence_do_not_retry_same_session_"
            "quarantine_then_rotate"
        )
        if provider_quarantine_eligible:
            recommended_action = (
                "manual_operator_review_then_quarantine_and_rotate"
            )
            operator_recovery_command = (
                "./bin/omx_visible_dispatch quarantine-lock --root . "
                f"--worker {worker_id} --run {run} --task {task} "
                "--allow-nonterminal-quarantine "
                "--reason reviewed_nonretryable_provider_error"
            )
        else:
            recommended_action = (
                "collect_task_bound_session_provider_evidence"
            )
            operator_recovery_command = ""
        reason = (
            "a task-bound non-retryable provider error contaminated the "
            "owning session: "
            f"{truth.get('provider_error_kind') or 'provider_error'}"
        )
    elif recovery_handshake.get("status") == "prepared":
        safe_command = ""
        operator_recovery_command = ""
        safe_handling = "preserve_owner_lock_do_not_submit_second_recovery"
        if recovery_handshake.get("timed_out"):
            diagnosis = "recovery_handshake_prepared_stalled"
            severity = "error"
            recommended_action = "manual_operator_review_recovery_timeout"
            reason = (
                "the one-shot recovery claim remained prepared without a "
                "submission result beyond the recovery timeout"
            )
        else:
            diagnosis = "recovery_handshake_prepared"
            severity = "attention"
            recommended_action = "wait_for_recovery_submission_result"
            reason = (
                "the one-shot recovery claim is prepared and submission "
                "completion is still pending"
            )
    elif recovery_handshake.get("status") == "submitted":
        safe_command = ""
        operator_recovery_command = ""
        safe_handling = "preserve_owner_lock_do_not_submit_second_recovery"
        if recovery_handshake.get("timed_out"):
            diagnosis = "recovery_handshake_stalled"
            severity = "error"
            recommended_action = "manual_operator_review_recovery_timeout"
            if provider_quarantine_eligible:
                recommended_action = (
                    "manual_operator_review_then_quarantine_recovery_timeout"
                )
                operator_recovery_command = (
                    "./bin/omx_visible_dispatch quarantine-lock --root . "
                    f"--worker {worker_id} --run {run} --task {task} "
                    "--allow-nonterminal-quarantine "
                    "--allow-reviewed-recovery-timeout-quarantine "
                    "--reason reviewed_recovery_timeout_provider_interruption"
                )
                required_session_action = "rotate"
                required_rotation_reason = "context_contaminated"
                safe_handling = (
                    "preserve_protocol_truth_quarantine_after_review_"
                    "then_rotate_contaminated_session"
                )
            reason = (
                "the one authorized recovery handshake produced no fresh "
                "terminal truth before the recovery timeout"
            )
        else:
            diagnosis = "recovery_handshake_pending"
            severity = "attention"
            recommended_action = "wait_for_recovery_progress"
            reason = (
                "the one authorized recovery handshake is submitted and "
                "still within the recovery observation window"
            )
    elif recovery_handshake.get("status") == "submitted_session_unverified":
        diagnosis = "recovery_handshake_session_unverified"
        severity = "error"
        recommended_action = (
            "manual_operator_closeout_via_close_interrupted_task"
        )
        safe_command = ""
        operator_recovery_command = interrupted_recovery_command_for(
            run,
            task,
            "recovery_handshake_session_unverified",
        )
        safe_handling = "preserve_owner_lock_do_not_submit_second_recovery"
        reason = (
            "the one authorized recovery handshake transport was submitted "
            "but the fenced live session was not verified after delivery; "
            "same-session recovery is unproven"
        )
    elif recovery_handshake.get("status") == "submission_failed":
        diagnosis = "recovery_handshake_submission_failed"
        severity = "error"
        recommended_action = "manual_operator_review_recovery_failure"
        safe_command = ""
        operator_recovery_command = ""
        safe_handling = "preserve_owner_lock_do_not_submit_second_recovery"
        reason = "the one authorized recovery handshake failed during submission"
    elif provider_continuation_eligible and not truth.get("has_started"):
        diagnosis = "delivery_uncertain_provider_error"
        severity = "attention"
        safe_command = ""
        if receipt_state == "submitted_without_received":
            recommended_action = (
                "wait_for_worker_receipt_or_user_authorized_recovery"
            )
            recovery_reason = (
                "submitted_without_received_provider_error_"
                "user_authorized_recovery"
            )
        else:
            recommended_action = (
                "wait_or_user_authorized_recovery_received_not_started"
            )
            recovery_reason = (
                "received_without_started_provider_error_"
                "user_authorized_recovery"
            )
        operator_recovery_command = interrupted_recovery_command_for(
            run,
            task,
            recovery_reason,
        )
        safe_handling = (
            "do_not_resend_do_not_press_enter_do_not_settle_active_lock"
        )
        reason = (
            "the exact task session ended before .started; use only the "
            "guarded interrupted-task closeout path"
        )
        truth["provider_error_next_safe_action"] = recommended_action
    elif provider_continuation_eligible:
        diagnosis = "provider_interruption_recoverable"
        severity = "attention"
        recommended_action = "owner_preserving_recovery_handshake"
        safe_command = ""
        required_session_action = "recovery"
        if worker_id and truth.get("has_started"):
            operator_recovery_command = recovery_handshake_command_for(
                worker_id,
                run,
                task,
            )
        safe_handling = (
            "preserve_owner_lock_submit_one_recovery_handshake"
        )
        reason = (
            "the exact task-bound background child ended with a terminal "
            "zero-output provider error and is eligible for one fenced recovery"
            if truth.get("background_child_failure_continuation_eligible")
            else (
                "the exact task session ended with a zero-token provider "
                "finish interruption and is eligible for one fenced recovery"
            )
        )
    elif (
        truth.get("provider_error_detected")
        and str(truth.get("provider_error_kind") or "")
        == "provider_spending_limit"
        and state in {"running", "received"}
    ):
        # #789: a replenishable quota blockage on a started/received owner
        # task never demands rotation, quarantine, or a recovery handshake.
        diagnosis = "running_provider_error"
        severity = "attention"
        recommended_action = "replenish_quota_then_observe_same_owner"
        safe_command = ""
        operator_recovery_command = ""
        required_session_action = ""
        safe_handling = (
            "preserve_owner_lock_do_not_redispatch_wait_for_quota_"
            "replenishment"
        )
        reason = (
            "a replenishable provider spending-limit blockage stopped the "
            "current request of the started owner task without protocol "
            "completion; preserve owner/task/attempt/session and wait for "
            "quota replenishment or user-confirmed continuation on the same "
            "attempt (no automatic resumption): "
            f"{truth.get('provider_error_kind') or 'provider_error'}"
        )
    elif (
        truth.get("provider_error_detected")
        and truth.get("provider_error_retryable")
        and state in {"running", "received"}
    ):
        diagnosis = "running_provider_error"
        severity = "attention"
        recommended_action = "owner_preserving_recovery_or_manual_continue"
        safe_command = ""
        if worker_id and truth.get("has_started"):
            operator_recovery_command = recovery_handshake_command_for(
                worker_id,
                run,
                task,
            )
        safe_handling = "preserve_owner_lock_do_not_redispatch"
        reason = (
            "a retryable provider error was observed for the active owner task: "
            f"{truth.get('provider_error_kind') or 'provider_error'}"
        )
    elif stale_heartbeat_without_report and reviewer_call_in_flight:
        diagnosis = "active_inner_reviewer_progress"
        severity = "attention"
        recommended_action = "wait_for_reviewer_sidecar_progress"
        safe_command = ""
        safe_handling = "do_not_resend_do_not_press_enter_do_not_settle_active_lock"
        reason = "task-local reviewer sidecars are newer than protocol heartbeat; preserve ownership and keep waiting"
    elif stale_heartbeat_without_report:
        diagnosis = "nonterminal_heartbeat_stale"
        severity = "attention"
        recommended_action = "manual_operator_review_or_quarantine_nonterminal_task"
        safe_command = ""
        if worker_id:
            operator_recovery_command = recovery_handshake_command_for(worker_id, run, task)
        safe_handling = "do_not_resend_do_not_press_enter_do_not_settle_active_lock"
        reason = "task heartbeated but did not produce terminal truth or report.md before the leader timeout"
    elif stale_started_without_heartbeat and reviewer_call_in_flight:
        diagnosis = "active_inner_reviewer_progress"
        severity = "attention"
        recommended_action = "wait_for_reviewer_sidecar_progress"
        safe_command = ""
        safe_handling = "do_not_resend_do_not_press_enter_do_not_settle_active_lock"
        reason = "task-local reviewer sidecars are newer than protocol status; preserve ownership and keep waiting"
    elif stale_started_without_heartbeat:
        diagnosis = "started_without_heartbeat_stale"
        severity = "attention"
        recommended_action = "manual_operator_review_or_quarantine_nonterminal_task"
        safe_command = ""
        if worker_id:
            operator_recovery_command = recovery_handshake_command_for(worker_id, run, task)
        safe_handling = "do_not_resend_do_not_press_enter_do_not_settle_active_lock"
        reason = "task started but did not heartbeat, produce terminal truth, or report.md before the leader timeout"
    elif report_without_terminal_marker_stale:
        diagnosis = "report_without_terminal_marker_stale"
        severity = "attention"
        recommended_action = "owner_recovery_preserve_lock"
        safe_command = ""
        if worker_id:
            operator_recovery_command = recovery_handshake_command_for(worker_id, run, task)
        safe_handling = "owner_recovery_only_do_not_quarantine_active_lock"
        reason = "task produced report.md but no terminal marker before the leader timeout"
        if _reviewed_session_drift_eligible(task_dir(root, run, task)):
            recommended_action = (
                "manual_operator_closeout_via_close_interrupted_task"
            )
            operator_recovery_command = interrupted_recovery_command_for(
                run,
                task,
                "finish_refused_session_drift",
            )
            reason = (
                "task produced report.md but finish was refused by the "
                "acceptance fence; use the existing close-interrupted-task "
                "entry (it preserves the report, records blocked/fail, and "
                "archives the owner lock after its activity cooldown)"
            )
    elif pending_after_timeout or summary_needs_settle:
        diagnosis = "needs_settle_lock"
        severity = "warning"
        recommended_action = "observe_or_manual_review_pending_task"
        safe_command = ""
        safe_handling = "do_not_settle_active_nonterminal_lock"
        reason = (
            "previous run recorded needs_settle or pending_after_timeout; "
            "the owner lock is nonterminal, so settle is not permitted "
            "while ownership is preserved"
        )
    elif state == "blocked_context_compaction_review" or truth.get("context_compaction_detected"):
        diagnosis = "context_compaction_review_lock"
        severity = "attention"
        recommended_action = "manual_operator_review_context_compaction"
        safe_command = ""
        safe_handling = "do_not_resend_do_not_press_enter_do_not_settle_active_lock"
        reason = str(truth.get("state_reason") or "OpenCode context compaction evidence detected without terminal truth")
    elif state == "blocked_context_overflow" or truth.get("context_overflow_detected"):
        diagnosis = "context_overflow_blocked_lock"
        severity = "attention"
        recommended_action = "manual_operator_review_context_overflow"
        safe_command = ""
        safe_handling = "do_not_resend_do_not_press_enter_do_not_settle_active_lock"
        reason = str(truth.get("state_reason") or "OpenCode context window overflow detected after submission")
    elif state == "verbal_terminal_without_protocol_signal" or truth.get("verbal_terminal_sentinel_detected"):
        diagnosis = "verbal_terminal_without_protocol_signal"
        severity = "attention"
        recommended_action = "manual_operator_review_or_recovery_handshake"
        safe_command = ""
        if worker_id:
            operator_recovery_command = recovery_handshake_command_for(worker_id, run, task)
        safe_handling = "do_not_resend_do_not_press_enter_do_not_settle_active_lock"
        reason = str(truth.get("state_reason") or "visible OMX_TASK_CLOSED line detected without protocol truth")
    elif (
        state == "delivery_uncertain_provider_error"
        and str(truth.get("provider_error_kind") or "")
        == "provider_spending_limit"
    ):
        # #789: submitted-only quota blockage has no handshake path (the
        # worker never received/started); only replenish-and-observe or the
        # user-authorized interrupted-task closeout.
        diagnosis = "delivery_uncertain_provider_error"
        severity = "attention"
        recommended_action = "replenish_quota_then_observe_same_owner"
        safe_command = ""
        operator_recovery_command = ""
        required_session_action = ""
        safe_handling = (
            "preserve_owner_lock_do_not_redispatch_wait_for_quota_"
            "replenishment"
        )
        reason = (
            "a replenishable provider spending-limit blockage stopped the "
            "request while the attempt is submitted-only without .received/"
            ".started; preserve owner/task/attempt/session, replenish the "
            "quota and observe, and use only the user-authorized "
            "close-interrupted-task closeout if abandoning (no automatic "
            "resumption): "
            f"{truth.get('provider_error_kind') or 'provider_error'}"
        )
    elif state == "delivery_uncertain_provider_error":
        diagnosis = "delivery_uncertain_provider_error"
        severity = "attention"
        recommended_action = "manual_continue_required"
        safe_command = ""
        operator_recovery_command = ""
        safe_handling = (
            "preserve_owner_lock_do_not_redispatch_manual_continue_only"
        )
        reason = str(truth.get("state_reason") or state)
    elif state == "delivery_uncertain" and truth.get("submit_interrupted"):
        diagnosis = "submit_interrupted"
        severity = "attention"
        recommended_action = (
            "wait_for_worker_receipt_or_user_authorized_recovery"
        )
        safe_command = ""
        operator_recovery_command = interrupted_recovery_command_for(
            run,
            task,
            "submit_interrupted_user_authorized_recovery",
        )
        safe_handling = "do_not_resend_do_not_press_enter_do_not_settle_active_lock"
        reason = str(truth.get("state_reason") or state)
    elif state == "delivery_uncertain":
        diagnosis = "active_nonterminal_lock"
        severity = "attention"
        recommended_action = "wait_for_worker_receipt_or_user_authorized_recovery"
        safe_command = ""
        if receipt_state == "submitted_without_received":
            operator_recovery_command = interrupted_recovery_command_for(
                run,
                task,
                "submitted_without_received_user_authorized_recovery",
            )
        safe_handling = "do_not_resend_do_not_press_enter_do_not_settle_active_lock"
        reason = str(truth.get("state_reason") or state)
    elif state in {"running", "received", "prepared"}:
        diagnosis = "active_nonterminal_lock"
        severity = "attention"
        recommended_action = (
            "wait_or_user_authorized_recovery_received_not_started"
            if receipt_state == "received_without_started"
            else "wait_or_check_worker_before_reuse"
        )
        safe_command = ""
        recovery_reason = (
            "received_without_started_user_authorized_recovery"
            if receipt_state == "received_without_started"
            else "active_nonterminal_lock_user_authorized_recovery"
        )
        if worker_id and truth.get("has_started"):
            operator_recovery_command = recovery_handshake_command_for(worker_id, run, task)
        else:
            operator_recovery_command = interrupted_recovery_command_for(run, task, recovery_reason)
        safe_handling = "do_not_resend_do_not_press_enter_do_not_settle_active_lock"
        reason = str(truth.get("state_reason") or state)
    else:
        diagnosis = "active_unknown"
        severity = "warning"
        recommended_action = "inspect_worker_status"
        safe_command = settle_latest_command(worker_id) if worker_id else ""
        reason = str(truth.get("state_reason") or state or "unknown")

    if "recovery-handshake" in operator_recovery_command:
        no_send = _task_local_handshake_guidance(
            root, run, task, worker_id
        )
        if no_send is not None:
            operator_recovery_command = ""
            recommended_action = no_send["recommended_action"]
            extra = no_send["reason"]
            reason = f"{reason}; {extra}" if reason else extra
            safe_handling = "preserve_owner_lock_do_not_send_recovery_handshake"

    return {
        **item,
        "run_id": run,
        "task_id": task,
        "state": state,
        "task_truth": truth,
        "terminal": state in VALID_TERMINAL_STATES,
        "diagnosis": diagnosis,
        "severity": severity,
        "recommended_action": recommended_action,
        "safe_command": safe_command,
        "operator_recovery_command": operator_recovery_command,
        "required_session_action": required_session_action,
        "required_rotation_reason": required_rotation_reason,
        "reason": reason,
        "protocol_terminal_state": state,
        "receipt_state": receipt_state,
        "missing_protocol_evidence": protocol_missing,
        "safe_handling": safe_handling,
        "flow_markers": list(truth.get("flow_markers") or []),
        "terminal_markers": list(truth.get("terminal_markers") or []),
        "report_bytes": int(truth.get("report_bytes") or 0),
        "last_event_ts": str(truth.get("last_event_ts") or ""),
        "protocol_freshness_ts": str(truth.get("protocol_freshness_ts") or ""),
        "sidecar_progress_recent": bool(truth.get("sidecar_progress_recent")),
        "latest_sidecar_ts": str(truth.get("latest_sidecar_ts") or ""),
        "latest_sidecar_path": str(truth.get("latest_sidecar_path") or ""),
        "recovery_handshake_status": str(recovery_handshake.get("status") or ""),
        "recovery_handshake_path": str(recovery_handshake.get("path") or ""),
        "recovery_handshake_age_seconds": nonnegative_int(
            recovery_handshake.get("age_seconds")
        ),
        "recovery_handshake_timed_out": bool(
            recovery_handshake.get("timed_out")
        ),
        "recovery_progress_at": str(
            recovery_handshake.get("progress_at") or ""
        ),
        "recovery_progress_after_handshake": bool(
            recovery_handshake.get("progress_after_handshake")
        ),
        "context_overflow_detected": bool(truth.get("context_overflow_detected")),
        "context_overflow_status": str(truth.get("context_overflow_status") or ""),
        "context_overflow_evidence_path": str(truth.get("context_overflow_evidence_path") or ""),
        "context_overflow_next_safe_action": str(truth.get("context_overflow_next_safe_action") or ""),
        "context_compaction_detected": bool(truth.get("context_compaction_detected")),
        "context_compaction_status": str(truth.get("context_compaction_status") or ""),
        "context_compaction_evidence_path": str(truth.get("context_compaction_evidence_path") or ""),
        "context_compaction_next_safe_action": str(truth.get("context_compaction_next_safe_action") or ""),
        "provider_error_detected": bool(truth.get("provider_error_detected")),
        "provider_error_kind": str(truth.get("provider_error_kind") or ""),
        "provider_error_retryable": bool(truth.get("provider_error_retryable")),
        "provider_error_request_id": str(truth.get("provider_error_request_id") or ""),
        "provider_error_status": str(truth.get("provider_error_status") or ""),
        "provider_error_payload_limit_bytes": nonnegative_int(
            truth.get("provider_error_payload_limit_bytes")
        ),
        "provider_error_evidence_path": str(truth.get("provider_error_evidence_path") or ""),
        "provider_error_next_safe_action": str(truth.get("provider_error_next_safe_action") or ""),
        "provider_error_continuation_eligible": bool(
            truth.get("provider_error_continuation_eligible")
        ),
        "verbal_terminal_sentinel_detected": bool(truth.get("verbal_terminal_sentinel_detected")),
        "verbal_terminal_sentinel_state": str(truth.get("verbal_terminal_sentinel_state") or ""),
        "verbal_terminal_sentinel_evidence_path": str(truth.get("verbal_terminal_sentinel_evidence_path") or ""),
        "verbal_terminal_sentinel_next_safe_action": str(truth.get("verbal_terminal_sentinel_next_safe_action") or ""),
        "owner_instance_gone_evidence": owner_gone,
    }


def diagnose_worker_locks(root: Path, worker_id: str | None = None) -> list[dict[str, Any]]:
    locks: list[dict[str, Any]] = []
    for item in current_locks(root, worker_id=worker_id):
        diagnosed = diagnose_lock_item(root, item)
        diagnosed["worker_id_port_suffix_mismatch"] = (
            worker_id_port_suffix_mismatch(
                diagnosed.get("worker_id"),
                diagnosed.get("port"),
            )
        )
        locks.append(diagnosed)
    return locks


def summarize_lock_diagnosis(locks: list[dict[str, Any]]) -> dict[str, Any]:
    counts = Counter(str(item.get("diagnosis") or "unknown") for item in locks)
    blocking = [
        item for item in locks
        if str(item.get("diagnosis") or "") in BLOCKING_LOCK_DIAGNOSES
    ]
    recoverable = [
        item for item in locks
        if str(item.get("diagnosis") or "") in {"terminal_stale_lock", "terminal_expected_non_success", "submit_failed_lock"}
    ]
    return {
        "total": len(locks),
        "counts": dict(sorted(counts.items())),
        "blocking_count": len(blocking),
        "recoverable_count": len(recoverable),
        "blocked_workers": [str(item.get("worker_id") or "") for item in blocking if str(item.get("worker_id") or "")],
        "recoverable_workers": [str(item.get("worker_id") or "") for item in recoverable if str(item.get("worker_id") or "")],
    }


def nonnegative_int(value: Any) -> int:
    try:
        return max(0, int(value))
    except (TypeError, ValueError):
        return 0


def worker_id_port_suffix_mismatch(worker_id: Any, port: Any) -> bool:
    current_port = nonnegative_int(port)
    suffix_match = re.search(r"(\d+)$", str(worker_id or ""))
    return bool(
        current_port
        and suffix_match
        and int(suffix_match.group(1)) != current_port
    )


def watcher_snapshot_status(watcher: dict[str, Any], locks: list[dict[str, Any]]) -> dict[str, Any]:
    if not watcher:
        return {
            "present": False,
            "snapshot_stale": False,
            "conflict": "",
            "watcher_active_lock_count": 0,
            "current_lock_count": len(locks),
        }
    summary = watcher.get("summary", {}) if isinstance(watcher.get("summary"), dict) else {}
    watcher_active_lock_count = nonnegative_int(summary.get("active_lock"))
    current_lock_count = len(locks)
    stale_active_lock = watcher_active_lock_count > 0 and current_lock_count == 0
    return {
        "present": True,
        "snapshot_stale": stale_active_lock,
        "conflict": "active_lock_without_current_lock" if stale_active_lock else "",
        "watcher_active_lock_count": watcher_active_lock_count,
        "current_lock_count": current_lock_count,
        "prefer": "Active locks section" if stale_active_lock else "",
    }


def format_lock_diagnosis_line(item: dict[str, Any]) -> str:
    command = str(item.get("safe_command") or "-")
    worker_id = str(item.get("worker_id") or "-")
    port = nonnegative_int(item.get("port"))
    suffix_mismatch = (
        bool(item.get("worker_id_port_suffix_mismatch"))
        if "worker_id_port_suffix_mismatch" in item
        else worker_id_port_suffix_mismatch(worker_id, port)
    )
    parts = [
        worker_id,
        f"port={port or '-'}",
    ]
    if suffix_mismatch:
        parts.append("worker_id_port_suffix_mismatch=true")
    parts.extend([
        f"diagnosis={item.get('diagnosis') or '-'}",
        f"state={item.get('protocol_terminal_state') or item.get('task_truth', {}).get('protocol_terminal_state') or '-'}",
        f"run={item.get('run') or '-'}",
        f"task={item.get('task') or '-'}",
        f"action={item.get('recommended_action') or '-'}",
        f"command={command}",
    ])
    receipt_state = str(item.get("receipt_state") or "")
    if receipt_state:
        parts.append(f"receipt_state={receipt_state}")
    context_overflow = str(item.get("context_overflow_status") or item.get("task_truth", {}).get("context_overflow_status") or "")
    if context_overflow:
        parts.append(f"context_overflow={context_overflow}")
    context_compaction = str(item.get("context_compaction_status") or item.get("task_truth", {}).get("context_compaction_status") or "")
    if context_compaction:
        parts.append(f"context_compaction={context_compaction}")
    missing = [str(value) for value in item.get("missing_protocol_evidence", []) if str(value)]
    if missing:
        parts.append(f"missing_protocol_evidence={','.join(missing)}")
    latest_sidecar = str(item.get("latest_sidecar_path") or "")
    latest_sidecar_ts = str(item.get("latest_sidecar_ts") or "")
    if item.get("sidecar_progress_recent"):
        parts.append("sidecar_progress_recent=true")
    if latest_sidecar_ts:
        parts.append(f"latest_sidecar_ts={latest_sidecar_ts}")
    if latest_sidecar:
        parts.append(f"latest_sidecar_path={latest_sidecar}")
    safe_handling = str(item.get("safe_handling") or "")
    if safe_handling:
        parts.append(f"safe_handling={safe_handling}")
    recovery_command = str(item.get("operator_recovery_command") or "")
    if recovery_command:
        parts.append(f"operator_recovery_command={recovery_command}")
    no_send_reason = str(item.get("reason") or "")
    if (
        str(item.get("safe_handling") or "")
        == "preserve_owner_lock_do_not_send_recovery_handshake"
        and no_send_reason
    ):
        parts.append(f"reason={no_send_reason}")
    return " ".join(parts)


def worker_ids_from_values(values: Any) -> list[str]:
    if not isinstance(values, (list, tuple, set)):
        return []
    worker_ids: list[str] = []
    for value in values:
        if isinstance(value, dict):
            worker_id = str(value.get("worker_id") or "").strip()
        elif isinstance(value, str):
            worker_id = value.strip()
        else:
            worker_id = ""
        if worker_id and worker_id not in worker_ids:
            worker_ids.append(worker_id)
    return worker_ids


def registry_only_pool_snapshot(root: Path) -> dict[str, Any]:
    registry_warning = ""
    try:
        workers = dispatchable_visible_workers(root)
    except DispatchError as exc:
        workers = []
        registry_warning = str(exc)
    worker_ids = worker_ids_from_values(workers)
    return {
        "registry_warning": registry_warning,
        "registry_qualified_workers": workers,
        "pool_rows": [
            {
                "worker_id": worker_id,
                "dispatch_state": "rebind_check_unknown",
                "rebind_status": "rebind_check_not_requested",
                "rebind_skipped": True,
            }
            for worker_id in worker_ids
        ],
        "dispatchable_workers": [],
        "requires_manual_rebind_workers": [],
        "rebind_check_unknown_workers": workers,
        "rebind_check_limit": 0,
        "rebind_check_skipped_workers": worker_ids,
        "rebind_timed_out_workers": [],
    }


def lock_doctor_payload(
    root: Path,
    worker_id: str | None = None,
    *,
    backend: str = RUNTIME_BACKEND,
    include_pool_readiness: bool = False,
) -> dict[str, Any]:
    requested_worker = safe_id(worker_id, "worker") if worker_id else ""
    pool_readiness_included = bool(requested_worker or include_pool_readiness)
    if pool_readiness_included:
        pool_snapshot = current_dispatchable_pool_snapshot(
            root,
            backend=backend,
            worker_id=requested_worker or None,
            rebind_timeout=(
                TARGET_REBIND_READINESS_TIMEOUT
                if requested_worker
                else POOL_REBIND_READINESS_TIMEOUT
            ),
            max_rebind_checks=1 if requested_worker else POOL_REBIND_READINESS_MAX_CHECKS,
            prioritize_worker_ids=[requested_worker] if requested_worker else None,
        )
    else:
        pool_snapshot = registry_only_pool_snapshot(root)
    registry_qualified_workers = pool_snapshot["registry_qualified_workers"]
    dispatchable = pool_snapshot["dispatchable_workers"]
    registry_warning = str(pool_snapshot["registry_warning"] or "")
    registry_qualified_ids = worker_ids_from_values(
        registry_qualified_workers
    )
    pool_rows = pool_snapshot["pool_rows"]
    rebind_check_limit = pool_snapshot.get("rebind_check_limit")
    rebind_check_skipped_workers = list(
        pool_snapshot.get("rebind_check_skipped_workers", [])
    )
    rebind_check_unknown_workers = worker_ids_from_values(
        pool_snapshot.get("rebind_check_unknown_workers")
    )
    rebind_timed_out_workers = list(
        pool_snapshot.get("rebind_timed_out_workers", [])
    )
    ready_rows, rebind_required_rows = split_pool_rows_by_rebind(pool_rows)
    dispatchable_ids = [
        str(row.get("worker_id") or "")
        for row in ready_rows
        if str(row.get("worker_id") or "")
    ]
    requires_manual_rebind_ids = [
        str(row.get("worker_id") or "")
        for row in rebind_required_rows
        if str(row.get("worker_id") or "")
    ]
    scoped_workers = [requested_worker] if requested_worker else dispatchable_ids
    raw_global_locks = current_locks(root)
    if requested_worker:
        locks = diagnose_worker_locks(root, worker_id=requested_worker)
    else:
        locks = diagnose_worker_locks(root)
    unrelated_locks = [
        item for item in raw_global_locks
        if requested_worker and str(item.get("worker_id") or "") != requested_worker
    ]
    by_worker: dict[str, list[dict[str, Any]]] = {worker: [] for worker in scoped_workers}
    for item in locks:
        wid = str(item.get("worker_id") or "")
        by_worker.setdefault(wid, []).append(item)
    worker_rows: list[dict[str, Any]] = []
    for worker in scoped_workers:
        worker_locks = by_worker.get(worker, [])
        diagnosis = summarize_lock_diagnosis(worker_locks)
        availability_known = worker not in rebind_check_unknown_workers
        available = (
            availability_known
            and worker in dispatchable_ids
            and diagnosis.get("blocking_count", 0) == 0
            and diagnosis.get("recoverable_count", 0) == 0
        )
        worker_rows.append({
            "worker_id": worker,
            "availability_known": availability_known,
            "available_for_dispatch": bool(available),
            "locks": worker_locks,
            "lock_diagnosis": diagnosis,
        })
    summary = summarize_lock_diagnosis(locks)
    available_workers = [row["worker_id"] for row in worker_rows if row.get("available_for_dispatch")]
    blocked_workers = sorted(set(summary.get("blocked_workers", [])))
    recoverable_workers = sorted(set(summary.get("recoverable_workers", [])))
    unrelated_locked_workers = sorted(
        {
            str(item.get("worker_id") or "")
            for item in unrelated_locks
            if str(item.get("worker_id") or "")
        }
    )
    target_worker_lock_count = len(locks) if requested_worker else None
    global_zero_lock = len(raw_global_locks) == 0
    recommended_commands: list[str] = []
    for item in locks:
        command = str(item.get("safe_command") or "")
        if command and command not in recommended_commands:
            recommended_commands.append(command)
    status = "OK"
    if summary.get("blocking_count", 0):
        status = "ATTENTION"
    elif summary.get("recoverable_count", 0):
        status = "RECOVERABLE"
    target_availability_known = bool(
        requested_worker
        and worker_rows
        and worker_rows[0].get("availability_known")
    )
    target_available = (
        bool(worker_rows[0].get("available_for_dispatch"))
        if target_availability_known
        else None
    )
    payload = {
        "schema_version": 1,
        "generated_at": utc_now(),
        "root": str(root),
        "runtime_backend": backend,
        "runtime_backend_type": backend_type_for(backend),
        "worker_id": requested_worker,
        "lock_scope": "worker" if requested_worker else "global",
        "pool_readiness_included": pool_readiness_included,
        "pool_snapshot_mode": (
            "rebind_readiness"
            if pool_readiness_included
            else "lock_truth_only"
        ),
        "global_lock_count": len(raw_global_locks),
        "global_zero_lock": global_zero_lock,
        "global_mutation_allowed": global_zero_lock,
        "target_worker_lock_count": target_worker_lock_count,
        "target_session_rebind_allowed": (
            target_worker_lock_count == 0
            if requested_worker and target_worker_lock_count is not None
            else None
        ),
        "unrelated_lock_count": len(unrelated_locks),
        "unrelated_locked_workers": unrelated_locked_workers,
        "target_worker_availability_known": (
            target_availability_known
            if requested_worker
            else None
        ),
        "target_worker_available_for_dispatch": target_available,
        "lock_doctor": status,
        "registry_qualified_visible_worker_count": len(registry_qualified_ids),
        "registry_qualified_visible_workers": registry_qualified_ids,
        "dispatchable_visible_worker_count": len(dispatchable_ids),
        "dispatchable_visible_workers": dispatchable_ids,
        "requires_manual_rebind_worker_count": len(requires_manual_rebind_ids),
        "requires_manual_rebind_workers": requires_manual_rebind_ids,
        "rebind_check_unknown_worker_count": len(
            rebind_check_unknown_workers
        ),
        "rebind_check_unknown_workers": rebind_check_unknown_workers,
        "pool_rebind_check_limit": rebind_check_limit,
        "pool_rebind_check_skipped_workers": rebind_check_skipped_workers,
        "global_pool_snapshot_timed_out": bool(rebind_timed_out_workers),
        "global_pool_timed_out_workers": rebind_timed_out_workers,
        "available_worker_count": len(available_workers),
        "available_workers": available_workers,
        "fanout2_available": len(available_workers) >= 2,
        "fanout3_available": len(available_workers) >= 3,
        "fanout4_available": len(available_workers) >= 4,
        "blocked_workers": blocked_workers,
        "recoverable_workers": recoverable_workers,
        "lock_diagnosis": summary,
        "locks": locks,
        "workers": worker_rows,
        "recommended_commands": recommended_commands,
    }
    if registry_warning:
        payload["registry_warning"] = registry_warning
    return payload


def compact_recovery_payload(
    root: Path,
    *,
    command: str,
    worker_id: str | None = None,
    backend: str = RUNTIME_BACKEND,
    include_pool_readiness: bool = False,
) -> dict[str, Any]:
    source = lock_doctor_payload(
        root,
        worker_id=worker_id,
        backend=backend,
        include_pool_readiness=include_pool_readiness,
    )
    fields = (
        "schema_version",
        "generated_at",
        "root",
        "runtime_backend",
        "runtime_backend_type",
        "worker_id",
        "lock_scope",
        "pool_readiness_included",
        "pool_snapshot_mode",
        "global_lock_count",
        "global_zero_lock",
        "global_mutation_allowed",
        "target_worker_lock_count",
        "target_session_rebind_allowed",
        "unrelated_lock_count",
        "unrelated_locked_workers",
        "target_worker_availability_known",
        "target_worker_available_for_dispatch",
        "lock_doctor",
        "registry_qualified_visible_worker_count",
        "registry_qualified_visible_workers",
        "dispatchable_visible_worker_count",
        "dispatchable_visible_workers",
        "requires_manual_rebind_worker_count",
        "requires_manual_rebind_workers",
        "rebind_check_unknown_worker_count",
        "rebind_check_unknown_workers",
        "pool_rebind_check_limit",
        "pool_rebind_check_skipped_workers",
        "global_pool_snapshot_timed_out",
        "global_pool_timed_out_workers",
        "available_worker_count",
        "available_workers",
        "fanout2_available",
        "fanout3_available",
        "fanout4_available",
        "blocked_workers",
        "recoverable_workers",
        "recommended_commands",
        "registry_warning",
    )
    payload = {
        key: source[key]
        for key in fields
        if key in source
    }
    diagnosis = source.get("lock_diagnosis", {})
    payload.update(
        {
            "projection_kind": "compact_recovery",
            "command": command,
            "lock_diagnosis": {
                "blocking_count": int(diagnosis.get("blocking_count", 0)),
                "recoverable_count": int(
                    diagnosis.get("recoverable_count", 0)
                ),
            },
        }
    )
    if command == "doctor":
        target_available = source.get(
            "target_worker_available_for_dispatch"
        )
        payload["ok"] = bool(
            source.get("lock_doctor") == "OK"
            and (
                not (source.get("worker_id") or worker_id)
                or target_available is True
            )
            and not source.get("global_pool_snapshot_timed_out")
        )
    payload_bytes = len(
        json.dumps(
            payload,
            indent=2,
            sort_keys=True,
            ensure_ascii=False,
        ).encode("utf-8")
    ) + 1
    if payload_bytes > COMPACT_RECOVERY_MAX_BYTES:
        raise DispatchError(
            "compact recovery projection exceeds "
            f"{COMPACT_RECOVERY_MAX_BYTES} bytes "
            f"(actual: {payload_bytes} bytes)"
        )
    return payload


def print_compact_recovery(payload: dict[str, Any]) -> None:
    print(
        f"{payload.get('command')}: "
        f"{'OK' if payload.get('ok', True) else 'ERROR'}"
    )
    print(f"projection_kind: {payload.get('projection_kind')}")
    print(f"worker_id: {payload.get('worker_id') or '-'}")
    print(f"lock_scope: {payload.get('lock_scope') or '-'}")
    print(f"global_lock_count: {payload.get('global_lock_count', 0)}")
    print(f"lock_doctor: {payload.get('lock_doctor') or '-'}")
    print(
        "target_worker_available_for_dispatch: "
        f"{payload.get('target_worker_available_for_dispatch')}"
    )
    print(
        "dispatchable_visible_workers: "
        f"{', '.join(payload.get('dispatchable_visible_workers', [])) or '-'}"
    )


def raw_locks_with_truth(root: Path, worker_id: str | None = None) -> list[dict[str, Any]]:
    locks: list[dict[str, Any]] = []
    for item in current_locks(root, worker_id=worker_id):
        run = str(item.get("run", ""))
        task = str(item.get("task", ""))
        truth: dict[str, Any] = {}
        if run and task:
            try:
                truth = task_truth(root, run, task)
            except DispatchError as exc:
                truth = {"protocol_terminal_state": "invalid_lock_reference", "state_reason": str(exc)}
        locks.append({
            **item,
            "task_truth": truth,
            "terminal": truth.get("protocol_terminal_state") in VALID_TERMINAL_STATES,
        })
    return locks


def build_doctor_report(
    root: Path,
    *,
    worker_id: str | None = None,
    backend: str = RUNTIME_BACKEND,
    reset_recovery_reservation: dict[str, str] | None = None,
) -> dict[str, Any]:
    checks: list[dict[str, Any]] = []
    errors: list[str] = []
    warnings: list[str] = []

    def check(name: str, status: str, detail: str = "", **extra: Any) -> None:
        item = {"name": name, "status": status}
        if detail:
            item["detail"] = detail
        item.update(extra)
        checks.append(item)
        if status == "error":
            errors.append(f"{name}: {detail}" if detail else name)
        elif status == "warning":
            warnings.append(f"{name}: {detail}" if detail else name)

    try:
        ensure_state_team_clean(root)
        check("state_team_clean", "ok", ".omx/state/team has no framework pollution")
    except DispatchError as exc:
        check("state_team_clean", "error", str(exc))

    defaults_path = root / DEFAULTS_REL
    if defaults_path.is_file():
        defaults_validation = validate_authorization_profile_defaults_file(defaults_path, root=root)
        if defaults_validation.get("ok"):
            check("authorization_profile_defaults", "ok", "authorization profile defaults validated")
        else:
            check(
                "authorization_profile_defaults",
                "error",
                "; ".join(str(reason) for reason in defaults_validation.get("blocked_reasons", [])),
            )

    for name, path in (
        ("omx_visible_dispatch", dispatch_path(root)),
        ("omx_opencode_tui_adapter", adapter_path(root)),
        ("omx_task_signal", root / "bin" / "omx_task_signal"),
        ("omx_visible_watcher", watcher_path(root)),
        ("omx_visible_rebind", rebind_path(root)),
    ):
        status = tool_status(root, path)
        check(name, "ok" if status["exists"] else "error", status["path"], **status)

    worker: dict[str, Any] = {}
    binding: dict[str, Any] = {}
    schema: dict[str, Any] = {}
    rebind_result: dict[str, Any] = {}
    readiness: dict[str, Any] = {}
    requested_worker_id = safe_id(worker_id, "worker") if worker_id else ""
    try:
        worker = worker_record(root, requested_worker_id)
        worker_id = str(worker.get("worker_id", ""))
        if requested_worker_id:
            check("requested_worker_id", "ok", requested_worker_id)
            check("resolved_worker_id", "ok", worker_id)
        else:
            check("default_worker_id", "ok", worker_id)
        ensure_worker_allowed(root, worker, must_be_default=not requested_worker_id)
        check(
            "worker_policy",
            "ok",
            f"pane={worker.get('pane_id')} port={worker.get('port')} binding={worker.get('binding_confidence')} role={worker.get('role')}",
        )
        rebind_command = None
        if rebind_path(root).is_file():
            rebind_command = run_command(
                [str(rebind_path(root)), "check", "--root", str(root), "--worker", worker_id, "--runtime-backend", backend, "--json"],
                root,
                timeout=45,
            )
            try:
                parsed = json.loads(rebind_command.get("stdout") or "{}")
                if isinstance(parsed, dict):
                    rebind_result = parsed
            except Exception:
                rebind_result = {}
            status = str(rebind_result.get("status") or "unknown")
            if rebind_command["returncode"] == 0 and status == "current_binding_ok":
                gate_reason = dispatch_binding_gate_reason(
                    rebind_result,
                    worker_id,
                    expected_root=str(root),
                )
                if gate_reason:
                    check("rebind_check", "error", gate_reason)
                else:
                    check("rebind_check", "ok", "current_binding_ok")
            else:
                detail = status
                if status in {"stale_pane_rebind_available", "rebind_available"}:
                    detail += f"; run ./bin/omx_visible_rebind rebind --root . --worker {worker_id} --port {worker.get('port')} --allow-rebind"
                elif rebind_command.get("stderr"):
                    detail += f"; {rebind_command['stderr']}"
                check("rebind_check", "error", detail)
        else:
            check("rebind_check", "error", "missing bin/omx_visible_rebind")
        verified = verify_worker(root, worker_id, backend=backend, rebind_command=rebind_command)
        binding = verified.get("binding", {})
        agent_backend = str(
            binding.get("backend") or worker.get("backend") or "opencode_tui"
        )
        check("verify_visible", "ok", f"binding_confidence={binding.get('binding_confidence')}")
        if agent_backend == "codex_tui":
            check(
                "endpoint_schema",
                "ok",
                "codex backend: native thread binding verified "
                f"(codex_thread={binding.get('codex_thread') or '-'})",
            )
            codex_ready = load_codex_adapter_module(root).verify_binding(
                root, worker_id
            )
            if codex_ready.get("binding_confidence") == "strong":
                check("tui_readiness", "ok", "codex thread idle/readable")
            else:
                check(
                    "tui_readiness",
                    "error",
                    "codex binding not strong: "
                    + json.dumps(codex_ready.get("checks") or {},
                                 default=str),
                )
        else:
            methods = set(binding.get("detected_tui_methods", []))
            required = {"/tui/clear-prompt", "/tui/append-prompt", "/tui/submit-prompt"}
            missing = sorted(required - methods)
            if missing:
                check("endpoint_schema", "error", f"read-only /doc check missing: {', '.join(missing)}")
            else:
                schema = {
                    "all_required_endpoints_present": True,
                    "all_payloads_executable": None,
                    "read_only_check": True,
                }
                check("endpoint_schema", "ok", "required /tui endpoints confirmed by read-only rebind check")
            readiness = tui_readiness(root, worker_id)
            readiness_state = str(readiness.get("readiness", "unknown"))
            readiness_detail = f"{readiness_state}: {readiness.get('reason', '')}"
            if readiness_state == "unhealthy":
                check("tui_readiness", "error", readiness_detail, readiness=readiness_state)
            elif readiness_state == "busy":
                check("tui_readiness", "warning", readiness_detail, readiness=readiness_state)
            elif readiness_state == "unknown":
                check("tui_readiness", "warning", readiness_detail, readiness=readiness_state)
            else:
                check("tui_readiness", "ok", readiness_detail, readiness=readiness_state)
    except DispatchError as exc:
            check("worker_chain", "error", str(exc))

    locks = inspect_locks_readonly(root, worker_id=requested_worker_id or None)
    recovery_owner_lock_id = ""
    if reset_recovery_reservation is not None:
        try:
            reserved = validate_reset_recovery_reservation_lock(
                root,
                requested_worker_id,
                reset_recovery_reservation,
            )
            recovery_owner_lock_id = str(
                reserved.get("owner_lock_id") or ""
            )
            check(
                "reset_recovery_reservation",
                "ok",
                recovery_owner_lock_id,
            )
        except DispatchError as exc:
            check(
                "reset_recovery_reservation",
                "error",
                str(exc),
            )
    blocking_locks = [
        item
        for item in locks
        if not recovery_owner_lock_id
        or str(item.get("owner_lock_id") or "") != recovery_owner_lock_id
    ]
    active_nonterminal = [
        item for item in blocking_locks
        if item.get("task_truth", {}).get("lock_state") == "active_lock"
    ]
    terminal_locks = [
        item for item in blocking_locks
        if item.get("task_truth", {}).get("lock_state") == "stale_terminal_lock"
    ]
    invalid_terminal = [
        item for item in blocking_locks
        if item.get("task_truth", {}).get("protocol_terminal_state") in INVALID_TERMINAL_STATES
    ]
    classified_blocking = [
        item
        for item in blocking_locks
        if str(item.get("diagnosis") or "") in BLOCKING_LOCK_DIAGNOSES
    ]
    if invalid_terminal:
        detail = ", ".join(
            f"{item.get('worker_id')}:{item.get('run')}/{item.get('task')}={item.get('task_truth', {}).get('protocol_terminal_state')}"
            for item in invalid_terminal
        )
        check("active_lock_status", "error", detail)
    elif active_nonterminal:
        detail = ", ".join(
            f"{item.get('worker_id')}:{item.get('run')}/{item.get('task')}={item.get('task_truth', {}).get('protocol_terminal_state')}"
            for item in active_nonterminal
        )
        check("active_lock_status", "error", detail)
    elif classified_blocking:
        detail = ", ".join(
            f"{item.get('worker_id') or '-'}:{item.get('diagnosis')}"
            for item in classified_blocking
        )
        check("active_lock_status", "error", detail)
    elif terminal_locks:
        detail = ", ".join(f"{item.get('worker_id')}:{item.get('run')}/{item.get('task')}" for item in terminal_locks)
        check("active_lock_status", "warning", f"terminal stale lock(s): {detail}")
    else:
        check("active_lock_status", "ok", "no active locks")

    for item in locks:
        lock_truth = item.get("task_truth", {}) if isinstance(item.get("task_truth"), dict) else {}
        lock_summary = lock_truth.get("summary_data", {}) if isinstance(lock_truth.get("summary_data"), dict) else {}
        current_state = str(lock_truth.get("protocol_terminal_state") or "")
        summary_state = str(
            lock_summary.get("final_protocol_terminal_state")
            or lock_summary.get("protocol_terminal_state")
            or ""
        )
        lock_run = str(item.get("run_id") or "")
        lock_task = str(item.get("task_id") or "")
        if summary_state and current_state and summary_state != current_state:
            check(
                "summary_stale",
                "warning",
                f"{lock_run}/{lock_task} summary={summary_state} truth={current_state}; run {settle_command_for(lock_run, lock_task)}",
            )
        elif bool(lock_summary.get("needs_settle")):
            check(
                "pending_after_timeout",
                "warning",
                f"{lock_run}/{lock_task} still needs settle; run {settle_command_for(lock_run, lock_task)}",
            )

    check("watcher_board_read", "ok", "existing watcher board read without refreshing it")

    watcher = filter_watcher_board_for_worker(root, read_watcher_board(root), requested_worker_id or None)
    watcher_snapshot = watcher_snapshot_status(watcher, locks)
    if watcher:
        check(
            "watcher_summary",
            "ok",
            f"alerts={watcher.get('alert_count', 0)} summary={watcher.get('summary', {})}",
        )
    else:
        check("watcher_summary", "warning", "watcher board absent")

    default_worker = {
        "worker_id": worker.get("worker_id"),
        "pane_id": worker.get("pane_id"),
        "port": worker.get("port"),
        "binding_confidence": binding.get(
            "binding_confidence",
            worker.get("binding_confidence"),
        ),
        "allow_auto_submit": worker.get("allow_auto_submit"),
        "default_for_new_tasks": worker.get("default_for_new_tasks"),
        "status": worker.get("status"),
        "role": worker.get("role"),
        "launch_owned": worker.get("launch_owned"),
        "user_started": worker.get("user_started"),
    }
    stale_default_worker: dict[str, Any] = {}
    if requested_worker_id:
        default_worker_state = "explicit"
    elif worker:
        if str(rebind_result.get("status") or "") == "current_binding_ok":
            default_worker_state = "healthy"
        else:
            default_worker_state = "stale"
            stale_default_worker = default_worker
            default_worker = {}
    else:
        default_worker_state = "unavailable"
    return {
        "schema_version": 1,
        "generated_at": utc_now(),
        "root": str(root),
        "runtime_backend": backend,
        "runtime_backend_type": backend_type_for(backend),
        **command_support_report(),
        "ok": not errors,
        "errors": errors,
        "warnings": warnings,
        "checks": checks,
        "default_worker": default_worker,
        "default_worker_state": default_worker_state,
        "stale_default_worker": stale_default_worker,
        "locks": locks,
        "lock_diagnosis": summarize_lock_diagnosis(locks),
        "watcher": {
            "board_path": rel(watcher_board_path(root), root),
            "generated_at": watcher.get("generated_at", ""),
            "summary": watcher.get("summary", {}),
            "alert_count": watcher.get("alert_count", 0),
            "alerts": watcher.get("alerts", []) if isinstance(watcher.get("alerts"), list) else [],
            "snapshot_status": watcher_snapshot,
        },
        "registered_workers": source_registered_worker_summary(root),
        "dispatchable_visible_workers": dispatchable_visible_workers(root),
        "authorization_profile_summary": authorization_profile_surface_summary(root),
        "opencode_mixed_status": source_opencode_mixed_status_summary(
            root,
            worker_id=requested_worker_id or None,
            include_all=False,
        ),
        "rebind_check": rebind_result,
        "endpoint_schema": {
            "all_required_endpoints_present": schema.get("all_required_endpoints_present"),
            "all_payloads_executable": schema.get("all_payloads_executable"),
        },
        "tui_readiness": readiness,
        "requested_worker_id": requested_worker_id,
    }


def global_doctor_operator_report(
    report: dict[str, Any],
    *,
    current_dispatchable_ids: list[str] | None = None,
) -> dict[str, Any]:
    if (
        report.get("requested_worker_id")
        or report.get("default_worker_state") != "stale"
    ):
        return report
    stale_worker = report.get("stale_default_worker", {})
    if not isinstance(stale_worker, dict) or not stale_worker:
        return report
    stale_id = str(stale_worker.get("worker_id") or "").strip()
    dispatchable_ids = [
        worker_id
        for worker_id in worker_ids_from_values(current_dispatchable_ids)
        if worker_id != stale_id
    ]
    if not dispatchable_ids:
        return report
    rebind_status = str(
        report.get("rebind_check", {}).get("status") or ""
    ).strip()

    def stale_default_error(value: Any) -> bool:
        text = str(value)
        return text.startswith("rebind_check:") or text.startswith("worker_chain:")

    suppressed = [
        str(item)
        for item in report.get("errors", [])
        if stale_default_error(item)
    ]
    if not suppressed:
        return report
    kept_errors = [
        str(item)
        for item in report.get("errors", [])
        if not stale_default_error(item)
    ]
    warning = (
        f"stale_default_worker: {stale_id or '-'} rebind_status={rebind_status or '-'}; "
        f"ignored for global doctor because dispatchable workers exist: {', '.join(dispatchable_ids)}"
    )
    warnings = [str(item) for item in report.get("warnings", [])]
    if warning not in warnings:
        warnings.append(warning)
    checks: list[dict[str, Any]] = []
    for item in report.get("checks", []):
        if not isinstance(item, dict):
            continue
        copied = dict(item)
        if copied.get("status") == "error" and copied.get("name") in {
            "rebind_check",
            "worker_chain",
        }:
            copied["status"] = "warning"
            copied["demoted_from_error"] = True
        checks.append(copied)
    normalized = dict(report)
    normalized["errors"] = kept_errors
    normalized["warnings"] = warnings
    normalized["checks"] = checks
    normalized["ok"] = not kept_errors
    normalized["stale_default_worker_demoted_errors"] = suppressed
    normalized["current_dispatchable_visible_workers"] = dispatchable_ids
    return normalized


def command_doctor(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    backend = getattr(args, "backend", RUNTIME_BACKEND)
    if getattr(args, "compact", False):
        if getattr(args, "all_workers", False):
            raise DispatchError(
                "--compact cannot be combined with --all-workers; "
                "use --worker for bounded live readiness"
            )
        payload = compact_recovery_payload(
            root,
            command="doctor",
            worker_id=getattr(args, "worker", None),
            backend=backend,
        )
        if args.json:
            print(
                json.dumps(
                    payload,
                    indent=2,
                    sort_keys=True,
                    ensure_ascii=False,
                )
            )
        else:
            print_compact_recovery(payload)
        return 0 if payload["ok"] else 1
    if getattr(args, "all_workers", False):
        workers = load_visible_workers(root)
        reports = [
            build_doctor_report(root, worker_id=str(worker.get("worker_id") or ""), backend=backend)
            for worker in workers
        ]
        overall_ok = all(
            report.get("ok", False) or not is_production_visible_worker(report.get("default_worker", {}))
            for report in reports
        )
        if args.json:
            print(json.dumps({
                "schema_version": 1,
                "generated_at": utc_now(),
                "root": str(root),
                **command_support_report(),
                "ok": overall_ok,
                "workers": reports,
            }, indent=2, sort_keys=True, ensure_ascii=False))
            return 0 if overall_ok else 1
        print(f"doctor: {'OK' if overall_ok else 'ERROR'}")
        for report in reports:
            worker = report.get("default_worker", {})
            print("")
            print(
                f"worker={worker.get('worker_id') or '-'} role={worker.get('role') or '-'} "
                f"pane={worker.get('pane_id') or '-'} port={worker.get('port') or '-'} "
                f"ok={str(bool(report.get('ok'))).lower()}"
            )
            print(f"  tmux_live_baseline: {report.get('tmux_live_baseline')}")
            print(f"  active_runtime_substrate: {report.get('active_runtime_substrate')}")
            features = report.get("blocked_post_baseline_features", [])
            if isinstance(features, list):
                print(f"  blocked_post_baseline_features: {', '.join(str(item) for item in features) or '-'}")
            rebind = report.get("rebind_check", {})
            print(f"  rebind_status: {rebind.get('status') or '-'}")
            print(f"  active_locks: {len(report.get('locks', []))}")
            lock_diag = report.get("lock_diagnosis", {}) if isinstance(report.get("lock_diagnosis"), dict) else {}
            print(f"  lock_diagnosis: {lock_diag.get('counts', {})}")
            watcher = report.get("watcher", {})
            print(f"  watcher_alerts: {watcher.get('alert_count', 0)}")
            readiness = report.get("tui_readiness", {})
            print(f"  tui_readiness: {readiness.get('readiness', '-')}")
            mixed_status = report.get("opencode_mixed_status", {})
            for line in format_opencode_mixed_status_human(mixed_status, indent="  "):
                print(line)
            for item in report.get("warnings", []):
                print(f"  warning: {item}")
            for item in report.get("errors", []):
                print(f"  error: {item}")
        return 0 if overall_ok else 1

    report = build_doctor_report(
        root,
        worker_id=getattr(args, "worker", None),
        backend=backend,
    )
    current_dispatchable_ids: list[str] = []
    if (
        not getattr(args, "worker", None)
        and report.get("default_worker_state") == "stale"
        and report.get("errors")
    ):
        pool_snapshot = current_dispatchable_pool_snapshot(
            root,
            backend=backend,
            rebind_timeout=POOL_REBIND_READINESS_TIMEOUT,
            max_rebind_checks=POOL_REBIND_READINESS_MAX_CHECKS,
        )
        current_dispatchable_ids = worker_ids_from_values(
            pool_snapshot.get("dispatchable_workers", [])
        )
    report = global_doctor_operator_report(
        report,
        current_dispatchable_ids=current_dispatchable_ids,
    )
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True, ensure_ascii=False))
        return 0 if report["ok"] else 1

    worker = report.get("default_worker", {})
    readiness = report.get("tui_readiness", {})
    rebind = report.get("rebind_check", {})
    submit_safe = bool(readiness.get("submit_safe", False))
    dispatchable_ids = dispatchable_visible_worker_ids(root)
    dispatch_ready = bool(
        submit_safe
        and str(rebind.get("status") or "") == "current_binding_ok"
        and str(worker.get("binding_confidence") or "") == "strong"
    )
    doctor_label = "OK" if report["ok"] else ("ATTENTION" if dispatch_ready else "ERROR")
    print(f"doctor: {doctor_label}")
    if doctor_label == "ATTENTION":
        print("doctor_scope_note: default worker is dispatchable; follow-up items below are global or secondary")
    print(f"default_worker: {worker.get('worker_id') or '-'}")
    default_worker_state = str(
        report.get("default_worker_state")
        or ("explicit" if report.get("requested_worker_id") else "healthy")
    )
    print(f"default_worker_state: {default_worker_state}")
    stale_default_worker = report.get("stale_default_worker", {})
    if isinstance(stale_default_worker, dict) and stale_default_worker:
        print(
            "stale_default_worker: "
            f"{stale_default_worker.get('worker_id') or '-'}"
        )
        print(
            "stale_default_pane: "
            f"{stale_default_worker.get('pane_id') or '-'}"
        )
        print(
            "stale_default_port: "
            f"{stale_default_worker.get('port') or '-'}"
        )
    print(f"runtime_backend: {backend}")
    print(f"tmux_live_baseline: {report.get('tmux_live_baseline')}")
    print(f"active_runtime_substrate: {report.get('active_runtime_substrate')}")
    features = report.get("blocked_post_baseline_features", [])
    if isinstance(features, list):
        print(f"blocked_post_baseline_features: {', '.join(str(item) for item in features) or '-'}")
    if report.get("requested_worker_id"):
        print(f"requested_worker_id: {report.get('requested_worker_id')}")
    print(f"worker_role: {worker.get('role') or '-'}")
    print(f"pane: {worker.get('pane_id') or '-'}")
    print(f"port: {worker.get('port') or '-'}")
    print(f"binding_confidence: {worker.get('binding_confidence') or '-'}")
    print(f"rebind_status: {rebind.get('status') or '-'}")
    print(f"default_worker_submit_safe: {str(submit_safe).lower()}")
    print(f"dispatchable_pool_ready: {str(dispatch_ready).lower()}")
    print(f"dispatchable_visible_worker_count: {len(dispatchable_ids)}")
    print(f"dispatchable_visible_workers: {', '.join(dispatchable_ids) or '-'}")
    current_dispatchable_ids = worker_ids_from_values(
        report.get("current_dispatchable_visible_workers", [])
    )
    if current_dispatchable_ids:
        print(
            "current_dispatchable_visible_workers: "
            f"{', '.join(current_dispatchable_ids)}"
        )
    print(f"active_locks: {len(report.get('locks', []))}")
    lock_diag = report.get("lock_diagnosis", {}) if isinstance(report.get("lock_diagnosis"), dict) else {}
    print(f"lock_diagnosis: {lock_diag.get('counts', {})}")
    if lock_diag:
        print(f"lock_blocking_count: {lock_diag.get('blocking_count', 0)}")
        print(f"lock_recoverable_count: {lock_diag.get('recoverable_count', 0)}")
    watcher = report.get("watcher", {})
    print(f"watcher_summary: {watcher.get('summary', {})}")
    print(f"watcher_alerts: {watcher.get('alert_count', 0)}")
    print(f"tui_readiness: {readiness.get('readiness', '-')}")
    print(f"submit_safe: {str(submit_safe).lower()}")
    if readiness.get("reason"):
        print(f"tui_readiness_reason: {readiness.get('reason')}")
    mixed_status = report.get("opencode_mixed_status", {})
    for line in format_opencode_mixed_status_human(mixed_status):
        print(line)
    registered = report.get("registered_workers", {})
    print("secondary_registered_worker_inventory_scope: non-visible inventory; separate from dispatchable visible workers")
    print(
        "secondary_registered_worker_inventory: "
        f"present={str(bool(registered.get('present'))).lower()} "
        f"valid={str(bool(registered.get('registry_valid'))).lower()} "
        f"count={registered.get('worker_count', 0)}"
    )

    if report.get("warnings"):
        print("Warnings:")
        for item in report["warnings"]:
            print(f"  - {item}")
    if report.get("errors"):
        print("Errors:")
        for item in report["errors"]:
            print(f"  - {item}")
        if rebind.get("status") in {"stale_pane_rebind_available", "rebind_available"}:
            suggestion_worker = str(worker.get("worker_id") or report.get("requested_worker_id") or "").strip()
            suggestion_port = str(worker.get("port") or "").strip()
            if suggestion_worker and suggestion_port:
                print(
                    "suggested_rebind: "
                    f"./bin/omx_visible_rebind rebind --root . --worker {suggestion_worker} "
                    f"--port {suggestion_port} --allow-rebind"
                )
    else:
        if worker.get("worker_id"):
            print("ready_for_run_one: true")
        else:
            print("ready_for_run_one: false")
            if current_dispatchable_ids:
                print("ready_for_explicit_worker_dispatch: true")
    return 0 if report["ok"] else 1


def _legacy_baseline_run_ids(root: Path, args: argparse.Namespace) -> list[str]:
    requested_run = str(getattr(args, "run", "") or "").strip()
    all_runs = bool(getattr(args, "all_runs", False))
    if all_runs:
        if requested_run:
            raise DispatchError("--run and --all-runs are mutually exclusive")
        runs_root = _validate_real_directory_chain(
            root,
            visible_runs_root(root),
            create=False,
        )
        if not runs_root.is_dir():
            raise DispatchError(f"visible runs directory missing: {rel(runs_root, root)}")
        run_dirs = []
        for entry in sorted(runs_root.iterdir()):
            if entry.name.startswith("_") or entry.name == LEGACY_ACTIVATION_BATCH_FILENAME:
                continue
            try:
                entry_mode = entry.lstat().st_mode
            except OSError as exc:
                raise DispatchError(
                    f"visible run inventory entry is unreadable: {rel(entry, root)}"
                ) from exc
            if (
                _LEGACY_ACTIVATION_BATCH_TEMP_RE.fullmatch(entry.name)
                and stat.S_ISREG(entry_mode)
            ):
                continue
            if stat.S_ISLNK(entry_mode) or not stat.S_ISDIR(entry_mode):
                raise DispatchError(f"invalid visible run inventory entry: {rel(entry, root)}")
            try:
                entry.resolve().relative_to(runs_root.resolve())
                tasks_mode = (entry / "tasks").lstat().st_mode
            except FileNotFoundError:
                continue
            except (OSError, ValueError) as exc:
                raise DispatchError(
                    f"visible run inventory containment invalid: {rel(entry, root)}"
                ) from exc
            if stat.S_ISLNK(tasks_mode) or not stat.S_ISDIR(tasks_mode):
                raise DispatchError(
                    f"visible run tasks directory missing or unsafe: {rel(entry, root)}"
                )
            run_dirs.append(entry.name)
        if not run_dirs:
            raise DispatchError("visible run inventory is empty")
        return run_dirs
    if not requested_run:
        raise DispatchError("one of --run or --all-runs is required")
    run = safe_id(requested_run, "run")
    runs_root = _validate_real_directory_chain(
        root,
        visible_runs_root(root),
        create=False,
    )
    run_root = runs_root / run
    if run_root.is_symlink() or not run_root.is_dir():
        raise DispatchError(f"visible run directory missing: {rel(run_root, root)}")
    try:
        run_root.resolve().relative_to(visible_runs_root(root).resolve())
        tasks_mode = (run_root / "tasks").lstat().st_mode
    except (OSError, ValueError) as exc:
        raise DispatchError(
            f"visible run inventory containment invalid: {rel(run_root, root)}"
        ) from exc
    if stat.S_ISLNK(tasks_mode) or not stat.S_ISDIR(tasks_mode):
        raise DispatchError(
            f"visible run tasks directory missing or unsafe: {rel(run_root, root)}"
        )
    return [run]


def _legacy_activation_metadata(root: Path, run_ids: list[str]) -> tuple[str, str]:
    existing: set[tuple[str, str]] = set()
    for run in run_ids:
        path = legacy_baseline_path(visible_runs_root(root) / run / "tasks" / "_baseline")
        present, raw, unsafe = read_regular_file_bytes(path)
        if not present:
            continue
        if unsafe:
            raise DispatchError(f"legacy baseline target is not a regular file: {path}")
        try:
            payload = json.loads(raw.decode("utf-8"))
        except (UnicodeError, json.JSONDecodeError) as exc:
            raise DispatchError(f"legacy baseline target is malformed: {path}") from exc
        if not isinstance(payload, dict):
            raise DispatchError(f"legacy baseline target is malformed: {path}")
        generation = payload.get("activation_generation")
        cutoff = payload.get("activation_cutoff")
        if not isinstance(generation, str) or not generation:
            raise DispatchError(f"legacy baseline activation_generation missing: {path}")
        if not isinstance(cutoff, str) or not cutoff:
            raise DispatchError(f"legacy baseline activation_cutoff missing: {path}")
        existing.add((generation, cutoff))
    if len(existing) > 1:
        raise DispatchError("existing legacy baselines use conflicting activation metadata")
    if existing:
        return next(iter(existing))
    cutoff = utc_now()
    generation = "legacy-baseline-" + hashlib.sha256(
        f"{'|'.join(run_ids)}/{cutoff}".encode("utf-8")
    ).hexdigest()[:16]
    return generation, cutoff


def _legacy_baseline_plan(
    root: Path,
    run_ids: list[str],
    *,
    activation_generation: str,
    activation_cutoff: str,
    activation_batch_id: str | None = None,
    allow_exclusions: bool = False,
) -> list[tuple[str, Path, dict[str, Any]]]:
    plan: list[tuple[str, Path, dict[str, Any]]] = []
    for run in run_ids:
        run_root = visible_runs_root(root) / run
        try:
            baseline = build_legacy_terminal_baseline(
                run_root,
                activation_generation=activation_generation,
                activation_cutoff=activation_cutoff,
                activation_batch_id=activation_batch_id,
                allow_exclusions=allow_exclusions,
            )
        except (OSError, ValueError) as exc:
            raise DispatchError(f"legacy baseline inventory invalid: {exc}") from exc
        plan.append((run, legacy_baseline_path(run_root / "tasks" / "_baseline"), baseline))
    return plan


def _legacy_baseline_target_status(path: Path, data: dict[str, Any]) -> str:
    expected = _legacy_baseline_bytes(data)
    present, actual, unsafe = read_regular_file_bytes(path)
    if not present:
        return "missing"
    if unsafe:
        raise DispatchError(f"legacy baseline target is unsafe or non-regular: {path}")
    if actual != expected:
        raise DispatchError(f"legacy baseline target conflicts: {path}")
    return "equal"


def _legacy_baseline_bytes(data: dict[str, Any]) -> bytes:
    return (
        json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
    ).encode("utf-8")


def _legacy_activation_batch_path(root: Path) -> Path:
    return visible_runs_root(root) / LEGACY_ACTIVATION_BATCH_FILENAME


def _read_legacy_activation_batch(root: Path) -> dict[str, Any] | None:
    path = _legacy_activation_batch_path(root)
    present, raw, unsafe = read_regular_file_bytes(path)
    if not present:
        return None
    if unsafe:
        raise DispatchError(f"legacy activation batch is unsafe or non-regular: {path}")
    try:
        payload = json.loads(raw.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise DispatchError(f"legacy activation batch is malformed: {path}") from exc
    if not isinstance(payload, dict):
        raise DispatchError(f"legacy activation batch is malformed: {path}")
    if type(payload.get("schema_version")) is not int or payload.get("schema_version") != 1:
        raise DispatchError(f"legacy activation batch schema is unsupported: {path}")
    if payload.get("batch_kind") != "legacy_terminal_activation_batch":
        raise DispatchError(f"legacy activation batch kind is unsupported: {path}")
    phase = payload.get("phase")
    if phase not in {"PREPARED", "SEALED"}:
        raise DispatchError(f"legacy activation batch phase is invalid: {path}")
    if payload.get("sealed") is not (phase == "SEALED"):
        raise DispatchError(f"legacy activation batch sealing is invalid: {path}")
    for field in ("activation_generation", "activation_cutoff"):
        value = payload.get(field)
        if not isinstance(value, str) or not value:
            raise DispatchError(f"legacy activation batch {field} is missing: {path}")
    run_ids = payload.get("run_ids")
    if (
        not isinstance(run_ids, list)
        or not run_ids
        or any(not isinstance(run, str) or not run for run in run_ids)
        or run_ids != sorted(set(run_ids))
    ):
        raise DispatchError(f"legacy activation batch run inventory is invalid: {path}")
    targets = payload.get("target_sha256")
    if not isinstance(targets, dict) or set(targets) != set(run_ids):
        raise DispatchError(f"legacy activation batch target inventory is invalid: {path}")
    target_paths = payload.get("target_paths")
    if not isinstance(target_paths, dict) or set(target_paths) != set(run_ids):
        raise DispatchError(f"legacy activation batch target paths are invalid: {path}")
    for run in run_ids:
        digest = targets.get(run)
        if (
            not isinstance(digest, str)
            or len(digest) != 64
            or any(character not in "0123456789abcdef" for character in digest)
        ):
            raise DispatchError(f"legacy activation batch target hash is invalid: {path}")
        if target_paths.get(run) != f"{run}/{LEGACY_BASELINE_FILENAME}":
            raise DispatchError(f"legacy activation batch target path is invalid: {path}")
    batch_id = payload.get("activation_batch_id")
    if not isinstance(batch_id, str) or batch_id != legacy_activation_batch_id(
        str(payload["activation_generation"]),
        str(payload["activation_cutoff"]),
        run_ids,
    ):
        raise DispatchError(f"legacy activation batch identity is invalid: {path}")
    return payload


def _legacy_activation_batch_payload(
    generation: str,
    cutoff: str,
    plan: list[tuple[str, Path, dict[str, Any]]],
    *,
    phase: str,
) -> dict[str, Any]:
    run_ids = [run for run, _, _ in plan]
    return {
        "schema_version": 1,
        "batch_kind": "legacy_terminal_activation_batch",
        "phase": phase,
        "sealed": phase == "SEALED",
        "activation_generation": generation,
        "activation_cutoff": cutoff,
        "run_ids": run_ids,
        "activation_batch_id": legacy_activation_batch_id(generation, cutoff, run_ids),
        "target_paths": {
            run: f"{run}/{LEGACY_BASELINE_FILENAME}"
            for run, _, _ in plan
        },
        "target_sha256": {
            run: hashlib.sha256(_legacy_baseline_bytes(baseline)).hexdigest()
            for run, _, baseline in plan
        },
    }


def _legacy_batch_target_status(
    path: Path,
    data: dict[str, Any],
    expected_hash: str,
) -> str:
    present, actual, unsafe = read_regular_file_bytes(path)
    if not present:
        raise DispatchError(f"legacy activation batch target is missing: {path}")
    if unsafe:
        raise DispatchError(f"legacy baseline target is unsafe or non-regular: {path}")
    if (
        actual != _legacy_baseline_bytes(data)
        or hashlib.sha256(actual).hexdigest() != expected_hash
    ):
        raise DispatchError(f"legacy activation batch target conflicts: {path}")
    return "equal"


def command_legacy_baseline(args: argparse.Namespace) -> int:
    """Seal pre-v2 task identities under one guarded activation gate."""
    root = root_path(args.root)
    all_runs = bool(getattr(args, "all_runs", False))
    run_ids = _legacy_baseline_run_ids(root, args)
    batch = _read_legacy_activation_batch(root)
    activation_batch_id: str | None = None
    if batch is not None:
        if all_runs and run_ids != batch["run_ids"]:
            raise DispatchError("legacy activation run inventory changed since sealing")
        if not all_runs and run_ids[0] not in batch["run_ids"]:
            raise DispatchError(
                "legacy activation is sealed by an all-runs activation batch"
            )
        activation_generation = str(batch["activation_generation"])
        activation_cutoff = str(batch["activation_cutoff"])
        activation_batch_id = str(batch["activation_batch_id"])
    elif all_runs:
        existing_targets: list[Path] = []
        for run in run_ids:
            target = legacy_baseline_path(
                visible_runs_root(root) / run / "tasks" / "_baseline"
            )
            present, _raw, unsafe = read_regular_file_bytes(target)
            if unsafe:
                raise DispatchError(
                    f"legacy baseline target is unsafe or non-regular: {target}"
                )
            if present:
                existing_targets.append(target)
        if existing_targets:
            raise DispatchError(
                "legacy activation cannot create an all-runs batch over existing baselines"
            )
        activation_cutoff = utc_now()
        activation_generation = "legacy-baseline-" + hashlib.sha256(
            f"{'|'.join(run_ids)}/{activation_cutoff}".encode("utf-8")
        ).hexdigest()[:16]
        activation_batch_id = legacy_activation_batch_id(
            activation_generation,
            activation_cutoff,
            run_ids,
        )
    else:
        activation_generation, activation_cutoff = _legacy_activation_metadata(root, run_ids)
    plan = _legacy_baseline_plan(
        root,
        run_ids,
        activation_generation=activation_generation,
        activation_cutoff=activation_cutoff,
        activation_batch_id=activation_batch_id,
        allow_exclusions=all_runs,
    )
    with global_mutation_gate(root, exclusive=True):
        locks = current_locks(root)
        if locks:
            raise DispatchError(
                "legacy baseline activation blocked by owner locks: "
                + ",".join(str(item.get("worker_id") or "unknown") for item in locks)
            )
        gated_run_ids = _legacy_baseline_run_ids(root, args)
        if gated_run_ids != run_ids:
            raise DispatchError("legacy baseline inventory changed during activation gate")
        gated_batch = _read_legacy_activation_batch(root)
        if gated_batch is not None:
            if batch is None or gated_batch != batch:
                raise DispatchError("legacy activation batch changed during activation gate")
            if all_runs and gated_batch["run_ids"] != run_ids:
                raise DispatchError("legacy activation run inventory changed during activation gate")
            if not all_runs and run_ids[0] not in gated_batch["run_ids"]:
                raise DispatchError("legacy activation run is outside sealed activation batch")
            activation_generation = str(gated_batch["activation_generation"])
            activation_cutoff = str(gated_batch["activation_cutoff"])
            gated_plan = _legacy_baseline_plan(
                root,
                run_ids,
                activation_generation=activation_generation,
                activation_cutoff=activation_cutoff,
                activation_batch_id=activation_batch_id,
                allow_exclusions=all_runs,
            )
            if all_runs and gated_batch["phase"] == "PREPARED":
                prepared = _legacy_activation_batch_payload(
                    activation_generation,
                    activation_cutoff,
                    gated_plan,
                    phase="PREPARED",
                )
                if gated_batch != prepared:
                    raise DispatchError("prepared legacy activation batch conflicts with plan")
                statuses = [
                    (run, path, baseline, _legacy_baseline_target_status(path, baseline))
                    for run, path, baseline in gated_plan
                ]
                for _, path, baseline, status in statuses:
                    if status == "missing":
                        _write_json_nofollow(
                            root=root,
                            path=path,
                            payload=baseline,
                            existing_equal_ok=True,
                        )
                for run, path, baseline, _ in statuses:
                    _legacy_batch_target_status(
                        path,
                        baseline,
                        str(prepared["target_sha256"][run]),
                    )
                _write_json_nofollow(
                    root=root,
                    path=_legacy_activation_batch_path(root),
                    payload=_legacy_activation_batch_payload(
                        activation_generation,
                        activation_cutoff,
                        gated_plan,
                        phase="SEALED",
                    ),
                    expected=prepared,
                )
            else:
                if gated_batch["phase"] != "SEALED":
                    raise DispatchError("single-run activation cannot recover a prepared batch")
                statuses = [
                    (
                        run,
                        path,
                        baseline,
                        _legacy_batch_target_status(
                            path,
                            baseline,
                            str(gated_batch["target_sha256"][run]),
                        ),
                    )
                    for run, path, baseline in gated_plan
                ]
        elif batch is not None:
            raise DispatchError("legacy activation batch disappeared during activation gate")
        else:
            gated_plan = _legacy_baseline_plan(
                root,
                run_ids,
                activation_generation=activation_generation,
                activation_cutoff=activation_cutoff,
                activation_batch_id=activation_batch_id,
                allow_exclusions=all_runs,
            )
            if gated_plan != plan:
                raise DispatchError("legacy baseline inventory changed during activation gate")
            if all_runs:
                statuses = [
                    (run, path, baseline, _legacy_baseline_target_status(path, baseline))
                    for run, path, baseline in gated_plan
                ]
                if any(status != "missing" for _, _, _, status in statuses):
                    raise DispatchError(
                        "legacy activation has mixed existing and missing baselines"
                    )
                prepared = _legacy_activation_batch_payload(
                    activation_generation,
                    activation_cutoff,
                    gated_plan,
                    phase="PREPARED",
                )
                _write_json_nofollow(
                    root=root,
                    path=_legacy_activation_batch_path(root),
                    payload=prepared,
                    existing_equal_ok=True,
                )
                for _, path, baseline, _ in statuses:
                    _write_json_nofollow(
                        root=root,
                        path=path,
                        payload=baseline,
                        existing_equal_ok=True,
                    )
                for run, path, baseline, _ in statuses:
                    _legacy_batch_target_status(
                        path,
                        baseline,
                        str(prepared["target_sha256"][run]),
                    )
                _write_json_nofollow(
                    root=root,
                    path=_legacy_activation_batch_path(root),
                    payload=_legacy_activation_batch_payload(
                        activation_generation,
                        activation_cutoff,
                        gated_plan,
                        phase="SEALED",
                    ),
                    expected=prepared,
                )
            else:
                statuses = [
                    (run, path, baseline, _legacy_baseline_target_status(path, baseline))
                    for run, path, baseline in gated_plan
                ]
                for _, path, baseline, _ in statuses:
                    _write_json_nofollow(
                        root=root,
                        path=path,
                        payload=baseline,
                        existing_equal_ok=True,
                    )
    written_paths = [rel(path, root) for _, path, _, status in statuses if status == "missing"]
    equal_paths = [rel(path, root) for _, path, _, status in statuses if status == "equal"]
    payload = {
        "ok": True,
        "activation_generation": activation_generation,
        "activation_cutoff": activation_cutoff,
        "run_count": len(run_ids),
        "entry_count": sum(len(baseline["entries"]) for _, _, baseline, _ in statuses),
        "written_paths": written_paths,
        "equal_paths": equal_paths,
    }
    if len(statuses) == 1:
        run, path, baseline, _ = statuses[0]
        payload.update(
            {
                "run_id": run,
                "baseline_path": rel(path, root),
                "entry_count": len(baseline["entries"]),
            }
        )
    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(f"activation_generation: {payload['activation_generation']}")
        print(f"activation_cutoff: {payload['activation_cutoff']}")
        print(f"runs: {payload['run_count']}")
        print(f"entries: {payload['entry_count']}")
        print(f"written_paths: {', '.join(payload['written_paths']) or '-'}")
        print(f"equal_paths: {', '.join(payload['equal_paths']) or '-'}")
    return 0


def command_new_task(args: argparse.Namespace) -> int:
    ensure_nonempty_task_body(args.body)
    root = root_path(args.root)
    backend = getattr(args, "backend", RUNTIME_BACKEND)
    task_contract = parse_task_contract_json(
        getattr(args, "task_contract_json", "")
    )
    worker, _worker_scope = resolve_dispatch_worker(
        root,
        args.worker,
        backend=backend,
    )
    operation_contract = _prepare_worker_dispatch_operation_contract(
        root,
        task_contract,
        str(worker["worker_id"]),
        task_id=args.task,
    )
    capability = _extract_run_one_capability(task_contract)
    dispatch_claim = _reserve_worker_dispatch_claim(
        root=root,
        args=args,
        capability=capability,
        worker_id=str(worker["worker_id"]),
        task_id=args.task,
        run_id=args.run,
    )
    if dispatch_claim["action"] == "reuse":
        return _return_reused_run_one_dispatch_claim(
            root=root,
            claim=dispatch_claim,
        )
    session_decision = run_one_session_decision(args)
    rotation_request = run_one_rotation_request(
        args,
        task_id=args.task,
        attempt_id=args.run,
        role=str(worker.get("role") or "visible-worker"),
        contract_hash=_canonical_json_hash(
            {"title": args.title, "body": args.body}
        ),
    )
    try:
        with _authorized_task_preparation(
            root,
            operation_contract,
            str(worker["worker_id"]),
        ):
            tdir = create_task(
                root,
                args.run,
                args.task,
                str(worker["worker_id"]),
                args.title,
                args.body,
                runtime_backend=backend,
                runtime_backend_type=backend_type_for(backend),
                task_contract=task_contract,
                operation_contract=operation_contract,
                session_action=str(session_decision.get("session_action") or ""),
            )
            write_task_session_action(
                tdir,
                str(worker["worker_id"]),
                session_decision,
                args=args,
                rotation_request=rotation_request,
            )
        dispatch_claim = mark_run_one_dispatch_claim_prepared(
            root=root,
            claim=dispatch_claim,
            tdir=tdir,
        )
    except DispatchError:
        _revoke_worker_dispatch_authorization(
            root,
            operation_contract,
            str(worker["worker_id"]),
            provenance="dispatch-rejected-revoke",
        )
        raise
    print(f"created_task: {rel(tdir, root)}")
    print(f"worker: {worker['worker_id']}")
    print(f"runtime_backend: {backend}")
    print(f"worker_role: {worker.get('role') or '-'}")
    print(f"prompt: {rel(tdir / 'prompt.txt', root)}")
    return 0


def session_rotation_requirement_path(
    root: Path,
    worker_id: str,
) -> Path:
    return visible_task_state.session_rotation_requirement_path(
        root,
        worker_id,
    )


def record_session_rotation_requirement(
    root: Path,
    worker_id: str,
    *,
    run: str,
    task: str,
    provider_error: dict[str, Any],
) -> dict[str, Any]:
    try:
        with visible_registry_lock(root):
            return visible_task_state.record_session_rotation_requirement_locked(
                root,
                worker_id,
                run=run,
                task=task,
                provider_error=provider_error,
            )
    except visible_task_state.TaskStateError as exc:
        raise DispatchError(str(exc)) from exc


def require_session_rotation_for_submit(
    root: Path,
    worker_id: str,
    rotation_request: dict[str, str] | None,
) -> dict[str, Any]:
    requirement = read_json(
        session_rotation_requirement_path(root, worker_id)
    )
    if requirement.get("status") != "required":
        return {}
    if rotation_request is None:
        raise DispatchError(
            f"worker {worker_id} requires controlled session rotation "
            "before submit"
        )
    expected_reason = str(
        requirement.get("rotation_reason")
        or "context_contaminated"
    )
    if rotation_request.get("rotation_reason") != expected_reason:
        raise DispatchError(
            f"worker {worker_id} rotation_reason must be "
            f"{expected_reason}"
        )
    return requirement


def clear_session_rotation_requirement(
    root: Path,
    worker_id: str,
    *,
    expected_fence: dict[str, Any],
    run: str,
    task: str,
    rotation: dict[str, Any],
) -> dict[str, Any]:
    path = session_rotation_requirement_path(root, worker_id)
    current = read_json(path)
    if (
        current.get("status") != "required"
        or str(current.get("fence_id") or "")
        != str(expected_fence.get("fence_id") or "")
    ):
        raise DispatchError(
            "session rotation requirement changed before clearance"
        )
    fresh_session_id = str(rotation.get("session_id") or "")
    contaminated_session_id = str(
        current.get("source_session_id") or ""
    )
    session_clearance = bool(
        contaminated_session_id.startswith("ses_")
        and fresh_session_id.startswith("ses_")
        and fresh_session_id != contaminated_session_id
    )
    fresh_process = (
        rotation.get("fresh_process")
        if isinstance(rotation.get("fresh_process"), dict)
        else {}
    )
    fresh_process_instance_id = str(
        fresh_process.get("instance_id") or ""
    )
    fresh_process_generation = int(
        fresh_process.get("binding_generation") or 0
    )
    fresh_process_fencing_generation = int(
        fresh_process.get("fencing_generation")
        or fresh_process_generation
        or 0
    )
    process_restart_evidence = str(
        fresh_process.get("process_restart_evidence") or ""
    ).strip()
    source_dispatch = read_json(
        task_dir(
            root,
            str(current.get("source_run_id") or ""),
            str(current.get("source_task_id") or ""),
        )
        / "dispatch.json"
    )
    source_worker = (
        source_dispatch.get("worker_record")
        if isinstance(source_dispatch.get("worker_record"), dict)
        else {}
    )
    source_instance = derive_process_instance(source_worker)
    source_instance_id = str(source_instance.get("instance_id") or "")
    source_generation = int(
        source_worker.get("binding_generation") or 0
    )
    source_fencing_generation = int(
        source_worker.get("fencing_generation")
        or source_generation
        or 0
    )
    process_clearance = bool(
        rotation.get("fresh_process_status") == "verified_fresh_process"
        and process_restart_evidence
        and fresh_process_instance_id.startswith("vw-inst-")
        and source_instance_id.startswith("vw-inst-")
        and fresh_process_instance_id != source_instance_id
        and fresh_process_generation > source_generation
        and fresh_process_fencing_generation > source_fencing_generation
    )
    fresh_home_clearance = bool(
        not fresh_session_id
        and rotation.get("fresh_home_without_session_proven") is True
    )
    if (
        not session_clearance
        and not process_clearance
        and not fresh_home_clearance
    ):
        raise DispatchError(
            "verified rotation did not prove a fresh session"
        )
    clearance_mode = (
        "session_id"
        if session_clearance
        else (
            "verified_fresh_process"
            if process_clearance
            else "fresh_home_without_session"
        )
    )
    cleared = {
        **current,
        "status": "cleared",
        "cleared_at": utc_now(),
        "cleared_by_run": run,
        "cleared_by_task": task,
        "fresh_session_id": fresh_session_id,
        "clearance_mode": clearance_mode,
        "fresh_process_instance_id": (
            fresh_process_instance_id if process_clearance else ""
        ),
        "source_process_instance_id": (
            source_instance_id if process_clearance else ""
        ),
        "fresh_home_without_session_proven": fresh_home_clearance,
        "rotation_receipt_path": str(
            rotation.get("receipt_path") or ""
        ),
        "rotation_receipt_hash": str(
            rotation.get("receipt_hash") or ""
        ),
    }
    write_json_atomic(path, cleared)
    return cleared


def run_one_rotation_request(
    args: argparse.Namespace,
    *,
    task_id: str = "",
    attempt_id: str = "",
    role: str = "",
    contract_hash: str = "",
) -> dict[str, str] | None:
    decision = run_one_session_decision(args)
    if decision["session_action"] != "rotate":
        return None
    request = {
        "task_id": str(
            getattr(args, "rotation_task_id", "") or task_id or ""
        ),
        "attempt_id": str(
            getattr(args, "rotation_attempt_id", "") or attempt_id or ""
        ),
        "role": str(getattr(args, "rotation_role", "") or role or ""),
        "contract_hash": str(
            getattr(args, "rotation_contract_hash", "")
            or contract_hash
            or ""
        ),
        "session_action_reason": decision["session_action_reason"],
        "rotation_reason": str(
            getattr(args, "rotation_reason", "") or ""
        ),
        "rehydration_packet_type": str(
            getattr(args, "rehydration_packet_type", "") or ""
        ),
        "context_domain_id": str(
            getattr(args, "context_domain_id", "") or ""
        ).strip(),
        "previous_context_domain_id": str(
            getattr(args, "previous_context_domain_id", "") or ""
        ).strip(),
    }
    missing = [
        field
        for field in (
            "task_id",
            "attempt_id",
            "role",
            "contract_hash",
            "rotation_reason",
            "rehydration_packet_type",
        )
        if not request[field]
    ]
    if missing:
        raise DispatchError(
            "run-one pre-submit rotation is missing: "
            + ", ".join(missing)
        )
    if request["rotation_reason"] not in RUN_ONE_ROTATION_REASONS:
        raise DispatchError("run-one rotation_reason is invalid")
    if (
        request["rehydration_packet_type"]
        not in RUN_ONE_REHYDRATION_PACKET_TYPES
    ):
        raise DispatchError(
            "run-one rehydration_packet_type is invalid"
        )
    if (
        request["role"] == "dual-agent-thinker-parent"
        and (
            not request["context_domain_id"]
            or not request["previous_context_domain_id"]
            or request["context_domain_id"]
            == request["previous_context_domain_id"]
        )
    ):
        raise DispatchError(
            "dual-agent-thinker rotation requires changed context-domain ids"
        )
    return request


def run_one_session_decision(args: argparse.Namespace) -> dict[str, str]:
    action = str(getattr(args, "session_action", "") or "")
    try:
        actions = resolve_session_actions(
            [action] if action else [],
            ["selected-worker"],
            reason=str(getattr(args, "session_action_reason", "") or ""),
            rotation_reason=str(getattr(args, "rotation_reason", "") or ""),
            rehydration_packet_type=str(
                getattr(args, "rehydration_packet_type", "") or ""
            ),
            required=True,
        )
    except SessionActionError as exc:
        raise DispatchError(str(exc)) from exc
    resolved = actions["selected-worker"]
    if bool(getattr(args, "rotate_before_submit", False)) and resolved != "rotate":
        raise DispatchError(
            "--rotate-before-submit conflicts with session_action "
            + resolved
        )
    if (
        resolved == "rotate"
        and str(getattr(args, "rotation_reason", "") or "")
        == "context_domain_changed"
        and (
            not str(getattr(args, "context_domain_id", "") or "").strip()
            or not str(
                getattr(args, "previous_context_domain_id", "") or ""
            ).strip()
            or str(getattr(args, "context_domain_id", "") or "").strip()
            == str(
                getattr(args, "previous_context_domain_id", "") or ""
            ).strip()
        )
    ):
        raise DispatchError(
            "context_domain_changed rotation requires changed context-domain "
            "ids; a fresh worker without previous context must use "
            "session_action=keep"
        )
    return {
        "session_action": resolved,
        "session_action_reason": str(
            getattr(args, "session_action_reason", "") or ""
        ),
    }


def run_one_reset_recovery_reservation(
    args: argparse.Namespace,
    *,
    session_decision: dict[str, str],
) -> dict[str, str] | None:
    values = {
        "reservation_id": str(
            getattr(args, "recovery_reservation_id", "") or ""
        ),
        "target_run_root": str(
            getattr(args, "recovery_target_run_root", "") or ""
        ),
        "contract_hash": str(
            getattr(args, "recovery_contract_hash", "") or ""
        ),
        "expected_first_lane_id": str(
            getattr(args, "recovery_first_lane_id", "") or ""
        ),
        "expected_first_request_hash": str(
            getattr(args, "recovery_first_request_hash", "") or ""
        ),
        "expected_first_dispatch_hash": str(
            getattr(args, "recovery_first_dispatch_hash", "") or ""
        ),
    }
    if not any(values.values()):
        return None
    missing = [
        field for field, value in values.items() if not value
    ]
    if missing:
        raise DispatchError(
            "reset recovery reservation is incomplete: "
            + ", ".join(missing)
        )
    if not str(getattr(args, "worker", "") or ""):
        raise DispatchError(
            "reset recovery reservation requires an explicit worker"
        )
    if session_decision["session_action"] != "keep":
        raise DispatchError(
            "reset recovery reservation requires session_action keep"
        )
    try:
        parsed = str(uuid.UUID(values["reservation_id"]))
    except ValueError as exc:
        raise DispatchError(
            "reset recovery reservation id must be a UUID"
        ) from exc
    if parsed != values["reservation_id"]:
        raise DispatchError(
            "reset recovery reservation id must use canonical UUID form"
        )
    body_lines = str(getattr(args, "body", "") or "").splitlines()
    lane_ids = [
        line.removeprefix("LANE_ID=")
        for line in body_lines
        if line.startswith("LANE_ID=")
    ]
    request_hashes = [
        line.removeprefix("REQUEST_HASH=")
        for line in body_lines
        if line.startswith("REQUEST_HASH=")
    ]
    if lane_ids != [values["expected_first_lane_id"]]:
        raise DispatchError(
            "reset recovery first lane id does not match task body"
        )
    if request_hashes != [values["expected_first_request_hash"]]:
        raise DispatchError(
            "reset recovery first request hash does not match task body"
        )
    actual_dispatch_hash = _canonical_json_hash(
        {
            "title": str(getattr(args, "title", "") or ""),
            "body": str(getattr(args, "body", "") or ""),
        }
    )
    if actual_dispatch_hash != values["expected_first_dispatch_hash"]:
        raise DispatchError(
            "reset recovery dispatch payload hash mismatch"
        )
    return values


def validate_reset_recovery_reservation_lock(
    root: Path,
    worker_id: str,
    reservation: dict[str, str],
    *,
    worker: dict[str, Any] | None = None,
    lock: dict[str, Any] | None = None,
) -> dict[str, Any]:
    target_run_root = Path(reservation["target_run_root"])
    if (
        not target_run_root.is_absolute()
        or ".." in target_run_root.parts
        or any(
            path.is_symlink()
            for path in (target_run_root, *target_run_root.parents)
        )
    ):
        raise DispatchError(
            "reset recovery reservation target run root is invalid"
        )
    resolved_target = target_run_root.resolve(strict=False)
    unsafe_runtime_root = (
        root.resolve(strict=False) / ".omx"
    ).resolve(strict=False)
    if (
        resolved_target == unsafe_runtime_root
        or unsafe_runtime_root in resolved_target.parents
        or not resolved_target.is_dir()
    ):
        raise DispatchError(
            "reset recovery reservation target run root is invalid"
        )
    lock_file = lock_path(root, worker_id)
    if lock_file.is_symlink() or not lock_file.is_file():
        raise DispatchError(
            "reset recovery reservation lock is missing"
        )
    current = dict(lock if lock is not None else read_json(lock_file))
    expected = {
        "owner_lock_id": reservation["reservation_id"],
        "worker_id": worker_id,
        "status": "reset_recovery_reserved",
        "target_run_root": str(resolved_target),
        "rotation_contract_hash": reservation["contract_hash"],
        "recovery_kind": "verify_only_consumed_reset",
        "expected_first_lane_id": reservation[
            "expected_first_lane_id"
        ],
        "expected_first_request_hash": reservation[
            "expected_first_request_hash"
        ],
        "expected_first_dispatch_hash": reservation[
            "expected_first_dispatch_hash"
        ],
    }
    mismatched = [
        field
        for field, value in expected.items()
        if current.get(field) != value
    ]
    if mismatched:
        raise DispatchError(
            "reset recovery reservation lock mismatch: "
            + ", ".join(mismatched)
        )
    if worker is not None:
        binding_fields = (
            "worker_id",
            "pane_id",
            "pane_pid",
            "port",
            "binding_generation",
            "binding_lease_id",
        )
        binding_mismatches = [
            field
            for field in binding_fields
            if str(current.get(field) or "")
            != str(worker.get(field) or "")
        ]
        if binding_mismatches:
            raise DispatchError(
                "reset recovery reservation worker binding mismatch: "
                + ", ".join(binding_mismatches)
            )
    return current


def recovery_session_decision(
    args: argparse.Namespace,
    worker_id: str,
) -> dict[str, str]:
    action = str(getattr(args, "session_action", "") or "")
    reason = str(
        getattr(args, "session_action_reason", "") or ""
    )
    try:
        actions = resolve_session_actions(
            [action] if action else [],
            [worker_id],
            reason=reason,
            required=True,
            allow_recovery=True,
        )
    except SessionActionError as exc:
        raise DispatchError(str(exc)) from exc
    if actions[worker_id] != "recovery":
        raise DispatchError(
            "recovery-handshake requires session_action recovery"
        )
    return {
        "session_action": "recovery",
        "session_action_reason": reason,
    }


def write_task_session_action(
    tdir: Path,
    worker_id: str,
    session_decision: dict[str, str],
    *,
    args: argparse.Namespace,
    rotation_request: dict[str, str] | None,
) -> dict[str, Any]:
    record = task_session_action_record(
        worker_id,
        session_decision,
        args=args,
        rotation_request=rotation_request,
    )
    write_json(tdir / "session_action.json", record)
    return record


def task_session_action_record(
    worker_id: str,
    session_decision: dict[str, str],
    *,
    args: argparse.Namespace,
    rotation_request: dict[str, str] | None,
) -> dict[str, Any]:
    record: dict[str, Any] = {
        "schema_version": 1,
        "worker_id": worker_id,
        **session_decision,
        "rotation_reason": str(
            getattr(args, "rotation_reason", "") or ""
        ),
        "rehydration_packet_type": str(
            getattr(args, "rehydration_packet_type", "") or ""
        ),
    }
    for field in ("context_domain_id", "previous_context_domain_id"):
        value = str(getattr(args, field, "") or "").strip()
        if value:
            record[field] = value
    if rotation_request is not None:
        record.update(rotation_request)
    return record


def require_supported_worker_session_action(worker: dict[str, Any],
                                           decision: dict[str, Any]) -> None:
    if (worker.get("backend") == "codex_tui"
            and decision.get("session_action") != "keep"):
        raise DispatchError(
            "codex_tui workers only support session_action keep; refusing "
            f"session_action={decision.get('session_action')} before task or lock mutation")


def validated_task_session_action(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    provided: dict[str, Any] | None = None,
) -> dict[str, Any]:
    path = task_dir(root, run, task) / "session_action.json"
    if provided is None:
        if not path.is_file():
            raise DispatchError(
                f"session action record is required: {rel(path, root)}"
            )
        record = read_json(path)
    else:
        record = dict(provided)
        if path.is_file() and read_json(path) != record:
            raise DispatchError(
                "provided session action differs from persisted "
                "session action record"
            )
    if int(record.get("schema_version") or 0) != 1:
        raise DispatchError("session action record schema_version must be 1")
    if str(record.get("worker_id") or "") != worker_id:
        raise DispatchError(
            "session action record worker does not match submit worker"
        )
    action = str(record.get("session_action") or "")
    try:
        actions = resolve_session_actions(
            [action] if action else [],
            [worker_id],
            reason=str(record.get("session_action_reason") or ""),
            rotation_reason=str(record.get("rotation_reason") or ""),
            rehydration_packet_type=str(
                record.get("rehydration_packet_type") or ""
            ),
            required=True,
        )
    except SessionActionError as exc:
        raise DispatchError(f"invalid session action record: {exc}") from exc
    record["session_action"] = actions[worker_id]
    return record


def rotation_request_from_session_action(
    record: dict[str, Any],
) -> dict[str, str] | None:
    if record["session_action"] != "rotate":
        return None
    fields = (
        "task_id",
        "attempt_id",
        "role",
        "contract_hash",
        "session_action_reason",
        "rotation_reason",
        "rehydration_packet_type",
    )
    missing = [
        field for field in fields if not str(record.get(field) or "").strip()
    ]
    if missing:
        raise DispatchError(
            "rotate session action record is missing: " + ", ".join(missing)
        )
    return {
        field: str(record.get(field) or "")
        for field in (
            *fields,
            "context_domain_id",
            "previous_context_domain_id",
        )
    }


def normalized_rotation_request(
    request: dict[str, Any],
) -> dict[str, str]:
    return {
        field: str(
            request.get(field)
            or (
                request.get("rotation_reason")
                if field == "session_action_reason"
                else ""
            )
        )
        for field in (
            "task_id",
            "attempt_id",
            "role",
            "contract_hash",
            "session_action_reason",
            "rotation_reason",
            "rehydration_packet_type",
            "context_domain_id",
            "previous_context_domain_id",
        )
    }


FRESH_PROCESS_HISTORY_MARKERS = (
    ".submitted",
    ".received",
    ".started",
    ".done",
    ".fail",
    ".blocked",
    ".heartbeat",
    "delivery.json",
    "submit_interrupted.json",
    "submit_error.json",
    "report.md",
)


def run_one_fresh_process_reset_evidence(root: Path, worker_id: str) -> str:
    tasks: list[dict[str, Any]] = []
    errors: list[str] = []
    runs_root = visible_runs_root(root)
    if not runs_root.exists():
        return ""
    try:
        run_dirs = sorted(runs_root.iterdir(), key=lambda item: item.name)
    except OSError:
        return ""
    for run_dir in run_dirs:
        if run_dir.name == "_locks":
            continue
        if run_dir.is_symlink():
            errors.append(rel(run_dir, root))
            continue
        tasks_dir = run_dir / "tasks"
        if tasks_dir.is_symlink():
            errors.append(rel(tasks_dir, root))
            continue
        if not tasks_dir.is_dir():
            continue
        try:
            task_dirs = sorted(tasks_dir.iterdir(), key=lambda item: item.name)
        except OSError:
            errors.append(rel(tasks_dir, root))
            continue
        for task_dir in task_dirs:
            if task_dir.is_symlink():
                errors.append(rel(task_dir, root))
                continue
            if not task_dir.is_dir():
                continue
            owner = read_text(task_dir / "owner").strip()
            task_json = read_json(task_dir / "task.json")
            task_worker = owner or str(
                task_json.get("worker_id") or task_json.get("worker") or ""
            ).strip()
            if task_worker != worker_id:
                continue
            markers = [
                marker
                for marker in FRESH_PROCESS_HISTORY_MARKERS
                if (task_dir / marker).exists()
            ]
            dispatch = read_json(task_dir / "dispatch.json")
            task_worker_record = (
                dispatch.get("worker_record")
                if isinstance(dispatch.get("worker_record"), dict)
                else {}
            )
            task_instance = derive_process_instance(task_worker_record)
            tasks.append(
                {
                    "path": rel(task_dir, root),
                    "markers": markers,
                    "created_at": str(dispatch.get("created_at") or ""),
                    "instance_id": str(
                        task_instance.get("instance_id") or ""
                    ),
                    "binding_generation": int(
                        task_worker_record.get("binding_generation") or 0
                    ),
                    "fencing_generation": int(
                        task_worker_record.get("fencing_generation")
                        or task_worker_record.get("binding_generation")
                        or 0
                    ),
                }
            )
    submitted = [task for task in tasks if task["markers"]]
    prepared = [task for task in tasks if not task["markers"]]
    if not errors and len(tasks) == 1 and not submitted:
        return (
            "visible-run-one:fresh-prepared-worker;"
            f"worker={worker_id};"
            f"owned_task_count={len(tasks)};"
            f"prepared_only_count={len(prepared)};"
            f"submitted_count={len(submitted)};"
            f"task_path={prepared[0]['path']}"
        )

    receipt_relative = Path(
        ".omx/framework/team"
    ) / f"opencode_visible_replace_{worker_id}.json"
    receipt_path = root / receipt_relative
    if (
        errors
        or receipt_path.is_symlink()
        or not receipt_path.is_file()
    ):
        return ""
    receipt = read_json(receipt_path)
    rebind = (
        receipt.get("rebind")
        if isinstance(receipt.get("rebind"), dict)
        else {}
    )
    doctor = (
        receipt.get("doctor")
        if isinstance(receipt.get("doctor"), dict)
        else {}
    )
    worker = worker_record(root, worker_id)
    current_instance = derive_process_instance(worker)
    current_instance_id = str(
        current_instance.get("instance_id") or ""
    )
    current_generation = int(worker.get("binding_generation") or 0)
    current_fencing_generation = int(
        worker.get("fencing_generation")
        or current_generation
        or 0
    )
    try:
        replaced_at = datetime.fromisoformat(
            str(receipt.get("replaced_at") or "").replace("Z", "+00:00")
        )
        binding_created_at = datetime.fromisoformat(
            str(
                worker.get("binding_created_at")
                or worker.get("rebind_at")
                or ""
            ).replace("Z", "+00:00")
        )
    except ValueError:
        return ""
    binding_age = (replaced_at - binding_created_at).total_seconds()
    if (
        int(receipt.get("schema_version") or 0) != 1
        or str(receipt.get("worker_id") or "") != worker_id
        or str(receipt.get("pane_id") or "")
        != str(worker.get("pane_id") or "")
        or int(receipt.get("port") or 0)
        != int(worker.get("port") or 0)
        or rebind.get("respawn_transition") is not True
        or rebind.get("post_rebind_status") != "current_binding_ok"
        or doctor.get("ok") is not True
        or str(worker.get("binding_confidence") or "") != "strong"
        or not current_instance_id.startswith("vw-inst-")
        or current_generation <= 1
        or current_fencing_generation <= 1
        or not 0 <= binding_age <= 300
    ):
        return ""

    current_process_tasks = [
        task
        for task in tasks
        if (
            task["instance_id"] == current_instance_id
            and task["binding_generation"] == current_generation
            and task["fencing_generation"]
            == current_fencing_generation
        )
    ]
    prior_process_tasks = [
        task for task in tasks if task not in current_process_tasks
    ]
    current_submitted = [
        task for task in current_process_tasks if task["markers"]
    ]
    current_prepared = [
        task for task in current_process_tasks if not task["markers"]
    ]
    if (
        len(current_process_tasks) != 1
        or current_submitted
        or len(current_prepared) != 1
        or not prior_process_tasks
        or any(
            not task["instance_id"].startswith("vw-inst-")
            or task["binding_generation"] >= current_generation
            or task["fencing_generation"] >= current_fencing_generation
            for task in prior_process_tasks
        )
    ):
        return ""
    receipt_hash = hashlib.sha256(
        json.dumps(
            receipt,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
        ).encode("utf-8")
    ).hexdigest()
    return json.dumps(
        {
            "schema_version": 1,
            "status": "verified_fresh_process",
            "worker_id": worker_id,
            "receipt_path": str(receipt_relative),
            "receipt_sha256": receipt_hash,
            "instance_id": current_instance_id,
            "binding_generation": current_generation,
            "fencing_generation": current_fencing_generation,
            "opencode_pid": int(current_instance.get("opencode_pid") or 0),
            "opencode_start_time_ticks": int(
                current_instance.get("opencode_start_time_ticks") or 0
            ),
            "current_process_task_count": len(current_process_tasks),
            "prior_process_task_count": len(prior_process_tasks),
            "prepared_only_count": len(current_prepared),
            "submitted_count": len(current_submitted),
        },
        sort_keys=True,
        separators=(",", ":"),
    )


def _canonical_json_hash(payload: Any) -> str:
    encoded = json.dumps(
        payload,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
    ).encode("utf-8")
    return "sha256:" + hashlib.sha256(encoded).hexdigest()


def _canonical_dispatch_contract_hash(
    task_contract: dict[str, Any] | None,
    operation_contract: dict[str, Any],
    *,
    worker_id: str,
    task_id: str,
    attempt_id: str,
) -> str:
    task_contract_without_capability = dict(task_contract) if task_contract else {}
    task_contract_without_capability.pop("operation_capability", None)
    return _canonical_json_hash(
        {
            "task_contract": task_contract_without_capability,
            "operation_contract": operation_contract,
            "worker_id": worker_id,
            "task_id": task_id,
            "attempt_id": attempt_id,
        }
    )


def _rotation_receipt_reference(stdout: str) -> Path:
    observed = [
        match.group(1).strip()
        for line in stdout.splitlines()
        if (
            match := re.fullmatch(
                r"rotation_receipt:\s*(.*?)\s*",
                line,
            )
        )
    ]
    unique = list(dict.fromkeys(value for value in observed if value))
    if len(unique) != 1:
        raise DispatchError(
            "verify-reset-real must emit one unique rotation receipt"
        )
    relative = Path(unique[0])
    if relative.is_absolute() or ".." in relative.parts:
        raise DispatchError(
            "rotation receipt must be control-root relative"
        )
    return relative


def _resolve_rotation_receipt(
    root: Path,
    worker_id: str,
    reference: str | Path,
) -> tuple[Path, Path]:
    relative = Path(reference)
    if relative.is_absolute() or ".." in relative.parts:
        raise DispatchError(
            "rotation receipt must be control-root relative"
        )
    expected_relative_root = (
        Path(".omx/framework/team/session-rotations") / worker_id
    )
    if (
        relative.name == "latest.json"
        or expected_relative_root not in relative.parents
    ):
        raise DispatchError(
            "rotation receipt must be unique and worker scoped"
        )
    path = root / relative
    if path.is_symlink():
        raise DispatchError("rotation receipt must not be a symlink")
    try:
        resolved = path.resolve(strict=True)
    except (FileNotFoundError, OSError) as exc:
        raise DispatchError(
            f"rotation receipt not found: {relative}"
        ) from exc
    control_root = root.resolve()
    expected_root = (root / expected_relative_root).resolve()
    if control_root not in expected_root.parents:
        raise DispatchError("rotation receipt escapes control root")
    if expected_root not in resolved.parents:
        raise DispatchError("rotation receipt escapes worker scope")
    return relative, resolved


def _rotation_receipt_mismatches(
    receipt: dict[str, Any],
    *,
    worker_id: str,
    request: dict[str, str],
    expected_lock: dict[str, Any],
    expected_binding: dict[str, Any] | None = None,
) -> list[str]:
    expected = {
        "schema_version": "1",
        "receipt_kind": "worker_session_rotation",
        "worker_id": worker_id,
        "task_id": request["task_id"],
        "attempt_id": request["attempt_id"],
        "role": request["role"],
        "contract_hash": request["contract_hash"],
        "session_action": "rotate",
        "session_action_reason": (
            request.get("session_action_reason")
            or request["rotation_reason"]
        ),
        "rotation_reason": request["rotation_reason"],
        "rehydration_packet_type": request[
            "rehydration_packet_type"
        ],
        "binding_confidence": "strong",
    }
    mismatched = [
        field
        for field, value in expected.items()
        if str(receipt.get(field) or "") != value
    ]
    if not str(receipt.get("evidence_source") or "").strip():
        mismatched.append("evidence_source")
    if not str(receipt.get("checked_at") or "").strip():
        mismatched.append("checked_at")
    reset_evidence = receipt.get("reset_evidence")
    if (
        not isinstance(reset_evidence, dict)
        or reset_evidence.get("found") is not True
        or not str(reset_evidence.get("source") or "").strip()
    ):
        mismatched.append("reset_evidence")
    selection = receipt.get("selection_continuity")
    if not isinstance(selection, dict):
        mismatched.append("selection_continuity")
    elif selection.get("status") == "preserved_fresh_home":
        if (
            receipt.get("session_id")
            or not isinstance(reset_evidence, dict)
            or reset_evidence.get("fresh_home_without_session_proven") is not True
        ):
            mismatched.append("selection_continuity.fresh_home")
    elif selection.get("status") == "preserved_session_selection":
        before = selection.get("before")
        after = selection.get("after")
        if (
            not isinstance(before, dict) or before != after
            or not before.get("agent")
            or not isinstance(before.get("model"), dict)
            or not before["model"].get("providerID")
            or not before["model"].get("modelID")
            or not isinstance(before.get("variant"), str)
            or selection.get("visible_select_ack") is not True
            or not receipt.get("session_id")
            or receipt.get("old_session_id") == receipt.get("session_id")
        ):
            mismatched.append("selection_continuity.session_selection")
    else:
        mismatched.append("selection_continuity.status")

    binding = receipt.get("binding_snapshot")
    post_binding = receipt.get("post_binding_snapshot")
    side_effect_fence = receipt.get("side_effect_fence")
    acceptance_fence = receipt.get("acceptance_fence")
    if not isinstance(binding, dict):
        mismatched.append("binding_snapshot")
        binding = {}
    if not isinstance(post_binding, dict):
        mismatched.append("post_binding_snapshot")
        post_binding = {}
    if not isinstance(side_effect_fence, dict):
        mismatched.append("side_effect_fence")
        side_effect_fence = {}
    if not isinstance(acceptance_fence, dict):
        mismatched.append("acceptance_fence")
        acceptance_fence = {}

    if str(binding.get("worker_id") or "") != worker_id:
        mismatched.append("binding_snapshot.worker_id")
    if str(binding.get("binding_confidence") or "") != "strong":
        mismatched.append("binding_snapshot.binding_confidence")
    for field in ("instance_id", "pane_id"):
        if not str(binding.get(field) or ""):
            mismatched.append(f"binding_snapshot.{field}")
    try:
        if int(binding.get("port") or 0) <= 0:
            mismatched.append("binding_snapshot.port")
    except (TypeError, ValueError):
        mismatched.append("binding_snapshot.port")

    lock_binding_fields = {
        "pane_id": expected_lock.get("pane_id"),
        "pane_pid": expected_lock.get("pane_pid"),
        "port": expected_lock.get("port"),
        "binding_generation": expected_lock.get(
            "binding_generation"
        ),
    }
    for field, value in lock_binding_fields.items():
        if str(binding.get(field) or "") != str(value or ""):
            mismatched.append(f"binding_snapshot.{field}")

    if expected_binding is not None:
        current_instance = derive_process_instance(expected_binding)
        current_binding = {
            "worker_id": str(expected_binding.get("worker_id") or ""),
            "instance_id": str(
                current_instance.get("instance_id") or ""
            ),
            "pane_id": str(expected_binding.get("pane_id") or ""),
            "pane_pid": expected_binding.get("pane_pid"),
            "port": expected_binding.get("port"),
            "binding_generation": expected_binding.get(
                "binding_generation"
            ),
            "fencing_generation": (
                expected_binding.get("fencing_generation")
                or expected_binding.get("binding_generation")
            ),
            "lease_id": str(expected_binding.get("lease_id") or ""),
            "lease_owner": str(
                expected_binding.get("lease_owner") or ""
            ),
            "lease_status": str(
                expected_binding.get("lease_status") or "unmanaged"
            ),
        }
        for field, value in current_binding.items():
            receipt_value = binding.get(field)
            if field == "lease_status":
                receipt_value = receipt_value or "unmanaged"
            if str(receipt_value or "") != str(value or ""):
                mismatched.append(f"binding_snapshot.{field}")

    stable_binding_fields = (
        "worker_id",
        "instance_id",
        "pane_id",
        "pane_pid",
        "port",
        "binding_generation",
        "fencing_generation",
        "lease_id",
        "lease_status",
    )
    for field in stable_binding_fields:
        if str(post_binding.get(field) or "") != str(
            binding.get(field) or ""
        ):
            mismatched.append(f"post_binding_snapshot.{field}")

    fence_fields = (
        "worker_id",
        "instance_id",
        "pane_id",
        "pane_pid",
        "port",
        "binding_generation",
        "fencing_generation",
        "lease_id",
        "lease_owner",
        "lease_status",
    )
    for field in fence_fields:
        if str(side_effect_fence.get(field) or "") != str(
            binding.get(field) or ""
        ):
            mismatched.append(f"side_effect_fence.{field}")
        if str(acceptance_fence.get(field) or "") != str(
            side_effect_fence.get(field) or ""
        ):
            mismatched.append(f"acceptance_fence.{field}")
    for field, value in (
        ("task_id", request["task_id"]),
        ("attempt_id", request["attempt_id"]),
        ("contract_hash", request["contract_hash"]),
    ):
        if str(acceptance_fence.get(field) or "") != value:
            mismatched.append(f"acceptance_fence.{field}")
    receipt_session_id = str(receipt.get("session_id") or "")
    if str(receipt.get("new_session_id") or "") != receipt_session_id:
        mismatched.append("new_session_id")
    if (
        str(acceptance_fence.get("session_id") or "")
        != receipt_session_id
    ):
        mismatched.append("acceptance_fence.session_id")

    for field in (
        "pane_id",
        "pane_pid",
        "port",
        "binding_generation",
    ):
        if str(receipt.get(field) or "") != str(
            binding.get(field) or ""
        ):
            mismatched.append(field)
    return sorted(set(mismatched))


def _claim_rotation_receipt_consumption(
    root: Path,
    worker_id: str,
    *,
    run: str,
    task: str,
    receipt_relative: Path,
    receipt_hash: str,
    request: dict[str, str],
) -> str:
    worker_root = (
        root
        / ".omx/framework/team/session-rotations"
        / worker_id
    ).resolve()
    consumed_dir = worker_root / "consumed"
    consumed_dir.mkdir(parents=True, exist_ok=True)
    if (
        consumed_dir.is_symlink()
        or consumed_dir.resolve().parent != worker_root
    ):
        raise DispatchError(
            "rotation receipt consumption path escapes worker scope"
        )

    # ponytail: claims are sparse; add an index only if this scan is measurable.
    for existing_path in consumed_dir.glob("*.json"):
        if existing_path.is_symlink():
            raise DispatchError(
                "rotation receipt consumption claim must not be a symlink"
            )
        existing = read_json(existing_path)
        if (
            str(existing.get("receipt_path") or "")
            == str(receipt_relative)
            and str(existing.get("receipt_hash") or "")
            != receipt_hash
        ):
            raise DispatchError(
                "rotation receipt changed after consumption"
            )

    claim_path = (
        consumed_dir
        / f"{receipt_hash.removeprefix('sha256:')}.json"
    )
    if claim_path.is_symlink():
        raise DispatchError(
            "rotation receipt consumption claim must not be a symlink"
        )
    existing = read_json(claim_path)
    if existing and (
        str(existing.get("target_visible_run") or "") != run
        or str(existing.get("target_visible_task") or "") != task
    ):
        raise DispatchError(
            "rotation receipt already consumed by "
            f"{existing.get('target_visible_run')}/"
            f"{existing.get('target_visible_task')}"
        )
    claim = {
        "schema_version": 1,
        "claim_kind": "rotation_receipt_consumption",
        "receipt_path": str(receipt_relative),
        "receipt_hash": receipt_hash,
        "worker_id": worker_id,
        "target_visible_run": run,
        "target_visible_task": task,
        "rotation_task_id": request["task_id"],
        "rotation_attempt_id": request["attempt_id"],
        "contract_hash": request["contract_hash"],
        "consumed_at": str(existing.get("consumed_at") or utc_now()),
    }
    write_json_exclusive_or_equal(claim_path, claim)
    return rel(claim_path, root)


def _terminal_fence_generation_allowed(
    fence_binding: Any, fence_fencing: Any,
    current_binding: Any, current_fencing: Any,
) -> bool:
    # A same-process binding repair advances the live generations without
    # changing the worker or its process-lifecycle identity, so a terminal
    # fence written before that repair stays a verifiable rotation source
    # while its generations are positive true ints, keep fencing generation
    # at or above binding generation, and are historical-or-equal to the
    # current ones (issue #1012).
    for value in (fence_binding, fence_fencing, current_binding, current_fencing):
        if type(value) is not int or value <= 0:
            return False
    if fence_fencing < fence_binding or current_fencing < current_binding:
        return False
    return fence_binding <= current_binding and fence_fencing <= current_fencing


def terminal_rotation_source_session(
    root: Path, worker: dict[str, Any], *, run: str, task: str,
) -> str:
    worker_id = str(worker["worker_id"])
    candidates = [
        item for item in visible_tasks(root, worker_id=worker_id)
        if (item["run"], item["task"]) != (run, task)
        and item.get("protocol_terminal_state") in VALID_TERMINAL_STATES
    ]
    if not candidates:
        return ""
    latest = max(candidates, key=lambda item: (str(item.get("updated_at") or ""), item["run"], item["task"]))
    fence = read_json(task_dir(root, latest["run"], latest["task"]) / "acceptance_fence.json")
    instance = derive_process_instance(worker)
    current_binding = worker.get("binding_generation")
    current_fencing = (
        worker.get("fencing_generation") or worker.get("binding_generation")
    )
    generations_match_current = (
        fence.get("binding_generation") == current_binding
        and fence.get("fencing_generation") == current_fencing
    )
    if (
        fence.get("worker_id") != worker_id
        or fence.get("instance_id") != instance.get("instance_id")
        or not (
            generations_match_current
            or (
                str(instance.get("identity_strength") or "") == "process_lifecycle"
                and _terminal_fence_generation_allowed(
                    fence.get("binding_generation"), fence.get("fencing_generation"),
                    current_binding, current_fencing,
                )
            )
        )
    ):
        return ""
    session_id = str(fence.get("session_id") or "")
    return session_id if session_id.startswith("ses_") else ""


def execute_reserved_session_rotation(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    runtime_backend: str,
    expected_lock: dict[str, Any],
    request: dict[str, str],
    rotation_receipt: str = "",
    expected_binding: dict[str, Any] | None = None,
) -> dict[str, Any]:
    lock_file = lock_path(root, worker_id)
    current_lock = read_json(lock_file)
    if (
        owner_lock_transition_fence(current_lock)
        != owner_lock_transition_fence(expected_lock)
        or str(current_lock.get("status") or "")
        != "rotation_reserved"
    ):
        raise DispatchError(
            "rotation reservation changed before reset execution"
        )
    rotation_args = [
        "--root",
        str(root),
        "--worker",
        worker_id,
        "--runtime-backend",
        runtime_backend,
        "--allow-real",
        "--task-id",
        request["task_id"],
        "--attempt-id",
        request["attempt_id"],
        "--role",
        request["role"],
        "--contract-hash",
        request["contract_hash"],
        "--rotation-reason",
        request["rotation_reason"],
        "--rehydration-packet-type",
        request["rehydration_packet_type"],
    ]
    if request.get("context_domain_id"):
        rotation_args.extend(
            ["--context-domain-id", request["context_domain_id"]]
        )
    if request.get("previous_context_domain_id"):
        rotation_args.extend(
            [
                "--previous-context-domain-id",
                request["previous_context_domain_id"],
            ]
        )
    source_session_id = str(expected_lock.get("rotation_source_session_id") or "")
    if source_session_id:
        rotation_args.extend(["--selection-session-id", source_session_id])
    process_restart_evidence = run_one_fresh_process_reset_evidence(
        root,
        worker_id,
    )
    if process_restart_evidence:
        rotation_args.extend(
            [
                "--worker-process-restarted-after-last-task",
                "--process-restart-evidence",
                process_restart_evidence,
            ]
        )

    execute_argv = [
        str(adapter_path(root)),
        "execute-command-real",
        *rotation_args,
        "--command",
        "/new",
    ]
    if rotation_receipt:
        result = {
            "returncode": 0,
            "stdout": f"rotation_receipt: {rotation_receipt}\n",
            "stderr": "",
        }
    else:
        result = run_command(execute_argv, root, timeout=180)
    if result.get("returncode") != 0:
        raise DispatchError(
            "reset rotation failed; no automatic retry after potentially created session: "
            + str(result.get("stdout") or result.get("stderr") or "unknown error")[-4000:]
        )

    receipt_relative = _rotation_receipt_reference(
        str(result.get("stdout") or "")
    )

    receipt_relative, resolved_receipt = _resolve_rotation_receipt(
        root,
        worker_id,
        receipt_relative,
    )
    receipt = read_json(resolved_receipt)
    mismatched = _rotation_receipt_mismatches(
        receipt,
        worker_id=worker_id,
        request=request,
        expected_lock=expected_lock,
        expected_binding=expected_binding,
    )
    if mismatched:
        raise DispatchError(
            "rotation receipt mismatch: "
            + ", ".join(mismatched)
        )
    current_lock = read_json(lock_file)
    if (
        owner_lock_transition_fence(current_lock)
        != owner_lock_transition_fence(expected_lock)
        or str(current_lock.get("status") or "")
        != "rotation_reserved"
    ):
        raise DispatchError(
            "rotation reservation changed during verify-reset-real"
        )
    receipt_hash = _canonical_json_hash(receipt)
    consumption_path = ""
    if rotation_receipt:
        consumption_path = _claim_rotation_receipt_consumption(
            root,
            worker_id,
            run=run,
            task=task,
            receipt_relative=receipt_relative,
            receipt_hash=receipt_hash,
            request=request,
        )
    record = {
        "schema_version": 1,
        "worker_id": worker_id,
        "run_id": run,
        "task_id": task,
        "receipt_path": str(receipt_relative),
        "receipt_hash": receipt_hash,
        "contract_hash": request["contract_hash"],
        "rotation_reason": request["rotation_reason"],
        "rehydration_packet_type": request[
            "rehydration_packet_type"
        ],
        "session_id": str(receipt.get("session_id") or ""),
        "checked_at": str(receipt.get("checked_at") or ""),
        "evidence_source": str(
            receipt.get("evidence_source") or ""
        ),
        "fresh_process_status": str(
            receipt.get("fresh_process_status") or ""
        ),
    }
    reset_evidence = (
        receipt.get("reset_evidence")
        if isinstance(receipt.get("reset_evidence"), dict)
        else {}
    )
    record["fresh_home_without_session_proven"] = bool(
        not record["session_id"]
        and reset_evidence.get("found") is True
        and reset_evidence.get("fresh_home_without_session_proven") is True
        and (
            reset_evidence.get("command_ack_found") is True
            or (receipt.get("selection_continuity") or {}).get("status") == "preserved_fresh_home"
        )
        and reset_evidence.get("status_empty_found") is True
        and reset_evidence.get("tui_home_evidence_found") is True
    )
    record["selection_continuity"] = receipt.get("selection_continuity") or {}
    binding_snapshot = (
        receipt.get("binding_snapshot")
        if isinstance(receipt.get("binding_snapshot"), dict)
        else {}
    )
    if record["fresh_process_status"] == "verified_fresh_process":
        record["fresh_process"] = {
            "instance_id": str(
                binding_snapshot.get("instance_id") or ""
            ),
            "binding_generation": int(
                binding_snapshot.get("binding_generation") or 0
            ),
            "fencing_generation": int(
                binding_snapshot.get("fencing_generation")
                or binding_snapshot.get("binding_generation")
                or 0
            ),
            "process_restart_evidence": str(
                reset_evidence.get("process_restart_evidence") or ""
            ),
        }
    if consumption_path:
        record["consumption_path"] = consumption_path
    write_json(task_dir(root, run, task) / "session_rotation.json", record)
    return record


def renew_binding_lease_for_submit(
    root: Path,
    worker_id: str,
    *,
    expected_fence: tuple[str, ...],
) -> dict[str, Any]:
    """Renew the worker binding lease through sanctioned adapter verification.

    A fenced pre-submit rotation can outlive the remaining binding lease
    (issue #870): the dispatch-side lease gate passes, the rotation runs,
    and the real submit then fails on the now-expired lease after side
    effects already happened. ``verify-visible --update-registry`` is the
    existing sanctioned renewal: it re-collects live pane/process/port
    evidence, keeps the lease id and binding generations, and extends only
    ``binding_expires_at``, so identity, fence, owner, and grant checks stay
    intact. The adapter takes the same registry lock file as this dispatch,
    so it must run outside ``visible_registry_lock``.
    """
    result = run_command(
        [
            str(adapter_path(root)),
            "verify-visible",
            "--root",
            str(root),
            "--worker",
            worker_id,
            "--update-registry",
        ],
        root,
        timeout=120,
    )
    if result.get("returncode") != 0:
        detail = (
            str(result.get("stderr") or "").strip()
            or str(result.get("stdout") or "").strip()
        )
        raise DispatchError(
            "binding lease renewal for submit failed: "
            f"{detail or 'unknown error'}"
        )
    renewed = worker_record(root, worker_id)
    if worker_binding_fence(renewed) != expected_fence:
        raise DispatchError(
            "worker binding changed during binding lease renewal"
        )
    require_binding_lease_for_submit(renewed)
    return renewed


def submit_task(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    allow_real: bool,
    runtime_backend: str = RUNTIME_BACKEND,
    pre_submit_rotation: dict[str, str] | None = None,
    rotation_receipt: str = "",
    session_decision: dict[str, Any] | None = None,
    reset_recovery_reservation: dict[str, str] | None = None,
    expected_instance_id: str = "",
    expected_binding_generation: int | None = None,
    expected_fencing_generation: int | None = None,
    supervision_run_id: str = "",
    supervision_logical_action_id: str = "",
    supervision_lease_epoch: int | None = None,
    supervision_fencing_token: str = "",
) -> int:
    if not allow_real:
        raise DispatchError("submit requires --allow-real")
    if (
        reset_recovery_reservation is not None
        and pre_submit_rotation is not None
    ):
        raise DispatchError(
            "reset recovery reservation conflicts with pre-submit rotation"
        )
    defer_session_action_validation = any(
        (
            bool(expected_instance_id),
            expected_binding_generation is not None,
            expected_fencing_generation is not None,
            bool(supervision_run_id),
            bool(supervision_logical_action_id),
            supervision_lease_epoch is not None,
            bool(supervision_fencing_token),
        )
    )
    decision: dict[str, Any] | None = None
    if not defer_session_action_validation:
        decision = validated_task_session_action(
            root,
            run,
            task,
            worker_id,
            provided=session_decision,
        )
        recorded_rotation = rotation_request_from_session_action(decision)
        if pre_submit_rotation is None:
            pre_submit_rotation = recorded_rotation
        else:
            pre_submit_rotation = normalized_rotation_request(
                pre_submit_rotation
            )
            if recorded_rotation != pre_submit_rotation:
                raise DispatchError(
                    "pre-submit rotation does not match session action record"
                )
        if (
            reset_recovery_reservation is not None
            and decision.get("session_action") != "keep"
        ):
            raise DispatchError(
                "reset recovery reservation requires session_action keep"
            )
    if rotation_receipt:
        preflight_decision = decision
        if preflight_decision is None:
            preflight_decision = validated_task_session_action(
                root,
                run,
                task,
                worker_id,
                provided=session_decision,
            )
        preflight_rotation = rotation_request_from_session_action(
            preflight_decision
        )
        if preflight_rotation is None:
            raise DispatchError(
                "--rotation-receipt requires recorded session_action=rotate"
            )
        if (
            pre_submit_rotation is not None
            and normalized_rotation_request(pre_submit_rotation)
            != preflight_rotation
        ):
            raise DispatchError(
                "pre-submit rotation does not match session action record"
            )
        _resolve_rotation_receipt(
            root,
            worker_id,
            rotation_receipt,
        )
    rotation_requirement: dict[str, Any] = {}
    with global_mutation_gate(root, exclusive=False):
        worker = worker_record(root, worker_id)
        ensure_worker_allowed(root, worker, must_be_default=False)
        require_binding_lease_for_submit(worker)
        worker_id = str(worker["worker_id"])
        agent_backend = str(worker.get("backend") or "opencode_tui")
        if decision is not None:
            require_supported_worker_session_action(worker, decision)
            rotation_requirement = require_session_rotation_for_submit(
                root,
                worker_id,
                pre_submit_rotation,
            )
        tdir = task_dir(root, run, task)
        if not (tdir / "prompt.txt").is_file():
            raise DispatchError(f"prompt not found: {rel(tdir / 'prompt.txt', root)}")
        try:
            task_contract = load_clean_room_task_contract(tdir / "task.json")
        except CleanRoomStartupError as exc:
            raise DispatchError(str(exc)) from exc
        try:
            server_selector = extract_opencode_server_prompt_async_canary(
                task_contract if isinstance(task_contract, dict) else None
            )
        except OperationAuthorizationError as exc:
            raise DispatchError(str(exc)) from exc
        if agent_backend == "codex_tui" and server_selector is not None:
            raise DispatchError(
                "codex_tui workers do not support the OpenCode server "
                "selector path"
            )
        verify_worker(
            root,
            worker_id,
            backend=runtime_backend,
            require_tui_endpoints=server_selector is None,
        )
        if agent_backend == "codex_tui":
            load_codex_adapter_module(root).codex_preflight(
                root, worker_id, framework_run_arg(run), task
            )
        elif server_selector is None:
            endpoint_schema(root, int(worker["port"]))
        require_clean_room_startup_gate(
            root,
            worker,
            task_contract,
        )
        if agent_backend == "codex_tui":
            pass
        elif server_selector is None:
            readiness = ensure_tui_ready_for_submit(root, worker_id)
            write_json(tdir / "pre_submit_tui_readiness.json", readiness)
        else:
            adapter = load_adapter_module(root)
            if server_selector.get("session_mode") == "create":
                if decision is None or decision.get("session_action") != "keep":
                    raise DispatchError(
                        "cold-start session creation requires session_action keep"
                    )
                if (
                    isinstance(task_contract, dict)
                    and task_contract.get("clean_room_startup") is not None
                ):
                    raise DispatchError(
                        "cold-start session creation forbids clean_room_startup"
                    )
                session_list = adapter.session_list_snapshot(
                    root,
                    worker_id,
                    runtime_backend=runtime_backend,
                )
                session_status = adapter.session_status_snapshot(
                    root,
                    worker_id,
                    runtime_backend=runtime_backend,
                )
                if (
                    int(session_list.get("session_count") or 0) != 0
                    or int(session_status.get("status_count") or 0) != 0
                ):
                    raise DispatchError(
                        "cold-start session creation requires empty session "
                        "list and no active status"
                    )
                fence = read_json(tdir / "acceptance_fence.json")
                if (
                    str(fence.get("session_id") or "")
                    or str(fence.get("session_fence_state") or "")
                    != "pending_live_observation"
                ):
                    raise DispatchError(
                        "cold-start session creation requires a pending "
                        "empty session fence"
                    )
                write_json(
                    tdir / "pre_submit_server_preflight.json",
                    {
                        "session_mode": "create",
                        "session_list": session_list,
                        "session_status": session_status,
                    },
                )
            else:
                identity = adapter.session_identity_snapshot(
                    root,
                    worker_id,
                    server_selector["session_id"],
                    runtime_backend=runtime_backend,
                )
                if not isinstance(identity, dict) or not identity.get("exists"):
                    raise DispatchError(
                        "server selector session is not live on the bound worker"
                    )
                write_json(
                    tdir / "pre_submit_server_preflight.json",
                    {
                        "session_id": server_selector["session_id"],
                        "identity": identity,
                    },
                )
        if (tdir / ".submitted").exists():
            raise DispatchError(f"task already submitted: {rel(tdir / '.submitted', root)}")
        with visible_registry_lock(root):
            locked_worker = worker_record(root, worker_id)
            if worker_binding_fence(locked_worker) != worker_binding_fence(worker):
                raise DispatchError(
                    f"worker {worker_id} binding changed before owner lock acquisition"
                )
            require_expected_worker_binding(
                locked_worker,
                expected_instance_id=expected_instance_id,
                expected_binding_generation=expected_binding_generation,
                expected_fencing_generation=expected_fencing_generation,
            )
            require_supervision_dispatch_claim(
                root,
                supervision_run_id=supervision_run_id,
                supervision_logical_action_id=supervision_logical_action_id,
                supervision_lease_epoch=supervision_lease_epoch,
                supervision_fencing_token=supervision_fencing_token,
            )
            if decision is None:
                decision = validated_task_session_action(
                    root,
                    run,
                    task,
                    worker_id,
                    provided=session_decision,
                )
                require_supported_worker_session_action(locked_worker, decision)
                recorded_rotation = rotation_request_from_session_action(
                    decision
                )
                if pre_submit_rotation is None:
                    pre_submit_rotation = recorded_rotation
                else:
                    pre_submit_rotation = normalized_rotation_request(
                        pre_submit_rotation
                    )
                    if recorded_rotation != pre_submit_rotation:
                        raise DispatchError(
                            "pre-submit rotation does not match session "
                            "action record"
                        )
                if rotation_receipt and pre_submit_rotation is None:
                    raise DispatchError(
                        "--rotation-receipt requires recorded "
                        "session_action=rotate"
                    )
                if rotation_receipt:
                    _resolve_rotation_receipt(
                        root,
                        worker_id,
                        rotation_receipt,
                    )
            require_no_provider_inspection_pending_for_submit_locked(
                root,
                worker_id,
            )
            rotation_requirement = require_session_rotation_for_submit(
                root,
                worker_id,
                pre_submit_rotation,
            )
            lock_file = lock_path(root, worker_id)
            if reset_recovery_reservation is not None:
                current_reservation = (
                    validate_reset_recovery_reservation_lock(
                        root,
                        worker_id,
                        reset_recovery_reservation,
                        worker=locked_worker,
                    )
                )
                with _operation_mutation_boundary(
                    root,
                    tdir,
                    worker_id,
                    applied_mutation_gates=(
                        WORKER_DISPATCH_ENFORCED_GATES
                    ),
                ):
                    pass
                refresh_task_acceptance_fence(
                    root,
                    run,
                    task,
                    locked_worker,
                )
                reserved_version = owner_lock_version(
                    current_reservation
                )
                consumed_version = reserved_version + 1
                consumption_path = (
                    tdir
                    / "reset_recovery_reservation_consumption.json"
                )
                consumption = {
                    "schema_version": 1,
                    "consumption_kind": (
                        "reset_recovery_first_dispatch"
                    ),
                    "status": "claimed",
                    "reservation_id": reset_recovery_reservation[
                        "reservation_id"
                    ],
                    "owner_lock_id": reset_recovery_reservation[
                        "reservation_id"
                    ],
                    "worker_id": worker_id,
                    "source_run": current_reservation.get("run"),
                    "source_task": current_reservation.get("task"),
                    "target_run_root": reset_recovery_reservation[
                        "target_run_root"
                    ],
                    "contract_hash": reset_recovery_reservation[
                        "contract_hash"
                    ],
                    "expected_first_lane_id": (
                        reset_recovery_reservation[
                            "expected_first_lane_id"
                        ]
                    ),
                    "expected_first_request_hash": (
                        reset_recovery_reservation[
                            "expected_first_request_hash"
                        ]
                    ),
                    "expected_first_dispatch_hash": (
                        reset_recovery_reservation[
                            "expected_first_dispatch_hash"
                        ]
                    ),
                    "target_visible_run": run,
                    "target_visible_task": task,
                    "reserved_owner_lock_version": reserved_version,
                    "consumed_owner_lock_version": consumed_version,
                }
                write_json_exclusive_or_equal(
                    consumption_path,
                    consumption,
                )
                lock_data = {
                    **current_reservation,
                    "owner_lock_version": consumed_version,
                    "runtime_backend": runtime_backend,
                    "run": run,
                    "task": task,
                    "pane_id": locked_worker.get("pane_id"),
                    "pane_pid": locked_worker.get("pane_pid"),
                    "port": (int(locked_worker["port"]) if locked_worker.get("port") is not None else None),
                    "tmux_session": locked_worker.get("tmux_session"),
                    "tmux_window": locked_worker.get("tmux_window"),
                    "listener_pids": locked_worker.get(
                        "listener_pids",
                        [],
                    ),
                    "opencode_pids": locked_worker.get(
                        "opencode_pids",
                        [],
                    ),
                    "opencode_pid": locked_worker.get("opencode_pid"),
                    "binding_generation": locked_worker.get(
                        "binding_generation"
                    ),
                    "binding_lease_id": locked_worker.get(
                        "binding_lease_id"
                    ),
                    "binding_expires_at": locked_worker.get(
                        "binding_expires_at"
                    ),
                    "status": "submitting",
                    "task_dir": rel(tdir, root),
                    "owner": "omx_visible_dispatch",
                    "updated_at": utc_now(),
                    "recovery_source_run": current_reservation.get(
                        "run"
                    ),
                    "recovery_source_task": current_reservation.get(
                        "task"
                    ),
                    "recovery_reservation_status": "consumed",
                    "recovery_reservation_consumed_at": utc_now(),
                    "recovery_reserved_owner_lock_version": (
                        reserved_version
                    ),
                    "recovery_consumed_owner_lock_version": (
                        consumed_version
                    ),
                    "recovery_consumption_sidecar": rel(
                        consumption_path,
                        root,
                    ),
                }
                write_json_atomic(lock_file, lock_data)
            else:
                lock = resolve_lock(
                    root,
                    worker_id,
                    auto_release_terminal=False,
                )
                if lock.get("active"):
                    raise DispatchError(
                        f"active_task_exists for {worker_id}: "
                        f"{lock.get('path')}"
                    )
                lock_data = {
                    "schema_version": 1,
                    "owner_lock_id": str(uuid.uuid4()),
                    "owner_lock_version": 1,
                    "worker_id": worker_id,
                    "runtime_backend": runtime_backend,
                    "run": run,
                    "task": task,
                    "created_at": utc_now(),
                    "pane_id": locked_worker.get("pane_id"),
                    "pane_pid": locked_worker.get("pane_pid"),
                    "port": (int(locked_worker["port"]) if locked_worker.get("port") is not None else None),
                    "tmux_session": locked_worker.get("tmux_session"),
                    "tmux_window": locked_worker.get("tmux_window"),
                    "host_boot_id": locked_worker.get("host_boot_id"),
                    "tmux_server_pid": locked_worker.get("tmux_server_pid"),
                    "instance_id": locked_worker.get("instance_id"),
                    "fencing_generation": locked_worker.get(
                        "fencing_generation"
                    ),
                    "pane_start_time_ticks": locked_worker.get(
                        "pane_start_time_ticks"
                    ),
                    "opencode_start_time_ticks": locked_worker.get(
                        "opencode_start_time_ticks"
                    ),
                    "listener_pids": locked_worker.get(
                        "listener_pids",
                        [],
                    ),
                    "opencode_pids": locked_worker.get(
                        "opencode_pids",
                        [],
                    ),
                    "opencode_pid": locked_worker.get("opencode_pid"),
                    "binding_generation": locked_worker.get(
                        "binding_generation"
                    ),
                    "binding_lease_id": locked_worker.get(
                        "binding_lease_id"
                    ),
                    "binding_expires_at": locked_worker.get(
                        "binding_expires_at"
                    ),
                    "status": (
                        "rotation_reserved"
                        if pre_submit_rotation is not None
                        else "submitting"
                    ),
                    "task_dir": rel(tdir, root),
                    "owner": "omx_visible_dispatch",
                }
                if pre_submit_rotation is not None:
                    lock_data["rotation_source_session_id"] = (
                        str(locked_worker.get("session_id") or "")
                        or terminal_rotation_source_session(root, locked_worker, run=run, task=task)
                    )
                    lock_data["rotation_contract_hash"] = (
                        pre_submit_rotation["contract_hash"]
                    )
                    lock_data["rotation_reason"] = (
                        pre_submit_rotation["rotation_reason"]
                    )
                with _operation_mutation_boundary(
                    root,
                    tdir,
                    worker_id,
                    applied_mutation_gates=(
                        WORKER_DISPATCH_ENFORCED_GATES
                    ),
                ):
                    if pre_submit_rotation is None:
                        refresh_task_acceptance_fence(
                            root,
                            run,
                            task,
                            locked_worker,
                        )
                    create_owner_lock(lock_file, lock_data)
    if reset_recovery_reservation is not None:
        print(
            "recovery_reservation_consumed: "
            + reset_recovery_reservation["reservation_id"]
        )
    if pre_submit_rotation is not None:
        try:
            rotation = execute_reserved_session_rotation(
                root,
                run,
                task,
                worker_id,
                runtime_backend=runtime_backend,
                expected_lock=lock_data,
                request=pre_submit_rotation,
                rotation_receipt=rotation_receipt,
                expected_binding=(
                    locked_worker if rotation_receipt else None
                ),
            )
            submitting_lock = {
                **lock_data,
                "owner_lock_version": (
                    owner_lock_version(lock_data) + 1
                ),
                "status": "submitting",
                "rotation_receipt_path": rotation["receipt_path"],
                "rotation_receipt_hash": rotation["receipt_hash"],
                "updated_at": utc_now(),
            }
            update_owner_lock(
                lock_file,
                submitting_lock,
                expected_status="rotation_reserved",
                expected_version=owner_lock_version(lock_data),
            )
            lock_data = submitting_lock
            with visible_registry_lock(root):
                current_worker = worker_record(root, worker_id)
                if worker_binding_fence(
                    current_worker
                ) != worker_binding_fence(worker):
                    raise DispatchError(
                        "worker binding changed after session rotation"
                    )
                current_lock = read_json(lock_file)
                if (
                    owner_lock_transition_fence(current_lock)
                    != owner_lock_transition_fence(lock_data)
                ):
                    raise DispatchError(
                        "owner lock changed after session rotation"
                    )
                refresh_task_acceptance_fence(
                    root,
                    run,
                    task,
                    current_worker,
                    rotation_session_id=rotation["session_id"],
                )
                if rotation_requirement:
                    clear_session_rotation_requirement(
                        root,
                        worker_id,
                        expected_fence=rotation_requirement,
                        run=run,
                        task=task,
                        rotation=rotation,
                    )
            # The rotation window can outlive the binding lease (issue #870).
            # Renew through the sanctioned adapter verification path whenever
            # the lease cannot cover the imminent submit window, before the
            # adapter-side lease gate turns an already-rotated dispatch into
            # an ambiguous submit failure. Runs outside visible_registry_lock
            # because the adapter takes the same registry lock file.
            lease_remaining = binding_lease_seconds_remaining(current_worker)
            if (
                lease_remaining is None
                or lease_remaining <= SUBMIT_BINDING_LEASE_MARGIN_SECONDS
            ):
                renewed_worker = renew_binding_lease_for_submit(
                    root,
                    worker_id,
                    expected_fence=worker_binding_fence(worker),
                )
                print(
                    "binding_lease_renewed_for_submit: "
                    f"{renewed_worker.get('binding_expires_at')}"
                )
            print(f"rotation_receipt: {rotation['receipt_path']}")
        except Exception as exc:
            failed_at = utc_now()
            error_doc = {
                "schema_version": 1,
                "failed_at": failed_at,
                "run": run,
                "task": task,
                "worker": worker_id,
                "error": str(exc),
            }
            write_json(
                tdir / "session_rotation_error.json",
                error_doc,
            )
            write_json(
                tdir / "submit_error.json",
                {
                    "schema_version": 1,
                    "failed_at": failed_at,
                    "run": run,
                    "task": task,
                    "worker": worker_id,
                    "rotation_error_path": rel(
                        tdir / "session_rotation_error.json",
                        root,
                    ),
                    "error": str(exc),
                    "submitted_exists": (tdir / ".submitted").exists(),
                },
            )
            current_lock = read_json(lock_file)
            if (
                owner_lock_identity(current_lock)
                == owner_lock_identity(lock_data)
                and str(current_lock.get("status") or "")
                in {"rotation_reserved", "submitting"}
            ):
                failed_lock = {
                    **current_lock,
                    "owner_lock_version": (
                        owner_lock_version(current_lock) + 1
                    ),
                    "status": "rotation_failed",
                    "updated_at": failed_at,
                    "rotation_error_path": rel(
                        tdir / "session_rotation_error.json",
                        root,
                    ),
                }
                update_owner_lock(
                    lock_file,
                    failed_lock,
                    expected_status=str(
                        current_lock.get("status") or ""
                    ),
                    expected_version=owner_lock_version(
                        current_lock
                    ),
                )
                archive_lock(
                    root,
                    lock_file,
                    "pre_submit_rotation_failed",
                    expected=failed_lock,
                )
            print(
                f"ERROR: pre-submit session rotation failed: {exc}",
                file=sys.stderr,
            )
            _record_operation_receipt(
                root,
                tdir,
                worker_id,
                outcome="rejected",
                submitted_before=False,
                submitted_after=(tdir / ".submitted").exists(),
            )
            return 1
    submit_adapter_path = (
        codex_adapter_path(root)
        if agent_backend == "codex_tui"
        else adapter_path(root)
    )
    argv = [
        str(submit_adapter_path),
        "submit-visible-real",
        "--root",
        str(root),
        "--run",
        framework_run_arg(run),
        "--task",
        task,
        "--worker",
        worker_id,
        "--allow-real",
    ]
    try:
        result = run_command(argv, root, timeout=90)
    except KeyboardInterrupt:
        record_submit_interruption(
            root,
            tdir,
            lock_file,
            lock_data,
            run=run,
            task=task,
            worker_id=worker_id,
        )
        print(
            "ERROR: submit interrupted; delivery remains uncertain",
            file=sys.stderr,
        )
        _record_operation_receipt(
            root,
            tdir,
            worker_id,
            outcome="ambiguous",
            submitted_before=False,
            submitted_after=(tdir / ".submitted").exists(),
        )
        return 130
    if result["returncode"] != 0:
        error_doc = {
            "schema_version": 1,
            "failed_at": utc_now(),
            "run": run,
            "task": task,
            "worker": worker_id,
            "adapter_result": result,
            "submitted_exists": (tdir / ".submitted").exists(),
        }
        adapter_error_path = tdir / "submit_error.json"
        if not adapter_error_path.is_file():
            write_json(adapter_error_path, error_doc)
        else:
            try:
                preserved = read_json(adapter_error_path)
            except Exception:
                preserved = None
            if not isinstance(preserved, dict):
                write_json(adapter_error_path, error_doc)
        submitted_after = bool(error_doc["submitted_exists"])
        # A positive pre-delivery rejection is an explicit, deterministic adapter
        # refusal (e.g. stale acceptance fence) where .submitted definitely does
        # not exist.  Timeout or any other non-zero exit is ambiguous: the adapter
        # may have already handed the prompt to the TUI server before the client
        # side observed the result, so we must preserve the grant and the active
        # lock for settlement/reconciliation.
        positive_rejection = (
            not submitted_after
            and not result.get("timed_out")
            and (
                is_stale_acceptance_fence_submit_error(result)
                or _native_submit_positive_rejection(root, tdir)
            )
        )
        if positive_rejection:
            current_version = owner_lock_version(lock_data)
            lock_data = {
                **lock_data,
                "owner_lock_version": current_version + 1,
                "status": "submit_failed",
                "updated_at": error_doc["failed_at"],
                "submit_error_path": rel(tdir / "submit_error.json", root),
            }
            update_owner_lock(
                lock_file,
                lock_data,
                expected_status="submitting",
                expected_version=current_version,
            )
            archive_lock(
                root,
                lock_file,
                "submit_failed_before_submitted",
                expected=lock_data,
            )
        _record_operation_receipt(
            root,
            tdir,
            worker_id,
            outcome="rejected" if positive_rejection else "ambiguous",
            submitted_before=False,
            submitted_after=submitted_after,
        )
        print(result["stdout"], end="")
        print(result["stderr"], end="", file=sys.stderr)
        return result["returncode"] or 1

    current_version = owner_lock_version(lock_data)
    lock_data = {
        **lock_data,
        "owner_lock_version": current_version + 1,
        "status": "submitted",
        "submitted_at": utc_now(),
    }
    receipt_path = _record_operation_receipt(
        root,
        tdir,
        worker_id,
        outcome="applied",
        submitted_before=False,
        submitted_after=True,
    )
    finalize_delivered_owner_lock(
        root,
        tdir,
        lock_file,
        lock_data,
        event_name="visible_dispatch_submitted",
    )
    print(result["stdout"], end="")
    print(f"run_id: {run}")
    print(f"task_id: {task}")
    print(f"task_dir: {rel(tdir, root)}")
    print(f"lock: {rel(lock_file, root)}")
    print(f"delivery: {rel(tdir / 'delivery.json', root)}")
    print(f"operation_receipt: {rel(receipt_path, root)}")
    return 0


def _native_submit_positive_rejection(root: Path, tdir: Path) -> bool:
    codex_error = _read_json_nofollow(
        root=root,
        path=tdir / "submit_error.json",
        missing_ok=True,
    )
    if isinstance(codex_error, dict):
        codex_error_outcome = str(codex_error.get("error") or "")
        if codex_error_outcome or "client_result" in codex_error:
            return bool(
                not (tdir / ".submitted").exists()
                and codex_error_outcome.startswith("refused_")
                and codex_error_outcome != "refused_existing_evidence_dir"
            )
    delivery_error = _read_json_nofollow(
        root=root,
        path=tdir / "delivery_error.json",
        missing_ok=True,
    )
    if not isinstance(delivery_error, dict):
        return False
    responses = delivery_error.get("responses")
    failed_endpoint = str(delivery_error.get("failed_endpoint") or "")
    return (
        isinstance(responses, dict)
        and "/tui/submit-prompt" not in responses
        and failed_endpoint
        in {"binding_fence", "/tui/clear-prompt", "/tui/append-prompt"}
    )


def submit_task_native(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    allow_real: bool,
    runtime_backend: str = RUNTIME_BACKEND,
    session_decision: dict[str, Any] | None = None,
) -> int:
    if not allow_real:
        raise DispatchError("submit-native requires --allow-real")
    decision = validated_task_session_action(
        root,
        run,
        task,
        worker_id,
        provided=session_decision,
    )
    if decision["session_action"] == "rotate":
        raise DispatchError(
            "submit-native does not support session_action rotate"
        )
    if runtime_backend != "tmux-reference":
        raise DispatchError("submit-native currently only supports --backend tmux-reference")
    with global_mutation_gate(root, exclusive=False):
        worker = worker_record(root, worker_id)
        ensure_worker_allowed(root, worker, must_be_default=False)
        require_binding_lease_for_submit(worker)
        worker_id = str(worker["worker_id"])
        agent_backend = str(worker.get("backend") or "opencode_tui")
        require_supported_worker_session_action(worker, decision)
        require_session_rotation_for_submit(
            root,
            worker_id,
            None,
        )
        verify_worker(root, worker_id, backend=runtime_backend)
        tdir = task_dir(root, run, task)
        if not (tdir / "prompt.txt").is_file():
            raise DispatchError(f"prompt not found: {rel(tdir / 'prompt.txt', root)}")
        try:
            task_contract = load_clean_room_task_contract(tdir / "task.json")
        except CleanRoomStartupError as exc:
            raise DispatchError(str(exc)) from exc
        try:
            if extract_opencode_server_prompt_async_canary(
                task_contract if isinstance(task_contract, dict) else None
            ) is not None:
                raise DispatchError(
                    "opencode_server_prompt_async_canary is not supported on submit-native"
                )
        except OperationAuthorizationError as exc:
            raise DispatchError(str(exc)) from exc
        clean_room_startup = (
            task_contract.get("clean_room_startup")
            if isinstance(task_contract, dict)
            and isinstance(task_contract.get("clean_room_startup"), dict)
            else None
        )
        require_clean_room_startup_gate(
            root,
            worker,
            task_contract,
        )
        prompt_body = read_text(tdir / "prompt.txt")
        if not prompt_body.strip():
            raise DispatchError(f"prompt is empty: {rel(tdir / 'prompt.txt', root)}")
        if (tdir / ".submitted").exists():
            raise DispatchError(f"task already submitted: {rel(tdir / '.submitted', root)}")
        with visible_registry_lock(root):
            locked_worker = worker_record(root, worker_id)
            if worker_binding_fence(locked_worker) != worker_binding_fence(worker):
                raise DispatchError(
                    f"worker {worker_id} binding changed before owner lock acquisition"
                )
            require_no_provider_inspection_pending_for_submit_locked(
                root,
                worker_id,
            )
            require_session_rotation_for_submit(
                root,
                worker_id,
                None,
            )
            lock = resolve_lock(root, worker_id, auto_release_terminal=False)
            if lock.get("active"):
                raise DispatchError(f"active_task_exists for {worker_id}: {lock.get('path')}")

            lock_file = lock_path(root, worker_id)
            lock_data = {
                "schema_version": 1,
                "owner_lock_id": str(uuid.uuid4()),
                "owner_lock_version": 1,
                "worker_id": worker_id,
                "runtime_backend": runtime_backend,
                "run": run,
                "task": task,
                "created_at": utc_now(),
                "pane_id": locked_worker.get("pane_id"),
                "pane_pid": locked_worker.get("pane_pid"),
                "port": (int(locked_worker["port"]) if locked_worker.get("port") is not None else None),
                "tmux_session": locked_worker.get("tmux_session"),
                "tmux_window": locked_worker.get("tmux_window"),
                "host_boot_id": locked_worker.get("host_boot_id"),
                "tmux_server_pid": locked_worker.get("tmux_server_pid"),
                "instance_id": locked_worker.get("instance_id"),
                "fencing_generation": locked_worker.get(
                    "fencing_generation"
                ),
                "pane_start_time_ticks": locked_worker.get(
                    "pane_start_time_ticks"
                ),
                "opencode_start_time_ticks": locked_worker.get(
                    "opencode_start_time_ticks"
                ),
                "listener_pids": locked_worker.get("listener_pids", []),
                "opencode_pids": locked_worker.get("opencode_pids", []),
                "opencode_pid": locked_worker.get("opencode_pid"),
                "binding_generation": locked_worker.get("binding_generation"),
                "binding_lease_id": locked_worker.get("binding_lease_id"),
                "binding_expires_at": locked_worker.get("binding_expires_at"),
                "status": "submitting",
                "task_dir": rel(tdir, root),
                "owner": "omx_visible_dispatch_native",
            }
            with _operation_mutation_boundary(
                root,
                tdir,
                worker_id,
                applied_mutation_gates=(
                    WORKER_DISPATCH_ENFORCED_GATES
                ),
            ):
                acceptance_fence = refresh_task_acceptance_fence(
                    root,
                    run,
                    task,
                    locked_worker,
                )
                prompt_body = read_text(tdir / "prompt.txt")
                create_owner_lock(lock_file, lock_data)
    try:
        if agent_backend == "codex_tui":
            load_codex_adapter_module(root).submit_visible_real_runtime(
                root,
                framework_run_arg(run),
                task,
                worker_id,
                runtime_backend=runtime_backend,
            )
        else:
            module = load_adapter_module(root)
            readiness = tui_readiness(root, worker_id)
            write_json(tdir / "pre_submit_tui_readiness.json", readiness)
            capabilities = {}
            collect_caps = getattr(module, "collect_cli_capabilities", None)
            if callable(collect_caps):
                try:
                    capabilities = collect_caps(root)
                except Exception:
                    capabilities = {}
            features = capabilities.get("features", {}) if isinstance(capabilities, dict) else {}
            supports_attach_run = bool(features.get("supports_run") and features.get("supports_attach"))
            if supports_attach_run:
                validate_native_submit_guard(
                    root,
                    run,
                    task,
                    worker_id,
                    expected_worker=worker,
                    expected_lock=lock_data,
                )
                session_observation: dict[str, Any] = {}
                if clean_room_startup is not None:
                    observe_session = getattr(
                        module,
                        "acceptance_session_observation",
                        None,
                    )
                    if not callable(observe_session):
                        raise DispatchError(
                            "clean_room_startup_session_observer_unavailable"
                        )
                    session_observation = observe_session(
                        root,
                        worker_id,
                        acceptance_fence,
                        runtime_backend=runtime_backend,
                        allow_pending=False,
                        fence_path=tdir / "acceptance_fence.json",
                    )
                    acceptance_fence = dict(
                        session_observation.get("fence")
                        or acceptance_fence
                    )
                    if (
                        not session_observation.get("ok")
                        or str(
                            acceptance_fence.get("session_fence_state")
                            or ""
                        )
                        != "live_observed"
                    ):
                        raise DispatchError(
                            "clean_room_startup_session_not_live_observed"
                        )
                submitted_path = tdir / ".submitted"
                try:
                    arm_clean_room_startup_session(
                        root,
                        tdir,
                        worker_id,
                        str(acceptance_fence.get("session_id") or ""),
                        task_contract,
                    )
                except CleanRoomStartupError as exc:
                    raise DispatchError(str(exc)) from exc
                module.write_marker(submitted_path)
                submitted_at = utc_now()
                bound_session_id = str(
                    acceptance_fence.get("session_id") or ""
                )
                argv = [
                    shutil.which("opencode") or "opencode",
                    "run",
                    "--attach",
                    str(worker.get("base_url") or f"http://127.0.0.1:{int(worker.get('port'))}"),
                ]
                if clean_room_startup is not None:
                    argv.extend(["--session", bound_session_id])
                argv.extend(
                    [
                        "--format",
                        "json",
                        "--dir",
                        str(root),
                        prompt_body,
                    ]
                )
                result = run_command(argv, root, timeout=300)
                parsed = parse_opencode_run_json_events(str(result.get("stdout") or ""))
                if result["returncode"] != 0:
                    raise DispatchError(
                        f"opencode run --attach failed: {result.get('stderr') or result.get('stdout') or result.get('returncode')}"
                    )
                if (
                    clean_room_startup is not None
                    and str(parsed.get("session_id") or "")
                    != bound_session_id
                ):
                    raise DispatchError(
                        "clean_room_startup_session_mismatch: "
                        f"expected={bound_session_id or '-'} "
                        f"observed={parsed.get('session_id') or '-'}"
                    )
                delivery = {
                    "schema_version": 1,
                    "mode": "visible-native-cli-attach",
                    "attempted_at": lock_data["created_at"],
                    "submitted_at": submitted_at,
                    "run": run,
                    "task": task,
                    "worker": worker_id,
                    "runtime_backend": runtime_backend,
                    "host": "127.0.0.1",
                    "port": int(worker.get("port")),
                    "pane_id": worker.get("pane_id"),
                    "pane_pid": worker.get("pane_pid"),
                    "base_url": str(worker.get("base_url") or f"http://127.0.0.1:{int(worker.get('port'))}"),
                    "prompt_path": rel(tdir / "prompt.txt", root),
                    "prompt_bytes": len(prompt_body.encode("utf-8")),
                    "prompt_sha256": hashlib.sha256(prompt_body.encode("utf-8")).hexdigest(),
                    "submitted_marker": rel(submitted_path, root),
                    "received_written_by_adapter": False,
                    "received": False,
                    "state_note": "submitted marker was written before official cli attach-run; worker still owns .received/.started/.done/.fail/.blocked",
                    "cli_capabilities": capabilities,
                    "live_session_observation": session_observation,
                    "command": {
                        "argv": argv,
                        "returncode": result.get("returncode"),
                        "stderr": result.get("stderr", ""),
                        "elapsed_seconds": result.get("elapsed_seconds"),
                        "timed_out": result.get("timed_out", False),
                    },
                    "responses": {
                        "opencode_run_attach": {
                            "ok": True,
                            "status": 0,
                            "session_id": parsed.get("session_id", ""),
                            "final_text": parsed.get("final_text", ""),
                            "event_count": parsed.get("event_count", 0),
                        }
                    },
                    "events_jsonl": parsed.get("events", []),
                    "adapter_never_writes": [
                        ".received",
                        ".started",
                        ".heartbeat",
                        ".done",
                        ".fail",
                        ".blocked",
                    ],
                    "adapter_writes_only": [
                        ".submitted",
                        "delivery.json",
                        "submit_error.json",
                        "events.jsonl",
                    ],
                }
                write_json(tdir / "delivery.json", delivery)
            else:
                endpoint_schema(root, int(worker["port"]))
                ensured = ensure_tui_ready_for_submit(root, worker_id)
                write_json(tdir / "pre_submit_tui_readiness.json", ensured)
                module.submit_visible_real_runtime(
                    root,
                    framework_run_arg(run),
                    task,
                    worker_id,
                    runtime_backend=runtime_backend,
                )
    except Exception as exc:
        submitted_exists = (tdir / ".submitted").exists()
        positive_rejection = (
            not submitted_exists
            and _native_submit_positive_rejection(root, tdir)
        )
        error_doc = {
            "schema_version": 1,
            "failed_at": utc_now(),
            "run": run,
            "task": task,
            "worker": worker_id,
            "error": str(exc),
            "submitted_exists": submitted_exists,
            "submit_mode": "rmux_native_inline",
        }
        if not (tdir / "submit_error.json").is_file():
            write_json(tdir / "submit_error.json", error_doc)
        if positive_rejection:
            lock_data = {
                **lock_data,
                "owner_lock_version": 2,
                "status": "submit_failed",
                "updated_at": error_doc["failed_at"],
                "submit_error_path": rel(tdir / "submit_error.json", root),
            }
            update_owner_lock(
                lock_file,
                lock_data,
                expected_status="submitting",
                expected_version=1,
            )
            archive_lock(
                root,
                lock_file,
                "submit_failed_before_submitted",
                expected=lock_data,
            )
        _record_operation_receipt(
            root,
            tdir,
            worker_id,
            outcome="rejected" if positive_rejection else "ambiguous",
            submitted_before=False,
            submitted_after=submitted_exists,
        )
        raise DispatchError(str(exc)) from exc

    lock_data = {
        **lock_data,
        "owner_lock_version": 2,
        "status": "submitted",
        "submitted_at": utc_now(),
    }
    receipt_path = _record_operation_receipt(
        root,
        tdir,
        worker_id,
        outcome="applied",
        submitted_before=False,
        submitted_after=True,
    )
    finalize_delivered_owner_lock(
        root,
        tdir,
        lock_file,
        lock_data,
        event_name="visible_dispatch_submitted_native",
    )
    print(f"run_id: {run}")
    print(f"task_id: {task}")
    print(f"task_dir: {rel(tdir, root)}")
    print(f"lock: {rel(lock_file, root)}")
    print(f"delivery: {rel(tdir / 'delivery.json', root)}")
    print(f"operation_receipt: {rel(receipt_path, root)}")
    return 0


def command_submit_native(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    backend = getattr(args, "backend", RUNTIME_BACKEND)
    run = args.run
    task = args.task
    if args.worker:
        worker, _scope = resolve_dispatch_worker(
            root,
            args.worker,
            backend=backend,
        )
        worker_id = str(worker["worker_id"])
    else:
        summary = build_doctor_report(root, worker_id=None, backend=backend)
        if not summary.get("ok"):
            raise DispatchError("submit-native preflight failed; run doctor first")
        worker_id = str(summary.get("default_worker", {}).get("worker_id") or "")
    return submit_task_native(root, run, task, worker_id, allow_real=args.allow_real, runtime_backend=backend)


def command_submit(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    if args.worker:
        worker = worker_record(root, args.worker)
    else:
        owner = read_text(task_dir(root, args.run, args.task) / "owner").strip()
        worker = worker_record(root, owner or None)
    return submit_task(
        root,
        args.run,
        args.task,
        str(worker["worker_id"]),
        allow_real=args.allow_real,
        runtime_backend=getattr(args, "backend", RUNTIME_BACKEND),
        rotation_receipt=getattr(args, "rotation_receipt", ""),
        expected_instance_id=getattr(args, "expected_instance_id", ""),
        expected_binding_generation=getattr(
            args,
            "expected_binding_generation",
            None,
        ),
        expected_fencing_generation=getattr(
            args,
            "expected_fencing_generation",
            None,
        ),
        supervision_run_id=getattr(args, "supervision_run_id", ""),
        supervision_logical_action_id=getattr(
            args,
            "supervision_logical_action_id",
            "",
        ),
        supervision_lease_epoch=getattr(args, "supervision_lease_epoch", None),
        supervision_fencing_token=getattr(
            args,
            "supervision_fencing_token",
            "",
        ),
    )


def unique_run_id(root: Path) -> str:
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S")
    nonce = uuid.uuid4().hex[:8]
    base = f"visible-run-{stamp}Z-{nonce}"
    candidate = base
    index = 2
    while (visible_runs_root(root) / candidate).exists():
        candidate = f"{base}-{index}"
        index += 1
    return candidate


def parse_task_contract_json(value: str) -> dict[str, Any] | None:
    raw = str(value or "").strip()
    if not raw:
        return None
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise DispatchError(f"invalid task contract JSON: {exc.msg}") from exc
    if not isinstance(payload, dict):
        raise DispatchError("task contract JSON must be an object")
    return payload


def _run_one_operation_contract(
    task_contract: dict[str, Any] | None,
) -> dict[str, Any]:
    try:
        return derive_operation_contract("worker_dispatch", task_contract)
    except OperationAuthorizationError as exc:
        raise DispatchError(str(exc)) from exc


def _run_one_operation_capability(
    root: Path,
    task_contract: dict[str, Any] | None,
    worker_id: str,
    operation_contract: dict[str, Any],
    *,
    task_id: str,
    attempt_id: str,
) -> dict[str, Any]:
    contract = task_contract or {}
    capability = contract.get("operation_capability")
    if capability is None:
        raise DispatchError("operation capability is required")
    if not isinstance(capability, dict):
        raise DispatchError("operation capability must be an object")
    authorization_id = str(capability.get("authorization_id") or "")
    expected_contract_hash = _canonical_dispatch_contract_hash(
        task_contract,
        operation_contract,
        worker_id=worker_id,
        task_id=task_id,
        attempt_id=attempt_id,
    )
    try:
        ledger = _operation_authorization_ledger(
            root,
            task_id,
            attempt_id,
        )
        boundary = ledger.boundary_sequence()
        durable_capability = ledger.require_active_authorization(
            authorization_id,
            expected_boundary=boundary,
        )
        if _canonical_json_hash(durable_capability) != _canonical_json_hash(capability):
            raise OperationAuthorizationError("capability does not match ledger")
        if durable_capability.get("contract_hash") != expected_contract_hash:
            raise OperationAuthorizationError("dispatch contract hash mismatch")
        validated = validate_operation_capability(
            durable_capability,
            operation_kind="worker_dispatch",
            target_scope={"kind": "worker", "id": worker_id},
            required_mutation_gates=list(
                operation_contract["required_mutation_gates"]
            ),
            task_id=task_id,
            attempt_id=attempt_id,
        )
    except OperationAuthorizationError as exc:
        raise DispatchError(str(exc)) from exc
    return {
        "authorization_mode": "ledger",
        "authorization_id": authorization_id,
        "ledger_boundary": boundary,
        "capability": validated,
    }


def _extract_run_one_capability(
    task_contract: dict[str, Any] | None,
) -> dict[str, Any]:
    contract = task_contract or {}
    capability = contract.get("operation_capability")
    if capability is None:
        raise DispatchError("worker_dispatch operation capability is required")
    if not isinstance(capability, dict):
        raise DispatchError("operation capability must be an object")
    task_id = str(capability.get("task_id") or "").strip()
    if not task_id:
        raise DispatchError("operation capability task_id is required")
    attempt_id = str(capability.get("attempt_id") or "").strip()
    if not attempt_id:
        raise DispatchError("operation capability attempt_id is required")
    return capability


def _prepare_worker_dispatch_operation_contract(
    root: Path,
    task_contract: dict[str, Any] | None,
    worker_id: str,
    *,
    task_id: str,
) -> dict[str, Any]:
    operation_contract = _run_one_operation_contract(task_contract)
    capability_candidate = (
        task_contract.get("operation_capability")
        if isinstance(task_contract, dict)
        else None
    )
    if capability_candidate is None:
        raise DispatchError("worker_dispatch operation capability is required")
    attempt_id = str(capability_candidate.get("attempt_id") or "")
    authorization = _run_one_operation_capability(
        root,
        task_contract,
        worker_id,
        operation_contract,
        task_id=task_id,
        attempt_id=attempt_id,
    )
    current_contract_hash = _canonical_dispatch_contract_hash(
        task_contract,
        operation_contract,
        worker_id=worker_id,
        task_id=task_id,
        attempt_id=attempt_id,
    )
    return {
        **operation_contract,
        "task_id": task_id,
        "attempt_id": attempt_id,
        "authorization": authorization,
        "current_contract_hash": current_contract_hash,
    }


def _task_operation_contract(
    root: Path,
    tdir: Path,
    *,
    expected_worker_id: str,
) -> dict[str, Any]:
    task_record = _read_json_nofollow(
        root=root,
        path=tdir / "task.json",
    )
    assert task_record is not None
    operation_contract = task_record.get("operation_contract")
    if not isinstance(operation_contract, dict):
        raise DispatchError("task operation authorization is missing")
    if (
        str(operation_contract.get("task_id") or "")
        != str(task_record.get("id") or "")
        or str(operation_contract.get("attempt_id") or "")
        != str(task_record.get("attempt_id") or "")
    ):
        raise DispatchError(
            "task operation contract task-attempt mismatch"
        )
    if str(task_record.get("owner") or "") != expected_worker_id:
        raise DispatchError("task operation contract worker mismatch")
    try:
        expected = derive_operation_contract(
            "worker_dispatch",
            (
                task_record.get("task_contract")
                if isinstance(task_record.get("task_contract"), dict)
                else None
            ),
        )
    except OperationAuthorizationError as exc:
        raise DispatchError(str(exc)) from exc
    for field in (
        "operation_kind",
        "scope_kind",
        "known_effects",
        "required_mutation_gates",
    ):
        if operation_contract.get(field) != expected.get(field):
            raise DispatchError(f"task operation contract {field} mismatch")
    current_contract_hash = _canonical_dispatch_contract_hash(
        (
            task_record.get("task_contract")
            if isinstance(task_record.get("task_contract"), dict)
            else None
        ),
        expected,
        worker_id=expected_worker_id,
        task_id=str(operation_contract.get("task_id") or ""),
        attempt_id=str(operation_contract.get("attempt_id") or ""),
    )
    return {**operation_contract, "current_contract_hash": current_contract_hash}


def _operation_authorization_ledger(
    root: Path,
    task_id: str,
    attempt_id: str,
) -> AuthorizationLedger:
    return AuthorizationLedger(
        framework_root(root)
        / "operation-authorizations"
        / safe_id(task_id, "task")
        / f"{safe_id(attempt_id, 'attempt')}.jsonl",
        task_id=task_id,
        attempt_id=attempt_id,
    )


@contextmanager
def _prepared_operation_mutation_boundary(
    root: Path,
    operation_contract: dict[str, Any],
    worker_id: str,
    *,
    applied_mutation_gates: list[str],
) -> Any:
    authorization = operation_contract.get("authorization")
    if not isinstance(authorization, dict):
        raise DispatchError("task operation authorization is invalid")
    mode = str(authorization.get("authorization_mode") or "")
    if mode != "ledger":
        raise DispatchError("unknown task operation authorization mode")
    authorization_id = str(authorization.get("authorization_id") or "")
    boundary = authorization.get("ledger_boundary")
    if type(boundary) is not int or boundary < 1:
        raise DispatchError("ledger authorization boundary is invalid")
    try:
        validate_mutation_gate_union(
            list(operation_contract["required_mutation_gates"]),
            applied_mutation_gates,
        )
        ledger = _operation_authorization_ledger(
            root,
            str(operation_contract.get("task_id") or ""),
            str(operation_contract.get("attempt_id") or ""),
        )
        with ledger.mutation_boundary(
            authorization_id,
            expected_boundary=boundary,
        ) as capability:
            validate_operation_capability(
                capability,
                operation_kind="worker_dispatch",
                target_scope={"kind": "worker", "id": worker_id},
                required_mutation_gates=list(
                    operation_contract["required_mutation_gates"]
                ),
                task_id=str(operation_contract.get("task_id") or ""),
                attempt_id=str(operation_contract.get("attempt_id") or ""),
            )
            current_hash = str(operation_contract.get("current_contract_hash") or "")
            granted_hash = str(capability.get("contract_hash") or "")
            if current_hash != granted_hash:
                raise DispatchError(
                    "contract hash mismatch between current task contract and grant"
                )
            yield authorization
    except OperationAuthorizationError as exc:
        raise DispatchError(str(exc)) from exc


@contextmanager
def _operation_mutation_boundary(
    root: Path,
    tdir: Path,
    worker_id: str,
    *,
    applied_mutation_gates: list[str],
) -> Any:
    with _prepared_operation_mutation_boundary(
        root,
        _task_operation_contract(
            root,
            tdir,
            expected_worker_id=worker_id,
        ),
        worker_id,
        applied_mutation_gates=applied_mutation_gates,
    ) as authorization:
        yield authorization


@contextmanager
def _authorized_task_preparation(
    root: Path,
    operation_contract: dict[str, Any],
    worker_id: str,
) -> Any:
    with global_mutation_gate(root, exclusive=False):
        with visible_registry_lock(root):
            worker = worker_record(root, worker_id)
            ensure_worker_allowed(root, worker, must_be_default=False)
            require_binding_lease_for_submit(worker)
            lock = resolve_lock(
                root,
                worker_id,
                auto_release_terminal=False,
            )
            if lock.get("active"):
                raise DispatchError(
                    f"active_task_exists for {worker_id}: "
                    f"{lock.get('path')}"
                )
            with _prepared_operation_mutation_boundary(
                root,
                operation_contract,
                worker_id,
                applied_mutation_gates=(
                    WORKER_DISPATCH_ENFORCED_GATES
                ),
            ):
                yield


def _revoke_worker_dispatch_authorization(
    root: Path,
    operation_contract: dict[str, Any],
    worker_id: str,
    *,
    provenance: str,
) -> bool:
    """Revoke a worker_dispatch grant after a deterministic applied/rejected outcome."""
    return _ensure_worker_dispatch_authorization_revoked(
        root,
        operation_contract,
        worker_id,
        provenance=provenance,
    )


def _revoke_rejected_dispatch_before_delivery(
    root: Path,
    tdir: Path,
    worker_id: str,
    operation_contract: dict[str, Any],
) -> bool:
    if lock_path(root, worker_id).exists() or (tdir / ".submitted").exists():
        return False
    _revoke_worker_dispatch_authorization(
        root,
        operation_contract,
        worker_id,
        provenance="dispatch-rejected-revoke",
    )
    return True


def _record_operation_receipt(
    root: Path,
    tdir: Path,
    worker_id: str,
    *,
    outcome: str,
    submitted_before: bool,
    submitted_after: bool,
) -> Path:
    operation_contract = _task_operation_contract(
        root,
        tdir,
        expected_worker_id=worker_id,
    )
    authorization = operation_contract["authorization"]
    task_record = _read_json_nofollow(
        root=root,
        path=tdir / "task.json",
    )
    assert task_record is not None
    receipt_path = (
        framework_root(root)
        / "operation-receipts"
        / safe_id(str(task_record.get("run") or ""), "run")
        / f"{safe_id(str(task_record.get('id') or ''), 'task')}.json"
    )
    existing = _read_json_nofollow(
        root=root,
        path=receipt_path,
        missing_ok=True,
        create_parents=True,
    )
    if existing is None:
        receipt = build_trusted_operation_receipt(
            authorization_id=str(authorization.get("authorization_id") or ""),
            operation_kind="worker_dispatch",
            resolved_target={"kind": "worker", "id": worker_id},
            before_state={"submitted": submitted_before},
            after_state={"submitted": submitted_after},
            outcome=outcome,
            task_id=str(operation_contract.get("task_id") or ""),
            attempt_id=str(operation_contract.get("attempt_id") or ""),
            ledger_sequence=int(authorization.get("ledger_boundary") or 0),
            created_at=utc_now(),
        )
        _write_json_nofollow(
            root=root,
            path=receipt_path,
            payload=receipt,
            existing_equal_ok=True,
        )
    else:
        try:
            validate_trusted_operation_receipt(
                existing,
                authorization_id=str(
                    authorization.get("authorization_id") or ""
                ),
                operation_kind="worker_dispatch",
                resolved_target={"kind": "worker", "id": worker_id},
                task_id=str(operation_contract.get("task_id") or ""),
                attempt_id=str(
                    operation_contract.get("attempt_id") or ""
                ),
                ledger_sequence=int(
                    authorization.get("ledger_boundary") or 0
                ),
            )
        except OperationAuthorizationError as exc:
            raise DispatchError(str(exc)) from exc
        if (
            existing.get("before_state")
            != {"submitted": submitted_before}
            or existing.get("after_state")
            != {"submitted": submitted_after}
            or existing.get("outcome") != outcome
        ):
            raise DispatchError("operation receipt outcome conflict")
        receipt = existing
    if outcome == "ambiguous":
        _write_json_nofollow(
            root=root,
            path=tdir / "reconcile_needed.json",
            payload={
                "schema_version": 1,
                "recorded_at": str(receipt["created_at"]),
                "outcome": "ambiguous",
                "receipt_path": rel(receipt_path, root),
                "note": (
                    "worker_dispatch grant is preserved; external "
                    "reconciliation is required before reuse"
                ),
            },
            existing_equal_ok=True,
        )
    if outcome in {"applied", "rejected"}:
        provenance = (
            "dispatch-receipt-revoke-repair"
            if existing is not None
            else (
                "dispatch-applied-consume"
                if outcome == "applied"
                else "dispatch-rejected-revoke"
            )
        )
        _revoke_worker_dispatch_authorization(
            root,
            operation_contract,
            worker_id,
            provenance=provenance,
        )
    return receipt_path


def _ensure_worker_dispatch_authorization_revoked(
    root: Path,
    operation_contract: dict[str, Any],
    worker_id: str,
    *,
    provenance: str,
) -> bool:
    """Idempotently append the deterministic revoke for an applied/rejected grant.

    Returns True if a new revoke record was written, False if it already exists.
    """
    authorization = operation_contract.get("authorization")
    if not isinstance(authorization, dict):
        raise DispatchError("task operation authorization is invalid")
    grant_authorization_id = str(authorization.get("authorization_id") or "")
    task_id = str(operation_contract.get("task_id") or "")
    attempt_id = str(operation_contract.get("attempt_id") or "")
    capability = authorization.get("capability")
    if not isinstance(capability, dict):
        raise DispatchError("task operation capability is invalid")
    contract_hash = str(capability.get("contract_hash") or "")
    ledger = _operation_authorization_ledger(root, task_id, attempt_id)
    revoke_id = f"revoke-{grant_authorization_id}"
    records = ledger.records()
    if any(
        record.get("decision") == "revoke"
        and record.get("revokes_authorization_id") == grant_authorization_id
        for record in records
    ):
        return False
    try:
        ledger.append(
            {
                "schema_version": 1,
                "authorization_id": revoke_id,
                "principal": "omx_visible_dispatch",
                "decision": "revoke",
                "task_id": task_id,
                "attempt_id": attempt_id,
                "contract_hash": contract_hash,
                "created_at": utc_now(),
                "provenance": provenance,
                "revokes_authorization_id": grant_authorization_id,
            }
        )
    except OperationAuthorizationError:
        if any(
            record.get("decision") == "revoke"
            and record.get("revokes_authorization_id") == grant_authorization_id
            for record in ledger.records()
        ):
            return False
        raise
    return True


def command_submit_new(args: argparse.Namespace) -> int:
    ensure_nonempty_task_body(args.body)
    root = root_path(args.root)
    backend = getattr(args, "backend", RUNTIME_BACKEND)
    session_decision = run_one_session_decision(args)
    task_contract = parse_task_contract_json(getattr(args, "task_contract_json", ""))
    run_one_capability = _extract_run_one_capability(task_contract)
    task_id = str(run_one_capability.get("task_id") or "")
    worker, _worker_scope = resolve_dispatch_worker(
        root,
        getattr(args, "worker", None),
        backend=backend,
    )
    task = task_id
    operation_contract = _prepare_worker_dispatch_operation_contract(
        root,
        task_contract,
        str(worker["worker_id"]),
        task_id=task,
    )
    dispatch_claim = _reserve_worker_dispatch_claim(
        root=root,
        args=args,
        capability=run_one_capability,
        worker_id=str(worker["worker_id"]),
        task_id=task,
    )
    if dispatch_claim["action"] == "reuse":
        return _return_reused_run_one_dispatch_claim(
            root=root,
            claim=dispatch_claim,
        )
    run = str(dispatch_claim["run_id"])
    rotation_request = run_one_rotation_request(
        args,
        task_id=task,
        attempt_id=run,
        role=str(worker.get("role") or "visible-worker"),
        contract_hash=_canonical_json_hash(
            {
                "title": args.title,
                "body": args.body,
                "task_contract": task_contract or {},
            }
        ),
    )
    try:
        with _authorized_task_preparation(
            root,
            operation_contract,
            str(worker["worker_id"]),
        ):
            tdir = create_task(
                root,
                run,
                task,
                str(worker["worker_id"]),
                args.title,
                args.body,
                runtime_backend=backend,
                runtime_backend_type=backend_type_for(backend),
                task_contract=task_contract,
                operation_contract=operation_contract,
                session_action=str(session_decision.get("session_action") or ""),
            )
            session_record = write_task_session_action(
                tdir,
                str(worker["worker_id"]),
                session_decision,
                args=args,
                rotation_request=rotation_request,
            )
        dispatch_claim = mark_run_one_dispatch_claim_prepared(
            root=root,
            claim=dispatch_claim,
            tdir=tdir,
        )
    except DispatchError:
        _revoke_worker_dispatch_authorization(
            root,
            operation_contract,
            str(worker["worker_id"]),
            provenance="dispatch-rejected-revoke",
        )
        raise
    print(f"created_task: {rel(tdir, root)}")
    print(f"run_id: {run}")
    print(f"task_id: {task}")
    print(f"worker: {worker['worker_id']}")
    print(f"runtime_backend: {backend}")
    print(f"worker_role: {worker.get('role') or '-'}")
    code = submit_task(
        root,
        run,
        task,
        str(worker["worker_id"]),
        allow_real=args.allow_real,
        runtime_backend=backend,
        pre_submit_rotation=rotation_request,
        session_decision=session_record,
    )
    return code


def latest_visible_run(
    root: Path,
    worker_id: str | None = None,
    *,
    runs_root_override: Path | None = None,
    projected_tasks: list[dict[str, Any]] | None = None,
) -> dict[str, Any] | None:
    base = runs_root_override or visible_runs_root(root)
    if not base.is_dir():
        return None
    scope_worker = safe_id(worker_id, "worker") if worker_id else ""
    candidates: list[dict[str, Any]] = []
    for run_dir in sorted(path for path in base.iterdir() if path.is_dir() and path.name.startswith("visible-run-")):
        tasks_dir = run_dir / "tasks"
        if projected_tasks is not None:
            task_info = [
                {
                    "task": str(item.get("task") or ""),
                    "path": str(item.get("path") or ""),
                    "status": item.get("protocol_terminal_state"),
                    "protocol_terminal_state": item.get("protocol_terminal_state"),
                    "reason": item.get("reason"),
                    "terminal_markers": item.get("terminal_markers", []),
                    "flow_markers": item.get("flow_markers", []),
                    "report_bytes": item.get("report_bytes", 0),
                    "owner": str(item.get("owner") or ""),
                    "backend": item.get("backend", ""),
                    "updated_at": item.get("updated_at", ""),
                    "report_path": rel(
                        base / run_dir.name / "tasks" / str(item.get("task") or "") / "report.md",
                        root,
                    ),
                }
                for item in projected_tasks
                if str(item.get("run") or "") == run_dir.name
            ]
        else:
            task_dirs = sorted(path for path in tasks_dir.iterdir() if path.is_dir()) if tasks_dir.is_dir() else []
            task_info = []
            for tdir in task_dirs:
                if scope_worker and visible_task_state.owner_backend_for_task(tdir)[0] != scope_worker:
                    continue
                truth = task_truth(root, run_dir.name, tdir.name, runs_root=base)
                owner = str(truth.get("owner", ""))
                task_info.append({
                    "task": tdir.name,
                    "path": rel(tdir, root),
                    "status": truth.get("protocol_terminal_state"),
                    "protocol_terminal_state": truth.get("protocol_terminal_state"),
                    "reason": truth.get("state_reason"),
                    "terminal_markers": truth.get("terminal_markers", []),
                    "flow_markers": truth.get("flow_markers", []),
                    "report_bytes": truth.get("report_bytes", 0),
                    "owner": owner,
                    "backend": truth.get("backend", ""),
                    "updated_at": truth.get("last_event_ts", ""),
                    "report_path": rel(tdir / "report.md", root),
                })
        if not task_info:
            continue
        summary_data = read_json(run_dir / "summary.json")
        candidates.append({
            "run_id": run_dir.name,
            "run_path": rel(run_dir, root),
            "summary_json": rel(run_dir / "summary.json", root) if (run_dir / "summary.json").is_file() else "",
            "summary_md": rel(run_dir / "summary.md", root) if (run_dir / "summary.md").is_file() else "",
            "summary_state": summary_state_value(summary_data),
            "pending_after_timeout": bool(summary_data.get("pending_after_timeout")),
            "needs_settle": bool(summary_data.get("needs_settle")),
            "needs_settle_evidence_valid": type(summary_data.get("needs_settle")) is bool,
            "recommended_settle_command": str(summary_data.get("recommended_settle_command") or ""),
            "final_protocol_terminal_state": str(summary_data.get("final_protocol_terminal_state") or ""),
            "runtime_snapshot_path": str(summary_data.get("runtime_snapshot_path") or ""),
            "runtime_snapshot_ok": bool(summary_data.get("runtime_snapshot_ok")),
            "runtime_snapshot_status": str(summary_data.get("runtime_snapshot_status") or ""),
            "runtime_snapshot_backend_type": str(summary_data.get("runtime_snapshot_backend_type") or ""),
            "runtime_observation_path": str(summary_data.get("runtime_observation_path") or ""),
            "runtime_observation_ok": bool(summary_data.get("runtime_observation_ok")),
            "runtime_observation_status": str(summary_data.get("runtime_observation_status") or ""),
            "runtime_observation_readiness": str(summary_data.get("runtime_observation_readiness") or ""),
            "runtime_observation_backend_type": str(summary_data.get("runtime_observation_backend_type") or ""),
            "runtime_observation_session_id": str(summary_data.get("runtime_observation_session_id") or ""),
            "runtime_observation_window_id": str(summary_data.get("runtime_observation_window_id") or ""),
            "runtime_observation_pane_id": str(summary_data.get("runtime_observation_pane_id") or ""),
            "runtime_observation_process_id": summary_data.get("runtime_observation_process_id"),
            "tasks": task_info,
            "worker_scope": scope_worker,
        })
    if not candidates:
        return None
    return max(
        candidates,
        key=lambda item: (
            max((str(task.get("updated_at", "")) for task in item.get("tasks", [])), default=""),
            str(item.get("run_id", "")),
        ),
    )


def recorded_runtime_backend(
    root: Path,
    run: str,
    task: str,
    *,
    fixture: str | None = None,
    runs_root: Path | None = None,
    fallback_backend: str = RUNTIME_BACKEND,
) -> tuple[str, str]:
    base = runs_root or visible_task_state.runs_root_for(root, fixture)
    tdir = visible_task_state.task_dir(root, run, task, runs_root=base)
    task_meta = read_json(tdir / "task.json")
    if task_meta.get("runtime_backend"):
        backend = str(task_meta.get("runtime_backend") or fallback_backend)
        backend_type = str(task_meta.get("runtime_backend_type") or backend_type_for(backend))
        return backend, backend_type
    run_summary = read_json(base / run / "summary.json")
    if run_summary.get("runtime_backend"):
        backend = str(run_summary.get("runtime_backend") or fallback_backend)
        backend_type = str(run_summary.get("runtime_backend_type") or backend_type_for(backend))
        return backend, backend_type
    return fallback_backend, backend_type_for(fallback_backend)


def worker_status_payload(
    root: Path,
    worker_id: str,
    *,
    projected_tasks: list[dict[str, Any]] | None = None,
) -> dict[str, Any]:
    safe_id(worker_id, "worker")
    tasks = (
        projected_tasks
        if projected_tasks is not None
        else visible_tasks(root, worker_id=worker_id)
    )
    locks = diagnose_worker_locks(root, worker_id=worker_id)
    latest = latest_visible_run(
        root,
        worker_id=worker_id,
        projected_tasks=tasks if projected_tasks is not None else None,
    )
    binding: dict[str, Any] = {}
    try:
        binding = next(
            (
                dict(worker)
                for worker in load_visible_workers(root)
                if str(worker.get("worker_id") or "") == worker_id
            ),
            {},
        )
    except DispatchError:
        binding = {}
    port = nonnegative_int(binding.get("port"))
    watcher = read_watcher_board(root)
    alerts = []
    if watcher:
        for alert in watcher.get("alerts", []):
            if not isinstance(alert, dict):
                continue
            inferred_worker = infer_alert_worker_id(root, alert)
            if inferred_worker == worker_id:
                alert_doc = dict(alert)
                if inferred_worker and "worker_id" not in alert_doc:
                    alert_doc["inferred_worker_id"] = inferred_worker
                alerts.append(alert_doc)
    return {
        "worker_id": worker_id,
        "port": port or None,
        "pane_id": str(binding.get("pane_id") or ""),
        "tmux_session": str(binding.get("tmux_session") or ""),
        "tmux_window": str(binding.get("tmux_window") or ""),
        "worker_id_port_suffix_mismatch": (
            worker_id_port_suffix_mismatch(worker_id, port)
        ),
        "tasks": tasks,
        "locks": locks,
        "lock_diagnosis": summarize_lock_diagnosis(locks),
        "summary": dict(sorted(Counter(item["status"] for item in tasks).items())),
        "latest": latest or {},
        "alerts": alerts,
        "alert_count": len(alerts),
    }


def worker_rebind_readiness(
    root: Path,
    worker_id: str,
    *,
    backend: str = RUNTIME_BACKEND,
    timeout: int = 45,
) -> dict[str, Any]:
    safe_id(worker_id, "worker")
    if not rebind_path(root).is_file():
        return {
            "dispatch_state": "requires_manual_rebind",
            "rebind_status": "missing_rebind_checker",
            "rebind_ok": False,
        }
    result = run_command(
        [str(rebind_path(root)), "check", "--root", str(root), "--worker", worker_id, "--runtime-backend", backend, "--json"],
        root,
        timeout=timeout,
    )
    parsed: dict[str, Any] = {}
    try:
        loaded = json.loads(result.get("stdout") or "{}")
        if isinstance(loaded, dict):
            parsed = loaded
    except Exception:
        parsed = {}
    status = str(parsed.get("status") or "")
    if not status and result.get("timed_out"):
        status = "rebind_check_timeout"
    status = status or "unknown"
    ok = result.get("returncode") == 0 and status == "current_binding_ok"
    dispatch_state = (
        "dispatchable_without_rebind"
        if ok
        else "rebind_check_unknown"
        if result.get("timed_out")
        else "requires_manual_rebind"
    )
    return {
        "dispatch_state": dispatch_state,
        "rebind_status": status,
        "rebind_ok": bool(ok),
        "rebind_returncode": result.get("returncode"),
        "rebind_timed_out": bool(result.get("timed_out")),
        "opencode_pid_in_current_window_pane_tree": parsed.get("opencode_pid_in_current_window_pane_tree"),
        "registry_pane_exists_in_current_window": parsed.get("registry_pane_exists_in_current_window"),
    }


def current_dispatchable_pool_status(
    root: Path,
    dispatchable_workers: list[dict[str, Any]],
    *,
    backend: str = RUNTIME_BACKEND,
    rebind_timeout: int = 45,
    max_rebind_checks: int | None = None,
    include_worker_status: bool = True,
) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    rebind_checks = 0
    for worker in dispatchable_workers:
        worker_id = str(worker.get("worker_id") or "")
        if not worker_id:
            continue
        scoped = worker_status_payload(root, worker_id) if include_worker_status else {}
        if max_rebind_checks is not None and rebind_checks >= max_rebind_checks:
            rebind = {
                "dispatch_state": "rebind_check_unknown",
                "rebind_status": "rebind_check_skipped_budget_exhausted",
                "rebind_ok": False,
                "rebind_skipped": True,
            }
        else:
            rebind = worker_rebind_readiness(
                root,
                worker_id,
                backend=backend,
                timeout=rebind_timeout,
            )
            rebind_checks += 1
        latest = scoped.get("latest", {}) if isinstance(scoped.get("latest"), dict) else {}
        latest_tasks = latest.get("tasks", []) if isinstance(latest.get("tasks"), list) else []
        latest_task = latest_tasks[0] if latest_tasks else {}
        worker_status_state = (
            "hydrated"
            if include_worker_status
            else "skipped_bounded_pool_snapshot"
        )
        rows.append({
            "worker_id": worker_id,
            "role": str(worker.get("role") or infer_worker_role(worker)),
            "pane_id": str(worker.get("pane_id") or ""),
            "port": worker.get("port"),
            "binding_confidence": str(worker.get("binding_confidence") or ""),
            "dispatch_state": rebind.get("dispatch_state"),
            "rebind_status": rebind.get("rebind_status"),
            "rebind_ok": bool(rebind.get("rebind_ok")),
            "rebind_returncode": rebind.get("rebind_returncode"),
            "rebind_timed_out": bool(rebind.get("rebind_timed_out")),
            "rebind_skipped": bool(rebind.get("rebind_skipped")),
            "opencode_pid_in_current_window_pane_tree": rebind.get("opencode_pid_in_current_window_pane_tree"),
            "registry_pane_exists_in_current_window": rebind.get("registry_pane_exists_in_current_window"),
            "worker_status_hydrated": include_worker_status,
            "worker_status_state": worker_status_state,
            "alert_count": (
                int(scoped.get("alert_count", 0) or 0)
                if include_worker_status
                else None
            ),
            "lock_count": (
                len(scoped.get("locks", []))
                if include_worker_status and isinstance(scoped.get("locks"), list)
                else None
            ),
            "latest_run": str(latest.get("run_id") or ""),
            "latest_summary_state": str(latest.get("summary_state") or ""),
            "latest_truth_state": str(
                latest_task.get("protocol_terminal_state")
                or latest_task.get("status")
                or ""
            ),
            "latest_pending_after_timeout": bool(latest.get("pending_after_timeout")),
            "latest_needs_settle": bool(latest.get("needs_settle")),
        })
    return rows


def normalized_pool_dispatch_state(row: dict[str, Any]) -> str:
    state = str(row.get("dispatch_state") or "").strip()
    if state in {
        "dispatchable_without_rebind",
        "requires_manual_rebind",
    }:
        return state
    return "rebind_check_unknown"


def split_pool_rows_by_rebind(rows: list[dict[str, Any]]) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    ready: list[dict[str, Any]] = []
    requires_rebind: list[dict[str, Any]] = []
    for row in rows:
        state = normalized_pool_dispatch_state(row)
        if state == "requires_manual_rebind":
            requires_rebind.append(row)
        elif state == "dispatchable_without_rebind":
            ready.append(row)
    return ready, requires_rebind


def current_dispatchable_pool_snapshot(
    root: Path,
    *,
    backend: str = RUNTIME_BACKEND,
    worker_id: str | None = None,
    rebind_timeout: int = POOL_REBIND_READINESS_TIMEOUT,
    max_rebind_checks: int | None = POOL_REBIND_READINESS_MAX_CHECKS,
    prioritize_worker_ids: list[str] | None = None,
) -> dict[str, Any]:
    requested_worker = safe_id(worker_id, "worker") if worker_id else ""
    registry_warning = ""
    try:
        registry_qualified_workers = dispatchable_visible_workers(root)
    except DispatchError as exc:
        registry_qualified_workers = []
        registry_warning = str(exc)
    if requested_worker:
        registry_qualified_workers = [
            worker
            for worker in registry_qualified_workers
            if str(worker.get("worker_id") or "") == requested_worker
        ]
    priority_order = {
        worker_id: index
        for index, worker_id in enumerate(prioritize_worker_ids or [])
        if worker_id
    }
    if priority_order:
        registry_qualified_workers = [
            worker
            for _, worker in sorted(
                enumerate(registry_qualified_workers),
                key=lambda item: (
                    priority_order.get(
                        str(item[1].get("worker_id") or ""),
                        len(priority_order),
                    ),
                    item[0],
                ),
            )
        ]
    pool_rows = current_dispatchable_pool_status(
        root,
        registry_qualified_workers,
        backend=backend,
        rebind_timeout=rebind_timeout,
        max_rebind_checks=max_rebind_checks,
        include_worker_status=False,
    )
    ready_rows, rebind_required_rows = split_pool_rows_by_rebind(pool_rows)
    ready_ids = {
        str(row.get("worker_id") or "")
        for row in ready_rows
        if str(row.get("worker_id") or "")
    }
    rebind_required_ids = {
        str(row.get("worker_id") or "")
        for row in rebind_required_rows
        if str(row.get("worker_id") or "")
    }
    rebind_unknown_ids = {
        str(row.get("worker_id") or "")
        for row in pool_rows
        if (
            normalized_pool_dispatch_state(row) == "rebind_check_unknown"
            and str(row.get("worker_id") or "")
        )
    }
    return {
        "registry_warning": registry_warning,
        "registry_qualified_workers": registry_qualified_workers,
        "pool_rows": pool_rows,
        "rebind_check_limit": max_rebind_checks,
        "rebind_check_skipped_workers": [
            str(row.get("worker_id") or "")
            for row in pool_rows
            if row.get("rebind_skipped") and str(row.get("worker_id") or "")
        ],
        "rebind_timed_out_workers": [
            str(row.get("worker_id") or "")
            for row in pool_rows
            if row.get("rebind_timed_out") and str(row.get("worker_id") or "")
        ],
        "dispatchable_workers": [
            worker
            for worker in registry_qualified_workers
            if str(worker.get("worker_id") or "") in ready_ids
        ],
        "requires_manual_rebind_workers": [
            worker
            for worker in registry_qualified_workers
            if str(worker.get("worker_id") or "") in rebind_required_ids
        ],
        "rebind_check_unknown_workers": [
            worker
            for worker in registry_qualified_workers
            if str(worker.get("worker_id") or "") in rebind_unknown_ids
        ],
    }


def format_pool_status_line(row: dict[str, Any], *, include_rebind: bool = False) -> str:
    line = (
        f"{row.get('worker_id') or '-'} "
        f"role={row.get('role') or '-'} "
        f"pane={row.get('pane_id') or '-'} "
        f"port={row.get('port') or '-'} "
        f"binding={row.get('binding_confidence') or '-'}"
    )
    if bool(row.get("worker_status_hydrated", True)):
        line += (
            f" alerts={row.get('alert_count', 0)} "
            f"locks={row.get('lock_count', 0)} "
            f"latest_run={row.get('latest_run') or '-'} "
            f"summary_state={row.get('latest_summary_state') or '-'} "
            f"truth_state={row.get('latest_truth_state') or '-'}"
        )
    else:
        line += (
            " worker_status="
            f"{row.get('worker_status_state') or 'not_hydrated'}"
        )
    if include_rebind:
        line += f" rebind_status={row.get('rebind_status') or '-'}"
    return line


def partition_status_payloads_for_human(
    payloads: list[dict[str, Any]],
    worker_inventory: list[dict[str, Any]],
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    role_by_worker = {
        str(worker.get("worker_id") or ""): str(worker.get("role") or infer_worker_role(worker))
        for worker in worker_inventory
        if str(worker.get("worker_id") or "")
    }
    actionable: list[dict[str, Any]] = []
    hidden: list[dict[str, Any]] = []
    for payload in payloads:
        worker_id = str(payload.get("worker_id") or "")
        role = role_by_worker.get(worker_id, "")
        if role in {"default", "production_candidate"}:
            actionable.append(payload)
        else:
            hidden.append(payload)
    return actionable, hidden


def filter_mixed_status_for_actionable(summary: dict[str, Any], actionable_worker_ids: set[str]) -> tuple[dict[str, Any], list[str]]:
    workers = summary.get("workers", []) if isinstance(summary.get("workers"), list) else []
    if not actionable_worker_ids or not workers:
        return summary, []
    actionable_workers = [
        worker for worker in workers
        if str(worker.get("worker_id") or "") in actionable_worker_ids
    ]
    if not actionable_workers:
        return summary, []
    hidden_workers = [
        str(worker.get("worker_id") or "")
        for worker in workers
        if str(worker.get("worker_id") or "") not in actionable_worker_ids
    ]
    filtered = dict(summary)
    filtered["workers"] = actionable_workers
    filtered["worker_count"] = len(actionable_workers)
    filtered["mixed_ready_workers"] = [
        worker_id for worker_id in summary.get("mixed_ready_workers", [])
        if str(worker_id) in actionable_worker_ids
    ]
    filtered["mixed_blocked_workers"] = [
        worker_id for worker_id in summary.get("mixed_blocked_workers", [])
        if str(worker_id) in actionable_worker_ids
    ]
    filtered["evidence_missing_workers"] = [
        worker_id for worker_id in summary.get("evidence_missing_workers", [])
        if str(worker_id) in actionable_worker_ids
    ]
    filtered["evidence_collected_candidates"] = [
        worker_id for worker_id in summary.get("evidence_collected_candidates", [])
        if str(worker_id) in actionable_worker_ids
    ]
    return filtered, [worker_id for worker_id in hidden_workers if worker_id]


def command_last(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    backend = getattr(args, "backend", RUNTIME_BACKEND)
    latest = latest_visible_run(root, worker_id=getattr(args, "worker", None))
    if not latest:
        if args.json:
            print(json.dumps({
                "run": None,
                "worker_id": getattr(args, "worker", None) or "",
                "runtime_backend": backend,
                "runtime_backend_type": backend_type_for(backend),
            }, indent=2, sort_keys=True))
        else:
            print(f"runtime_backend: {backend}")
            print(f"runtime_backend_type: {backend_type_for(backend)}")
            if getattr(args, "worker", None):
                print(f"worker_id: {args.worker}")
                print("last_run: none")
            else:
                print("last_run: none")
        return 1
    latest = dict(latest)
    latest["runtime_backend"] = backend
    latest["runtime_backend_type"] = backend_type_for(backend)
    if args.json:
        print(json.dumps(latest, indent=2, sort_keys=True, ensure_ascii=False))
        return 0
    print(f"runtime_backend: {backend}")
    print(f"runtime_backend_type: {backend_type_for(backend)}")
    print(f"run_id: {latest['run_id']}")
    if getattr(args, "worker", None):
        print(f"worker_id: {args.worker}")
    print(f"run_path: {latest['run_path']}")
    print(f"summary_md: {latest.get('summary_md') or '-'}")
    print(f"summary_json: {latest.get('summary_json') or '-'}")
    print(f"summary_state: {latest.get('summary_state') or '-'}")
    print(f"pending_after_timeout: {str(bool(latest.get('pending_after_timeout'))).lower()}")
    print(f"needs_settle: {str(bool(latest.get('needs_settle'))).lower()}")
    print(f"runtime_snapshot_path: {latest.get('runtime_snapshot_path') or '-'}")
    print(f"runtime_snapshot_ok: {str(bool(latest.get('runtime_snapshot_ok'))).lower()}")
    print(f"runtime_snapshot_status: {latest.get('runtime_snapshot_status') or '-'}")
    print(f"runtime_snapshot_backend_type: {latest.get('runtime_snapshot_backend_type') or '-'}")
    print(f"runtime_observation_path: {latest.get('runtime_observation_path') or '-'}")
    print(f"runtime_observation_ok: {str(bool(latest.get('runtime_observation_ok'))).lower()}")
    print(f"runtime_observation_status: {latest.get('runtime_observation_status') or '-'}")
    print(f"runtime_observation_readiness: {latest.get('runtime_observation_readiness') or '-'}")
    print(f"runtime_observation_backend_type: {latest.get('runtime_observation_backend_type') or '-'}")
    print(f"runtime_observation_pane_id: {latest.get('runtime_observation_pane_id') or '-'}")
    if latest.get("recommended_settle_command"):
        print(f"recommended_settle_command: {latest.get('recommended_settle_command')}")
    for item in latest.get("tasks", []):
        print(f"task_id: {item['task']}")
        print(f"state: {item['status']}")
        print(f"report: {item['report_path']}")
    return 0


def leader_prompt_template(worker: dict[str, Any]) -> str:
    worker_id = str(worker.get("worker_id", ""))
    pane_id = str(worker.get("pane_id", ""))
    port = str(worker.get("port", ""))
    return """你是主控 agent。默认 visible worker 以 registry/default-worker 为准：
- registry=.omx/framework/team/opencode_visible_workers.json
- worker_id={worker_id}
- current_snapshot_pane={pane_id}
- current_snapshot_port={port}

提交任务只允许优先调用：
./bin/omx_visible_dispatch run-one --root . --title "..." --body "..." --timeout 300 --session-action keep --session-action-reason same_domain_continuation --task-contract-json "$PREPARED" --allow-real

如必须分步，只能按顺序调用：
./bin/omx_visible_dispatch doctor --root .
./bin/omx_visible_dispatch submit-new --root . --title "..." --body "..." --session-action keep --session-action-reason same_domain_continuation --task-contract-json "$PREPARED" --allow-real
./bin/omx_visible_dispatch wait --root . --run <run_id> --task task-001 --timeout <seconds>
./bin/omx_visible_dispatch collect --root . --run <run_id> --task task-001

允许状态查看：
./bin/omx_visible_dispatch status --root .
./bin/omx_visible_watcher once --root .
./bin/omx_visible_watcher status --root .
./bin/omx_visible_watcher alerts --root .

禁止 tmux send-keys/paste-buffer，禁止直接调用 omx_opencode_tui_adapter 提交，禁止 direct curl POST /tui/*。
禁止投给 %32/%34/%35，禁止默认使用 vw1/%40/4201，禁止投给未登记 pane。

状态规则：submitted 不等于 received；idle 不等于 completed；只有非空 report.md 加且仅加一个 .done/.fail/.blocked 才是 terminal signal。
如果 run-one 非 0：collect、status、watcher alerts；不要补 Enter，不重复提交，除非 lock 已 terminal 或用户明确授权。
""".format(worker_id=worker_id, pane_id=pane_id, port=port)


def command_prompt_template(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    worker, _scope = resolve_dispatch_worker(
        root,
        None,
        backend=getattr(args, "backend", RUNTIME_BACKEND),
    )
    print(leader_prompt_template(worker), end="")
    return 0


def summarize_delivery(delivery: dict[str, Any]) -> dict[str, Any]:
    responses = delivery.get("responses") if isinstance(delivery, dict) else {}
    if not isinstance(responses, dict):
        responses = {}
    return {
        endpoint: {
            "status": value.get("status"),
            "ok": value.get("ok"),
            "url": value.get("url"),
        }
        for endpoint, value in responses.items()
        if endpoint in {"/tui/clear-prompt", "/tui/append-prompt", "/tui/submit-prompt"} and isinstance(value, dict)
    }


def finalize_summary(
    root: Path,
    run: str,
    task: str,
    *,
    worker: dict[str, Any] | None = None,
    summary_overrides: dict[str, Any] | None = None,
    event_action: str = "finalize-summary",
    fixture: str | None = None,
    runs_root: Path | None = None,
) -> dict[str, Any]:
    base = runs_root or visible_task_state.runs_root_for(root, fixture)
    run_dir = base / run
    tdir = visible_task_state.task_dir(root, run, task, runs_root=base)
    previous_summary = read_json(run_dir / "summary.json")
    truth_before = task_truth(root, run, task, fixture=fixture, runs_root=base)
    previous_summary_state = summary_state_value(previous_summary)
    summary = dict(previous_summary)
    if summary_overrides:
        summary.update(summary_overrides)

    stale_summary_detected = bool(
        summary.get("stale_summary_detected")
        or (
            previous_summary_state
            and previous_summary_state != truth_before.get("protocol_terminal_state")
        )
    )
    summary_claimed_active_lock = bool(summary.get("active_lock_before"))
    summary_claimed_terminal_stale = bool(summary.get("lock_terminal_stale"))
    active_lock_before = bool(truth_before.get("has_active_lock"))
    lock_terminal_stale = bool(truth_before.get("lock_is_terminal_stale"))
    if (
        summary_claimed_active_lock
        and not active_lock_before
    ) or (
        summary_claimed_terminal_stale
        and not lock_terminal_stale
    ):
        stale_summary_detected = True
    archived_lock = ""
    lock_archived_by_finalizer = False
    lock_release_blocked_reason = ""
    terminal_authority_durability: dict[str, Any] = {}
    if lock_terminal_stale:
        lock_rel = str(truth_before.get("lock_path") or "")
        if not lock_rel:
            raise DispatchError("terminal stale lock path is missing")
        terminal_authority_durability = pin_terminal_authority(tdir)
        if terminal_authority_durability.get("ok"):
            archived = archive_lock(
                root,
                root / lock_rel,
                "terminal_only_finalizer_archive",
                expected=(
                    truth_before.get("lock_data")
                    if isinstance(truth_before.get("lock_data"), dict)
                    else {}
                ),
                archive_root=visible_task_state.lock_archive_root_for_runs(base),
            )
            archived_lock = rel(archived, root)
            lock_archived_by_finalizer = bool(archived_lock)
        else:
            lock_release_blocked_reason = str(
                terminal_authority_durability.get("reason") or ""
            )
    truth_after = task_truth(root, run, task, fixture=fixture, runs_root=base)
    owner = str(truth_after.get("owner") or "")
    post_terminal_readiness: dict[str, Any] = {}
    post_terminal_warning = ""
    if truth_after.get("protocol_terminal_state") in VALID_TERMINAL_STATES and owner and base == visible_runs_root(root):
        post_terminal_readiness = record_post_terminal_readiness(
            root,
            run,
            task,
            owner,
            append_busy_event=False,
        )
        if str(post_terminal_readiness.get("readiness")) == "busy":
            post_terminal_warning = "post_terminal_tui_busy"
    else:
        post_terminal_readiness = read_json(tdir / "post_terminal_tui_readiness.json")
        if str(post_terminal_readiness.get("readiness")) == "busy":
            post_terminal_warning = "post_terminal_tui_busy"
    runtime_observation: dict[str, Any] = {}
    runtime_snapshot: dict[str, Any] = {}
    runtime_backend = str(summary.get("runtime_backend") or RUNTIME_BACKEND)
    if owner and base == visible_runs_root(root):
        runtime_observation = record_runtime_observation(root, run, task, owner, runtime_backend)
        runtime_snapshot = runtime_snapshot_from_observation(runtime_observation)
    else:
        runtime_observation = read_json(tdir / "runtime_observation.json")
        runtime_snapshot = read_json(tdir / "runtime_snapshot.json")

    worker_data = worker or {}
    context_compaction_late_observation: dict[str, Any] = {}
    if truth_after.get("protocol_terminal_state") in VALID_TERMINAL_STATES and base == visible_runs_root(root):
        worker_hint = dict(worker_data)
        worker_hint.setdefault("worker_id", owner)
        if not worker_hint.get("port") and summary.get("worker_port"):
            worker_hint["port"] = summary.get("worker_port")
        context_compaction_late_observation = record_late_context_compaction_observation(
            root,
            run,
            task,
            worker=worker_hint,
            post_terminal_readiness=post_terminal_readiness,
            runs_root=base,
        )
        if context_compaction_late_observation.get("detected"):
            truth_after = task_truth(root, run, task, fixture=fixture, runs_root=base)

    lock_status = {
        "active": bool(truth_after.get("has_active_lock")),
        "state": truth_after.get("lock_state"),
        "path": truth_after.get("lock_path") or "",
    }
    wait_result_label = str(summary.get("wait_result") or "")
    if not wait_result_label:
        wait_result_label = "completed" if truth_after.get("protocol_terminal_state") == "completed" else str(
            truth_after.get("protocol_terminal_state") or ""
        )
    run_one_exit_state = str(summary.get("run_one_exit_state") or "")
    if not run_one_exit_state:
        run_one_exit_state = previous_summary_state or wait_result_label or str(truth_after.get("protocol_terminal_state") or "")
    previous_wait_result = str(summary.get("previous_wait_result") or previous_summary.get("wait_result") or "")
    previous_run_one_exit_state = str(
        summary.get("previous_run_one_exit_state") or previous_summary.get("run_one_exit_state") or ""
    )
    recorded_previous_summary_state = str(summary.get("previous_summary_state") or previous_summary_state or "")
    delayed_finalize_enabled = bool(summary.get("delayed_finalize_enabled", False))
    delayed_finalize_seconds = int(summary.get("delayed_finalize_seconds") or 0)
    delayed_finalize_interval = int(summary.get("delayed_finalize_interval") or 0)
    delayed_finalize_attempts = int(summary.get("delayed_finalize_attempts") or 0)
    delayed_finalize_observed_terminal = bool(summary.get("delayed_finalize_observed_terminal", False))
    delayed_finalize_terminal_state = str(summary.get("delayed_finalize_terminal_state") or "")
    archived_lock = str(
        archived_lock
        or (
            summary.get("archived_lock")
            if lock_terminal_stale
            else ""
        )
        or ""
    )
    pending_after_timeout = bool(summary.get("pending_after_timeout") or previous_summary.get("pending_after_timeout"))
    lock_state_after_run_one = str(
        truth_after.get("lock_state")
        or summary.get("lock_state_after_run_one")
        or previous_summary.get("lock_state_after_run_one")
        or "none"
    )
    settle_admissible = bool(truth_after.get("lock_is_terminal_stale"))
    recommended_settle_command = (
        str(
            summary.get("recommended_settle_command")
            or previous_summary.get("recommended_settle_command")
            or settle_command_for(run, task)
        )
        if settle_admissible
        else ""
    )
    current_state = str(truth_after.get("protocol_terminal_state") or "")
    if lock_release_blocked_reason:
        needs_settle = False
        next_safe_action = "manual_operator_review"
    elif current_state in VALID_TERMINAL_STATES:
        needs_settle = False
        next_safe_action = "none"
    elif current_state in INVALID_TERMINAL_STATES:
        needs_settle = False
        next_safe_action = "inspect_invalid_terminal_state"
    else:
        inherited_action = str(
            summary.get("next_safe_action")
            or previous_summary.get("next_safe_action")
            or ""
        )
        if inherited_action.startswith(
            "./bin/omx_visible_dispatch settle"
        ):
            inherited_action = ""
        needs_settle = False
        if inherited_action:
            next_safe_action = inherited_action
        elif pending_after_timeout:
            next_safe_action = (
                "manual_operator_review_or_recovery_handshake"
                if truth_after.get("has_submitted")
                and truth_after.get("has_started")
                else "manual_operator_review"
            )
        else:
            next_safe_action = "none"

    if (
        not lock_release_blocked_reason
        and truth_after.get("has_active_lock")
        and current_state in INVALID_TERMINAL_STATES
    ):
        lock_release_blocked_reason = current_state

    summary.update({
        "schema_version": 1,
        "generated_at": utc_now(),
        "run_id": run,
        "task_id": task,
        "task_dir": rel(tdir, root),
        "worker": worker_data.get("worker_id") or truth_after.get("owner") or summary.get("worker"),
        "runtime_backend": summary.get("runtime_backend") or RUNTIME_BACKEND,
        "pane": worker_data.get("pane_id") or summary.get("pane", ""),
        "port": worker_data.get("port") or summary.get("port", ""),
        "protocol_terminal_state": truth_after.get("protocol_terminal_state"),
        "final_protocol_terminal_state": truth_after.get("protocol_terminal_state"),
        "terminal_state": truth_after.get("protocol_terminal_state"),
        "pending_after_timeout": pending_after_timeout,
        "needs_settle": needs_settle,
        "recommended_settle_command": recommended_settle_command,
        "lock_state_after_run_one": lock_state_after_run_one,
        "next_safe_action": next_safe_action,
        "lock_release_blocked_reason": lock_release_blocked_reason,
        "terminal_authority_durability": {
            key: terminal_authority_durability.get(key)
            for key in ("ok", "reason", "pinned")
        },
        "terminal_marker": truth_after.get("terminal_marker"),
        "terminal_markers": truth_after.get("terminal_markers", []),
        "terminal_marker_count": truth_after.get("terminal_marker_count"),
        "flow_markers": truth_after.get("flow_markers", []),
        "report_path": rel(tdir / "report.md", root),
        "report_bytes": truth_after.get("report_bytes", 0),
        "summary_json": rel(run_dir / "summary.json", root),
        "summary_md": rel(run_dir / "summary.md", root),
        "previous_summary_state": recorded_previous_summary_state,
        "previous_wait_result": previous_wait_result,
        "previous_run_one_exit_state": previous_run_one_exit_state,
        "summary_reconciled": bool(
            summary.get("summary_reconciled")
            or delayed_finalize_observed_terminal
            or
            stale_summary_detected
            or lock_archived_by_finalizer
            or not previous_summary
            or summary_state_value(previous_summary) != str(truth_after.get("protocol_terminal_state") or "")
        ),
        "stale_summary_detected": stale_summary_detected,
        "active_lock_before": active_lock_before,
        "lock_terminal_stale": lock_terminal_stale,
        "lock_archived_by_finalizer": lock_archived_by_finalizer,
        "archived_lock": archived_lock,
        "finalizer_timestamp": utc_now(),
        "lock_status": lock_status,
        "delayed_finalize_enabled": delayed_finalize_enabled,
        "delayed_finalize_seconds": delayed_finalize_seconds,
        "delayed_finalize_interval": delayed_finalize_interval,
        "delayed_finalize_attempts": delayed_finalize_attempts,
        "delayed_finalize_observed_terminal": delayed_finalize_observed_terminal,
        "delayed_finalize_terminal_state": delayed_finalize_terminal_state,
        "delivery_path": rel(tdir / "delivery.json", root) if (tdir / "delivery.json").is_file() else "",
        "delivery_responses": summarize_delivery(read_json(tdir / "delivery.json")),
        "pre_submit_tui_readiness": read_json(tdir / "pre_submit_tui_readiness.json"),
        "post_terminal_tui_readiness": post_terminal_readiness,
        "runtime_snapshot_path": rel(tdir / "runtime_snapshot.json", root) if (tdir / "runtime_snapshot.json").is_file() else "",
        "runtime_snapshot_ok": bool(runtime_snapshot.get("ok")) if isinstance(runtime_snapshot, dict) else False,
        "runtime_snapshot_status": str((runtime_snapshot.get("status") if isinstance(runtime_snapshot, dict) else "") or ""),
        "runtime_snapshot_backend_type": str((runtime_snapshot.get("backend_type") if isinstance(runtime_snapshot, dict) else "") or ""),
        "runtime_observation_path": rel(tdir / "runtime_observation.json", root) if (tdir / "runtime_observation.json").is_file() else "",
        "runtime_observation_ok": bool(runtime_observation.get("ok")) if isinstance(runtime_observation, dict) else False,
        "runtime_observation_status": str((runtime_observation.get("status") if isinstance(runtime_observation, dict) else "") or ""),
        "runtime_observation_readiness": str((runtime_observation.get("readiness") if isinstance(runtime_observation, dict) else "") or ""),
        "runtime_observation_backend_type": str((runtime_observation.get("backend_type") if isinstance(runtime_observation, dict) else "") or ""),
        "runtime_observation_session_id": str((runtime_observation.get("session_id") if isinstance(runtime_observation, dict) else "") or ""),
        "runtime_observation_window_id": str((runtime_observation.get("window_id") if isinstance(runtime_observation, dict) else "") or ""),
        "runtime_observation_pane_id": str((runtime_observation.get("pane_id") if isinstance(runtime_observation, dict) else "") or ""),
        "runtime_observation_process_id": runtime_observation.get("process_id") if isinstance(runtime_observation, dict) else None,
        "post_terminal_warning": post_terminal_warning,
        "context_compaction_late_observation": context_compaction_late_observation,
        "session_status_summary": post_terminal_readiness.get("session_status_summary", {}) if isinstance(post_terminal_readiness, dict) else {},
        "wait_result": wait_result_label,
        "run_one_exit_state": run_one_exit_state,
        "evidence_paths": truth_after.get("evidence_paths", {}),
    })
    write_json(run_dir / "summary.json", summary)
    write_text(run_dir / "summary.md", render_summary_markdown(summary, truth_after, root))
    event = {
        "schema_version": 1,
        "action": event_action,
        "finalized_at": summary["finalizer_timestamp"],
        "run": run,
        "task": task,
        "previous_summary_state": previous_summary_state,
        "stale_summary_detected": stale_summary_detected,
        "active_lock_before": active_lock_before,
        "lock_terminal_stale": lock_terminal_stale,
        "lock_archived_by_finalizer": lock_archived_by_finalizer,
        "archived_lock": archived_lock,
        "before_state": truth_before.get("protocol_terminal_state"),
        "after_state": truth_after.get("protocol_terminal_state"),
        "previous_wait_result": previous_wait_result,
        "previous_run_one_exit_state": previous_run_one_exit_state,
        "final_protocol_terminal_state": truth_after.get("protocol_terminal_state"),
        "pending_after_timeout": pending_after_timeout,
        "needs_settle": needs_settle,
        "recommended_settle_command": recommended_settle_command,
        "lock_state_after_run_one": lock_state_after_run_one,
        "next_safe_action": next_safe_action,
        "lock_release_blocked_reason": lock_release_blocked_reason,
        "terminal_authority_durability": {
            key: terminal_authority_durability.get(key)
            for key in ("ok", "reason", "pinned")
        },
        "delayed_finalize_enabled": delayed_finalize_enabled,
        "delayed_finalize_seconds": delayed_finalize_seconds,
        "delayed_finalize_interval": delayed_finalize_interval,
        "delayed_finalize_attempts": delayed_finalize_attempts,
        "delayed_finalize_observed_terminal": delayed_finalize_observed_terminal,
        "delayed_finalize_terminal_state": delayed_finalize_terminal_state,
        "no_business_files_modified": True,
    }
    write_finalizer_event(root, run, task, event, runs_root=base)
    return summary


def settle_task(
    root: Path,
    run: str,
    task: str,
    *,
    allow_terminal_archive: bool,
    fixture: str | None = None,
    runs_root: Path | None = None,
) -> tuple[int, dict[str, Any]]:
    if not allow_terminal_archive:
        raise DispatchError("settle requires --allow-terminal-archive")
    base = runs_root or visible_task_state.runs_root_for(root, fixture)
    before = task_truth(root, run, task, fixture=fixture, runs_root=base)
    state = str(before.get("protocol_terminal_state") or "")
    previous_summary = before.get("summary_data", {}) if isinstance(before.get("summary_data"), dict) else {}
    pending_after_timeout = bool(
        previous_summary.get("pending_after_timeout")
        or previous_summary.get("run_one_exit_state") == "pending_after_timeout"
    )
    overrides = {
        "pending_after_timeout": pending_after_timeout,
        "recommended_settle_command": settle_command_for(run, task),
        "lock_state_after_run_one": (
            previous_summary.get("lock_state_after_run_one")
            or before.get("lock_state")
            or "none"
        ),
    }
    if state == "submit_failed":
        if before.get("has_active_lock") and before.get("lock_path"):
            archive_lock(
                root,
                lock_path(root, str(before.get("owner") or "")),
                "submit_failed_finalizer_archive",
                expected=(
                    before.get("lock_data")
                    if isinstance(before.get("lock_data"), dict)
                    else {}
                ),
            )
        overrides.update({
            "needs_settle": False,
            "next_safe_action": "none",
        })
        summary = finalize_summary(
            root,
            run,
            task,
            summary_overrides=overrides,
            event_action="settle",
            fixture=fixture,
            runs_root=base,
        )
        return 0, summary
    if state in VALID_TERMINAL_STATES:
        overrides.update({
            "needs_settle": False,
            "next_safe_action": "none",
        })
        summary = finalize_summary(
            root,
            run,
            task,
            summary_overrides=overrides,
            event_action="settle",
            fixture=fixture,
            runs_root=base,
        )
        if summary.get("lock_release_blocked_reason"):
            return 1, summary
        return 0, summary
    if state in INVALID_TERMINAL_STATES:
        overrides.update({
            "needs_settle": False,
            "next_safe_action": "inspect_invalid_terminal_state",
        })
        summary = finalize_summary(
            root,
            run,
            task,
            summary_overrides=overrides,
            event_action="settle",
            fixture=fixture,
            runs_root=base,
        )
        return 2, summary
    needs_settle = bool(before.get("has_active_lock") or pending_after_timeout)
    drift_tdir = base / run / "tasks" / task
    if (
        str(
            read_json(drift_tdir / "protocol_status.json").get("status")
            or ""
        )
        == "finish_refused_acceptance_fence"
    ):
        if _reviewed_session_drift_eligible(drift_tdir):
            next_safe_action = interrupted_recovery_command_for(
                run,
                task,
                "finish_refused_session_drift",
                root=root,
            )
        else:
            next_safe_action = task_state_query_command_for(root, run, task)
        overrides.update({
            "needs_settle": needs_settle,
            "next_safe_action": next_safe_action,
        })
        summary = finalize_summary(
            root,
            run,
            task,
            summary_overrides=overrides,
            event_action="settle",
            fixture=fixture,
            runs_root=base,
        )
        return (1 if before.get("has_active_lock") else 0), summary
    overrides.update({
        "needs_settle": needs_settle,
        "next_safe_action": settle_command_for(run, task) if needs_settle else "none",
    })
    summary = finalize_summary(
        root,
        run,
        task,
        summary_overrides=overrides,
        event_action="settle",
        fixture=fixture,
        runs_root=base,
    )
    return (1 if before.get("has_active_lock") else 0), summary


def settle_latest(
    root: Path,
    *,
    allow_terminal_archive: bool,
    worker_id: str | None = None,
    fixture: str | None = None,
    runtime_backend: str = RUNTIME_BACKEND,
) -> tuple[int, dict[str, Any]]:
    scope_worker = safe_id(worker_id, "worker") if worker_id else ""
    base = visible_task_state.runs_root_for(root, fixture)
    if not scope_worker:
        return 2, {
            "run_id": "",
            "task_id": "",
            "protocol_terminal_state": "",
            "lock_state_before": "none",
            "lock_state_after": "none",
            "summary_reconciled": False,
            "lock_archived_by_finalizer": False,
            "pending_after_timeout": False,
            "needs_settle": False,
            "recommended_settle_command": "",
            "next_safe_action": "none",
            "message": "global settle-latest is not attribution-safe under concurrent workers; use --worker",
            "settle_scope": "global",
            "settle_worker_id": "",
            "runtime_backend": runtime_backend,
            "runtime_backend_type": backend_type_for(runtime_backend),
        }
    latest = latest_visible_run(root, worker_id=scope_worker, runs_root_override=base)
    if not latest:
        return 0, {
            "run_id": "",
            "task_id": "",
            "protocol_terminal_state": "",
            "lock_state_before": "none",
            "lock_state_after": "none",
            "summary_reconciled": False,
            "lock_archived_by_finalizer": False,
            "pending_after_timeout": False,
            "needs_settle": False,
            "message": f"no latest run for worker {scope_worker}",
            "settle_scope": "worker",
            "settle_worker_id": scope_worker,
            "runtime_backend": runtime_backend,
            "runtime_backend_type": backend_type_for(runtime_backend),
        }
    tasks = latest.get("tasks", []) if isinstance(latest.get("tasks"), list) else []
    if not tasks:
        return 0, {
            "run_id": str(latest.get("run_id") or ""),
            "task_id": "",
            "protocol_terminal_state": "",
            "lock_state_before": "none",
            "lock_state_after": "none",
            "summary_reconciled": False,
            "lock_archived_by_finalizer": False,
            "pending_after_timeout": False,
            "needs_settle": False,
            "message": f"latest run has no tasks for worker {scope_worker}",
            "settle_scope": "worker",
            "settle_worker_id": scope_worker,
            "runtime_backend": runtime_backend,
            "runtime_backend_type": backend_type_for(runtime_backend),
        }
    task_info = tasks[0]
    run = str(latest.get("run_id") or "")
    task = str(task_info.get("task") or "")
    truth_before = task_truth(root, run, task, fixture=fixture, runs_root=base)
    rc, summary = settle_task(root, run, task, allow_terminal_archive=allow_terminal_archive, fixture=fixture, runs_root=base)
    truth_after = task_truth(root, run, task, fixture=fixture, runs_root=base)
    return rc, {
        "run_id": run,
        "task_id": task,
        "protocol_terminal_state": summary.get("protocol_terminal_state") or truth_after.get("protocol_terminal_state") or "",
        "lock_state_before": truth_before.get("lock_state") or "none",
        "lock_state_after": truth_after.get("lock_state") or "none",
        "summary_reconciled": bool(summary.get("summary_reconciled")),
        "lock_archived_by_finalizer": bool(summary.get("lock_archived_by_finalizer")),
        "pending_after_timeout": bool(summary.get("pending_after_timeout")),
        "needs_settle": bool(summary.get("needs_settle")),
        "recommended_settle_command": summary.get("recommended_settle_command") or settle_command_for(run, task),
        "next_safe_action": summary.get("next_safe_action") or "none",
        "message": "",
        "settle_scope": "worker",
        "settle_worker_id": scope_worker,
        "runtime_backend": runtime_backend,
        "runtime_backend_type": backend_type_for(runtime_backend),
    }


def pre_submit_settle(
    root: Path,
    *,
    worker_id: str,
    locks: list[dict[str, Any]],
) -> tuple[int, dict[str, Any]]:
    """Settle the target worker's exact occupancy before a new submit.

    The settle target comes from the worker's own lock record; with no target
    occupancy there is nothing to settle and run history is not traversed.
    Worker-scoped settle-latest remains the manual history-maintenance command.
    """
    target: tuple[str, str, dict[str, Any]] | None = None
    for item in locks:
        if str(item.get("worker_id") or "") != worker_id:
            continue
        run = str(item.get("run_id") or "")
        task = str(item.get("task_id") or "")
        if not run or not task:
            continue
        truth = item.get("task_truth", {}) if isinstance(item.get("task_truth"), dict) else {}
        lock_state = str(truth.get("lock_state") or "")
        protocol_state = str(truth.get("protocol_terminal_state") or "")
        if protocol_state in INVALID_TERMINAL_STATES:
            return 2, {
                "run_id": run,
                "task_id": task,
                "protocol_terminal_state": protocol_state,
                "lock_state_before": lock_state or "none",
                "lock_state_after": lock_state or "none",
                "summary_reconciled": False,
                "lock_archived_by_finalizer": False,
                "pending_after_timeout": False,
                "needs_settle": False,
                "recommended_settle_command": "",
                "next_safe_action": "inspect_invalid_terminal_state",
                "message": f"worker {worker_id} target occupancy is in an invalid terminal state: {run}/{task}",
                "settle_scope": "worker",
                "settle_worker_id": worker_id,
            }
        if lock_state == "active_lock":
            return 1, {
                "run_id": run,
                "task_id": task,
                "protocol_terminal_state": protocol_state,
                "lock_state_before": "active_lock",
                "lock_state_after": "active_lock",
                "summary_reconciled": False,
                "lock_archived_by_finalizer": False,
                "pending_after_timeout": False,
                "needs_settle": False,
                "recommended_settle_command": "",
                "next_safe_action": "none",
                "message": f"worker {worker_id} target occupancy is active nonterminal: {run}/{task}",
                "settle_scope": "worker",
                "settle_worker_id": worker_id,
            }
        target = (run, task, truth)
        break
    if target is None:
        return 0, {
            "run_id": "",
            "task_id": "",
            "protocol_terminal_state": "",
            "lock_state_before": "none",
            "lock_state_after": "none",
            "summary_reconciled": False,
            "lock_archived_by_finalizer": False,
            "pending_after_timeout": False,
            "needs_settle": False,
            "recommended_settle_command": "",
            "next_safe_action": "none",
            "message": f"no target occupancy for worker {worker_id}",
            "settle_scope": "worker",
            "settle_worker_id": worker_id,
        }
    run, task, truth = target
    settle_rc, summary = settle_task(root, run, task, allow_terminal_archive=True)
    truth_after = task_truth(root, run, task)
    return settle_rc, {
        "run_id": run,
        "task_id": task,
        "protocol_terminal_state": summary.get("protocol_terminal_state") or truth_after.get("protocol_terminal_state") or "",
        "lock_state_before": str(truth.get("lock_state") or "none"),
        "lock_state_after": str(truth_after.get("lock_state") or "none"),
        "summary_reconciled": bool(summary.get("summary_reconciled")),
        "lock_archived_by_finalizer": bool(summary.get("lock_archived_by_finalizer")),
        "pending_after_timeout": bool(summary.get("pending_after_timeout")),
        "needs_settle": bool(summary.get("needs_settle")),
        "recommended_settle_command": summary.get("recommended_settle_command") or settle_command_for(run, task),
        "next_safe_action": summary.get("next_safe_action") or "none",
        "message": "",
        "settle_scope": "worker",
        "settle_worker_id": worker_id,
    }


def _return_reused_run_one_dispatch_claim(
    *,
    root: Path,
    claim: dict[str, Any],
) -> int:
    run = str(claim.get("run_id") or "")
    task = str(claim.get("task_id") or "")
    tdir = task_dir(root, run, task)
    print("== dispatch-claim ==")
    print("dispatch_claim_reused: true")
    print(f"dispatch_claim_id: {claim.get('claim_id') or '-'}")
    print(f"dispatch_claim_status: {claim.get('status') or '-'}")
    print(f"run_id: {run}")
    print(f"task_id: {task}")
    print(f"task_dir: {rel(tdir, root)}")
    if not tdir.is_dir():
        print("pending_after_timeout: true")
        print("needs_settle: false")
        print("why_blocked: dispatch_claim_task_not_prepared")
        return 1
    truth = task_truth(root, run, task)
    protocol_state = str(
        truth.get("protocol_terminal_state") or ""
    )
    print(f"protocol_terminal_state: {protocol_state or '-'}")
    if protocol_state in VALID_TERMINAL_STATES:
        task_record = read_json(tdir / "task.json")
        task_contract = task_record.get("task_contract")
        if (
            isinstance(task_contract, dict)
            and validate_task_contract(task_contract, "").get("configured")
        ):
            validation = read_json(
                tdir / "report_contract_validation.json"
            )
            contract_status = str(
                validation.get("semantic_status") or ""
            )
            print(f"report_contract_status: {contract_status or '-'}")
            if contract_status != "passed":
                print("why_blocked: report_contract_not_passed")
                return 1
        print("pending_after_timeout: false")
        print("needs_settle: false")
        return 0
    print("pending_after_timeout: true")
    print(
        "needs_settle: "
        f"{str(bool(truth.get('lock_is_terminal_stale'))).lower()}"
    )
    print("why_blocked: dispatch_claim_already_owned")
    return 1


def _command_run_one_impl(args: argparse.Namespace, submitter: Any) -> int:
    resolve_body_file_argument(args)
    ensure_nonempty_task_body(args.body)
    root = root_path(args.root)
    backend = getattr(args, "backend", RUNTIME_BACKEND)
    task_contract = parse_task_contract_json(
        getattr(args, "task_contract_json", "")
    )
    session_decision = run_one_session_decision(args)
    reset_recovery_reservation = (
        run_one_reset_recovery_reservation(
            args,
            session_decision=session_decision,
        )
    )
    if (
        session_decision["session_action"] == "rotate"
        and submitter is submit_task_native
    ):
        raise DispatchError(
            "run-one-native does not support session_action rotate"
        )
    if not args.allow_real:
        raise DispatchError("run-one requires --allow-real")
    _run_one_operation_contract(task_contract)
    run_one_capability = _extract_run_one_capability(task_contract)
    task_id = str(run_one_capability.get("task_id") or "")
    run_one_worker_id = str(
        (run_one_capability.get("scope") or {}).get("id") or ""
    )
    if not run_one_worker_id:
        raise DispatchError("operation capability worker scope is required")
    requested_worker_id = getattr(args, "worker", None)
    if requested_worker_id and requested_worker_id != run_one_worker_id:
        raise DispatchError("requested worker does not match capability scope")
    operation_contract = _prepare_worker_dispatch_operation_contract(
        root,
        task_contract,
        run_one_worker_id,
        task_id=task_id,
    )

    def revoke_rejected_grant() -> None:
        _revoke_worker_dispatch_authorization(
            root,
            operation_contract,
            run_one_worker_id,
            provenance="dispatch-rejected-revoke",
        )

    dispatch_claim = _reserve_worker_dispatch_claim(
        root=root,
        args=args,
        capability=run_one_capability,
        worker_id=run_one_worker_id,
        task_id=task_id,
    )
    if dispatch_claim["action"] == "reuse":
        _predecessor_handoff_replay_conflict_check(
            root,
            args,
            task_contract,
            run_one_capability,
        )
        return _return_reused_run_one_dispatch_claim(
            root=root,
            claim=dispatch_claim,
        )
    run = str(dispatch_claim["run_id"])
    task = str(dispatch_claim["task_id"])
    _write_run_one_receipt_out(
        str(getattr(args, "receipt_out", "") or ""),
        phase="claim_reserved",
        fields={
            "worker_id": run_one_worker_id,
            "run_id": run,
            "task_id": task,
            "task_dir": str(dispatch_claim.get("task_dir") or ""),
            "dispatch_claim_path": str(dispatch_claim.get("claim_path") or ""),
            "attempt_id": str(
                run_one_capability.get("attempt_id") or ""
            ),
            # No trusted standalone event source exists inside the
            # validated capability; an explicit unknown beats an empty
            # string masquerading as identity.
            "event_id": "unknown",
            "task_created": False,
        },
    )

    print("== doctor ==")
    doctor_report = build_doctor_report(
        root,
        worker_id=run_one_worker_id,
        backend=backend,
        reset_recovery_reservation=reset_recovery_reservation,
    )
    worker = doctor_report.get("default_worker", {})
    preflight = evaluate_run_dispatch_preflight(run_one_worker_id, doctor_report)
    if not doctor_report.get("ok") or not preflight.get("ok"):
        print_run_dispatch_preflight(preflight)
        revoke_rejected_grant()
        print(json.dumps({
            "doctor": "error",
            "requested_worker_id": run_one_worker_id,
            "errors": doctor_report.get("errors", []),
            "warnings": doctor_report.get("warnings", []),
            "run_preflight": preflight,
        }, indent=2, ensure_ascii=False))
        return 2
    resolved_worker_id = str(worker.get("worker_id") or "")
    worker_role = str(worker.get("role") or "")
    print(
        f"doctor: OK resolved_worker={resolved_worker_id} role={worker_role} "
        f"pane={worker.get('pane_id')} port={worker.get('port')}"
    )
    print(f"runtime_backend: {backend}")
    if resolved_worker_id != run_one_worker_id:
        revoke_rejected_grant()
        raise DispatchError("doctor worker does not match capability scope")
    print("== pre-submit settle ==")
    if reset_recovery_reservation is None:
        settle_rc, settle_result = pre_submit_settle(
            root,
            worker_id=resolved_worker_id,
            locks=doctor_report.get("locks", []) if isinstance(doctor_report.get("locks"), list) else [],
        )
    else:
        settle_rc = 0
        settle_result = {
            "run_id": "",
            "task_id": "",
            "protocol_terminal_state": "",
            "lock_state_before": "reset_recovery_reserved",
            "lock_state_after": "reset_recovery_reserved",
            "summary_reconciled": False,
            "lock_archived_by_finalizer": False,
            "pending_after_timeout": False,
            "message": (
                "expected reset recovery reservation preserved "
                "for atomic submit handoff"
            ),
            "settle_scope": "worker",
            "settle_worker_id": resolved_worker_id,
        }
    print(f"settle_scope: {settle_result.get('settle_scope') or 'worker'}")
    print(f"settle_worker_id: {settle_result.get('settle_worker_id') or resolved_worker_id}")
    print(f"settle_run_id: {settle_result.get('run_id') or '-'}")
    print(f"settle_task_id: {settle_result.get('task_id') or '-'}")
    print(f"protocol_terminal_state: {settle_result.get('protocol_terminal_state') or '-'}")
    print(f"lock_state_before: {settle_result.get('lock_state_before') or '-'}")
    print(f"lock_state_after: {settle_result.get('lock_state_after') or '-'}")
    print(f"summary_reconciled: {str(bool(settle_result.get('summary_reconciled'))).lower()}")
    print(f"lock_archived_by_finalizer: {str(bool(settle_result.get('lock_archived_by_finalizer'))).lower()}")
    print(f"pending_after_timeout: {str(bool(settle_result.get('pending_after_timeout'))).lower()}")
    if settle_result.get("message"):
        print(f"message: {settle_result.get('message')}")
    if settle_rc == 1:
        preflight = {
            **preflight,
            "ok": False,
            "status": "failed",
            "failed_reason": "target_busy",
        }
        print_run_dispatch_preflight(preflight)
        print("pre_submit_blocked: active target task still nonterminal")
        print("why_blocked: active_nonterminal_lock")
        print(f"suggested_command: {settle_result.get('recommended_settle_command') or settle_latest_command(resolved_worker_id)}")
        revoke_rejected_grant()
        return 1
    if settle_rc == 2:
        preflight = {
            **preflight,
            "ok": False,
            "status": "failed",
            "failed_reason": "invalid_terminal_state",
        }
        print_run_dispatch_preflight(preflight)
        print("pre_submit_blocked: target task is in an invalid terminal state")
        print("why_blocked: invalid_terminal_state")
        print(f"suggested_command: {settle_result.get('recommended_settle_command') or settle_latest_command(resolved_worker_id)}")
        revoke_rejected_grant()
        return 2
    print_run_dispatch_preflight(preflight)
    _print_prompt_delivery_scope_notice(task_contract)

    rotation_request = run_one_rotation_request(
        args,
        task_id=task,
        attempt_id=run,
        role=worker_role or "visible-worker",
        contract_hash=_canonical_json_hash(
            {"title": args.title, "body": args.body}
        ),
    )
    print("== new-task ==")
    tdir = task_dir(root, run, task)
    expected_session_record = task_session_action_record(
        resolved_worker_id,
        session_decision,
        args=args,
        rotation_request=rotation_request,
    )
    if session_decision is not None:
        try:
            run_one_worker = worker_record(root, resolved_worker_id)
        except DispatchError:
            run_one_worker = {}
        require_supported_worker_session_action(run_one_worker, session_decision)
    if (
        dispatch_claim["action"] == "takeover"
        and tdir.is_dir()
        and (tdir / "task.json").is_file()
    ):
        task_record = read_json(tdir / "task.json")
        if (
            task_record.get("id") != task
            or task_record.get("run") != run
            or task_record.get("owner") != resolved_worker_id
            or task_record.get("title") != args.title
            or task_record.get("body") != args.body
            or (
                task_record.get("task_contract")
                if isinstance(task_record.get("task_contract"), dict)
                else None
            )
            != task_contract
            or task_record.get("operation_contract") != operation_contract
            or read_json(tdir / "session_action.json")
            != expected_session_record
        ):
            revoke_rejected_grant()
            raise DispatchError(
                "run-one dispatch claim task identity mismatch"
            )
        session_record = expected_session_record
        # Takeover uses the same protected preparation transaction as the
        # create path: worker admission, binding lease, active-target-lock
        # refusal and the current dispatch grant mutation boundary wrap the
        # handoff gate, so a late admission/revocation refusal or evidence
        # drift consumes nothing and sends nothing.
        with _authorized_task_preparation(
            root,
            operation_contract,
            resolved_worker_id,
        ):
            predecessor_handoff_claim = (
                _prepare_predecessor_handoff_for_run_one(
                    root,
                    args,
                    task_contract,
                    run_one_capability,
                    dispatch_claim,
                )
            )
            if predecessor_handoff_claim is not None:
                predecessor_block = (
                    predecessor_handoff_claim.get("predecessor") or {}
                )
                print(
                    "predecessor_handoff_claim: "
                    f"{predecessor_handoff_claim.get('action')} "
                    f"predecessor_task="
                    f"{predecessor_block.get('task') or '-'} "
                    f"successor_task={task}"
                )
    else:
        try:
            with _authorized_task_preparation(
                root,
                operation_contract,
                resolved_worker_id,
            ):
                predecessor_handoff_claim = (
                    _prepare_predecessor_handoff_for_run_one(
                        root,
                        args,
                        task_contract,
                        run_one_capability,
                        dispatch_claim,
                    )
                )
                if predecessor_handoff_claim is not None:
                    predecessor_block = (
                        predecessor_handoff_claim.get("predecessor") or {}
                    )
                    print(
                        "predecessor_handoff_claim: "
                        f"{predecessor_handoff_claim.get('action')} "
                        f"predecessor_task="
                        f"{predecessor_block.get('task') or '-'} "
                        f"successor_task={task}"
                    )
                tdir = create_task(
                    root,
                    run,
                    task,
                    resolved_worker_id,
                    args.title,
                    args.body,
                    runtime_backend=backend,
                    runtime_backend_type=backend_type_for(backend),
                    task_contract=task_contract,
                    operation_contract=operation_contract,
                    session_action=str(session_decision.get("session_action") or ""),
                )
                session_record = write_task_session_action(
                    tdir,
                    resolved_worker_id,
                    session_decision,
                    args=args,
                    rotation_request=rotation_request,
                )
        except DispatchError:
            revoke_rejected_grant()
            raise
    try:
        dispatch_claim = mark_run_one_dispatch_claim_prepared(
            root=root,
            claim=dispatch_claim,
            tdir=tdir,
        )
    except DispatchError:
        revoke_rejected_grant()
        raise
    _write_run_one_receipt_out(
        str(getattr(args, "receipt_out", "") or ""),
        phase="task_prepared",
        fields={
            "worker_id": run_one_worker_id,
            "run_id": run,
            "task_id": task,
            "task_dir": str(dispatch_claim.get("task_dir") or ""),
            "dispatch_claim_path": str(dispatch_claim.get("claim_path") or ""),
            "attempt_id": str(
                run_one_capability.get("attempt_id") or ""
            ),
            "event_id": "unknown",
            "task_created": True,
        },
    )
    if dispatch_claim.get("claim_id"):
        print(
            f"dispatch_claim_id: {dispatch_claim['claim_id']}"
        )
        print(
            "dispatch_claim_path: "
            + rel(Path(str(dispatch_claim["claim_path"])), root)
        )
    print(f"run_id: {run}")
    print(f"task_id: {task}")
    print(f"task_dir: {rel(tdir, root)}")

    print("== submit ==")
    try:
        if rotation_request is None:
            submit_options: dict[str, Any] = {
                "allow_real": True,
                "runtime_backend": backend,
                "session_decision": session_record,
            }
            if reset_recovery_reservation is not None:
                submit_options["reset_recovery_reservation"] = (
                    reset_recovery_reservation
                )
            submit_code = submitter(
                root,
                run,
                task,
                resolved_worker_id,
                **submit_options,
            )
        else:
            submit_code = submitter(
                root,
                run,
                task,
                resolved_worker_id,
                allow_real=True,
                runtime_backend=backend,
                pre_submit_rotation=rotation_request,
                session_decision=session_record,
            )
    except DispatchError as exc:
        _revoke_rejected_dispatch_before_delivery(
            root,
            tdir,
            resolved_worker_id,
            operation_contract,
        )
        print(f"ERROR: submit failed: {exc}", file=sys.stderr)
        submit_code = 1
        write_json(tdir / "submit_error.json", {
            "schema_version": 1,
            "failed_at": utc_now(),
            "run": run,
            "task": task,
            "worker": worker.get("worker_id"),
            "error": str(exc),
        })
    wait_result: dict[str, Any] = {}
    collect_result: dict[str, Any] = {}
    delayed_finalize = {
        "delayed_finalize_enabled": bool(int(args.finalize_linger_seconds) > 0),
        "delayed_finalize_seconds": max(0, int(args.finalize_linger_seconds)),
        "delayed_finalize_interval": max(1, int(args.finalize_linger_interval)),
        "delayed_finalize_attempts": 0,
        "delayed_finalize_observed_terminal": False,
        "delayed_finalize_terminal_state": "",
    }
    if submit_code != 0:
        summary = finalize_summary(
            root,
            run,
            task,
            worker=worker,
            summary_overrides={
                "submit_returncode": submit_code,
                "wait_returncode": None,
                "wait_result": "submit_failed",
                "collect_returncode": None,
                "doctor_ok": doctor_report.get("ok"),
                "run_one_exit_state": "submit_failed",
                "requested_worker_id": requested_worker_id or "",
                "resolved_worker_id": resolved_worker_id,
                "worker_role": worker_role,
                "runtime_backend": backend,
                "worker_pane": worker.get("pane_id"),
                "worker_port": worker.get("port"),
                "worker_scoped_settle_used": True,
                "pending_after_timeout": False,
                "needs_settle": False,
                "recommended_settle_command": settle_command_for(run, task),
                "lock_state_after_run_one": "none",
                "next_safe_action": "inspect_submit_error",
                **delayed_finalize,
            },
        )
        print(f"summary_json: {summary['summary_json']}")
        print(f"summary_md: {summary['summary_md']}")
        return 2

    print("== wait ==")
    with readonly_wait_window():
        wait_result = run_command(
            [str(dispatch_path(root)), "wait", "--root", str(root), "--run", run, "--task", task, "--timeout", str(args.timeout)],
            root,
            timeout=int(args.timeout) + 60,
        )
    print(wait_result.get("stdout", ""), end="")
    if not wait_result.get("timed_out"):
        print(wait_result.get("stderr", ""), end="", file=sys.stderr)
    elif str(wait_result.get("stderr") or "").strip() not in {"", "command timed out"}:
        print(
            f"intermediate_wait_stderr: {str(wait_result.get('stderr') or '').strip()}",
            file=sys.stderr,
        )

    print("== collect ==")
    collect_result = run_command(
        [str(dispatch_path(root)), "collect", "--root", str(root), "--run", run, "--task", task, "--compact", "--completion-json"],
        root,
        timeout=45,
    )
    collect_completed = parse_collect_completed(collect_result)
    collect_output = (
        json.loads(collect_result["stdout"])["output"]
        if collect_completed else collect_result.get("stdout", "")
    )
    print(collect_output, end="")
    print(collect_result.get("stderr", ""), end="", file=sys.stderr)
    print("== finalize-summary ==")
    wait_result_label = parse_wait_result_label(wait_result)
    truth_after_collect = task_truth(root, run, task)

    def finalize_from_truth(truth_for_overrides: dict[str, Any]) -> dict[str, Any]:
        return finalize_summary(
            root,
            run,
            task,
            worker=worker,
            summary_overrides={
                "submit_returncode": submit_code,
                "wait_returncode": wait_result.get("returncode"),
                "wait_result": wait_result_label,
                "collect_returncode": collect_result.get("returncode"),
                "collect_completed": collect_completed,
                "doctor_ok": doctor_report.get("ok"),
                "requested_worker_id": requested_worker_id or "",
                "resolved_worker_id": resolved_worker_id,
                "worker_role": worker_role,
                "runtime_backend": backend,
                "worker_pane": worker.get("pane_id"),
                "worker_port": worker.get("port"),
                "worker_scoped_settle_used": True,
                **run_one_summary_overrides(run, task, truth_for_overrides, wait_result_label),
                **delayed_finalize,
            },
        )

    summary = finalize_from_truth(truth_after_collect)
    print(f"protocol_terminal_state: {summary.get('protocol_terminal_state')}")
    print(f"summary_reconciled: {str(bool(summary.get('summary_reconciled'))).lower()}")
    print(f"stale_summary_detected: {str(bool(summary.get('stale_summary_detected'))).lower()}")
    print(f"lock_archived_by_finalizer: {str(bool(summary.get('lock_archived_by_finalizer'))).lower()}")

    if (
        wait_result_label in RUN_ONE_DELAYED_FINALIZE_WAIT_RESULTS
        and summary.get("protocol_terminal_state") not in VALID_TERMINAL_STATES
    ):
        print("== delayed finalize linger ==")
        delayed_finalize = delayed_finalize_scan(
            root,
            run,
            task,
            linger_seconds=args.finalize_linger_seconds,
            linger_interval=args.finalize_linger_interval,
            max_total_seconds=args.timeout,
        )
        if delayed_finalize.get("delayed_finalize_observed_terminal"):
            summary = finalize_from_truth(task_truth(root, run, task))
        print(f"delayed_finalize_enabled: {str(bool(delayed_finalize.get('delayed_finalize_enabled'))).lower()}")
        print(f"delayed_finalize_seconds: {delayed_finalize.get('delayed_finalize_seconds')}")
        print(f"delayed_finalize_interval: {delayed_finalize.get('delayed_finalize_interval')}")
        print(f"delayed_finalize_attempts: {delayed_finalize.get('delayed_finalize_attempts')}")
        print(f"delayed_finalize_observed_terminal: {str(bool(delayed_finalize.get('delayed_finalize_observed_terminal'))).lower()}")
        print(f"delayed_finalize_terminal_state: {delayed_finalize.get('delayed_finalize_terminal_state') or '-'}")
        print(f"final_protocol_terminal_state: {summary.get('final_protocol_terminal_state') or '-'}")
        print(f"lock_archived_by_finalizer: {str(bool(summary.get('lock_archived_by_finalizer'))).lower()}")

    wait_timeout_state = intermediate_wait_timeout_state(wait_result, summary)
    if wait_timeout_state:
        print(f"intermediate_wait_timeout: {wait_timeout_state}")

    post_run_truth = task_truth(root, run, task)
    observed_state = str(post_run_truth.get("protocol_terminal_state") or "")
    if (
        observed_state in (VALID_TERMINAL_STATES | INVALID_TERMINAL_STATES)
        and (
            observed_state != str(summary.get("protocol_terminal_state") or "")
            or bool(post_run_truth.get("lock_is_terminal_stale"))
        )
    ):
        print("== post-run finalize-summary ==")
        summary = finalize_from_truth(task_truth(root, run, task))
        print(f"protocol_terminal_state: {summary.get('protocol_terminal_state')}")
        print(f"final_protocol_terminal_state: {summary.get('final_protocol_terminal_state') or '-'}")
        print(f"summary_reconciled: {str(bool(summary.get('summary_reconciled'))).lower()}")
        print(f"stale_summary_detected: {str(bool(summary.get('stale_summary_detected'))).lower()}")
        print(f"lock_archived_by_finalizer: {str(bool(summary.get('lock_archived_by_finalizer'))).lower()}")

    final_truth = task_truth(root, run, task)
    final_observed_state = str(final_truth.get("protocol_terminal_state") or "")
    if (
        final_observed_state in (VALID_TERMINAL_STATES | INVALID_TERMINAL_STATES)
        and final_observed_state != str(summary.get("protocol_terminal_state") or "")
    ):
        print("== final-result finalize-summary ==")
        summary = finalize_from_truth(final_truth)
        final_truth = task_truth(root, run, task)
        print(f"protocol_terminal_state: {summary.get('protocol_terminal_state')}")
        print(f"final_protocol_terminal_state: {summary.get('final_protocol_terminal_state') or '-'}")
        print(f"summary_reconciled: {str(bool(summary.get('summary_reconciled'))).lower()}")

    print("== final summary ==")
    print(f"run_id: {run}")
    print(f"task_id: {task}")
    print(f"task_dir: {rel(tdir, root)}")
    print(f"requested_worker_id: {requested_worker_id or '-'}")
    print(f"worker: {worker.get('worker_id')}")
    print(f"worker_role: {worker_role or '-'}")
    print(f"runtime_backend: {summary.get('runtime_backend') or RUNTIME_BACKEND}")
    print(f"pane: {worker.get('pane_id')}")
    print(f"port: {worker.get('port')}")
    print(f"worker_scoped_settle_used: true")
    print(f"run_one_exit_state: {summary.get('run_one_exit_state') or '-'}")
    print(f"wait_result: {summary.get('wait_result') or '-'}")
    print(f"protocol_terminal_state: {summary['protocol_terminal_state']}")
    print(f"final_protocol_terminal_state: {summary.get('final_protocol_terminal_state') or '-'}")
    print(f"pending_after_timeout: {str(bool(summary.get('pending_after_timeout'))).lower()}")
    print(f"needs_settle: {str(bool(summary.get('needs_settle'))).lower()}")
    if summary.get("lock_release_blocked_reason"):
        print(f"lock_release_blocked_reason: {summary.get('lock_release_blocked_reason')}")
    print(f"recommended_settle_command: {summary.get('recommended_settle_command') or '-'}")
    print(f"lock_state_after_run_one: {summary.get('lock_state_after_run_one') or '-'}")
    print(f"next_safe_action: {summary.get('next_safe_action') or '-'}")
    print(f"terminal_state: {summary['terminal_state']}")
    print(f"summary_reconciled: {str(bool(summary.get('summary_reconciled'))).lower()}")
    print(f"stale_summary_detected: {str(bool(summary.get('stale_summary_detected'))).lower()}")
    print(f"lock_archived_by_finalizer: {str(bool(summary.get('lock_archived_by_finalizer'))).lower()}")
    print(f"delayed_finalize_enabled: {str(bool(summary.get('delayed_finalize_enabled'))).lower()}")
    print(f"delayed_finalize_seconds: {summary.get('delayed_finalize_seconds', 0)}")
    print(f"delayed_finalize_interval: {summary.get('delayed_finalize_interval', 0)}")
    print(f"delayed_finalize_attempts: {summary.get('delayed_finalize_attempts', 0)}")
    print(f"delayed_finalize_observed_terminal: {str(bool(summary.get('delayed_finalize_observed_terminal'))).lower()}")
    print(f"delayed_finalize_terminal_state: {summary.get('delayed_finalize_terminal_state') or '-'}")
    post_readiness = summary.get("post_terminal_tui_readiness", {})
    if isinstance(post_readiness, dict) and post_readiness:
        print(f"post_terminal_tui_readiness: {post_readiness.get('readiness')}")
    if summary.get("post_terminal_warning"):
        print(f"post_terminal_warning: {summary.get('post_terminal_warning')}")
    print(f"runtime_snapshot_path: {summary.get('runtime_snapshot_path') or '-'}")
    print(f"runtime_snapshot_ok: {str(bool(summary.get('runtime_snapshot_ok'))).lower()}")
    print(f"runtime_snapshot_status: {summary.get('runtime_snapshot_status') or '-'}")
    print(f"runtime_snapshot_backend_type: {summary.get('runtime_snapshot_backend_type') or '-'}")
    print(f"runtime_observation_path: {summary.get('runtime_observation_path') or '-'}")
    print(f"runtime_observation_ok: {str(bool(summary.get('runtime_observation_ok'))).lower()}")
    print(f"runtime_observation_status: {summary.get('runtime_observation_status') or '-'}")
    print(f"runtime_observation_readiness: {summary.get('runtime_observation_readiness') or '-'}")
    print(f"runtime_observation_backend_type: {summary.get('runtime_observation_backend_type') or '-'}")
    print(f"runtime_observation_pane_id: {summary.get('runtime_observation_pane_id') or '-'}")
    print(f"report_path: {summary['report_path']}")
    print(f"summary_json: {summary['summary_json']}")
    print(f"summary_md: {summary['summary_md']}")
    receipt = final_truth.get("result_receipt")
    if isinstance(receipt, dict):
        print("== result receipt ==")
        visible_task_state.print_result_receipt(receipt)

    final_receipt = receipt if isinstance(receipt, dict) else {}
    report_contract_validation = read_json(
        tdir / "report_contract_validation.json"
    )
    report_contract_failed = bool(
        isinstance(report_contract_validation, dict)
        and report_contract_validation.get("configured")
        and report_contract_validation.get("semantic_status") == "failed"
    )
    final_accepted_completed = bool(
        str(final_truth.get("protocol_terminal_state") or "") == "completed"
        and final_receipt.get("protocol_complete") is True
        and final_receipt.get("acceptance_result") == "accepted"
        and final_receipt.get("lock_state") == "none"
        and not report_contract_failed
    )
    if (
        final_accepted_completed
        and collect_result.get("returncode") != 0
    ):
        print(
            "final_result_precedence: accepted completed task truth "
            "observed after incomplete wait/collect; historical wait and "
            "collect results are preserved above"
        )
    state = summary["protocol_terminal_state"]
    if (
        state == "completed"
        and (
            collect_result.get("returncode") == 0
            or final_accepted_completed
        )
    ):
        return 0
    if submit_code != 0 or doctor_report.get("errors"):
        return 2
    return 1


def command_run_one(args: argparse.Namespace) -> int:
    return _command_run_one_impl(args, submit_task)


def command_run_one_native(args: argparse.Namespace) -> int:
    backend = getattr(args, "backend", RUNTIME_BACKEND)
    if backend != "tmux-reference":
        raise DispatchError("run-one-native currently only supports --backend tmux-reference")
    return _command_run_one_impl(args, submit_task_native)


def current_request_advisory(
    payload: Any, *, session_id: str, run: str, task: str,
    worker_id: str, attempt_id: str, session_status: str,
) -> dict[str, Any]:
    unknown = {"state": "unknown", "reason": "request_attribution_insufficient"}
    if not isinstance(payload, list) or not payload:
        return unknown
    infos = []
    for message in payload:
        if not isinstance(message, dict) or not isinstance(message.get("info"), dict):
            return unknown
        info = message["info"]
        if (
            info.get("sessionID") != session_id
            or not isinstance(info.get("id"), str) or not info["id"]
            or info.get("role") not in {"user", "assistant"}
        ):
            return unknown
        infos.append(info)
    times = [_message_created_ms(message) for message in payload]
    if any(t <= 0 for t in times) or times != sorted(times):
        return unknown
    user_index = max((i for i, info in enumerate(infos) if info["role"] == "user"), default=-1)
    if user_index < 0:
        return unknown
    header = _task_message_header(_message_text(payload[user_index]))
    expected = {"OMX_RUN_ID": run, "OMX_TASK_ID": task,
                "OMX_WORKER_ID": worker_id, "OMX_ATTEMPT_ID": attempt_id}
    if any(header.get(key) != value for key, value in expected.items()):
        return unknown
    request_id = infos[user_index]["id"]
    assistants = infos[user_index + 1:]
    if not assistants or any(info.get("parentID") != request_id for info in assistants):
        return unknown
    latest = assistants[-1]
    result = {"state": "unknown", "request_id": request_id, "message_id": latest["id"]}
    if session_status in {"busy", "retry"}:
        return {**result, "state": session_status}
    if session_status not in {"idle", "absent"}:
        return unknown
    error = latest.get("error")
    explicit_error = False
    error_name = ""
    if isinstance(error, dict):
        data = error.get("data") if isinstance(error.get("data"), dict) else {}
        name = error.get("name", "")
        message = data.get("message", error.get("message", ""))
        if not isinstance(name, str) or not isinstance(message, str):
            return unknown
        explicit_error = bool(name.strip() or message.strip())
        if re.fullmatch(r"[A-Za-z0-9_.-]{1,80}", name):
            error_name = name
    elif isinstance(error, str):
        explicit_error = bool(error.strip())
    elif error is not None:
        return unknown
    completed = latest.get("time", {}).get("completed")
    if explicit_error or (latest.get("finish") == "error" and type(completed) is int and completed > 0):
        return {**result, "state": "request_error_observed", "error_name": error_name}
    if latest.get("finish") in {"stop", "end_turn"} and type(completed) is int and completed > 0:
        return {**result, "state": "request_completed"}
    return {**result, "state": "no_active_request_evidence"}


def observe_current_request(root: Path, tdir: Path, worker_id: str, attempt_id: str) -> dict[str, Any]:
    unknown = {"state": "unknown", "reason": "query_or_identity_insufficient"}
    try:
        fence = read_json(tdir / "acceptance_fence.json")
        worker = worker_record(root, worker_id)
        if (
            not _recovery_fence_identity_current(fence, tdir=tdir, worker=worker, worker_id=worker_id)
            or _current_fence_attempt_contract(tdir, fence) != (attempt_id, fence.get("contract_hash"))
            or not read_checkpoint_access(root, tdir).get("ok")
        ):
            return unknown
        session_id = fence["session_id"]
        base_url = str(worker.get("base_url") or f"http://127.0.0.1:{int(worker['port'])}")
        adapter = load_adapter_module(root)
        host, port = adapter.verified_visible_transport_endpoint(worker, worker)
        endpoint = urlparse(base_url)
        if endpoint.scheme != "http" or endpoint.hostname not in {host, "localhost"} or endpoint.port != port:
            return unknown
        response = adapter.safe_http_request(
            host, port, "/session/status", "GET", timeout=2.0,
            limit=2_000_000, include_body_text=True,
        )
        if not response.get("ok") or response.get("truncated") or response.get("timed_out"):
            return unknown
        status_map = json.loads(response.get("body_text", ""))
        if not isinstance(status_map, dict):
            return unknown
        entry = status_map.get(session_id)
        if session_id not in status_map:
            status = "absent"
        elif isinstance(entry, dict) and entry.get("type") in {"busy", "retry", "idle"}:
            status = entry["type"]
        else:
            return unknown
        fetched = fetch_opencode_session_message(base_url, session_id)
        if not isinstance(fetched, dict) or fetched.get("ok") is False or "payload" not in fetched:
            return unknown
        current_worker = worker_record(root, worker_id)
        if (
            read_json(tdir / "acceptance_fence.json") != fence
            or not _recovery_fence_identity_current(fence, tdir=tdir, worker=current_worker, worker_id=worker_id)
            or _current_fence_attempt_contract(tdir, fence) != (attempt_id, fence.get("contract_hash"))
            or not read_checkpoint_access(root, tdir).get("ok")
        ):
            return unknown
        return current_request_advisory(
            fetched["payload"], session_id=session_id, run=tdir.parents[1].name,
            task=tdir.name, worker_id=worker_id, attempt_id=attempt_id, session_status=status,
        )
    except Exception:
        return unknown


def observation_payload(
    *,
    run: str,
    task: str,
    label: str,
    reason: str,
    truth: dict[str, Any],
    identity: dict[str, Any],
    identity_guard: dict[str, Any],
    expected_attempt_id: str,
    polls: int,
    since_seq: int,
    cursor: int,
    records: list[dict[str, Any]],
    observed_ordinary: set[int],
    checkpoint: dict[str, Any] | None,
    checkpoint_reason: str,
    store: dict[str, Any],
    foreign_or_stale: int,
    pending_after_return: int,
    critical_beyond_return: list[int],
    compact: bool = False,
    ordinary_checkpoint_count: int = 0,
    ordinary_summary: str = "",
    request_advisory: dict[str, Any] | None = None,
) -> dict[str, Any]:
    notable_payload: dict[str, Any] | None = checkpoint
    if compact and checkpoint is not None:
        notable_payload = {
            "seq": checkpoint.get("seq"),
            "reason": checkpoint_reason,
        }
    payload = {
        "schema_version": 1,
        "run": run,
        "task": task,
        "observe": True,
        "wait_result": label,
        "reason": reason,
        "protocol_terminal_state": truth.get("protocol_terminal_state") or "",
        "owner": truth.get("owner") or "",
        "lock_state": truth.get("lock_state") or "none",
        "attempt_id": str(identity.get("attempt_id") or ""),
        "expected_attempt_id": expected_attempt_id,
        "identity_source": str(identity.get("source") or ""),
        "identity_conflict": bool(identity.get("conflict")),
        "identity_guard_ok": bool(identity_guard.get("ok")),
        "identity_guard_mode": str(identity_guard.get("mode") or ""),
        "identity_guard_status": str(identity_guard.get("status") or ""),
        "observation_polls": polls,
        "since_seq": since_seq,
        "cursor": cursor,
        "records": records,
        "observed_ordinary_checkpoints": len(observed_ordinary),
        "notable_checkpoint": notable_payload,
        "notable_reason": checkpoint_reason,
        "foreign_or_stale_records": foreign_or_stale,
        "checkpoint_invalid_records": store.get("invalid_count", 0),
        "unsafe_evidence_records": store.get("unsafe_evidence_count", 0),
        "checkpoint_incomplete_tail": bool(store.get("incomplete_tail")),
        "checkpoint_out_of_order": bool(store.get("out_of_order")),
        "checkpoint_oversize_store": bool(store.get("oversize_store")),
        "store_latest_seq": store_latest_seq(store),
        "pending_after_return": pending_after_return,
        "critical_beyond_return": critical_beyond_return,
    }
    if compact:
        payload.update(
            compact=True,
            ordinary_checkpoint_count=ordinary_checkpoint_count,
            ordinary_summary=ordinary_summary,
            request_advisory=request_advisory or {"state": "unknown", "reason": "not_queried"},
        )
    return payload


def command_wait_continued(args: argparse.Namespace, *, admission_root: Path | None = None) -> int:
    """Foreground compact caller; each existing wait owns only its own admission."""
    initial_cursor = max(0, args.since_seq)
    confirmed = (initial_cursor, 0, 0, "")
    owner = ""
    calls = 0
    output = io.StringIO()
    error_stop = "segment_error"

    def metadata(stop: str, snapshot: tuple[int, int, int, str]) -> dict[str, Any]:
        cursor, polls, ordinary, summary = snapshot
        return {
            "stop": stop, "segment_calls": calls, "observation_polls": polls,
            "total_timeout": args.total_timeout, "segment_timeout": args.timeout,
            "last_confirmed_cursor": cursor,
            "ordinary_checkpoint_count": ordinary, "ordinary_summary": summary,
        }

    try:
        if not args.observe or not args.compact or not args.attempt_id.strip():
            raise DispatchError("--total-timeout requires --observe --compact --attempt-id")
        if args.total_timeout <= 0 or args.timeout <= 0:
            raise DispatchError("--total-timeout and segment --timeout must be positive")
        segment = argparse.Namespace(**vars(args))
        segment.root = str(root_path(args.root))
        deadline = time.monotonic() + args.total_timeout
        while True:
            # Never round the final fractional remainder up or start after expiry.
            remaining = deadline - time.monotonic()
            if remaining <= 0 and calls:
                payload["continuation"] = metadata("total_budget", confirmed)
                print("observation_json: " + json.dumps(payload, sort_keys=True, ensure_ascii=False))
                print("wait_result: observation_deadline")
                return 0
            segment.since_seq = confirmed[0]
            output = io.StringIO()
            payload: dict[str, Any] = {}

            def wait_segment(current: argparse.Namespace) -> int:
                current.timeout = min(args.timeout, max(0.0, deadline - time.monotonic()))
                return command_wait(current, observation_result=payload)

            calls += 1
            with redirect_stdout(output):
                rc = invoke_cli_handler(
                    "omx_visible_dispatch", segment, wait_segment,
                    admission_root=admission_root,
                )
            text = output.getvalue()
            if not (
                payload
                and all(type(payload.get(key)) is int and payload[key] >= 0
                        for key in ("cursor", "since_seq", "observation_polls", "ordinary_checkpoint_count"))
                and isinstance(payload.get("ordinary_summary"), str)
                and payload["since_seq"] == segment.since_seq
                and payload["cursor"] >= segment.since_seq
            ):
                error_stop = "invalid_result"
                raise DispatchError("invalid or missing compact observation result; no continuation")
            stop = "event"
            same_identity = (
                payload.get("run") == args.run and payload.get("task") == args.task
                and payload.get("attempt_id") == args.attempt_id.strip()
                and payload.get("expected_attempt_id") == args.attempt_id.strip()
                and payload["identity_conflict"] is False
                and payload["identity_guard_ok"] is True
                and bool(payload["owner"])
                and (not owner or payload["owner"] == owner)
            )
            if not same_identity:
                stop = "identity_anomaly"
            elif any(payload[key] for key in (
                "foreign_or_stale_records", "checkpoint_invalid_records", "unsafe_evidence_records",
                "checkpoint_incomplete_tail", "checkpoint_out_of_order", "checkpoint_oversize_store",
            )):
                stop = "observation_anomaly"
            elif (
                rc == 0 and payload["wait_result"] == payload["reason"] == "observation_deadline"
                and payload.get("protocol_terminal_state") in {"running", "received"}
                and payload.get("lock_state") == "active_lock"
                and not payload["records"] and not payload["critical_beyond_return"]
                and not payload["pending_after_return"]
                and payload.get("notable_checkpoint") is None
                and payload.get("notable_reason") == ""
            ):
                stop = "total_budget" if time.monotonic() >= deadline else "continue"
            next_confirmed = confirmed
            if same_identity:
                owner = payload["owner"]
                cursor, polls, ordinary, summary = confirmed
                polls += payload["observation_polls"]
                ordinary += payload["ordinary_checkpoint_count"]
                if payload["ordinary_checkpoint_count"]:
                    summary = payload["ordinary_summary"]
                payload.update(since_seq=initial_cursor, observation_polls=polls,
                               ordinary_checkpoint_count=ordinary,
                               observed_ordinary_checkpoints=ordinary, ordinary_summary=summary)
                next_confirmed = (payload["cursor"], polls, ordinary, summary)
            if stop == "continue":
                # Publish the entire confirmed boundary in one assignment.
                confirmed = next_confirmed
                continue
            payload["continuation"] = metadata(stop, next_confirmed)
            print(text, end="")
            print("observation_json: " + json.dumps(payload, sort_keys=True, ensure_ascii=False))
            confirmed = next_confirmed
            return 1 if stop in {"identity_anomaly", "observation_anomaly"} else rc
    except KeyboardInterrupt:
        # Unconfirmed aggregation or output may be re-read; authority is unchanged.
        print("observation_continuation_json: " + json.dumps(metadata("observer_cancelled", confirmed), sort_keys=True))
        raise
    except (DispatchError, AdmissionError):
        print(output.getvalue(), end="")
        print("observation_continuation_json: " + json.dumps(metadata(error_stop, confirmed), sort_keys=True))
        raise


def command_wait(args: argparse.Namespace, *, observation_result: dict[str, Any] | None = None) -> int:
    root = root_path(args.root)
    backend, backend_type = recorded_runtime_backend(
        root,
        args.run,
        args.task,
        fallback_backend=getattr(args, "backend", RUNTIME_BACKEND),
    )
    print(f"runtime_backend: {backend}")
    print(f"runtime_backend_type: {backend_type}")
    observe = bool(getattr(args, "observe", False))
    compact = bool(getattr(args, "compact", False))
    if compact and not observe:
        raise DispatchError("--compact requires --observe")
    since_seq = max(0, int(getattr(args, "since_seq", 0) or 0)) if observe else 0
    expected_attempt = str(getattr(args, "attempt_id", "") or "").strip()
    if observe and not expected_attempt:
        raise DispatchError(
            "wait --observe requires --attempt-id: observation stays bound to "
            "one explicit caller attempt and never adopts the current attempt"
        )
    notify_names = list(getattr(args, "notify_key_checkpoint", None) or [])
    tdir = task_dir(root, args.run, args.task)
    cursor = since_seq
    returned_records: list[dict[str, Any]] = []
    compact_returned_records: list[dict[str, Any]] = []
    compact_ordinary_count = 0
    compact_ordinary_summary = ""
    observed_ordinary_seqs: set[int] = set()
    notable_record: dict[str, Any] | None = None
    notable_reason = ""
    polls = 0
    observation_store: dict[str, Any] = {
        "records": [],
        "invalid_count": 0,
        "unsafe_evidence_count": 0,
        "incomplete_tail": False,
        "out_of_order": False,
    }
    observation_identity: dict[str, Any] = {}
    observation_guard: dict[str, Any] = {"ok": False, "mode": "", "status": ""}
    foreign_or_stale = 0
    critical_beyond_return: list[int] = []
    pending_after_return = 0
    initial_owner = ""
    observe_reason = ""
    wait_clock = time.monotonic if observation_result is not None else time.time
    wait_budget = max(0.0, float(args.timeout)) if observation_result is not None else max(0, int(args.timeout))
    deadline = wait_clock() + wait_budget
    last = ""
    final_truth: dict[str, Any] = {}
    provider_error: dict[str, Any] = {}
    readiness: dict[str, Any] = {}
    timed_out = False
    request_advisory: dict[str, Any] = {}

    def _snapshot_observation() -> dict[str, Any]:
        """Read one bounded observation snapshot: store, identity, page, metadata.

        Plain observation returns the earliest page. Compact observation
        consumes ordinary records and delivers at most one page of notable
        records, stopping before the first undelivered notable record.
        """
        store = read_progress_checkpoints(tdir)
        access = read_checkpoint_access(root, tdir)
        identity = access["identity"]
        if access.get("ok"):
            current_records, foreign = identity_valid_records(store, identity)
        else:
            current_records, foreign = [], len(store.get("records") or [])
        pending = [
            record
            for record in current_records
            if int(record.get("seq", 0)) > cursor
        ]
        if compact:
            page = []
            ordinary = []
            next_cursor = cursor
            for record in pending:
                notable, _reason = classify_notable(
                    record, notify_names=notify_names
                )
                if notable:
                    if len(page) >= CHECKPOINT_QUERY_RETURN_LIMIT:
                        break
                    page.append(record)
                    next_cursor = int(record.get("seq", 0))
                    continue
                ordinary.append(record)
                next_cursor = int(record.get("seq", 0))
            ordinary_count = len(ordinary)
            ordinary_summary = (
                str(ordinary[-1].get("summary") or "") if ordinary else ""
            )
            ordinary_seqs = {
                int(record.get("seq", 0)) for record in ordinary
            }
        else:
            page = pending[:CHECKPOINT_QUERY_RETURN_LIMIT]
            next_cursor = int(page[-1].get("seq", 0)) if page else cursor
            ordinary_count = 0
            ordinary_summary = ""
            ordinary_seqs = set()
        pending_after = [
            record
            for record in current_records
            if int(record.get("seq", 0)) > next_cursor
        ]
        return {
            "store": store,
            "page": page,
            "identity": identity,
            "access": access,
            "foreign": foreign,
            "next_cursor": next_cursor,
            "ordinary_count": ordinary_count,
            "ordinary_summary": ordinary_summary,
            "ordinary_seqs": ordinary_seqs,
            "pending_after": len(pending_after),
            "critical_beyond": [
                int(record.get("seq", 0))
                for record in pending_after
                if classify_notable(record, notify_names=notify_names)[0]
            ],
        }

    with readonly_wait_window():
        while True:
            truth = task_truth(root, args.run, args.task)
            final_truth = truth
            summary = (
                f"{truth['protocol_terminal_state']} "
                f"markers={','.join(truth['flow_markers'] + truth['terminal_markers']) or '-'} "
                f"report_bytes={truth['report_bytes']}"
            )
            if summary != last:
                print(f"{utc_now()} {summary}")
                last = summary
            status = str(truth.get("protocol_terminal_state") or "prepared")
            terminal = status in (
                VALID_TERMINAL_STATES
                | INVALID_TERMINAL_STATES
                | {
                    "blocked_context_overflow",
                    "blocked_provider_error",
                    "verbal_terminal_without_protocol_signal",
                }
            )
            if observe:
                polls += 1
                snapshot = _snapshot_observation()
                observation_store = snapshot["store"]
                observation_identity = snapshot["identity"]
                observation_guard = snapshot["access"]
                foreign_or_stale = snapshot["foreign"]
                critical_beyond_return = snapshot["critical_beyond"]
                pending_after_return = snapshot["pending_after"]
                page = snapshot["page"]
                if compact and observation_guard.get("ok"):
                    cursor = int(snapshot["next_cursor"])
                    compact_ordinary_count += int(snapshot["ordinary_count"])
                    if snapshot["ordinary_summary"]:
                        compact_ordinary_summary = str(snapshot["ordinary_summary"])
                    observed_ordinary_seqs.update(snapshot["ordinary_seqs"])
                    compact_returned_records.extend(page)
                identity_conflict = bool(observation_identity.get("conflict"))
                identity_unknown = not observation_identity.get("known")
                attempt_mismatch = bool(
                    observation_identity.get("known")
                    and not identity_conflict
                    and str(observation_identity.get("attempt_id") or "")
                    != expected_attempt
                )
                guard_failed = bool(
                    observation_identity.get("known")
                    and not identity_conflict
                    and not attempt_mismatch
                    and not observation_guard.get("ok")
                )
                returned_records = compact_returned_records if compact else page
                if not compact:
                    observed_ordinary_seqs.update(
                        int(item.get("seq", 0)) for item in page
                    )
                notable_record = None
                notable_reason = ""
                for record in page:
                    notable, reason = classify_notable(record, notify_names=notify_names)
                    if notable:
                        notable_record = record
                        notable_reason = reason
                        break
                current_owner = str(truth.get("owner") or "")
                if current_owner and not initial_owner:
                    initial_owner = current_owner
                if (
                    initial_owner
                    and current_owner
                    and current_owner != initial_owner
                    and not terminal
                ):
                    observe_reason = "ownership_anomaly"
                elif identity_conflict:
                    observe_reason = "identity_conflict"
                elif identity_unknown:
                    observe_reason = "identity_unknown"
                elif attempt_mismatch:
                    observe_reason = "attempt_mismatch"
                elif guard_failed:
                    observe_reason = "identity_guard_failed"
                elif compact and critical_beyond_return and not terminal:
                    observe_reason = "critical_beyond_page"
                elif notable_record is not None and not terminal:
                    observe_reason = "notable_checkpoint"
                elif not compact and critical_beyond_return and not terminal:
                    observe_reason = "critical_beyond_page"
                if observe_reason in {
                    "identity_conflict",
                    "identity_unknown",
                    "attempt_mismatch",
                    "identity_guard_failed",
                } or (compact and observe_reason == "ownership_anomaly"):
                    returned_records = []
                    notable_record = None
                    notable_reason = ""
                    pending_after_return = 0
                    critical_beyond_return = []
                    if compact:
                        cursor = since_seq
                        compact_returned_records.clear()
                        compact_ordinary_count = 0
                        compact_ordinary_summary = ""
                        observed_ordinary_seqs.clear()
                if observe_reason:
                    break
                if compact and not terminal:
                    request_advisory = observe_current_request(root, tdir, current_owner, expected_attempt)
                    latest_truth = task_truth(root, args.run, args.task)
                    latest_access = read_checkpoint_access(root, tdir)
                    if (
                        any(latest_truth.get(key) != truth.get(key) for key in
                            ("protocol_terminal_state", "owner", "lock_state"))
                        or not latest_access.get("ok")
                        or latest_access.get("identity") != observation_identity
                    ):
                        request_advisory = {}
                        continue
                    if request_advisory.get("state") == "request_error_observed":
                        observe_reason = "current_request_error"
                        break
            if terminal:
                break
            now = wait_clock()
            if now >= deadline:
                if observe:
                    observe_reason = "observation_deadline"
                    if returned_records:
                        cursor = int(returned_records[-1].get("seq", 0))
                    break
                timed_out = True
                break
            time.sleep(min(3.0, max(0.0, deadline - now)))
    if observe and observe_reason in {
        "notable_checkpoint",
        "critical_beyond_page",
        "ownership_anomaly",
        "identity_conflict",
        "identity_unknown",
        "attempt_mismatch",
        "identity_guard_failed",
        "observation_deadline",
        "current_request_error",
    }:
        label = "progress_change"
        if observe_reason in {
            "identity_conflict",
            "identity_unknown",
            "attempt_mismatch",
            "identity_guard_failed",
        }:
            label = observe_reason
        if observe_reason == "observation_deadline":
            label = "observation_deadline"
        if returned_records:
            cursor = max(cursor, int(returned_records[-1].get("seq", 0)))
        payload = observation_payload(
            run=args.run,
            task=args.task,
            label=label,
            reason=observe_reason,
            truth=final_truth,
            identity=observation_identity,
            identity_guard=observation_guard,
            expected_attempt_id=expected_attempt,
            polls=polls,
            since_seq=since_seq,
            cursor=cursor,
            records=returned_records,
            observed_ordinary=observed_ordinary_seqs,
            checkpoint=notable_record,
            checkpoint_reason=notable_reason,
            store=observation_store,
            foreign_or_stale=foreign_or_stale,
            pending_after_return=pending_after_return,
            critical_beyond_return=critical_beyond_return,
            compact=compact,
            ordinary_checkpoint_count=compact_ordinary_count,
            ordinary_summary=compact_ordinary_summary,
            request_advisory=request_advisory,
        )
        if observation_result is not None:
            observation_result.update(payload)
        else:
            print("observation_json: " + json.dumps(payload, sort_keys=True, ensure_ascii=False))
        print(f"wait_result: {label}")
        return 0 if (
            observe_reason in {"observation_deadline", "notable_checkpoint", "critical_beyond_page", "current_request_error"}
            and final_truth.get("protocol_terminal_state") in {"running", "received"}
            and observation_guard.get("ok")
            and not foreign_or_stale
            and not any(observation_store.get(key) for key in (
                "invalid_count", "unsafe_evidence_count", "incomplete_tail",
                "out_of_order", "oversize_store",
            ))
        ) else 1

    status = str(final_truth.get("protocol_terminal_state") or "prepared")
    owner = str(final_truth.get("owner") or "")
    runtime_observation: dict[str, Any] = {}
    if status in VALID_TERMINAL_STATES and owner and not compact:
        readiness = record_post_terminal_readiness(root, args.run, args.task, owner, append_busy_event=True)
        if readiness:
            print(f"post_terminal_tui_readiness: {readiness.get('readiness')}")
            if readiness.get("reason"):
                print(f"post_terminal_tui_reason: {readiness.get('reason')}")
            if readiness.get("readiness") == "busy":
                print("warning: post_terminal_tui_busy")
        runtime_observation = record_runtime_observation(root, args.run, args.task, owner, backend)
        if runtime_observation:
            print(f"runtime_observation_ok: {str(bool(runtime_observation.get('ok'))).lower()}")
            print(f"runtime_observation_status: {runtime_observation.get('status') or '-'}")
            print(f"runtime_observation_readiness: {runtime_observation.get('readiness') or '-'}")
            print(f"runtime_observation_backend_type: {runtime_observation.get('backend_type') or '-'}")
            print(f"runtime_observation_pane_id: {runtime_observation.get('pane_id') or '-'}")
    elif timed_out and owner:
        readiness = tui_readiness(root, owner)
        observations = record_session_observations(
            root,
            args.run,
            args.task,
            owner,
            readiness=readiness,
        )
        provider_error = observations["provider"]
        rechecked_truth = task_truth(root, args.run, args.task)
        rechecked_status = str(
            rechecked_truth.get("protocol_terminal_state") or ""
        )
        final_truth = rechecked_truth
        if rechecked_status in (
            VALID_TERMINAL_STATES
            | INVALID_TERMINAL_STATES
        ):
            status = rechecked_status
    if provider_error.get("detected"):
        print(f"provider_error: {provider_error.get('kind')}")
        print(f"provider_error_retryable: {str(bool(provider_error.get('retryable'))).lower()}")
        if provider_error.get("request_id"):
            print(f"provider_error_request_id: {provider_error.get('request_id')}")
        print(
            "provider_error_observation: "
            f"{rel(task_dir(root, args.run, args.task) / 'provider_error_observation.json', root)}"
        )
    if observe:
        terminal_reason = (
            "terminal_with_unread_checkpoints" if returned_records else "terminal"
        )
        if returned_records:
            cursor = max(cursor, int(returned_records[-1].get("seq", 0)))
        payload = observation_payload(
            run=args.run,
            task=args.task,
            label="terminal",
            reason=terminal_reason,
            truth=final_truth,
            identity=observation_identity,
            identity_guard=observation_guard,
            expected_attempt_id=expected_attempt,
            polls=polls,
            since_seq=since_seq,
            cursor=cursor,
            records=returned_records,
            observed_ordinary=observed_ordinary_seqs,
            checkpoint=notable_record,
            checkpoint_reason=notable_reason,
            store=observation_store,
            foreign_or_stale=foreign_or_stale,
            pending_after_return=pending_after_return,
            critical_beyond_return=critical_beyond_return,
            compact=compact,
            ordinary_checkpoint_count=compact_ordinary_count,
            ordinary_summary=compact_ordinary_summary,
        )
        if observation_result is not None:
            observation_result.update(payload)
        else:
            print("observation_json: " + json.dumps(payload, sort_keys=True, ensure_ascii=False))
    if status == "completed":
        print("wait_result: completed")
        return 0
    if status == "failed":
        print("wait_result: failed")
        return 1
    if status == "blocked":
        print("wait_result: blocked")
        return 1
    if status in INVALID_TERMINAL_STATES:
        print(f"wait_result: {status}")
        return 1
    if status == "blocked_context_overflow":
        print("wait_result: blocked_context_overflow")
        return 1
    if status == "blocked_provider_error":
        print("wait_result: blocked_provider_error")
        return 1
    if status == "verbal_terminal_without_protocol_signal":
        print("wait_result: verbal_terminal_without_protocol_signal")
        return 1
    if status == "delivery_uncertain_provider_error":
        print("wait_result: delivery_uncertain_provider_error")
        return 1
    if not final_truth.get("has_received"):
        print("wait_result: delivery_uncertain")
        return 1
    print("wait_result: running_or_incomplete")
    return 1


SUPPLEMENT_TEXT_BYTE_LIMIT = 8192
SUPPLEMENT_SELECTION_FIELDS = ("agent", "model", "variant")
SUPPLEMENT_SELECTION_FILE_FIELDS = frozenset(
    (*SUPPLEMENT_SELECTION_FIELDS, "selection_evidence")
)
SUPPLEMENT_ENFORCED_GATES = [
    "supplement_authorization",
    "target_worker_lock",
    "task_directory_write",
    "worker_transport",
]
SUPPLEMENT_ACKNOWLEDGEMENT_PREFIX = "supplement:"
SUPPLEMENT_ACK_SUMMARY_PLACEHOLDER = (
    "<adoption summary: what you adopted or refused, in your own words>"
)
SUPPLEMENT_ACK_COMMAND_NOTE = (
    "Run this only after actually reading this supplement and adopting or "
    "refusing it within the original scope; replace the --summary placeholder "
    "with your truthful one-line adoption summary first. Only a checkpoint "
    "with the exact --name supplement:<id> satisfies the required "
    "acknowledgement; a request-id or summary alone does not. Re-running the "
    "unchanged command is an idempotent duplicate."
)
INTERRUPT_ENFORCED_GATES = [
    "interrupt_authorization",
    "target_worker_lock",
    "task_directory_write",
    "worker_transport",
]
RESUME_ACKNOWLEDGEMENT_PREFIX = "resume:"


def supplement_ack_request_id(supplement_id: str) -> str:
    """Pre-derived checkpoint request id, within the CLI's 128-char cap.

    ``safe_id`` does not bound the supplement id's length, so an id longer
    than the checkpoint request-id budget keeps the readable derived form
    only when it fits and otherwise falls back to a deterministic sha256
    suffix of the exact id. The checkpoint name always carries the full id.
    """
    request_id = f"supplement-ack-{supplement_id}"
    if len(request_id) > 128:
        request_id = (
            "supplement-ack-"
            + hashlib.sha256(supplement_id.encode("utf-8")).hexdigest()[:32]
        )
    return request_id


def supplement_ack_checkpoint_command(
    root: Path,
    tdir: Path,
    worker_id: str,
    attempt_id: str,
    supplement_id: str,
) -> str:
    """Render the worker's exact supplement ACK command for this send.

    The command is guidance material bound to one invocation (root, task dir,
    worker, attempt, exact checkpoint name, pre-derived request id); the
    ``--summary`` placeholder stays for the worker's truthful adoption
    summary, and the checkpoint CLI revalidates identity on execution. The
    path is rendered without validation so a receipt can carry the command
    even when the signal binary is checked only at run time.
    """
    return shlex.join(
        [
            str(root / "bin" / "omx_task_signal"),
            "checkpoint",
            "--root",
            str(root),
            "--task-dir",
            str(tdir),
            "--worker",
            worker_id,
            "--attempt-id",
            attempt_id,
            "--name",
            f"{SUPPLEMENT_ACKNOWLEDGEMENT_PREFIX}{supplement_id}",
            "--request-id",
            supplement_ack_request_id(supplement_id),
            "--summary",
            SUPPLEMENT_ACK_SUMMARY_PLACEHOLDER,
        ]
    )


@contextmanager
def task_lifecycle_lock(tdir: Path):
    """Hold the task's lifecycle lock that ``omx_task_signal`` also uses.

    The supplement holds this lock across its final identity validation and
    the POST, so a legitimate ``finish`` (or reassignment) cannot land inside
    that window instead of relying on a check-then-send sequence.
    """
    path = tdir / ".task-lifecycle.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def _supplement_route_send_outcome(
    adapter,
    root: Path,
    args_run: str,
    args_task: str,
    worker_id: str,
    *,
    supplement_id: str,
    text: str,
    request_hash: str,
    record_path: Path,
    record: dict[str, Any],
    original_selection: dict[str, str],
    selection_evidence: str,
    runtime_backend: str,
) -> None:
    """Shared single-send outcome path for the two actual message routes.

    The adapter POSTs only as its final side effect, so an AdapterError is a
    pre-send refusal: nothing reached the backend. Any other exception may
    have happened after the POST, so the outcome is ambiguous and never
    resent. Both routes persist the resolved outcome on the same immutable
    reservation they created.
    """
    try:
        result = adapter.deliver_visible_supplement_runtime(
            root,
            args_run,
            args_task,
            worker_id,
            supplement_id=supplement_id,
            text=text,
            request_hash=request_hash,
            reservation_path=record_path,
            original_selection=original_selection,
            selection_evidence=selection_evidence,
            runtime_backend=runtime_backend,
        )
    except Exception as exc:
        adapter_error_type = getattr(adapter, "AdapterError", None)
        refused = bool(
            isinstance(adapter_error_type, type)
            and isinstance(exc, adapter_error_type)
        )
        record.update(
            {
                "status": "refused" if refused else "ambiguous",
                "resolved_at": utc_now(),
                "error": f"{type(exc).__name__}: {exc}",
                "response": {},
            }
        )
        write_json_atomic(record_path, record)
    else:
        record.update(
            {
                "status": (
                    "sent"
                    if result.get("delivery") == "sent"
                    else str(result.get("delivery") or "ambiguous")
                ),
                "delivered_at": utc_now(),
                "transport": str(result.get("transport") or ""),
                "endpoint": str(result.get("endpoint") or ""),
                "backend_accepted": bool(result.get("backend_accepted")),
                "selection_binding": result.get("selection_binding") or {},
                "response": result.get("response") or {},
                "consumption_at_delivery": "unknown",
            }
        )
        write_json_atomic(record_path, record)


def supplement_record_path(tdir: Path, supplement_id: str) -> Path:
    safe_id(supplement_id, "supplement-id")
    path = tdir / f"supplement-{supplement_id}.json"
    if not is_relative_to(path, tdir):
        raise DispatchError("supplement record escaped the task directory")
    return path


def supplement_request_hash(text: str) -> str:
    return "sha256:" + hashlib.sha256(text.encode("utf-8")).hexdigest()


def supplement_selection_inputs(path: Path) -> tuple[dict[str, Any], str]:
    """Read the host-bound original selection facts for this supplement grant."""
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DispatchError(f"supplement selection file is unreadable: {exc}") from exc
    if not isinstance(raw, dict) or set(raw) != SUPPLEMENT_SELECTION_FILE_FIELDS:
        raise DispatchError(
            "supplement selection file must carry exactly "
            f"{sorted(SUPPLEMENT_SELECTION_FILE_FIELDS)}"
        )
    evidence = str(raw.get("selection_evidence") or "").strip()
    if not evidence:
        raise DispatchError("supplement selection file needs a selection_evidence source")
    selection = {
        "agent": raw.get("agent"),
        "model": raw.get("model"),
        "variant": raw.get("variant"),
    }
    return selection, evidence


def _supplement_contract_hash(
    task_contract: dict[str, Any] | None,
    operation_contract: dict[str, Any],
    *,
    worker_id: str,
    task_id: str,
    attempt_id: str,
    supplement_id: str,
    request_hash: str,
    original_selection: dict[str, str],
    selection_evidence: str,
    bindings_key: str = "supplement",
) -> str:
    """Mirror operation_authorization._supplement_derived_contract_hash."""
    base = dict(task_contract) if task_contract else {}
    base.pop("operation_capability", None)
    return _canonical_json_hash(
        {
            "task_contract": base,
            "operation_contract": operation_contract,
            "worker_id": worker_id,
            "task_id": task_id,
            "attempt_id": attempt_id,
            bindings_key: {
                (
                    "resume_id" if bindings_key == "resume" else "supplement_id"
                ): supplement_id,
                "request_hash": request_hash,
                "original_selection": dict(original_selection),
                "selection_evidence": selection_evidence,
            },
        }
    )


def supplement_delivery_state(record: dict[str, Any]) -> str:
    """Collapse one supplement record into its caller-visible delivery state.

    A durable reservation without a recorded outcome means an interrupted send
    attempt: the request may or may not have reached the backend, so it is
    reported ambiguous and never resent. A recorded pre-send refusal is known
    not to have reached the backend and is reported as refused.
    """
    status = str(record.get("status") or "")
    if status == "sent":
        return "sent"
    if status == "backend_rejected":
        return "backend_rejected"
    if status == "refused":
        return "refused"
    return "ambiguous"


def supplement_consumption_evidence(
    root: Path,
    tdir: Path,
    record: dict[str, Any],
    acknowledgement_prefix: str = SUPPLEMENT_ACKNOWLEDGEMENT_PREFIX,
) -> dict[str, Any]:
    """Report worker-acknowledged consumption from existing checkpoint evidence.

    The acknowledgement anchor is the exact checkpoint ``name`` field
    ``supplement:<supplement-id>``. Serialized-substring scans are not used, so
    ``sup-1`` can never be satisfied by an unrelated mention of ``sup-12``.
    This is worker-reported acknowledgement only: it is not proof that the
    instruction changed subsequent behavior, which must be judged from later
    evidence on its own.
    """
    supplement_id = str(record.get("supplement_id") or "")
    cursor = int(record.get("checkpoint_cursor_at_reservation") or 0)
    anchor = f"{acknowledgement_prefix}{supplement_id}"
    base = {
        "anchor": f"checkpoint.name == {anchor!r}",
        "scope": "worker_reported_acknowledgement",
        "note": (
            "worker-reported acknowledgement only; actual behavior change is "
            "judged separately from later task evidence"
        ),
        "evidence_seqs": [],
    }
    access = read_checkpoint_access(root, tdir)
    if not access.get("ok"):
        return {
            **base,
            "status": "unknown",
            "note": (
                base["note"]
                + f"; no verifiable current-identity checkpoint read (guard={access.get('status') or '-'})"
            ),
        }
    store = read_progress_checkpoints(tdir)
    records, _foreign = identity_valid_records(store, access["identity"])
    seqs = [
        int(item["seq"])
        for item in records
        if int(item.get("seq", 0)) > cursor
        and str(item.get("name") or "").strip() == anchor
    ]
    if seqs:
        return {**base, "status": "worker_reported", "evidence_seqs": seqs}
    return {**base, "status": "unknown"}


def supplement_payload(
    root: Path,
    run: str,
    task: str,
    tdir: Path,
    record: dict[str, Any],
    *,
    duplicate: bool,
    delivery: str,
    consumption: dict[str, Any],
    terminal_state: str,
) -> dict[str, Any]:
    supplement_id = str(record.get("supplement_id") or "")
    return {
        "schema_version": 1,
        "run": run,
        "task": task,
        "task_dir": rel(tdir, root),
        "supplement_id": supplement_id,
        "record": rel(supplement_record_path(tdir, supplement_id), root),
        "duplicate": duplicate,
        "attempt_id": str(record.get("attempt_id") or ""),
        "worker_id": str(record.get("worker_id") or ""),
        "session_id": str(record.get("session_id") or ""),
        "request_hash": str(record.get("request_hash") or ""),
        "text_bytes": int(record.get("text_bytes") or 0),
        "reserved_at": str(record.get("reserved_at") or ""),
        "delivered_at": str(record.get("delivered_at") or ""),
        "record_status": str(record.get("status") or ""),
        "error": str(record.get("error") or ""),
        "delivery": delivery,
        "delivery_note": (
            "Backend response is request acceptance only; authorization "
            "idempotence is not backend exactly-once and delivery is not "
            "consumption or completion"
        ),
        "response": record.get("response") or {},
        "transport": str(record.get("transport") or ""),
        "endpoint": str(record.get("endpoint") or ""),
        "turn_id": str(record.get("turn_id") or (record.get("response") or {}).get("turn_id") or ""),
        "authorization_id": str(record.get("authorization_id") or ""),
        "original_selection": record.get("original_selection") or {},
        "selection_evidence": str(record.get("selection_evidence") or ""),
        "ack_command": supplement_ack_checkpoint_command(
            root,
            tdir,
            str(record.get("worker_id") or ""),
            str(record.get("attempt_id") or ""),
            supplement_id,
        ),
        "ack_command_note": SUPPLEMENT_ACK_COMMAND_NOTE,
        "consumption": consumption,
        "task_protocol_terminal_state": terminal_state,
    }


def supplement_replay_identity_errors(
    root: Path,
    run: str,
    task: str,
    tdir: Path,
    record: dict[str, Any],
    *,
    worker_id: str,
    attempt_id: str,
) -> list[str]:
    """Full caller identity check before returning a known supplement result.

    A wrong worker, task, attempt, session, or request must never receive the
    original caller's successful receipt. The check does not require a live
    owner lock once the task has reached a legitimate terminal, so reading a
    historical receipt after lock archival stays possible without a resend.
    """
    errors: list[str] = []
    fence = read_json(tdir / "acceptance_fence.json")
    if not fence:
        return ["acceptance fence is missing"]
    if str(fence.get("worker_id") or "") != worker_id:
        errors.append("acceptance fence worker does not match the caller")
    if str(fence.get("task_id") or "") != task:
        errors.append("acceptance fence task does not match the caller")
    fence_attempt = str(fence.get("attempt_id") or "")
    if not fence_attempt:
        errors.append("acceptance fence carries no attempt identity")
    elif fence_attempt != attempt_id:
        errors.append(
            f"caller attempt {attempt_id} does not match current attempt {fence_attempt}"
        )
    for field, expected in (
        ("run", run),
        ("task", task),
        ("worker_id", worker_id),
        ("attempt_id", attempt_id),
    ):
        if str(record.get(field) or "") != expected:
            errors.append(f"recorded {field} does not match the caller")
    recorded_session = str(record.get("session_id") or "")
    if not recorded_session or recorded_session != str(fence.get("session_id") or ""):
        errors.append("recorded session does not match the current acceptance fence")
    if record.get("backend") == "codex_tui":
        if str(record.get("fence_hash") or "") != _canonical_json_hash(fence):
            errors.append("recorded native supplement fence no longer matches")
    markers = [
        name for name in ("done", "fail", "blocked") if (tdir / f".{name}").is_file()
    ]
    truth = task_truth(root, run, task)
    state = str(truth.get("protocol_terminal_state") or "")
    if markers:
        if state not in VALID_TERMINAL_STATES:
            errors.append(
                f"task terminal evidence is inconsistent: {state or 'unknown'}"
            )
    else:
        access = read_checkpoint_access(root, tdir)
        if not access.get("ok"):
            errors.append(
                "current binding/owner-lock guard failed: "
                f"{access.get('status') or '-'}"
            )
    return errors


def supplement_pre_send_errors(
    root: Path,
    run: str,
    task: str,
    tdir: Path,
    *,
    worker_id: str,
    attempt_id: str,
    allow_default_tui: bool = False,
) -> tuple[list[str], dict[str, Any], str]:
    """Final identity/ownership validation for a real supplement send."""
    errors: list[str] = []
    owner = read_text(tdir / "owner").strip()
    if not owner:
        return ["task has no recorded owner"], {}, ""
    if owner != worker_id:
        errors.append(f"worker {worker_id} does not match task owner {owner}")
    if not (tdir / ".submitted").is_file() or not (tdir / ".started").is_file():
        errors.append("task is not started; supplement requires submitted and started evidence")
    markers = [
        name for name in ("done", "fail", "blocked") if (tdir / f".{name}").is_file()
    ]
    if markers:
        errors.append("task already has terminal marker(s): " + ",".join(markers))
    fence = read_json(tdir / "acceptance_fence.json")
    fence_attempt = str(fence.get("attempt_id") or "")
    if not fence_attempt:
        errors.append("acceptance fence carries no attempt identity")
    elif fence_attempt != attempt_id:
        errors.append(
            f"caller attempt {attempt_id} does not match current attempt {fence_attempt}"
        )
    if str(fence.get("worker_id") or "") != worker_id:
        errors.append("acceptance fence worker does not match the target")
    if str(fence.get("task_id") or "") != task:
        errors.append("acceptance fence task does not match the target")
    session_id = str(fence.get("session_id") or "")
    try:
        interrupt_worker = worker_record(root, worker_id)
    except DispatchError:
        interrupt_worker = {}
    interrupt_backend = str(
        interrupt_worker.get("backend") or "opencode_tui")
    if interrupt_backend == "codex_tui":
        session_ok = bool(
            session_id
            and session_id == str(interrupt_worker.get("codex_thread") or ""))
        session_error = (
            "acceptance fence session is not the bound codex thread")
    else:
        session_ok = session_id.startswith("ses_")
        session_error = "acceptance fence has no live observed session"
    if (
        not session_ok
        or str(fence.get("session_fence_state") or "") != "live_observed"
    ):
        errors.append(session_error)
    access = read_checkpoint_access(root, tdir)
    if not access.get("ok"):
        errors.append(
            "current binding/owner-lock guard failed: "
            f"{access.get('status') or '-'}"
        )
    task_contract = read_json(tdir / "task.json").get("task_contract")
    contract = task_contract if isinstance(task_contract, dict) else {}
    if interrupt_backend != "codex_tui" and not isinstance(contract.get("opencode_server_prompt_async_canary"), dict) and not (
        allow_default_tui and read_text(tdir / "backend").strip() == "opencode_tui"
    ):
        errors.append(
            "supplement_transport_unsupported: the task contract declares no "
            "sanctioned async server transport "
            "(opencode_server_prompt_async_canary); raw tmux and direct /tui "
            "submission are not fallbacks"
        )
    return errors, fence, session_id


def _supplement_known_result(
    root: Path,
    args: argparse.Namespace,
    tdir: Path,
    record: dict[str, Any],
    *,
    worker_id: str,
    supplement_id: str,
    request_hash: str,
) -> int:
    delivery = supplement_delivery_state(record)
    payload = supplement_payload(
        root,
        args.run,
        args.task,
        tdir,
        record,
        duplicate=True,
        delivery=delivery,
        consumption=supplement_consumption_evidence(root, tdir, record),
        terminal_state=str(
            (task_truth(root, args.run, args.task) or {}).get(
                "protocol_terminal_state"
            )
            or ""
        ),
    )
    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print(
            "supplement_json: "
            + json.dumps(payload, sort_keys=True, ensure_ascii=False)
        )
        print(
            f"supplement: id={supplement_id} duplicate=true delivery={delivery} "
            f"resend=false"
        )
    return 0 if delivery == "sent" else 1


def command_supplement(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    if not getattr(args, "allow_real", False):
        raise DispatchError("supplement requires --allow-real")
    worker_id = safe_id(str(getattr(args, "worker", "") or ""), "worker")
    supplement_id = safe_id(
        str(getattr(args, "supplement_id", "") or ""), "supplement-id"
    )
    expected_attempt = str(getattr(args, "attempt_id", "") or "").strip()
    if not expected_attempt:
        raise DispatchError(
            "supplement requires --attempt-id: delivery stays bound to one "
            "explicit caller attempt and never adopts the current attempt"
        )
    authorization_id = str(
        getattr(args, "supplement_authorization_id", "") or ""
    ).strip()
    text_file_value = str(getattr(args, "text_file", "") or "")
    if not text_file_value:
        raise DispatchError("supplement requires --text-file")
    text_path = Path(text_file_value)
    if not text_path.is_file():
        raise DispatchError(f"supplement text file not found: {text_path}")
    with text_path.open(encoding="utf-8", newline="") as handle:
        text = handle.read()
    if not text.strip():
        raise DispatchError("supplement text is empty")
    if len(text.encode("utf-8")) > SUPPLEMENT_TEXT_BYTE_LIMIT:
        raise DispatchError(
            f"supplement text exceeds {SUPPLEMENT_TEXT_BYTE_LIMIT} bytes"
        )
    selection_file_value = str(getattr(args, "selection_file", "") or "")
    if not selection_file_value:
        raise DispatchError(
            "supplement requires --selection-file: the original agent/model/"
            "variant binding must come from the host-prepared grant, not task prose"
        )
    selection_path = Path(selection_file_value)
    if not selection_path.is_file():
        raise DispatchError(f"supplement selection file not found: {selection_path}")
    request_hash = supplement_request_hash(text)
    selection, selection_evidence = supplement_selection_inputs(selection_path)
    try:
        bound = supplement_selection_payload(selection, selection_evidence)
    except OperationAuthorizationError as exc:
        raise DispatchError(str(exc)) from exc
    original_selection = bound["selection"]
    selection_evidence = bound["selection_evidence"]
    tdir = task_dir(root, args.run, args.task)
    if not tdir.is_dir():
        raise DispatchError(f"task directory missing: {rel(tdir, root)}")
    record_path = supplement_record_path(tdir, supplement_id)
    existing = read_json(record_path) if record_path.is_file() else {}
    if existing:
        if str(existing.get("request_hash") or "") != request_hash:
            raise DispatchError(
                f"supplement {supplement_id} already exists with different "
                "content; use a new supplement-id"
            )
        if ("original_selection" in existing and (
                existing.get("original_selection") != original_selection
                or existing.get("selection_evidence") != selection_evidence)):
            raise DispatchError("supplement replay refused: original selection identity changed")
        identity_errors = supplement_replay_identity_errors(
            root,
            args.run,
            args.task,
            tdir,
            existing,
            worker_id=worker_id,
            attempt_id=expected_attempt,
        )
        if identity_errors:
            raise DispatchError(
                "supplement replay refused: " + "; ".join(identity_errors)
            )
        return _supplement_known_result(
            root,
            args,
            tdir,
            existing,
            worker_id=worker_id,
            supplement_id=supplement_id,
            request_hash=request_hash,
        )
    task_contract = read_json(tdir / "task.json").get("task_contract")
    contract = task_contract if isinstance(task_contract, dict) else {}
    pre_errors, _fence, _session = supplement_pre_send_errors(
        root,
        args.run,
        args.task,
        tdir,
        worker_id=worker_id,
        attempt_id=expected_attempt,
        allow_default_tui=True,
    )
    if pre_errors:
        raise DispatchError("supplement refused: " + "; ".join(pre_errors))
    if bool(getattr(args, "authorize_leader", False)):
        if authorization_id:
            raise DispatchError(
                "--authorize-leader cannot be combined with "
                "--supplement-authorization-id; use one authorization mode"
            )
        event_id = str(getattr(args, "event_id", "") or "").strip()
        if not event_id:
            raise DispatchError("--authorize-leader requires --event-id")
        base_contract = {
            key: value
            for key, value in contract.items()
            if key != "operation_capability"
        }
        try:
            prepared = prepare_external_harness_supplement_grant(
                root=root,
                task_id=args.task,
                attempt_id=expected_attempt,
                worker_id=worker_id,
                supplement_id=supplement_id,
                request_hash=request_hash,
                original_selection=original_selection,
                selection_evidence=selection_evidence,
                base_task_contract=base_contract,
                event_id=event_id,
            )
        except OperationAuthorizationError as exc:
            raise DispatchError(f"supplement authorization refused: {exc}") from exc
        authorization_id = str(prepared["authorization_id"])
    elif not authorization_id:
        raise DispatchError(
            "supplement requires --supplement-authorization-id, or "
            "--authorize-leader with --event-id for the trusted leader path"
        )
    try:
        operation_contract = derive_operation_contract("worker_supplement", contract)
    except OperationAuthorizationError as exc:
        raise DispatchError(str(exc)) from exc
    expected_hash = _supplement_contract_hash(
        contract,
        operation_contract,
        worker_id=worker_id,
        task_id=args.task,
        attempt_id=expected_attempt,
        supplement_id=supplement_id,
        request_hash=request_hash,
        original_selection=original_selection,
        selection_evidence=selection_evidence,
    )
    ledger = _operation_authorization_ledger(root, args.task, expected_attempt)
    boundary = ledger.boundary_sequence()
    record: dict[str, Any] = {}
    try:
        with ledger.mutation_boundary(
            authorization_id,
            expected_boundary=boundary,
        ) as capability:
            validate_operation_capability(
                capability,
                operation_kind="worker_supplement",
                target_scope={"kind": "worker", "id": worker_id},
                required_mutation_gates=list(
                    operation_contract["required_mutation_gates"]
                ),
                task_id=args.task,
                attempt_id=expected_attempt,
            )
            validate_mutation_gate_union(
                list(operation_contract["required_mutation_gates"]),
                SUPPLEMENT_ENFORCED_GATES,
            )
            if str(capability.get("contract_hash") or "") != expected_hash:
                raise DispatchError(
                    "supplement grant contract hash does not match this exact "
                    "supplement request and original selection"
                )
            with task_lifecycle_lock(tdir):
                errors, fence, session_id = supplement_pre_send_errors(
                    root,
                    args.run,
                    args.task,
                    tdir,
                    worker_id=worker_id,
                    attempt_id=expected_attempt,
                    allow_default_tui=True,
                )
                if errors:
                    raise DispatchError(
                        "supplement refused: " + "; ".join(errors)
                    )
                supplement_worker_record = worker_record(root, worker_id)
                if str(supplement_worker_record.get("backend") or "") == "codex_tui":
                    adapter = load_codex_adapter_module(root)
                else:
                    adapter = load_adapter_module(root)
                try:
                    adapter.supplement_selection_guard(
                        original_selection=dict(original_selection),
                        selection_evidence=selection_evidence,
                    )
                except Exception as exc:
                    raise DispatchError(f"supplement refused: {exc}") from exc
                store = read_progress_checkpoints(tdir)
                record = {
                    "schema_version": 1,
                    "record_kind": "visible_same_task_supplement",
                    "supplement_id": supplement_id,
                    "run": args.run,
                    "task": args.task,
                    "worker_id": worker_id,
                    "attempt_id": expected_attempt,
                    "session_id": session_id,
                    "fence_hash": _canonical_json_hash(fence),
                    "authorization_id": authorization_id,
                    "contract_hash": expected_hash,
                    "original_selection": dict(original_selection),
                    "selection_evidence": selection_evidence,
                    "request_hash": request_hash,
                    "text": text,
                    "text_bytes": len(text.encode("utf-8")),
                    "ack_command": supplement_ack_checkpoint_command(
                        root, tdir, worker_id, expected_attempt, supplement_id
                    ),
                    "ack_command_note": SUPPLEMENT_ACK_COMMAND_NOTE,
                    "checkpoint_cursor_at_reservation": store_latest_seq(store),
                    "reservation_id": str(uuid.uuid4()),
                    "reserved_at": utc_now(),
                    "status": "reserved",
                }
                if supplement_worker_record.get("backend") == "codex_tui":
                    receipt = read_json(tdir / "codex_turn" / "turn-receipt.json")
                    native_turn = ((receipt.get("response") or {}).get("result") or {}).get("turn") or {}
                    record.update(
                        backend="codex_tui",
                        turn_id=str(native_turn.get("id") or ""),
                        transport="codex_appserver_websocket",
                        endpoint="turn/steer",
                    )
                write_json_exclusive_or_equal(record_path, record)
                _supplement_route_send_outcome(
                    adapter,
                    root,
                    args.run,
                    args.task,
                    worker_id,
                    supplement_id=supplement_id,
                    text=text,
                    request_hash=request_hash,
                    record_path=record_path,
                    record=record,
                    original_selection=original_selection,
                    selection_evidence=selection_evidence,
                    runtime_backend=getattr(args, "backend", RUNTIME_BACKEND),
                )
    except OperationAuthorizationError as exc:
        raise DispatchError(f"supplement authorization refused: {exc}") from exc
    if record and str(record.get("status") or "") in {
        "sent",
        "backend_rejected",
        "refused",
        "ambiguous",
    }:
        _ensure_supplement_authorization_revoked(
            root,
            args.task,
            expected_attempt,
            authorization_id=authorization_id,
            contract_hash=str(record.get("contract_hash") or ""),
            status=str(record.get("status") or ""),
        )
    delivery = supplement_delivery_state(record)
    payload = supplement_payload(
        root,
        args.run,
        args.task,
        tdir,
        record,
        duplicate=False,
        delivery=delivery,
        consumption=supplement_consumption_evidence(root, tdir, record),
        terminal_state=str(
            (task_truth(root, args.run, args.task) or {}).get(
                "protocol_terminal_state"
            )
            or ""
        ),
    )
    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print(
            "supplement_json: "
            + json.dumps(payload, sort_keys=True, ensure_ascii=False)
        )
        print(
            f"supplement: id={supplement_id} delivery={delivery} "
            f"resend=false terminal={payload['task_protocol_terminal_state'] or '-'}"
        )
    return 0 if delivery == "sent" else 1


def _ensure_supplement_authorization_revoked(
    root: Path,
    task_id: str,
    attempt_id: str,
    *,
    authorization_id: str,
    contract_hash: str,
    status: str,
) -> bool:
    """Idempotently consume a resolved supplement grant.

    A request-bound grant can never authorize a different supplement, so every
    resolved outcome revokes it; an interrupted ambiguous outcome is retained
    as a durable reservation and still ends this grant.
    """
    ledger = _operation_authorization_ledger(root, task_id, attempt_id)
    records = ledger.records()
    if any(
        item.get("decision") == "revoke"
        and item.get("revokes_authorization_id") == authorization_id
        for item in records
    ):
        return False
    provenance = (
        "supplement-applied-consume"
        if status == "sent"
        else "supplement-outcome-revoke"
    )
    try:
        ledger.append(
            {
                "schema_version": 1,
                "authorization_id": f"revoke-{authorization_id}",
                "principal": "omx_visible_dispatch",
                "decision": "revoke",
                "task_id": task_id,
                "attempt_id": attempt_id,
                "contract_hash": contract_hash,
                "created_at": utc_now(),
                "provenance": provenance,
                "revokes_authorization_id": authorization_id,
            }
        )
    except OperationAuthorizationError:
        if any(
            item.get("decision") == "revoke"
            and item.get("revokes_authorization_id") == authorization_id
            for item in ledger.records()
        ):
            return False
        raise
    return True


def interrupt_record_path(tdir: Path, interrupt_id: str) -> Path:
    safe_id(interrupt_id, "interrupt-id")
    path = tdir / f"interrupt-{interrupt_id}.json"
    if not is_relative_to(path, tdir):
        raise DispatchError("interrupt record escaped the task directory")
    return path


def interrupt_request_hash(fence: dict[str, Any], session_id: str) -> str:
    """Bind the exact task fence and session into one interrupt request hash."""
    return "sha256:" + hashlib.sha256(
        json.dumps(
            {
                "interrupt_kind": "session_abort",
                "session_id": session_id,
                "fence_hash": _canonical_json_hash(fence),
            },
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=True,
        ).encode("utf-8")
    ).hexdigest()


def _interrupt_contract_hash(
    task_contract: dict[str, Any] | None,
    operation_contract: dict[str, Any],
    *,
    worker_id: str,
    task_id: str,
    attempt_id: str,
    interrupt_id: str,
    request_hash: str,
    original_selection: dict[str, str],
    selection_evidence: str,
) -> str:
    """Mirror operation_authorization._interrupt_derived_contract_hash."""
    base = dict(task_contract) if task_contract else {}
    base.pop("operation_capability", None)
    return _canonical_json_hash(
        {
            "task_contract": base,
            "operation_contract": operation_contract,
            "worker_id": worker_id,
            "task_id": task_id,
            "attempt_id": attempt_id,
            "interrupt": {
                "interrupt_id": interrupt_id,
                "request_hash": request_hash,
                "original_selection": dict(original_selection),
                "selection_evidence": selection_evidence,
            },
        }
    )


def interrupt_pre_send_errors(
    root: Path,
    run: str,
    task: str,
    tdir: Path,
    *,
    worker_id: str,
    attempt_id: str,
) -> tuple[list[str], dict[str, Any], str]:
    """Final identity/ownership validation for a real interrupt send."""
    errors: list[str] = []
    owner = read_text(tdir / "owner").strip()
    if not owner:
        return ["task has no recorded owner"], {}, ""
    if owner != worker_id:
        errors.append(f"worker {worker_id} does not match task owner {owner}")
    if not (tdir / ".submitted").is_file() or not (tdir / ".started").is_file():
        errors.append("task is not started; interrupt requires submitted and started evidence")
    markers = [
        name for name in ("done", "fail", "blocked") if (tdir / f".{name}").is_file()
    ]
    if markers:
        errors.append("task already has terminal marker(s): " + ",".join(markers))
    fence = read_json(tdir / "acceptance_fence.json")
    fence_attempt = str(fence.get("attempt_id") or "")
    if not fence_attempt:
        errors.append("acceptance fence carries no attempt identity")
    elif fence_attempt != attempt_id:
        errors.append(
            f"caller attempt {attempt_id} does not match current attempt {fence_attempt}"
        )
    if str(fence.get("worker_id") or "") != worker_id:
        errors.append("acceptance fence worker does not match the target")
    if str(fence.get("task_id") or "") != task:
        errors.append("acceptance fence task does not match the target")
    session_id = str(fence.get("session_id") or "")
    try:
        interrupt_worker = worker_record(root, worker_id)
    except DispatchError:
        interrupt_worker = {}
    interrupt_backend = str(
        interrupt_worker.get("backend") or "opencode_tui")
    if interrupt_backend == "codex_tui":
        session_ok = bool(
            session_id
            and session_id == str(interrupt_worker.get("codex_thread") or ""))
        session_error = (
            "acceptance fence session is not the bound codex thread")
    else:
        session_ok = session_id.startswith("ses_")
        session_error = "acceptance fence has no live observed session"
    if (
        not session_ok
        or str(fence.get("session_fence_state") or "") != "live_observed"
    ):
        errors.append(session_error)
    access = read_checkpoint_access(root, tdir)
    if not access.get("ok"):
        errors.append(
            "current binding/owner-lock guard failed: "
            f"{access.get('status') or '-'}"
        )
    return errors, fence, session_id


def interrupt_payload(
    root: Path,
    run: str,
    task: str,
    tdir: Path,
    record: dict[str, Any],
    *,
    duplicate: bool,
    delivery: str,
    terminal_state: str,
) -> dict[str, Any]:
    return {
        "schema_version": 1,
        "run": run,
        "task": task,
        "task_dir": rel(tdir, root),
        "interrupt_id": str(record.get("interrupt_id") or ""),
        "record": rel(
            interrupt_record_path(tdir, str(record.get("interrupt_id") or "")), root
        ),
        "duplicate": duplicate,
        "attempt_id": str(record.get("attempt_id") or ""),
        "worker_id": str(record.get("worker_id") or ""),
        "session_id": str(record.get("session_id") or ""),
        "request_hash": str(record.get("request_hash") or ""),
        "reserved_at": str(record.get("reserved_at") or ""),
        "delivered_at": str(record.get("delivered_at") or ""),
        "record_status": str(record.get("status") or ""),
        "error": str(record.get("error") or ""),
        "delivery": delivery,
        "delivery_note": (
            "the measured 200 JSON boolean is the tracked-run cancel result "
            "and backend request acceptance only; it is not proof that every "
            "external tool, plugin, MCP or remote writer stopped, not "
            "consumption of a future correction, and never task completion; "
            "an ambiguous or lost-outcome reservation is retained and never "
            "resent"
        ),
        "response": record.get("response") or {},
        "backend_accepted": record.get("backend_accepted"),
        "pre_status": record.get("pre_status") or {},
        "post_status": record.get("post_status") or {},
        "authorization_id": str(record.get("authorization_id") or ""),
        "original_selection": record.get("original_selection") or {},
        "selection_evidence": str(record.get("selection_evidence") or ""),
        "task_protocol_terminal_state": terminal_state,
    }


def _interrupt_known_result(
    root: Path,
    args: argparse.Namespace,
    tdir: Path,
    record: dict[str, Any],
    *,
    interrupt_id: str,
) -> int:
    delivery = supplement_delivery_state(record)
    payload = interrupt_payload(
        root,
        args.run,
        args.task,
        tdir,
        record,
        duplicate=True,
        delivery=delivery,
        terminal_state=str(
            (task_truth(root, args.run, args.task) or {}).get(
                "protocol_terminal_state"
            )
            or ""
        ),
    )
    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print(
            "interrupt_json: "
            + json.dumps(payload, sort_keys=True, ensure_ascii=False)
        )
        print(
            f"interrupt: id={interrupt_id} duplicate=true delivery={delivery} "
            f"resend=false"
        )
    return 0 if delivery == "sent" else 1


def _ensure_interrupt_authorization_revoked(
    root: Path,
    task_id: str,
    attempt_id: str,
    *,
    authorization_id: str,
    contract_hash: str,
    status: str,
) -> bool:
    """Idempotently consume a resolved interrupt grant.

    A request-bound grant can never authorize a different interrupt, so every
    resolved outcome revokes it; an interrupted ambiguous outcome is retained
    as a durable reservation and still ends this grant.
    """
    ledger = _operation_authorization_ledger(root, task_id, attempt_id)
    records = ledger.records()
    if any(
        item.get("decision") == "revoke"
        and item.get("revokes_authorization_id") == authorization_id
        for item in records
    ):
        return False
    provenance = (
        "interrupt-applied-consume"
        if status == "sent"
        else "interrupt-outcome-revoke"
    )
    try:
        ledger.append(
            {
                "schema_version": 1,
                "authorization_id": f"revoke-{authorization_id}",
                "principal": "omx_visible_dispatch",
                "decision": "revoke",
                "task_id": task_id,
                "attempt_id": attempt_id,
                "contract_hash": contract_hash,
                "created_at": utc_now(),
                "provenance": provenance,
                "revokes_authorization_id": authorization_id,
            }
        )
    except OperationAuthorizationError:
        if any(
            item.get("decision") == "revoke"
            and item.get("revokes_authorization_id") == authorization_id
            for item in ledger.records()
        ):
            return False
        raise
    return True


def command_interrupt(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    if not getattr(args, "allow_real", False):
        raise DispatchError("interrupt requires --allow-real")
    worker_id = safe_id(str(getattr(args, "worker", "") or ""), "worker")
    interrupt_id = safe_id(
        str(getattr(args, "interrupt_id", "") or ""), "interrupt-id"
    )
    expected_attempt = str(getattr(args, "attempt_id", "") or "").strip()
    if not expected_attempt:
        raise DispatchError(
            "interrupt requires --attempt-id: delivery stays bound to one "
            "explicit caller attempt and never adopts the current attempt"
        )
    authorization_id = str(
        getattr(args, "interrupt_authorization_id", "") or ""
    ).strip()
    selection_file_value = str(getattr(args, "selection_file", "") or "")
    if selection_file_value:
        selection_path = Path(selection_file_value)
        if not selection_path.is_file():
            raise DispatchError(f"interrupt selection file not found: {selection_path}")
        selection, selection_evidence = supplement_selection_inputs(selection_path)
        try:
            bound = supplement_selection_payload(selection, selection_evidence)
        except OperationAuthorizationError as exc:
            raise DispatchError(str(exc)) from exc
        original_selection = bound["selection"]
        selection_evidence = bound["selection_evidence"]
    else:
        # Abort-only interrupt: default TUI tasks carry no original selection,
        # and the bodyless abort POST sends no prompt or model facts.
        original_selection = {}
        selection_evidence = ""
    tdir = task_dir(root, args.run, args.task)
    if not tdir.is_dir():
        raise DispatchError(f"task directory missing: {rel(tdir, root)}")
    record_path = interrupt_record_path(tdir, interrupt_id)
    existing = read_json(record_path) if record_path.is_file() else {}
    if existing:
        fence_now = read_json(tdir / "acceptance_fence.json")
        current_hash = (
            interrupt_request_hash(
                fence_now, str(fence_now.get("session_id") or "")
            )
            if fence_now
            else ""
        )
        if str(existing.get("request_hash") or "") != current_hash:
            raise DispatchError(
                f"interrupt {interrupt_id} already exists for a different "
                "task identity; use a new interrupt-id"
            )
        identity_errors = supplement_replay_identity_errors(
            root,
            args.run,
            args.task,
            tdir,
            existing,
            worker_id=worker_id,
            attempt_id=expected_attempt,
        )
        if identity_errors:
            raise DispatchError(
                "interrupt replay refused: " + "; ".join(identity_errors)
            )
        recorded_selection = existing.get("original_selection")
        recorded_evidence = str(existing.get("selection_evidence") or "")
        if (
            _canonical_json_hash(
                recorded_selection if isinstance(recorded_selection, dict) else {}
            )
            != _canonical_json_hash(dict(original_selection))
            or recorded_evidence != selection_evidence
        ):
            raise DispatchError(
                f"interrupt {interrupt_id} replay refused: the supplied "
                "selection or selection evidence differs from the recorded "
                "interrupt request; changed content never replays a known "
                "result or mints a new grant"
            )
        return _interrupt_known_result(
            root,
            args,
            tdir,
            existing,
            interrupt_id=interrupt_id,
        )
    pre_errors, fence, session_id = interrupt_pre_send_errors(
        root,
        args.run,
        args.task,
        tdir,
        worker_id=worker_id,
        attempt_id=expected_attempt,
    )
    if pre_errors:
        raise DispatchError("interrupt refused: " + "; ".join(pre_errors))
    request_hash = interrupt_request_hash(fence, session_id)
    task_contract = read_json(tdir / "task.json").get("task_contract")
    contract = task_contract if isinstance(task_contract, dict) else {}
    if bool(getattr(args, "authorize_leader", False)):
        if authorization_id:
            raise DispatchError(
                "--authorize-leader cannot be combined with "
                "--interrupt-authorization-id; use one authorization mode"
            )
        event_id = str(getattr(args, "event_id", "") or "").strip()
        if not event_id:
            raise DispatchError("--authorize-leader requires --event-id")
        base_contract = {
            key: value
            for key, value in contract.items()
            if key != "operation_capability"
        }
        try:
            prepared = prepare_external_harness_interrupt_grant(
                root=root,
                task_id=args.task,
                attempt_id=expected_attempt,
                worker_id=worker_id,
                interrupt_id=interrupt_id,
                request_hash=request_hash,
                original_selection=original_selection,
                selection_evidence=selection_evidence,
                base_task_contract=base_contract,
                event_id=event_id,
            )
        except OperationAuthorizationError as exc:
            raise DispatchError(f"interrupt authorization refused: {exc}") from exc
        authorization_id = str(prepared["authorization_id"])
    elif not authorization_id:
        raise DispatchError(
            "interrupt requires --interrupt-authorization-id, or "
            "--authorize-leader with --event-id for the trusted leader path"
        )
    try:
        operation_contract = derive_operation_contract("worker_interrupt", contract)
    except OperationAuthorizationError as exc:
        raise DispatchError(str(exc)) from exc
    expected_hash = _interrupt_contract_hash(
        contract,
        operation_contract,
        worker_id=worker_id,
        task_id=args.task,
        attempt_id=expected_attempt,
        interrupt_id=interrupt_id,
        request_hash=request_hash,
        original_selection=original_selection,
        selection_evidence=selection_evidence,
    )
    ledger = _operation_authorization_ledger(root, args.task, expected_attempt)
    boundary = ledger.boundary_sequence()
    record: dict[str, Any] = {}
    try:
        with ledger.mutation_boundary(
            authorization_id,
            expected_boundary=boundary,
        ) as capability:
            validate_operation_capability(
                capability,
                operation_kind="worker_interrupt",
                target_scope={"kind": "worker", "id": worker_id},
                required_mutation_gates=list(
                    operation_contract["required_mutation_gates"]
                ),
                task_id=args.task,
                attempt_id=expected_attempt,
            )
            validate_mutation_gate_union(
                list(operation_contract["required_mutation_gates"]),
                INTERRUPT_ENFORCED_GATES,
            )
            if str(capability.get("contract_hash") or "") != expected_hash:
                raise DispatchError(
                    "interrupt grant contract hash does not match this exact "
                    "interrupt request and original selection"
                )
            with task_lifecycle_lock(tdir):
                errors, fence, session_id = interrupt_pre_send_errors(
                    root,
                    args.run,
                    args.task,
                    tdir,
                    worker_id=worker_id,
                    attempt_id=expected_attempt,
                )
                if errors:
                    raise DispatchError(
                        "interrupt refused: " + "; ".join(errors)
                    )
                if interrupt_request_hash(fence, session_id) != request_hash:
                    raise DispatchError(
                        "task identity changed under the interrupt request; "
                        "refusing to bind a stale fence/session"
                    )
                interrupt_worker_record = worker_record(root, worker_id)
                if str(interrupt_worker_record.get("backend") or "") == "codex_tui":
                    codex_adapter_module = load_codex_adapter_module(root)

                    class CodexInterruptShim:
                        AdapterError = codex_adapter_module.CodexAdapterError

                        @staticmethod
                        def interrupt_selection_guard(*_a, **_k):
                            return None

                        @staticmethod
                        def request_session_abort_runtime(root, run, task,
                                                          worker_id,
                                                          **_k):
                            return codex_adapter_module.interrupt_turn(
                                root, run, task, worker_id)

                    adapter = CodexInterruptShim
                else:
                    adapter = load_adapter_module(root)
                if original_selection:
                    try:
                        adapter.interrupt_selection_guard(
                            original_selection=dict(original_selection),
                            selection_evidence=selection_evidence,
                        )
                    except Exception as exc:
                        raise DispatchError(f"interrupt refused: {exc}") from exc
                record = {
                    "schema_version": 1,
                    "record_kind": "visible_task_interrupt",
                    "interrupt_id": interrupt_id,
                    "run": args.run,
                    "task": args.task,
                    "worker_id": worker_id,
                    "attempt_id": expected_attempt,
                    "session_id": session_id,
                    "fence_hash": _canonical_json_hash(fence),
                    "authorization_id": authorization_id,
                    "contract_hash": expected_hash,
                    "original_selection": dict(original_selection),
                    "selection_evidence": selection_evidence,
                    "request_hash": request_hash,
                    "reservation_id": str(uuid.uuid4()),
                    "reserved_at": utc_now(),
                    "status": "reserved",
                }
                write_json_exclusive_or_equal(record_path, record)
                try:
                    result = adapter.request_session_abort_runtime(
                        root,
                        args.run,
                        args.task,
                        worker_id,
                        interrupt_id=interrupt_id,
                        request_hash=request_hash,
                        reservation_path=record_path,
                        original_selection=original_selection,
                        selection_evidence=selection_evidence,
                        runtime_backend=getattr(args, "backend", RUNTIME_BACKEND),
                    )
                except Exception as exc:
                    # The adapter POSTs only as its final side effect, so an
                    # AdapterError is a pre-send refusal: nothing reached the
                    # backend. Any other exception may have happened after the
                    # POST, so the outcome is ambiguous and never resent.
                    adapter_error_type = getattr(adapter, "AdapterError", None)
                    refused = bool(
                        isinstance(adapter_error_type, type)
                        and isinstance(exc, adapter_error_type)
                    )
                    record.update(
                        {
                            "status": "refused" if refused else "ambiguous",
                            "resolved_at": utc_now(),
                            "error": f"{type(exc).__name__}: {exc}",
                            "response": {},
                        }
                    )
                    write_json_atomic(record_path, record)
                else:
                    record.update(
                        {
                            "status": (
                                "sent"
                                if result.get("delivery") == "sent"
                                else str(result.get("delivery") or "ambiguous")
                            ),
                            "delivered_at": utc_now(),
                            "transport": str(result.get("transport") or ""),
                            "endpoint": str(result.get("endpoint") or ""),
                            "backend_accepted": result.get("backend_accepted"),
                            "response_boolean": result.get("response_boolean"),
                            "pre_status": result.get("pre_status") or {},
                            "post_status": result.get("post_status") or {},
                            "selection_binding": result.get("selection_binding") or {},
                            "response": result.get("response") or {},
                        }
                    )
                    write_json_atomic(record_path, record)
    except OperationAuthorizationError as exc:
        raise DispatchError(f"interrupt authorization refused: {exc}") from exc
    if record and str(record.get("status") or "") in {
        "sent",
        "backend_rejected",
        "refused",
        "ambiguous",
    }:
        _ensure_interrupt_authorization_revoked(
            root,
            args.task,
            expected_attempt,
            authorization_id=authorization_id,
            contract_hash=str(record.get("contract_hash") or ""),
            status=str(record.get("status") or ""),
        )
    delivery = supplement_delivery_state(record)
    payload = interrupt_payload(
        root,
        args.run,
        args.task,
        tdir,
        record,
        duplicate=False,
        delivery=delivery,
        terminal_state=str(
            (task_truth(root, args.run, args.task) or {}).get(
                "protocol_terminal_state"
            )
            or ""
        ),
    )
    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print(
            "interrupt_json: "
            + json.dumps(payload, sort_keys=True, ensure_ascii=False)
        )
        print(
            f"interrupt: id={interrupt_id} delivery={delivery} "
            f"resend=false terminal={payload['task_protocol_terminal_state'] or '-'}"
        )
    return 0 if delivery == "sent" else 1


def _interrupt_status_caller_errors(
    root: Path,
    run: str,
    task: str,
    tdir: Path,
    *,
    worker_id: str,
    attempt_id: str,
) -> list[str]:
    """Exact caller binding for interrupt-status before any receipt or read.

    Read-only, so started/terminal evidence is not required: a legitimate
    terminal keeps historical receipt reads available, but the caller must
    still be the task owner on the fence's worker/task/attempt with current
    binding/owner-lock access.
    """
    errors: list[str] = []
    owner = read_text(tdir / "owner").strip()
    if not owner:
        errors.append("task has no recorded owner")
    elif owner != worker_id:
        errors.append(f"worker {worker_id} does not match task owner {owner}")
    fence = read_json(tdir / "acceptance_fence.json")
    fence_attempt = str(fence.get("attempt_id") or "")
    if not fence_attempt:
        errors.append("acceptance fence carries no attempt identity")
    elif fence_attempt != attempt_id:
        errors.append(
            f"caller attempt {attempt_id} does not match current attempt {fence_attempt}"
        )
    if str(fence.get("worker_id") or "") != worker_id:
        errors.append("acceptance fence worker does not match the caller")
    if str(fence.get("task_id") or "") != task:
        errors.append("acceptance fence task does not match the caller")
    access = read_checkpoint_access(root, tdir)
    if not access.get("ok"):
        errors.append(
            "current binding/owner-lock guard failed: "
            f"{access.get('status') or '-'}"
        )
    return errors


def command_interrupt_status(args: argparse.Namespace) -> int:
    """Read-only interrupt receipt plus bounded live session observation.

    Replay/query never appends authorization, aborts again, changes owner
    locks or terminal data, and a live observation never rewrites a recorded
    ambiguous or failed delivery into a known successful one.
    """
    root = root_path(args.root)
    worker_id = safe_id(str(getattr(args, "worker", "") or ""), "worker")
    interrupt_id = safe_id(
        str(getattr(args, "interrupt_id", "") or ""), "interrupt-id"
    )
    expected_attempt = str(getattr(args, "attempt_id", "") or "").strip()
    if not expected_attempt:
        raise DispatchError("interrupt-status requires --attempt-id")
    tdir = task_dir(root, args.run, args.task)
    if not tdir.is_dir():
        raise DispatchError(f"task directory missing: {rel(tdir, root)}")
    record_path = interrupt_record_path(tdir, interrupt_id)
    record = read_json(record_path) if record_path.is_file() else {}
    identity_errors: list[str] = []
    if record:
        identity_errors = supplement_replay_identity_errors(
            root,
            args.run,
            args.task,
            tdir,
            record,
            worker_id=worker_id,
            attempt_id=expected_attempt,
        )
    caller_errors = _interrupt_status_caller_errors(
        root,
        args.run,
        args.task,
        tdir,
        worker_id=worker_id,
        attempt_id=expected_attempt,
    )
    if caller_errors or identity_errors:
        # Exact caller binding before any receipt fields or live read: a
        # wrong or stale caller never receives the prior caller's receipt.
        payload = {
            "schema_version": 1,
            "run": args.run,
            "task": args.task,
            "task_dir": rel(tdir, root),
            "interrupt_id": interrupt_id,
            "present": bool(record),
            "withheld": True,
            "identity_errors": caller_errors or identity_errors,
            "observes_only": True,
            "observation_note": (
                "read-only: the caller does not match the current task "
                "owner/fence/attempt/access, so no receipt fields and no "
                "live observation are returned"
            ),
        }
        if getattr(args, "json", False):
            print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
        else:
            print(
                "interrupt_status_json: "
                + json.dumps(payload, sort_keys=True, ensure_ascii=False)
            )
        return 1
    delivery = supplement_delivery_state(record) if record else "absent"
    observed_status: dict[str, Any] = {}
    observation_error = ""
    if not identity_errors:
        fence = read_json(tdir / "acceptance_fence.json")
        session_id = str(fence.get("session_id") or "") if fence else ""
        try:
            observe_worker_record = worker_record(root, worker_id)
            observe_is_codex = bool(
                str(observe_worker_record.get("backend") or "") == "codex_tui"
                and session_id
                and session_id == str(
                    observe_worker_record.get("codex_thread") or ""))
        except DispatchError:
            observe_is_codex = False
        if session_id.startswith("ses_") or observe_is_codex:
            try:
                if observe_is_codex:
                    codex_adapter_module = load_codex_adapter_module(root)

                    class CodexObserveShim:
                        AdapterError = codex_adapter_module.CodexAdapterError

                        @staticmethod
                        def observe_session_status_runtime(root, worker_id,
                                                           session_id,
                                                           **_k):
                            return codex_adapter_module.observe_thread_status(
                                root, worker_id)

                    adapter = CodexObserveShim
                else:
                    adapter = load_adapter_module(root)
                observed_status = adapter.observe_session_status_runtime(
                    root,
                    worker_id,
                    session_id,
                    runtime_backend=getattr(args, "backend", RUNTIME_BACKEND),
                )
            except Exception as exc:
                observation_error = f"{type(exc).__name__}: {exc}"
    payload = {
        "schema_version": 1,
        "run": args.run,
        "task": args.task,
        "task_dir": rel(tdir, root),
        "interrupt_id": interrupt_id,
        "present": bool(record),
        "delivery": delivery,
        "record_status": str(record.get("status") or ""),
        "duplicate": bool(record),
        "attempt_id": str(record.get("attempt_id") or ""),
        "worker_id": str(record.get("worker_id") or ""),
        "session_id": str(record.get("session_id") or ""),
        "pre_status": record.get("pre_status") or {},
        "post_status": record.get("post_status") or {},
        "backend_accepted": record.get("backend_accepted"),
        "observed_status": observed_status,
        "observation_error": observation_error,
        "observes_only": True,
        "withheld": False,
        "observation_note": (
            "read-only: replay/query never appends authorization, never "
            "aborts again, and never rewrites a recorded ambiguous or failed "
            "delivery into a known successful one; the live observation is "
            "diagnostic only"
        ),
        "identity_errors": identity_errors,
        "task_protocol_terminal_state": str(
            (task_truth(root, args.run, args.task) or {}).get(
                "protocol_terminal_state"
            )
            or ""
        ),
    }
    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print(
            "interrupt_status_json: "
            + json.dumps(payload, sort_keys=True, ensure_ascii=False)
        )
    return 1 if identity_errors else 0


def resume_record_path(tdir: Path, resume_id: str) -> Path:
    safe_id(resume_id, "resume-id")
    path = tdir / f"resume-{resume_id}.json"
    if not is_relative_to(path, tdir):
        raise DispatchError("resume record escaped the task directory")
    return path


def resume_request_hash(
    *,
    resume_id: str,
    fence: dict[str, Any],
    session_id: str,
    interrupt_record: dict[str, Any],
    text: str,
    original_selection: dict[str, str],
    selection_evidence: str,
    writer_record: dict[str, Any],
) -> str:
    """Bind intent + identity/selection/text + the entire immutable interrupt receipt + writer record.

    The whole canonical interrupt receipt is hash-bound, so any post-hoc
    modification of the stored receipt invalidates an exact replay. The
    measured fresh stop observation is an enforced pre-send predicate and
    persisted receipt fact; it is deliberately not part of this logical hash,
    so an exact replay never needs a re-measured timestamp or idle backend.
    This is the logical resume identity; the transport-level text payload
    hash stays the adapter's own unconditional check.
    """
    return "sha256:" + hashlib.sha256(
        json.dumps(
            {
                "resume_kind": "same_task_resume",
                "resume_id": resume_id,
                "session_id": session_id,
                "fence_hash": _canonical_json_hash(fence),
                "interrupt_receipt_hash": _canonical_json_hash(
                    interrupt_record
                ),
                "text": text,
                "original_selection": dict(original_selection),
                "selection_evidence": selection_evidence,
                "writer_record_hash": _canonical_json_hash(writer_record),
            },
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=True,
        ).encode("utf-8")
    ).hexdigest()


_WRITER_ACTIVE_STATES = frozenset(
    {"active", "unknown", "running", "pending"}
)
_WRITER_TERMINAL_STATES = frozenset(
    {"stopped", "exited", "completed", "finished", "done"}
)


def _parse_iso_utc(value: str) -> datetime | None:
    text = str(value or "").strip()
    if not text:
        return None
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        parsed = datetime.fromisoformat(text)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        return None
    return parsed


def _writer_coverage_common_errors(
    record: dict[str, Any],
    tdir: Path,
    *,
    run: str,
    task: str,
) -> tuple[list[str], datetime | None]:
    """Shared coordinator writer-coverage core for resume and handoff.

    Two real consumers: the same-task resume writer record and the P4B
    predecessor handoff writer-coverage record. Validates verifier, a
    timezone-aware ISO-8601 checked_at (returned for caller-specific
    applicability rules), reviewed scope/coverage, an empty unresolved list,
    known terminal writer identities with task-contained digest-matching
    evidence, explicit backend-only review for empty writer lists, and the
    quiet cross-check. Binding fields (record kind, interrupt/closeout
    applicability, fence) stay with each caller.
    """
    errors: list[str] = []
    if str(record.get("run") or "") != run:
        errors.append("writer verification run does not match the task")
    if str(record.get("task") or "") != task:
        errors.append("writer verification task does not match the task")
    if not str(record.get("verifier") or "").strip():
        errors.append("writer verification verifier is required")
    checked_at_text = str(record.get("checked_at") or "").strip()
    if not checked_at_text:
        errors.append("writer verification checked_at is required")
    checked_at = _parse_iso_utc(checked_at_text)
    if checked_at is None:
        errors.append(
            "writer verification checked_at must be a timezone-aware ISO-8601 "
            "timestamp"
        )
    if not str(record.get("scope") or "").strip():
        errors.append("writer verification scope is required")
    if not str(record.get("coverage") or "").strip():
        errors.append("writer verification coverage is required")
    unresolved = record.get("unresolved")
    if not isinstance(unresolved, list) or unresolved:
        errors.append("writer verification unresolved must be an empty list")
    writers = record.get("writers")
    if not isinstance(writers, list):
        errors.append("writer verification writers must be a list")
        writers = []
    if record.get("quiet") is True and (
        (isinstance(unresolved, list) and unresolved)
        or any(
            isinstance(writer, dict)
            and str(writer.get("terminal_state") or "").strip()
            in _WRITER_ACTIVE_STATES
            for writer in writers
        )
    ):
        errors.append(
            "writer verification quiet=true contradicts unresolved or "
            "active writers; fake quiet is refused"
        )
    if not writers and not str(
        record.get("backend_only_reviewed_by") or ""
    ).strip():
        errors.append(
            "empty writer list requires an explicitly reviewed "
            "backend-only scope (backend_only_reviewed_by); quiet is never "
            "inferred from an empty list"
        )
    for writer in writers:
        if not isinstance(writer, dict):
            errors.append("writer entry must be an object")
            continue
        identity = str(writer.get("identity") or "").strip()
        if not identity:
            errors.append("writer identity is required")
        terminal_state = str(writer.get("terminal_state") or "").strip()
        if terminal_state in _WRITER_ACTIVE_STATES or (
            terminal_state and terminal_state not in _WRITER_TERMINAL_STATES
        ):
            errors.append(
                f"writer {identity or '?'} terminal_state must be one of the "
                f"known terminal states {sorted(_WRITER_TERMINAL_STATES)}, "
                "not an arbitrary or active/unknown value"
            )
        elif not terminal_state:
            errors.append(
                f"writer {identity or '?'} terminal_state is required"
            )
        evidence = writer.get("evidence")
        if not isinstance(evidence, dict):
            errors.append(f"writer {identity or '?'} evidence must be an object")
            continue
        evidence_path_value = str(evidence.get("path") or "")
        expected_digest = str(evidence.get("sha256") or "").strip().lower()
        if not evidence_path_value or not expected_digest:
            errors.append(
                f"writer {identity or '?'} evidence path and sha256 are required"
            )
            continue
        evidence_path = Path(evidence_path_value)
        if not is_relative_to(evidence_path, tdir) or not evidence_path.is_file():
            errors.append(
                f"writer {identity or '?'} evidence path must stay inside "
                "the task directory"
            )
            continue
        actual = hashlib.sha256(evidence_path.read_bytes()).hexdigest()
        if actual != expected_digest:
            errors.append(
                f"writer {identity or '?'} evidence digest does not match "
                "the file"
            )
    return errors, checked_at


def _resume_writer_verification_errors(
    writer_record: dict[str, Any],
    tdir: Path,
    fence: dict[str, Any],
    *,
    interrupt_id: str,
    run: str,
    task: str,
    interrupt_record: dict[str, Any] | None = None,
) -> list[str]:
    """Validate the mandatory trusted-leader writer verification record.

    This is coordinator verification under the existing trusted-leader
    convention: it binds exact task/fence/interrupt, verifier and check time,
    reviewed scope/coverage, known writer identities with terminal states and
    task-contained digest-matching evidence refs, and an empty unresolved
    list. It is not cryptographic attestation or an automatic inventory.
    """
    errors: list[str] = []
    if int(writer_record.get("schema_version") or 0) != 1:
        errors.append("writer verification schema_version must be 1")
    if str(writer_record.get("record_kind") or "") != (
        "p4_resume_writer_verification"
    ):
        errors.append("writer verification record_kind mismatch")
    if str(writer_record.get("interrupt_id") or "") != interrupt_id:
        errors.append(
            "writer verification interrupt does not match the target interrupt"
        )
    if str(writer_record.get("fence_hash") or "") != _canonical_json_hash(fence):
        errors.append(
            "writer verification fence_hash does not match the current fence"
        )
    common_errors, checked_at = _writer_coverage_common_errors(
        writer_record,
        tdir,
        run=run,
        task=task,
    )
    errors.extend(common_errors)
    interrupt_delivered_at = _parse_iso_utc(
        str((interrupt_record or {}).get("delivered_at") or "")
    )
    if checked_at is not None and interrupt_delivered_at is not None:
        if checked_at < interrupt_delivered_at:
            errors.append(
                "writer verification checked_at must apply after the exact "
                "interrupt; older terminal evidence may stay valid but the "
                "leader scope verification cannot predate the interrupt"
            )
    elif interrupt_record is not None and interrupt_delivered_at is None:
        errors.append(
            "interrupt receipt delivered_at is not a parseable timestamp, so "
            "writer verification applicability is unverifiable"
        )
    return errors

def _resume_interrupt_errors(
    interrupt_record: dict[str, Any],
    fence: dict[str, Any],
    *,
    run: str,
    task: str,
    worker_id: str,
    attempt_id: str,
    original_selection: dict[str, str] | None = None,
) -> list[str]:
    errors: list[str] = []
    if str(interrupt_record.get("record_kind") or "") != (
        "visible_task_interrupt"
    ):
        errors.append(
            "the referenced interrupt record is not a task interrupt receipt"
        )
        return errors
    if (
        str(interrupt_record.get("run") or "") != run
        or str(interrupt_record.get("task") or "") != task
    ):
        errors.append("interrupt receipt belongs to a different task")
    if str(interrupt_record.get("worker_id") or "") != worker_id:
        errors.append("interrupt receipt worker does not match the caller")
    if str(interrupt_record.get("attempt_id") or "") != attempt_id:
        errors.append(
            "interrupt receipt attempt does not match the caller attempt"
        )
    if str(interrupt_record.get("session_id") or "") != str(
        fence.get("session_id") or ""
    ):
        errors.append("interrupt receipt session does not match the fence session")
    if (
        str(interrupt_record.get("status") or "") != "sent"
        or interrupt_record.get("backend_accepted") is not True
        or interrupt_record.get("response_boolean") is not True
    ):
        errors.append(
            "interrupt receipt is not an accepted nonambiguous cancellation "
            "with a true measured boolean result"
        )
    receipt_selection = interrupt_record.get("original_selection")
    if original_selection is not None and _canonical_json_hash(
        receipt_selection if isinstance(receipt_selection, dict) else {}
    ) != _canonical_json_hash(dict(original_selection)):
        errors.append(
            "interrupt receipt original selection does not match the resume's "
            "bound selection; resume preserves the interrupted task selection"
        )
    if str(interrupt_record.get("fence_hash") or "") != _canonical_json_hash(fence):
        errors.append(
            "interrupt receipt fence_hash does not match the current fence"
        )
    return errors


def _resume_rekey_errors(
    tdir: Path,
    resume_id: str,
    interrupt_id: str,
) -> list[str]:
    errors: list[str] = []
    for path in sorted(tdir.glob("resume-*.json")):
        if path == resume_record_path(tdir, resume_id):
            continue
        other = read_json(path)
        if str(other.get("interrupt_id") or "") != interrupt_id:
            continue
        if str(other.get("status") or "") in {"sent", "reserved", "ambiguous"}:
            errors.append(
                f"a potentially delivered resume (status="
                f"{other.get('status')}) {other.get('resume_id') or path.name} "
                f"already exists for interrupt {interrupt_id}; one accepted "
                "interrupt permits at most one potentially delivered resume, "
                "a new accepted interruption is required for another stop/"
                "resume, fresh idle never refreshes consumed stop or "
                "writer proof, the same unresolved interrupted-resume is "
                "never re-keyed, and only proven no-effect refusal or "
                "backend rejection may retry under a new id"
            )
    return errors


def resume_payload(
    root: Path,
    args: argparse.Namespace,
    tdir: Path,
    record: dict[str, Any],
    *,
    duplicate: bool,
    delivery: str,
    terminal_state: str,
) -> dict[str, Any]:
    return {
        "schema_version": 1,
        "run": args.run,
        "task": args.task,
        "task_dir": rel(tdir, root),
        "resume_id": str(record.get("resume_id") or ""),
        "record": rel(
            resume_record_path(tdir, str(record.get("resume_id") or "")), root
        ),
        "duplicate": duplicate,
        "attempt_id": str(record.get("attempt_id") or ""),
        "worker_id": str(record.get("worker_id") or ""),
        "session_id": str(record.get("session_id") or ""),
        "interrupt_id": str(record.get("interrupt_id") or ""),
        "writer_record_hash": str(record.get("writer_record_hash") or ""),
        "request_hash": str(record.get("request_hash") or ""),
        "logical_resume_hash": str(record.get("logical_resume_hash") or ""),
        "reserved_at": str(record.get("reserved_at") or ""),
        "delivered_at": str(record.get("delivered_at") or ""),
        "record_status": str(record.get("status") or ""),
        "error": str(record.get("error") or ""),
        "delivery": delivery,
        "delivery_note": (
            "backend request acceptance only; tracked stop came from the "
            "measured pre-send idle observation plus leader writer "
            "verification, worker-reported acknowledgement comes only from "
            "the exact resume:<resume-id> checkpoint anchor, and actual "
            "resumed-work acceptance is judged from later task evidence; an "
            "ambiguous or lost-outcome reservation is retained and never "
            "resent"
        ),
        "response": record.get("response") or {},
        "backend_accepted": record.get("backend_accepted"),
        "stop_observation": record.get("stop_observation") or {},
        "authorization_id": str(record.get("authorization_id") or ""),
        "original_selection": record.get("original_selection") or {},
        "selection_evidence": str(record.get("selection_evidence") or ""),
        "consumption": supplement_consumption_evidence(
            root,
            tdir,
            record,
            acknowledgement_prefix=RESUME_ACKNOWLEDGEMENT_PREFIX,
        ),
        "task_protocol_terminal_state": terminal_state,
    }


def _resume_known_result(
    root: Path,
    args: argparse.Namespace,
    tdir: Path,
    record: dict[str, Any],
    *,
    resume_id: str,
) -> int:
    delivery = supplement_delivery_state(record)
    payload = resume_payload(
        root,
        args,
        tdir,
        record,
        duplicate=True,
        delivery=delivery,
        terminal_state=str(
            (task_truth(root, args.run, args.task) or {}).get(
                "protocol_terminal_state"
            )
            or ""
        ),
    )
    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print(
            "resume_json: " + json.dumps(payload, sort_keys=True, ensure_ascii=False)
        )
        print(
            f"resume: id={resume_id} duplicate=true delivery={delivery} "
            f"resend=false"
        )
    return 0 if delivery == "sent" else 1


def command_resume(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    if not getattr(args, "allow_real", False):
        raise DispatchError("resume requires --allow-real")
    worker_id = safe_id(str(getattr(args, "worker", "") or ""), "worker")
    resume_id = safe_id(str(getattr(args, "resume_id", "") or ""), "resume-id")
    interrupt_id = safe_id(
        str(getattr(args, "interrupt_id", "") or ""), "interrupt-id"
    )
    expected_attempt = str(getattr(args, "attempt_id", "") or "").strip()
    if not expected_attempt:
        raise DispatchError(
            "resume requires --attempt-id: delivery stays bound to one "
            "explicit caller attempt and never adopts the current attempt"
        )
    authorization_id = str(
        getattr(args, "resume_authorization_id", "") or ""
    ).strip()
    selection_file_value = str(getattr(args, "selection_file", "") or "")
    if not selection_file_value:
        raise DispatchError(
            "resume requires --selection-file: the task's original agent/"
            "model/variant binding must come from the host-prepared grant, "
            "not task prose"
        )
    selection_path = Path(selection_file_value)
    if not selection_path.is_file():
        raise DispatchError(f"resume selection file not found: {selection_path}")
    selection, selection_evidence = supplement_selection_inputs(selection_path)
    try:
        bound = supplement_selection_payload(selection, selection_evidence)
    except OperationAuthorizationError as exc:
        raise DispatchError(str(exc)) from exc
    original_selection = bound["selection"]
    selection_evidence = bound["selection_evidence"]
    text_file_value = str(getattr(args, "text_file", "") or "")
    if not text_file_value:
        raise DispatchError("resume requires --text-file")
    text_path = Path(text_file_value)
    if not text_path.is_file():
        raise DispatchError(f"resume text file not found: {text_path}")
    text = text_path.read_text(encoding="utf-8")
    if not text.strip():
        raise DispatchError("resume text is empty")
    if len(text.encode("utf-8")) > SUPPLEMENT_TEXT_BYTE_LIMIT:
        raise DispatchError(
            f"resume text exceeds {SUPPLEMENT_TEXT_BYTE_LIMIT} bytes"
        )
    writer_file_value = str(getattr(args, "writer_evidence_file", "") or "")
    if not writer_file_value:
        raise DispatchError(
            "resume requires --writer-evidence-file: coordinator writer "
            "verification is mandatory"
        )
    writer_path = Path(writer_file_value)
    if not writer_path.is_file():
        raise DispatchError(
            f"resume writer evidence file not found: {writer_path}"
        )
    writer_record = read_json(writer_path)
    if not writer_record:
        raise DispatchError("resume writer evidence record is empty or unreadable")
    tdir = task_dir(root, args.run, args.task)
    if not tdir.is_dir():
        raise DispatchError(f"task directory missing: {rel(tdir, root)}")
    record_path = resume_record_path(tdir, resume_id)
    fence_now = read_json(tdir / "acceptance_fence.json")
    session_now = str(fence_now.get("session_id") or "") if fence_now else ""
    interrupt_record_now = (
        read_json(interrupt_record_path(tdir, interrupt_id))
        if interrupt_record_path(tdir, interrupt_id).is_file()
        else {}
    )
    existing = read_json(record_path) if record_path.is_file() else {}
    if existing:
        if not fence_now or not session_now or not interrupt_record_now:
            raise DispatchError(
                "resume replay refused: the task fence or interrupt receipt "
                "needed to recompute the bound request is missing"
            )
        current_hash = resume_request_hash(
            resume_id=resume_id,
            fence=fence_now,
            session_id=session_now,
            interrupt_record=interrupt_record_now,
            text=text,
            original_selection=original_selection,
            selection_evidence=selection_evidence,
            writer_record=writer_record,
        )
        if str(existing.get("logical_resume_hash") or "") != current_hash:
            raise DispatchError(
                f"resume {resume_id} replay refused: the supplied text/"
                "selection/writer evidence or the stored interrupt receipt "
                "differs from the recorded resume request; changed content "
                "never replays a known result"
            )
        identity_errors = supplement_replay_identity_errors(
            root,
            args.run,
            args.task,
            tdir,
            existing,
            worker_id=worker_id,
            attempt_id=expected_attempt,
        )
        if identity_errors:
            raise DispatchError(
                "resume replay refused: " + "; ".join(identity_errors)
            )
        return _resume_known_result(
            root,
            args,
            tdir,
            existing,
            resume_id=resume_id,
        )
    pre_errors, fence, session_id = supplement_pre_send_errors(
        root,
        args.run,
        args.task,
        tdir,
        worker_id=worker_id,
        attempt_id=expected_attempt,
        allow_default_tui=True,
    )
    if pre_errors:
        raise DispatchError("resume refused: " + "; ".join(pre_errors))
    writer_errors = _resume_writer_verification_errors(
        writer_record,
        tdir,
        fence,
        interrupt_id=interrupt_id,
        run=args.run,
        task=args.task,
        interrupt_record=interrupt_record_now,
    )
    if writer_errors:
        raise DispatchError(
            "resume writer verification refused: " + "; ".join(writer_errors)
        )
    rekey_errors = _resume_rekey_errors(tdir, resume_id, interrupt_id)
    if rekey_errors:
        raise DispatchError("resume refused: " + "; ".join(rekey_errors))
    transport_hash = supplement_request_hash(text)
    request_hash = resume_request_hash(
        resume_id=resume_id,
        fence=fence,
        session_id=session_id,
        interrupt_record=interrupt_record_now,
        text=text,
        original_selection=original_selection,
        selection_evidence=selection_evidence,
        writer_record=writer_record,
    )
    task_contract = read_json(tdir / "task.json").get("task_contract")
    contract = task_contract if isinstance(task_contract, dict) else {}
    if bool(getattr(args, "authorize_leader", False)):
        if authorization_id:
            raise DispatchError(
                "--authorize-leader cannot be combined with "
                "--resume-authorization-id; use one authorization mode"
            )
        event_id = str(getattr(args, "event_id", "") or "").strip()
        if not event_id:
            raise DispatchError("--authorize-leader requires --event-id")
        base_contract = {
            key: value
            for key, value in contract.items()
            if key != "operation_capability"
        }
        try:
            prepared = prepare_external_harness_supplement_resume_grant(
                root=root,
                task_id=args.task,
                attempt_id=expected_attempt,
                worker_id=worker_id,
                resume_id=resume_id,
                request_hash=request_hash,
                original_selection=original_selection,
                selection_evidence=selection_evidence,
                base_task_contract=base_contract,
                event_id=event_id,
            )
        except OperationAuthorizationError as exc:
            raise DispatchError(f"resume authorization refused: {exc}") from exc
        authorization_id = str(prepared["authorization_id"])
    elif not authorization_id:
        raise DispatchError(
            "resume requires --resume-authorization-id, or --authorize-leader "
            "with --event-id for the trusted leader path"
        )
    try:
        operation_contract = derive_operation_contract("worker_supplement", contract)
    except OperationAuthorizationError as exc:
        raise DispatchError(str(exc)) from exc
    expected_hash = _supplement_contract_hash(
        contract,
        operation_contract,
        worker_id=worker_id,
        task_id=args.task,
        attempt_id=expected_attempt,
        supplement_id=resume_id,
        request_hash=request_hash,
        original_selection=original_selection,
        selection_evidence=selection_evidence,
        bindings_key="resume",
    )
    ledger = _operation_authorization_ledger(root, args.task, expected_attempt)
    boundary = ledger.boundary_sequence()
    record: dict[str, Any] = {}
    try:
        with ledger.mutation_boundary(
            authorization_id,
            expected_boundary=boundary,
        ) as capability:
            validate_operation_capability(
                capability,
                operation_kind="worker_supplement",
                target_scope={"kind": "worker", "id": worker_id},
                required_mutation_gates=list(
                    operation_contract["required_mutation_gates"]
                ),
                task_id=args.task,
                attempt_id=expected_attempt,
            )
            validate_mutation_gate_union(
                list(operation_contract["required_mutation_gates"]),
                SUPPLEMENT_ENFORCED_GATES,
            )
            if str(capability.get("contract_hash") or "") != expected_hash:
                raise DispatchError(
                    "resume grant contract hash does not match this exact "
                    "resume request; an ordinary supplement grant without "
                    "resume bindings is not resume authority"
                )
            with task_lifecycle_lock(tdir):
                errors, fence, session_id = supplement_pre_send_errors(
                    root,
                    args.run,
                    args.task,
                    tdir,
                    worker_id=worker_id,
                    attempt_id=expected_attempt,
                    allow_default_tui=True,
                )
                if errors:
                    raise DispatchError("resume refused: " + "; ".join(errors))
                fresh_interrupt = (
                    read_json(interrupt_record_path(tdir, interrupt_id))
                    if interrupt_record_path(tdir, interrupt_id).is_file()
                    else {}
                )
                if not fresh_interrupt:
                    raise DispatchError(
                        f"interrupt receipt {interrupt_id} is missing"
                    )
                interrupt_errors = _resume_interrupt_errors(
                    fresh_interrupt,
                    fence,
                    run=args.run,
                    task=args.task,
                    worker_id=worker_id,
                    attempt_id=expected_attempt,
                    original_selection=original_selection,
                )
                if interrupt_errors:
                    raise DispatchError(
                        "resume interrupt receipt refused: "
                        + "; ".join(interrupt_errors)
                    )
                fresh_writer = read_json(writer_path)
                if not fresh_writer:
                    raise DispatchError(
                        "resume writer evidence record became unreadable"
                    )
                writer_errors = _resume_writer_verification_errors(
                    fresh_writer,
                    tdir,
                    fence,
                    interrupt_id=interrupt_id,
                    run=args.run,
                    task=args.task,
                    interrupt_record=fresh_interrupt,
                )
                if writer_errors:
                    raise DispatchError(
                        "resume writer verification refused: "
                        + "; ".join(writer_errors)
                    )
                rekey_errors = _resume_rekey_errors(tdir, resume_id, interrupt_id)
                if rekey_errors:
                    raise DispatchError("resume refused: " + "; ".join(rekey_errors))
                if (
                    resume_request_hash(
                        resume_id=resume_id,
                        fence=fence,
                        session_id=session_id,
                        interrupt_record=fresh_interrupt,
                        text=text,
                        original_selection=original_selection,
                        selection_evidence=selection_evidence,
                        writer_record=fresh_writer,
                    )
                    != request_hash
                    or supplement_request_hash(text) != transport_hash
                ):
                    raise DispatchError(
                        "resume inputs changed under the grant; refusing to "
                        "bind a stale request"
                    )
                resume_contract = read_json(tdir / "task.json").get(
                    "task_contract"
                )
                resume_contract = (
                    resume_contract
                    if isinstance(resume_contract, dict)
                    else {}
                )
                try:
                    resume_selector = extract_opencode_server_prompt_async_canary(
                        resume_contract
                    )
                except OperationAuthorizationError as exc:
                    raise DispatchError(str(exc)) from exc
                if resume_selector is not None:
                    # Pinned-selector tasks keep their exact schema admission;
                    # a selector-less ordinary default-TUI task is admitted by
                    # the pre-send backend check above and re-checked by the
                    # shared supplement transport (#906). No selector is
                    # fabricated for either case.
                    try:
                        admit_opencode_server_interrupt_canary(resume_selector)
                    except OperationAuthorizationError as exc:
                        raise DispatchError(
                            "resume refused: pinned runtime admission failed at "
                            f"the send boundary: {exc}"
                        ) from exc
                stop_worker_record = worker_record(root, worker_id)
                if str(stop_worker_record.get("backend") or "") == "codex_tui":
                    codex_adapter_module = load_codex_adapter_module(root)

                    class CodexStopObserveShim:
                        AdapterError = codex_adapter_module.CodexAdapterError

                        @staticmethod
                        def observe_session_status_runtime(root, worker_id,
                                                           session_id,
                                                           **_k):
                            return codex_adapter_module.observe_thread_status(
                                root, worker_id)

                    adapter = CodexStopObserveShim
                else:
                    adapter = load_adapter_module(root)
                try:
                    stop_observation = adapter.observe_session_status_runtime(
                        root,
                        worker_id,
                        session_id,
                        runtime_backend=getattr(args, "backend", RUNTIME_BACKEND),
                    )
                except Exception as exc:
                    raise DispatchError(
                        f"resume fresh stop observation failed: {exc}"
                    ) from exc
                if (
                    stop_observation.get("status_type") != "idle"
                    or not stop_observation.get("ok")
                ):
                    raise DispatchError(
                        "resume refused: the exact session is not freshly "
                        "idle (status_type="
                        f"{stop_observation.get('status_type') or '-'}); "
                        "abort acceptance is not complete writer proof, so "
                        "resume waits for observed quiet"
                    )
                store = read_progress_checkpoints(tdir)
                try:
                    adapter.interrupt_selection_guard(
                        original_selection=dict(original_selection),
                        selection_evidence=selection_evidence,
                    )
                except Exception as exc:
                    raise DispatchError(f"resume refused: {exc}") from exc
                record = {
                    "schema_version": 1,
                    "record_kind": "visible_task_resume",
                    "resume_id": resume_id,
                    "supplement_id": resume_id,
                    "run": args.run,
                    "task": args.task,
                    "worker_id": worker_id,
                    "attempt_id": expected_attempt,
                    "session_id": session_id,
                    "fence_hash": _canonical_json_hash(fence),
                    "authorization_id": authorization_id,
                    "contract_hash": expected_hash,
                    "original_selection": dict(original_selection),
                    "selection_evidence": selection_evidence,
                    "request_hash": transport_hash,
                    "logical_resume_hash": request_hash,
                    "interrupt_id": interrupt_id,
                    "interrupt_contract_hash": str(
                        fresh_interrupt.get("contract_hash") or ""
                    ),
                    "interrupt_request_hash": str(
                        fresh_interrupt.get("request_hash") or ""
                    ),
                    "writer_record_hash": _canonical_json_hash(fresh_writer),
                    "text": text,
                    "text_bytes": len(text.encode("utf-8")),
                    "checkpoint_cursor_at_reservation": store_latest_seq(store),
                    "stop_observation": stop_observation,
                    "reservation_id": str(uuid.uuid4()),
                    "reserved_at": utc_now(),
                    "status": "reserved",
                }
                write_json_exclusive_or_equal(record_path, record)
                _supplement_route_send_outcome(
                    adapter,
                    root,
                    args.run,
                    args.task,
                    worker_id,
                    supplement_id=resume_id,
                    text=text,
                    request_hash=transport_hash,
                    record_path=record_path,
                    record=record,
                    original_selection=original_selection,
                    selection_evidence=selection_evidence,
                    runtime_backend=getattr(args, "backend", RUNTIME_BACKEND),
                )
    except OperationAuthorizationError as exc:
        raise DispatchError(f"resume authorization refused: {exc}") from exc
    if record and str(record.get("status") or "") in {
        "sent",
        "backend_rejected",
        "refused",
        "ambiguous",
    }:
        _ensure_supplement_authorization_revoked(
            root,
            args.task,
            expected_attempt,
            authorization_id=authorization_id,
            contract_hash=str(record.get("contract_hash") or ""),
            status=str(record.get("status") or ""),
        )
    delivery = supplement_delivery_state(record)
    payload = resume_payload(
        root,
        args,
        tdir,
        record,
        duplicate=False,
        delivery=delivery,
        terminal_state=str(
            (task_truth(root, args.run, args.task) or {}).get(
                "protocol_terminal_state"
            )
            or ""
        ),
    )
    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print(
            "resume_json: " + json.dumps(payload, sort_keys=True, ensure_ascii=False)
        )
        print(
            f"resume: id={resume_id} delivery={delivery} "
            f"resend=false terminal={payload['task_protocol_terminal_state'] or '-'}"
        )
    return 0 if delivery == "sent" else 1


HANDOFF_RECORD_KIND = "p4_predecessor_handoff"
HANDOFF_WRITER_RECORD_KIND = "p4_predecessor_handoff_writer_coverage"
_PREDECESSOR_TERMINAL_MARKERS = {
    "completed": ".done",
    "blocked": ".blocked",
    "failed": ".fail",
}
_PREDECESSOR_TERMINAL_KIND_STATES = {
    "normal_done": {"completed"},
    "recovery_closeout": {"blocked", "failed"},
}
_PREDECESSOR_RETAINED_KINDS = frozenset(
    {"report", "artifact", "unfinished_work"}
)


def handoff_record_hash(record: dict[str, Any]) -> str:
    """Canonical hash of the whole predecessor handoff record."""
    return _canonical_json_hash(record)


def predecessor_handoff_errors(
    root: Path,
    handoff_record: dict[str, Any],
    *,
    successor_task_id: str,
    successor_attempt_id: str,
    successor_worker_id: str,
) -> list[str]:
    """Validate one hash-bound predecessor->successor handoff record.

    The predecessor must have a legitimately accepted current terminal
    (normal finish or existing explicit recovery closeout blocked/fail), a
    retained non-empty report with matching digest, task-contained retained
    artifact/unfinished-work references, settled ownership (no active old
    owner lock), and a coordinator writer-coverage record whose scope
    verification applies after the accepted closeout and binds the
    predecessor identity. The successor identity must match the actual
    dispatch. Nothing here closes or settles the predecessor, fabricates an
    interrupt receipt for a normally finished task, or treats a terminal
    protocol result as business success.
    """
    errors: list[str] = []
    if int(handoff_record.get("schema_version") or 0) != 1:
        errors.append("predecessor handoff schema_version must be 1")
    if str(handoff_record.get("record_kind") or "") != HANDOFF_RECORD_KIND:
        errors.append("predecessor handoff record_kind mismatch")
    predecessor = handoff_record.get("predecessor")
    if not isinstance(predecessor, dict):
        errors.append("predecessor handoff predecessor block is required")
        return errors
    terminal = handoff_record.get("terminal")
    if not isinstance(terminal, dict):
        errors.append("predecessor handoff terminal block is required")
        return errors
    retained = handoff_record.get("retained_work")
    if not isinstance(retained, list) or not retained:
        errors.append(
            "predecessor handoff retained_work must be a non-empty list"
        )
        retained = []
    writer_coverage = handoff_record.get("writer_coverage")
    if not isinstance(writer_coverage, dict):
        errors.append(
            "predecessor handoff writer_coverage block is required"
        )
        writer_coverage = {}
    successor = handoff_record.get("successor")
    if not isinstance(successor, dict):
        errors.append("predecessor handoff successor block is required")
        successor = {}

    run = str(predecessor.get("run") or "")
    task = str(predecessor.get("task") or "")
    if not run or not task:
        errors.append("predecessor run/task are required")
        return errors
    if (
        str(successor.get("task_id") or "") != successor_task_id
        or str(successor.get("attempt_id") or "") != successor_attempt_id
        or str(successor.get("worker_id") or "") != successor_worker_id
    ):
        errors.append(
            "predecessor handoff successor identity does not match the "
            "actual dispatch successor task/attempt/worker"
        )

    pdir = task_dir(root, run, task)
    if not pdir.is_dir():
        errors.append(f"predecessor task directory missing: {rel(pdir, root)}")
        return errors
    fence = read_json(pdir / "acceptance_fence.json")
    if not fence:
        errors.append("predecessor acceptance fence is missing")
        return errors
    if str(predecessor.get("fence_hash") or "") != _canonical_json_hash(fence):
        errors.append(
            "predecessor handoff fence_hash does not match the predecessor "
            "acceptance fence"
        )
    if str(predecessor.get("attempt_id") or "") != str(
        fence.get("attempt_id") or ""
    ):
        errors.append(
            "predecessor handoff attempt does not match the predecessor fence"
        )
    if str(predecessor.get("worker_id") or "") != str(
        fence.get("worker_id") or ""
    ):
        errors.append(
            "predecessor handoff worker does not match the predecessor fence"
        )
    if str(fence.get("task_id") or "") != task:
        errors.append(
            "predecessor handoff task does not match the predecessor fence"
        )
    if str(predecessor.get("session_id") or "") != str(
        fence.get("session_id") or ""
    ):
        errors.append(
            "predecessor handoff session does not match the predecessor fence"
        )

    truth = task_truth(root, run, task)
    state = str(truth.get("protocol_terminal_state") or "")
    marker = _PREDECESSOR_TERMINAL_MARKERS.get(state, "")
    if not marker:
        errors.append(
            "predecessor has no legitimately accepted current terminal "
            f"state (state={state or '-'}); handoff requires normal finish "
            "or explicit recovery closeout"
        )
    elif not (pdir / marker).is_file():
        errors.append(
            f"predecessor terminal marker {marker} is missing"
        )
    if not bool(truth.get("terminal_acceptance_accepted")):
        errors.append(
            "predecessor terminal acceptance fence is not accepted"
        )
    if str(truth.get("lock_state") or "") != "none":
        errors.append(
            "predecessor ownership is not settled "
            f"(lock_state={truth.get('lock_state') or '-'}); settle is an "
            "explicit prior operation and handoff never auto-settles"
        )
    kind = str(terminal.get("kind") or "")
    allowed_states = _PREDECESSOR_TERMINAL_KIND_STATES.get(kind)
    if allowed_states is None:
        errors.append(
            "predecessor handoff terminal kind must be normal_done or "
            "recovery_closeout"
        )
    else:
        if state not in allowed_states:
            errors.append(
                f"predecessor handoff terminal kind {kind} does not match "
                f"the accepted terminal state {state or '-'}"
            )
        if str(terminal.get("state") or "") != state:
            errors.append(
                "predecessor handoff terminal state does not match the "
                "authoritative task state"
            )

    # Advertised terminal provenance comes from the existing accepted
    # terminal evidence itself (claim kind + acceptance reason), never from
    # a caller label: normal_done requires the ordinary visible terminal
    # output claim, recovery_closeout requires the accepted
    # operator-recovery closeout path with its retained authorization.
    acceptance = terminal_acceptance_status(pdir)
    acceptance_claim = (
        acceptance.get("claim")
        if isinstance(acceptance.get("claim"), dict)
        else {}
    )
    actual_claim_kind = str(acceptance_claim.get("claim_kind") or "")
    acceptance_reason = str(acceptance.get("reason") or "")
    if kind == "normal_done" and (
        actual_claim_kind != "visible_terminal_output"
        or acceptance_reason != "accepted"
    ):
        errors.append(
            "predecessor handoff normal_done requires the accepted ordinary "
            f"terminal output claim (claim_kind={actual_claim_kind or '-'}, "
            f"reason={acceptance_reason or '-'})"
        )
    if kind == "recovery_closeout" and (
        actual_claim_kind != OPERATOR_RECOVERY_CLAIM_KIND
        or acceptance_reason != "accepted_operator_recovery_closeout"
    ):
        errors.append(
            "predecessor handoff recovery_closeout requires the accepted "
            "operator-recovery closeout terminal "
            f"(claim_kind={actual_claim_kind or '-'}, "
            f"reason={acceptance_reason or '-'}); an ordinary worker "
            "blocked/fail terminal is not recovery provenance"
        )

    terminal_claim_path = pdir / "terminal_output_claim.json"
    terminal_claim_digest = str(terminal.get("terminal_claim_sha256") or "")
    if not terminal_claim_digest:
        errors.append(
            "predecessor handoff must bind the exact accepted terminal "
            "claim digest (terminal_claim_sha256)"
        )
    elif not terminal_claim_path.is_file() or (
        hashlib.sha256(terminal_claim_path.read_bytes()).hexdigest()
        != terminal_claim_digest
    ):
        errors.append(
            "predecessor handoff terminal claim digest does not match the "
            "accepted terminal_output_claim.json"
        )
    if kind == "recovery_closeout":
        recovery_authorization_path = (
            pdir / "recovery_closeout_authorization.json"
        )
        recovery_digest = str(
            terminal.get("recovery_authorization_sha256") or ""
        )
        if not recovery_digest:
            errors.append(
                "predecessor handoff recovery_closeout must bind the "
                "consumed recovery authorization digest "
                "(recovery_authorization_sha256)"
            )
        elif not recovery_authorization_path.is_file() or (
            hashlib.sha256(
                recovery_authorization_path.read_bytes()
            ).hexdigest()
            != recovery_digest
        ):
            errors.append(
                "predecessor handoff recovery authorization digest does not "
                "match recovery_closeout_authorization.json"
            )

    report_path = pdir / "report.md"
    report_digest = str(terminal.get("report_sha256") or "")
    if not report_path.is_file() or not report_path.read_text(
        encoding="utf-8"
    ).strip():
        errors.append("predecessor report.md must exist and be non-empty")
    elif not report_digest:
        errors.append("predecessor handoff terminal report_sha256 is required")
    elif (
        hashlib.sha256(report_path.read_bytes()).hexdigest() != report_digest
    ):
        errors.append(
            "predecessor handoff report digest does not match report.md"
        )

    closeout_at = None
    marker_path = pdir / marker if marker else None
    if marker_path is not None and marker_path.exists():
        closeout_at = datetime.fromtimestamp(
            marker_path.stat().st_mtime,
            tz=timezone.utc,
        )
        if report_path.exists():
            closeout_at = max(
                closeout_at,
                datetime.fromtimestamp(
                    report_path.stat().st_mtime,
                    tz=timezone.utc,
                ),
            )

    for entry in retained:
        if not isinstance(entry, dict):
            errors.append("retained_work entry must be an object")
            continue
        retained_path_value = str(entry.get("path") or "")
        retained_digest = str(entry.get("sha256") or "").strip().lower()
        retained_kind = str(entry.get("kind") or "")
        if retained_kind not in _PREDECESSOR_RETAINED_KINDS:
            errors.append(
                f"retained_work kind must be one of "
                f"{sorted(_PREDECESSOR_RETAINED_KINDS)}"
            )
        if not retained_path_value or not retained_digest:
            errors.append(
                "retained_work entry path and sha256 are required"
            )
            continue
        retained_path = Path(retained_path_value)
        if not is_relative_to(retained_path, pdir) or not retained_path.is_file():
            errors.append(
                "retained_work path must stay inside the predecessor task "
                "directory"
            )
            continue
        if (
            hashlib.sha256(retained_path.read_bytes()).hexdigest()
            != retained_digest
        ):
            errors.append(
                "retained_work digest does not match the referenced file"
            )

    if writer_coverage:
        if int(writer_coverage.get("schema_version") or 0) != 1:
            errors.append("writer coverage schema_version must be 1")
        if str(writer_coverage.get("record_kind") or "") != (
            HANDOFF_WRITER_RECORD_KIND
        ):
            errors.append("writer coverage record_kind mismatch")
        if str(writer_coverage.get("fence_hash") or "") != _canonical_json_hash(
            fence
        ):
            errors.append(
                "writer coverage fence_hash does not bind the predecessor "
                "fence identity"
            )
        coverage_errors, checked_at = _writer_coverage_common_errors(
            writer_coverage,
            pdir,
            run=run,
            task=task,
        )
        errors.extend(coverage_errors)
        if closeout_at is not None:
            if checked_at is not None and checked_at < closeout_at:
                errors.append(
                    "writer coverage checked_at must apply after the "
                    "predecessor's accepted closeout; older terminal "
                    "evidence may stay valid but the scope verification "
                    "cannot predate the closeout"
                )
    return errors


def claim_predecessor_successor(
    root: Path,
    handoff_record: dict[str, Any],
    handoff_hash: str,
    *,
    successor_task_id: str,
    successor_attempt_id: str,
    successor_worker_id: str,
    dispatch_claim_id: str = "",
    successor_run_id: str = "",
) -> dict[str, Any]:
    """Serialize the predecessor-local one-successor claim.

    Under the predecessor's task lifecycle lock, the first accepted successor
    creates the claim; the exact same successor identity plus handoff hash
    reuses it; any other successor identity or changed handoff evidence
    refuses. A predecessor is consumed by at most one successor and is never
    re-keyed; a later handoff must start from the actual successor. Only the
    explicitly scoped local claim file is written: predecessor reports,
    markers, artifacts and lock archives stay untouched.
    """
    predecessor = handoff_record.get("predecessor")
    if not isinstance(predecessor, dict):
        raise DispatchError("predecessor handoff predecessor block is required")
    pdir = task_dir(root, str(predecessor.get("run") or ""), str(predecessor.get("task") or ""))
    claim_path = pdir / "predecessor-successor-claim.json"
    claim = {
        "schema_version": 1,
        "record_kind": "p4_predecessor_successor_claim",
        "predecessor": {
            "run": str(predecessor.get("run") or ""),
            "task": str(predecessor.get("task") or ""),
            "attempt_id": str(predecessor.get("attempt_id") or ""),
            "worker_id": str(predecessor.get("worker_id") or ""),
            "session_id": str(predecessor.get("session_id") or ""),
        },
        "successor": {
            "task_id": successor_task_id,
            "attempt_id": successor_attempt_id,
            "worker_id": successor_worker_id,
        },
        "handoff_sha256": handoff_hash,
        "dispatch_claim_id": dispatch_claim_id,
        "successor_run": successor_run_id,
        "status": "claimed",
        "created_at": utc_now(),
    }
    with task_lifecycle_lock(pdir):
        # One lifecycle-serialized decision for every potentially-sending
        # path through this helper: revalidate the predecessor evidence
        # under the same predecessor lock that serializes the claim, so
        # drift while waiting for the lock can never reuse or create a
        # claim on stale-validated evidence. The genuine historical
        # no-send replay never reaches this helper: it returns earlier in
        # run-one after the immutable hash comparison alone.
        lock_errors = predecessor_handoff_errors(
            root,
            handoff_record,
            successor_task_id=successor_task_id,
            successor_attempt_id=successor_attempt_id,
            successor_worker_id=successor_worker_id,
        )
        if lock_errors:
            raise DispatchError(
                "predecessor handoff refused under the predecessor lock: "
                + "; ".join(lock_errors)
            )
        existing = read_json(claim_path) if claim_path.is_file() else {}
        if existing:
            same_successor_and_content = (
                existing.get("successor") == claim["successor"]
                and str(existing.get("handoff_sha256") or "") == handoff_hash
                and existing.get("predecessor") == claim["predecessor"]
            )
            if same_successor_and_content:
                if dispatch_claim_id and str(
                    existing.get("dispatch_claim_id") or ""
                ) not in {"", dispatch_claim_id}:
                    raise DispatchError(
                        "predecessor handoff refused: the predecessor is "
                        "already consumed by this successor under dispatch "
                        "claim "
                        f"{existing.get('dispatch_claim_id')} "
                        f"(run {existing.get('successor_run') or '-'}); a "
                        "different grant or dispatch claim cannot re-send "
                        "it. Replay must reuse the already reserved "
                        "successor run/dispatch claim; uncertain original "
                        "progress stays reserved and is never re-keyed"
                    )
                return {**existing, "action": "reused"}
            existing_successor = (
                existing.get("successor") or {}
                if isinstance(existing.get("successor"), dict)
                else {}
            )
            raise DispatchError(
                "predecessor handoff refused: this predecessor already has "
                f"a successor claim for successor task "
                f"{existing_successor.get('task_id') or '-'}; one "
                "predecessor is consumed by at most one successor, a "
                "consumed predecessor or changed evidence is never re-keyed, "
                "and a later handoff must start from the actual successor"
            )
        write_json_exclusive_or_equal(claim_path, claim)
        stored = read_json(claim_path)
        if (
            stored.get("successor") != claim["successor"]
            or str(stored.get("handoff_sha256") or "") != handoff_hash
        ):
            raise DispatchError(
                "predecessor successor claim changed during creation"
            )
    return {**claim, "action": "claimed"}


def _predecessor_handoff_replay_conflict_check(
    root: Path,
    args: argparse.Namespace,
    task_contract: dict[str, Any],
    capability: dict[str, Any],
) -> None:
    """Compare handoff identity/content before a lower-level replay return.

    A reused run-one dispatch claim returns the stored result; before that
    happens, a supplied predecessor handoff file must still hash-match the
    grant-bound digest and successor identity. This is a content conflict
    check only: historical receipt replay is not conflated with fresh
    admission or writer observations, and no predecessor state is re-read.
    """
    handoff_file = str(getattr(args, "predecessor_handoff_file", "") or "")
    binding = task_contract.get("predecessor_handoff")
    if not handoff_file and not binding:
        return
    if not handoff_file or not isinstance(binding, dict):
        raise DispatchError(
            "predecessor handoff conflict: replay requires both the "
            "--predecessor-handoff-file and its grant-bound "
            "predecessor_handoff binding"
        )
    handoff_path = Path(handoff_file)
    if not handoff_path.is_file():
        raise DispatchError(
            f"predecessor handoff file not found: {handoff_path}"
        )
    handoff_record = read_json(handoff_path)
    if not handoff_record:
        raise DispatchError(
            "predecessor handoff file is empty or unreadable JSON"
        )
    handoff_hash = handoff_record_hash(handoff_record)
    if str(binding.get("handoff_sha256") or "") != handoff_hash:
        raise DispatchError(
            "predecessor handoff conflict: the supplied handoff content "
            "differs from the grant-bound digest on this replayed dispatch "
            "claim; changed content never replays a known result"
        )
    successor = handoff_record.get("successor")
    successor = successor if isinstance(successor, dict) else {}
    if (
        str(successor.get("task_id") or "") != str(capability.get("task_id") or "")
        or str(successor.get("attempt_id") or "")
        != str(capability.get("attempt_id") or "")
        or str(successor.get("worker_id") or "")
        != str((capability.get("scope") or {}).get("id") or "")
    ):
        raise DispatchError(
            "predecessor handoff conflict: successor identity does not "
            "match the replayed dispatch capability"
        )


def _prepare_predecessor_handoff_for_run_one(
    root: Path,
    args: argparse.Namespace,
    task_contract: dict[str, Any],
    capability: dict[str, Any],
    dispatch_claim: dict[str, Any],
) -> dict[str, Any] | None:
    """Optional predecessor handoff gate at protected preparation.

    Present only when both the successor dispatch supplies
    ``--predecessor-handoff-file`` and the grant-bound task contract carries
    the matching ``predecessor_handoff`` binding; an ordinary dispatch
    without either is unchanged. Validates the predecessor's accepted
    terminal state, retained evidence, writer coverage and successor
    identity, then claims the predecessor-local one-successor lock under the
    predecessor's lifecycle lock before any successor task creation,
    ownership or send.
    """
    handoff_file = str(getattr(args, "predecessor_handoff_file", "") or "")
    binding = task_contract.get("predecessor_handoff")
    if not handoff_file and not binding:
        return None
    if not handoff_file:
        raise DispatchError(
            "predecessor handoff: the grant binds a predecessor handoff but "
            "no --predecessor-handoff-file was supplied"
        )
    if not isinstance(binding, dict):
        raise DispatchError(
            "predecessor handoff: --predecessor-handoff-file requires a "
            "grant that binds the predecessor handoff; an ordinary dispatch "
            "grant without the binding refuses"
        )
    successor_task_id = str(capability.get("task_id") or "")
    successor_attempt_id = str(capability.get("attempt_id") or "")
    successor_worker_id = str((capability.get("scope") or {}).get("id") or "")
    handoff_path = Path(handoff_file)
    if not handoff_path.is_file():
        raise DispatchError(
            f"predecessor handoff file not found: {handoff_path}"
        )
    handoff_record = read_json(handoff_path)
    if not handoff_record:
        raise DispatchError(
            "predecessor handoff file is empty or unreadable JSON"
        )
    errors = predecessor_handoff_errors(
        root,
        handoff_record,
        successor_task_id=successor_task_id,
        successor_attempt_id=successor_attempt_id,
        successor_worker_id=successor_worker_id,
    )
    if errors:
        raise DispatchError(
            "predecessor handoff refused: " + "; ".join(errors)
        )
    handoff_hash = handoff_record_hash(handoff_record)
    if str(binding.get("handoff_sha256") or "") != handoff_hash:
        raise DispatchError(
            "predecessor handoff: the grant-bound handoff digest does not "
            "match the supplied handoff record"
        )
    if (
        str(binding.get("successor_task") or "") != successor_task_id
        or str(binding.get("successor_attempt") or "") != successor_attempt_id
        or str(binding.get("worker_id") or "") != successor_worker_id
    ):
        raise DispatchError(
            "predecessor handoff: grant-bound successor identity does not "
            "match the dispatch capability"
        )
    return claim_predecessor_successor(
        root,
        handoff_record,
        handoff_hash,
        successor_task_id=successor_task_id,
        successor_attempt_id=successor_attempt_id,
        successor_worker_id=successor_worker_id,
        dispatch_claim_id=str(dispatch_claim.get("claim_id") or ""),
        successor_run_id=str(dispatch_claim.get("run_id") or ""),
    )


def command_status(args: argparse.Namespace) -> int:

    root = root_path(args.root)
    backend = getattr(args, "backend", RUNTIME_BACKEND)
    requested_worker = getattr(args, "worker", None)
    show_all_workers = bool(getattr(args, "all_workers", False))
    if getattr(args, "compact", False):
        if show_all_workers:
            raise DispatchError(
                "--compact cannot be combined with --all-workers; "
                "use --worker for bounded live readiness"
            )
        payload = compact_recovery_payload(
            root,
            command="status",
            worker_id=requested_worker,
            backend=backend,
            include_pool_readiness=bool(
                getattr(args, "include_pool_readiness", False)
            ),
        )
        if args.json:
            print(
                json.dumps(
                    payload,
                    indent=2,
                    sort_keys=True,
                    ensure_ascii=False,
                )
            )
        else:
            print_compact_recovery(payload)
        return 0
    pool_scope_worker = requested_worker if requested_worker and not show_all_workers else None
    include_pool_readiness = bool(
        pool_scope_worker
        or show_all_workers
        or getattr(args, "include_pool_readiness", False)
    )
    tasks = visible_tasks(root, worker_id=requested_worker)
    locks = diagnose_worker_locks(root, worker_id=requested_worker)
    watcher = read_watcher_board(root)
    watcher_snapshot = watcher_snapshot_status(watcher, locks)
    if include_pool_readiness:
        pool_snapshot = current_dispatchable_pool_snapshot(
            root,
            backend=backend,
            worker_id=pool_scope_worker,
            rebind_timeout=(
                TARGET_REBIND_READINESS_TIMEOUT
                if pool_scope_worker
                else POOL_REBIND_READINESS_TIMEOUT
            ),
            prioritize_worker_ids=[requested_worker] if requested_worker else None,
        )
    else:
        pool_snapshot = registry_only_pool_snapshot(root)
    registry_qualified_workers = pool_snapshot["registry_qualified_workers"]
    dispatchable = pool_snapshot["dispatchable_workers"]
    rebind_required_workers = pool_snapshot["requires_manual_rebind_workers"]
    rebind_unknown_workers = pool_snapshot.get(
        "rebind_check_unknown_workers",
        [],
    )
    pool_rows = pool_snapshot["pool_rows"]
    rebind_check_limit = pool_snapshot.get("rebind_check_limit")
    rebind_check_skipped_workers = list(
        pool_snapshot.get("rebind_check_skipped_workers", [])
    )
    rebind_timed_out_workers = list(
        pool_snapshot.get("rebind_timed_out_workers", [])
    )
    registry_warning = str(pool_snapshot["registry_warning"] or "")
    default_worker: dict[str, Any] = {}
    stale_default_worker: dict[str, Any] = {}
    default_worker_state = "not_applicable"
    if not requested_worker and not show_all_workers:
        if registry_qualified_workers:
            try:
                candidate, readiness = default_worker_rebind_readiness(
                    root,
                    backend=backend,
                )
            except DispatchError as exc:
                default_worker_state = "unavailable"
                registry_warning = "; ".join(
                    item for item in (registry_warning, str(exc)) if item
                )
            else:
                if readiness.get("rebind_ok"):
                    default_worker = candidate
                    default_worker_state = "healthy"
                else:
                    stale_default_worker = {
                        **candidate,
                        "rebind_status": readiness.get("rebind_status"),
                    }
                    default_worker_state = "stale"
        else:
            default_worker_state = "unavailable"
    worker_inventory: list[dict[str, Any]] = []
    if show_all_workers:
        try:
            worker_inventory = load_visible_workers(root)
        except DispatchError as exc:
            worker_inventory = []
            if not registry_warning:
                registry_warning = str(exc)
    payload = {
        "schema_version": 1,
        "generated_at": utc_now(),
        "visible_runs_root": rel(visible_runs_root(root), root),
        "tasks": tasks,
        "locks": locks,
        "lock_diagnosis": summarize_lock_diagnosis(locks),
        "summary": dict(sorted(Counter(item["status"] for item in tasks).items())),
        "watcher": {
            "present": bool(watcher),
            "path": rel(watcher_board_path(root), root),
            "generated_at": watcher.get("generated_at", ""),
            "summary": watcher.get("summary", {}),
            "alert_count": watcher.get("alert_count", 0),
            "snapshot_status": watcher_snapshot,
        },
        "registered_workers": source_registered_worker_summary(root),
        "default_worker": default_worker,
        "default_worker_state": default_worker_state,
        "stale_default_worker": stale_default_worker,
        "registry_qualified_visible_workers": registry_qualified_workers,
        "dispatchable_visible_workers": dispatchable,
        "requires_manual_rebind_workers": rebind_required_workers,
        "rebind_check_unknown_workers": rebind_unknown_workers,
        "pool_rebind_check_limit": rebind_check_limit,
        "pool_rebind_check_skipped_workers": rebind_check_skipped_workers,
        "global_pool_snapshot_timed_out": bool(rebind_timed_out_workers),
        "global_pool_timed_out_workers": rebind_timed_out_workers,
        "pool_readiness_included": include_pool_readiness,
        "pool_snapshot_mode": (
            "rebind_readiness"
            if include_pool_readiness
            else "registry_only"
        ),
        "current_dispatchable_pool": pool_rows,
        "authorization_profile_summary": authorization_profile_surface_summary(root),
        "opencode_mixed_status": source_opencode_mixed_status_summary(
            root,
            worker_id=requested_worker or None,
            include_all=show_all_workers,
        ),
        "runtime_backend": backend,
        "runtime_backend_type": backend_type_for(backend),
        "worker_id": requested_worker or "",
        "all_workers": show_all_workers,
    }
    if registry_warning:
        payload["registry_warning"] = registry_warning
    if requested_worker:
        payload["worker"] = worker_status_payload(
            root,
            requested_worker,
            projected_tasks=tasks,
        )
    elif show_all_workers:
        payload["workers"] = [worker_status_payload(root, str(worker.get("worker_id") or "")) for worker in worker_inventory]
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
        return 0
    if requested_worker:
        scoped = payload["worker"]
        print(f"worker_id: {requested_worker}")
        print(f"port: {scoped.get('port') or '-'}")
        print(f"pane_id: {scoped.get('pane_id') or '-'}")
        print(f"tmux_session: {scoped.get('tmux_session') or '-'}")
        print(f"tmux_window: {scoped.get('tmux_window') or '-'}")
        print(
            "worker_id_port_suffix_mismatch: "
            f"{str(bool(scoped.get('worker_id_port_suffix_mismatch'))).lower()}"
        )
        print("status_scope: worker")
        print(f"runtime_backend: {payload.get('runtime_backend') or RUNTIME_BACKEND}")
        print(f"runtime_backend_type: {payload.get('runtime_backend_type') or RUNTIME_BACKEND_TYPE}")
        if payload.get("registry_warning"):
            print(f"registry_warning: {payload.get('registry_warning')}")
        print("Summary:")
        if scoped["summary"]:
            for key, count in scoped["summary"].items():
                print(f"  {key}: {count}")
        else:
            print("  tasks: 0")
        if scoped["locks"]:
            print("\nLocks:")
            for item in scoped["locks"]:
                print(f"  {format_lock_diagnosis_line(item)} path={item.get('path')}")
        else:
            print("\nLocks: none")
        lock_diag = scoped.get("lock_diagnosis", {}) if isinstance(scoped.get("lock_diagnosis"), dict) else {}
        print(f"lock_diagnosis: {lock_diag.get('counts', {})}")
        print(f"lock_blocking_count: {lock_diag.get('blocking_count', 0)}")
        print(f"lock_recoverable_count: {lock_diag.get('recoverable_count', 0)}")
        latest = scoped.get("latest") or {}
        if latest:
            latest_tasks = latest.get("tasks", []) if isinstance(latest.get("tasks"), list) else []
            latest_task = latest_tasks[0] if latest_tasks else {}
            print("\nLatest:")
            print(f"  run: {latest.get('run_id') or '-'}")
            print(f"  summary_state: {latest.get('summary_state') or '-'}")
            print(f"  truth_state: {latest_task.get('protocol_terminal_state') or latest_task.get('status') or '-'}")
            print(f"  pending_after_timeout: {str(bool(latest.get('pending_after_timeout'))).lower()}")
            print(f"  needs_settle: {str(bool(latest.get('needs_settle'))).lower()}")
            print(f"  runtime_snapshot_ok: {str(bool(latest.get('runtime_snapshot_ok'))).lower()}")
            print(f"  runtime_snapshot_status: {latest.get('runtime_snapshot_status') or '-'}")
            print(f"  runtime_snapshot_backend_type: {latest.get('runtime_snapshot_backend_type') or '-'}")
            print(f"  runtime_observation_ok: {str(bool(latest.get('runtime_observation_ok'))).lower()}")
            print(f"  runtime_observation_status: {latest.get('runtime_observation_status') or '-'}")
            print(f"  runtime_observation_readiness: {latest.get('runtime_observation_readiness') or '-'}")
            print(f"  runtime_observation_backend_type: {latest.get('runtime_observation_backend_type') or '-'}")
            print(f"  runtime_observation_pane_id: {latest.get('runtime_observation_pane_id') or '-'}")
            if latest.get("recommended_settle_command"):
                print(f"  recommended_settle_command: {latest.get('recommended_settle_command')}")
        else:
            print("\nLatest:\n  none")
        print(f"\nWatcher alerts for worker: {scoped.get('alert_count', 0)}")
        if scoped.get("alerts"):
            for alert in scoped["alerts"]:
                wid = alert.get("worker_id") or alert.get("inferred_worker_id") or "-"
                print(f"  {wid} {alert.get('type','-')} run={alert.get('run','-')} task={alert.get('task','-')} {alert.get('message','')}")
        registered = payload.get("registered_workers", {})
        print(
            "\nRegistered worker inventory: "
            f"present={str(bool(registered.get('present'))).lower()} "
            f"valid={str(bool(registered.get('registry_valid'))).lower()} "
            f"count={registered.get('worker_count', 0)}"
        )
        print("registered_worker_inventory_scope: non-visible inventory; separate from dispatchable visible workers")
        registry_qualified_ids = worker_ids_from_values(
            payload.get("registry_qualified_visible_workers")
        )
        print(f"registry_qualified_visible_worker_count: {len(registry_qualified_ids)}")
        print(f"registry_qualified_visible_workers: {', '.join(registry_qualified_ids) or '-'}")
        dispatchable_ids = worker_ids_from_values(
            payload.get("dispatchable_visible_workers")
        )
        print(f"dispatchable_visible_worker_count: {len(dispatchable_ids)}")
        print(f"dispatchable_visible_workers: {', '.join(dispatchable_ids) or '-'}")
        rebind_required_ids = worker_ids_from_values(
            payload.get("requires_manual_rebind_workers")
        )
        print(f"requires_manual_rebind_worker_count: {len(rebind_required_ids)}")
        print(f"requires_manual_rebind_workers: {', '.join(rebind_required_ids) or '-'}")
        unknown_rebind_ids = worker_ids_from_values(
            payload.get("rebind_check_unknown_workers")
        )
        print(f"rebind_check_unknown_worker_count: {len(unknown_rebind_ids)}")
        print(f"rebind_check_unknown_workers: {', '.join(unknown_rebind_ids) or '-'}")
        profile = payload.get("authorization_profile_summary", {})
        print(
            "authorization_profile: "
            f"business_readonly={profile.get('default_business_readonly_review_profile') or '-'} "
            f"scoped_write_enabled={str(bool(profile.get('business_scoped_write_profile_enabled'))).lower()} "
            f"valid={str(bool(profile.get('profile_valid'))).lower()} "
            f"live_requires_explicit_allow={str(bool(profile.get('live_requires_explicit_allow'))).lower()}"
        )
        print("")
        for line in format_opencode_mixed_status_human(payload.get("opencode_mixed_status", {})):
            print(line)
        print("\nTasks:")
        if not scoped["tasks"]:
            print("  none")
            return 0
        print("STATUS             RUN                         TASK      WORKER       REPORT  UPDATED")
        for item in scoped["tasks"]:
            print(
                f"{item['status']:<18} {item['run']:<27} {item['task']:<9} "
                f"{item.get('owner',''):<12} {item.get('report_bytes', 0):<7} {item.get('updated_at','')}"
            )
        return 0
    if show_all_workers:
        print("status_scope: all_workers")
        print(f"runtime_backend: {payload.get('runtime_backend') or RUNTIME_BACKEND}")
        print(f"runtime_backend_type: {payload.get('runtime_backend_type') or RUNTIME_BACKEND_TYPE}")
        if payload.get("registry_warning"):
            print(f"registry_warning: {payload.get('registry_warning')}")
        actionable_payloads, hidden_payloads = partition_status_payloads_for_human(payload.get("workers", []), worker_inventory)
        print(f"actionable_worker_count: {len(actionable_payloads)}")
        print(f"hidden_non_actionable_worker_count: {len(hidden_payloads)}")
        for scoped in actionable_payloads:
            print("")
            print(f"worker_id: {scoped.get('worker_id')}")
            print(f"  alerts: {scoped.get('alert_count', 0)}")
            print(f"  locks: {len(scoped.get('locks', []))}")
            lock_diag = scoped.get("lock_diagnosis", {}) if isinstance(scoped.get("lock_diagnosis"), dict) else {}
            print(f"  lock_diagnosis: {lock_diag.get('counts', {})}")
            print(f"  latest_run: {scoped.get('latest', {}).get('run_id') or '-'}")
            print(f"  latest_state: {((scoped.get('latest', {}).get('tasks') or [{}])[0]).get('status', '-')}")
            print(f"  summary: {scoped.get('summary', {})}")
        if hidden_payloads:
            print("")
            print(
                "hidden_non_actionable_workers: "
                + (", ".join(str(item.get("worker_id") or "-") for item in hidden_payloads) or "-")
            )
        registered = payload.get("registered_workers", {})
        print("")
        print(
            "registered_worker_inventory: "
            f"present={str(bool(registered.get('present'))).lower()} "
            f"valid={str(bool(registered.get('registry_valid'))).lower()} "
            f"count={registered.get('worker_count', 0)}"
        )
        print("registered_worker_inventory_scope: non-visible inventory; separate from dispatchable visible workers")
        dispatchable_ids = [str(item.get("worker_id") or "") for item in payload.get("dispatchable_visible_workers", [])]
        print(f"dispatchable_visible_worker_count: {len(dispatchable_ids)}")
        print(f"dispatchable_visible_workers: {', '.join(dispatchable_ids) or '-'}")
        print("dispatchable_visible_worker_scope: rebind-ready only; registry-qualified workers requiring rebind are listed separately")
        print("recommended_entry: status")
        print("recommended_scale: run_one")
        profile = payload.get("authorization_profile_summary", {})
        print(
            "authorization_profile: "
            f"business_readonly={profile.get('default_business_readonly_review_profile') or '-'} "
            f"scoped_write_enabled={str(bool(profile.get('business_scoped_write_profile_enabled'))).lower()} "
            f"valid={str(bool(profile.get('profile_valid'))).lower()} "
            f"live_requires_explicit_allow={str(bool(profile.get('live_requires_explicit_allow'))).lower()}"
        )
        print("")
        actionable_ids = {str(item.get("worker_id") or "") for item in actionable_payloads if str(item.get("worker_id") or "")}
        filtered_mixed_status, hidden_mixed_workers = filter_mixed_status_for_actionable(payload.get("opencode_mixed_status", {}), actionable_ids)
        for line in format_opencode_mixed_status_human(filtered_mixed_status):
            print(line)
        if hidden_mixed_workers:
            print("hidden_non_actionable_mixed_workers: " + ", ".join(hidden_mixed_workers))
        return 0
    print(f"runtime_backend: {payload.get('runtime_backend') or RUNTIME_BACKEND}")
    print(f"runtime_backend_type: {payload.get('runtime_backend_type') or RUNTIME_BACKEND_TYPE}")
    if payload.get("registry_warning"):
        print(f"registry_warning: {payload.get('registry_warning')}")
    print(f"visible_runs: {payload['visible_runs_root']}")
    if payload.get("pool_readiness_included"):
        print(
            "status_scope: global (dispatchable-pool-first); "
            "use --worker for one worker, --all-workers for per-worker detail, "
            "or --json for full history"
        )
    else:
        print(
            "status_scope: global (registry-first); use --worker for one "
            "worker or --include-pool-readiness for bounded pool telemetry"
        )
    print(f"pool_snapshot_mode: {payload.get('pool_snapshot_mode') or '-'}")
    default_worker = payload.get("default_worker", {})
    print(f"default_worker: {default_worker.get('worker_id') or '-'}")
    print(f"default_worker_state: {payload.get('default_worker_state') or '-'}")
    stale_default_worker = payload.get("stale_default_worker", {})
    if isinstance(stale_default_worker, dict) and stale_default_worker:
        print(
            "stale_default_worker: "
            f"{stale_default_worker.get('worker_id') or '-'}"
        )
        print(
            "stale_default_rebind_status: "
            f"{stale_default_worker.get('rebind_status') or '-'}"
        )
    print("Summary:")
    if payload["summary"]:
        for key, count in payload["summary"].items():
            print(f"  {key}: {count}")
    else:
        print("  tasks: 0")
    ready_pool_rows, rebind_required_rows = split_pool_rows_by_rebind(pool_rows)
    print("\nCurrent dispatchable pool:")
    print(f"  count: {len(ready_pool_rows)}")
    if ready_pool_rows:
        for row in ready_pool_rows:
            print("  - " + format_pool_status_line(row))
            if row.get("latest_pending_after_timeout") or row.get("latest_needs_settle"):
                print(
                    "    "
                    f"pending_after_timeout={str(bool(row.get('latest_pending_after_timeout'))).lower()} "
                    f"needs_settle={str(bool(row.get('latest_needs_settle'))).lower()}"
                )
    else:
        print("  none")
    if rebind_required_rows:
        print("\nRequires manual rebind:")
        print(f"  count: {len(rebind_required_rows)}")
        for row in rebind_required_rows:
            print("  - " + format_pool_status_line(row, include_rebind=True))
    unknown_rebind_rows = [
        row
        for row in pool_rows
        if normalized_pool_dispatch_state(row) == "rebind_check_unknown"
    ]
    if unknown_rebind_rows:
        print("\nRebind readiness unknown:")
        print(f"  count: {len(unknown_rebind_rows)}")
        for row in unknown_rebind_rows:
            print("  - " + format_pool_status_line(row, include_rebind=True))
    if locks:
        print("\nActive locks:")
        for item in locks:
            print(f"  {format_lock_diagnosis_line(item)} path={item.get('path')}")
    else:
        print("\nActive locks: none")
    lock_diag = payload.get("lock_diagnosis", {}) if isinstance(payload.get("lock_diagnosis"), dict) else {}
    print(f"lock_diagnosis: {lock_diag.get('counts', {})}")
    print(f"lock_blocking_count: {lock_diag.get('blocking_count', 0)}")
    print(f"lock_recoverable_count: {lock_diag.get('recoverable_count', 0)}")
    print("\nWatcher:")
    if watcher:
        print(f"  path: {rel(watcher_board_path(root), root)}")
        print(f"  generated_at: {watcher.get('generated_at', '-')}")
        summary = watcher.get("summary", {})
        if summary:
            print("  summary: " + ", ".join(f"{key}={value}" for key, value in summary.items()))
        else:
            print("  summary: tasks=0")
        print(f"  alerts: {watcher.get('alert_count', 0)}")
        print(f"  snapshot_stale: {str(bool(watcher_snapshot.get('snapshot_stale'))).lower()}")
        print(f"  current_lock_count: {watcher_snapshot.get('current_lock_count', 0)}")
        print(f"  watcher_active_lock_count: {watcher_snapshot.get('watcher_active_lock_count', 0)}")
        if watcher_snapshot.get("conflict"):
            print(f"  conflict: {watcher_snapshot.get('conflict')}")
            print(f"  prefer: {watcher_snapshot.get('prefer')}")
    else:
        print(f"  absent: run {rel(watcher_path(root), root)} once --root .")
    registered = payload.get("registered_workers", {})
    print("\nRegistered worker inventory:")
    print(f"  present: {str(bool(registered.get('present'))).lower()}")
    print(f"  registry_valid: {str(bool(registered.get('registry_valid'))).lower()}")
    print(f"  worker_count: {registered.get('worker_count', 0)}")
    print("  scope: non-visible inventory; separate from dispatchable visible workers")
    registry_qualified_ids = worker_ids_from_values(
        payload.get("registry_qualified_visible_workers")
    )
    dispatchable_ids = [str(item.get("worker_id") or "") for item in ready_pool_rows if str(item.get("worker_id") or "")]
    rebind_required_ids = [str(item.get("worker_id") or "") for item in rebind_required_rows if str(item.get("worker_id") or "")]
    print(f"registry_qualified_visible_worker_count: {len(registry_qualified_ids)}")
    print(f"registry_qualified_visible_workers: {', '.join(registry_qualified_ids) or '-'}")
    print(f"dispatchable_visible_worker_count: {len(dispatchable_ids)}")
    print(f"dispatchable_visible_workers: {', '.join(dispatchable_ids) or '-'}")
    print(f"requires_manual_rebind_worker_count: {len(rebind_required_ids)}")
    print(f"requires_manual_rebind_workers: {', '.join(rebind_required_ids) or '-'}")
    unknown_rebind_ids = worker_ids_from_values(
        payload.get("rebind_check_unknown_workers")
    )
    print(f"rebind_check_unknown_worker_count: {len(unknown_rebind_ids)}")
    print(f"rebind_check_unknown_workers: {', '.join(unknown_rebind_ids) or '-'}")
    print("dispatchable_visible_worker_scope: rebind-ready only; registry-qualified workers requiring rebind are listed separately")
    for worker in registered.get("workers", []):
        print(
            "  - "
            f"{worker.get('worker_id') or '-'} backend={worker.get('backend_kind') or '-'} "
            f"business_ready={str(bool(worker.get('business_ready'))).lower()} "
            f"mixed_ready={str(bool(worker.get('mixed_ready'))).lower()} "
            f"last_smoke_ok={str(bool(worker.get('last_smoke_ok'))).lower()}"
        )
    print("")
    for line in format_opencode_mixed_status_human(payload.get("opencode_mixed_status", {})):
        print(line)
    latest = latest_visible_run(root)
    if latest:
        latest_tasks = latest.get("tasks", []) if isinstance(latest.get("tasks"), list) else []
        latest_task = latest_tasks[0] if latest_tasks else {}
        print("\nLatest:")
        print(f"  run: {latest.get('run_id') or '-'}")
        print(f"  summary_state: {latest.get('summary_state') or '-'}")
        print(f"  truth_state: {latest_task.get('protocol_terminal_state') or latest_task.get('status') or '-'}")
        print(f"  pending_after_timeout: {str(bool(latest.get('pending_after_timeout'))).lower()}")
        print(f"  needs_settle: {str(bool(latest.get('needs_settle'))).lower()}")
        print(f"  runtime_snapshot_ok: {str(bool(latest.get('runtime_snapshot_ok'))).lower()}")
        print(f"  runtime_snapshot_status: {latest.get('runtime_snapshot_status') or '-'}")
        print(f"  runtime_snapshot_backend_type: {latest.get('runtime_snapshot_backend_type') or '-'}")
        print(f"  runtime_observation_ok: {str(bool(latest.get('runtime_observation_ok'))).lower()}")
        print(f"  runtime_observation_status: {latest.get('runtime_observation_status') or '-'}")
        print(f"  runtime_observation_readiness: {latest.get('runtime_observation_readiness') or '-'}")
        print(f"  runtime_observation_backend_type: {latest.get('runtime_observation_backend_type') or '-'}")
        print(f"  runtime_observation_pane_id: {latest.get('runtime_observation_pane_id') or '-'}")
        if latest.get("recommended_settle_command"):
            print(f"  recommended_settle_command: {latest.get('recommended_settle_command')}")
    print("\nHistory:")
    print(f"  global_task_count: {len(tasks)}")
    print("  hidden_by_default: true")
    print("  use: --worker <id> for one worker, --all-workers for per-worker detail, or --json for full task inventory")
    return 0


def command_locks(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    payload = lock_doctor_payload(
        root,
        worker_id=getattr(args, "worker", None),
        backend=getattr(args, "backend", RUNTIME_BACKEND),
        include_pool_readiness=bool(
            getattr(args, "include_pool_readiness", False)
        ),
    )
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
        return 0 if payload.get("lock_doctor") == "OK" else 1

    print(f"lock_doctor: {payload.get('lock_doctor')}")
    print(f"lock_scope: {payload.get('lock_scope') or 'global'}")
    print(f"pool_snapshot_mode: {payload.get('pool_snapshot_mode') or '-'}")
    print(
        "pool_readiness_included: "
        f"{str(bool(payload.get('pool_readiness_included'))).lower()}"
    )
    print(f"global_lock_count: {payload.get('global_lock_count', len(payload.get('locks', [])))}")
    print(f"global_mutation_allowed: {str(bool(payload.get('global_mutation_allowed'))).lower()}")
    if payload.get("worker_id"):
        print(f"target_worker_lock_count: {payload.get('target_worker_lock_count', 0)}")
        print(
            "target_session_rebind_allowed: "
            f"{str(bool(payload.get('target_session_rebind_allowed'))).lower()}"
        )
        print(f"unrelated_lock_count: {payload.get('unrelated_lock_count', 0)}")
        print(f"unrelated_locked_workers: {', '.join(payload.get('unrelated_locked_workers', [])) or '-'}")
        target_available = payload.get("target_worker_available_for_dispatch")
        print(
            "target_worker_available_for_dispatch: "
            f"{str(bool(target_available)).lower() if target_available is not None else 'unknown'}"
        )
    print(f"runtime_backend: {payload.get('runtime_backend') or RUNTIME_BACKEND}")
    print(
        "global_pool_snapshot_timed_out: "
        f"{str(bool(payload.get('global_pool_snapshot_timed_out'))).lower()}"
    )
    print(
        "global_pool_timed_out_workers: "
        f"{', '.join(payload.get('global_pool_timed_out_workers', [])) or '-'}"
    )
    print(
        "pool_rebind_check_skipped_workers: "
        f"{', '.join(payload.get('pool_rebind_check_skipped_workers', [])) or '-'}"
    )
    print(f"registry_qualified_visible_worker_count: {payload.get('registry_qualified_visible_worker_count', 0)}")
    print(f"registry_qualified_visible_workers: {', '.join(payload.get('registry_qualified_visible_workers', [])) or '-'}")
    print(f"dispatchable_visible_worker_count: {payload.get('dispatchable_visible_worker_count', 0)}")
    print(f"dispatchable_visible_workers: {', '.join(payload.get('dispatchable_visible_workers', [])) or '-'}")
    print(f"requires_manual_rebind_worker_count: {payload.get('requires_manual_rebind_worker_count', 0)}")
    print(f"requires_manual_rebind_workers: {', '.join(payload.get('requires_manual_rebind_workers', [])) or '-'}")
    print(f"rebind_check_unknown_worker_count: {payload.get('rebind_check_unknown_worker_count', 0)}")
    print(f"rebind_check_unknown_workers: {', '.join(payload.get('rebind_check_unknown_workers', [])) or '-'}")
    print(f"available_worker_count: {payload.get('available_worker_count', 0)}")
    print(f"available_workers: {', '.join(payload.get('available_workers', [])) or '-'}")
    print(f"fanout2_available: {str(bool(payload.get('fanout2_available'))).lower()}")
    print(f"fanout3_available: {str(bool(payload.get('fanout3_available'))).lower()}")
    print(f"fanout4_available: {str(bool(payload.get('fanout4_available'))).lower()}")
    print(f"blocked_workers: {', '.join(payload.get('blocked_workers', [])) or '-'}")
    print(f"recoverable_workers: {', '.join(payload.get('recoverable_workers', [])) or '-'}")
    diagnosis = payload.get("lock_diagnosis", {}) if isinstance(payload.get("lock_diagnosis"), dict) else {}
    print(f"lock_diagnosis: {diagnosis.get('counts', {})}")
    if payload.get("registry_warning"):
        print(f"registry_warning: {payload.get('registry_warning')}")
    print("")
    if payload.get("locks"):
        print("Locks:")
        for item in payload["locks"]:
            print(f"  {format_lock_diagnosis_line(item)} path={item.get('path')}")
    else:
        print("Locks: none")
    print("")
    if payload.get("recommended_commands"):
        print("Recommended commands:")
        for command in payload["recommended_commands"]:
            print(f"  {command}")
    else:
        print("Recommended commands: none")
    return 0 if payload.get("lock_doctor") == "OK" else 1


def _control_line_value(value: Any, *, default: str = "-") -> str:
    text = " ".join(
        line.strip()
        for line in str(value or "").splitlines()
        if line.strip()
    )
    return text or default


SEMANTIC_REVIEW_FIELD_KEYS = (
    "worker_role",
    "semantic_status",
    "semantic_reason",
    "retry_scope",
    "rerun_summarizer",
)


def command_collect(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    tdir = task_dir(root, args.run, args.task)
    truth = task_truth(root, args.run, args.task)
    backend, backend_type = recorded_runtime_backend(
        root,
        args.run,
        args.task,
        fallback_backend=getattr(args, "backend", RUNTIME_BACKEND),
    )
    delivery = read_json(tdir / "delivery.json")
    semantic_review = read_json(tdir / "semantic_review.json")
    task_metadata = read_json(tdir / "task.json")
    compact = bool(getattr(args, "compact", False))
    task_md = "" if compact else read_text(tdir / "task.md").strip()
    report = read_text(tdir / "report.md").strip()
    task_contract = task_metadata.get("task_contract") if isinstance(task_metadata.get("task_contract"), dict) else {}
    report_contract_validation = validate_task_contract(task_contract, report)
    if report_contract_validation.get("configured"):
        write_json(tdir / "report_contract_validation.json", report_contract_validation)
    semantic_review_lines: list[str] = []
    if semantic_review:
        semantic_review_lines = [
            f"semantic_review: {rel(tdir / 'semantic_review.json', root)}",
            f"worker_role: {_control_line_value(semantic_review.get('worker_role'))}",
            f"semantic_status: {_control_line_value(semantic_review.get('semantic_status'))}",
            f"semantic_reason: {_control_line_value(semantic_review.get('semantic_reason'))}",
            f"retry_scope: {_control_line_value(semantic_review.get('retry_scope'))}",
        ]
        rerun_summarizer = semantic_review.get("rerun_summarizer")
        semantic_review_lines.append(
            f"rerun_summarizer: {str(rerun_summarizer).lower()}"
            if isinstance(rerun_summarizer, bool)
            else "rerun_summarizer: -"
        )
        if not any(key in semantic_review for key in SEMANTIC_REVIEW_FIELD_KEYS):
            semantic_review_lines.append(
                "semantic_review_warning: present but no recognized keys "
                f"(expected {'/'.join(SEMANTIC_REVIEW_FIELD_KEYS)})"
            )
    report_contract_lines: list[str] = []
    if report_contract_validation.get("configured"):
        errors = report_contract_validation.get("errors", [])
        rendered_errors = ",".join(
            rendered
            for item in errors
            if (rendered := _control_line_value(item, default=""))
        )
        report_contract_lines = [
            f"report_contract_validation: {rel(tdir / 'report_contract_validation.json', root)}",
            f"report_contract_status: {_control_line_value(report_contract_validation.get('semantic_status'))}",
            f"report_contract_reason: {_control_line_value(report_contract_validation.get('semantic_reason'))}",
            f"report_contract_retry_scope: {_control_line_value(report_contract_validation.get('retry_scope'))}",
            f"report_contract_errors: {rendered_errors or '-'}",
        ]
    post_terminal_readiness: dict[str, Any] = {}
    provider_readiness: dict[str, Any] = {}
    runtime_observation: dict[str, Any] = {}
    runtime_snapshot: dict[str, Any] = {}
    owner = str(truth.get("owner") or "")
    if truth["protocol_terminal_state"] in VALID_TERMINAL_STATES:
        post_terminal_readiness = record_post_terminal_readiness(root, args.run, args.task, owner, append_busy_event=False)
        provider_readiness = post_terminal_readiness
        runtime_observation = record_runtime_observation(root, args.run, args.task, owner, backend)
        runtime_snapshot = runtime_snapshot_from_observation(runtime_observation)
    elif owner:
        try:
            collect_worker = worker_record(root, owner)
        except DispatchError:
            collect_worker = {}
        if str(collect_worker.get("backend") or "") == "codex_tui":
            provider_readiness = load_codex_adapter_module(
                root
            ).observe_thread_status(root, owner)
        else:
            provider_readiness = tui_readiness(root, owner)
    provider_error: dict[str, Any] = {}
    if (
        owner
        and (
            truth["protocol_terminal_state"] not in VALID_TERMINAL_STATES
            or bool(_session_ids_from_readiness(provider_readiness))
        )
    ):
        provider_error = record_provider_error_observation(
            root,
            args.run,
            args.task,
            owner,
            readiness=provider_readiness,
        )
        if provider_error.get("detected"):
            truth = task_truth(root, args.run, args.task)
    print(f"runtime_backend: {backend}")
    print(f"runtime_backend_type: {backend_type}")
    print(f"run: {args.run}")
    print(f"task: {args.task}")
    print(f"path: {rel(tdir, root)}")
    print(f"task_path: {rel(tdir / 'task.md', root)}")
    print(f"report_path: {rel(tdir / 'report.md', root)}")
    print(f"status: {truth['protocol_terminal_state']}")
    print(f"reason: {truth['state_reason']}")
    print(f"owner: {truth.get('owner') or '-'}")
    print(f"backend: {truth.get('backend') or '-'}")
    print(f"markers: {','.join(truth['flow_markers'] + truth['terminal_markers']) or '-'}")
    terminal_markers = [
        value if value.startswith(".") else f".{value}"
        for value in truth["terminal_markers"]
    ]
    print(f"terminal_markers: {','.join(terminal_markers) or '-'}")
    print(f"report_present: {str((tdir / 'report.md').is_file()).lower()}")
    print(f"report_non_empty: {str(bool(truth.get('report_nonempty'))).lower()}")
    print(f"report_bytes: {truth['report_bytes']}")
    print(f"lock_state: {truth.get('lock_state') or 'none'}")
    print(f"previous_summary_state: {truth.get('previous_summary_state') or '-'}")
    if post_terminal_readiness:
        print(f"post_terminal_tui_readiness: {post_terminal_readiness.get('readiness')}")
        print(f"session_status_summary: {post_terminal_readiness.get('session_status_summary', {})}")
        if post_terminal_readiness.get("readiness") == "busy":
            print("warning: post_terminal_tui_busy")
    if runtime_snapshot:
        print(f"runtime_snapshot_ok: {str(bool(runtime_snapshot.get('ok'))).lower()}")
        print(f"runtime_snapshot_status: {runtime_snapshot.get('status') or '-'}")
        print(f"runtime_snapshot_backend_type: {runtime_snapshot.get('backend_type') or '-'}")
    if runtime_observation:
        print(f"runtime_observation_ok: {str(bool(runtime_observation.get('ok'))).lower()}")
        print(f"runtime_observation_status: {runtime_observation.get('status') or '-'}")
        print(f"runtime_observation_readiness: {runtime_observation.get('readiness') or '-'}")
        print(f"runtime_observation_backend_type: {runtime_observation.get('backend_type') or '-'}")
        print(f"runtime_observation_pane_id: {runtime_observation.get('pane_id') or '-'}")
    if provider_error.get("detected"):
        print(f"provider_error: {provider_error.get('kind')}")
        print(f"provider_error_retryable: {str(bool(provider_error.get('retryable'))).lower()}")
        if provider_error.get("request_id"):
            print(f"provider_error_request_id: {provider_error.get('request_id')}")
        print(
            "provider_error_observation: "
            f"{rel(tdir / 'provider_error_observation.json', root)}"
        )
    print(f"delivery: {rel(tdir / 'delivery.json', root) if delivery else '-'}")
    if delivery:
        responses = delivery.get("responses", {})
        for endpoint in ("/tui/clear-prompt", "/tui/append-prompt", "/tui/submit-prompt"):
            if endpoint in responses:
                print(f"{endpoint}: {responses[endpoint].get('status')}")
    for line in semantic_review_lines + report_contract_lines:
        print(line)
    if compact:
        print("projection_kind: compact_collect")
        print("\nReport:")
        excerpt = report.encode("utf-8")[:4096].decode("utf-8", errors="ignore")
        print(excerpt or "(missing report.md)")
        if excerpt != report:
            print("[report excerpt; full report at report_path]")
    else:
        print("\nTask:")
        print(task_md or "(missing task.md)")
        print("\nReport:")
        print(report or "(missing report.md)")
        print("\nSemantic Review:")
        if semantic_review_lines:
            print("\n".join(semantic_review_lines))
        else:
            print("(missing semantic_review.json)")
        if report_contract_lines:
            print("\nReport Contract:")
            print("\n".join(report_contract_lines))
    return 0 if (
        truth["protocol_terminal_state"] == "completed"
        and report_contract_validation.get("semantic_status") != "failed"
    ) else 1


def command_finalize_summary(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    backend = getattr(args, "backend", RUNTIME_BACKEND)
    run = args.run
    task = args.task
    if args.fixture and (not run or not task):
        try:
            run, task = visible_task_state.infer_single_fixture_run_task(root, args.fixture)
        except visible_task_state.TaskStateError as exc:
            raise DispatchError(str(exc)) from exc
    if not run or not task:
        raise DispatchError("finalize-summary requires --run and --task, unless --fixture contains exactly one task")
    base = visible_task_state.runs_root_for(root, args.fixture)
    runtime_backend, runtime_backend_type = recorded_runtime_backend(
        root,
        run,
        task,
        fixture=args.fixture,
        runs_root=base,
        fallback_backend=backend,
    )
    before = task_truth(root, run, task, fixture=args.fixture, runs_root=base)
    summary = finalize_summary(root, run, task, fixture=args.fixture, runs_root=base)
    print(f"runtime_backend: {runtime_backend}")
    print(f"runtime_backend_type: {runtime_backend_type}")
    print(f"run: {run}")
    print(f"task: {task}")
    print(f"protocol_terminal_state: {summary.get('protocol_terminal_state') or '-'}")
    print(f"final_protocol_terminal_state: {summary.get('final_protocol_terminal_state') or '-'}")
    print(f"previous_summary_state: {summary.get('previous_summary_state') or '-'}")
    print(f"previous_wait_result: {summary.get('previous_wait_result') or '-'}")
    print(f"previous_run_one_exit_state: {summary.get('previous_run_one_exit_state') or '-'}")
    print(f"summary_reconciled: {str(bool(summary.get('summary_reconciled'))).lower()}")
    print(f"stale_summary_detected: {str(bool(summary.get('stale_summary_detected'))).lower()}")
    print(f"terminal_marker: {summary.get('terminal_marker') or '-'}")
    print(f"report_bytes: {summary.get('report_bytes', 0)}")
    print(f"runtime_snapshot_path: {summary.get('runtime_snapshot_path') or '-'}")
    print(f"runtime_snapshot_ok: {str(bool(summary.get('runtime_snapshot_ok'))).lower()}")
    print(f"runtime_snapshot_status: {summary.get('runtime_snapshot_status') or '-'}")
    print(f"runtime_snapshot_backend_type: {summary.get('runtime_snapshot_backend_type') or '-'}")
    print(f"runtime_observation_path: {summary.get('runtime_observation_path') or '-'}")
    print(f"runtime_observation_ok: {str(bool(summary.get('runtime_observation_ok'))).lower()}")
    print(f"runtime_observation_status: {summary.get('runtime_observation_status') or '-'}")
    print(f"runtime_observation_readiness: {summary.get('runtime_observation_readiness') or '-'}")
    print(f"runtime_observation_backend_type: {summary.get('runtime_observation_backend_type') or '-'}")
    print(f"runtime_observation_pane_id: {summary.get('runtime_observation_pane_id') or '-'}")
    print(f"active_lock_before: {str(bool(summary.get('active_lock_before'))).lower()}")
    print(f"lock_terminal_stale: {str(bool(summary.get('lock_terminal_stale'))).lower()}")
    print(f"lock_archived_by_finalizer: {str(bool(summary.get('lock_archived_by_finalizer'))).lower()}")
    print(f"finalizer_timestamp: {summary.get('finalizer_timestamp') or '-'}")
    print(f"delayed_finalize_enabled: {str(bool(summary.get('delayed_finalize_enabled'))).lower()}")
    print(f"delayed_finalize_seconds: {summary.get('delayed_finalize_seconds', 0)}")
    print(f"delayed_finalize_interval: {summary.get('delayed_finalize_interval', 0)}")
    print(f"delayed_finalize_attempts: {summary.get('delayed_finalize_attempts', 0)}")
    print(f"delayed_finalize_observed_terminal: {str(bool(summary.get('delayed_finalize_observed_terminal'))).lower()}")
    print(f"delayed_finalize_terminal_state: {summary.get('delayed_finalize_terminal_state') or '-'}")
    print(f"summary_json: {summary.get('summary_json') or '-'}")
    print(f"summary_md: {summary.get('summary_md') or '-'}")
    blocked_reason = str(summary.get("lock_release_blocked_reason") or "")
    if blocked_reason:
        print(f"lock_release_blocked_reason: {blocked_reason}")
        return 1
    if before.get("lock_state") == "active_lock" and not before.get("lock_is_terminal_stale"):
        return 1
    if summary.get("protocol_terminal_state") in VALID_TERMINAL_STATES:
        return 0
    return 1


def command_settle(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    backend = getattr(args, "backend", RUNTIME_BACKEND)
    run = args.run
    task = args.task
    if args.fixture and (not run or not task):
        try:
            run, task = visible_task_state.infer_single_fixture_run_task(root, args.fixture)
        except visible_task_state.TaskStateError as exc:
            raise DispatchError(str(exc)) from exc
    if not run or not task:
        raise DispatchError("settle requires --run and --task, unless --fixture contains exactly one task")
    base = visible_task_state.runs_root_for(root, args.fixture)
    runtime_backend, runtime_backend_type = recorded_runtime_backend(
        root,
        run,
        task,
        fixture=args.fixture,
        runs_root=base,
        fallback_backend=backend,
    )
    before = task_truth(root, run, task, fixture=args.fixture, runs_root=base)
    rc, summary = settle_task(
        root,
        run,
        task,
        allow_terminal_archive=args.allow_terminal_archive,
        fixture=args.fixture,
        runs_root=base,
    )
    after = task_truth(root, run, task, fixture=args.fixture, runs_root=base)
    print(f"runtime_backend: {runtime_backend}")
    print(f"runtime_backend_type: {runtime_backend_type}")
    print(f"run: {run}")
    print(f"task: {task}")
    print(f"protocol_terminal_state: {summary.get('protocol_terminal_state') or '-'}")
    print(f"final_protocol_terminal_state: {summary.get('final_protocol_terminal_state') or '-'}")
    print(f"lock_state_before: {before.get('lock_state') or 'none'}")
    print(f"lock_state_after: {after.get('lock_state') or 'none'}")
    print(f"summary_reconciled: {str(bool(summary.get('summary_reconciled'))).lower()}")
    print(f"stale_summary_detected: {str(bool(summary.get('stale_summary_detected'))).lower()}")
    print(f"lock_archived_by_finalizer: {str(bool(summary.get('lock_archived_by_finalizer'))).lower()}")
    print(f"pending_after_timeout: {str(bool(summary.get('pending_after_timeout'))).lower()}")
    print(f"needs_settle: {str(bool(summary.get('needs_settle'))).lower()}")
    if summary.get("lock_release_blocked_reason"):
        print(f"lock_release_blocked_reason: {summary.get('lock_release_blocked_reason')}")
    print(f"recommended_settle_command: {summary.get('recommended_settle_command') or '-'}")
    print(f"next_safe_action: {summary.get('next_safe_action') or '-'}")
    print(f"summary_json: {summary.get('summary_json') or '-'}")
    print(f"summary_md: {summary.get('summary_md') or '-'}")
    return rc


def command_settle_latest(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    backend = getattr(args, "backend", RUNTIME_BACKEND)
    if not args.allow_terminal_archive:
        raise DispatchError("settle-latest requires --allow-terminal-archive")
    rc, result = settle_latest(
        root,
        allow_terminal_archive=args.allow_terminal_archive,
        worker_id=getattr(args, "worker", None),
        fixture=getattr(args, "fixture", None),
        runtime_backend=backend,
    )
    print(f"settle_scope: {result.get('settle_scope') or 'global'}")
    print(f"runtime_backend: {result.get('runtime_backend') or backend}")
    print(f"runtime_backend_type: {result.get('runtime_backend_type') or backend_type_for(backend)}")
    if result.get("settle_worker_id"):
        print(f"settle_worker_id: {result.get('settle_worker_id')}")
    elif not getattr(args, "worker", None):
        print("warning: global settle-latest is legacy; use --worker for multiworker mode")
    print(f"latest_run_id: {result.get('run_id') or '-'}")
    print(f"latest_task_id: {result.get('task_id') or '-'}")
    print(f"protocol_terminal_state: {result.get('protocol_terminal_state') or '-'}")
    print(f"lock_state_before: {result.get('lock_state_before') or 'none'}")
    print(f"lock_state_after: {result.get('lock_state_after') or 'none'}")
    print(f"summary_reconciled: {str(bool(result.get('summary_reconciled'))).lower()}")
    print(f"lock_archived_by_finalizer: {str(bool(result.get('lock_archived_by_finalizer'))).lower()}")
    print(f"pending_after_timeout: {str(bool(result.get('pending_after_timeout'))).lower()}")
    print(f"needs_settle: {str(bool(result.get('needs_settle'))).lower()}")
    print(f"recommended_settle_command: {result.get('recommended_settle_command') or '-'}")
    print(f"next_safe_action: {result.get('next_safe_action') or '-'}")
    if result.get("message"):
        print(f"message: {result.get('message')}")
    return rc


def command_release_lock(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    worker = worker_record(root, args.worker)
    worker_id = str(worker["worker_id"])
    path = lock_path(root, worker_id)
    if not path.is_file():
        print(f"lock_absent: {rel(path, root)}")
        return 0
    data = read_json(path)
    if data.get("run") != args.run or data.get("task") != args.task:
        raise DispatchError(f"lock belongs to run={data.get('run')} task={data.get('task')}, not {args.run}/{args.task}")
    truth = task_truth(root, args.run, args.task)
    if truth["protocol_terminal_state"] not in VALID_TERMINAL_STATES:
        raise DispatchError(f"refusing to release non-terminal or invalid task: {truth['protocol_terminal_state']}")
    durability = pin_terminal_authority(task_dir(root, args.run, args.task))
    if not durability.get("ok"):
        raise DispatchError(
            "refusing to release: terminal authority not durable or not accepted: "
            + str(durability.get("reason") or "")
        )
    archive = archive_lock(
        root,
        path,
        f"manual_release_{truth['protocol_terminal_state']}",
        expected=data,
    )
    print(f"lock_released: {rel(archive, root)}")
    return 0


def command_cancel_reset_recovery_reservation(
    args: argparse.Namespace,
) -> int:
    if not args.allow_unconsumed_cancel:
        raise DispatchError(
            "cancel-reset-recovery requires --allow-unconsumed-cancel"
        )
    reason = str(args.reason or "").strip()
    if not reason:
        raise DispatchError("cancel-reset-recovery requires --reason")
    reservation_id = str(args.reservation_id or "")
    try:
        parsed_reservation_id = str(uuid.UUID(reservation_id))
    except ValueError as exc:
        raise DispatchError(
            "reset recovery reservation id must be a UUID"
        ) from exc
    if parsed_reservation_id != reservation_id:
        raise DispatchError(
            "reset recovery reservation id must use canonical UUID form"
        )

    root = root_path(args.root)
    worker = worker_record(root, args.worker)
    worker_id = str(worker["worker_id"])
    target_run_root = Path(str(args.target_run_root or ""))
    if (
        not target_run_root.is_absolute()
        or ".." in target_run_root.parts
        or not target_run_root.is_dir()
        or any(
            path.is_symlink()
            for path in (target_run_root, *target_run_root.parents)
        )
    ):
        raise DispatchError(
            "reset recovery reservation target run root is invalid"
        )
    target_run_root = target_run_root.resolve()
    source_task_dir = task_dir(root, args.run, args.task)
    if source_task_dir.is_symlink() or not source_task_dir.is_dir():
        raise DispatchError("reset recovery source task is invalid")
    lock_file = lock_path(root, worker_id)

    with visible_registry_lock(root):
        if lock_file.is_symlink() or not lock_file.is_file():
            raise DispatchError(
                "reset recovery reservation lock is missing"
            )
        current = read_json(lock_file)
        expected = {
            "owner_lock_id": reservation_id,
            "worker_id": worker_id,
            "run": args.run,
            "task": args.task,
            "status": "reset_recovery_reserved",
            "target_run_root": str(target_run_root),
            "recovery_kind": "verify_only_consumed_reset",
        }
        mismatched = [
            field
            for field, value in expected.items()
            if current.get(field) != value
        ]
        reservation_fields = (
            "rotation_contract_hash",
            "expected_first_lane_id",
            "expected_first_request_hash",
            "expected_first_dispatch_hash",
            "rotation_receipt_path",
            "rotation_receipt_hash",
        )
        if mismatched or owner_lock_version(current) < 1 or any(
            not str(current.get(field) or "")
            for field in reservation_fields
        ):
            raise DispatchError(
                "reset recovery reservation lock mismatch"
                + (
                    ": " + ", ".join(mismatched)
                    if mismatched
                    else ""
                )
            )
        if any(
            current.get(field)
            for field in (
                "recovery_reservation_consumed_at",
                "recovery_consumption_sidecar",
            )
        ) or current.get("recovery_reservation_status") == "consumed":
            raise DispatchError(
                "reset recovery reservation already has consumption evidence"
            )
        if any(
            (source_task_dir / name).exists()
            or (source_task_dir / name).is_symlink()
            for name in (
                ".submitted",
                ".received",
                ".started",
                ".heartbeat",
                ".done",
                ".fail",
                ".blocked",
                "report.md",
            )
        ):
            raise DispatchError(
                "reset recovery source task has dispatch or terminal evidence"
            )
        # ponytail: O(n) scan; add an index only if run history makes this slow.
        for sidecar in sorted(
            visible_runs_root(root).glob(
                "*/tasks/task-*/"
                "reset_recovery_reservation_consumption.json"
            )
        ):
            if sidecar.is_symlink() or not is_relative_to(
                sidecar,
                visible_runs_root(root),
            ):
                raise DispatchError(
                    "reset recovery consumption evidence path is invalid"
                )
            try:
                consumption = json.loads(
                    sidecar.read_text(encoding="utf-8")
                )
            except (OSError, json.JSONDecodeError) as exc:
                raise DispatchError(
                    "reset recovery consumption evidence is unreadable"
                ) from exc
            if (
                isinstance(consumption, dict)
                and consumption.get("reservation_id") == reservation_id
            ):
                raise DispatchError(
                    "reset recovery reservation already has "
                    "consumption evidence"
                )

        archive = archive_lock(
            root,
            lock_file,
            f"cancelled_reset_recovery_reservation:{reason}",
            expected=current,
            registry_locked=True,
        )

    print(f"reservation_cancelled: {reservation_id}")
    print(f"lock_released: {rel(archive, root)}")
    return 0


def recovery_handshake_prompt(
    root: Path,
    run: str,
    task: str,
    worker_id: str,
    *,
    reviewed_replacement: bool = False,
) -> str:
    tdir = task_dir(root, run, task)
    report_path = tdir / "report.md"
    attempt_id = str(
        read_json(tdir / "acceptance_fence.json").get("attempt_id")
        or ""
    )
    reviewer_instruction = (
        "Preserve existing task artifacts and continue only the original child "
        "activity. Do not invent a new reviewer protocol. If a provider error "
        f"prevents safe completion, write a non-empty {report_path} naming the "
        "blocker, and call omx_task_signal finish --state blocked exactly once."
    )
    if reviewed_replacement:
        reviewer_instruction = (
            "Preserve all existing task artifacts. If a provider error blocks "
            f"safe completion, record that blocker in {report_path}, heartbeat if "
            "needed, then stop and leave terminal closeout to the operator."
        )
    completion_instruction = (
        "Continue only the existing task. Preserve or finish the non-empty "
        f"report at {report_path}, heartbeat if needed, then stop. Do not run "
        "the ordinary terminal signal against the immutable old session fence. "
        "Leave terminal closeout to the operator using the "
        "separate operator_recovery_closeout_command printed by the dispatcher."
        if reviewed_replacement
        else (
            "Continue only the existing task. If its work is complete, write a "
            f"non-empty report at {report_path} and call omx_task_signal finish "
            f"exactly once using the exact command already recorded in "
            f"{tdir / 'prompt.txt'}. Do not use a relative report.md "
            "precondition. Confirm exit status 0 before printing "
            "OMX_TASK_CLOSED."
        )
    )
    return f"""OMX visible task
OMX_RUN_ID={run}
OMX_TASK_ID={task}
OMX_WORKER_ID={worker_id}
OMX_ATTEMPT_ID={attempt_id}

This is the only authorized recovery handshake for the existing
OMX task {run}/{task}, owned by {worker_id}.

Do not restart or repeat the original task body. Inspect only:
{tdir}

{completion_instruction}
If work remains, heartbeat and continue the original task. Do not create a new
owner, task, or terminal marker by hand.

{reviewer_instruction}
"""


def command_recovery_handshake(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    if not args.allow_recovery:
        raise DispatchError("recovery-handshake requires --allow-recovery")
    worker = worker_record(root, args.worker)
    ensure_worker_allowed(root, worker, must_be_default=False)
    worker_id = str(worker["worker_id"])
    decision = recovery_session_decision(args, worker_id)
    tdir = task_dir(root, args.run, args.task)
    truth = task_truth(root, args.run, args.task)
    if truth.get("owner") != worker_id:
        raise DispatchError("recovery worker does not own the task")
    lock = resolve_lock(root, worker_id, auto_release_terminal=False)
    if not lock.get("active"):
        raise DispatchError("recovery-handshake requires the active owner lock")
    lock_data = lock.get("lock", {})
    if (
        lock_data.get("run") != args.run
        or lock_data.get("task") != args.task
    ):
        raise DispatchError("active lock belongs to another task")
    if lock_data.get("worker_id") not in {None, "", worker_id}:
        raise DispatchError("active lock belongs to another worker")
    if truth.get("quarantine_state") == "quarantined":
        raise DispatchError("recovery-handshake refuses a quarantined task")
    initial_state = str(
        truth.get("protocol_terminal_state") or ""
    )
    initial_provider_continuation = bool(
        initial_state == "blocked_provider_error"
        and truth.get("provider_error_continuation_eligible")
    )
    if initial_state != "running" and not initial_provider_continuation:
        raise DispatchError("recovery-handshake requires a running task")
    if not truth.get("has_submitted") or not truth.get("has_started"):
        raise DispatchError(
            "recovery-handshake requires submitted and started evidence"
        )
    if truth.get("terminal_markers"):
        raise DispatchError("recovery-handshake refuses terminal marker evidence")
    handshake_path = tdir / "recovery_handshake.json"
    if handshake_path.exists():
        raise DispatchError("recovery-handshake is one-shot per task")

    if str(worker.get("backend") or "") == "codex_tui":
        readiness = load_codex_adapter_module(root).observe_thread_status(
            root, worker_id)
    else:
        readiness = tui_readiness(root, worker_id)
    fence = read_json(tdir / "acceptance_fence.json")
    fence_session_id = str(fence.get("session_id") or "")
    session_observation: dict[str, Any] = {}
    fence_is_current = False
    if str(worker.get("backend") or "") == "codex_tui":
        if (not fence_session_id
                or fence_session_id != str(worker.get("codex_thread") or "")):
            raise DispatchError(
                "recovery-handshake codex fence session is not the bound "
                "thread; preserve the owner lock and inspect "
                "acceptance_fence.json"
            )
    elif not fence_session_id.startswith("ses_"):
        raise DispatchError(
            "recovery-handshake current fence session is missing or malformed; "
            "preserve the owner lock and inspect acceptance_fence.json"
        )
    if _current_fence_attempt_contract(tdir, fence) is None:
        raise DispatchError(
            "recovery-handshake current attempt/contract/binding evidence "
            "is insufficient; preserve the owner lock and inspect "
            "task-local fence and task records"
        )
    if _recovery_fence_identity_current(
        fence,
        tdir=tdir,
        worker=worker,
        worker_id=worker_id,
    ):
        if worker.get("backend") == "codex_tui":
            readiness = load_codex_adapter_module(root).observe_thread_status(
                root, worker_id, run=args.run, task=args.task)
            session_observation = {
                "ok": readiness.get("ok") is True,
                "status": "live_session_observed" if readiness.get("ok") else "live_session_observation_failed",
            }
        else:
            session_observation = _observe_recovery_handshake_session(
                root, worker_id, fence, backend=str(args.backend))
        if not isinstance(session_observation, dict):
            raise DispatchError(
                "recovery-handshake session observation is invalid; "
                "preserve the owner lock and inspect the current fence"
            )
        observation_status = str(session_observation.get("status") or "")
        if (
            session_observation.get("ok") is True
            and observation_status in _CURRENT_RECOVERY_SESSION_STATUSES
        ):
            fence_is_current = True
    preferred_recovery_session_id = ""
    reviewed_replacement_proof: dict[str, Any] = {}
    reviewed_drift_terms: dict[str, bool] = {}
    if fence_session_id.startswith("ses_") and not fence_is_current:
        reviewed_replacement_proof, readiness, reviewed_drift_terms = (
            _reviewed_session_drift_candidate(
                root,
                tdir,
                worker_id,
                args.backend,
            )
        )
        preferred_recovery_session_id = str(
            reviewed_replacement_proof.get("session_id") or ""
        )
        if not preferred_recovery_session_id:
            observation_status = str(session_observation.get("status") or "")
            if observation_status in {
                "known_idle_session_not_found",
                "live_session_mismatch",
                "known_idle_session_observation_failed",
                "live_session_observation_failed",
                "live_session_ambiguous",
                "invalid_expected_session_id",
                "live_session_not_observed",
            }:
                raise DispatchError(
                    _recovery_handshake_no_send_reason(observation_status)
                    + _drift_terms_suffix(reviewed_drift_terms, root, tdir)
                )
            failed_terms = _failed_drift_terms(reviewed_drift_terms)
            raise DispatchError(
                "recovery-handshake provider inspection incomplete; "
                "preserve the owner lock and retry read-only inspection; "
                f"session_observation_status={observation_status or 'not_observed'}; "
                "session-drift conditions failed: "
                + (", ".join(failed_terms) if failed_terms else "not_evaluated")
                + f"; evidence: {rel(tdir / 'acceptance_fence.json', root)}"
            )
    if str(worker.get("backend") or "") == "codex_tui":
        provider_error = {
            "source": readiness.get("source"),
            "session_ids_checked": [str(worker.get("codex_thread") or "")],
            "task_bound": readiness.get("ok") is True and fence_is_current,
            "turn_id": readiness.get("turn_id"),
            "turn_state": readiness.get("turn_state"),
            "fetch_errors": [] if readiness.get("ok") else [
                str(readiness.get("status") or "thread_read_failed")],
            "status": readiness.get("status_type") or "",
        }
    else:
        provider_error = record_provider_error_observation(
            root,
            args.run,
            args.task,
            worker_id,
            readiness=readiness,
            preferred_recovery_session_id=preferred_recovery_session_id,
        )
    checked_sessions = provider_error.get("session_ids_checked", [])
    session_inspection_complete = bool(
        provider_error.get("source")
        == "opencode_session_message_api"
        and isinstance(checked_sessions, list)
        and checked_sessions
        and provider_error.get("task_bound") is True
        and not provider_error.get("fetch_errors")
        and provider_error.get("status")
        in {
            "task_session_no_provider_error",
            "provider_error_detected",
        }
    )
    background_child_continuation_eligible = (
        visible_task_state.background_child_failure_continuation_eligible(
            provider_error
        )
    )
    background_inspection_complete = bool(
        provider_error.get("source") == "opencode_background_output"
        and background_child_continuation_eligible
        and provider_error.get("status")
        == "background_child_failure_detected"
    )
    inspection_complete = bool(
        session_inspection_complete or background_inspection_complete
        or (worker.get("backend") == "codex_tui"
            and provider_error.get("source") == "codex_appserver_thread_turn_read"
            and provider_error.get("task_bound") is True
            and provider_error.get("turn_id")
            and not provider_error.get("fetch_errors")
            and provider_error.get("status") == "idle")
    )
    if worker.get("backend") == "codex_tui":
        write_json(tdir / "provider_error_observation.json", provider_error)
    if not inspection_complete:
        session_terms = {
            "session_source_is_message_api": str(
                provider_error.get("source") or ""
            )
            == "opencode_session_message_api",
            "session_ids_checked_nonempty": isinstance(
                checked_sessions, list
            )
            and bool(checked_sessions),
            "task_bound": provider_error.get("task_bound") is True,
            "no_fetch_errors": not provider_error.get("fetch_errors"),
            "session_status_classified": str(
                provider_error.get("status") or ""
            )
            in {
                "task_session_no_provider_error",
                "provider_error_detected",
            },
        }
        background_terms = {
            "background_source_observed": str(
                provider_error.get("source") or ""
            )
            == "opencode_background_output",
            "background_continuation_eligible": (
                background_child_continuation_eligible
            ),
            "background_status_classified": str(
                provider_error.get("status") or ""
            )
            == "background_child_failure_detected",
        }
        if session_terms["session_source_is_message_api"]:
            failed_provider_terms = sorted(
                name for name, ok in session_terms.items() if not ok
            )
        elif background_terms["background_source_observed"]:
            failed_provider_terms = sorted(
                name for name, ok in background_terms.items() if not ok
            )
        else:
            failed_provider_terms = ["provider_source_observed"]
        raise DispatchError(
            "recovery-handshake provider inspection incomplete; "
            "preserve the owner lock and retry read-only inspection; "
            f"provider_observation_source={provider_error.get('source') or '-'}, "
            f"status={provider_error.get('status') or '-'}, "
            f"fetch_errors={len(provider_error.get('fetch_errors') or [])}; "
            "provider conditions failed: "
            + ", ".join(failed_provider_terms)
            + f"; evidence: {rel(tdir / 'provider_error_observation.json', root)}"
        )
    provider_continuation_eligible = bool(
        visible_task_state.provider_error_continuation_eligible(
            provider_error
        )
        or background_child_continuation_eligible
    )
    if (
        provider_error.get("task_bound")
        and provider_error.get("detected")
        and not provider_error.get("retryable")
        and (
            not provider_error.get("attempt_id")
            or provider_error.get("confirmed") is True
        )
        and not provider_continuation_eligible
    ):
        raise DispatchError(
            "recovery-handshake refuses a non-retryable provider error; "
            "preserve evidence, quarantine explicitly, then rotate the "
            "contaminated session"
        )

    prepared_at = utc_now()
    prompt_path = tdir / "recovery_handshake_prompt.txt"
    handshake = {
        "schema_version": 1,
        "status": "prepared",
        "recovery_attempt": 1,
        "prepared_at": prepared_at,
        "worker_id": worker_id,
        "run_id": args.run,
        "task_id": args.task,
        "runtime_backend": args.backend,
        "prompt_path": rel(prompt_path, root),
        "provider_error_kind": str(
            provider_error.get("kind") or ""
        ),
        "provider_error_continuation_eligible": (
            provider_continuation_eligible
        ),
        "reviewed_replacement_session_id": preferred_recovery_session_id,
        "reviewed_worker_identity": reviewed_replacement_proof.get(
            "worker_identity",
            [],
        ),
        "reviewed_owner_lock_transition": reviewed_replacement_proof.get(
            "owner_lock_transition",
            [],
        ),
        **decision,
    }
    with visible_registry_lock(root):
        current = resolve_lock(
            root,
            worker_id,
            auto_release_terminal=False,
        )
        current_lock = current.get("lock", {})
        if (
            not current.get("active")
            or current_lock.get("run") != args.run
            or current_lock.get("task") != args.task
            or owner_lock_identity(current_lock)
            != owner_lock_identity(lock_data)
            or owner_lock_version(current_lock)
            != owner_lock_version(lock_data)
        ):
            raise DispatchError(
                "active lock changed before recovery evidence"
            )
        if reviewed_replacement_proof and (
            not _reviewed_worker_identity_matches(
                reviewed_replacement_proof.get("worker_identity"),
                worker_record(root, worker_id),
            )
            or list(owner_lock_transition_fence(current_lock))
            != reviewed_replacement_proof.get("owner_lock_transition")
        ):
            raise DispatchError(
                "reviewed replacement identity changed before recovery evidence"
            )
        if (
            preferred_recovery_session_id
            and not _reviewed_session_drift_eligible(tdir)
        ):
            raise DispatchError(
                "reviewed recovery eligibility changed before recovery evidence"
            )
        current_truth = task_truth(root, args.run, args.task)
        current_state = str(
            current_truth.get("protocol_terminal_state") or ""
        )
        current_provider_continuation = bool(
            current_state == "blocked_provider_error"
            and provider_continuation_eligible
            and current_truth.get(
                "provider_error_continuation_eligible"
            )
        )
        if (
            current_lock.get("worker_id")
            not in {None, "", worker_id}
            or current_truth.get("owner") != worker_id
            or current_truth.get("quarantine_state") == "quarantined"
            or (
                current_state != "running"
                and not current_provider_continuation
            )
            or not current_truth.get("has_submitted")
            or not current_truth.get("has_started")
            or current_truth.get("terminal_markers")
        ):
            raise DispatchError(
                "task state changed before recovery evidence"
            )
        if handshake_path.exists():
            raise DispatchError(
                "recovery-handshake is one-shot per task"
            )
        write_text(
            prompt_path,
            recovery_handshake_prompt(
                root,
                args.run,
                args.task,
                worker_id,
                reviewed_replacement=bool(
                    preferred_recovery_session_id
                ),
            ),
        )
        try:
            with handshake_path.open("x", encoding="utf-8") as handle:
                json.dump(
                    handshake,
                    handle,
                    indent=2,
                    sort_keys=True,
                    ensure_ascii=False,
                )
                handle.write("\n")
        except FileExistsError as exc:
            raise DispatchError(
                "recovery-handshake is one-shot per task"
            ) from exc
    try:
        adapter = (load_codex_adapter_module(root)
                   if worker.get("backend") == "codex_tui"
                   else load_adapter_module(root))
        if preferred_recovery_session_id:
            delivery = adapter.submit_visible_recovery_runtime(
                root,
                args.run,
                args.task,
                worker_id,
                runtime_backend=args.backend,
                reviewed_replacement_session_id=(
                    preferred_recovery_session_id
                ),
            )
        else:
            delivery = adapter.submit_visible_recovery_runtime(
                root,
                args.run,
                args.task,
                worker_id,
                runtime_backend=args.backend,
            )
        if not isinstance(delivery, dict):
            raise DispatchError("recovery adapter returned invalid delivery data")
    except Exception as exc:
        failed = {
            **handshake,
            "status": "submission_failed",
            "failed_at": utc_now(),
            "error_class": type(exc).__name__,
        }
        write_json(handshake_path, failed)
        raise DispatchError(
            f"recovery-handshake submission failed: {type(exc).__name__}"
        ) from exc

    if delivery.get("post_delivery_session_observation_ok") is not True:
        observation_status = str(
            delivery.get("live_session_observation_status") or ""
        )
        closeout_command = str(
            delivery.get("operator_recovery_closeout_command") or ""
        ) or interrupted_recovery_command_for(
            args.run.removeprefix("visible-runs/"),
            args.task,
            "recovery_handshake_session_unverified",
        )
        unverified = {
            **handshake,
            "status": "submitted_session_unverified",
            "submitted_at": utc_now(),
            "delivery_mode": str(delivery.get("mode") or ""),
            "delivery_path": str(delivery.get("delivery_path") or ""),
            "post_delivery_session_observation_ok": False,
            "post_delivery_session_observation_status": observation_status,
            "operator_recovery_closeout_command": closeout_command,
        }
        write_json(handshake_path, unverified)
        print(f"worker_id: {worker_id}")
        print(f"run: {args.run}")
        print(f"task: {args.task}")
        print("recovery_attempt: 1")
        print(f"recovery_handshake_json: {rel(handshake_path, root)}")
        print(
            "post_delivery_session_observation_status: "
            f"{observation_status or 'unverified'}"
        )
        print(
            "recovery_session_verified: false "
            "(transport submitted; same-session recovery NOT verified)"
        )
        print(
            "operator_recovery_closeout_command: "
            f"{closeout_command}"
        )
        return 1

    submitted = {
        **handshake,
        "status": "submitted",
        "submitted_at": utc_now(),
        "delivery_mode": str(delivery.get("mode") or ""),
        "delivery_path": str(delivery.get("delivery_path") or ""),
        "operator_recovery_closeout_command": str(
            delivery.get("operator_recovery_closeout_command") or ""
        ),
    }
    write_json(handshake_path, submitted)
    print(f"worker_id: {worker_id}")
    print(f"run: {args.run}")
    print(f"task: {args.task}")
    print("recovery_attempt: 1")
    print(f"recovery_handshake_json: {rel(handshake_path, root)}")
    if submitted["operator_recovery_closeout_command"]:
        print(
            "operator_recovery_closeout_command: "
            f"{submitted['operator_recovery_closeout_command']}"
        )
    return 0


def reconcile_quarantine_summary(
    root: Path,
    run: str,
    task: str,
    quarantine: dict[str, Any],
) -> dict[str, Any]:
    run_dir = visible_runs_root(root) / run
    summary_path = run_dir / "summary.json"
    summary = read_json(summary_path)
    truth = task_truth(root, run, task)
    state = str(truth.get("protocol_terminal_state") or "")
    previous_diagnosis = str(
        quarantine.get("previous_diagnosis") or ""
    )
    next_safe_action = (
        "rotate_contaminated_worker_session"
        if (
            previous_diagnosis == "provider_error_blocked_lock"
            or quarantine.get("provider_error_quarantine_safe")
        )
        else "rebind_target_worker"
    )
    summary.update(
        {
            "schema_version": 1,
            "generated_at": utc_now(),
            "run_id": run,
            "task_id": task,
            "protocol_terminal_state": state,
            "final_protocol_terminal_state": state,
            "terminal_state": state,
            "pending_after_timeout": False,
            "needs_settle": False,
            "recommended_settle_command": "",
            "next_safe_action": next_safe_action,
            "lock_state_after_run_one": "none",
            "lock_status": {
                "active": False,
                "state": "none",
                "path": "",
            },
            "summary_reconciled": True,
            "stale_summary_detected": True,
            "quarantine_state": "quarantined",
            "quarantine_summary_reconciled": True,
            "quarantine_reason": str(
                quarantine.get("quarantine_reason") or ""
            ),
            "quarantine_diagnosis": str(
                quarantine.get("previous_diagnosis") or ""
            ),
            "quarantine_json": rel(
                task_dir(root, run, task) / "quarantine.json",
                root,
            ),
            "quarantined_lock_archive": str(
                quarantine.get("archived_lock") or ""
            ),
            "active_lock_before": True,
            "lock_terminal_stale": False,
            "lock_archived_by_finalizer": False,
            "archived_lock": "",
        }
    )
    write_json(summary_path, summary)
    write_text(
        run_dir / "summary.md",
        render_summary_markdown(summary, truth, root),
    )
    return {
        "summary_json": rel(summary_path, root),
        "summary_md": rel(run_dir / "summary.md", root),
        "protocol_terminal_state": state,
        "needs_settle": False,
        "next_safe_action": next_safe_action,
    }


def cross_boot_quarantine_identity(
    tdir: Path,
    data: dict[str, Any],
    *,
    run: str,
    task: str,
    worker_id: str,
) -> dict[str, Any]:
    fence = read_json(tdir / "acceptance_fence.json")
    current_boot = current_host_boot_id()
    identities_match = all(
        _nonempty_identity_str(data.get(lock_key)) is not None
        and data[lock_key] == fence.get(fence_key) == expected
        for lock_key, fence_key, expected in (
            ("worker_id", "worker_id", worker_id),
            ("run", "run_id", run),
            ("task", "task_id", task),
            ("instance_id", "instance_id", data.get("instance_id")),
        )
    )
    generations_match = all(
        type(data.get(key)) is int
        and data[key] > 0
        and type(fence.get(key)) is int
        and data[key] == fence[key]
        for key in ("binding_generation", "fencing_generation")
    )
    session = fence.get("session_id")
    session_shape_valid = (
        type(session) is str
        and (
            fence.get("session_fence_state") == "pending_live_observation"
            or (
                fence.get("session_fence_state") == "live_observed"
                and bool(session.strip())
            )
        )
    )
    if not all(
        (
            _nonempty_identity_str(data.get("owner_lock_id")),
            _nonempty_identity_str(data.get("host_boot_id")),
            current_boot and current_boot != data.get("host_boot_id"),
            identities_match,
            generations_match,
            session_shape_valid,
            _current_fence_attempt_contract(tdir, fence) is not None,
            read_text(tdir / "owner").strip() == worker_id,
            not any(marker(tdir, name).is_file() for name in TERMINAL_MARKERS),
        )
    ):
        raise DispatchError(
            "refusing cross-boot quarantine: old lock/fence identity incomplete or mismatched"
        )
    return {
        "lock_host_boot_id": data["host_boot_id"],
        "current_host_boot_id": current_boot,
        "acceptance_fence": fence,
    }


def command_quarantine_lock(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    if not args.allow_nonterminal_quarantine:
        raise DispatchError("quarantine-lock requires --allow-nonterminal-quarantine")
    reason = str(args.reason or "").strip()
    if not reason:
        raise DispatchError("quarantine-lock requires --reason")
    worker = worker_record(root, args.worker)
    worker_id = str(worker["worker_id"])
    path = lock_path(root, worker_id)
    if not path.is_file():
        raise DispatchError(f"lock absent: {rel(path, root)}")
    data = read_json(path)
    if data.get("run") != args.run or data.get("task") != args.task:
        raise DispatchError(f"lock belongs to run={data.get('run')} task={data.get('task')}, not {args.run}/{args.task}")
    diagnosed = diagnose_lock_item(root, {
        **data,
        "worker_id": worker_id,
        "run": args.run,
        "task": args.task,
        "path": rel(path, root),
    })
    tdir = task_dir(root, args.run, args.task)
    allowed_quarantine_diagnoses = {
        "nonterminal_heartbeat_stale",
        "started_without_heartbeat_stale",
        "nonterminal_owner_instance_gone",
    }
    diagnosis = str(diagnosed.get("diagnosis") or "")
    quarantine_basis = "stale_nonterminal_lock"
    replacement_binding_evidence: dict[str, Any] = {}
    recovery_failed_endpoint = ""
    recovery_response_count = 0
    recovery_failure_safe = False
    protocol_status = read_json(tdir / "protocol_status.json")
    recovery_handshake = read_json(tdir / "recovery_handshake.json")
    report_path = tdir / "report.md"
    report_bytes = report_path.stat().st_size if report_path.is_file() else 0
    terminal_marker_count = sum(
        1
        for marker in (".done", ".fail", ".blocked")
        if (tdir / marker).is_file()
    )
    terminal_acceptance = protocol_status.get("terminal_acceptance")
    reviewed_recovery_failure_override = bool(
        getattr(
            args,
            "allow_reviewed_recovery_failure_quarantine",
            False,
        )
    )
    reviewed_recovery_timeout_override = bool(
        getattr(
            args,
            "allow_reviewed_recovery_timeout_quarantine",
            False,
        )
    )
    reviewed_legacy_owner_absence_override = bool(
        getattr(
            args,
            "allow_reviewed_legacy_owner_absence_quarantine",
            False,
        )
    )
    reviewed_session_drift_override = bool(
            getattr(
                args,
                "allow_reviewed_session_drift_quarantine",
                False,
            )
        )
    reviewed_predelivery_rotation_override = bool(
        getattr(
            args,
            "allow_reviewed_predelivery_rotation_quarantine",
            False,
        )
    )
    reviewed_finish_refusal_safe = False
    reviewed_recovery_timeout_safe = False
    reviewed_legacy_owner_absence_safe = False
    reviewed_session_drift_safe = False
    reviewed_session_drift_session_id = ""
    reviewed_session_drift_proof: dict[str, Any] = {}
    reviewed_session_drift_terms: dict[str, bool] = {}
    reviewed_predelivery_rotation_safe = False
    predelivery_rotation_evidence: dict[str, Any] = {}
    replacement_registry_identity: list[Any] = []
    same_boot_owner_absence: dict[str, Any] = {}
    cross_boot_identity: dict[str, Any] = {}
    provider_error_quarantine_safe = False
    provider_error = read_json(
        tdir / "provider_error_observation.json"
    )
    provider_error_terminal_evidence = bool(
        visible_task_state.provider_error_quarantine_eligible(
            provider_error
        )
        and str(provider_error.get("run") or "") == args.run
        and str(provider_error.get("task") or "") == args.task
        and str(provider_error.get("worker_id") or "") == worker_id
        and report_bytes == 0
        and terminal_marker_count == 0
    )
    rotation_requirement: dict[str, Any] = {}
    recovery_timeout_owner_absence_evidence: dict[str, Any] = {}
    recovery_timeout_shape_terms: dict[str, bool] = {}
    legacy_owner_absence_evidence: dict[str, Any] = {}
    legacy_missing_boot_evidence: dict[str, Any] = {}
    legacy_replacement_binding_evidence: dict[str, Any] = {}
    legacy_replacement_registry_identity: list[Any] = []
    legacy_replacement_differs_from_lock = False
    legacy_task_eligibility: dict[str, Any] = {}
    if diagnosis == "recovery_handshake_submission_failed":
        recovery_error = read_json(
            tdir / "recovery_handshake_delivery_error.json"
        )
        recovery_failed_endpoint = str(
            recovery_error.get("failed_endpoint") or ""
        )
        responses = recovery_error.get("responses")
        recovery_response_count = (
            len(responses) if isinstance(responses, dict) else 0
        )
        recovery_failure_safe = (
            recovery_failed_endpoint
            in {
                "acceptance_fence",
                "acceptance_session_fence",
                "binding_fence",
            }
            and recovery_response_count == 0
        )
        if recovery_failure_safe:
            quarantine_basis = (
                "pre_side_effect_recovery_submission_failure"
            )
        reviewed_finish_refusal_safe = (
            reviewed_recovery_failure_override
            and str(recovery_handshake.get("status") or "")
            == "submission_failed"
            and nonnegative_int(
                recovery_handshake.get("recovery_attempt")
            )
            == 1
            and str(protocol_status.get("status") or "")
            == "finish_refused_acceptance_fence"
            and protocol_status.get("finish_refused_missing_report") is False
            and isinstance(terminal_acceptance, dict)
            and terminal_acceptance.get("accepted") is False
            and protocol_status.get("terminal_markers") == []
            and recovery_response_count == 0
            and report_bytes > 0
            and terminal_marker_count == 0
        )
        if reviewed_finish_refusal_safe:
            quarantine_basis = (
                "reviewed_finish_refusal_recovery_failure"
            )
    elif diagnosis == "recovery_handshake_stalled":
        if reviewed_recovery_timeout_override:
            recovery_timeout_owner_absence_evidence = (
                stalled_recovery_owner_absence_evidence(
                    root,
                    worker_id,
                    data,
                )
            )
        recovery_timeout_shape_terms = {
            "reviewed_timeout_override": (
                reviewed_recovery_timeout_override
            ),
            "handshake_submitted": (
                str(recovery_handshake.get("status") or "")
                == "submitted"
            ),
            "recovery_attempt_is_first": (
                nonnegative_int(
                    recovery_handshake.get("recovery_attempt")
                )
                == 1
            ),
            "handshake_timed_out": bool(
                diagnosed.get("recovery_handshake_timed_out")
            ),
            "no_fresh_progress_or_owner_absent": (
                not bool(
                    diagnosed.get("recovery_progress_after_handshake")
                )
                or bool(
                    recovery_timeout_owner_absence_evidence.get("ok")
                )
            ),
            "no_terminal_markers": terminal_marker_count == 0,
        }
        reviewed_recovery_timeout_shape = all(
            recovery_timeout_shape_terms.values()
        )
        provider_error_quarantine_safe = bool(
            reviewed_recovery_timeout_shape
            and provider_error_terminal_evidence
        )
        reviewed_recovery_timeout_safe = bool(
            reviewed_recovery_timeout_shape
            and (
                recovery_timeout_owner_absence_evidence.get("ok")
                or provider_error_quarantine_safe
            )
        )
        if reviewed_recovery_timeout_safe:
            if provider_error_quarantine_safe:
                quarantine_basis = (
                    "reviewed_recovery_timeout_provider_interruption"
                )
            else:
                quarantine_basis = "reviewed_recovery_timeout_owner_absent"
    elif diagnosis == "nonterminal_owner_instance_gone":
        current_boot = current_host_boot_id()
        if (
            current_boot
            and data.get("host_boot_id")
            and current_boot != data["host_boot_id"]
        ):
            cross_boot_identity = cross_boot_quarantine_identity(
                tdir, data, run=args.run, task=args.task, worker_id=worker_id,
            )
        else:
            if not current_boot or data.get("host_boot_id") != current_boot:
                raise DispatchError("refusing owner-gone quarantine without current host boot identity")
            replacement_binding_evidence = (
                strong_replacement_binding_evidence(root, worker_id)
            )
            if not replacement_binding_evidence.get("ok"):
                raise DispatchError(
                    "refusing reboot-stale quarantine without strong "
                    "replacement binding evidence"
                )
        live = replacement_binding_evidence.get("live", {})
        live_boot_id = str(
            live.get("host_boot_id")
            if isinstance(live, dict)
            else ""
        )
        lock_boot_id = str(data.get("host_boot_id") or "")
        live_server_pid = nonnegative_int(
            live.get("tmux_server_pid")
            if isinstance(live, dict)
            else 0
        )
        lock_server_pid = nonnegative_int(data.get("tmux_server_pid"))
        tmux_generation_mismatch = bool(
            live_boot_id
            and lock_boot_id
            and live_boot_id == lock_boot_id
            and live_server_pid > 0
            and lock_server_pid > 0
            and live_server_pid != lock_server_pid
        )
        if not (
            cross_boot_identity or tmux_generation_mismatch
        ):
            raise DispatchError(
                "refusing reboot-stale quarantine without a reviewed "
                "old/new host boot or tmux server generation mismatch"
            )
        quarantine_basis = "reboot_stale_owner_instance_gone"
    elif (
        diagnosis
        in {"active_nonterminal_lock", "active_inner_reviewer_progress"}
        and reviewed_legacy_owner_absence_override
    ):
        legacy_owner_absence_evidence = (
            stalled_recovery_owner_absence_evidence(
                root,
                worker_id,
                data,
            )
        )
        legacy_missing_boot_evidence = {}
        legacy_replacement_binding_evidence = {}
        legacy_replacement_registry_identity = []
        legacy_replacement_differs_from_lock = False
        legacy_task_eligibility = legacy_owner_absence_task_eligibility(
            root,
            tdir,
            run=args.run,
            task=args.task,
            worker_id=worker_id,
        )
        legacy_shape = bool(
            not str(data.get("host_boot_id") or "")
            and legacy_task_eligibility["eligible"]
        )
        if (
            legacy_shape
            and not legacy_owner_absence_evidence.get("ok")
        ):
            legacy_missing_boot_evidence = (
                missing_boot_owner_absence_evidence(data)
            )
            if legacy_missing_boot_evidence.get("ok"):
                legacy_replacement_binding_evidence = (
                    strong_replacement_binding_evidence(root, worker_id)
                )
                legacy_replacement_registry_identity = list(
                    _guard_worker_identity(worker)
                )
                live = legacy_replacement_binding_evidence.get("live", {})
                live = live if isinstance(live, dict) else {}
                lock_pids = set(
                    legacy_missing_boot_evidence.get(
                        "lock_process_pids"
                    )
                    or []
                )
                legacy_replacement_differs_from_lock = bool(
                    nonnegative_int(live.get("pane_pid"))
                    and nonnegative_int(
                        legacy_missing_boot_evidence.get("lock_pane_pid")
                    )
                    and nonnegative_int(live.get("pane_pid"))
                    != nonnegative_int(
                        legacy_missing_boot_evidence.get("lock_pane_pid")
                    )
                    and nonnegative_int(live.get("opencode_pid"))
                    and nonnegative_int(live.get("opencode_pid"))
                    not in lock_pids
                    and nonnegative_int(
                        legacy_missing_boot_evidence.get("lock_port")
                    )
                    and nonnegative_int(live.get("port"))
                    == nonnegative_int(
                        legacy_missing_boot_evidence.get("lock_port")
                    )
                )
        reviewed_legacy_owner_absence_safe = bool(
            legacy_shape
            and (
                legacy_owner_absence_evidence.get("ok")
                or (
                    legacy_missing_boot_evidence.get("ok")
                    and legacy_replacement_binding_evidence.get("ok")
                    and legacy_replacement_differs_from_lock
                )
            )
        )
        if reviewed_legacy_owner_absence_safe:
            quarantine_basis = "reviewed_legacy_lock_owner_absent"
    elif (
        diagnosis == "active_nonterminal_lock"
        and reviewed_predelivery_rotation_override
    ):
        predelivery_rotation_evidence = predelivery_rotation_task_eligibility(
            tdir,
            data,
            run=args.run,
            task=args.task,
            worker_id=worker_id,
        )
        if predelivery_rotation_evidence["eligible"]:
            same_boot_owner_absence = (
                same_boot_owner_absence_evidence(data)
            )
            replacement_binding_evidence = (
                strong_replacement_binding_evidence(root, worker_id)
            )
            replacement_registry_identity = list(
                _guard_worker_identity(worker)
            )
            live = replacement_binding_evidence.get("live", {})
            live = live if isinstance(live, dict) else {}
            lock_pids = set(
                same_boot_owner_absence.get("lock_process_pids") or []
            )
            live_pane_pid = nonnegative_int(live.get("pane_pid"))
            live_opencode_pid = nonnegative_int(live.get("opencode_pid"))
            live_port = nonnegative_int(live.get("port"))
            lock_pane_pid = nonnegative_int(
                same_boot_owner_absence.get("lock_pane_pid")
            )
            lock_port = nonnegative_int(
                same_boot_owner_absence.get("lock_port")
            )
            lock_opencode_pid = nonnegative_int(data.get("opencode_pid"))
            replacement_differs_from_lock = bool(
                live_pane_pid
                and lock_pane_pid
                and live_pane_pid != lock_pane_pid
                and live_opencode_pid
                and live_opencode_pid != lock_opencode_pid
                and live_opencode_pid not in lock_pids
                and live_port
                and lock_port
                and live_port == lock_port
            )
            predelivery_rotation_evidence.update(
                {
                    "replacement_differs_from_lock": (
                        replacement_differs_from_lock
                    ),
                    "live_pane_pid": live_pane_pid,
                    "live_opencode_pid": live_opencode_pid,
                    "live_port": live_port,
                }
            )
            reviewed_predelivery_rotation_safe = bool(
                same_boot_owner_absence.get("ok")
                and replacement_binding_evidence.get("ok")
                and replacement_differs_from_lock
            )
        if reviewed_predelivery_rotation_safe:
            quarantine_basis = (
                "reviewed_predelivery_rotation_owner_absent"
            )
    elif diagnosis == "provider_error_blocked_lock":
        provider_error_quarantine_safe = (
            provider_error_terminal_evidence
        )
        if provider_error_quarantine_safe:
            quarantine_basis = (
                "completed_task_bound_nonretryable_provider_error"
            )
    elif (
        diagnosis == "report_without_terminal_marker_stale"
        and reviewed_session_drift_override
    ):
        reviewed_session_drift_proof, _readiness, drift_terms = (
            _reviewed_session_drift_candidate(
                root,
                tdir,
                worker_id,
                str(data.get("runtime_backend") or RUNTIME_BACKEND),
            )
        )
        reviewed_session_drift_terms.update(drift_terms)
        reviewed_session_drift_session_id = str(
            reviewed_session_drift_proof.get("session_id") or ""
        )
        reviewed_session_drift_shape = bool(
            _reviewed_session_drift_eligible(tdir)
            and reviewed_session_drift_session_id
        )
        reviewed_session_drift_safe = reviewed_session_drift_shape
        if reviewed_session_drift_safe:
            quarantine_basis = "reviewed_session_drift_finish_refusal"
    if (
        diagnosis not in allowed_quarantine_diagnoses
        and not recovery_failure_safe
        and not reviewed_finish_refusal_safe
        and not reviewed_recovery_timeout_safe
        and not reviewed_legacy_owner_absence_safe
        and not reviewed_session_drift_safe
        and not reviewed_predelivery_rotation_safe
        and not provider_error_quarantine_safe
    ):
        message = (
            f"refusing to quarantine diagnosis={diagnosed.get('diagnosis') or '-'}"
        )
        if reviewed_session_drift_override and reviewed_session_drift_terms:
            failed_drift_terms = _failed_drift_terms(
                reviewed_session_drift_terms
            )
            if failed_drift_terms:
                message += (
                    "; session-drift conditions failed: "
                    + ", ".join(failed_drift_terms)
                )
        if reviewed_recovery_timeout_override and recovery_timeout_shape_terms:
            failed_terms = [
                name
                for name, ok in sorted(
                    recovery_timeout_shape_terms.items()
                )
                if not ok
            ]
            if failed_terms:
                message += (
                    "; timeout-shape conditions failed: "
                    + ", ".join(failed_terms)
                )
            else:
                owner_conditions = (
                    recovery_timeout_owner_absence_evidence.get(
                        "conditions"
                    )
                )
                if isinstance(owner_conditions, dict):
                    failed_owner_terms = [
                        name
                        for name, ok in sorted(owner_conditions.items())
                        if not ok
                    ]
                    if failed_owner_terms:
                        message += (
                            "; owner-absence conditions failed: "
                            + ", ".join(failed_owner_terms)
                        )
        if (
            reviewed_legacy_owner_absence_override
            and not reviewed_legacy_owner_absence_safe
        ):
            legacy_conditions = legacy_missing_boot_evidence.get(
                "conditions"
            )
            if isinstance(legacy_conditions, dict) and not all(
                legacy_conditions.values()
            ):
                failed_legacy_terms = [
                    name
                    for name, ok in sorted(legacy_conditions.items())
                    if not ok
                ]
                if failed_legacy_terms:
                    message += (
                        "; legacy missing-boot owner-absence conditions "
                        "failed: "
                        + ", ".join(failed_legacy_terms)
                    )
            elif legacy_missing_boot_evidence.get("ok") and not (
                legacy_replacement_binding_evidence.get("ok")
                and legacy_replacement_differs_from_lock
            ):
                message += (
                    "; legacy replacement binding evidence insufficient"
                )
        raise DispatchError(message)
    with visible_registry_lock(root):
        current_lock = read_json(path)
        if cross_boot_identity:
            if current_lock != data or cross_boot_quarantine_identity(
                tdir, current_lock, run=args.run, task=args.task, worker_id=worker_id,
            ) != cross_boot_identity:
                raise DispatchError("cross-boot old lock/fence identity changed before quarantine")
        if reviewed_session_drift_proof and (
            not _reviewed_worker_identity_matches(
                reviewed_session_drift_proof.get("worker_identity"),
                worker_record(root, worker_id),
            )
            or list(owner_lock_transition_fence(current_lock))
            != reviewed_session_drift_proof.get("owner_lock_transition")
        ):
            raise DispatchError(
                "reviewed replacement identity changed before quarantine"
            )
        if (
            reviewed_session_drift_proof
            and not _reviewed_session_drift_eligible(tdir)
        ):
            raise DispatchError(
                "reviewed recovery eligibility changed before quarantine"
            )
        if (
            reviewed_predelivery_rotation_safe
            and (
                not _reviewed_worker_identity_matches(
                    replacement_registry_identity,
                    worker_record(root, worker_id),
                )
                or not predelivery_rotation_task_eligibility(
                    tdir,
                    current_lock,
                    run=args.run,
                    task=args.task,
                    worker_id=worker_id,
                )["eligible"]
            )
        ):
            raise DispatchError(
                "predelivery rotation identity or eligibility changed "
                "before quarantine"
            )
        if reviewed_legacy_owner_absence_safe:
            if legacy_replacement_binding_evidence and (
                not _reviewed_worker_identity_matches(
                    legacy_replacement_registry_identity,
                    worker_record(root, worker_id),
                )
                or not missing_boot_owner_absence_evidence(
                    current_lock
                ).get("ok")
            ):
                raise DispatchError(
                    "legacy replacement identity or owner absence "
                    "changed before quarantine"
                )
            if not legacy_owner_absence_task_eligibility(
                root,
                tdir,
                run=args.run,
                task=args.task,
                worker_id=worker_id,
            )["eligible"]:
                raise DispatchError(
                    "legacy task owner or eligibility changed before "
                    "quarantine"
                )
        archive = archive_lock(
            root,
            path,
            f"manual_quarantine_{diagnosed.get('diagnosis')}",
            expected=data,
            registry_locked=True,
        )
    if provider_error_terminal_evidence:
        rotation_requirement = read_json(
            session_rotation_requirement_path(root, worker_id)
        )
    payload = {
        "schema_version": 1,
        "quarantine_state": "quarantined",
        "quarantined_at": utc_now(),
        "worker_id": worker_id,
        "run_id": args.run,
        "task_id": args.task,
        "quarantine_reason": reason,
        "previous_diagnosis": diagnosed.get("diagnosis"),
        "previous_protocol_terminal_state": diagnosed.get("protocol_terminal_state"),
        "previous_receipt_state": diagnosed.get("receipt_state"),
        "previous_missing_protocol_evidence": diagnosed.get("missing_protocol_evidence", []),
        "safe_handling": diagnosed.get("safe_handling", ""),
        "quarantine_basis": quarantine_basis,
        "recovery_failed_endpoint": recovery_failed_endpoint,
        "recovery_response_count": recovery_response_count,
        "reviewed_recovery_failure_override": (
            reviewed_recovery_failure_override
        ),
        "reviewed_recovery_timeout_override": (
            reviewed_recovery_timeout_override
        ),
        "reviewed_legacy_owner_absence_override": (
            reviewed_legacy_owner_absence_override
        ),
        "reviewed_session_drift_override": (
            reviewed_session_drift_override
        ),
        "reviewed_session_drift_safe": reviewed_session_drift_safe,
        "reviewed_session_drift_session_id": (
            reviewed_session_drift_session_id
        ),
        "reviewed_predelivery_rotation_override": (
            reviewed_predelivery_rotation_override
        ),
        "reviewed_predelivery_rotation_safe": (
            reviewed_predelivery_rotation_safe
        ),
        "predelivery_rotation_evidence": (
            predelivery_rotation_evidence
        ),
        "same_boot_owner_absence_evidence": same_boot_owner_absence,
        "replacement_registry_identity": replacement_registry_identity,
        "provider_error_quarantine_safe": (
            provider_error_quarantine_safe
        ),
        "session_rotation_requirement": rotation_requirement,
        "recovery_timeout_owner_absence_evidence": (
            recovery_timeout_owner_absence_evidence
        ),
        "legacy_owner_absence_evidence": (
            legacy_owner_absence_evidence
        ),
        "legacy_task_eligibility": legacy_task_eligibility,
        "legacy_missing_boot_evidence": legacy_missing_boot_evidence,
        "legacy_replacement_binding_evidence": (
            legacy_replacement_binding_evidence
        ),
        "legacy_replacement_registry_identity": (
            legacy_replacement_registry_identity
        ),
        "legacy_replacement_differs_from_lock": (
            legacy_replacement_differs_from_lock
        ),
        "protocol_status": str(protocol_status.get("status") or ""),
        "report_bytes": report_bytes,
        "terminal_marker_count": terminal_marker_count,
        "replacement_binding_evidence": replacement_binding_evidence,
        "cross_boot_owner_identity": cross_boot_identity,
        "archived_lock": rel(archive, root),
    }
    write_json(tdir / "quarantine.json", payload)
    append_event(tdir / "events.jsonl", {
        "ts": payload["quarantined_at"],
        "event": "visible_task_quarantined",
        "source": "omx_visible_dispatch",
        "worker": worker_id,
        "run": args.run,
        "task": args.task,
        "diagnosis": diagnosed.get("diagnosis"),
        "archived_lock": payload["archived_lock"],
    })
    if diagnosis in {
        "nonterminal_owner_instance_gone",
        "provider_error_blocked_lock",
    } or any(
        (
            reviewed_legacy_owner_absence_safe,
            reviewed_session_drift_safe,
            reviewed_predelivery_rotation_safe,
            provider_error_quarantine_safe,
        )
    ):
        payload["summary_reconciliation"] = (
            reconcile_quarantine_summary(
                root,
                args.run,
                args.task,
                payload,
            )
        )
        write_json(tdir / "quarantine.json", payload)
    print("quarantine_state: quarantined")
    print(f"worker_id: {worker_id}")
    print(f"run: {args.run}")
    print(f"task: {args.task}")
    print(f"previous_diagnosis: {diagnosed.get('diagnosis')}")
    print(f"previous_protocol_terminal_state: {diagnosed.get('protocol_terminal_state')}")
    print(f"archived_lock: {payload['archived_lock']}")
    print(f"quarantine_json: {rel(tdir / 'quarantine.json', root)}")
    return 0


def command_demo(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    run = "demo-visible-run"
    base = visible_runs_root(root) / run
    if base.exists():
        raise DispatchError(f"demo run already exists; remove or archive manually first: {rel(base, root)}")
    create_task(root, run, "task-001", "demo-worker", "Completed visible dispatch demo", "Simulated completed task.", demo=True)
    t1 = task_dir(root, run, "task-001")
    write_text(t1 / ".submitted", utc_now() + "\n")
    write_text(t1 / ".received", utc_now() + "\n")
    write_text(t1 / ".started", utc_now() + "\n")
    write_text(t1 / "report.md", "Demo completed task report.\n")
    write_text(t1 / ".done", utc_now() + "\n")

    create_task(root, run, "task-002", "demo-worker", "Blocked visible dispatch demo", "Simulated blocked task.", demo=True)
    t2 = task_dir(root, run, "task-002")
    write_text(t2 / ".submitted", utc_now() + "\n")
    write_text(t2 / ".received", utc_now() + "\n")
    write_text(t2 / ".started", utc_now() + "\n")
    write_text(t2 / "report.md", "Demo blocked task report.\n")
    write_text(t2 / ".blocked", utc_now() + "\n")

    create_task(root, run, "task-003", "demo-worker", "Delivery uncertain visible dispatch demo", "Simulated submitted-only task.", demo=True)
    t3 = task_dir(root, run, "task-003")
    write_text(t3 / ".submitted", utc_now() + "\n")

    demo_lock = lock_path(root, "demo-worker")
    demo_lock_data = {
        "schema_version": 1,
        "owner_lock_id": str(uuid.uuid4()),
        "worker_id": "demo-worker",
        "run": run,
        "task": "task-001",
        "created_at": utc_now(),
        "pane_id": "demo",
        "port": 0,
        "status": "submitted",
    }
    write_json(demo_lock, demo_lock_data)
    archive = archive_lock(
        root,
        demo_lock,
        "demo_terminal_completed",
        expected=demo_lock_data,
    )
    print(f"demo_run: {rel(base, root)}")
    print(f"demo_lock_archive: {rel(archive, root)}")
    command_status(argparse.Namespace(root=str(root), json=False))
    return 0


def command_dry_run_resolve_worker(args: argparse.Namespace) -> int:
    root = root_path(args.root)
    fixture_dir = Path(args.fixture).resolve() if args.fixture else runtime_fixture_dir()
    backend = getattr(args, "backend", RUNTIME_BACKEND)
    backend_type = "rmux" if backend.startswith("rmux") else "tmux"
    metadata = {
        "runtime_backend": backend,
        "runtime_backend_type": backend_type,
        "rmux_default": RMUX_DEFAULT,
        "dispatch_adapter": DISPATCH_ADAPTER,
    }
    if backend == "rmux-spike":
        payload = {
            "ok": False,
            **metadata,
            "source": "explicit" if args.worker else "default",
            "requested_worker_id": args.worker or "",
            "dispatch_allowed": False,
            "errors": [f"runtime backend {backend} unsupported for visible dispatch live path"],
            "warnings": [],
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
        else:
            print(f"runtime_backend: {backend}")
            print(f"runtime_backend_type: {backend_type}")
            print(f"rmux_default: {str(RMUX_DEFAULT).lower()}")
            print(f"dispatch_adapter: {DISPATCH_ADAPTER}")
            print("dispatch_allowed: false")
            print(f"error: runtime backend {backend} unsupported for visible dispatch live path")
        return 1
    if backend == "rmux-reference":
        try:
            adapter = get_backend(backend, fixture_dir=fixture_dir)
            result = adapter.resolve_worker(root, args.worker or "")
        except Exception as exc:
            payload = {
                "ok": False,
                **metadata,
                "source": "explicit" if args.worker else "default",
                "requested_worker_id": args.worker or "",
                "dispatch_allowed": False,
                "errors": [str(exc)],
                "warnings": [],
            }
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
            else:
                print(f"runtime_backend: {backend}")
                print(f"runtime_backend_type: {backend_type}")
                print(f"rmux_default: {str(RMUX_DEFAULT).lower()}")
                print(f"dispatch_adapter: {DISPATCH_ADAPTER}")
                print("dispatch_allowed: false")
                print(f"error: {exc}")
            return 1
        payload = {
            "ok": bool(result.dispatch_allowed),
            **metadata,
            "source": "explicit" if args.worker else "default",
            "requested_worker_id": args.worker or "",
            "worker": result.worker.to_dict(),
            "dispatch_allowed": bool(result.dispatch_allowed),
            "warnings": list(result.warnings),
            "errors": list(result.errors),
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
        else:
            worker_data = result.worker.to_dict()
            print(f"runtime_backend: {backend}")
            print(f"runtime_backend_type: {backend_type}")
            print(f"rmux_default: {str(RMUX_DEFAULT).lower()}")
            print(f"dispatch_adapter: {DISPATCH_ADAPTER}")
            print(f"source: {'explicit' if args.worker else 'default'}")
            print(f"worker_id: {worker_data.get('worker_id')}")
            print(f"role: {worker_data.get('role')}")
            print(f"allow_auto_submit: {str(bool(worker_data.get('allow_auto_submit'))).lower()}")
            print(f"default_for_new_tasks: {str(bool(worker_data.get('default_for_new_tasks'))).lower()}")
            print(f"pane: {worker_data.get('pane_id') or '-'}")
            print(f"port: {worker_data.get('port') if worker_data.get('port') is not None else '-'}")
            print(f"binding_confidence: {worker_data.get('binding_confidence') or '-'}")
            print(f"dispatch_allowed: {str(bool(result.dispatch_allowed)).lower()}")
            for warning in result.warnings:
                print(f"warning: {warning}")
            for error in result.errors:
                print(f"error: {error}")
        return 0 if result.dispatch_allowed else 1
    try:
        if args.worker:
            safe_id(args.worker, "worker")
            worker = runtime_registry.resolve_worker_record(root, args.worker, fixture_dir)
            source = "explicit"
            validation = runtime_registry.validate_worker_for_dispatch(worker, must_be_default=False)
        else:
            worker = runtime_registry.resolve_default_worker(root, fixture_dir)
            source = "default"
            validation = runtime_registry.validate_worker_for_dispatch(worker, must_be_default=True)
    except RegistryError as exc:
        payload = {
            "ok": False,
            **metadata,
            "source": "explicit" if args.worker else "default",
            "requested_worker_id": args.worker or "",
            "dispatch_allowed": False,
            "errors": [str(exc)],
            "warnings": [],
        }
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
        else:
            print(f"runtime_backend: {backend}")
            print(f"runtime_backend_type: {backend_type}")
            print(f"rmux_default: {str(RMUX_DEFAULT).lower()}")
            print(f"dispatch_adapter: {DISPATCH_ADAPTER}")
            print("dispatch_allowed: false")
            print(f"error: {exc}")
        return 1

    payload = {
        "ok": bool(validation["dispatch_allowed"]),
        **metadata,
        "source": source,
        "requested_worker_id": args.worker or "",
        "worker": validation["worker"],
        "dispatch_allowed": bool(validation["dispatch_allowed"]),
        "warnings": validation["warnings"],
        "errors": validation["errors"],
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        worker_data = validation["worker"]
        print(f"runtime_backend: {backend}")
        print(f"runtime_backend_type: {backend_type}")
        print(f"rmux_default: {str(RMUX_DEFAULT).lower()}")
        print(f"dispatch_adapter: {DISPATCH_ADAPTER}")
        print(f"source: {source}")
        print(f"worker_id: {worker_data.get('worker_id')}")
        print(f"role: {worker_data.get('role')}")
        print(f"allow_auto_submit: {str(bool(worker_data.get('allow_auto_submit'))).lower()}")
        print(f"default_for_new_tasks: {str(bool(worker_data.get('default_for_new_tasks'))).lower()}")
        print(f"pane: {worker_data.get('pane_id') or '-'}")
        print(f"port: {worker_data.get('port') if worker_data.get('port') is not None else '-'}")
        print(f"binding_confidence: {worker_data.get('binding_confidence') or '-'}")
        print(f"dispatch_allowed: {str(bool(validation['dispatch_allowed'])).lower()}")
        for warning in validation["warnings"]:
            print(f"warning: {warning}")
        for error in validation["errors"]:
            print(f"error: {error}")
    return 0 if validation["dispatch_allowed"] else 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="omx_visible_dispatch",
        description=(
            "Formal high-level dispatch wrapper for a user-visible OpenCode TUI. "
            "Recommended fresh-pane order: status, doctor, then run-one when execution is needed; "
            "use health summary/check only for deeper diagnosis. "
            "Writes only .omx/framework/team/visible-runs and delegates the three allowed POSTs to omx_opencode_tui_adapter."
        ),
    )
    sub = parser.add_subparsers(dest="command", required=True)

    status = sub.add_parser("status", help="show visible-runs tasks, owner locks, and latest settle hints; supports worker-scoped views")
    status.add_argument("--root", default=".")
    status.add_argument("--backend", default=RUNTIME_BACKEND, choices=RUNTIME_BACKEND_CHOICES)
    status.add_argument("--worker")
    status.add_argument("--all-workers", action="store_true")
    status.add_argument(
        "--compact",
        action="store_true",
        help="show bounded lock and worker-pool recovery facts without task-history scans",
    )
    status.add_argument(
        "--include-pool-readiness",
        action="store_true",
        help="also run bounded rebind readiness probes for global pool telemetry",
    )
    status.add_argument("--json", action="store_true")
    status.set_defaults(func=command_status)

    locks = sub.add_parser("locks", help="diagnose visible worker locks and fanout availability without mutating locks")
    locks.add_argument("--root", default=".")
    locks.add_argument("--backend", default=RUNTIME_BACKEND, choices=RUNTIME_BACKEND_CHOICES)
    locks.add_argument("--worker")
    locks.add_argument(
        "--include-pool-readiness",
        action="store_true",
        help="also run bounded rebind readiness probes for fanout telemetry",
    )
    locks.add_argument("--json", action="store_true")
    locks.set_defaults(func=command_locks)

    doctor = sub.add_parser("doctor", help="read-only chain check for current dispatchable-pool and run-one readiness; supports --worker/--all-workers and --json")
    doctor.add_argument("--root", default=".")
    doctor.add_argument("--backend", default=RUNTIME_BACKEND, choices=RUNTIME_BACKEND_CHOICES)
    doctor.add_argument("--worker")
    doctor.add_argument("--all-workers", action="store_true")
    doctor.add_argument(
        "--compact",
        action="store_true",
        help="run bounded lock and worker-pool recovery checks without the full doctor chain",
    )
    doctor.add_argument("--json", action="store_true")
    doctor.set_defaults(func=command_doctor)

    last = sub.add_parser("last", help="show latest non-demo visible-run, settle hints, and summary paths")
