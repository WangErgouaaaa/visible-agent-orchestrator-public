    preflight = sub.add_parser("preflight", help="verify framework plus the default or explicit worker binding, endpoint schema, and owner lock")
    preflight.add_argument("--root", default=".")
    preflight.add_argument("--backend", default=RUNTIME_BACKEND, choices=RUNTIME_BACKEND_CHOICES)
    preflight.add_argument("--worker")
    preflight.set_defaults(func=command_preflight)

    run_one = sub.add_parser(
        "run-one",
        help=(
            "recommended one-shot path: embedded binding/current-window/doctor/"
            "target-lock preflight, worker-scoped pre-submit settle, submit, "
