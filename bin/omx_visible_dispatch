        f"- runtime_snapshot_backend_type: {summary.get('runtime_snapshot_backend_type') or '-'}",
        f"- runtime_observation_path: {summary.get('runtime_observation_path') or '-'}",
        f"- runtime_observation_ok: {str(bool(summary.get('runtime_observation_ok'))).lower()}",
        f"- runtime_observation_status: {summary.get('runtime_observation_status') or '-'}",
        f"- runtime_observation_readiness: {summary.get('runtime_observation_readiness') or '-'}",
        f"- runtime_observation_backend_type: {summary.get('runtime_observation_backend_type') or '-'}",
        f"- runtime_observation_session_id: {summary.get('runtime_observation_session_id') or '-'}",
