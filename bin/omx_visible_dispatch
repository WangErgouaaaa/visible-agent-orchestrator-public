    demo = sub.add_parser("demo", help="create framework-only visible dispatch demo data")
    demo.add_argument("--root", default=".")
    demo.set_defaults(func=command_demo)

    supplement = sub.add_parser(
        "supplement",
        help=(
            "deliver one idempotent same-task supplementary instruction over "
            "the fenced session's async server transport (including default "
            "TUI tasks); repeat requests return the "
            "known result without resending"
        ),
    )
    supplement.add_argument("--root", default=".")
    supplement.add_argument("--backend", default=RUNTIME_BACKEND, choices=RUNTIME_BACKEND_CHOICES)
    supplement.add_argument("--worker", required=True)
    supplement.add_argument("--run", required=True)
    supplement.add_argument("--task", required=True)
    supplement.add_argument(
        "--attempt-id",
        dest="attempt_id",
        default="",
        help=(
            "the caller's explicit expected attempt; it must match the "
            "authoritative task/fence identity"
        ),
    )
    supplement.add_argument("--supplement-id", dest="supplement_id", required=True)
    supplement.add_argument(
        "--supplement-authorization-id",
        dest="supplement_authorization_id",
        default="",
        help=(
            "task/request bound grant id from the operation-authorization "
            "ledger (prepared by the trusted host); required"
        ),
    )
    supplement.add_argument(
        "--text-file",
        dest="text_file",
        required=True,
        help=f"file with the supplemental instruction text (<= {SUPPLEMENT_TEXT_BYTE_LIMIT} bytes)",
    )
    supplement.add_argument(
        "--selection-file",
        dest="selection_file",
        required=True,
        help=(
            "JSON file with the host-bound original selection "
            "(agent, model, variant, selection_evidence); the same facts must "
            "hash-match the prepared grant"
        ),
    )
    supplement.add_argument(
        "--authorize-leader",
        dest="authorize_leader",
        action="store_true",
        help=(
            "trusted-leader path: mint the request-bound supplement grant for "
            "this exact request and selection instead of passing a prepared "
            "--supplement-authorization-id"
        ),
    )
    supplement.add_argument(
        "--event-id",
        dest="event_id",
        default="",
        help="with --authorize-leader: the operator event id that names the grant",
    )
    supplement.add_argument("--allow-real", action="store_true")
    supplement.add_argument("--json", action="store_true")
    supplement.set_defaults(func=command_supplement)

    interrupt_cmd = sub.add_parser(
        "interrupt",
        help=(
            "deliver one idempotent task-bound interrupt over the pinned "
            "session abort transport; repeat requests return the known "
            "result without resending"
        ),
    )
    interrupt_cmd.add_argument("--root", default=".")
    interrupt_cmd.add_argument(
        "--backend", default=RUNTIME_BACKEND, choices=RUNTIME_BACKEND_CHOICES
    )
    interrupt_cmd.add_argument("--worker", required=True)
    interrupt_cmd.add_argument("--run", required=True)
    interrupt_cmd.add_argument("--task", required=True)
    interrupt_cmd.add_argument(
        "--attempt-id",
        dest="attempt_id",
        default="",
        help=(
            "the caller's explicit expected attempt; it must match the "
            "authoritative task/fence identity"
        ),
    )
    interrupt_cmd.add_argument("--interrupt-id", dest="interrupt_id", required=True)
    interrupt_cmd.add_argument(
        "--interrupt-authorization-id",
        dest="interrupt_authorization_id",
        default="",
        help=(
            "task/request bound grant id from the operation-authorization "
            "ledger (prepared by the trusted host); required unless "
            "--authorize-leader is used"
        ),
    )
    interrupt_cmd.add_argument(
        "--selection-file",
        dest="selection_file",
        default="",
        help=(
            "optional JSON file with the host-bound original selection "
            "(agent, model, variant, selection_evidence) as request "
            "identity; omitting it sends an abort-only interrupt with no "
            "selection facts - only a selection-bound interrupt (this file, "
            "on either transport) can later back a same-task resume"
        ),
    )
    interrupt_cmd.add_argument(
        "--authorize-leader",
        dest="authorize_leader",
        action="store_true",
        help=(
            "trusted-leader path: mint the request-bound interrupt grant for "
            "this exact request (and selection when supplied) instead of "
            "passing a prepared --interrupt-authorization-id"
        ),
    )
    interrupt_cmd.add_argument(
        "--event-id",
        dest="event_id",
        default="",
        help="with --authorize-leader: the operator event id that names the grant",
    )
    interrupt_cmd.add_argument("--allow-real", action="store_true")
    interrupt_cmd.add_argument("--json", action="store_true")
    interrupt_cmd.set_defaults(func=command_interrupt)

    interrupt_status = sub.add_parser(
        "interrupt-status",
        help=(
            "read-only interrupt receipt plus bounded live session "
            "observation; it never re-aborts or rewrites recorded delivery"
        ),
    )
    interrupt_status.add_argument("--root", default=".")
    interrupt_status.add_argument(
        "--backend", default=RUNTIME_BACKEND, choices=RUNTIME_BACKEND_CHOICES
    )
    interrupt_status.add_argument("--worker", required=True)
    interrupt_status.add_argument("--run", required=True)
    interrupt_status.add_argument("--task", required=True)
    interrupt_status.add_argument(
        "--attempt-id",
        dest="attempt_id",
        default="",
        help="the caller's explicit expected attempt for identity binding",
    )
    interrupt_status.add_argument(
        "--interrupt-id", dest="interrupt_id", required=True
    )
    interrupt_status.add_argument("--json", action="store_true")
    interrupt_status.set_defaults(func=command_interrupt_status)

    resume = sub.add_parser(
        "resume",
        help=(
            "deliver one idempotent same-task resume instruction after an "
            "accepted interrupt; repeat requests return the known result "
            "without resending. Works over the pinned server transport and "
            "the ordinary default-TUI supplement transport when the "
            "interrupt was selection-bound (--selection-file on interrupt); "
            "a selection-less abort-only interrupt cannot resume and keeps "
            "the existing closeout/continuation path"
        ),
    )
    resume.add_argument("--root", default=".")
    resume.add_argument(
        "--backend", default=RUNTIME_BACKEND, choices=RUNTIME_BACKEND_CHOICES
    )
    resume.add_argument("--worker", required=True)
    resume.add_argument("--run", required=True)
    resume.add_argument("--task", required=True)
    resume.add_argument(
        "--attempt-id",
        dest="attempt_id",
        default="",
        help=(
            "the caller's explicit expected attempt; it must match the "
            "authoritative task/fence identity"
        ),
    )
    resume.add_argument(
        "--interrupt-id",
        dest="interrupt_id",
        required=True,
        help=(
            "the accepted nonambiguous task interrupt whose true cancel "
            "receipt this resume continues from"
        ),
    )
    resume.add_argument("--resume-id", dest="resume_id", required=True)
    resume.add_argument("--text-file", dest="text_file", required=True)
    resume.add_argument(
        "--selection-file",
        dest="selection_file",
        required=True,
        help=(
            "JSON file with the host-bound original selection "
            "(agent, model, variant, selection_evidence)"
        ),
    )
    resume.add_argument(
        "--writer-evidence-file",
        dest="writer_evidence_file",
        required=True,
        help=(
            "trusted-leader writer verification record binding task/fence/"
            "interrupt, verifier/check time, reviewed scope/coverage, known "
            "writer identities with terminal states and task-contained "
            "digest-matching evidence, and an empty unresolved list"
        ),
    )
    resume.add_argument(
        "--resume-authorization-id",
        dest="resume_authorization_id",
        default="",
        help=(
            "resume-bound grant id from the operation-authorization ledger "
            "(prepared by the trusted host); required unless "
            "--authorize-leader is used"
        ),
    )
    resume.add_argument(
        "--authorize-leader",
        dest="authorize_leader",
        action="store_true",
        help=(
            "trusted-leader path: mint the resume-bound supplement grant "
            "for this exact request instead of passing a prepared "
            "--resume-authorization-id"
        ),
    )
    resume.add_argument(
        "--event-id",
        dest="event_id",
        default="",
        help="with --authorize-leader: the operator event id that names the grant",
    )
    resume.add_argument("--allow-real", action="store_true")
    resume.add_argument("--json", action="store_true")
    resume.set_defaults(func=command_resume)

    for command_parser in sub.choices.values():
        command_parser.set_defaults(root=None)
    return parser


def raise_keyboard_interrupt_on_sigterm(_signum: int, _frame: Any) -> None:
    raise KeyboardInterrupt


def main(argv: list[str] | None = None, *, _admission_root: Path | None = None) -> int:
    if argv is None:
        argv = sys.argv[1:]
    previous_sigterm_handler = signal.signal(
        signal.SIGTERM,
        raise_keyboard_interrupt_on_sigterm,
    )
    try:
        if argv and argv[0] == "--dry-run-resolve-worker":
            argv = ["dry-run-resolve-worker", *argv[1:]]
        parser = build_parser()
        args = parser.parse_args(argv)
        try:
            if args.command == "wait" and args.total_timeout is not None:
                return command_wait_continued(args, admission_root=_admission_root)
            if args.command == "collect" and args.completion_json:
                output = io.StringIO()
                try:
                    with redirect_stdout(output):
                        result = invoke_cli_handler("omx_visible_dispatch", args, args.func, admission_root=_admission_root)
                except (DispatchError, AdmissionError):
                    print(output.getvalue(), end="", file=sys.stderr)
                    raise
                print(json.dumps({"collect_completed": True, "output": output.getvalue()}))
                return result
            return invoke_cli_handler("omx_visible_dispatch", args, args.func, admission_root=_admission_root)
        except DispatchError as exc:
            print(f"ERROR: {exc}", file=sys.stderr)
            return 1
        except AdmissionError as exc:
            print(f"ERROR: {exc}", file=sys.stderr)
            return 1
        except KeyboardInterrupt:
            print("ERROR: interrupted", file=sys.stderr)
            return 130
    finally:
        signal.signal(signal.SIGTERM, previous_sigterm_handler)


if __name__ == "__main__":
    raise SystemExit(main())
