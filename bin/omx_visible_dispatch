    quarantine.add_argument("--reason", required=True)
    quarantine.add_argument("--allow-nonterminal-quarantine", action="store_true")
    quarantine.add_argument(
        "--allow-reviewed-recovery-failure-quarantine",
        action="store_true",
        help=(
            "also authorize the exact reviewed finish-refused acceptance "
