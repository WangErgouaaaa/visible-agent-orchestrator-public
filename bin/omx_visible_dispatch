class DispatchError(Exception):
    """Expected operator-facing failure."""


def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def root_path(value: str | None) -> Path:
    return runtime_root(value)


def current_host_boot_id() -> str:
    try:
        return (
            Path("/proc/sys/kernel/random/boot_id")
            .read_text(encoding="utf-8")
            .strip()
        )
    except OSError:
        return ""


def team_root(root: Path) -> Path:
    return root / ".omx" / "state" / "team"


def framework_root(root: Path) -> Path:
    return root / ".omx" / "framework" / "team"


def visible_runs_root(root: Path) -> Path:
    return framework_root(root) / "visible-runs"


def _validate_real_directory_chain(
    root: Path,
    target: Path,
    *,
    create: bool,
) -> Path:
    root = Path(root)
    target = Path(target)
    try:
        root_mode = root.lstat().st_mode
    except OSError as exc:
        raise DispatchError(f"control root is unavailable: {root}") from exc
    if stat.S_ISLNK(root_mode) or not stat.S_ISDIR(root_mode):
        raise DispatchError(f"control root is not a real directory: {root}")
    try:
        relative = target.relative_to(root)
    except ValueError as exc:
        raise DispatchError("visible-runs path escapes the control root") from exc
    root_resolved = root.resolve()
    current = root
    for part in relative.parts:
        current = current / part
        try:
            mode = current.lstat().st_mode
        except FileNotFoundError:
            if not create:
                raise DispatchError(
                    f"visible-runs path is missing: {current}"
                )
            try:
                current.mkdir(mode=0o700)
            except FileExistsError:
                pass
            try:
                mode = current.lstat().st_mode
            except OSError as exc:
                raise DispatchError(
                    f"visible-runs path is unavailable: {current}"
                ) from exc
        except OSError as exc:
            raise DispatchError(f"visible-runs path is unreadable: {current}") from exc
        if stat.S_ISLNK(mode) or not stat.S_ISDIR(mode):
            raise DispatchError(
                f"visible-runs path contains symlink or non-directory: {current}"
            )
        try:
            current.resolve().relative_to(root_resolved)
        except ValueError as exc:
            raise DispatchError(
                f"visible-runs path escapes the control root: {current}"
            ) from exc
    return current.resolve()


def locks_root(root: Path) -> Path:
    return visible_runs_root(root) / "_locks"


def lock_archive_root(root: Path) -> Path:
    return locks_root(root) / "archive"


def adapter_path(root: Path) -> Path:
    return root / "bin" / "omx_opencode_tui_adapter"


_ADAPTER_MODULE_CACHE: dict[str, Any] = {}


def load_adapter_module(root: Path) -> Any:
    path = adapter_path(root).resolve()
    key = str(path)
    cached = _ADAPTER_MODULE_CACHE.get(key)
    if cached is not None:
        return cached
    loader = importlib.machinery.SourceFileLoader(f"omx_opencode_tui_adapter__{path.stat().st_mtime_ns}", key)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise DispatchError(f"failed to load adapter module: {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    _ADAPTER_MODULE_CACHE[key] = module
    return module


_CODEX_ADAPTER_MODULE_CACHE: dict[str, Any] = {}


def codex_adapter_path(root: Path) -> Path:
    return root / "bin" / "omx_codex_tui_adapter"


def load_codex_adapter_module(root: Path) -> Any:
    path = codex_adapter_path(root).resolve()
    if not path.is_file():
        raise DispatchError(f"missing codex adapter: {path}")
    key = str(path)
    cached = _CODEX_ADAPTER_MODULE_CACHE.get(key)
    if cached is not None:
        return cached
    loader = importlib.machinery.SourceFileLoader(f"omx_codex_tui_adapter__{path.stat().st_mtime_ns}", key)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise DispatchError(f"failed to load codex adapter module: {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    _CODEX_ADAPTER_MODULE_CACHE[key] = module
    return module


