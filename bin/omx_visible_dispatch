        f"- delayed_finalize_terminal_state: {summary.get('delayed_finalize_terminal_state') or '-'}",
        f"- pre_submit_tui_readiness: {summary.get('pre_submit_tui_readiness', {}).get('readiness', '-') if isinstance(summary.get('pre_submit_tui_readiness'), dict) else '-'}",
        f"- post_terminal_tui_readiness: {summary.get('post_terminal_tui_readiness', {}).get('readiness', '-') if isinstance(summary.get('post_terminal_tui_readiness'), dict) else '-'}",
