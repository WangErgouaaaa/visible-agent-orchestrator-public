# Minimum binding-lease validity that must remain when the dispatch reaches
# the real submit adapter: a bounded submit margin covering the 90-second
# submit-visible-real adapter command window plus the lease-renewal and
# fence-refresh overhead. It is not a universal race-free guarantee — with
# arbitrary scheduling delay or clock changes the lease can still expire
# before the adapter-side lease gate, which rejects that submit and leaves
# the residue to the existing bounded recovery path.
SUBMIT_BINDING_LEASE_MARGIN_SECONDS = 120
