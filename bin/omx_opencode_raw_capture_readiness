def command_runtime_proof_postcheck_contract(args: argparse.Namespace) -> int:
    wrapper = _read_json_arg(args.wrapper_json)
    execution_receipt = _read_json_arg(args.execution_receipt_json)
    cleanup_receipt = _read_json_arg(args.cleanup_receipt_json)
    operator_report = _read_json_arg(args.operator_report_json)
    postcheck_contract = build_runtime_proof_postcheck_contract(
        wrapper=wrapper,
        postcheck_contract_id=args.postcheck_contract_id,
        source_wrapper_path=args.wrapper_json if args.wrapper_json != "-" else "",
        target_worker_id=args.worker or "",
        execution_receipt=execution_receipt,
        cleanup_receipt=cleanup_receipt,
        operator_report=operator_report,
    )
    validation = postcheck_contract["validation"]
    payload = {
        "ok": validation["ok"],
        "errors": validation["errors"],
        "validation": validation,
        "postcheck_contract": postcheck_contract,
        "would_execute_opencode": False,
        "would_execute_live": False,
        "would_touch_worker": False,
        "would_create_artifacts": False,
        "would_create_temp_root": False,
        "would_read_live_artifacts": False,
        "would_write_live_config": False,
        "would_write_task_local": False,
        "would_write_registry": False,
        "would_write_state_team": False,
        "would_write_cleanup_proof": False,
        "would_collect_runtime_evidence": False,
    }
    _emit_runtime_postcheck_contract_payload(payload, as_json=bool(args.json))
    return 0 if payload["ok"] else 2


def command_validate_runtime_proof_postcheck_contract(args: argparse.Namespace) -> int:
    postcheck_contract = _read_json_arg(args.postcheck_contract_json)
