def command_runtime_proof_execute_once(args: argparse.Namespace) -> int:
    if not bool(args.execute_approved_once):
        raise RawCaptureReadinessError("runtime-proof-execute-once requires --execute-approved-once")
    wrapper = _read_json_arg(args.wrapper_json)
    payload = execute_runtime_proof_once(
        wrapper=wrapper,
        execution_id=args.execution_id,
    )
    _emit_runtime_execute_once_payload(payload, as_json=bool(args.json))
    return 0 if payload["ok"] else 2


