def command_runtime_proof_authorization_package(args: argparse.Namespace) -> int:
    manifest = _read_json_arg(args.manifest_json)
    approved_argv = _parse_approved_argv_json(args.approved_argv_json)
    package = build_runtime_proof_authorization_package(
        manifest=manifest,
        package_id=args.package_id,
        target_worker_id=args.worker or "",
        approval_id=args.approval_id,
        approval_expires_at=args.approval_expires_at,
        approved_argv=approved_argv,
        timebox_seconds=args.timebox_seconds,
        disposable_root=args.disposable_root,
        selected_runtime_root=args.root,
        selected_workspace_root=args.workspace_root,
    )
    output_errors = output_dir_guard_errors(args.output_dir) if args.output_dir else []
    package_path = None
    package_markdown_path = None
    if not output_errors and args.output_dir and package["validation"]["ok"]:
        written = write_runtime_proof_authorization_package(package, output_dir=args.output_dir)
        package_path = written["package_path"]
        package_markdown_path = written["package_markdown_path"]

    errors = [*package["validation"]["errors"], *output_errors]
    payload = {
        "ok": not errors,
        "errors": errors,
        "validation": package["validation"],
        "package": package,
        "package_path": package_path,
        "package_markdown_path": package_markdown_path,
        "would_execute_opencode": False,
        "would_create_artifacts": bool(package_path or package_markdown_path),
        "would_write_live_config": False,
        "would_write_task_local": False,
        "would_write_registry": False,
        "would_write_state_team": False,
    }
    _emit_runtime_package_payload(payload, as_json=bool(args.json))
    return 0 if payload["ok"] else 2


def command_validate_runtime_proof_authorization_package(args: argparse.Namespace) -> int:
    package = _read_json_arg(args.package_json)
    validation = validate_runtime_proof_authorization_package(package)
    payload = {
        "ok": validation["ok"],
        "errors": validation["errors"],
        "validation": validation,
        "package_kind": package.get("package_kind", ""),
        "would_execute_opencode": bool(package.get("would_execute_opencode", False)),
    }
    _emit_runtime_package_payload(payload, as_json=bool(args.json))
    return 0 if validation["ok"] else 2


def command_runtime_proof_runner_plan(args: argparse.Namespace) -> int:
    package = _read_json_arg(args.package_json)
    runner_plan = build_runtime_proof_runner_plan(
        package=package,
        runner_plan_id=args.runner_plan_id,
        source_package_path=args.package_json if args.package_json != "-" else "",
        target_worker_id=args.worker or "",
    )
    validation = runner_plan["validation"]
    payload = {
        "ok": validation["ok"],
        "errors": validation["errors"],
        "validation": validation,
        "runner_plan": runner_plan,
        "would_execute_opencode": False,
        "would_create_artifacts": False,
        "would_write_live_config": False,
        "would_write_task_local": False,
        "would_write_registry": False,
        "would_write_state_team": False,
    }
    _emit_runtime_runner_plan_payload(payload, as_json=bool(args.json))
    return 0 if payload["ok"] else 2


