    validate_runtime_proof_install_sync_review,
)


def _emit(payload: dict, *, as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
        return
    status = "ready" if payload.get("ready_for_future_capture") else "not_ready"
    print(f"opencode_raw_capture_readiness: {status}")
    print(f"checker_writes: {str(bool(payload.get('checker_writes'))).lower()}")
    print(f"control_writes: {str(bool(payload.get('control_writes'))).lower()}")
    print(f"isolated_config_root: {payload.get('isolated_config_root') or '-'}")
    print(f"planned_capture_output: {payload.get('planned_capture_output') or '-'}")
    reasons = payload.get("reasons", [])
    if reasons:
        print(f"reasons: {', '.join(str(item) for item in reasons)}")


def command_validate(args: argparse.Namespace) -> int:
    plan = read_plan_json(args.plan_json, sys.stdin.read() if args.plan_json == "-" else None)
    payload = check_readiness_plan(plan, cwd=Path.cwd())
    _emit(payload, as_json=bool(args.json))
    return 0 if payload["ready_for_future_capture"] else 2


def command_plan(args: argparse.Namespace) -> int:
    plan = build_plan(
        isolated_config_root=args.isolated_config_root,
        capture_output_path=args.capture_output_path,
        plugin_path=args.plugin_path,
        worker_id=args.worker or "",
        parent_run_id=args.parent_run_id or "",
        parent_task_id=args.parent_task_id or "",
    )
    payload = check_readiness_plan(plan, cwd=Path.cwd())
    _emit(payload, as_json=bool(args.json))
    return 0 if payload["ready_for_future_capture"] else 2


def command_manifest(args: argparse.Namespace) -> int:
    payload = build_capture_manifest(
        isolated_config_root=args.isolated_config_root,
        capture_output_path=args.capture_output_path,
        plugin_path=args.plugin_path,
        worker_id=args.worker or "",
        parent_run_id=args.parent_run_id or "",
        parent_task_id=args.parent_task_id or "",
        authorization_level=args.authorization_level,
        cwd=Path.cwd(),
    )
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print("opencode_isolated_capture_manifest: no-execution")
        print(f"would_execute: {str(bool(payload.get('would_execute'))).lower()}")
        print(f"ready_for_runtime_capture: {str(bool(payload.get('ready_for_runtime_capture'))).lower()}")
        reasons = payload.get("blocked_reasons", [])
        if reasons:
            print(f"blocked_reasons: {', '.join(str(item) for item in reasons)}")
    return 0 if payload["readiness"]["ready_for_future_capture"] else 2


def _read_json_arg(path: str) -> dict:
    text = sys.stdin.read() if path == "-" else Path(path).read_text(encoding="utf-8")
    payload = json.loads(text)
    if not isinstance(payload, dict):
        raise RawCaptureReadinessError("JSON document must be an object")
    return payload


def _unwrap_rollout_review(payload: dict) -> dict:
    nested = payload.get("rollout_review")
    if isinstance(nested, dict):
        return nested
    return payload


def _unwrap_install_sync_review(payload: dict) -> dict:
    nested = payload.get("install_sync_review")
    if isinstance(nested, dict):
        return nested
    return payload


def _unwrap_postcheck_contract(payload: dict) -> dict:
    nested = payload.get("postcheck_contract")
    if isinstance(nested, dict):
        return nested
    return payload


def _unwrap_evidence_postcheck(payload: dict) -> dict:
    nested = payload.get("evidence_postcheck")
    if isinstance(nested, dict):
        return nested
    return payload


def _parse_approved_argv_json(value: str) -> list[str]:
    payload = json.loads(value)
    if not isinstance(payload, list) or not all(isinstance(item, str) for item in payload):
        raise RawCaptureReadinessError("--approved-argv-json must be a JSON string array")
    return list(payload)


def _emit_runtime_package_payload(payload: dict, *, as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False))
        return
    status = "ok" if payload.get("ok") else "not_ok"
    print(f"opencode_runtime_proof_authorization_package: {status}")
    print(f"would_execute_opencode: {str(bool(payload.get('would_execute_opencode'))).lower()}")
    print(f"would_create_artifacts: {str(bool(payload.get('would_create_artifacts'))).lower()}")
    if payload.get("package_path"):
        print(f"package_path: {payload['package_path']}")
    errors = payload.get("errors", [])
    if errors:
        print(f"errors: {', '.join(str(item) for item in errors)}")


