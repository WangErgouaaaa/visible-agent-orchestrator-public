        "executor_kind": executor_contract.get("executor_kind", ""),
        "would_execute_opencode": bool(executor_contract.get("would_execute_opencode", False)),
        "would_read_live_artifacts": bool(executor_contract.get("would_read_live_artifacts", False)),
    }
    _emit_runtime_executor_contract_payload(payload, as_json=bool(args.json))
    return 0 if validation["ok"] else 2


