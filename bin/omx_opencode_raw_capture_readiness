        "would_write_data_sync": False,
        "would_copy_files": False,
        "would_chmod": False,
        "would_run_live_smoke": False,
        "would_execute_opencode": False,
        "would_touch_tmux": False,
    }
    _emit_runtime_install_sync_review_payload(payload, as_json=bool(args.json))
    return 0 if payload["ok"] else 2


