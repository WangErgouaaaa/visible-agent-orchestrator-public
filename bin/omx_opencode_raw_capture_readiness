def command_runtime_proof_evidence_postcheck(args: argparse.Namespace) -> int:
    postcheck_contract = _unwrap_postcheck_contract(_read_json_arg(args.postcheck_contract_json))
    raw_event_evidence = _read_json_arg(args.raw_event_evidence_json)
    evidence_postcheck = build_runtime_proof_evidence_postcheck(
        postcheck_contract=postcheck_contract,
        evidence_postcheck_id=args.evidence_postcheck_id,
        source_postcheck_contract_path=args.postcheck_contract_json if args.postcheck_contract_json != "-" else "",
        target_worker_id=args.worker or "",
        raw_event_evidence=raw_event_evidence,
    )
    validation = evidence_postcheck["validation"]
    payload = {
        "ok": validation["ok"],
        "errors": validation["errors"],
        "validation": validation,
        "evidence_postcheck": evidence_postcheck,
        "would_execute_opencode": False,
        "would_execute_live": False,
        "would_touch_worker": False,
        "would_create_temp_root": False,
        "would_read_live_artifacts": False,
        "would_write_live_config": False,
        "would_write_task_local": False,
        "would_write_registry": False,
        "would_write_state_team": False,
        "would_collect_runtime_evidence": False,
        "would_touch_tmux": False,
        "would_call_tui": False,
    }
    _emit_runtime_evidence_postcheck_payload(payload, as_json=bool(args.json))
    return 0 if payload["ok"] else 2


def command_validate_runtime_proof_evidence_postcheck(args: argparse.Namespace) -> int:
    evidence_postcheck = _unwrap_evidence_postcheck(_read_json_arg(args.evidence_postcheck_json))
    validation = validate_runtime_proof_evidence_postcheck(evidence_postcheck)
    payload = {
        "ok": validation["ok"],
        "errors": validation["errors"],
        "validation": validation,
        "evidence_postcheck_kind": evidence_postcheck.get("evidence_postcheck_kind", ""),
        "would_execute_opencode": bool(evidence_postcheck.get("would_execute_opencode", False)),
        "would_read_live_artifacts": bool(evidence_postcheck.get("would_read_live_artifacts", False)),
        "would_collect_runtime_evidence": bool(evidence_postcheck.get("would_collect_runtime_evidence", False)),
    }
    _emit_runtime_evidence_postcheck_payload(payload, as_json=bool(args.json))
    return 0 if validation["ok"] else 2


def command_runtime_proof_executor_contract(args: argparse.Namespace) -> int:
    wrapper = _read_json_arg(args.wrapper_json)
    executor_contract = build_runtime_proof_executor_contract(
        wrapper=wrapper,
        executor_contract_id=args.executor_contract_id,
        source_wrapper_path=args.wrapper_json if args.wrapper_json != "-" else "",
        target_worker_id=args.worker or "",
    )
    validation = executor_contract["validation"]
    payload = {
        "ok": validation["ok"],
        "errors": validation["errors"],
        "validation": validation,
        "executor_contract": executor_contract,
        "would_execute_opencode": False,
        "would_execute_live": False,
        "would_touch_worker": False,
        "would_create_artifacts": False,
        "would_create_temp_root": False,
        "would_read_live_artifacts": False,
        "would_write_live_config": False,
        "would_write_task_local": False,
        "would_write_registry": False,
        "would_write_state_team": False,
        "would_write_cleanup_proof": False,
        "would_collect_runtime_evidence": False,
    }
    _emit_runtime_executor_contract_payload(payload, as_json=bool(args.json))
    return 0 if payload["ok"] else 2


def command_validate_runtime_proof_executor_contract(args: argparse.Namespace) -> int:
    executor_contract = _read_json_arg(args.executor_contract_json)
    validation = validate_runtime_proof_executor_contract(executor_contract)
    payload = {
        "ok": validation["ok"],
        "errors": validation["errors"],
