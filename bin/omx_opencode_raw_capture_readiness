def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    validate = sub.add_parser("validate", help="validate a proposed raw-capture plan JSON")
    validate.add_argument("--plan-json", required=True, help="plan JSON path, or '-' for stdin")
    validate.add_argument("--json", action="store_true")
    validate.set_defaults(func=command_validate)

    plan = sub.add_parser("plan", help="build and validate a no-live raw-capture readiness plan")
    plan.add_argument("--isolated-config-root", required=True)
    plan.add_argument("--capture-output-path", required=True)
    plan.add_argument("--plugin-path", required=True)
    plan.add_argument("--worker")
    plan.add_argument("--parent-run-id")
    plan.add_argument("--parent-task-id")
    plan.add_argument("--json", action="store_true")
    plan.set_defaults(func=command_plan)

    manifest = sub.add_parser("manifest", help="emit a no-execution isolated raw-capture manifest")
    manifest.add_argument("--isolated-config-root", required=True)
    manifest.add_argument("--capture-output-path", required=True)
    manifest.add_argument("--plugin-path", required=True)
    manifest.add_argument("--worker")
    manifest.add_argument("--parent-run-id")
    manifest.add_argument("--parent-task-id")
    manifest.add_argument("--authorization-level", default="no-execution")
    manifest.add_argument("--json", action="store_true")
    manifest.set_defaults(func=command_manifest)

    runtime_package = sub.add_parser(
        "runtime-proof-authorization-package",
        help="build a no-execution runtime-proof authorization package from a manifest",
    )
    runtime_package.add_argument("--manifest-json", required=True, help="authorized manifest JSON path, or '-'")
    runtime_package.add_argument("--package-id", required=True)
    runtime_package.add_argument("--worker", required=True)
    runtime_package.add_argument("--approval-id", required=True)
    runtime_package.add_argument("--approval-expires-at", required=True)
    runtime_package.add_argument("--approved-argv-json", required=True, help='JSON array, for example ["opencode","debug","config"]')
    runtime_package.add_argument("--timebox-seconds", required=True, type=int)
    runtime_package.add_argument("--disposable-root", required=True)
    runtime_package.add_argument("--root", default=str(runtime_root()))
    runtime_package.add_argument("--workspace-root", default=str(workspace_root()))
    runtime_package.add_argument("--output-dir", help="optional safe review-artifact output directory")
    runtime_package.add_argument("--json", action="store_true")
    runtime_package.set_defaults(func=command_runtime_proof_authorization_package)

    validate_runtime_package = sub.add_parser(
        "validate-runtime-proof-authorization-package",
        help="validate a no-execution runtime-proof authorization package JSON",
    )
    validate_runtime_package.add_argument("--package-json", required=True, help="package JSON path, or '-'")
    validate_runtime_package.add_argument("--json", action="store_true")
    validate_runtime_package.set_defaults(func=command_validate_runtime_proof_authorization_package)

    runtime_runner_plan = sub.add_parser(
        "runtime-proof-runner-plan",
        help="build a source-only no-execution runtime-proof runner plan from an authorization package",
    )
    runtime_runner_plan.add_argument("--package-json", required=True, help="authorization package JSON path, or '-'")
    runtime_runner_plan.add_argument("--runner-plan-id", required=True)
    runtime_runner_plan.add_argument("--worker", help="target worker override; must match the package approval")
    runtime_runner_plan.add_argument("--json", action="store_true")
    runtime_runner_plan.set_defaults(func=command_runtime_proof_runner_plan)

    validate_runtime_runner_plan = sub.add_parser(
        "validate-runtime-proof-runner-plan",
        help="validate a source-only no-execution runtime-proof runner plan JSON",
    )
    validate_runtime_runner_plan.add_argument("--runner-plan-json", required=True, help="runner plan JSON path, or '-'")
    validate_runtime_runner_plan.add_argument("--json", action="store_true")
    validate_runtime_runner_plan.set_defaults(func=command_validate_runtime_proof_runner_plan)

    runtime_execution_wrapper = sub.add_parser(
        "runtime-proof-execution-wrapper",
        help="build a source-only no-execution runtime-proof execution-wrapper plan from a runner plan",
    )
    runtime_execution_wrapper.add_argument("--runner-plan-json", required=True, help="runner plan JSON path, or '-'")
    runtime_execution_wrapper.add_argument("--wrapper-id", required=True)
    runtime_execution_wrapper.add_argument("--worker", help="target worker override; must match the runner plan")
    runtime_execution_wrapper.add_argument("--json", action="store_true")
    runtime_execution_wrapper.set_defaults(func=command_runtime_proof_execution_wrapper)

    validate_runtime_execution_wrapper = sub.add_parser(
        "validate-runtime-proof-execution-wrapper",
        help="validate a source-only no-execution runtime-proof execution-wrapper JSON",
    )
    validate_runtime_execution_wrapper.add_argument("--wrapper-json", required=True, help="execution-wrapper JSON path, or '-'")
    validate_runtime_execution_wrapper.add_argument("--json", action="store_true")
    validate_runtime_execution_wrapper.set_defaults(func=command_validate_runtime_proof_execution_wrapper)

    runtime_postcheck_contract = sub.add_parser(
        "runtime-proof-postcheck-contract",
        help="build a source-only no-execution runtime-proof postcheck contract from supplied receipt JSON",
    )
    runtime_postcheck_contract.add_argument("--wrapper-json", required=True, help="execution-wrapper JSON path")
    runtime_postcheck_contract.add_argument("--postcheck-contract-id", required=True)
    runtime_postcheck_contract.add_argument("--execution-receipt-json", required=True)
    runtime_postcheck_contract.add_argument("--cleanup-receipt-json", required=True)
    runtime_postcheck_contract.add_argument("--operator-report-json", required=True)
    runtime_postcheck_contract.add_argument("--worker", help="target worker override; must match the wrapper")
    runtime_postcheck_contract.add_argument("--json", action="store_true")
    runtime_postcheck_contract.set_defaults(func=command_runtime_proof_postcheck_contract)

    validate_runtime_postcheck_contract = sub.add_parser(
        "validate-runtime-proof-postcheck-contract",
        help="validate a source-only no-execution runtime-proof postcheck contract JSON",
    )
    validate_runtime_postcheck_contract.add_argument(
        "--postcheck-contract-json",
        required=True,
        help="postcheck contract JSON path, or '-'",
    )
    validate_runtime_postcheck_contract.add_argument("--json", action="store_true")
    validate_runtime_postcheck_contract.set_defaults(func=command_validate_runtime_proof_postcheck_contract)

    runtime_evidence_postcheck = sub.add_parser(
        "runtime-proof-evidence-postcheck",
        help="build a supplied-json-only runtime-proof evidence postcheck from a postcheck contract and raw-event evidence",
    )
    runtime_evidence_postcheck.add_argument("--postcheck-contract-json", required=True, help="postcheck contract JSON path")
    runtime_evidence_postcheck.add_argument("--evidence-postcheck-id", required=True)
    runtime_evidence_postcheck.add_argument("--raw-event-evidence-json", required=True)
    runtime_evidence_postcheck.add_argument("--worker", help="target worker override; must match the postcheck contract")
    runtime_evidence_postcheck.add_argument("--json", action="store_true")
    runtime_evidence_postcheck.set_defaults(func=command_runtime_proof_evidence_postcheck)

    validate_runtime_evidence_postcheck = sub.add_parser(
        "validate-runtime-proof-evidence-postcheck",
        help="validate a supplied-json-only runtime-proof evidence postcheck JSON",
    )
    validate_runtime_evidence_postcheck.add_argument(
        "--evidence-postcheck-json",
        required=True,
        help="evidence postcheck JSON path, or '-'",
    )
    validate_runtime_evidence_postcheck.add_argument("--json", action="store_true")
    validate_runtime_evidence_postcheck.set_defaults(func=command_validate_runtime_proof_evidence_postcheck)

    runtime_executor_contract = sub.add_parser(
        "runtime-proof-executor-contract",
        help="build a source-only no-execution runtime-proof executor contract from an execution wrapper",
    )
    runtime_executor_contract.add_argument("--wrapper-json", required=True, help="execution-wrapper JSON path")
    runtime_executor_contract.add_argument("--executor-contract-id", required=True)
    runtime_executor_contract.add_argument("--worker", help="target worker override; must match the wrapper")
    runtime_executor_contract.add_argument("--json", action="store_true")
    runtime_executor_contract.set_defaults(func=command_runtime_proof_executor_contract)

    validate_runtime_executor_contract = sub.add_parser(
        "validate-runtime-proof-executor-contract",
        help="validate a source-only no-execution runtime-proof executor contract JSON",
    )
    validate_runtime_executor_contract.add_argument(
        "--executor-contract-json",
        required=True,
        help="executor contract JSON path, or '-'",
    )
    validate_runtime_executor_contract.add_argument("--json", action="store_true")
    validate_runtime_executor_contract.set_defaults(func=command_validate_runtime_proof_executor_contract)

    runtime_executor_writer = sub.add_parser(
        "runtime-proof-executor-writer",
        help="build a source-only no-execution runtime-proof executor-writer contract from an executor contract",
    )
    runtime_executor_writer.add_argument("--executor-contract-json", required=True, help="executor contract JSON path")
    runtime_executor_writer.add_argument("--writer-contract-id", required=True)
    runtime_executor_writer.add_argument("--worker", help="target worker override; must match the executor contract")
    runtime_executor_writer.add_argument("--json", action="store_true")
    runtime_executor_writer.set_defaults(func=command_runtime_proof_executor_writer)

    validate_runtime_executor_writer = sub.add_parser(
        "validate-runtime-proof-executor-writer",
        help="validate a source-only no-execution runtime-proof executor-writer contract JSON",
    )
    validate_runtime_executor_writer.add_argument(
        "--executor-writer-json",
        required=True,
        help="executor-writer contract JSON path, or '-'",
    )
    validate_runtime_executor_writer.add_argument("--json", action="store_true")
    validate_runtime_executor_writer.set_defaults(func=command_validate_runtime_proof_executor_writer)

    runtime_execute_once = sub.add_parser(
        "runtime-proof-execute-once",
        help="execute one approved isolated runtime-proof wrapper attempt",
    )
    runtime_execute_once.add_argument("--wrapper-json", required=True, help="execution-wrapper JSON path")
    runtime_execute_once.add_argument("--execution-id", required=True)
    runtime_execute_once.add_argument(
        "--execute-approved-once",
        action="store_true",
        help="required acknowledgement that this runs the wrapper's approved argv exactly once",
    )
    runtime_execute_once.add_argument("--json", action="store_true")
    runtime_execute_once.set_defaults(func=command_runtime_proof_execute_once)

    runtime_rollout_review = sub.add_parser(
        "runtime-proof-rollout-review",
        help="build a source-only no-apply runtime-proof rollout review package",
    )
    runtime_rollout_review.add_argument("--review-id", required=True)
    runtime_rollout_review.add_argument("--source-root", required=True)
    runtime_rollout_review.add_argument("--target-root", required=True)
    runtime_rollout_review.add_argument("--manifest-json", required=True)
    runtime_rollout_review.add_argument("--json", action="store_true")
    runtime_rollout_review.set_defaults(func=command_runtime_proof_rollout_review)

    validate_runtime_rollout_review = sub.add_parser(
        "validate-runtime-proof-rollout-review",
        help="validate a source-only no-apply runtime-proof rollout review package JSON",
    )
    validate_runtime_rollout_review.add_argument(
        "--rollout-review-json",
        required=True,
        help="rollout review JSON path, or '-'",
    )
    validate_runtime_rollout_review.add_argument("--json", action="store_true")
    validate_runtime_rollout_review.set_defaults(func=command_validate_runtime_proof_rollout_review)

    runtime_install_sync_review = sub.add_parser(
        "runtime-proof-install-sync-review",
        help="build a source-only no-apply runtime-proof install/sync review bundle",
    )
    runtime_install_sync_review.add_argument("--review-id", required=True)
    runtime_install_sync_review.add_argument("--source-root", required=True)
    runtime_install_sync_review.add_argument("--target-root", required=True)
    runtime_install_sync_review.add_argument("--rollout-review-json", required=True, help="rollout review JSON path, or '-'")
    runtime_install_sync_review.add_argument("--install-plan-json", required=True, help="install plan JSON path, or '-'")
    runtime_install_sync_review.add_argument("--json", action="store_true")
    runtime_install_sync_review.set_defaults(func=command_runtime_proof_install_sync_review)

    validate_runtime_install_sync_review = sub.add_parser(
        "validate-runtime-proof-install-sync-review",
        help="validate a source-only no-apply runtime-proof install/sync review bundle JSON",
    )
    validate_runtime_install_sync_review.add_argument(
        "--install-sync-review-json",
        required=True,
        help="install/sync review JSON path, or '-'",
    )
    validate_runtime_install_sync_review.add_argument("--json", action="store_true")
    validate_runtime_install_sync_review.set_defaults(func=command_validate_runtime_proof_install_sync_review)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.func(args))
    except RawCaptureReadinessError as exc:
        print(f"opencode_raw_capture_readiness_error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
