#!/usr/bin/env python3
"""Validate isolated OpenCode raw-capture readiness plans without live writes."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path


_THIS_FILE = Path(__file__).resolve()
_CANDIDATE_IMPORT_ROOTS = []

_env_lib = os.environ.get("OMX_VISIBLE_AGENT_ORCHESTRATOR_LIB")
if _env_lib:
    _CANDIDATE_IMPORT_ROOTS.append(Path(_env_lib).expanduser().resolve())

_CANDIDATE_IMPORT_ROOTS.append((_THIS_FILE.parent.parent / "src").resolve())
_CANDIDATE_IMPORT_ROOTS.append((_THIS_FILE.parent.parent / "lib").resolve())

for _path in _CANDIDATE_IMPORT_ROOTS:
    if _path.exists() and str(_path) not in sys.path:
        sys.path.insert(0, str(_path))

from visible_agent_orchestrator.opencode_raw_capture_readiness import (  # noqa: E402
    RawCaptureReadinessError,
    build_plan,
    check_readiness_plan,
    read_plan_json,
)
from visible_agent_orchestrator.opencode_isolated_capture_manifest import (  # noqa: E402
    build_capture_manifest,
)
from visible_agent_orchestrator.opencode_runtime_proof_authorization import (  # noqa: E402
