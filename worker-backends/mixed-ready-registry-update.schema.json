{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omx/mixed-ready-registry-update.schema.json",
  "title": "MixedReadyRegistryUpdate",
  "type": "object",
  "required": [
    "schema_version",
    "update_id",
    "created_at",
    "update_kind",
    "backend_kind",
    "worker_id",
    "registry_path",
    "readiness_gate_result",
    "readiness_gate_evidence",
    "current_registry_record",
    "proposed_registry_record",
    "changed_fields",
    "business_ready_before",
    "business_ready_after",
    "mixed_ready_before",
    "mixed_ready_after",
    "allow_business_repo_writes_before",
    "allow_business_repo_writes_after",
    "allow_mixed_worker_before",
    "allow_mixed_worker_after",
    "mixed_ready_scope",
    "allowed_mixed_task_kinds",
    "would_write_registry",
    "would_execute_live",
    "blocked_reasons",
    "warnings",
    "safe_next_actions",
    "forbidden_next_actions",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "update_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "update_kind": { "const": "claude-mixed-ready-registry-update" },
    "backend_kind": { "const": "claude_code" },
    "worker_id": { "type": "string", "minLength": 1 },
    "registry_path": { "type": "string", "minLength": 1 },
    "readiness_gate_result": { "type": "object" },
    "readiness_gate_evidence": { "type": "array" },
    "current_registry_record": { "type": "object" },
    "proposed_registry_record": { "type": "object" },
    "changed_fields": { "type": "array", "items": { "type": "string" } },
    "business_ready_before": { "type": "boolean" },
    "business_ready_after": { "const": false },
    "mixed_ready_before": { "type": "boolean" },
    "mixed_ready_after": { "type": "boolean" },
    "allow_business_repo_writes_before": { "type": "boolean" },
    "allow_business_repo_writes_after": { "const": false },
    "allow_mixed_worker_before": { "type": "boolean" },
    "allow_mixed_worker_after": { "type": "boolean" },
    "mixed_ready_scope": { "const": "sandbox_noop_only" },
    "allowed_mixed_task_kinds": {
      "type": "array",
      "prefixItems": [
        { "const": "mixed_noop_sandbox" },
        { "const": "mixed_terminal_protocol_smoke" }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "would_write_registry": { "type": "boolean" },
    "would_execute_live": { "const": false },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "safe_next_actions": { "type": "array", "items": { "type": "string" } },
    "forbidden_next_actions": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array" }
  },
  "allOf": [
    { "properties": { "business_ready_after": { "const": false } } },
    { "properties": { "allow_business_repo_writes_after": { "const": false } } },
    { "properties": { "would_execute_live": { "const": false } } }
  ]
}
