{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omx/mixed-worker-plan.schema.json",
  "title": "MixedWorkerPlan",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "plan_id",
    "created_at",
    "plan_kind",
    "root",
    "runtime_backend",
    "workers",
    "worker_roles",
    "task_matrix",
    "allowed_write_roots",
    "forbidden_paths",
    "business_repo_policy",
    "readiness_gates",
    "terminal_protocol_gates",
    "lock_gates",
    "health_gates",
    "smoke_requirements",
    "execution_mode",
    "would_execute_live",
    "mixed_ready",
    "business_ready",
    "blocked_reasons",
    "warnings",
    "safe_next_actions",
    "forbidden_next_actions",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "plan_kind": { "type": "string" },
    "root": { "type": "string" },
    "runtime_backend": { "type": "string" },
    "workers": {
      "type": "array",
      "items": { "$ref": "#/$defs/MixedWorkerCandidate" }
    },
    "worker_roles": { "type": "object" },
    "task_matrix": { "type": "array", "items": { "type": "object" } },
    "allowed_write_roots": { "type": "array", "items": { "type": "string" } },
    "forbidden_paths": { "type": "array", "items": { "type": "string" } },
    "business_repo_policy": { "type": "object" },
    "readiness_gates": { "type": "array", "items": { "$ref": "#/$defs/GateResult" } },
    "terminal_protocol_gates": { "type": "array", "items": { "$ref": "#/$defs/GateResult" } },
    "lock_gates": { "type": "array", "items": { "$ref": "#/$defs/GateResult" } },
    "health_gates": { "type": "array", "items": { "$ref": "#/$defs/GateResult" } },
    "smoke_requirements": { "type": "object" },
    "execution_mode": { "enum": ["no-live", "live"] },
    "would_execute_live": { "type": "boolean", "const": false },
    "mixed_ready": { "type": "boolean" },
    "business_ready": { "type": "boolean" },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "safe_next_actions": { "type": "array", "items": { "type": "string" } },
    "forbidden_next_actions": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "MixedWorkerCandidate": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "worker_id",
        "backend_kind",
        "source",
        "workspace_root",
        "runtime_backend",
        "live_capable",
        "registered",
        "last_smoke_ok",
        "done_smoke_ok",
        "blocked_smoke_ok",
        "fail_smoke_ok",
        "business_ready",
        "mixed_ready",
        "allow_business_repo_writes",
        "allow_mixed_worker",
        "allowed_write_roots",
        "forbidden_paths",
        "required_gates",
        "blocked_reasons",
        "warnings"
      ],
      "properties": {
        "worker_id": { "type": "string" },
        "backend_kind": { "enum": ["opencode_tui", "claude_code", "cursor_agent"] },
        "source": {
          "type": "object",
          "required": ["opencode_visible_registry", "registered_worker_registry", "fixture"],
          "properties": {
            "opencode_visible_registry": { "type": "boolean" },
            "registered_worker_registry": { "type": "boolean" },
            "fixture": { "type": "boolean" }
          }
        },
        "workspace_root": { "type": "string" },
        "runtime_backend": { "type": "string" },
        "live_capable": { "type": "boolean" },
        "registered": { "type": "boolean" },
        "last_smoke_ok": { "type": "boolean" },
        "done_smoke_ok": { "type": "boolean" },
        "blocked_smoke_ok": { "type": "boolean" },
        "fail_smoke_ok": { "type": "boolean" },
        "business_ready": { "type": "boolean" },
        "mixed_ready": { "type": "boolean" },
        "allow_business_repo_writes": { "type": "boolean" },
        "allow_mixed_worker": { "type": "boolean" },
        "allowed_write_roots": { "type": "array", "items": { "type": "string" } },
        "forbidden_paths": { "type": "array", "items": { "type": "string" } },
        "required_gates": { "type": "array", "items": { "type": "string" } },
        "blocked_reasons": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "GateResult": {
      "type": "object",
      "required": ["gate", "ok", "blocked_reasons", "warnings", "evidence"],
      "properties": {
        "gate": { "type": "string" },
        "ok": { "type": "boolean" },
        "blocked_reasons": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
