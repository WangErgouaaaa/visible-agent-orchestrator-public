{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCode Runtime-Proof Rollout Review",
  "type": "object",
  "required": [
    "schema_version",
    "review_kind",
    "review_id",
    "review_state",
    "review_mode",
    "source_root",
    "target_root",
    "phase_range",
    "asset_inventory",
    "cli_commands",
    "source_modules",
    "schema_assets",
    "examples_assets",
    "readme_anchors",
    "install_manifest_bindings",
    "install_allowlist_bindings",
    "rollout_readiness_summary",
    "no_apply_flags",
    "would_apply_install_sync",
    "would_write_data_sync",
    "would_execute_opencode",
    "would_load_plugin",
    "would_create_temp_root",
    "would_run_cleanup",
    "would_write_cleanup_proof",
    "would_write_task_local",
    "would_write_registry",
    "would_write_state_team",
    "would_touch_tmux",
    "would_call_tui",
    "claims_installed_runtime_proof",
    "claims_runtime_execution_proven",
    "safe_next_actions",
    "forbidden_next_actions",
    "blocked_reasons",
    "warnings",
    "validation",
    "advisory"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "review_kind": { "const": "opencode-runtime-proof-rollout-review" },
    "review_id": { "type": "string" },
    "review_state": { "const": "review_only" },
    "review_mode": { "const": "no-apply" },
    "source_root": { "type": "string" },
    "target_root": { "type": "string" },
    "phase_range": {
      "type": "array",
      "prefixItems": [
        { "const": 15 },
        { "const": 16 },
        { "const": 17 },
        { "const": 18 },
        { "const": 19 }
      ],
      "minItems": 5,
      "maxItems": 5
    },
    "asset_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "phase",
          "asset_kind",
          "source_rel",
          "target_rel",
          "coverage_mode",
          "manifest_entry_present",
          "install_allowlist_present",
          "source_exists"
        ],
        "additionalProperties": true
      }
    },
    "cli_commands": { "type": "array", "items": { "type": "string" } },
    "source_modules": { "type": "array", "items": { "type": "string" } },
    "schema_assets": { "type": "array", "items": { "type": "string" } },
    "examples_assets": { "type": "array", "items": { "type": "string" } },
    "readme_anchors": { "type": "array", "items": { "type": "string" } },
    "install_manifest_bindings": { "type": "array", "items": { "type": "object" } },
    "install_allowlist_bindings": { "type": "array", "items": { "type": "object" } },
    "rollout_readiness_summary": { "type": "object" },
    "no_apply_flags": {
      "type": "object",
      "properties": {
        "would_apply_install_sync": { "const": false },
        "would_write_data_sync": { "const": false },
        "would_execute_opencode": { "const": false },
        "would_load_plugin": { "const": false },
        "would_create_temp_root": { "const": false },
        "would_run_cleanup": { "const": false },
        "would_write_cleanup_proof": { "const": false },
        "would_write_task_local": { "const": false },
        "would_write_registry": { "const": false },
        "would_write_state_team": { "const": false },
        "would_touch_tmux": { "const": false },
        "would_call_tui": { "const": false }
      },
      "additionalProperties": true
    },
    "would_apply_install_sync": { "const": false },
    "would_write_data_sync": { "const": false },
    "would_execute_opencode": { "const": false },
    "would_load_plugin": { "const": false },
    "would_create_temp_root": { "const": false },
    "would_run_cleanup": { "const": false },
    "would_write_cleanup_proof": { "const": false },
    "would_write_task_local": { "const": false },
    "would_write_registry": { "const": false },
    "would_write_state_team": { "const": false },
    "would_touch_tmux": { "const": false },
    "would_call_tui": { "const": false },
    "claims_installed_runtime_proof": { "const": false },
    "claims_runtime_execution_proven": { "const": false },
    "safe_next_actions": { "type": "array", "items": { "type": "string" } },
    "forbidden_next_actions": { "type": "array", "items": { "type": "string" } },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "validation": { "type": "object" },
    "advisory": { "type": "string" }
  },
  "additionalProperties": true
}
