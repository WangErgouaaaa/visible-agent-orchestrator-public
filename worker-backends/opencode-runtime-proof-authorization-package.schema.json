{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCode Runtime-Proof Authorization Package",
  "type": "object",
  "required": [
    "schema_version",
    "package_kind",
    "package_id",
    "target_worker_id",
    "would_execute_opencode",
    "would_create_artifacts",
    "would_write_live_config",
    "would_write_task_local",
    "would_write_registry",
    "would_write_state_team",
    "manifest_snapshot",
    "manifest_snapshot_sha256",
    "approval_record",
    "disposable_artifacts",
    "expected_post_checks",
    "forbidden_paths",
    "validation",
    "advisory"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_kind": { "const": "opencode-runtime-proof-authorization-package" },
    "package_id": { "type": "string" },
    "target_worker_id": { "type": "string" },
    "would_execute_opencode": { "const": false },
    "would_create_artifacts": { "const": false },
    "would_write_live_config": { "const": false },
    "would_write_task_local": { "const": false },
    "would_write_registry": { "const": false },
    "would_write_state_team": { "const": false },
    "manifest_snapshot": {
      "type": "object",
      "required": [
        "sha256",
        "authorization_level",
        "runtime_proof_authorized",
        "runtime_proof_evidence_proven",
        "plugin_load_smoke_plan",
        "config_root_contract",
        "plugin_contract"
      ],
      "properties": {
        "sha256": { "type": "string" },
        "authorization_level": { "const": "runtime-proof-promptless" },
        "runtime_proof_authorized": { "const": true },
        "runtime_proof_evidence_proven": { "const": false },
        "stop_conditions": { "type": "array", "items": { "type": "string" } },
        "plugin_load_smoke_plan": { "type": "object" },
        "config_root_contract": { "type": "object" },
        "plugin_contract": { "type": "object" }
      },
      "additionalProperties": true
    },
    "manifest_snapshot_sha256": { "type": "string" },
    "approval_record": {
      "type": "object",
      "required": [
        "approval_kind",
        "approval_record_id",
        "authorization_level",
        "approval_id",
        "approval_expires_at",
        "attempt_limit",
        "backend_kind",
        "target_worker",
        "target_worker_id",
        "approved_argv",
        "timebox_seconds",
        "approved_env",
        "unset_env",
        "approved_write_roots",
        "forbidden_paths",
        "required_stop_conditions",
        "single_attempt_only",
        "no_retry"
      ],
      "properties": {
        "approval_kind": { "const": "opencode-runtime-proof-approval-record" },
        "approval_record_id": { "type": "string" },
        "authorization_level": { "const": "runtime-proof-promptless" },
        "approval_id": { "type": "string" },
        "expires_at": { "type": "string" },
        "approval_expires_at": { "type": "string" },
        "attempt_limit": { "const": 1 },
        "backend_kind": { "const": "opencode_tui" },
        "target_worker": { "type": "object" },
        "target_worker_id": { "type": "string" },
        "approved_argv": { "type": "array", "items": { "type": "string" } },
        "timebox_seconds": { "type": "integer", "minimum": 1 },
        "approved_env": { "type": "object" },
        "unset_env": { "type": "array", "items": { "type": "string" } },
        "approved_write_roots": { "type": "array", "items": { "type": "string" } },
        "forbidden_paths": { "type": "array", "items": { "type": "string" } },
        "required_stop_conditions": { "type": "array", "items": { "type": "string" } },
        "single_attempt_only": { "const": true },
        "no_retry": { "const": true }
      },
      "additionalProperties": true
    },
    "disposable_artifacts": {
      "type": "object",
      "required": [
        "temp_root",
        "xdg_config_home",
        "config_json_path",
        "raw_events_jsonl_path",
        "runtime_log_path",
        "postcheck_marker_path",
        "cleanup_receipt_path",
        "allowed_write_roots",
        "cleanup_required",
        "cleanup_scope",
        "leak_allowed",
        "task_local_marker_write_allowed"
      ],
      "properties": {
        "temp_root": { "type": "string" },
        "xdg_config_home": { "type": "string" },
        "config_json_path": { "type": "string" },
        "raw_events_jsonl_path": { "type": "string" },
        "runtime_log_path": { "type": "string" },
        "postcheck_marker_path": { "type": "string" },
        "cleanup_receipt_path": { "type": "string" },
        "allowed_write_roots": { "type": "array", "items": { "type": "string" } },
        "cleanup_required": { "const": true },
        "cleanup_scope": { "const": "temp_root_only" },
        "leak_allowed": { "const": false },
        "task_local_marker_write_allowed": { "const": false }
      },
      "additionalProperties": true
    },
    "expected_post_checks": { "type": "object" },
    "forbidden_paths": { "type": "array", "items": { "type": "string" } },
    "validation": { "type": "object" },
    "advisory": { "type": "string" }
  },
  "additionalProperties": true
}
