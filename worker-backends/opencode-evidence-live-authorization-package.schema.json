{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCode Evidence Live Authorization Package",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "package_kind",
    "backend_kind",
    "target_worker_id",
    "execution_mode",
    "planned_smokes",
    "planned_lock_evidence",
    "planned_settle_evidence",
    "allowed_write_roots",
    "forbidden_paths",
    "would_execute_live",
    "would_touch_worker",
    "would_write_registry"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "type": "string" },
    "created_at": { "type": "string" },
    "package_kind": { "const": "opencode-evidence-live-authorization-package" },
    "backend_kind": { "const": "opencode_tui" },
    "target_worker_id": { "type": "string" },
    "root": { "type": "string" },
    "execution_mode": { "const": "no-live" },
    "requested_future_execution": { "type": "boolean" },
    "current_readiness_summary": { "type": "object" },
    "current_blockers": { "type": "array", "items": { "type": "string" } },
    "planned_smokes": { "type": "array", "minItems": 3, "items": { "type": "object" } },
    "planned_lock_evidence": { "type": "object" },
    "planned_settle_evidence": { "type": "object" },
    "allowed_write_roots": { "type": "array", "items": { "type": "string" } },
    "forbidden_paths": { "type": "array", "items": { "type": "string" } },
    "required_preflight": { "type": "array", "items": { "type": "string" } },
    "required_dispatch_surface": { "type": "object" },
    "required_terminal_protocol": { "type": "object" },
    "required_post_execution_validation": { "type": "object" },
    "required_settle_commands": { "type": "array", "items": { "type": "string" } },
    "would_execute_live": { "const": false },
    "would_touch_worker": { "const": false },
    "would_write_registry": { "const": false },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "safe_next_actions": { "type": "array", "items": { "type": "string" } },
    "forbidden_next_actions": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
