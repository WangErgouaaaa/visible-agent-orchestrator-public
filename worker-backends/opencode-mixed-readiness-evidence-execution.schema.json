{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omx/opencode-mixed-readiness-evidence-execution.schema.json",
  "title": "OpenCodeMixedReadinessEvidenceExecutionPlan",
  "type": "object",
  "required": [
    "schema_version",
    "execution_plan_id",
    "created_at",
    "plan_kind",
    "backend_kind",
    "worker_id",
    "root",
    "execution_mode",
    "opencode_visible_registry",
    "registered_worker_registry",
    "evidence_root",
    "run_root",
    "smoke_tasks",
    "done_smoke_task",
    "blocked_smoke_task",
    "fail_smoke_task",
    "lock_evidence_task",
    "settle_evidence_task",
    "allowed_write_roots",
    "forbidden_paths",
    "dispatch_surface",
    "required_wrappers",
    "terminal_protocol",
    "lock_policy",
    "settle_policy",
    "expected_evidence_bundle",
    "would_execute_live",
    "would_write_registry",
    "would_touch_worker",
    "blocked_reasons",
    "warnings",
    "safe_next_actions",
    "forbidden_next_actions",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "execution_plan_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "plan_kind": { "const": "opencode-mixed-readiness-evidence-execution-plan" },
    "backend_kind": { "const": "opencode_tui" },
    "worker_id": { "type": "string", "minLength": 1 },
    "root": { "type": "string" },
    "execution_mode": { "const": "no-live" },
    "opencode_visible_registry": { "type": "string" },
    "registered_worker_registry": { "type": "string" },
    "evidence_root": { "type": "string" },
    "run_root": { "type": "string" },
    "smoke_tasks": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/smokeTask" }
    },
    "done_smoke_task": { "$ref": "#/$defs/smokeTask" },
    "blocked_smoke_task": { "$ref": "#/$defs/smokeTask" },
    "fail_smoke_task": { "$ref": "#/$defs/smokeTask" },
    "lock_evidence_task": { "$ref": "#/$defs/smokeTask" },
    "settle_evidence_task": { "$ref": "#/$defs/smokeTask" },
    "allowed_write_roots": { "type": "array", "items": { "type": "string" } },
    "forbidden_paths": { "type": "array", "items": { "type": "string" } },
    "dispatch_surface": {
      "type": "object",
      "required": ["allowed_future_entrypoint", "forbidden"],
      "properties": {
        "allowed_future_entrypoint": { "const": "visible dispatch / controlled wrapper only" },
        "forbidden": { "type": "array", "items": { "type": "string" } }
      }
    },
    "required_wrappers": { "type": "array", "items": { "type": "string" } },
    "terminal_protocol": { "type": "object" },
    "lock_policy": { "type": "object" },
    "settle_policy": { "type": "object" },
    "expected_evidence_bundle": { "type": "object" },
    "would_execute_live": { "const": false },
    "would_write_registry": { "const": false },
    "would_touch_worker": { "const": false },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "safe_next_actions": { "type": "array", "items": { "type": "string" } },
    "forbidden_next_actions": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array" }
  },
  "$defs": {
    "smokeTask": {
      "type": "object",
      "required": [
        "smoke_kind",
        "task_id",
        "title",
        "prompt_template",
        "expected_report_path",
        "expected_marker",
        "expected_artifacts",
        "allowed_write_root",
        "forbidden_paths",
        "expected_validation"
      ],
      "properties": {
        "smoke_kind": { "enum": ["done", "blocked", "fail", "lock_evidence", "settle_evidence"] },
        "task_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "prompt_template": { "type": "string", "minLength": 1 },
        "expected_report_path": { "type": "string" },
        "expected_marker": { "type": "string" },
        "expected_artifacts": { "type": "array", "items": { "type": "string" } },
        "allowed_write_root": { "type": "string" },
        "forbidden_paths": { "type": "array", "items": { "type": "string" } },
        "expected_validation": { "type": "object" }
      }
    }
  }
}
