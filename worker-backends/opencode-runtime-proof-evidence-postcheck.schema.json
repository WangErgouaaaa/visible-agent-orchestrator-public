{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCode Runtime-Proof Evidence Postcheck",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_postcheck_kind",
    "evidence_postcheck_id",
    "source_postcheck_contract_id",
    "source_postcheck_contract_path",
    "source_postcheck_contract_sha256",
    "source_postcheck_contract",
    "source_postcheck_contract_validation",
    "source_wrapper_id",
    "source_wrapper_sha256",
    "source_runner_plan_id",
    "source_runner_plan_sha256",
    "source_package_id",
    "source_package_sha256",
    "target_worker_id",
    "dispatch_target_worker_id",
    "backend_kind",
    "evidence_mode",
    "evidence_state",
    "raw_event_evidence",
    "plugin_runtime_evidence",
    "terminal_truth",
    "write_scope_verification",
    "allowed_write_roots",
    "forbidden_paths",
    "would_execute_opencode",
    "would_execute_live",
    "would_touch_worker",
    "would_create_temp_root",
    "would_read_live_artifacts",
    "would_write_live_config",
    "would_write_task_local",
    "would_write_registry",
    "would_write_state_team",
    "would_collect_runtime_evidence",
    "would_touch_tmux",
    "would_call_tui",
    "safe_next_actions",
    "forbidden_next_actions",
    "blocked_reasons",
    "warnings",
    "validation",
    "advisory"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_postcheck_kind": { "const": "opencode-runtime-proof-evidence-postcheck" },
    "evidence_postcheck_id": { "type": "string" },
    "source_postcheck_contract_id": { "type": "string" },
    "source_postcheck_contract_path": { "type": "string" },
    "source_postcheck_contract_sha256": { "type": "string" },
    "source_postcheck_contract": {
      "type": "object",
      "required": ["postcheck_kind", "postcheck_contract_id", "target_worker_id", "validation"],
      "properties": {
        "postcheck_kind": { "const": "opencode-runtime-proof-postcheck-contract" },
        "postcheck_contract_id": { "type": "string" },
        "target_worker_id": { "type": "string" },
        "validation": { "type": "object" }
      },
      "additionalProperties": true
    },
    "source_postcheck_contract_validation": { "type": "object" },
    "source_wrapper_id": { "type": "string" },
    "source_wrapper_sha256": { "type": "string" },
    "source_runner_plan_id": { "type": "string" },
    "source_runner_plan_sha256": { "type": "string" },
    "source_package_id": { "type": "string" },
    "source_package_sha256": { "type": "string" },
    "target_worker_id": { "type": "string" },
    "dispatch_target_worker_id": { "type": "string" },
    "backend_kind": { "const": "opencode_tui" },
    "evidence_mode": { "const": "supplied-json-only" },
    "evidence_state": { "const": "review_only" },
    "raw_event_evidence": {
      "type": "object",
      "required": [
        "evidence_kind",
        "raw_events_jsonl_path",
        "raw_event_count",
        "plugin_import_observed",
        "hook_invocation_observed",
        "plugin_runtime_load_proven",
        "read_from_disposable_root_only",
        "forbidden_path_writes_detected"
      ],
      "properties": {
        "evidence_kind": { "const": "opencode-runtime-proof-raw-event-evidence" },
        "raw_events_jsonl_path": { "type": "string" },
        "raw_event_count": { "type": "integer", "minimum": 1 },
        "observed_event_kinds": { "type": "array", "items": { "type": "string" } },
        "plugin_import_observed": { "const": true },
        "hook_invocation_observed": { "const": true },
        "plugin_runtime_load_proven": { "const": true },
        "native_subagent_lifecycle_proven": { "type": "boolean" },
        "read_from_disposable_root_only": { "const": true },
        "forbidden_path_writes_detected": { "const": false }
      },
      "additionalProperties": true
    },
    "plugin_runtime_evidence": {
      "type": "object",
      "properties": {
        "raw_events_path_bound": { "const": true },
        "raw_event_count": { "type": "integer", "minimum": 1 },
        "plugin_import_observed": { "const": true },
        "hook_invocation_observed": { "const": true },
        "plugin_runtime_load_proven": { "const": true }
      },
      "additionalProperties": true
    },
    "terminal_truth": {
      "type": "object",
      "properties": {
        "terminal_marker": { "enum": [".done", ".fail", ".blocked"] },
        "terminal_marker_count": { "const": 1 }
      },
      "additionalProperties": true
    },
    "write_scope_verification": {
      "type": "object",
      "properties": {
        "no_live_config_write": { "const": true },
        "no_task_local_write": { "const": true },
        "no_registry_write": { "const": true },
        "no_state_team_write": { "const": true },
        "no_forbidden_path_writes": { "const": true }
      },
      "additionalProperties": true
    },
    "allowed_write_roots": { "type": "array", "items": { "type": "string" } },
    "forbidden_paths": { "type": "array", "items": { "type": "string" } },
    "would_execute_opencode": { "const": false },
    "would_execute_live": { "const": false },
    "would_touch_worker": { "const": false },
    "would_create_temp_root": { "const": false },
    "would_read_live_artifacts": { "const": false },
    "would_write_live_config": { "const": false },
    "would_write_task_local": { "const": false },
    "would_write_registry": { "const": false },
    "would_write_state_team": { "const": false },
    "would_collect_runtime_evidence": { "const": false },
    "would_touch_tmux": { "const": false },
    "would_call_tui": { "const": false },
    "safe_next_actions": { "type": "array", "items": { "type": "string" } },
    "forbidden_next_actions": { "type": "array", "items": { "type": "string" } },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "validation": { "type": "object" },
    "advisory": { "type": "string" }
  },
  "additionalProperties": true
}
