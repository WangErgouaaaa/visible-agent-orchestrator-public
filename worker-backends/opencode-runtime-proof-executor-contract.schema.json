{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCode Runtime-Proof Executor Contract",
  "type": "object",
  "required": [
    "schema_version",
    "executor_kind",
    "executor_contract_id",
    "source_wrapper_id",
    "source_wrapper_path",
    "source_wrapper_sha256",
    "source_wrapper",
    "source_wrapper_validation",
    "source_runner_plan_id",
    "source_runner_plan_sha256",
    "source_package_id",
    "source_package_sha256",
    "source_package_manifest_snapshot_sha256",
    "target_worker_id",
    "dispatch_target_worker_id",
    "backend_kind",
    "execution_mode",
    "executor_state",
    "approved_invocation_binding",
    "single_attempt_contract",
    "future_execution_receipt_template",
    "future_cleanup_receipt_template",
    "future_operator_report_template",
    "artifact_path_bindings",
    "terminal_truth_template",
    "cleanup_verification_template",
    "write_scope_verification_template",
    "allowed_write_roots",
    "forbidden_paths",
    "would_execute_opencode",
    "would_execute_live",
    "would_touch_worker",
    "would_create_artifacts",
    "would_create_temp_root",
    "would_read_live_artifacts",
    "would_write_live_config",
    "would_write_task_local",
    "would_write_registry",
    "would_write_state_team",
    "would_write_cleanup_proof",
    "would_collect_runtime_evidence",
    "safe_next_actions",
    "forbidden_next_actions",
    "blocked_reasons",
    "warnings",
    "validation",
    "advisory"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "executor_kind": { "const": "opencode-runtime-proof-executor-contract" },
    "executor_contract_id": { "type": "string" },
    "source_wrapper_id": { "type": "string" },
    "source_wrapper_path": { "type": "string" },
    "source_wrapper_sha256": { "type": "string" },
    "source_wrapper": {
      "type": "object",
      "required": ["wrapper_kind", "wrapper_id", "source_runner_plan_sha256", "target_worker_id"],
      "properties": {
        "wrapper_kind": { "const": "opencode-runtime-proof-execution-wrapper" },
        "wrapper_id": { "type": "string" },
        "source_runner_plan_sha256": { "type": "string" },
        "target_worker_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    "source_wrapper_validation": { "type": "object" },
    "source_runner_plan_id": { "type": "string" },
    "source_runner_plan_sha256": { "type": "string" },
    "source_package_id": { "type": "string" },
    "source_package_sha256": { "type": "string" },
    "source_package_manifest_snapshot_sha256": { "type": "string" },
    "target_worker_id": { "type": "string" },
    "dispatch_target_worker_id": { "type": "string" },
    "backend_kind": { "const": "opencode_tui" },
    "execution_mode": { "const": "no-execution" },
    "executor_state": { "const": "review_only" },
    "approved_invocation_binding": { "type": "object" },
    "single_attempt_contract": {
      "type": "object",
      "required": ["attempt_limit", "single_attempt_only", "no_retry"],
      "properties": {
        "attempt_limit": { "const": 1 },
        "attempt_count": { "const": 1 },
        "attempt_index": { "const": 1 },
        "single_attempt_only": { "const": true },
        "no_retry": { "const": true },
        "timebox_seconds": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "future_execution_receipt_template": {
      "type": "object",
      "required": ["receipt_kind", "source", "attempt_count", "single_attempt_only", "no_retry"],
      "properties": {
        "receipt_kind": { "const": "opencode-runtime-proof-execution-receipt" },
        "source": { "const": "opencode-runtime-proof-executor" },
        "attempt_count": { "const": 1 },
        "attempt_index": { "const": 1 },
        "single_attempt_only": { "const": true },
        "no_retry": { "const": true }
      },
      "additionalProperties": true
    },
    "future_cleanup_receipt_template": {
      "type": "object",
      "required": ["receipt_kind", "cleanup_scope", "cleanup_completed", "cleanup_leftover_paths"],
      "properties": {
        "receipt_kind": { "const": "opencode-runtime-proof-cleanup-receipt" },
        "cleanup_scope": { "const": "temp_root_only" },
        "cleanup_completed": { "const": true },
        "cleanup_leftover_paths": { "type": "array", "maxItems": 0 },
        "temp_root_only_writes": { "const": true },
        "forbidden_path_writes_detected": { "const": false }
      },
      "additionalProperties": true
    },
    "future_operator_report_template": {
      "type": "object",
      "required": ["report_md_nonempty", "terminal_marker_count", "terminal_marker"],
      "properties": {
        "report_md_nonempty": { "const": true },
        "terminal_marker_count": { "const": 1 },
        "terminal_marker": { "enum": [".done", ".fail", ".blocked"] },
        "terminal_markers": {
          "type": "array",
          "items": { "enum": [".done", ".fail", ".blocked"] },
          "minItems": 1,
          "maxItems": 1
        },
        "cleanup_completed": { "const": true }
      },
      "additionalProperties": true
    },
    "artifact_path_bindings": { "type": "object" },
    "terminal_truth_template": { "type": "object" },
    "cleanup_verification_template": { "type": "object" },
    "write_scope_verification_template": { "type": "object" },
    "allowed_write_roots": { "type": "array", "items": { "type": "string" } },
    "forbidden_paths": { "type": "array", "items": { "type": "string" } },
    "would_execute_opencode": { "const": false },
    "would_execute_live": { "const": false },
    "would_touch_worker": { "const": false },
    "would_create_artifacts": { "const": false },
    "would_create_temp_root": { "const": false },
    "would_read_live_artifacts": { "const": false },
    "would_write_live_config": { "const": false },
    "would_write_task_local": { "const": false },
    "would_write_registry": { "const": false },
    "would_write_state_team": { "const": false },
    "would_write_cleanup_proof": { "const": false },
    "would_collect_runtime_evidence": { "const": false },
    "safe_next_actions": { "type": "array", "items": { "type": "string" } },
    "forbidden_next_actions": { "type": "array", "items": { "type": "string" } },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "validation": { "type": "object" },
    "advisory": { "type": "string" }
  },
  "additionalProperties": true
}
