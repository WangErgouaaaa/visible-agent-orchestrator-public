{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omx/opencode-mixed-status.schema.json",
  "title": "OpenCode Mixed Status Summary",
  "type": "object",
  "required": [
    "schema_version",
    "status_kind",
    "root",
    "ok",
    "worker_count",
    "mixed_ready_workers",
    "mixed_blocked_workers",
    "evidence_missing_workers",
    "evidence_collected_candidates",
    "would_execute_live",
    "would_write_registry",
    "workers"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status_kind": { "const": "opencode-mixed-status" },
    "generated_at": { "type": "string" },
    "root": { "type": "string" },
    "worker_scope": { "enum": ["default_worker", "worker", "all_workers", "fixture"] },
    "ok": { "type": "boolean" },
    "worker_count": { "type": "integer", "minimum": 0 },
    "mixed_ready_workers": { "type": "array", "items": { "type": "string" } },
    "mixed_blocked_workers": { "type": "array", "items": { "type": "string" } },
    "evidence_missing_workers": { "type": "array", "items": { "type": "string" } },
    "evidence_collected_candidates": { "type": "array", "items": { "type": "string" } },
    "would_execute_live": { "const": false },
    "would_write_registry": { "const": false },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "worker_id",
          "backend_kind",
          "registry_present",
          "worker_present",
          "evidence_collected",
          "mixed_ready_candidate",
          "mixed_ready",
          "business_ready",
          "allow_business_repo_writes",
          "would_execute_live",
          "would_write_registry",
          "would_touch_worker",
          "blockers"
        ],
        "properties": {
          "worker_id": { "type": "string" },
          "backend_kind": { "const": "opencode_tui" },
          "registry_present": { "type": "boolean" },
          "registry_valid": { "type": "boolean" },
          "worker_present": { "type": "boolean" },
          "evidence_plan_available": { "type": "boolean" },
          "evidence_execution_plan_available": { "type": "boolean" },
          "evidence_collected": { "type": "boolean" },
          "done_smoke_ok": { "type": "boolean" },
          "blocked_smoke_ok": { "type": "boolean" },
          "fail_smoke_ok": { "type": "boolean" },
          "worker_scoped_lock_ok": { "type": "boolean" },
          "worker_scoped_settle_ok": { "type": "boolean" },
          "mixed_ready_candidate": { "type": "boolean" },
          "mixed_ready": { "type": "boolean" },
          "allow_mixed_worker": { "type": "boolean" },
          "business_ready": { "const": false },
          "allow_business_repo_writes": { "const": false },
          "would_execute_live": { "const": false },
          "would_write_registry": { "const": false },
          "would_touch_worker": { "const": false },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "warnings": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
